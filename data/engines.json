{
  "schema_version": 2,
  "max_grok_workers": 4,
  "grok_workers_enabled": true,
  "codex_controller_workers": {
    "enabled": true,
    "max_requests": 4,
    "retry_limit": 1,
    "max_attempts": 8,
    "max_result_chars": 12000
  },
  "prover_rotation": [
    "grok",
    "claude",
    "grok",
    "codex",
    "grok",
    "qwen"
  ],
  "escalation_order": [
    "grok",
    "qwen"
  ],
  "high_tier_chain_engines": ["claude", "codex"],
  "engines": {
    "claude": {
      "binary": "claude",
      "family": "claude",
      "model": "claude-opus-5",
      "effort": "max",
      "max_output_tokens": 128000,
      "max_task_seconds": 10800,
      "inactivity_timeout_seconds": 3600,
      "activity_streams": ["stdout"],
      "abort_stderr_pattern_counts": {
        "exceeded the 32000 output token maximum": 1,
        "exceeded the output token maximum": 1
      },
      "declared_capabilities": {
        "research": ["filesystem_read", "web_search", "web_fetch"],
        "finding-audit": ["filesystem_read", "web_search", "web_fetch"],
