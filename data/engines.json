    },
    "codex": {
      "binary": "codex",
      "family": "openai",
      "model": "gpt-5.6-sol",
      "model_reasoning_effort": "xhigh",
      "max_task_seconds": 10800,
      "inactivity_timeout_seconds": 3600,
      "declared_capabilities": {
        "research": ["filesystem_read", "web_search", "web_fetch"],
        "finding-audit": ["filesystem_read", "web_search", "web_fetch"],
        "novelty": ["filesystem_read", "web_search", "web_fetch"],
        "mathematics": ["filesystem_read", "web_search", "web_fetch"],
        "review": ["filesystem_read", "web_search", "web_fetch"]
