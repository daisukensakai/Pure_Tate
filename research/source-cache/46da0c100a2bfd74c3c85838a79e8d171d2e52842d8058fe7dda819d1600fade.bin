transform="matrix(1 0 0 -1 0 9.46)" width="35.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.E2.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{H}_{4,g,n}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{H}_{4,g,n}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 155.59 0) translate(68.72,0) matrix(1.0 0.0 0.0 1.0 -29.56 0)"><foreignObject style="--ltx-fo-width:3.27em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.86" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="45.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.E2.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces(\mathbb{P}\mathcal{E}^{\vee})^{n}}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces(\mathbb{P}\mathcal{E}^{\vee})^{n}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 67.45)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 4.99 0) translate(25.61,0) matrix(1.0 0.0 0.0 1.0 -19.65 0)"><foreignObject style="--ltx-fo-width:1.84em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.65" overflow="visible" transform="matrix(1 0 0 -1 0 11.69)" width="25.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.E2.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{H}_{4,g}^{\Diamond}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow><mi mathvariant="normal">◇</mi></msubsup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{H}_{4,g}^{\Diamond}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 66.18 0) translate(58.82,0) matrix(1.0 0.0 0.0 1.0 -19.65 0)"><foreignObject style="--ltx-fo-width:1.84em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="25.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.E2.m1.pic1.m5" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{H}_{4,g}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{H}_{4,g}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 171.4 0) translate(52.91,0) matrix(1.0 0.0 0.0 1.0 -13.74 0)"><foreignObject style="--ltx-fo-width:0.99em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="13.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.E2.m1.pic1.m6" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{B}.}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{B}.}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -68.45 24.94 L -36.34 24.94"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -36.07 24.94)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -99.32 12.18 L -99.32 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -99.32 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 25.95 24.94 L 58.05 24.94"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 58.33 24.94)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -4.92 12.18 L -4.92 -13.86"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -4.92 -14.14)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 94.4 12.68 L 94.4 -13.86"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 94.4 -14.14)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -73.43 -25.75 L -31.36 -25.75"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -31.08 -25.75)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 20.96 -25.75 L 73.87 -25.75"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 74.15 -25.75)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
