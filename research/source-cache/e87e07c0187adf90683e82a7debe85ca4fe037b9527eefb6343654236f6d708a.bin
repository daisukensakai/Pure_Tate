<th id="S5.Ex19.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column"><math id="S5.Ex19.m1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></th>
<th id="S5.Ex19.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column"><math id="S5.Ex19.m1.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></th>
