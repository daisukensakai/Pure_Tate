0 -1 0 4.17)" width="7.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex80.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\varphi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">φ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\varphi}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -21.67 29.62 L 10.84 29.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 11.12 29.62)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -37.75 42.96)"><foreignObject style="--ltx-fo-width:4.71em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.73em;font-size:10pt;" height="17.34" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="65.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex80.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces g_{1}|_{\Spec(\widehat{S}_{f})}}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi mathsize="0.700em">g</mi><mn mathsize="0.710em">1</mn></msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo maxsize="0.710em" minsize="0.710em">(</mo><msub><mover accent="true"><mi mathsize="0.710em">S</mi><mo mathsize="1.140em">^</mo></mover><mi>f</mi></msub><mo maxsize="0.710em" minsize="0.710em">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces g_{1}|_{\Spec(\widehat{S}_{f})}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 61.22 12.18 L 61.22 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 61.22 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 64.47 -2.42)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="7.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex80.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\psi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">ψ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\psi}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -21.67 -24.44 L 10.44 -24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 10.71 -24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -37.95 -11.1)"><foreignObject style="--ltx-fo-width:4.71em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.73em;font-size:10pt;" height="17.34" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="65.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex80.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces g_{2}|_{\Spec(\widehat{S}_{f})}}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi mathsize="0.700em">g</mi><mn mathsize="0.710em">2</mn></msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo maxsize="0.710em" minsize="0.710em">(</mo><msub><mover accent="true"><mi mathsize="0.710em">S</mi><mo mathsize="1.140em">^</mo></mover><mi>f</mi></msub><mo maxsize="0.710em" minsize="0.710em">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces g_{2}|_{\Spec(\widehat{S}_{f})}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p16.3" class="ltx_p">Given an affine scheme <math id="S5.SS1.p16.m9" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> over <math id="S5.SS1.p16.m10" class="ltx_Math" alttext="\Spec(S)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(S)</annotation></semantics></math>, we can form the two pullbacks <math id="S5.SS1.p16.m11" class="ltx_Math" alttext="A_{\Spec(\widehat{S})}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>S</mi><mo mathsize="1.140em">^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">A_{\Spec(\widehat{S})}</annotation></semantics></math> and <math id="S5.SS1.p16.m12" class="ltx_Math" alttext="A_{\Spec(S_{f})}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">A_{\Spec(S_{f})}</annotation></semantics></math>. Note that there is a canonical isomorphism <math id="S5.SS1.p16.m13" class="ltx_Math" alttext="\varphi_{A,can}:\left(A_{\Spec(\widehat{S})}\right)|_{\Spec(\widehat{S}_{f})}\xrightarrow{\sim}\left(A_{\Spec(S_{f})}\right)|_{\Spec(\widehat{S}_{f})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mrow><mi>A</mi><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mrow><mo>(</mo><msub><mi>A</mi><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>S</mi><mo mathsize="1.140em">^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub><mo>)</mo></mrow><mo stretchy="false">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>S</mi><mo mathsize="1.140em">^</mo></mover><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mrow><mrow><mo>(</mo><msub><mi>A</mi><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>)</mo></mrow><mo stretchy="false">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>S</mi><mo mathsize="1.140em">^</mo></mover><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\varphi_{A,can}:\left(A_{\Spec(\widehat{S})}\right)|_{\Spec(\widehat{S}_{f})}\xrightarrow{\sim}\left(A_{\Spec(S_{f})}\right)|_{\Spec(\widehat{S}_{f})}</annotation></semantics></math>. This defines a functor</p>
<table id="S5.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex81.m1" class="ltx_Math" alttext="\text{Aff}_{can}:\text{Aff}_{\Spec(S)}\to\text{Glue}_{\text{Aff}},\;\;\;A\mapsto(A_{\Spec(\widehat{S})},A_{\Spec(S_{f})},\varphi_{A,can})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mtext>Aff</mtext><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mtext>Aff</mtext><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">→</mo><msub><mtext>Glue</mtext><mtext>Aff</mtext></msub></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mi>A</mi><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>S</mi><mo mathsize="1.140em">^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msub><mi>A</mi><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msub><mi>φ</mi><mrow><mi>A</mi><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{Aff}_{can}:\text{Aff}_{\Spec(S)}\to\text{Glue}_{\text{Aff}},\;\;\;A\mapsto(A_{\Spec(\widehat{S})},A_{\Spec(S_{f})},\varphi_{A,can})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p16.4" class="ltx_p">Let <math id="S5.SS1.p16.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be an affine flat group scheme over <math id="S5.SS1.p16.m15" class="ltx_Math" alttext="\Spec(S)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(S)</annotation></semantics></math>. We can similarly define a category <math id="S5.SS1.p16.m16" class="ltx_Math" alttext="\text{Glue}_{G\text{Bun}}" display="inline" intent=":literal"><semantics><msub><mtext>Glue</mtext><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mtext>Bun</mtext></mrow></msub><annotation encoding="application/x-tex">\text{Glue}_{G\text{Bun}}</annotation></semantics></math> by replacing the tuple of affine schemes with <math id="S5.SS1.p16.m17" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles and requiring that <math id="S5.SS1.p16.m18" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> is a morphism of <math id="S5.SS1.p16.m19" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles. Denote by <math id="S5.SS1.p16.m20" class="ltx_Math" alttext="BG(S)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">BG(S)</annotation></semantics></math> the groupoid of <math id="S5.SS1.p16.m21" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles over <math id="S5.SS1.p16.m22" class="ltx_Math" alttext="\Spec(S)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(S)</annotation></semantics></math>. The functor <math id="S5.SS1.p16.m23" class="ltx_Math" alttext="\text{Aff}_{can}" display="inline" intent=":literal"><semantics><msub><mtext>Aff</mtext><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\text{Aff}_{can}</annotation></semantics></math> induces another functor</p>
<table id="S5.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex82.m1" class="ltx_Math" alttext="G\text{Bun}_{can}:BG(S)\to\text{Glue}_{G\text{Bun}},\;\;\;\mathcal{P}\mapsto(\mathcal{P}|_{\Spec(\widehat{S})},\mathcal{P}|_{\Spec(S_{f})},\varphi_{\mathcal{P},can})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mtext>Bun</mtext><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mtext>Glue</mtext><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mtext>Bun</mtext></mrow></msub></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>S</mi><mo mathsize="1.140em">^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msub><mi>φ</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G\text{Bun}_{can}:BG(S)\to\text{Glue}_{G\text{Bun}},\;\;\;\mathcal{P}\mapsto(\mathcal{P}|_{\Spec(\widehat{S})},\mathcal{P}|_{\Spec(S_{f})},\varphi_{\mathcal{P},can})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p16.5" class="ltx_p">The following lemma is usually known in the literature as Beauville-Laszlo gluing.</p>
</div>
<div id="S5.Thmthm6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm6.2" class="ltx_text ltx_font_bold">Lemma 5.6</span></span><span id="S5.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm6.p1" class="ltx_para">
<p id="S5.Thmthm6.p1.1" class="ltx_p"><span id="S5.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Suppose that the faithfully flat morphism <math id="S5.Thmthm6.p1.m1" class="ltx_Math" alttext="S\to\widehat{S}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">→</mo><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover></mrow><annotation encoding="application/x-tex">S\to\widehat{S}</annotation></semantics></math> induces an isomorphism <math id="S5.Thmthm6.p1.m2" class="ltx_Math" alttext="S/(f\cdot S)\xrightarrow{\sim}\widehat{S}/(f\cdot\widehat{S})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S/(f\cdot S)\xrightarrow{\sim}\widehat{S}/(f\cdot\widehat{S})</annotation></semantics></math>. Then both of the functors <math id="S5.Thmthm6.p1.m3" class="ltx_Math" alttext="\text{Aff}_{can}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_italic">Aff</mtext><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\text{Aff}_{can}</annotation></semantics></math> and <math id="S5.Thmthm6.p1.m4" class="ltx_Math" alttext="G\text{Bun}_{can}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mtext class="ltx_mathvariant_italic">Bun</mtext><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G\text{Bun}_{can}</annotation></semantics></math> described above are equivalences of categories.</span></p>
</div>
</div>
<div id="S5.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS1.p17" class="ltx_para">
<p id="S5.SS1.p17.1" class="ltx_p"><span id="S5.SS1.p17.1.1" class="ltx_text">We shall use <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Sta23</a>, <a href="https://stacks.math.columbia.edu/tag/05E5" title="" class="ltx_ref ltx_href">Tag 05ES</a>]</cite>. Since the gluing of modules preserves the tensor product structure on modules (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Sta23</a>, <a href="https://stacks.math.columbia.edu/tag/05EU" title="" class="ltx_ref ltx_href">Tag 05EU</a>]</cite>), the equivalence in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Sta23</a>, <a href="https://stacks.math.columbia.edu/tag/05E5" title="" class="ltx_ref ltx_href">Tag 05ES</a>]</cite> induces an equivalence of monoid objects (i.e. algebras). By applying the <math id="S5.SS1.p17.m1" class="ltx_Math" alttext="\Spec" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">Spec</mi><annotation encoding="application/x-tex">\Spec</annotation></semantics></math> functor we deduce that <math id="S5.SS1.p17.m2" class="ltx_Math" alttext="\text{Aff}_{can}" display="inline" intent=":literal"><semantics><msub><mtext>Aff</mtext><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\text{Aff}_{can}</annotation></semantics></math> is an equivalence, and that it is compatible with fiber products relative to the base. This implies that <math id="S5.SS1.p17.m3" class="ltx_Math" alttext="\text{Aff}_{can}" display="inline" intent=":literal"><semantics><msub><mtext>Aff</mtext><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\text{Aff}_{can}</annotation></semantics></math> induces an equivalence of categories of affine schemes equipped with a right <math id="S5.SS1.p17.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action<span id="footnote6" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">6</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">6</sup>
                  <span class="ltx_tag ltx_tag_note">6</span>
                  
                  
                  
                  
                  
                  
                  
                One defines the corresponding gluing category similarly as in the case for <math id="footnote6.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles above.</span></span></span>. If <math id="S5.SS1.p17.m5" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> is a scheme equipped with a right <math id="S5.SS1.p17.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action, then by descent for the flat cover <math id="S5.SS1.p17.m7" class="ltx_Math" alttext="\Spec(\widehat{S})\to\Spec(S)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Spec(\widehat{S})\to\Spec(S)</annotation></semantics></math> we know that <math id="S5.SS1.p17.m8" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> is a <math id="S5.SS1.p17.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle if and only if <math id="S5.SS1.p17.m10" class="ltx_Math" alttext="\mathcal{P}|_{\Spec(\widehat{S})}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>S</mi><mo mathsize="1.140em">^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\mathcal{P}|_{\Spec(\widehat{S})}</annotation></semantics></math> is a <math id="S5.SS1.p17.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle. This shows that the equivalence on affine schemes equipped with a right <math id="S5.SS1.p17.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action restricts to an equivalence <math id="S5.SS1.p17.m13" class="ltx_Math" alttext="G\text{Bun}_{can}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mtext>Bun</mtext><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G\text{Bun}_{can}</annotation></semantics></math> on the subcategories of <math id="S5.SS1.p17.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles.
∎</span></p>
</div>
</div>
<div id="S5.SS1.p18" class="ltx_para">
<p id="S5.SS1.p18.1" class="ltx_p">Now we are ready to prove the main theorem of this subsection.</p>
</div>
<div id="S5.Thmthm7" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm7.2" class="ltx_text ltx_font_bold">Theorem 5.7</span></span><span id="S5.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm7.p1" class="ltx_para">
<p id="S5.Thmthm7.p1.1" class="ltx_p"><span id="S5.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">The structure morphism <math id="S5.Thmthm7.p1.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)\rightarrow\Spec(k)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)\rightarrow\Spec(k)</annotation></semantics></math> satisfies the existence part of the valuative criterion for properness <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Sta23</a>, <a href="https://stacks.math.columbia.edu/tag/0CLK" title="" class="ltx_ref ltx_href">Tag 0CLK</a>]</cite> in the case of complete discrete valuation rings.</span></p>
</div>
</div>
<div id="S5.SS1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS1.p19" class="ltx_para">
<p id="S5.SS1.p19.1" class="ltx_p"><span id="S5.SS1.p19.1.1" class="ltx_text">Let <math id="S5.SS1.p19.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> be a discrete valuation <math id="S5.SS1.p19.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-algebra, with fraction field <math id="S5.SS1.p19.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Let <math id="S5.SS1.p19.m4" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S5.SS1.p19.m5" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S5.SS1.p19.m6" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. We will use the notation from Lemma <a href="#S5.Thmthm1" title="Lemma 5.1. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>. By Lemma <a href="#S5.Thmthm1" title="Lemma 5.1. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, it suffices to find a finite extension <math id="S5.SS1.p19.m7" class="ltx_Math" alttext="R^{\prime}\supset R" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>′</mo></msup><mo>⊃</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">R^{\prime}\supset R</annotation></semantics></math> of discrete valuation rings such that the base-change <math id="S5.SS1.p19.m8" class="ltx_Math" alttext="\mathcal{P}_{K^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><msup><mi>K</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">\mathcal{P}_{K^{\prime}}</annotation></semantics></math> on the generic point <math id="S5.SS1.p19.m9" class="ltx_Math" alttext="\eta_{K^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><msup><mi>K</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">\eta_{K^{\prime}}</annotation></semantics></math> of <math id="S5.SS1.p19.m10" class="ltx_Math" alttext="\Spec(\mathcal{O}_{X_{R^{\prime}},\eta_{\kappa^{\prime}}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><msup><mi>R</mi><mo>′</mo></msup></msub><mo>,</mo><msub><mi>η</mi><msup><mi>κ</mi><mo>′</mo></msup></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\mathcal{O}_{X_{R^{\prime}},\eta_{\kappa^{\prime}}})</annotation></semantics></math> admits an extension to a <math id="S5.SS1.p19.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S5.SS1.p19.m12" class="ltx_Math" alttext="\widetilde{\mathcal{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\mathcal{P}}</annotation></semantics></math> on the whole <math id="S5.SS1.p19.m13" class="ltx_Math" alttext="\Spec(\mathcal{O}_{X_{R^{\prime}},\eta_{\kappa^{\prime}}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><msup><mi>R</mi><mo>′</mo></msup></msub><mo>,</mo><msub><mi>η</mi><msup><mi>κ</mi><mo>′</mo></msup></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\mathcal{O}_{X_{R^{\prime}},\eta_{\kappa^{\prime}}})</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p20" class="ltx_para">
<p id="S5.SS1.p20.1" class="ltx_p"><span id="S5.SS1.p20.1.1" class="ltx_text">We can replace <math id="S5.SS1.p20.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> with <math id="S5.SS1.p20.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> in order to assume that <math id="S5.SS1.p20.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> is the ground field. By the Cohen structure theorem, we have <math id="S5.SS1.p20.m4" class="ltx_Math" alttext="R=\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>π</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R=\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]</annotation></semantics></math>. After replacing <math id="S5.SS1.p20.m5" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> with a finite extension <math id="S5.SS1.p20.m6" class="ltx_Math" alttext="\kappa^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\kappa^{\prime}</annotation></semantics></math>, we can assume that <math id="S5.SS1.p20.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is split. Set <math id="S5.SS1.p20.m8" class="ltx_Math" alttext="S=\mathcal{O}_{X_{R},\eta_{\kappa}}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">S=\mathcal{O}_{X_{R},\eta_{\kappa}}</annotation></semantics></math>. Note that <math id="S5.SS1.p20.m9" class="ltx_Math" alttext="S\supset R" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊃</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">S\supset R</annotation></semantics></math> is a discrete valuation ring with uniformizer <math id="S5.SS1.p20.m10" class="ltx_Math" alttext="\pi\in R" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\pi\in R</annotation></semantics></math>. Let <math id="S5.SS1.p20.m11" class="ltx_Math" alttext="\widehat{S}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover><annotation encoding="application/x-tex">\widehat{S}</annotation></semantics></math> denote the completion <math id="S5.SS1.p20.m12" class="ltx_Math" alttext="\widehat{\mathcal{O}}_{X_{R},\eta_{\kappa}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo mathsize="0.800em">^</mo></mover><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><annotation encoding="application/x-tex">\widehat{\mathcal{O}}_{X_{R},\eta_{\kappa}}</annotation></semantics></math>. Let <math id="S5.SS1.p20.m13" class="ltx_Math" alttext="\widehat{\mathcal{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo mathsize="0.800em">^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathcal{P}}</annotation></semantics></math> denote the base change of <math id="S5.SS1.p20.m14" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> to <math id="S5.SS1.p20.m15" class="ltx_Math" alttext="\Spec(\Frac(\widehat{S}))" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathsize="0.800em">Frac</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\Frac(\widehat{S}))</annotation></semantics></math>. We have that <math id="S5.SS1.p20.m16" class="ltx_Math" alttext="\widehat{S}=\kappa_{S}[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover><mo>=</mo><mrow><msub><mi>κ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>π</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{S}=\kappa_{S}[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]</annotation></semantics></math>, where <math id="S5.SS1.p20.m17" class="ltx_Math" alttext="\kappa_{S}\supset\kappa" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>S</mi></msub><mo>⊃</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">\kappa_{S}\supset\kappa</annotation></semantics></math> is the residue field of <math id="S5.SS1.p20.m18" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> (equivalently <math id="S5.SS1.p20.m19" class="ltx_Math" alttext="\kappa_{S}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\kappa_{S}</annotation></semantics></math> is the fraction field of the special fiber <math id="S5.SS1.p20.m20" class="ltx_Math" alttext="X_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">X_{\kappa}</annotation></semantics></math>).</span></p>
</div>
<div id="S5.SS1.p21" class="ltx_para">
<p id="S5.SS1.p21.1" class="ltx_p"><span id="S5.SS1.p21.1.1" class="ltx_text">By formal gluing (Lemma <a href="#S5.Thmthm6" title="Lemma 5.6. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.6</span></a> applied to <math id="S5.SS1.p21.m1" class="ltx_Math" alttext="S\to\widehat{S}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">→</mo><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover></mrow><annotation encoding="application/x-tex">S\to\widehat{S}</annotation></semantics></math> and <math id="S5.SS1.p21.m2" class="ltx_Math" alttext="f=\pi" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mi>π</mi></mrow><annotation encoding="application/x-tex">f=\pi</annotation></semantics></math>), extending <math id="S5.SS1.p21.m3" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> to <math id="S5.SS1.p21.m4" class="ltx_Math" alttext="\Spec(S)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(S)</annotation></semantics></math> is equivalent to extending <math id="S5.SS1.p21.m5" class="ltx_Math" alttext="\widehat{\mathcal{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo mathsize="0.800em">^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathcal{P}}</annotation></semantics></math> to <math id="S5.SS1.p21.m6" class="ltx_Math" alttext="\Spec(\widehat{S})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\widehat{S})</annotation></semantics></math>. Indeed, such an extension <math id="S5.SS1.p21.m7" class="ltx_Math" alttext="(\widehat{\mathcal{P}})^{\sim}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo mathsize="0.800em">^</mo></mover><mo stretchy="false">)</mo></mrow><mo>∼</mo></msup><annotation encoding="application/x-tex">(\widehat{\mathcal{P}})^{\sim}</annotation></semantics></math> to <math id="S5.SS1.p21.m8" class="ltx_Math" alttext="\Spec(\widehat{S})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\widehat{S})</annotation></semantics></math> yields a triple <math id="S5.SS1.p21.m9" class="ltx_Math" alttext="(\mathcal{P},(\widehat{\mathcal{P}})^{\sim},\varphi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo mathsize="0.800em">^</mo></mover><mo stretchy="false">)</mo></mrow><mo>∼</mo></msup><mo>,</mo><mi>φ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{P},(\widehat{\mathcal{P}})^{\sim},\varphi)</annotation></semantics></math>, which by Lemma <a href="#S5.Thmthm6" title="Lemma 5.6. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.6</span></a> glues to an extension of <math id="S5.SS1.p21.m10" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> over <math id="S5.SS1.p21.m11" class="ltx_Math" alttext="\Spec(S)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(S)</annotation></semantics></math>. Hence we may replace <math id="S5.SS1.p21.m12" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> with <math id="S5.SS1.p21.m13" class="ltx_Math" alttext="\widehat{S}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover><annotation encoding="application/x-tex">\widehat{S}</annotation></semantics></math>. Note that we are allowed to replace <math id="S5.SS1.p21.m14" class="ltx_Math" alttext="\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>π</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]</annotation></semantics></math> with a finite totally ramified extension <math id="S5.SS1.p21.m15" class="ltx_Math" alttext="\kappa[\hskip-1.42262pt[{\pi^{\frac{1}{m}}}]\hskip-1.42262pt]" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa[\hskip-1.42262pt[{\pi^{\frac{1}{m}}}]\hskip-1.42262pt]</annotation></semantics></math> for some <math id="S5.SS1.p21.m16" class="ltx_Math" alttext="m\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m\geq 1</annotation></semantics></math>. This replaces <math id="S5.SS1.p21.m17" class="ltx_Math" alttext="\widehat{S}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>S</mi><mo mathsize="0.800em">^</mo></mover><annotation encoding="application/x-tex">\widehat{S}</annotation></semantics></math> with <math id="S5.SS1.p21.m18" class="ltx_Math" alttext="\kappa_{S}[\hskip-1.42262pt[{\pi^{\frac{1}{m}}}]\hskip-1.42262pt]" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{S}[\hskip-1.42262pt[{\pi^{\frac{1}{m}}}]\hskip-1.42262pt]</annotation></semantics></math>. The theorem is therefore implied by Proposition <a href="#S5.Thmthm2" title="Proposition 5.2. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> (by taking <math id="S5.SS1.p21.m19" class="ltx_Math" alttext="\kappa=\kappa_{S}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>=</mo><msub><mi>κ</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">\kappa=\kappa_{S}</annotation></semantics></math> in that proposition).
∎</span></p>
</div>
</div>
<div id="S5.SS1.p22" class="ltx_para">
<p id="S5.SS1.p22.1" class="ltx_p">Since the semistable locus <math id="S5.SS1.p22.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss}</annotation></semantics></math> comes from a <math id="S5.SS1.p22.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification, we automatically have semistable reduction for <math id="S5.SS1.p22.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AHLH23</a>, Thm. 6.5, Cor. 6.12]</cite>. We record this result as a separate theorem.</p>
</div>
<div id="S5.Thmthm8" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm8.2" class="ltx_text ltx_font_bold">Theorem 5.8</span></span><span id="S5.Thmthm8.3" class="ltx_text ltx_font_bold"> </span>(Semistable Reduction)<span id="S5.Thmthm8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm8.p1" class="ltx_para">
<p id="S5.Thmthm8.p1.1" class="ltx_p"><span id="S5.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">The substack <math id="S5.Thmthm8.p1.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss}</annotation></semantics></math> of Gieseker semistable points satisfies the existence part of the valuative criterion for properness.
∎</span></p>
</div>
</div>
<div id="S5.SS1.p23" class="ltx_para">
<p id="S5.SS1.p23.1" class="ltx_p">The arguments in this subsection yield an interesting result in the case of curves, where <math id="S5.SS1.p23.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves are the same thing as <math id="S5.SS1.p23.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles.</p>
</div>
<div id="S5.Thmthm9" class="ltx_theorem ltx_theorem_coroll">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm9.2" class="ltx_text ltx_font_bold">Corollary 5.9</span></span><span id="S5.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm9.p1" class="ltx_para">
<p id="S5.Thmthm9.p1.1" class="ltx_p"><span id="S5.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmthm9.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a smooth projective geometrically connected curve over a field <math id="S5.Thmthm9.p1.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> of arbitrary characteristic. Let <math id="S5.Thmthm9.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a quasi-split connected reductive group over <math id="S5.Thmthm9.p1.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> satisfying the following two conditions:</span></p>
<ol id="S5.I4" class="ltx_enumerate">
<li id="S5.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I4.i1.p1" class="ltx_para">
<p id="S5.I4.i1.p1.1" class="ltx_p"><span id="S5.I4.i1.p1.1.1" class="ltx_text ltx_font_italic">The maximal central torus of </span><math id="S5.I4.i1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S5.I4.i1.p1.1.2" class="ltx_text ltx_font_italic"> is split over </span><math id="S5.I4.i1.p1.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math><span id="S5.I4.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S5.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I4.i2.p1" class="ltx_para">
<p id="S5.I4.i2.p1.1" class="ltx_p"><span id="S5.I4.i2.p1.1.1" class="ltx_text ltx_font_italic">Let </span><math id="S5.I4.i2.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="S5.I4.i2.p1.1.2" class="ltx_text ltx_font_italic"> denote the kernel of of the simply-connected cover </span><math id="S5.I4.i2.p1.m2" class="ltx_Math" alttext="\widetilde{[G,G]}\rightarrow[G,G]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mo stretchy="false">[</mo><mi>G</mi><mo>,</mo><mi>G</mi><mo stretchy="false">]</mo></mrow><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mi>G</mi><mo>,</mo><mi>G</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{[G,G]}\rightarrow[G,G]</annotation></semantics></math><span id="S5.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> of the derived subgroup of </span><math id="S5.I4.i2.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S5.I4.i2.p1.1.4" class="ltx_text ltx_font_italic">. Then, the characteristic of </span><math id="S5.I4.i2.p1.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math><span id="S5.I4.i2.p1.1.5" class="ltx_text ltx_font_italic"> does not divide the order of </span><math id="S5.I4.i2.p1.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="S5.I4.i2.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S5.Thmthm9.p1.2" class="ltx_p"><span id="S5.Thmthm9.p1.2.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmthm9.p1.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> be a complete discrete valuation ring over <math id="S5.Thmthm9.p1.m6" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> with fraction field <math id="S5.Thmthm9.p1.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Suppose that the residue field of <math id="S5.Thmthm9.p1.m8" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is perfect. Let <math id="S5.Thmthm9.p1.m9" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> be a <math id="S5.Thmthm9.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on the generic fiber <math id="S5.Thmthm9.p1.m11" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. Then, after maybe taking a root of the uniformizer of <math id="S5.Thmthm9.p1.m12" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, we can extend <math id="S5.Thmthm9.p1.m13" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> to a <math id="S5.Thmthm9.p1.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S5.Thmthm9.p1.m15" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS1.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS1.p24" class="ltx_para">
<p id="S5.SS1.p24.1" class="ltx_p"><span id="S5.SS1.p24.1.1" class="ltx_text">This follows by applying the proof of Lemma <a href="#S5.Thmthm1" title="Lemma 5.1. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, using formal gluing as in Theorem <a href="#S5.Thmthm7" title="Theorem 5.7. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.7</span></a> and then applying Proposition <a href="#S5.Thmthm2" title="Proposition 5.2. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2. </span>The degree of a <math id="S5.SS2.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf</h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.1" class="ltx_p">Fix the choice of an algebraic closure <math id="S5.SS2.p1.m1" class="ltx_Math" alttext="\overline{k}\supset k" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\overline{k}\supset k</annotation></semantics></math>. We denote by <math id="S5.SS2.p1.m2" class="ltx_Math" alttext="\Gamma_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Gamma_{k}</annotation></semantics></math> the absolute Galois group <math id="S5.SS2.p1.m3" class="ltx_Math" alttext="\Gamma_{k}\vcentcolon=\Gal(\overline{k}/k)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><mo>:=</mo><mrow><mi mathsize="0.800em">Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover><mo>/</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{k}\vcentcolon=\Gal(\overline{k}/k)</annotation></semantics></math>. Let <math id="S5.SS2.p1.m4" class="ltx_Math" alttext="X^{*}(G_{\overline{k}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X^{*}(G_{\overline{k}})</annotation></semantics></math> be the group of characters of the base-change <math id="S5.SS2.p1.m5" class="ltx_Math" alttext="G_{\overline{k}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><annotation encoding="application/x-tex">G_{\overline{k}}</annotation></semantics></math>. Let <math id="S5.SS2.p1.m6" class="ltx_Math" alttext="X^{*}(G_{\overline{k}})^{\vee}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo stretchy="false">)</mo></mrow><mo>∨</mo></msup></mrow><annotation encoding="application/x-tex">X^{*}(G_{\overline{k}})^{\vee}</annotation></semantics></math> denote the dual group <math id="S5.SS2.p1.m7" class="ltx_Math" alttext="\Hom\left(X^{*}(G_{\overline{k}}),\,\mathbb{Z}\right)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Hom</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.297em">,</mo><mi>ℤ</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\Hom\left(X^{*}(G_{\overline{k}}),\,\mathbb{Z}\right)</annotation></semantics></math>. This group admits a natural continuous action of the profinite absolute Galois group <math id="S5.SS2.p1.m8" class="ltx_Math" alttext="\Gamma_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Gamma_{k}</annotation></semantics></math>. We write <math id="S5.SS2.p1.m9" class="ltx_Math" alttext="\Lambda(G)\vcentcolon=\left(X^{*}(G_{\overline{k}})^{\vee}\right)_{\Gamma_{k}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msub><mrow><mo>(</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo stretchy="false">)</mo></mrow><mo>∨</mo></msup></mrow><mo>)</mo></mrow><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">\Lambda(G)\vcentcolon=\left(X^{*}(G_{\overline{k}})^{\vee}\right)_{\Gamma_{k}}</annotation></semantics></math> to denote the quotient group of <math id="S5.SS2.p1.m10" class="ltx_Math" alttext="\Gamma_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Gamma_{k}</annotation></semantics></math>-coinvariants of <math id="S5.SS2.p1.m11" class="ltx_Math" alttext="(X^{*}(G_{\overline{k}}))^{\vee}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>∨</mo></msup><annotation encoding="application/x-tex">(X^{*}(G_{\overline{k}}))^{\vee}</annotation></semantics></math>. Note that <math id="S5.SS2.p1.m12" class="ltx_Math" alttext="\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Lambda(G)</annotation></semantics></math> does not depend on the choice of algebraic closure <math id="S5.SS2.p1.m13" class="ltx_Math" alttext="\overline{k}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{k}</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmthm10" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm10.2" class="ltx_text ltx_font_bold">Example 5.10</span></span><span id="S5.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm10.p1" class="ltx_para">
<p id="S5.Thmthm10.p1.1" class="ltx_p"><span id="S5.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">If the group <math id="S5.Thmthm10.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is split over <math id="S5.Thmthm10.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, then <math id="S5.Thmthm10.p1.m3" class="ltx_Math" alttext="X^{*}(G_{\overline{k}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X^{*}(G_{\overline{k}})</annotation></semantics></math> coincides with the group <math id="S5.Thmthm10.p1.m4" class="ltx_Math" alttext="X^{*}(G)" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X^{*}(G)</annotation></semantics></math> of characters defined over <math id="S5.Thmthm10.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. The action of the Galois group <math id="S5.Thmthm10.p1.m6" class="ltx_Math" alttext="\Gamma_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Gamma_{k}</annotation></semantics></math> on <math id="S5.Thmthm10.p1.m7" class="ltx_Math" alttext="X^{*}(G)" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X^{*}(G)</annotation></semantics></math> is trivial. Therefore <math id="S5.Thmthm10.p1.m8" class="ltx_Math" alttext="\Lambda(G)=X^{*}(G)^{\vee}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mo>∨</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\Lambda(G)=X^{*}(G)^{\vee}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.Thmthm11" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm11.2" class="ltx_text ltx_font_bold">Example 5.11</span></span><span id="S5.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm11.p1" class="ltx_para">
<p id="S5.Thmthm11.p1.1" class="ltx_p"><span id="S5.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">If the group <math id="S5.Thmthm11.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is semisimple, then <math id="S5.Thmthm11.p1.m2" class="ltx_Math" alttext="\Lambda(G)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Lambda(G)=0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS2.p2" class="ltx_para">
<p id="S5.SS2.p2.1" class="ltx_p">Let <math id="S5.SS2.p2.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be an arbitrary algebraically closed field extension and let <math id="S5.SS2.p2.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S5.SS2.p2.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S5.SS2.p2.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. Let <math id="S5.SS2.p2.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be any big open subset of <math id="S5.SS2.p2.m6" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> where <math id="S5.SS2.p2.m7" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is locally-free and denote by <math id="S5.SS2.p2.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> be the open inclusion <math id="S5.SS2.p2.m9" class="ltx_Math" alttext="j:U\hookrightarrow X_{K}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">↪</mo><msub><mi>X</mi><mi>K</mi></msub></mrow></mrow><annotation encoding="application/x-tex">j:U\hookrightarrow X_{K}</annotation></semantics></math>. If <math id="S5.SS2.p2.m10" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is the corresponding <math id="S5.SS2.p2.m11" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math>-bundle on <math id="S5.SS2.p2.m12" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, then for any character <math id="S5.SS2.p2.m13" class="ltx_Math" alttext="\chi\in X^{*}(G_{K})" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>∈</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>K</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi\in X^{*}(G_{K})</annotation></semantics></math> we can form the associated line bundle <math id="S5.SS2.p2.m14" class="ltx_Math" alttext="\mathcal{G}\times^{G_{K}}\chi" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mi>K</mi></msub></msup><mi>χ</mi></mrow><annotation encoding="application/x-tex">\mathcal{G}\times^{G_{K}}\chi</annotation></semantics></math> over <math id="S5.SS2.p2.m15" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. Since <math id="S5.SS2.p2.m16" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> is smooth, the pushforward <math id="S5.SS2.p2.m17" class="ltx_Math" alttext="j_{*}(\mathcal{G}\times^{G_{K}}\chi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mi>K</mi></msub></msup><mi>χ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">j_{*}(\mathcal{G}\times^{G_{K}}\chi)</annotation></semantics></math> is a line bundle on <math id="S5.SS2.p2.m18" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> whose first Chern class is <math id="S5.SS2.p2.m19" class="ltx_Math" alttext="c_{1}\left(j_{*}(\mathcal{G}\times^{G_{K}}\chi)\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mi>K</mi></msub></msup><mi>χ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">c_{1}\left(j_{*}(\mathcal{G}\times^{G_{K}}\chi)\right)</annotation></semantics></math>. Let <math id="S5.SS2.p2.m20" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> be the hyperplane class on <math id="S5.SS2.p2.m21" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> corresponding to the line bundle <math id="S5.SS2.p2.m22" class="ltx_Math" alttext="\mathcal{O}_{X}(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}_{X}(1)</annotation></semantics></math> and define the group homomorphism (c.f Lemma <a href="#S4.Thmthm24" title="Lemma 4.24. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.24</span></a>):</p>
<table id="S5.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex83.m1" class="ltx_Math" alttext="\psi:X^{*}(G_{K})\rightarrow\mathbb{Z},\;\;\psi(\chi)\vcentcolon=c_{1}\left(j_{*}(\mathcal{G}\times^{G_{K}}\chi)\right)\cdot H^{d-1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>K</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><mo rspace="0.607em">,</mo><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mi>K</mi></msub></msup><mi>χ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\psi:X^{*}(G_{K})\rightarrow\mathbb{Z},\;\;\psi(\chi)\vcentcolon=c_{1}\left(j_{*}(\mathcal{G}\times^{G_{K}}\chi)\right)\cdot H^{d-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.SS2.p3" class="ltx_para">
<p id="S5.SS2.p3.1" class="ltx_p">If we denote by <math id="S5.SS2.p3.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> the algebraic closure of <math id="S5.SS2.p3.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> in <math id="S5.SS2.p3.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, then base-change induces a canonical identification <math id="S5.SS2.p3.m4" class="ltx_Math" alttext="X^{*}(G_{L})\xrightarrow{\sim}X^{*}(G_{K})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>K</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X^{*}(G_{L})\xrightarrow{\sim}X^{*}(G_{K})</annotation></semantics></math>. Choose an isomorphism <math id="S5.SS2.p3.m5" class="ltx_Math" alttext="\overline{k}\xrightarrow{\sim}L" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mi>L</mi></mrow><annotation encoding="application/x-tex">\overline{k}\xrightarrow{\sim}L</annotation></semantics></math> over <math id="S5.SS2.p3.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. This yields an isomorphism of abelian groups <math id="S5.SS2.p3.m7" class="ltx_Math" alttext="X^{*}(G_{\overline{k}})\xrightarrow{\sim}X^{*}(G_{L})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X^{*}(G_{\overline{k}})\xrightarrow{\sim}X^{*}(G_{L})</annotation></semantics></math> which identifies <math id="S5.SS2.p3.m8" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> with an element of <math id="S5.SS2.p3.m9" class="ltx_Math" alttext="X^{*}(G_{\overline{k}})^{\vee}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo stretchy="false">)</mo></mrow><mo>∨</mo></msup></mrow><annotation encoding="application/x-tex">X^{*}(G_{\overline{k}})^{\vee}</annotation></semantics></math>. Since any two choices of isomorphisms <math id="S5.SS2.p3.m10" class="ltx_Math" alttext="\overline{k}\xrightarrow{\sim}L" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mi>L</mi></mrow><annotation encoding="application/x-tex">\overline{k}\xrightarrow{\sim}L</annotation></semantics></math> differ by an element of the Galois group <math id="S5.SS2.p3.m11" class="ltx_Math" alttext="\Gamma_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Gamma_{k}</annotation></semantics></math>, <math id="S5.SS2.p3.m12" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> yields a well-defined element of the quotient <math id="S5.SS2.p3.m13" class="ltx_Math" alttext="\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Lambda(G)</annotation></semantics></math> that is independent of the choice of <math id="S5.SS2.p3.m14" class="ltx_Math" alttext="\overline{k}\xrightarrow{\sim}L" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mi>L</mi></mrow><annotation encoding="application/x-tex">\overline{k}\xrightarrow{\sim}L</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmthm12" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm12.2" class="ltx_text ltx_font_bold">Definition 5.12</span></span><span id="S5.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm12.p1" class="ltx_para">
<p id="S5.Thmthm12.p1.1" class="ltx_p"><span id="S5.Thmthm12.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmthm12.p1.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be an algebraically closed field extension. Let <math id="S5.Thmthm12.p1.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S5.Thmthm12.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S5.Thmthm12.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. We define the degree <math id="S5.Thmthm12.p1.m5" class="ltx_Math" alttext="\deg\,(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mi>deg</mi><mo lspace="0.130em">⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\deg\,(\mathcal{F},\sigma)</annotation></semantics></math> to be the element <math id="S5.Thmthm12.p1.m6" class="ltx_Math" alttext="\vartheta\in\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi>ϑ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vartheta\in\Lambda(G)</annotation></semantics></math> constructed above. For an arbitrary field extension <math id="S5.Thmthm12.p1.m7" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math>, we set <math id="S5.Thmthm12.p1.m8" class="ltx_Math" alttext="\deg\,(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mi>deg</mi><mo lspace="0.130em">⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\deg\,(\mathcal{F},\sigma)</annotation></semantics></math> to be <math id="S5.Thmthm12.p1.m9" class="ltx_Math" alttext="\deg\,(\mathcal{F}|_{X_{\widetilde{K}}},\sigma|_{X_{\widetilde{K}}})" display="inline" intent=":literal"><semantics><mrow><mi>deg</mi><mo lspace="0.130em">⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mover accent="true"><mi>K</mi><mo mathsize="1.600em">~</mo></mover></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mover accent="true"><mi>K</mi><mo mathsize="1.600em">~</mo></mover></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\deg\,(\mathcal{F}|_{X_{\widetilde{K}}},\sigma|_{X_{\widetilde{K}}})</annotation></semantics></math> for any choice of an algebraically closed field extension <math id="S5.Thmthm12.p1.m10" class="ltx_Math" alttext="\widetilde{K}\supset K" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>K</mi><mo mathsize="0.800em">~</mo></mover><mo>⊃</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">\widetilde{K}\supset K</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.Thmthm13" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm13.2" class="ltx_text ltx_font_bold">Proposition 5.13</span></span><span id="S5.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm13.p1" class="ltx_para">
<p id="S5.Thmthm13.p1.1" class="ltx_p"><span id="S5.Thmthm13.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmthm13.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="S5.Thmthm13.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme and let <math id="S5.Thmthm13.p1.m3" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S5.Thmthm13.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S5.Thmthm13.p1.m5" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>. Let <math id="S5.Thmthm13.p1.m6" class="ltx_Math" alttext="\deg:S\rightarrow\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi>deg</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\deg:S\rightarrow\Lambda(G)</annotation></semantics></math> denote the function defined by <math id="S5.Thmthm13.p1.m7" class="ltx_Math" alttext="\deg(s)\vcentcolon=\deg\,(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>deg</mi><mo lspace="0.130em">⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\deg(s)\vcentcolon=\deg\,(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math>.
Then <math id="S5.Thmthm13.p1.m8" class="ltx_Math" alttext="\deg" display="inline" intent=":literal"><semantics><mi>deg</mi><annotation encoding="application/x-tex">\deg</annotation></semantics></math> is locally constant on <math id="S5.Thmthm13.p1.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.p4" class="ltx_para">
<p id="S5.SS2.p4.1" class="ltx_p"><span id="S5.SS2.p4.1.1" class="ltx_text">Since the stack <math id="S5.SS2.p4.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> is locally of finite type over <math id="S5.SS2.p4.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, we can reduce to the case when <math id="S5.SS2.p4.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is of finite type over <math id="S5.SS2.p4.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Given that the notion of degree is well-behaved under taking field extensions, we can replace <math id="S5.SS2.p4.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> with an algebraic closure to assume that the ground field is algebraically closed and, hence <math id="S5.SS2.p4.m6" class="ltx_Math" alttext="\Gamma_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Gamma_{k}</annotation></semantics></math> is trivial.</span></p>
</div>
<div id="S5.SS2.p5" class="ltx_para">
<p id="S5.SS2.p5.1" class="ltx_p"><span id="S5.SS2.p5.1.1" class="ltx_text">Let <math id="S5.SS2.p5.m1" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be a big open subset of <math id="S5.SS2.p5.m2" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math> where <math id="S5.SS2.p5.m3" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is locally-free and denote by <math id="S5.SS2.p5.m4" class="ltx_Math" alttext="j:U\hookrightarrow X_{S}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">↪</mo><msub><mi>X</mi><mi>S</mi></msub></mrow></mrow><annotation encoding="application/x-tex">j:U\hookrightarrow X_{S}</annotation></semantics></math> the open immersion. For each point <math id="S5.SS2.p5.m5" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math>, let <math id="S5.SS2.p5.m6" class="ltx_Math" alttext="j_{s}" display="inline" intent=":literal"><semantics><msub><mi>j</mi><mi>s</mi></msub><annotation encoding="application/x-tex">j_{s}</annotation></semantics></math> be the base-change <math id="S5.SS2.p5.m7" class="ltx_Math" alttext="j_{s}:U_{s}\hookrightarrow X_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>U</mi><mi>s</mi></msub><mo stretchy="false">↪</mo><msub><mi>X</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">j_{s}:U_{s}\hookrightarrow X_{s}</annotation></semantics></math>. Denote by <math id="S5.SS2.p5.m8" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> the corresponding <math id="S5.SS2.p5.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S5.SS2.p5.m10" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. Let <math id="S5.SS2.p5.m11" class="ltx_Math" alttext="\chi\in X^{*}(G)" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>∈</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi\in X^{*}(G)</annotation></semantics></math> be a character of <math id="S5.SS2.p5.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and denote by <math id="S5.SS2.p5.m13" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> the associated line bundle <math id="S5.SS2.p5.m14" class="ltx_Math" alttext="\mathcal{G}\times^{G}\chi" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msup><mi>χ</mi></mrow><annotation encoding="application/x-tex">\mathcal{G}\times^{G}\chi</annotation></semantics></math> on <math id="S5.SS2.p5.m15" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. We want to show that the function <math id="S5.SS2.p5.m16" class="ltx_Math" alttext="f:S\rightarrow\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">f:S\rightarrow\mathbb{Z}</annotation></semantics></math> given by</span></p>
<table id="S5.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex84.m1" class="ltx_Math" alttext="f(s)\vcentcolon=c_{1}\left((j_{s})_{*}(\mathcal{L}|_{U_{s}})\right)\cdot H^{d-1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>j</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">|</mo></mrow><msub><mi>U</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f(s)\vcentcolon=c_{1}\left((j_{s})_{*}(\mathcal{L}|_{U_{s}})\right)\cdot H^{d-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p5.2" class="ltx_p"><span id="S5.SS2.p5.2.1" class="ltx_text">is locally constant on <math id="S5.SS2.p5.m17" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS2.p6" class="ltx_para">
<p id="S5.SS2.p6.1" class="ltx_p"><span id="S5.SS2.p6.1.1" class="ltx_text">We first claim that <math id="S5.SS2.p6.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is constructible on <math id="S5.SS2.p6.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. By Noetherian induction <span id="footnote7" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">7</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">7</sup>
                  <span class="ltx_tag ltx_tag_note">7</span>
                  
                  
                  
                  
                  
                  
                  
                By Noetherianity, there is a minimal closed subscheme <math id="footnote7.m1" class="ltx_Math" alttext="Z\subset S" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">Z\subset S</annotation></semantics></math> such that the restriction of <math id="footnote7.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> to <math id="footnote7.m3" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> is constructible. By looking at the irreducible components and passing to the reduced subscheme, we may assume that <math id="footnote7.m4" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> is integral. If we show that <math id="footnote7.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is constant on an open <math id="footnote7.m6" class="ltx_Math" alttext="U\subset Z" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">U\subset Z</annotation></semantics></math>, then constructibility on <math id="footnote7.m7" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> will follow from the constructibility on <math id="footnote7.m8" class="ltx_Math" alttext="Z\setminus U" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>∖</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">Z\setminus U</annotation></semantics></math> (by minimality) and on <math id="footnote7.m9" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.</span></span></span> we need to prove that if <math id="S5.SS2.p6.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is integral then <math id="S5.SS2.p6.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is constant on an open subset of <math id="S5.SS2.p6.m5" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. Assume that <math id="S5.SS2.p6.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is integral. Since <math id="S5.SS2.p6.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is perfect, there exists an open dense subset of <math id="S5.SS2.p6.m8" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> that is smooth over <math id="S5.SS2.p6.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Therefore we can reduce to the case when <math id="S5.SS2.p6.m10" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is a smooth variety. For each <math id="S5.SS2.p6.m11" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math>, consider the following Cartesian diagram</span></p>
<table id="S5.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S5.Ex85.m1.pic1" class="ltx_picture ltx_markedasmath" height="68.22" overflow="visible" style="vertical-align:-34.11px" version="1.1" viewBox="0 0 123.74 68.22" width="123.74"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,68.22) matrix(1 0 0 -1 0 0) translate(61.87,0) translate(0,34.11)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -61.87 -26.97)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 68.23)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 14.52)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0.8 0) translate(21.31,0) matrix(1.0 0.0 0.0 1.0 -15.35 0)"><foreignObject style="--ltx-fo-width:1.22em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces U_{s}}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces U_{s}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 49.02 0) translate(51.56,0) matrix(1.0 0.0 0.0 1.0 -12.4 0)"><foreignObject style="--ltx-fo-width:0.79em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces U}" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces U}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 61.09)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(22.11,0) matrix(1.0 0.0 0.0 1.0 -16.15 0)"><foreignObject style="--ltx-fo-width:1.33em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="18.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces X_{s}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces X_{s}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 44.22 0) translate(56.37,0) matrix(1.0 0.0 0.0 1.0 -17.2 0)"><foreignObject style="--ltx-fo-width:1.49em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="20.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces X_{S}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces X_{S}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -18.18 23.05 L 19.53 23.05"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 19.8 23.05)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -39.76 12.18 L -39.76 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -39.76 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -36.51 -2.26)"><foreignObject style="--ltx-fo-width:0.76em;--ltx-fo-height:0.46em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.29" overflow="visible" transform="matrix(1 0 0 -1 0 6.41)" width="10.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces j_{s}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">j</mi><mi mathsize="0.710em">s</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces j_{s}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 38.71 14.25 L 38.71 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 38.71 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 41.97 -1.23)"><foreignObject style="--ltx-fo-width:0.37em;--ltx-fo-height:0.46em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.29" overflow="visible" transform="matrix(1 0 0 -1 0 6.41)" width="5.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces j}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">j</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces j}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -17.38 -23.51 L 14.72 -23.51"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 15 -23.51)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p6.2" class="ltx_p"><span id="S5.SS2.p6.2.1" class="ltx_text">We get an induced base-change morphism of quasicoherent sheaves <math id="S5.SS2.p6.m12" class="ltx_Math" alttext="\varphi:j_{*}(\mathcal{L})|_{X_{s}}\rightarrow(j_{s})_{*}\left(\mathcal{L}|_{U_{s}}\right)" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">→</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>j</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">|</mo></mrow><msub><mi>U</mi><mi>s</mi></msub></msub><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi:j_{*}(\mathcal{L})|_{X_{s}}\rightarrow(j_{s})_{*}\left(\mathcal{L}|_{U_{s}}\right)</annotation></semantics></math> where the right-hand side is a line bundle. Since <math id="S5.SS2.p6.m13" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is smooth over <math id="S5.SS2.p6.m14" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="S5.SS2.p6.m15" class="ltx_Math" alttext="X_{S}\rightarrow S" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>S</mi></msub><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">X_{S}\rightarrow S</annotation></semantics></math> is a smooth morphism, we conclude that <math id="S5.SS2.p6.m16" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math> is also smooth over <math id="S5.SS2.p6.m17" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, so <math id="S5.SS2.p6.m18" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math> is a regular scheme. The complement of the open subset <math id="S5.SS2.p6.m19" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> has codimension <math id="S5.SS2.p6.m20" class="ltx_Math" alttext="\geq 2" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\geq 2</annotation></semantics></math> inside <math id="S5.SS2.p6.m21" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>, therefore the pushforward <math id="S5.SS2.p6.m22" class="ltx_Math" alttext="j_{*}(\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">j_{*}(\mathcal{L})</annotation></semantics></math> is a line bundle. It follows that <math id="S5.SS2.p6.m23" class="ltx_Math" alttext="j_{*}(\mathcal{L})|_{X_{s}}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">j_{*}(\mathcal{L})|_{X_{s}}</annotation></semantics></math> is a line bundle, and so <math id="S5.SS2.p6.m24" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> is a morphism of line bundles on <math id="S5.SS2.p6.m25" class="ltx_Math" alttext="X_{s}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>s</mi></msub><annotation encoding="application/x-tex">X_{s}</annotation></semantics></math>. Note that the restriction of <math id="S5.SS2.p6.m26" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> to the big open subset <math id="S5.SS2.p6.m27" class="ltx_Math" alttext="U_{s}\subset X_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>s</mi></msub><mo>⊂</mo><msub><mi>X</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">U_{s}\subset X_{s}</annotation></semantics></math> is an isomorphism by construction. We conclude that <math id="S5.SS2.p6.m28" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> must be an isomorphism of line bundles. This shows that we can equivalently write <math id="S5.SS2.p6.m29" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> as</span></p>
<table id="S5.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex86.m1" class="ltx_Math" alttext="f(s)=c_{1}\left((j_{*}\mathcal{L})|_{X_{s}}\right)\cdot H^{d-1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f(s)=c_{1}\left((j_{*}\mathcal{L})|_{X_{s}}\right)\cdot H^{d-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p6.3" class="ltx_p"><span id="S5.SS2.p6.3.1" class="ltx_text">Since <math id="S5.SS2.p6.m30" class="ltx_Math" alttext="j_{*}\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">j_{*}\mathcal{L}</annotation></semantics></math> is a line bundle its first Chern class is locally constant in families, then <math id="S5.SS2.p6.m31" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is constant on the variety <math id="S5.SS2.p6.m32" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. This concludes the proof that <math id="S5.SS2.p6.m33" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is constructible.</span></p>
</div>
<div id="S5.SS2.p7" class="ltx_para">
<p id="S5.SS2.p7.1" class="ltx_p"><span id="S5.SS2.p7.1.1" class="ltx_text">In order to show that <math id="S5.SS2.p7.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is locally constant, it suffices to check that <math id="S5.SS2.p7.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is constant when the base <math id="S5.SS2.p7.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is of the form <math id="S5.SS2.p7.m4" class="ltx_Math" alttext="\Spec(R)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(R)</annotation></semantics></math> for some discrete valuation ring <math id="S5.SS2.p7.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. In this case <math id="S5.SS2.p7.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is a regular integral scheme. Since <math id="S5.SS2.p7.m7" class="ltx_Math" alttext="X_{S}\rightarrow S" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>S</mi></msub><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">X_{S}\rightarrow S</annotation></semantics></math> is smooth, it follows that <math id="S5.SS2.p7.m8" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math> is regular <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Sta23</a>, <a href="https://stacks.math.columbia.edu/tag/07NF" title="" class="ltx_ref ltx_href">Tag 07NF</a>]</cite> and we can apply the same argument as in the proof of constructibility to see that <math id="S5.SS2.p7.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is constant on <math id="S5.SS2.p7.m10" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S5.SS2.p8" class="ltx_para">
<p id="S5.SS2.p8.1" class="ltx_p">As a consequence of Proposition <a href="#S5.Thmthm13" title="Proposition 5.13. ‣ 5.2. The degree of a 
          
            ρ
          
        -sheaf ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.13</span></a>, we have the following.</p>
</div>
<div id="S5.Thmthm14" class="ltx_theorem ltx_theorem_coroll">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm14.2" class="ltx_text ltx_font_bold">Corollary 5.14</span></span><span id="S5.Thmthm14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm14.p1" class="ltx_para">
<p id="S5.Thmthm14.p1.1" class="ltx_p"><span id="S5.Thmthm14.p1.1.1" class="ltx_text ltx_font_italic">For every <math id="S5.Thmthm14.p1.m1" class="ltx_Math" alttext="\vartheta\in\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi>ϑ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vartheta\in\Lambda(G)</annotation></semantics></math>, there exists an open and closed substack <math id="S5.Thmthm14.p1.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)_{\vartheta}\subset\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi></msub></mrow><mo>⊂</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)_{\vartheta}\subset\Bun_{\rho}(X)</annotation></semantics></math> parametrizing <math id="S5.Thmthm14.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves with degree <math id="S5.Thmthm14.p1.m4" class="ltx_Math" alttext="\vartheta" display="inline" intent=":literal"><semantics><mi>ϑ</mi><annotation encoding="application/x-tex">\vartheta</annotation></semantics></math>. Then</span></p>
<table id="S5.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex87.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)=\bigsqcup_{\vartheta\in\Lambda(G)}\Bun_{\rho}(X)_{\vartheta}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨆</mo><mrow><mi>ϑ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)=\bigsqcup_{\vartheta\in\Lambda(G)}\Bun_{\rho}(X)_{\vartheta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
<section id="S5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.3. </span>Boundedness and moduli space for the semistable locus</h3>

<div id="S5.SS3.p1" class="ltx_para">
<p id="S5.SS3.p1.1" class="ltx_p">Let <math id="S5.SS3.p1.m1" class="ltx_Math" alttext="P\in\mathbb{Q}[n]" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P\in\mathbb{Q}[n]</annotation></semantics></math> be a Hilbert polynomial and let <math id="S5.SS3.p1.m2" class="ltx_Math" alttext="\vartheta\in\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi>ϑ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vartheta\in\Lambda(G)</annotation></semantics></math>. We define <math id="S5.SS3.p1.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P}_{\vartheta}\vcentcolon=\Bun_{\rho}(X)^{ss,P}\cap\Bun_{\rho}(X)_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow><mo>:=</mo><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msup></mrow><mo>∩</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P}_{\vartheta}\vcentcolon=\Bun_{\rho}(X)^{ss,P}\cap\Bun_{\rho}(X)_{\vartheta}</annotation></semantics></math>. By Corollary <a href="#S5.Thmthm14" title="Corollary 5.14. ‣ 5.2. The degree of a 
          
            ρ
          
        -sheaf ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.14</span></a> we get a decomposition of the semistable locus</p>
<table id="S5.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex88.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P}=\bigsqcup_{\vartheta\in\Lambda(G)}\Bun_{\rho}(X)^{ss,P}_{\vartheta}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msup></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨆</mo><mrow><mi>ϑ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P}=\bigsqcup_{\vartheta\in\Lambda(G)}\Bun_{\rho}(X)^{ss,P}_{\vartheta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.p1.2" class="ltx_p">The next proposition shows that each piece <math id="S5.SS3.p1.m4" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P}_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P}_{\vartheta}</annotation></semantics></math> is bounded.</p>
</div>
<div id="S5.Thmthm15" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm15.2" class="ltx_text ltx_font_bold">Proposition 5.15</span></span><span id="S5.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm15.p1" class="ltx_para">
<p id="S5.Thmthm15.p1.1" class="ltx_p"><span id="S5.Thmthm15.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="S5.Thmthm15.p1.m1" class="ltx_Math" alttext="\vartheta\in\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi>ϑ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vartheta\in\Lambda(G)</annotation></semantics></math> and all <math id="S5.Thmthm15.p1.m2" class="ltx_Math" alttext="P\in\mathbb{Q}[n]" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P\in\mathbb{Q}[n]</annotation></semantics></math>, the stack <math id="S5.Thmthm15.p1.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P}_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P}_{\vartheta}</annotation></semantics></math> is quasicompact.</span></p>
</div>
</div>
<div id="S5.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS3.p2" class="ltx_para">
<p id="S5.SS3.p2.1" class="ltx_p"><span id="S5.SS3.p2.1.1" class="ltx_text">After replacing <math id="S5.SS3.p2.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> with a field extension, we can assume that <math id="S5.SS3.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is algebraically closed. Since the forgetful morphism <math id="S5.SS3.p2.m3" class="ltx_Math" alttext="\Forget:\Bun_{\rho}(X)\rightarrow\Coh_{r}^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Forget</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi mathsize="0.800em">Coh</mi><mi>r</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Forget:\Bun_{\rho}(X)\rightarrow\Coh_{r}^{tf}(X)</annotation></semantics></math> is of finite type, it is sufficient to show that the restriction <math id="S5.SS3.p2.m4" class="ltx_math_unparsed" alttext="\Forget|_{\Bun_{\rho}(X)^{ss,P}_{\vartheta}}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Forget</mi><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><msub><mi mathsize="1.140em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow></msub></mrow><annotation encoding="application/x-tex">\Forget|_{\Bun_{\rho}(X)^{ss,P}_{\vartheta}}</annotation></semantics></math> factors through a quasicompact open substack of <math id="S5.SS3.p2.m5" class="ltx_Math" alttext="\Coh_{r}^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">Coh</mi><mi>r</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Coh_{r}^{tf}(X)</annotation></semantics></math>. We shall show that the following set:</span></p>
<table id="S5.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex89.m1" class="ltx_Math" alttext="\mathfrak{S}=\left\{\;\Forget\left((\mathcal{F},\sigma)\right)\;\;\mid\;\;(\mathcal{F},\sigma)\in\Bun_{\rho}(X)^{ss,P}_{\vartheta}(k)\;\right\}" display="block" intent=":literal"><semantics><mrow><mi>𝔖</mi><mo>=</mo><mrow><mo rspace="0.220em">{</mo><mrow><mi mathsize="0.800em">Forget</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.162em">)</mo></mrow></mrow><mo fence="true" rspace="0.440em">∣</mo><mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo rspace="0.220em" stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{S}=\left\{\;\Forget\left((\mathcal{F},\sigma)\right)\;\;\mid\;\;(\mathcal{F},\sigma)\in\Bun_{\rho}(X)^{ss,P}_{\vartheta}(k)\;\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.p2.2" class="ltx_p"><span id="S5.SS3.p2.2.1" class="ltx_text">is a bounded family of torsion-free sheaves.</span></p>
</div>
<div id="S5.SS3.p3" class="ltx_para">
<p id="S5.SS3.p3.1" class="ltx_p"><span id="S5.SS3.p3.1.1" class="ltx_text">Let <math id="S5.SS3.p3.m1" class="ltx_Math" alttext="(\mathcal{F},\sigma)\in\Bun_{\rho}(X)^{ss,P}_{\vartheta}(k)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)\in\Bun_{\rho}(X)^{ss,P}_{\vartheta}(k)</annotation></semantics></math>. We claim that there exists a uniform upper bound <math id="S5.SS3.p3.m2" class="ltx_Math" alttext="\mu_{max}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><annotation encoding="application/x-tex">\mu_{max}</annotation></semantics></math> (only depending on <math id="S5.SS3.p3.m3" class="ltx_Math" alttext="\vartheta" display="inline" intent=":literal"><semantics><mi>ϑ</mi><annotation encoding="application/x-tex">\vartheta</annotation></semantics></math>) such that for all torsion-free subsheaves <math id="S5.SS3.p3.m4" class="ltx_Math" alttext="\mathcal{V}\subset\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>⊂</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">\mathcal{V}\subset\mathcal{F}</annotation></semantics></math> we have <math id="S5.SS3.p3.m5" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{V})\leq\mu_{max}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi>μ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{V})\leq\mu_{max}</annotation></semantics></math>. Since the Hilbert polynomial <math id="S5.SS3.p3.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> of <math id="S5.SS3.p3.m7" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is fixed, it will follow that the family <math id="S5.SS3.p3.m8" class="ltx_Math" alttext="\mathfrak{S}" display="inline" intent=":literal"><semantics><mi>𝔖</mi><annotation encoding="application/x-tex">\mathfrak{S}</annotation></semantics></math> is bounded by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx30" title="" class="ltx_ref">HL97</a>, Thm. 3.3.7]</cite>.</span></p>
</div>
<div id="S5.SS3.p4" class="ltx_para">
<p id="S5.SS3.p4.1" class="ltx_p"><span id="S5.SS3.p4.1.1" class="ltx_text">We are left to show the claim. Since <math id="S5.SS3.p4.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a reductive group over <math id="S5.SS3.p4.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> of characteristic <math id="S5.SS3.p4.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, <math id="S5.SS3.p4.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is linearly reductive and the representation <math id="S5.SS3.p4.m5" class="ltx_Math" alttext="\rho:G\rightarrow\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>G</mi><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:G\rightarrow\GL(V)</annotation></semantics></math> decomposes into a direct sum of irreducible representations <math id="S5.SS3.p4.m6" class="ltx_Math" alttext="V=\bigoplus_{i=1}^{q}V_{i}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup><msub><mi>V</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">V=\bigoplus_{i=1}^{q}V_{i}</annotation></semantics></math>. If we denote <math id="S5.SS3.p4.m7" class="ltx_Math" alttext="H\vcentcolon=\prod_{i=1}^{q}\GL(V_{i})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">H\vcentcolon=\prod_{i=1}^{q}\GL(V_{i})</annotation></semantics></math>, then <math id="S5.SS3.p4.m8" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> factors through a faithful homomorphism <math id="S5.SS3.p4.m9" class="ltx_Math" alttext="\varphi:G\rightarrow H" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>G</mi><mo stretchy="false">→</mo><mi>H</mi></mrow></mrow><annotation encoding="application/x-tex">\varphi:G\rightarrow H</annotation></semantics></math>. Since each representation <math id="S5.SS3.p4.m10" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> is irreducible, it follows that the image of <math id="S5.SS3.p4.m11" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> is not contained in any proper parabolic subgroup of <math id="S5.SS3.p4.m12" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS3.p5" class="ltx_para">
<p id="S5.SS3.p5.1" class="ltx_p"><span id="S5.SS3.p5.1.1" class="ltx_text">Let <math id="S5.SS3.p5.m1" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be a big open subset where <math id="S5.SS3.p5.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is locally-free and let <math id="S5.SS3.p5.m3" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> be the corresponding <math id="S5.SS3.p5.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S5.SS3.p5.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> which, by Proposition <a href="#S6.Thmthm6" title="Proposition 6.6. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a>, is slope semistable in the sense of Ramanathan <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx44" title="" class="ltx_ref">Ram79</a>]</cite>. By the analogue of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx8" title="" class="ltx_ref">BG03</a>, Thm. 5.1]</cite> for rational principal bundles (as explained in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx8" title="" class="ltx_ref">BG03</a>, §7]</cite>), the restriction of <math id="S5.SS3.p5.m6" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> to a general smooth complete intersection curve <math id="S5.SS3.p5.m7" class="ltx_Math" alttext="C\hookrightarrow X" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">↪</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">C\hookrightarrow X</annotation></semantics></math> of degree sufficiently large is a (slope) semistable <math id="S5.SS3.p5.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx43" title="" class="ltx_ref">Ram75</a>]</cite>. Let <math id="S5.SS3.p5.m9" class="ltx_Math" alttext="\mathcal{H}\vcentcolon=\varphi_{*}(\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>:=</mo><mrow><msub><mi>φ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}\vcentcolon=\varphi_{*}(\mathcal{G})</annotation></semantics></math> be the associated <math id="S5.SS3.p5.m10" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>-bundle on <math id="S5.SS3.p5.m11" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. Notice that <math id="S5.SS3.p5.m12" class="ltx_Math" alttext="\varphi_{*}(\mathcal{G}|_{C})" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">|</mo></mrow><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi_{*}(\mathcal{G}|_{C})</annotation></semantics></math> is the restriction <math id="S5.SS3.p5.m13" class="ltx_Math" alttext="\mathcal{H}|_{C}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mi>C</mi></msub><annotation encoding="application/x-tex">\mathcal{H}|_{C}</annotation></semantics></math>. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BH04</a>, Prop. 5.3]</cite> <math id="S5.SS3.p5.m14" class="ltx_Math" alttext="\varphi_{*}(\mathcal{G}|_{C})" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">|</mo></mrow><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi_{*}(\mathcal{G}|_{C})</annotation></semantics></math> is (slope) semistable on <math id="S5.SS3.p5.m15" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, so the restriction of <math id="S5.SS3.p5.m16" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> to a general smooth complete intersection curve <math id="S5.SS3.p5.m17" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> of degree sufficiently large is slope semistable in the sense of Ramanathan. By the argument in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx8" title="" class="ltx_ref">BG03</a>, Remark 5.2]</cite>, it follows that, since <math id="S5.SS3.p5.m18" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> is slope semistable, then <math id="S5.SS3.p5.m19" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> is also slope semistable.</span></p>
</div>
<div id="S5.SS3.p6" class="ltx_para">
<p id="S5.SS3.p6.1" class="ltx_p"><span id="S5.SS3.p6.1.1" class="ltx_text">This <math id="S5.SS3.p6.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>-bundle <math id="S5.SS3.p6.m2" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> amounts to the data of a <math id="S5.SS3.p6.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-tuple <math id="S5.SS3.p6.m4" class="ltx_Math" alttext="(\mathcal{E}_{U,i})_{i=1}^{q}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup><annotation encoding="application/x-tex">(\mathcal{E}_{U,i})_{i=1}^{q}</annotation></semantics></math> of vector bundles on <math id="S5.SS3.p6.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. Let <math id="S5.SS3.p6.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> denote the open inclusion <math id="S5.SS3.p6.m7" class="ltx_Math" alttext="j:U\hookrightarrow X" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">↪</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">j:U\hookrightarrow X</annotation></semantics></math>. For each <math id="S5.SS3.p6.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, define <math id="S5.SS3.p6.m9" class="ltx_Math" alttext="\mathcal{E}_{i}\vcentcolon=j_{*}(\mathcal{E}_{U,i})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo>:=</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{i}\vcentcolon=j_{*}(\mathcal{E}_{U,i})</annotation></semantics></math>. Note that <math id="S5.SS3.p6.m10" class="ltx_Math" alttext="\mathcal{E}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{i}</annotation></semantics></math> is torsion free because it is the push-forward of a torsion free sheaf. The fact that <math id="S5.SS3.p6.m11" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> is semistable implies that each <math id="S5.SS3.p6.m12" class="ltx_Math" alttext="\mathcal{E}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{i}</annotation></semantics></math> is a slope semistable sheaf: otherwise the slope filtration of <math id="S5.SS3.p6.m13" class="ltx_Math" alttext="\mathcal{E}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{i}</annotation></semantics></math> would restrict over <math id="S5.SS3.p6.m14" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> to a destabilizing filtration of the <math id="S5.SS3.p6.m15" class="ltx_Math" alttext="\mathcal{E}_{U,i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{E}_{U,i}</annotation></semantics></math>, thus contradicting the fact that <math id="S5.SS3.p6.m16" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> is semistable.</span></p>
</div>
<div id="S5.SS3.p7" class="ltx_para">
<p id="S5.SS3.p7.1" class="ltx_p"><span id="S5.SS3.p7.1.1" class="ltx_text">For each <math id="S5.SS3.p7.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, <math id="S5.SS3.p7.m2" class="ltx_Math" alttext="\det(V_{i})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\det(V_{i})</annotation></semantics></math> is a character of <math id="S5.SS3.p7.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and, by the definition of degree, <math id="S5.SS3.p7.m4" class="ltx_Math" alttext="\vartheta(\det(V_{i}))=c_{1}(\mathcal{E}_{i})\cdot H^{d-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϑ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\vartheta(\det(V_{i}))=c_{1}(\mathcal{E}_{i})\cdot H^{d-1}</annotation></semantics></math>. By Hizebruch-Riemann-Roch, the slope <math id="S5.SS3.p7.m5" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{E}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{E}_{i})</annotation></semantics></math> is given by</span></p>
<table id="S5.EGx7" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S5.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex90.m1" class="ltx_Math" alttext="\displaystyle\widehat{\mu}_{d-1}(\mathcal{E}_{i})=\frac{1}{A_{d}\,\rk(\mathcal{E}_{i})}c_{1}(\mathcal{E}_{i})\cdot H^{d-1}+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}=\frac{1}{A_{d}\,\dim(V_{i})}\vartheta(\det(V_{i}))+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mrow><msub><mi>A</mi><mi>d</mi></msub><mo lspace="0.297em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mrow><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mrow><msub><mi>A</mi><mi>d</mi></msub><mo lspace="0.297em" rspace="0em">​</mo><mrow><mo rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ϑ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widehat{\mu}_{d-1}(\mathcal{E}_{i})=\frac{1}{A_{d}\,\rk(\mathcal{E}_{i})}c_{1}(\mathcal{E}_{i})\cdot H^{d-1}+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}=\frac{1}{A_{d}\,\dim(V_{i})}\vartheta(\det(V_{i}))+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.p7.2" class="ltx_p"><span id="S5.SS3.p7.2.1" class="ltx_text">Therefore <math id="S5.SS3.p7.m6" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{E}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{E}_{i})</annotation></semantics></math> is completely determined by <math id="S5.SS3.p7.m7" class="ltx_Math" alttext="\vartheta" display="inline" intent=":literal"><semantics><mi>ϑ</mi><annotation encoding="application/x-tex">\vartheta</annotation></semantics></math>, and does not depend on <math id="S5.SS3.p7.m8" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>. Denote by <math id="S5.SS3.p7.m9" class="ltx_Math" alttext="\mu_{max}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><annotation encoding="application/x-tex">\mu_{max}</annotation></semantics></math> the maximum of the slopes <math id="S5.SS3.p7.m10" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{E}_{1}),\widehat{\mu}_{d-1}(\mathcal{E}_{2}),\ldots,\widehat{\mu}_{d-1}(\mathcal{E}_{q})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{E}_{1}),\widehat{\mu}_{d-1}(\mathcal{E}_{2}),\ldots,\widehat{\mu}_{d-1}(\mathcal{E}_{q})</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS3.p8" class="ltx_para">
<p id="S5.SS3.p8.1" class="ltx_p"><span id="S5.SS3.p8.1.1" class="ltx_text">We have <math id="S5.SS3.p8.m1" class="ltx_Math" alttext="\bigoplus_{i=1}^{q}\mathcal{E}_{i}=\mathcal{F}^{\vee\vee}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub></mrow><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\bigoplus_{i=1}^{q}\mathcal{E}_{i}=\mathcal{F}^{\vee\vee}</annotation></semantics></math>, where <math id="S5.SS3.p8.m2" class="ltx_Math" alttext="\mathcal{F}^{\vee\vee}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup><annotation encoding="application/x-tex">\mathcal{F}^{\vee\vee}</annotation></semantics></math> denotes the reflexive hull of <math id="S5.SS3.p8.m3" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>,
because both sides restrict to the same associated vector bundle <math id="S5.SS3.p8.m4" class="ltx_Math" alttext="\rho_{*}(\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{*}(\mathcal{G})</annotation></semantics></math> on <math id="S5.SS3.p8.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. If we set <math id="S5.SS3.p8.m6" class="ltx_Math" alttext="\mathcal{F}_{j}\vcentcolon=\left(\bigoplus_{i=1}^{j}\mathcal{E}_{i}\right)\cap\mathcal{F}\subset\mathcal{F}^{\vee\vee}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo>:=</mo><mrow><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></msubsup><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow><mo>∩</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><mo>⊂</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{F}_{j}\vcentcolon=\left(\bigoplus_{i=1}^{j}\mathcal{E}_{i}\right)\cap\mathcal{F}\subset\mathcal{F}^{\vee\vee}</annotation></semantics></math>, this defines a filtration of <math id="S5.SS3.p8.m7" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> by saturated subsheaves:</span></p>
<table id="S5.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex91.m1" class="ltx_Math" alttext="0=\mathcal{F}_{0}\subset\mathcal{F}_{1}\subset\cdots\subset\mathcal{F}_{q-1}\subset\mathcal{F}_{q}=\mathcal{F}" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>q</mi></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">0=\mathcal{F}_{0}\subset\mathcal{F}_{1}\subset\cdots\subset\mathcal{F}_{q-1}\subset\mathcal{F}_{q}=\mathcal{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.p8.2" class="ltx_p"><span id="S5.SS3.p8.2.1" class="ltx_text">For each <math id="S5.SS3.p8.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> we have <math id="S5.SS3.p8.m9" class="ltx_Math" alttext="(\mathcal{F}_{j}/\mathcal{F}_{j-1})|_{U}=\mathcal{E}_{U,j}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(\mathcal{F}_{j}/\mathcal{F}_{j-1})|_{U}=\mathcal{E}_{U,j}</annotation></semantics></math>, and therefore <math id="S5.SS3.p8.m10" class="ltx_Math" alttext="(\mathcal{F}_{j}/\mathcal{F}_{j-1})^{\vee\vee}=\mathcal{E}_{j}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">(\mathcal{F}_{j}/\mathcal{F}_{j-1})^{\vee\vee}=\mathcal{E}_{j}</annotation></semantics></math>. This implies that <math id="S5.SS3.p8.m11" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{F}_{j}/\mathcal{F}_{j-1})=\widehat{\mu}_{d-1}(\mathcal{E}_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{F}_{j}/\mathcal{F}_{j-1})=\widehat{\mu}_{d-1}(\mathcal{E}_{j})</annotation></semantics></math>. Since <math id="S5.SS3.p8.m12" class="ltx_Math" alttext="\mathcal{E}_{j}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{j}</annotation></semantics></math> is slope semistable, it also follows that <math id="S5.SS3.p8.m13" class="ltx_Math" alttext="\mathcal{F}_{j}/\mathcal{F}_{j-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{j}/\mathcal{F}_{j-1}</annotation></semantics></math> is a slope semistable sheaf.
We have therefore found a filtration of <math id="S5.SS3.p8.m14" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> such that each graded piece <math id="S5.SS3.p8.m15" class="ltx_Math" alttext="\mathcal{F}_{j}/\mathcal{F}_{j-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{j}/\mathcal{F}_{j-1}</annotation></semantics></math> is a slope semistable sheaf such that <math id="S5.SS3.p8.m16" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{F}_{j}/\mathcal{F}_{j-1})\leq\mu_{max}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi>μ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{F}_{j}/\mathcal{F}_{j-1})\leq\mu_{max}</annotation></semantics></math>. This implies that subsheaves <math id="S5.SS3.p8.m17" class="ltx_Math" alttext="\mathcal{V}\subset\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>⊂</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">\mathcal{V}\subset\mathcal{F}</annotation></semantics></math> satisfy <math id="S5.SS3.p8.m18" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{V})\leq\mu_{max}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi>μ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{V})\leq\mu_{max}</annotation></semantics></math>, as desired.
∎</span></p>
</div>
</div>
<div id="S5.Thmthm16" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm16.2" class="ltx_text ltx_font_bold">Theorem 5.16</span></span><span id="S5.Thmthm16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm16.p1" class="ltx_para">
<p id="S5.Thmthm16.p1.1" class="ltx_p"><span id="S5.Thmthm16.p1.1.1" class="ltx_text ltx_font_italic">For each choice of Hilbert polynomial <math id="S5.Thmthm16.p1.m1" class="ltx_Math" alttext="P\in\mathbb{Q}[n]" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P\in\mathbb{Q}[n]</annotation></semantics></math> and degree <math id="S5.Thmthm16.p1.m2" class="ltx_Math" alttext="\vartheta\in\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi>ϑ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vartheta\in\Lambda(G)</annotation></semantics></math>, the stack <math id="S5.Thmthm16.p1.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P}_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P}_{\vartheta}</annotation></semantics></math> admits a proper good moduli space <math id="S5.Thmthm16.p1.m4" class="ltx_Math" alttext="M_{\rho}(X)^{ss,P}_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">M_{\rho}(X)^{ss,P}_{\vartheta}</annotation></semantics></math> in the sense of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx4" title="" class="ltx_ref">Alp13</a>]</cite>.</span></p>
</div>
</div>
<div id="S5.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS3.p9" class="ltx_para">
<p id="S5.SS3.p9.1" class="ltx_p"><span id="S5.SS3.p9.1.1" class="ltx_text">It suffices to check the hypotheses of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Thm. 2.26]</cite> (see also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">HL14</a>, Thm. B]</cite>). Proposition <a href="#S4.Thmthm15" title="Proposition 4.15. ‣ 4.3. Monotonicity of the numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.15</span></a> implies that the numerical invariant <math id="S5.SS3.p9.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> is strictly <math id="S5.SS3.p9.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-monotone and strictly <math id="S5.SS3.p9.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-monotone. By Proposition <a href="#S5.Thmthm15" title="Proposition 5.15. ‣ 5.3. Boundedness and moduli space for the semistable locus ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.15</span></a>, the stack <math id="S5.SS3.p9.m4" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P}_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P}_{\vartheta}</annotation></semantics></math> is bounded. By Theorem <a href="#S5.Thmthm7" title="Theorem 5.7. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.7</span></a>, the stack <math id="S5.SS3.p9.m5" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> satisfies the existence part of the valuative criterion of properness.
∎</span></p>
</div>
</div>
<div id="S5.SS3.p10" class="ltx_para">
<p id="S5.SS3.p10.1" class="ltx_p">If the group <math id="S5.SS3.p10.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is semisimple, then the representation <math id="S5.SS3.p10.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> factors through the subgroup <math id="S5.SS3.p10.m3" class="ltx_Math" alttext="\SL(V)\subset\GL(V)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">SL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\SL(V)\subset\GL(V)</annotation></semantics></math>. In this case the moduli space of semistable <math id="S5.SS3.p10.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves was already constructed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx46" title="" class="ltx_ref">Sch02</a>, <a href="#bib.bibx18" title="" class="ltx_ref">GLSS08</a>]</cite> using GIT. For semisimple groups the proof above provides an alternative stack-theoretic approach which is intrinsic, in the sense that it does not appeal to an embedding into an external GIT problem.</p>
</div>
<div id="S5.SS3.p11" class="ltx_para">
<p id="S5.SS3.p11.1" class="ltx_p">On the other hand, suppose that the representation <math id="S5.SS3.p11.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central as in <a href="#S2.Thmthm1" title="Definition 2.1. ‣ 2.1. Notation ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>. Then, the degree <math id="S5.SS3.p11.m2" class="ltx_Math" alttext="\vartheta" display="inline" intent=":literal"><semantics><mi>ϑ</mi><annotation encoding="application/x-tex">\vartheta</annotation></semantics></math> is determined by the Hilbert polynomial <math id="S5.SS3.p11.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and each <math id="S5.SS3.p11.m4" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P}</annotation></semantics></math> admits a proper good moduli space <math id="S5.SS3.p11.m5" class="ltx_Math" alttext="M_{\rho}(X)^{ss,P}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M_{\rho}(X)^{ss,P}</annotation></semantics></math>. Let <math id="S5.SS3.p11.m6" class="ltx_Math" alttext="\Bun_{G}(X)^{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>G</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mrow><annotation encoding="application/x-tex">\Bun_{G}(X)^{s}</annotation></semantics></math> denote the stack of slope stable <math id="S5.SS3.p11.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles on <math id="S5.SS3.p11.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. By Corollary <a href="#S6.Thmthm10" title="Corollary 6.10. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.10</span></a>, the stack <math id="S5.SS3.p11.m9" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss}</annotation></semantics></math> of Gieseker semistable <math id="S5.SS3.p11.m10" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves contains <math id="S5.SS3.p11.m11" class="ltx_Math" alttext="\Bun_{G}(X)^{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>G</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mrow><annotation encoding="application/x-tex">\Bun_{G}(X)^{s}</annotation></semantics></math> as an open substack, which is saturated in the sense of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx4" title="" class="ltx_ref">Alp13</a>, Defn. 6.1]</cite> by a standard argument as in the case when <math id="S5.SS3.p11.m12" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a curve. Therefore, the separated moduli space <math id="S5.SS3.p11.m13" class="ltx_Math" alttext="M_{\rho}(X)^{ss}=\bigsqcup_{P\in\mathbb{Q}[n]}M_{\rho}(X)^{ss,P}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>⨆</mo><mrow><mi>P</mi><mo>∈</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{\rho}(X)^{ss}=\bigsqcup_{P\in\mathbb{Q}[n]}M_{\rho}(X)^{ss,P}</annotation></semantics></math> contains an open subspace <math id="S5.SS3.p11.m14" class="ltx_Math" alttext="M_{G}(X)^{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mrow><annotation encoding="application/x-tex">M_{G}(X)^{s}</annotation></semantics></math> which is a good moduli space for the stack <math id="S5.SS3.p11.m15" class="ltx_Math" alttext="\Bun_{G}(X)^{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>G</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mrow><annotation encoding="application/x-tex">\Bun_{G}(X)^{s}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6. </span>Generalization to products of general linear groups and comparison with previous work</h2>

<section id="S6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.1. </span>Generalization: <math id="S6.SS1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves for products of general linear groups</h3>

<div id="S6.SS1.p1" class="ltx_para">
<p id="S6.SS1.p1.1" class="ltx_p">In order to deal with reductive groups <math id="S6.SS1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with large center, it is convenient to allow the codomain of <math id="S6.SS1.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> to be a product of general linear groups. All of the previous results extend to this more general context.</p>
</div>
<div id="S6.SS1.p2" class="ltx_para">
<p id="S6.SS1.p2.1" class="ltx_p">Fix a tuple <math id="S6.SS1.p2.m1" class="ltx_Math" alttext="V^{\bullet}=(V^{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><msup><mi>V</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">V^{\bullet}=(V^{i})_{i=1}^{b}</annotation></semantics></math> of finite-dimensional vector spaces over <math id="S6.SS1.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> with <math id="S6.SS1.p2.m3" class="ltx_Math" alttext="r_{i}\vcentcolon=\dim\,V^{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo rspace="0.1389em">:=</mo><mrow><mo lspace="0.1389em" rspace="0.297em">dim</mo><msup><mi>V</mi><mi>i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">r_{i}\vcentcolon=\dim\,V^{i}</annotation></semantics></math>. Define <math id="S6.SS1.p2.m4" class="ltx_Math" alttext="\GL(V^{\bullet})\vcentcolon=\prod_{i=1}^{b}\GL(V^{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})\vcentcolon=\prod_{i=1}^{b}\GL(V^{i})</annotation></semantics></math>. We fix once and for all a faithful representation <math id="S6.SS1.p2.m5" class="ltx_Math" alttext="\rho:G\rightarrow\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>G</mi><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:G\rightarrow\GL(V^{\bullet})</annotation></semantics></math>, which induces representations <math id="S6.SS1.p2.m6" class="ltx_Math" alttext="\rho_{i}:G\rightarrow\GL(V^{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>G</mi><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{i}:G\rightarrow\GL(V^{i})</annotation></semantics></math> by composing with the natural projections <math id="S6.SS1.p2.m7" class="ltx_Math" alttext="\GL(V^{\bullet})\rightarrow\GL(V^{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})\rightarrow\GL(V^{i})</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.p3" class="ltx_para">
<p id="S6.SS1.p3.1" class="ltx_p">Let <math id="S6.SS1.p3.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="S6.SS1.p3.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme. Suppose that we are given a tuple <math id="S6.SS1.p3.m3" class="ltx_Math" alttext="\mathcal{F}^{\bullet}=(\mathcal{F}^{i})_{i=1}^{b}\in\prod_{i=1}^{b}\Coh_{r_{i}}^{tf}(X)\,(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mo rspace="0.111em">∈</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><mrow><msubsup><mi mathsize="0.800em">Coh</mi><msub><mi>r</mi><mi>i</mi></msub><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.130em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}=(\mathcal{F}^{i})_{i=1}^{b}\in\prod_{i=1}^{b}\Coh_{r_{i}}^{tf}(X)\,(S)</annotation></semantics></math> of families of torsion-free sheaves on <math id="S6.SS1.p3.m4" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>. We set</p>
<table id="S6.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex92.m1" class="ltx_Math" alttext="E_{V^{i}}(\mathcal{F}^{i})\vcentcolon=\Sym^{\bullet}(\mathcal{F}^{i}\otimes_{k}(V^{i})^{\vee})\otimes_{\mathcal{O}_{X_{S}}}\Sym^{\bullet}(\det(\mathcal{F}^{i})^{\vee}\otimes_{k}\det(V^{i}))" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><msup><mi>V</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msup><mi mathsize="0.800em">Sym</mi><mo>∙</mo></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>k</mi></msub><msup><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mo>∨</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>X</mi><mi>S</mi></msub></msub></msub><mrow><msup><mi mathsize="0.800em">Sym</mi><mo>∙</mo></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em" movablelimits="false" rspace="0em">det</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>∨</mo></msup></mrow><mo>⊗</mo><mrow><mmultiscripts><mo lspace="0.055em" movablelimits="false">det</mo><mprescripts></mprescripts><mi>k</mi><mrow></mrow></mmultiscripts><mo lspace="0em">⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{V^{i}}(\mathcal{F}^{i})\vcentcolon=\Sym^{\bullet}(\mathcal{F}^{i}\otimes_{k}(V^{i})^{\vee})\otimes_{\mathcal{O}_{X_{S}}}\Sym^{\bullet}(\det(\mathcal{F}^{i})^{\vee}\otimes_{k}\det(V^{i}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.p3.2" class="ltx_p">We also define <math id="S6.SS1.p3.m5" class="ltx_Math" alttext="H(\mathcal{F}^{i},V^{i})\vcentcolon=\underline{\Spec}_{X_{S}}(E_{V^{i}}(\mathcal{F}^{i}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo>,</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msub><munder accentunder="true"><mi mathsize="0.800em">Spec</mi><mo stretchy="true">¯</mo></munder><msub><mi>X</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>E</mi><msup><mi>V</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H(\mathcal{F}^{i},V^{i})\vcentcolon=\underline{\Spec}_{X_{S}}(E_{V^{i}}(\mathcal{F}^{i}))</annotation></semantics></math>
and <math id="S6.SS1.p3.m6" class="ltx_Math" alttext="H(\mathcal{F}^{\bullet},V^{\bullet})\vcentcolon=\prod_{i=1}^{b}H(\mathcal{F}^{i},\,V^{i})\;" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo>,</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">H(\mathcal{F}^{\bullet},V^{\bullet})\vcentcolon=\prod_{i=1}^{b}H(\mathcal{F}^{i},\,V^{i})\;</annotation></semantics></math>.
Each scheme <math id="S6.SS1.p3.m7" class="ltx_Math" alttext="H(\mathcal{F}^{i},V^{i})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo>,</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(\mathcal{F}^{i},V^{i})</annotation></semantics></math> admits a right action of the group <math id="S6.SS1.p3.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> via the representation <math id="S6.SS1.p3.m9" class="ltx_Math" alttext="\rho_{i}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\rho_{i}</annotation></semantics></math>, as described in Subsection <a href="#S2.SS3" title="2.3. The scheme of 
          
            G
          
        -reductions ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a>. Equip <math id="S6.SS1.p3.m10" class="ltx_Math" alttext="H(\mathcal{F}^{\bullet},V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(\mathcal{F}^{\bullet},V^{\bullet})</annotation></semantics></math> with the corresponding diagonal action of <math id="S6.SS1.p3.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and form the relatively affine GIT quotient <math id="S6.SS1.p3.m12" class="ltx_math_unparsed" alttext="H(\mathcal{F}^{\bullet},V^{\bullet})/\!/\!\,G" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow><mpadded style="width:0.330em;" width="0.330em"><mo>/</mo></mpadded><mo rspace="0.182em">/</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">H(\mathcal{F}^{\bullet},V^{\bullet})/\!/\!\,G</annotation></semantics></math> by taking the ring of <math id="S6.SS1.p3.m13" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariants. Let <math id="S6.SS1.p3.m14" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be a big open subscheme such that <math id="S6.SS1.p3.m15" class="ltx_Math" alttext="\mathcal{F}^{i}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{F}^{i}|_{U}</annotation></semantics></math> is locally-free for all <math id="S6.SS1.p3.m16" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. The same construction as in Subsection <a href="#S2.SS3" title="2.3. The scheme of 
          
            G
          
        -reductions ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> applies to yield a divisor <math id="S6.SS1.p3.m17" class="ltx_Math" alttext="\delta^{i}_{U}-1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>δ</mi><mi>U</mi><mi>i</mi></msubsup><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta^{i}_{U}-1</annotation></semantics></math> on <math id="S6.SS1.p3.m18" class="ltx_Math" alttext="H(\mathcal{F}^{i},V^{i})|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo>,</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">H(\mathcal{F}^{i},V^{i})|_{U}</annotation></semantics></math>. This divisor is stable under the right action of <math id="S6.SS1.p3.m19" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. We descend these divisors to get a closed subscheme <math id="S6.SS1.p3.m20" class="ltx_math_unparsed" alttext="\prod_{i=1}^{b}\left(H(\mathcal{F}^{i},V^{i})|_{U}\right)_{\alpha^{i}_{U}=0}\hookrightarrow\left(H(\mathcal{F}^{\bullet},V^{\bullet})|_{U}\right)/\!/\!\,G" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><msub><mrow><mo lspace="0em">(</mo><mi>H</mi><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo>,</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>U</mi></msub><mo>)</mo></mrow><mrow><msubsup><mi>α</mi><mi>U</mi><mi>i</mi></msubsup><mo>=</mo><mn>0</mn></mrow></msub><mo stretchy="false">↪</mo><mrow><mo>(</mo><mi>H</mi><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow><msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>U</mi></msub><mo>)</mo></mrow><mpadded style="width:0.330em;" width="0.330em"><mo>/</mo></mpadded><mo rspace="0.182em">/</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{b}\left(H(\mathcal{F}^{i},V^{i})|_{U}\right)_{\alpha^{i}_{U}=0}\hookrightarrow\left(H(\mathcal{F}^{\bullet},V^{\bullet})|_{U}\right)/\!/\!\,G</annotation></semantics></math>. Define the scheme of <math id="S6.SS1.p3.m21" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reductions <math id="S6.SS1.p3.m22" class="ltx_Math" alttext="\Red_{G}(\mathcal{F}^{\bullet})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Red_{G}(\mathcal{F}^{\bullet})</annotation></semantics></math> to be the scheme-theoretic closure of this subset in <math id="S6.SS1.p3.m23" class="ltx_math_unparsed" alttext="H(\mathcal{F}^{\bullet},V^{\bullet})/\!/\!\,G" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow><mpadded style="width:0.330em;" width="0.330em"><mo>/</mo></mpadded><mo rspace="0.182em">/</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">H(\mathcal{F}^{\bullet},V^{\bullet})/\!/\!\,G</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmthm1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm1.2" class="ltx_text ltx_font_bold">Definition 6.1</span></span><span id="S6.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm1.p1" class="ltx_para">
<p id="S6.Thmthm1.p1.1" class="ltx_p"><span id="S6.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">A <math id="S6.Thmthm1.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S6.Thmthm1.p1.m2" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math> is a pair <math id="S6.Thmthm1.p1.m3" class="ltx_Math" alttext="\left(\mathcal{F}^{\bullet},\sigma\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\mathcal{F}^{\bullet},\sigma\right)</annotation></semantics></math>, where <math id="S6.Thmthm1.p1.m4" class="ltx_Math" alttext="\mathcal{F}^{\bullet}\in\prod_{i=1}^{b}\Coh_{r_{i}}^{tf}(X)\,(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo rspace="0.111em">∈</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><mrow><msubsup><mi mathsize="0.800em">Coh</mi><msub><mi>r</mi><mi>i</mi></msub><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.130em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}\in\prod_{i=1}^{b}\Coh_{r_{i}}^{tf}(X)\,(S)</annotation></semantics></math> and <math id="S6.Thmthm1.p1.m5" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> is a section <math id="S6.Thmthm1.p1.m6" class="ltx_Math" alttext="\sigma:X_{S}\rightarrow\Red_{G}(\mathcal{F}^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>X</mi><mi>S</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma:X_{S}\rightarrow\Red_{G}(\mathcal{F}^{\bullet})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS1.p4" class="ltx_para">
<p id="S6.SS1.p4.1" class="ltx_p">The tuple <math id="S6.SS1.p4.m1" class="ltx_Math" alttext="\mathcal{F}^{\bullet}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}|_{U}</annotation></semantics></math> of locally-free sheaves defines a <math id="S6.SS1.p4.m2" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math>-bundle <math id="S6.SS1.p4.m3" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> on <math id="S6.SS1.p4.m4" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. The same argument as in Subsection <a href="#S2.SS3" title="2.3. The scheme of 
          
            G
          
        -reductions ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> shows that the data of a section <math id="S6.SS1.p4.m5" class="ltx_Math" alttext="\sigma:X_{S}\rightarrow\Red_{G}(\mathcal{F}^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>X</mi><mi>S</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma:X_{S}\rightarrow\Red_{G}(\mathcal{F}^{\bullet})</annotation></semantics></math> is equivalent to a <math id="S6.SS1.p4.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reduction of structure group for the <math id="S6.SS1.p4.m7" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math>-bundle <math id="S6.SS1.p4.m8" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>. In particular, we obtain a rational <math id="S6.SS1.p4.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S6.SS1.p4.m10" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> defined on <math id="S6.SS1.p4.m11" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. This allows to define the notion of degree <math id="S6.SS1.p4.m12" class="ltx_Math" alttext="\text{deg}(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mtext>deg</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{deg}(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> of a <math id="S6.SS1.p4.m13" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf as in Definition <a href="#S5.Thmthm12" title="Definition 5.12. ‣ 5.2. The degree of a 
          
            ρ
          
        -sheaf ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.12</span></a>.</p>
</div>
<div id="S6.SS1.p5" class="ltx_para">
<p id="S6.SS1.p5.1" class="ltx_p">We denote by <math id="S6.SS1.p5.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> the stack that takes an affine <math id="S6.SS1.p5.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme <math id="S6.SS1.p5.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> to the groupoid of <math id="S6.SS1.p5.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves on <math id="S6.SS1.p5.m5" class="ltx_Math" alttext="X_{T}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>T</mi></msub><annotation encoding="application/x-tex">X_{T}</annotation></semantics></math>. There is a natural forgetful morphism <math id="S6.SS1.p5.m6" class="ltx_Math" alttext="\Forget:\Bun_{\rho}(X)\rightarrow\prod_{i=1}^{b}\Coh_{r_{i}}^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Forget</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mi mathsize="0.800em">Coh</mi><msub><mi>r</mi><mi>i</mi></msub><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Forget:\Bun_{\rho}(X)\rightarrow\prod_{i=1}^{b}\Coh_{r_{i}}^{tf}(X)</annotation></semantics></math> defined by <math id="S6.SS1.p5.m7" class="ltx_Math" alttext="\Forget(\mathcal{F}^{\bullet},\sigma)=\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">Forget</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup></mrow><annotation encoding="application/x-tex">\Forget(\mathcal{F}^{\bullet},\sigma)=\mathcal{F}^{\bullet}</annotation></semantics></math>, which is affine and of finite type by the same reasoning as in Proposition <a href="#S3.Thmthm6" title="Proposition 3.6. ‣ 3.1. Principal 
          
            ρ
          
        -sheaves and the moduli stack 
          
            
              ⁢
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>. Therefore, <math id="S6.SS1.p5.m8" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> is an algebraic stack with affine diagonal and locally of finite type over <math id="S6.SS1.p5.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. All of the discussion for filtrations in Subsection <a href="#S3.SS3" title="3.3. Filtrations of 
          
            ρ
          
        -sheaves in the split case ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> applies in this more general context, the only difference being that the underlying associated filtration is now a tuple of filtrations <math id="S6.SS1.p5.m10" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math>, where each <math id="S6.SS1.p5.m11" class="ltx_Math" alttext="(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> is a filtration of the torsion-free sheaf <math id="S6.SS1.p5.m12" class="ltx_Math" alttext="\mathcal{F}^{i}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\mathcal{F}^{i}</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.p6" class="ltx_para">
<p id="S6.SS1.p6.1" class="ltx_p">We define a family of line bundles <math id="S6.SS1.p6.m1" class="ltx_Math" alttext="L_{n}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>n</mi></msub><annotation encoding="application/x-tex">L_{n}</annotation></semantics></math> on <math id="S6.SS1.p6.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> as follows. For each <math id="S6.SS1.p6.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we have a family of line bundles <math id="S6.SS1.p6.m4" class="ltx_Math" alttext="L_{n}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>n</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">L_{n}^{i}</annotation></semantics></math> on <math id="S6.SS1.p6.m5" class="ltx_Math" alttext="\Coh^{tf}_{r_{i}}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">Coh</mi><msub><mi>r</mi><mi>i</mi></msub><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Coh^{tf}_{r_{i}}(X)</annotation></semantics></math> defined by the same formulas as in Definition <a href="#S4.Thmthm1" title="Definition 4.1. ‣ 4.1. The numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>. Then, we define the box product <math id="S6.SS1.p6.m6" class="ltx_math_unparsed" alttext="L_{n}:=\boxtimes_{i=1}^{b}L^{i}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><msub><mrow></mrow><mi>n</mi></msub><mo rspace="0em">:=</mo><mo lspace="0em" rspace="0.222em">⊠</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>b</mi></msup><mi>L</mi><msup><mrow></mrow><mi>i</mi></msup><msub><mrow></mrow><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">L_{n}:=\boxtimes_{i=1}^{b}L^{i}_{n}</annotation></semantics></math> on the stack <math id="S6.SS1.p6.m7" class="ltx_Math" alttext="\prod_{i=1}^{b}\Coh^{tf}_{r_{i}}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mi mathsize="0.800em">Coh</mi><msub><mi>r</mi><mi>i</mi></msub><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{b}\Coh^{tf}_{r_{i}}(X)</annotation></semantics></math>, and use the morphism <math id="S6.SS1.p6.m8" class="ltx_Math" alttext="\Forget" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">Forget</mi><annotation encoding="application/x-tex">\Forget</annotation></semantics></math> to pullback <math id="S6.SS1.p6.m9" class="ltx_Math" alttext="L_{n}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>n</mi></msub><annotation encoding="application/x-tex">L_{n}</annotation></semantics></math> to a line bundle on <math id="S6.SS1.p6.m10" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>, also denoted by <math id="S6.SS1.p6.m11" class="ltx_Math" alttext="L_{n}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>n</mi></msub><annotation encoding="application/x-tex">L_{n}</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.p7" class="ltx_para">
<p id="S6.SS1.p7.1" class="ltx_p">More explicitly, for every morphism <math id="S6.SS1.p7.m1" class="ltx_Math" alttext="f:T\rightarrow\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>T</mi><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f:T\rightarrow\Bun_{\rho}(X)</annotation></semantics></math> represented by a <math id="S6.SS1.p7.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S6.SS1.p7.m3" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> on <math id="S6.SS1.p7.m4" class="ltx_Math" alttext="X_{T}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>T</mi></msub><annotation encoding="application/x-tex">X_{T}</annotation></semantics></math>, we have</p>
<table id="S6.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex93.m1" class="ltx_math_unparsed" alttext="f^{*}\,L_{n}=\left(\bigotimes_{i=1}^{b}f^{*}\,M^{i}_{n}\right)\otimes\left(\bigotimes_{i=1}^{b}(f^{*}\,b^{i}_{d})^{-\otimes\,\overline{p}_{\mathcal{F}^{i}}(n)}\right)" display="block" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><msub><mi>L</mi><mi>n</mi></msub><mo>=</mo><mrow><mo>(</mo><munderover><mo lspace="0em" movablelimits="false">⨂</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><msup><mi>f</mi><mo>∗</mo></msup><msubsup><mi>M</mi><mi>n</mi><mi>i</mi></msubsup><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⊗</mo><mrow><mo>(</mo><munderover><mo lspace="0em" movablelimits="false" rspace="0em">⨂</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><msup><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><msubsup><mi>b</mi><mi>d</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">−</mo><mo lspace="0em" rspace="0.352em">⊗</mo><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup></msub><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{*}\,L_{n}=\left(\bigotimes_{i=1}^{b}f^{*}\,M^{i}_{n}\right)\otimes\left(\bigotimes_{i=1}^{b}(f^{*}\,b^{i}_{d})^{-\otimes\,\overline{p}_{\mathcal{F}^{i}}(n)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.p7.2" class="ltx_p">where <math id="S6.SS1.p7.m5" class="ltx_math_unparsed" alttext="f^{*}M^{i}_{n}\vcentcolon=\det\,\left(R\pi_{T\,*}\left(\mathcal{F}^{i}(n)\right)\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><msubsup><mi>M</mi><mi>n</mi><mi>i</mi></msubsup><mo rspace="0.1389em">:=</mo><mo lspace="0.1389em" rspace="0.130em">det</mo><mrow><mo>(</mo><mi>R</mi><msub><mi>π</mi><mrow><mi>T</mi><mo lspace="0.352em">∗</mo></mrow></msub><mrow><mo>(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{*}M^{i}_{n}\vcentcolon=\det\,\left(R\pi_{T\,*}\left(\mathcal{F}^{i}(n)\right)\right)</annotation></semantics></math>
and <math id="S6.SS1.p7.m6" class="ltx_Math" alttext="b^{i}_{d}\vcentcolon=\bigotimes_{j=0}^{d}(M^{i}_{j})^{\otimes(-1)^{d+j}\binom{d}{j}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mi>d</mi><mi>i</mi></msubsup><mo rspace="0.111em">:=</mo><mrow><msubsup><mo rspace="0em">⨂</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></msubsup><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mi>j</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mo>+</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>d</mi><mi>j</mi></mfrac><mo>)</mo></mrow></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">b^{i}_{d}\vcentcolon=\bigotimes_{j=0}^{d}(M^{i}_{j})^{\otimes(-1)^{d+j}\binom{d}{j}}</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.p8" class="ltx_para">
<p id="S6.SS1.p8.1" class="ltx_p">We will use this family of line bundles <math id="S6.SS1.p8.m1" class="ltx_Math" alttext="L_{n}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>n</mi></msub><annotation encoding="application/x-tex">L_{n}</annotation></semantics></math> to define a polynomial numerical invariant on <math id="S6.SS1.p8.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>. Let <math id="S6.SS1.p8.m3" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be a <math id="S6.SS1.p8.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S6.SS1.p8.m5" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> for some field extension <math id="S6.SS1.p8.m6" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math>. For every nondegenerate filtration <math id="S6.SS1.p8.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> with underlying associated filtration <math id="S6.SS1.p8.m8" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math>, we set <math id="S6.SS1.p8.m9" class="ltx_Math" alttext="\nu(f)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(f)</annotation></semantics></math> to be the polynomial</p>
<table id="S6.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex94.m1" class="ltx_Math" alttext="\nu(f)=\frac{\wgt(L_{n}|_{0})}{\sqrt{\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}m^{2}\cdot\rk(\mathcal{F}^{i}_{m}/\mathcal{F}^{i}_{m+1})}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi>L</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msub><mo lspace="0.167em">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msup><mi>m</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\nu(f)=\frac{\wgt(L_{n}|_{0})}{\sqrt{\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}m^{2}\cdot\rk(\mathcal{F}^{i}_{m}/\mathcal{F}^{i}_{m+1})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.p8.2" class="ltx_p">The same computation as in Proposition <a href="#S4.Thmthm4" title="Proposition 4.4. ‣ 4.1. The numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> shows that this can be rewritten in terms of the reduced Hilbert polynomials as follows:</p>
<table id="S6.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex95.m1" class="ltx_Math" alttext="\nu(f)=\sqrt{A_{d}}\cdot\frac{\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}m\cdot(\overline{p}_{\mathcal{F}^{i}_{m}/\mathcal{F}^{i}_{m+1}}-\overline{p}_{\mathcal{F}^{i}})\cdot\rk(\mathcal{F}^{i}_{m}/\mathcal{F}^{i}_{m+1})}{\sqrt{\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}m^{2}\cdot\rk(\mathcal{F}^{i}_{m}/\mathcal{F}^{i}_{m+1})}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msub><mo lspace="0.167em">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><msqrt><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msub><mo lspace="0.167em">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msup><mi>m</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nu(f)=\sqrt{A_{d}}\cdot\frac{\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}m\cdot(\overline{p}_{\mathcal{F}^{i}_{m}/\mathcal{F}^{i}_{m+1}}-\overline{p}_{\mathcal{F}^{i}})\cdot\rk(\mathcal{F}^{i}_{m}/\mathcal{F}^{i}_{m+1})}{\sqrt{\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}m^{2}\cdot\rk(\mathcal{F}^{i}_{m}/\mathcal{F}^{i}_{m+1})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.SS1.p9" class="ltx_para">
<p id="S6.SS1.p9.1" class="ltx_p">One can define a version of the affine Grassmannian in this more general context. Let <math id="S6.SS1.p9.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a quasicompact <math id="S6.SS1.p9.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme and let <math id="S6.SS1.p9.m3" class="ltx_Math" alttext="\mathcal{F^{\bullet}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{F^{\bullet}}</annotation></semantics></math> be a tuple of torsion-free sheaves in <math id="S6.SS1.p9.m4" class="ltx_Math" alttext="\prod_{i=1}^{b}\Coh_{r_{i}}^{tf}(X)\,(S)" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><mrow><msubsup><mi mathsize="0.800em">Coh</mi><msub><mi>r</mi><mi>i</mi></msub><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.130em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{b}\Coh_{r_{i}}^{tf}(X)\,(S)</annotation></semantics></math>. Let <math id="S6.SS1.p9.m5" class="ltx_Math" alttext="D\hookrightarrow X_{S}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo stretchy="false">↪</mo><msub><mi>X</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">D\hookrightarrow X_{S}</annotation></semantics></math> be an effective Cartier divisor that is flat over <math id="S6.SS1.p9.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and set <math id="S6.SS1.p9.m7" class="ltx_Math" alttext="Q=X_{S}\setminus D" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>∖</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">Q=X_{S}\setminus D</annotation></semantics></math>. Assume that we have a section <math id="S6.SS1.p9.m8" class="ltx_Math" alttext="\sigma:Q\rightarrow\Red_{G}(\mathcal{F}^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Q</mi><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma:Q\rightarrow\Red_{G}(\mathcal{F}^{\bullet})</annotation></semantics></math> defined over <math id="S6.SS1.p9.m9" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.p10" class="ltx_para">
<p id="S6.SS1.p10.1" class="ltx_p">The affine Grassmannian <math id="S6.SS1.p10.m1" class="ltx_Math" alttext="\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi></mrow></msub><annotation encoding="application/x-tex">\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}</annotation></semantics></math> is the functor from <math id="S6.SS1.p10.m2" class="ltx_Math" alttext="\left(\Aff_{S}\right)^{op}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><msub><mi mathsize="0.800em">Aff</mi><mi>S</mi></msub><mo>)</mo></mrow><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><annotation encoding="application/x-tex">\left(\Aff_{S}\right)^{op}</annotation></semantics></math> into sets defined as follows. For each affine scheme <math id="S6.SS1.p10.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> in <math id="S6.SS1.p10.m4" class="ltx_Math" alttext="\Aff_{S}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">Aff</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\Aff_{S}</annotation></semantics></math>, <math id="S6.SS1.p10.m5" class="ltx_Math" alttext="\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}(T)</annotation></semantics></math> is the set of equivalence classes of the following data</p>
<ol id="S6.I1" class="ltx_enumerate">
<li id="S6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I1.i1.p1" class="ltx_para">
<p id="S6.I1.i1.p1.1" class="ltx_p">A <math id="S6.I1.i1.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S6.I1.i1.p1.m2" class="ltx_Math" alttext="(\mathcal{E}^{\bullet},\zeta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∙</mo></msup><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{E}^{\bullet},\zeta)</annotation></semantics></math> on <math id="S6.I1.i1.p1.m3" class="ltx_Math" alttext="X_{T}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>T</mi></msub><annotation encoding="application/x-tex">X_{T}</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I1.i2.p1" class="ltx_para">
<p id="S6.I1.i2.p1.1" class="ltx_p">A morphism <math id="S6.I1.i2.p1.m1" class="ltx_Math" alttext="\theta^{\bullet}:\mathcal{F}^{\bullet}|_{X_{T}}\to\mathcal{E}^{\bullet}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mo>∙</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">→</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∙</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\theta^{\bullet}:\mathcal{F}^{\bullet}|_{X_{T}}\to\mathcal{E}^{\bullet}</annotation></semantics></math> of tuples such that the restriction <math id="S6.I1.i2.p1.m2" class="ltx_Math" alttext="\theta^{\bullet}|_{Q_{T}}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mi>θ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>Q</mi><mi>T</mi></msub></msub><annotation encoding="application/x-tex">\theta^{\bullet}|_{Q_{T}}</annotation></semantics></math> is an isomorphism. Moreover, we require that the following diagram induced by the isomorphism <math id="S6.I1.i2.p1.m3" class="ltx_Math" alttext="\theta^{\bullet}|_{Q_{T}}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mi>θ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>Q</mi><mi>T</mi></msub></msub><annotation encoding="application/x-tex">\theta^{\bullet}|_{Q_{T}}</annotation></semantics></math> commutes.</p>
<table id="S6.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S6.Ex96.m1.pic1" class="ltx_picture ltx_markedasmath" height="79.09" overflow="visible" style="vertical-align:-36.92px" version="1.1" viewBox="0 0 185.37 79.09" width="185.37"><g transform="translate(0,79.09) matrix(1 0 0 -1 0 0) translate(92.69,0) translate(0,36.92)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -92.69 -27.9)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 73.83)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.44)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(22.7,0) matrix(1.0 0.0 0.0 1.0 -16.75 0)"><foreignObject style="--ltx-fo-width:1.42em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="19.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex96.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces Q_{T}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>T</mi></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces Q_{T}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 45.41 0) translate(86.59,0) matrix(1.0 0.0 0.0 1.0 -47.42 0)"><foreignObject style="--ltx-fo-width:5.85em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="81.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex96.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Red_{G}(\mathcal{E}^{\bullet}|_{Q_{T}})}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>Q</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Red_{G}(\mathcal{E}^{\bullet}|_{Q_{T}})}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 64.81)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 45.6 0) translate(86.4,0) matrix(1.0 0.0 0.0 1.0 -47.23 0)"><foreignObject style="--ltx-fo-width:5.83em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="80.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex96.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Red_{G}(\mathcal{F}^{\bullet}|_{Q_{T}})}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>Q</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Red_{G}(\mathcal{F}^{\bullet}|_{Q_{T}})}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -47 24.94 L -14.9 24.94"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -14.62 24.94)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -42.75 31.93)"><foreignObject style="--ltx-fo-width:1.75em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.27em;font-size:10pt;" height="11" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="24.15"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex96.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\zeta|_{Q_{T}}}" display="inline" intent=":literal"><semantics><msub><mrow><mi mathsize="0.700em">ζ</mi><mo maxsize="0.700em" minsize="0.700em" stretchy="true">|</mo></mrow><msub><mi mathsize="0.710em">Q</mi><mi>T</mi></msub></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\zeta|_{Q_{T}}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -47 14.56 L 11.68 -11.95"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.91132 -0.41171 0.41171 0.91132 11.93 -12.06)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -46.19 -9.33)"><foreignObject style="--ltx-fo-width:1.84em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.27em;font-size:10pt;" height="11" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="25.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex96.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\sigma|_{Q_{T}}}" display="inline" intent=":literal"><semantics><msub><mrow><mi mathsize="0.700em">σ</mi><mo maxsize="0.700em" minsize="0.700em" stretchy="true">|</mo></mrow><msub><mi mathsize="0.710em">Q</mi><mi>T</mi></msub></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\sigma|_{Q_{T}}}</annotation></semantics></math></span></span></foreignObject></g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.39998pt" transform="matrix(0.0 1.0 -1.0 0.0 44.25 -18.46)"><foreignObject style="--ltx-fo-width:2.67em;--ltx-fo-height:0.71em;--ltx-fo-depth:0em;font-size:10pt;" height="9.89" overflow="visible" transform="matrix(1 0 0 -1 0 9.89)" width="36.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex96.m1.pic1.m6" class="ltx_Math" alttext="\xrightarrow{\;\;\sim\;\;}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><annotation encoding="application/x-tex">\xrightarrow{\;\;\sim\;\;}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
<div id="S6.SS1.p11" class="ltx_para">
<p id="S6.SS1.p11.1" class="ltx_p">There is a forgetful morphism <math id="S6.SS1.p11.m1" class="ltx_Math" alttext="\Gr_{{X_{S},D,\mathcal{F}^{\bullet},\sigma}}\rightarrow\prod_{i=1}^{b}\Gr_{X_{S},D,\mathcal{F}^{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi></mrow></msub><mo rspace="0.111em" stretchy="false">→</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\Gr_{{X_{S},D,\mathcal{F}^{\bullet},\sigma}}\rightarrow\prod_{i=1}^{b}\Gr_{X_{S},D,\mathcal{F}^{i}}</annotation></semantics></math> that takes a point <math id="S6.SS1.p11.m2" class="ltx_Math" alttext="(\mathcal{E}^{\bullet},\zeta,\theta^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∙</mo></msup><mo>,</mo><mi>ζ</mi><mo>,</mo><msup><mi>θ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{E}^{\bullet},\zeta,\theta^{\bullet})</annotation></semantics></math> to the tuple <math id="S6.SS1.p11.m3" class="ltx_Math" alttext="(\mathcal{E}^{i},\theta^{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msup><mo>,</mo><msup><mi>θ</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><annotation encoding="application/x-tex">(\mathcal{E}^{i},\theta^{i})_{i=1}^{b}</annotation></semantics></math>.
The same proof as in Proposition <a href="#S4.Thmthm9" title="Proposition 4.9. ‣ 4.2. Affine Grassmannians for 
          
            ρ
          
        -sheaves ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a> shows that this forgetful morphism exhibits <math id="S6.SS1.p11.m4" class="ltx_Math" alttext="\Gr_{{X_{S},D,\mathcal{F}^{\bullet},\sigma}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi></mrow></msub><annotation encoding="application/x-tex">\Gr_{{X_{S},D,\mathcal{F}^{\bullet},\sigma}}</annotation></semantics></math> as a closed ind-subscheme of <math id="S6.SS1.p11.m5" class="ltx_Math" alttext="\prod_{i=1}^{b}\Gr_{X_{S},D,\mathcal{F}^{i}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{b}\Gr_{X_{S},D,\mathcal{F}^{i}}</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.p12" class="ltx_para">
<p id="S6.SS1.p12.1" class="ltx_p">Let <math id="S6.SS1.p12.m1" class="ltx_Math" alttext="P^{\bullet}=(P^{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">P^{\bullet}=(P^{i})_{i=1}^{b}</annotation></semantics></math> be a tuple of rational polynomials. For each <math id="S6.SS1.p12.m2" class="ltx_Math" alttext="N\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">N\geq 0</annotation></semantics></math> we define the subfunctor</p>
<table id="S6.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex97.m1" class="ltx_Math" alttext="\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}^{\leq N,P^{\bullet}}\vcentcolon=\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}\cap\prod_{i=1}^{b}\Gr_{X_{S},D,\mathcal{F}^{i}}^{\leq N,P^{i}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msubsup><mo>:=</mo><mrow><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi></mrow></msub><mo lspace="0em" rspace="0.055em">∩</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><msup><mi>P</mi><mi>i</mi></msup></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}^{\leq N,P^{\bullet}}\vcentcolon=\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}\cap\prod_{i=1}^{b}\Gr_{X_{S},D,\mathcal{F}^{i}}^{\leq N,P^{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.p12.2" class="ltx_p">which is a closed subscheme of <math id="S6.SS1.p12.m3" class="ltx_Math" alttext="\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi></mrow></msub><annotation encoding="application/x-tex">\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}</annotation></semantics></math> and it is projective over <math id="S6.SS1.p12.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. There exists an integer <math id="S6.SS1.p12.m5" class="ltx_Math" alttext="m\gg 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≫</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\gg 0</annotation></semantics></math> such that, for all <math id="S6.SS1.p12.m6" class="ltx_Math" alttext="n\geq m" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">n\geq m</annotation></semantics></math>, the restriction of the dual <math id="S6.SS1.p12.m7" class="ltx_Math" alttext="L_{n}^{\vee}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>n</mi><mo>∨</mo></msubsup><annotation encoding="application/x-tex">L_{n}^{\vee}</annotation></semantics></math> is <math id="S6.SS1.p12.m8" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-ample on the projective stratum <math id="S6.SS1.p12.m9" class="ltx_Math" alttext="\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}^{\leq N,P^{\bullet}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>S</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msubsup><annotation encoding="application/x-tex">\Gr_{X_{S},D,\mathcal{F}^{\bullet},\sigma}^{\leq N,P^{\bullet}}</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.p13" class="ltx_para">
<p id="S6.SS1.p13.1" class="ltx_p">The proof of Proposition <a href="#S4.Thmthm15" title="Proposition 4.15. ‣ 4.3. Monotonicity of the numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.15</span></a> applies without change in this more general context. The argument of HN boundedness in Proposition <a href="#S4.Thmthm25" title="Proposition 4.25. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.25</span></a> also applies, one only needs to keep track of one extra index <math id="S6.SS1.p13.m1" class="ltx_Math" alttext="1\leq i\leq b" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq b</annotation></semantics></math> in all the formulas. In particular, Theorem <a href="#S4.Thmthm27" title="Theorem 4.27. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.27</span></a> holds and the numerical invariant <math id="S6.SS1.p13.m2" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> induces a <math id="S6.SS1.p13.m3" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification on the stack <math id="S6.SS1.p13.m4" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>. All of the arguments in Subsection <a href="#S4.SS5" title="4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.5</span></a> and Section <a href="#S5.SS1" title="5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> apply without change.</p>
</div>
<div id="S6.SS1.p14" class="ltx_para">
<p id="S6.SS1.p14.1" class="ltx_p">The tuple of rational polynomials <math id="S6.SS1.p14.m1" class="ltx_Math" alttext="P^{\bullet}=(P^{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">P^{\bullet}=(P^{i})_{i=1}^{b}</annotation></semantics></math> defines an open substack <math id="S6.SS1.p14.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P^{\bullet}}\subset\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msup></mrow><mo>⊂</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P^{\bullet}}\subset\Bun_{\rho}(X)</annotation></semantics></math> parametrizing Gieseker semistable <math id="S6.SS1.p14.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves <math id="S6.SS1.p14.m4" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> such that the Hilbert polynomial of <math id="S6.SS1.p14.m5" class="ltx_Math" alttext="\mathcal{F}^{i}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\mathcal{F}^{i}</annotation></semantics></math> is <math id="S6.SS1.p14.m6" class="ltx_Math" alttext="P^{i}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mi>i</mi></msup><annotation encoding="application/x-tex">P^{i}</annotation></semantics></math>. If we fix the degree <math id="S6.SS1.p14.m7" class="ltx_Math" alttext="\vartheta\in\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi>ϑ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vartheta\in\Lambda(G)</annotation></semantics></math> of the <math id="S6.SS1.p14.m8" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf, we obtain an open and closed substack <math id="S6.SS1.p14.m9" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}\subset\Bun_{\rho}(X)^{ss,P^{\bullet}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msubsup></mrow><mo>⊂</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}\subset\Bun_{\rho}(X)^{ss,P^{\bullet}}</annotation></semantics></math>, which is quasicompact by the same proof as in Proposition <a href="#S5.Thmthm15" title="Proposition 5.15. ‣ 5.3. Boundedness and moduli space for the semistable locus ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.15</span></a>. It follows by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Thm. 2.26]</cite> that <math id="S6.SS1.p14.m10" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}</annotation></semantics></math> admits a proper good moduli space <math id="S6.SS1.p14.m11" class="ltx_Math" alttext="M_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msubsup></mrow><annotation encoding="application/x-tex">M_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmthm2" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm2.2" class="ltx_text ltx_font_bold">Theorem 6.2</span></span><span id="S6.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm2.p1" class="ltx_para">
<p id="S6.Thmthm2.p1.1" class="ltx_p"><span id="S6.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">The polynomial numerical invariant <math id="S6.Thmthm2.p1.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> induces a <math id="S6.Thmthm2.p1.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification on the stack <math id="S6.Thmthm2.p1.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>. In particular the leading term HN filtration induces a stratification of <math id="S6.Thmthm2.p1.m4" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> by locally closed susbtacks.</span></p>
</div>
<div id="S6.Thmthm2.p2" class="ltx_para">
<p id="S6.Thmthm2.p2.1" class="ltx_p"><span id="S6.Thmthm2.p2.1.1" class="ltx_text ltx_font_italic">For each choice of degree <math id="S6.Thmthm2.p2.m1" class="ltx_Math" alttext="\vartheta\in\Lambda(G)" display="inline" intent=":literal"><semantics><mrow><mi>ϑ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vartheta\in\Lambda(G)</annotation></semantics></math> and tuple of Hilbert polynomials <math id="S6.Thmthm2.p2.m2" class="ltx_Math" alttext="P^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">P^{\bullet}</annotation></semantics></math>, the open substack <math id="S6.Thmthm2.p2.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}</annotation></semantics></math> admits a proper good moduli space <math id="S6.Thmthm2.p2.m4" class="ltx_Math" alttext="M_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ϑ</mi><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msubsup></mrow><annotation encoding="application/x-tex">M_{\rho}(X)^{ss,P^{\bullet}}_{\vartheta}</annotation></semantics></math>. ∎</span></p>
</div>
</div>
<div id="S6.SS1.p15" class="ltx_para">
<p id="S6.SS1.p15.1" class="ltx_p">If the representation <math id="S6.SS1.p15.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central, then the degree <math id="S6.SS1.p15.m2" class="ltx_Math" alttext="\vartheta" display="inline" intent=":literal"><semantics><mi>ϑ</mi><annotation encoding="application/x-tex">\vartheta</annotation></semantics></math> is determined by the tuple of Hilbert polynomials <math id="S6.SS1.p15.m3" class="ltx_Math" alttext="P^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">P^{\bullet}</annotation></semantics></math> and each <math id="S6.SS1.p15.m4" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P^{\bullet}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P^{\bullet}}</annotation></semantics></math> admits a proper good moduli space <math id="S6.SS1.p15.m5" class="ltx_Math" alttext="M_{\rho}(X)^{ss,P^{\bullet}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">M_{\rho}(X)^{ss,P^{\bullet}}</annotation></semantics></math>. In this case, the stack <math id="S6.SS1.p15.m6" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss}</annotation></semantics></math> of Gieseker semistable <math id="S6.SS1.p15.m7" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves contains the stack <math id="S6.SS1.p15.m8" class="ltx_Math" alttext="\Bun_{G}(X)^{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>G</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mrow><annotation encoding="application/x-tex">\Bun_{G}(X)^{s}</annotation></semantics></math> of slope stable <math id="S6.SS1.p15.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles as an open substack, by Corollary <a href="#S6.Thmthm10" title="Corollary 6.10. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.10</span></a>. Therefore the separated moduli space <math id="S6.SS1.p15.m10" class="ltx_Math" alttext="M_{\rho}(X)^{ss}=\bigsqcup_{P^{\bullet}\in(\mathbb{Q}[n])^{b}}M_{\rho}(X)^{ss,P^{\bullet}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>⨆</mo><mrow><msup><mi>P</mi><mo>∙</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>b</mi></msup></mrow></msub><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><msup><mi>P</mi><mo>∙</mo></msup></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{\rho}(X)^{ss}=\bigsqcup_{P^{\bullet}\in(\mathbb{Q}[n])^{b}}M_{\rho}(X)^{ss,P^{\bullet}}</annotation></semantics></math> contains an open subspace <math id="S6.SS1.p15.m11" class="ltx_Math" alttext="M_{G}(X)^{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mrow><annotation encoding="application/x-tex">M_{G}(X)^{s}</annotation></semantics></math> which is a good moduli space for the stack <math id="S6.SS1.p15.m12" class="ltx_Math" alttext="\Bun_{G}(X)^{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>G</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mrow><annotation encoding="application/x-tex">\Bun_{G}(X)^{s}</annotation></semantics></math>. Hence <math id="S6.SS1.p15.m13" class="ltx_Math" alttext="M_{\rho}(X)^{ss}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M_{\rho}(X)^{ss}</annotation></semantics></math> is a locally proper compactification of the moduli of slope stable <math id="S6.SS1.p15.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles on <math id="S6.SS1.p15.m15" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx8" title="" class="ltx_ref">BG03</a>, §7]</cite>).</p>
</div>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.2. </span>Comparison with previous work</h3>

<div id="S6.SS2.p1" class="ltx_para">
<p id="S6.SS2.p1.1" class="ltx_p">The problem of finding a compactification of the moduli space by
introducing singular degenerations of principal bundles has already been
considered in the literature
(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx46" title="" class="ltx_ref">Sch02</a>, <a href="#bib.bibx23" title="" class="ltx_ref">GS03</a>, <a href="#bib.bibx24" title="" class="ltx_ref">GS05</a>, <a href="#bib.bibx18" title="" class="ltx_ref">GLSS08</a>, <a href="#bib.bibx19" title="" class="ltx_ref">GLSS10</a>]</cite>)<span id="footnote8" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">8</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">8</sup>
              <span class="ltx_tag ltx_tag_note">8</span>
              
              
              
              
              
              
              
            We warn the reader that, in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx46" title="" class="ltx_ref">Sch02</a>, <a href="#bib.bibx18" title="" class="ltx_ref">GLSS08</a>, <a href="#bib.bibx19" title="" class="ltx_ref">GLSS10</a>]</cite>,
a principal <math id="footnote8.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf was defined using the
dual representation.</span></span></span>.
All notions fit the same framework:
we fix a representation <math id="S6.SS2.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> of <math id="S6.SS2.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> (in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">GS05</a>, <a href="#bib.bibx19" title="" class="ltx_ref">GLSS10</a>]</cite> <math id="S6.SS2.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is not required to
be injective) and the objects are triples
consisting of a principal <math id="S6.SS2.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S6.SS2.p1.m5" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> on a big open subset <math id="S6.SS2.p1.m6" class="ltx_Math" alttext="U\subset X" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">U\subset X</annotation></semantics></math>, a
torsion free sheaf <math id="S6.SS2.p1.m7" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> on <math id="S6.SS2.p1.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>,
and an isomorphism <math id="S6.SS2.p1.m9" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> on <math id="S6.SS2.p1.m10" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> between the vector bundle associated to <math id="S6.SS2.p1.m11" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>
using the representation <math id="S6.SS2.p1.m12" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> and the restriction <math id="S6.SS2.p1.m13" class="ltx_Math" alttext="\mathcal{E}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{E}|_{U}</annotation></semantics></math>.
In this subsection we will see that our definition of Gieseker
semistability for principal <math id="S6.SS2.p1.m14" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves coincides with the
definitions that have already appeared.</p>
</div>
<div id="S6.SS2.p2" class="ltx_para">
<p id="S6.SS2.p2.1" class="ltx_p">By <a href="#S2.Thmthm17" title="Proposition 2.17. ‣ 2.3. The scheme of 
          
            G
          
        -reductions ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.17</span></a>, the following is equivalent to <a href="#S6.Thmthm1" title="Definition 6.1. ‣ 6.1. Generalization: 
          
            ρ
          
        -sheaves for products of general linear groups ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a></p>
</div>
<div id="S6.Thmthm3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm3.2" class="ltx_text ltx_font_bold">Definition 6.3</span></span><span id="S6.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm3.p1" class="ltx_para">
<p id="S6.Thmthm3.p1.1" class="ltx_p"><span id="S6.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmthm3.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a connected reductive group.
Let</span></p>
<table id="S6.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex98.m1" class="ltx_math_unparsed" alttext="\rho=(\rho_{1},\ldots,\rho_{b}):G\longrightarrow\GL(V^{1})\times\cdots\times\GL(V^{b})" display="block" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ρ</mi><mi>b</mi></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>G</mi><mo stretchy="false">⟶</mo><mi mathsize="0.800em">GL</mi><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mn>1</mn></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi mathsize="0.800em">GL</mi><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>b</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho=(\rho_{1},\ldots,\rho_{b}):G\longrightarrow\GL(V^{1})\times\cdots\times\GL(V^{b})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm3.p1.2" class="ltx_p"><span id="S6.Thmthm3.p1.2.1" class="ltx_text ltx_font_italic">be an injective homomorphism.
Let <math id="S6.Thmthm3.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="S6.Thmthm3.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme.
A principal <math id="S6.Thmthm3.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S6.Thmthm3.p1.m5" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math> is a triple
<math id="S6.Thmthm3.p1.m6" class="ltx_Math" alttext="(\mathcal{G},\mathcal{F}^{\bullet},\psi^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><msup><mi>ψ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{G},\mathcal{F}^{\bullet},\psi^{\bullet})</annotation></semantics></math>
where <math id="S6.Thmthm3.p1.m7" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is a principal <math id="S6.Thmthm3.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on a big open set <math id="S6.Thmthm3.p1.m9" class="ltx_Math" alttext="U\subset X_{S}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><msub><mi>X</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">U\subset X_{S}</annotation></semantics></math>,
<math id="S6.Thmthm3.p1.m10" class="ltx_Math" alttext="\mathcal{F}^{\bullet}=(\mathcal{F}^{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}=(\mathcal{F}^{i})_{i=1}^{b}</annotation></semantics></math> is a tuple of
torsion free sheaves on <math id="S6.Thmthm3.p1.m11" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>, and
<math id="S6.Thmthm3.p1.m12" class="ltx_Math" alttext="\psi^{\bullet}=(\psi^{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ψ</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msup><mi>ψ</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">\psi^{\bullet}=(\psi^{i})_{i=1}^{b}</annotation></semantics></math> is a tuple of isomorphisms
<math id="S6.Thmthm3.p1.m13" class="ltx_Math" alttext="(\rho_{i})_{*}\mathcal{G}\cong\mathcal{F}^{i}|_{U}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo>≅</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo stretchy="false">|</mo></mrow><mi>U</mi></msub></mrow><annotation encoding="application/x-tex">(\rho_{i})_{*}\mathcal{G}\cong\mathcal{F}^{i}|_{U}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS2.p3" class="ltx_para">
<p id="S6.SS2.p3.1" class="ltx_p">We generalize Definition <a href="#S4.Thmthm28" title="Definition 4.28. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.28</span></a> in the following way, using the summation by parts argument as in Equation (<a href="#S4.E12" title="Equation 12 ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).</p>
</div>
<div id="S6.Thmthm4" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm4.2" class="ltx_text ltx_font_bold">Definition 6.4</span></span><span id="S6.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm4.p1" class="ltx_para">
<p id="S6.Thmthm4.p1.1" class="ltx_p"><span id="S6.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmthm4.p1.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be an algebraically closed field.
A principal <math id="S6.Thmthm4.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S6.Thmthm4.p1.m3" class="ltx_Math" alttext="(\mathcal{G},\mathcal{F}^{\bullet},\psi^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><msup><mi>ψ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{G},\mathcal{F}^{\bullet},\psi^{\bullet})</annotation></semantics></math> on <math id="S6.Thmthm4.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> is
Gieseker semistable
if for all cocharacters <math id="S6.Thmthm4.p1.m5" class="ltx_Math" alttext="\lambda:(\mathbb{G}_{m})_{K}\longrightarrow G_{K}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mi>K</mi></msub><mo stretchy="false">⟶</mo><msub><mi>G</mi><mi>K</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda:(\mathbb{G}_{m})_{K}\longrightarrow G_{K}</annotation></semantics></math> and all weighted parabolic reductions <math id="S6.Thmthm4.p1.m6" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math>
with associated underlying filtrations <math id="S6.Thmthm4.p1.m7" class="ltx_Math" alttext="(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> of <math id="S6.Thmthm4.p1.m8" class="ltx_Math" alttext="\mathcal{F}^{i}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\mathcal{F}^{i}</annotation></semantics></math>,
(as in Definition <a href="#S3.Thmthm15" title="Definition 3.15. ‣ 3.3. Filtrations of 
          
            ρ
          
        -sheaves in the split case ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.15</span></a>) we have</span></p>
<table id="S6.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(14)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E14.m1" class="ltx_Math" alttext="\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}\left(\rk(\mathcal{F}^{i})\cdot P_{\mathcal{F}^{i}_{m}}-\rk(\mathcal{F}^{i}_{m})\cdot P_{\mathcal{F}^{i}}\right)\leq 0" display="block" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mo>(</mo><mrow><mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>P</mi><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup></msub></mrow><mo>−</mo><mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>P</mi><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}\left(\rk(\mathcal{F}^{i})\cdot P_{\mathcal{F}^{i}_{m}}-\rk(\mathcal{F}^{i}_{m})\cdot P_{\mathcal{F}^{i}}\right)\leq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S6.SS2.p4" class="ltx_para">
<p id="S6.SS2.p4.1" class="ltx_p">We start by comparing our notion of Gieseker semistability with Ramanathan’s notion of slope semistability for the underlying rational <math id="S6.SS2.p4.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle.</p>
</div>
<div id="S6.Thmthm5" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm5.2" class="ltx_text ltx_font_bold">Definition 6.5</span></span><span id="S6.Thmthm5.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx44" title="" class="ltx_ref">Ram79</a>]</cite>)<span id="S6.Thmthm5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm5.p1" class="ltx_para">
<p id="S6.Thmthm5.p1.1" class="ltx_p"><span id="S6.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">A rational <math id="S6.Thmthm5.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on a polarized
smooth projective variety <math id="S6.Thmthm5.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a <math id="S6.Thmthm5.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S6.Thmthm5.p1.m4" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>
on a big open set <math id="S6.Thmthm5.p1.m5" class="ltx_Math" alttext="U\subset X" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">U\subset X</annotation></semantics></math>.
It is called slope stable (respectively, semistable) if for all
reductions of structure group
<math id="S6.Thmthm5.p1.m6" class="ltx_Math" alttext="\mathcal{G}_{P}\to U^{\prime}\subset U" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>P</mi></msub><mo stretchy="false">→</mo><msup><mi>U</mi><mo>′</mo></msup><mo>⊂</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">\mathcal{G}_{P}\to U^{\prime}\subset U</annotation></semantics></math> to a proper parabolic subgroup <math id="S6.Thmthm5.p1.m7" class="ltx_Math" alttext="P\subset G" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⊂</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">P\subset G</annotation></semantics></math> on
a big open subset <math id="S6.Thmthm5.p1.m8" class="ltx_Math" alttext="U^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′</mo></msup><annotation encoding="application/x-tex">U^{\prime}</annotation></semantics></math> and
all dominant characters <math id="S6.Thmthm5.p1.m9" class="ltx_Math" alttext="\chi" display="inline" intent=":literal"><semantics><mi>χ</mi><annotation encoding="application/x-tex">\chi</annotation></semantics></math> of <math id="S6.Thmthm5.p1.m10" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, the associated line bundle <math id="S6.Thmthm5.p1.m11" class="ltx_Math" alttext="\chi_{*}(\mathcal{G}_{P})" display="inline" intent=":literal"><semantics><mrow><msub><mi>χ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>P</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi_{*}(\mathcal{G}_{P})</annotation></semantics></math> satisfies</span></p>
<table id="S6.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex99.m1" class="ltx_Math" alttext="\deg\chi_{*}(\mathcal{G}_{P})&lt;0\hskip 10.00002pt\text{(respectively, $\leq$)}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msub><mi>χ</mi><mo>∗</mo></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>P</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext class="ltx_mathvariant_italic">(respectively, </mtext><mo>≤</mo><mtext class="ltx_mathvariant_italic">)</mtext></mrow></mrow><annotation encoding="application/x-tex">\deg\chi_{*}(\mathcal{G}_{P})&lt;0\hskip 10.00002pt\text{(respectively, $\leq$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm5.p1.2" class="ltx_p"><span id="S6.Thmthm5.p1.2.1" class="ltx_text ltx_font_italic">Here the degree is defined with respect to the fixed polarization. A rational <math id="S6.Thmthm5.p1.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle is called slope unstable if it is not slope semistable.</span></p>
</div>
</div>
<div id="S6.Thmthm6" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm6.2" class="ltx_text ltx_font_bold">Proposition 6.6</span></span><span id="S6.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm6.p1" class="ltx_para">
<p id="S6.Thmthm6.p1.1" class="ltx_p"><span id="S6.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmthm6.p1.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be a field extension. Let <math id="S6.Thmthm6.p1.m2" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be a <math id="S6.Thmthm6.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S6.Thmthm6.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. Suppose that <math id="S6.Thmthm6.p1.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> is a big open subset of <math id="S6.Thmthm6.p1.m6" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> such that the tuple <math id="S6.Thmthm6.p1.m7" class="ltx_Math" alttext="\mathcal{F}^{\bullet}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}|_{U}</annotation></semantics></math> is locally-free. Let <math id="S6.Thmthm6.p1.m8" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> denote the <math id="S6.Thmthm6.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S6.Thmthm6.p1.m10" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> corresponding to <math id="S6.Thmthm6.p1.m11" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>. If <math id="S6.Thmthm6.p1.m12" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> is Gieseker semistable, then the rational <math id="S6.Thmthm6.p1.m13" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S6.Thmthm6.p1.m14" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is slope semistable in the sense of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx44" title="" class="ltx_ref">Ram79</a>]</cite>.</span></p>
</div>
</div>
<div id="S6.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.p5" class="ltx_para">
<p id="S6.SS2.p5.1" class="ltx_p"><span id="S6.SS2.p5.1.1" class="ltx_text">We freely use the notation from the proof of Proposition <a href="#S4.Thmthm25" title="Proposition 4.25. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.25</span></a> and assume, after replacing <math id="S6.SS2.p5.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> with a field extension, that <math id="S6.SS2.p5.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is algebraically closed. Suppose that the rational <math id="S6.SS2.p5.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S6.SS2.p5.m4" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is not slope semistable.
Then the Harder-Narasimhan reduction <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AAB02</a>, Theorem 6 (1)]</cite> gives a proper parabolic subgroup <math id="S6.SS2.p5.m5" class="ltx_Math" alttext="P_{\lambda}\subset G" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>λ</mi></msub><mo>⊂</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">P_{\lambda}\subset G</annotation></semantics></math> and a <math id="S6.SS2.p5.m6" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math>-reduction of structure group <math id="S6.SS2.p5.m7" class="ltx_Math" alttext="\mathcal{G}_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{P_{\lambda}}</annotation></semantics></math> defined over a big open subset <math id="S6.SS2.p5.m8" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> contained in <math id="S6.SS2.p5.m9" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. After replacing <math id="S6.SS2.p5.m10" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> with the smaller subset <math id="S6.SS2.p5.m11" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, we can assume without loss of generality that <math id="S6.SS2.p5.m12" class="ltx_Math" alttext="\mathcal{G}_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{P_{\lambda}}</annotation></semantics></math> is defined over <math id="S6.SS2.p5.m13" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.
The rational bundle <math id="S6.SS2.p5.m14" class="ltx_Math" alttext="\mathcal{G}_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{P_{\lambda}}</annotation></semantics></math> determines a linear functional <math id="S6.SS2.p5.m15" class="ltx_Math" alttext="\psi:X^{*}(Z_{\lambda})_{\mathbb{R}}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\psi:X^{*}(Z_{\lambda})_{\mathbb{R}}\rightarrow\mathbb{R}</annotation></semantics></math>, given by <math id="S6.SS2.p5.m16" class="ltx_Math" alttext="\psi(\chi):=\deg(\mathcal{G}_{P_{\lambda}}(\chi))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi(\chi):=\deg(\mathcal{G}_{P_{\lambda}}(\chi))</annotation></semantics></math> (as in the proof of Lemma <a href="#S4.Thmthm24" title="Lemma 4.24. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.24</span></a>). Since <math id="S6.SS2.p5.m17" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> actually lies in <math id="S6.SS2.p5.m18" class="ltx_Math" alttext="X_{*}(Z_{\lambda})_{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><annotation encoding="application/x-tex">X_{*}(Z_{\lambda})_{\mathbb{Q}}</annotation></semantics></math>, there is a multiple <math id="S6.SS2.p5.m19" class="ltx_Math" alttext="N\psi" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><annotation encoding="application/x-tex">N\psi</annotation></semantics></math> that lies in the lattice of cocharacters <math id="S6.SS2.p5.m20" class="ltx_Math" alttext="X_{*}(Z_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z_{\lambda})</annotation></semantics></math>. By the second property of the Harder-Narasimhan reduction <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AAB02</a>, Theorem 6 (2)]</cite>, <math id="S6.SS2.p5.m21" class="ltx_Math" alttext="\deg(\mathcal{G}_{P_{\lambda}}(\chi))&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\deg(\mathcal{G}_{P_{\lambda}}(\chi))&gt;0</annotation></semantics></math> whenever <math id="S6.SS2.p5.m22" class="ltx_Math" alttext="\chi" display="inline" intent=":literal"><semantics><mi>χ</mi><annotation encoding="application/x-tex">\chi</annotation></semantics></math> is a non-trivial non-negative linear combination of simple roots, therefore <math id="S6.SS2.p5.m23" class="ltx_Math" alttext="N\psi" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><annotation encoding="application/x-tex">N\psi</annotation></semantics></math> lies in the interior of the cone of <math id="S6.SS2.p5.m24" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math>-dominant coweights. It follows that <math id="S6.SS2.p5.m25" class="ltx_Math" alttext="P_{\lambda}=P_{(N\psi)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>λ</mi></msub><mo>=</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">P_{\lambda}=P_{(N\psi)}</annotation></semantics></math>. Therefore <math id="S6.SS2.p5.m26" class="ltx_Math" alttext="f=(N\psi,\mathcal{G}_{P_{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(N\psi,\mathcal{G}_{P_{\lambda}})</annotation></semantics></math> is a nondegenerate weighted parabolic reduction of <math id="S6.SS2.p5.m27" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p6" class="ltx_para">
<p id="S6.SS2.p6.1" class="ltx_p"><span id="S6.SS2.p6.1.1" class="ltx_text">The group <math id="S6.SS2.p6.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> acts on each vector space <math id="S6.SS2.p6.m2" class="ltx_Math" alttext="V^{j}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>j</mi></msup><annotation encoding="application/x-tex">V^{j}</annotation></semantics></math> via the homomorphism <math id="S6.SS2.p6.m3" class="ltx_Math" alttext="\rho_{j}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\rho_{j}</annotation></semantics></math>. For each <math id="S6.SS2.p6.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, we denote by <math id="S6.SS2.p6.m5" class="ltx_Math" alttext="(\chi_{i,j})_{i=1}^{r_{j}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><annotation encoding="application/x-tex">(\chi_{i,j})_{i=1}^{r_{j}}</annotation></semantics></math> the tuple of weights of the split maximal torus <math id="S6.SS2.p6.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> acting on <math id="S6.SS2.p6.m7" class="ltx_Math" alttext="V^{j}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>j</mi></msup><annotation encoding="application/x-tex">V^{j}</annotation></semantics></math> (with possible repetitions). Recall the function <math id="S6.SS2.p6.m8" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math> on the dominant cone <math id="S6.SS2.p6.m9" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math> described in Lemma <a href="#S4.Thmthm22" title="Lemma 4.22. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.22</span></a> (<a href="#S4.E4" title="Equation 4 ‣ Lemma 4.22. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>). In this case the formula (<a href="#S4.E4" title="Equation 4 ‣ Lemma 4.22. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) includes an extra summation</span></p>
<table id="S6.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(15)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E15.m1" class="ltx_Math" alttext="\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle\delta,\chi^{\lambda}_{i,j}\rangle\cdot(c_{i,j}-c_{j})}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle\delta,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>c</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><msup><mrow><mo>(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle\delta,\chi^{\lambda}_{i,j}\rangle\cdot(c_{i,j}-c_{j})}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle\delta,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p6.2" class="ltx_p"><span id="S6.SS2.p6.2.1" class="ltx_text">where we define <math id="S6.SS2.p6.m10" class="ltx_Math" alttext="c_{i,j}=\langle\psi,\chi_{i,j}^{\lambda}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">c_{i,j}=\langle\psi,\chi_{i,j}^{\lambda}\rangle</annotation></semantics></math> and <math id="S6.SS2.p6.m11" class="ltx_Math" alttext="c_{j}=\frac{1}{r_{j}}\langle\psi,\sum_{i=1}^{r_{j}}\chi_{i,j}^{\lambda}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>j</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><msub><mi>r</mi><mi>j</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo rspace="0em">,</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{j}=\frac{1}{r_{j}}\langle\psi,\sum_{i=1}^{r_{j}}\chi_{i,j}^{\lambda}\rangle</annotation></semantics></math>. Expression (<a href="#S6.E15" title="Equation 15 ‣ Proof. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) for <math id="S6.SS2.p6.m12" class="ltx_Math" alttext="\delta=N\psi" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow></mrow><annotation encoding="application/x-tex">\delta=N\psi</annotation></semantics></math> yields</span></p>
<table id="S6.EGx8" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S6.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex100.m1" class="ltx_Math" alttext="\displaystyle\nu_{d-1}(N\psi)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle N\psi,\chi^{\lambda}_{i,j}\rangle\cdot\left(\langle\psi,\chi_{i,j}^{\lambda}\rangle-\frac{1}{r_{j}}\sum_{l=1}^{r_{j}}\langle\psi,\chi_{i,l}^{\lambda}\rangle\right)}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle N\psi,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}=" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msub><mi>r</mi><mi>j</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><msup><mrow><mo>(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mfrac></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\nu_{d-1}(N\psi)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle N\psi,\chi^{\lambda}_{i,j}\rangle\cdot\left(\langle\psi,\chi_{i,j}^{\lambda}\rangle-\frac{1}{r_{j}}\sum_{l=1}^{r_{j}}\langle\psi,\chi_{i,l}^{\lambda}\rangle\right)}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle N\psi,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}=</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S6.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(16)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E16.m1" class="ltx_Math" alttext="\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\left(\sum_{i=1}^{r_{j}}\left(\langle\psi,\chi^{\lambda}_{i,j}\rangle\right)^{2}\right)-\frac{1}{r_{j}}\left(\sum_{i=1}^{r_{j}}\langle\psi,\chi_{i,j}^{\lambda}\rangle\right)\cdot\left(\sum_{l=1}^{r_{j}}\langle\psi,\chi_{l,j}^{\lambda}\rangle\right)}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle N\psi,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}" display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><mo lspace="0em">(</mo><mrow><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><msup><mrow><mo>(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mfrac><mn>1</mn><msub><mi>r</mi><mi>j</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><msup><mrow><mo>(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\left(\sum_{i=1}^{r_{j}}\left(\langle\psi,\chi^{\lambda}_{i,j}\rangle\right)^{2}\right)-\frac{1}{r_{j}}\left(\sum_{i=1}^{r_{j}}\langle\psi,\chi_{i,j}^{\lambda}\rangle\right)\cdot\left(\sum_{l=1}^{r_{j}}\langle\psi,\chi_{l,j}^{\lambda}\rangle\right)}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle N\psi,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.SS2.p7" class="ltx_para">
<p id="S6.SS2.p7.1" class="ltx_p"><span id="S6.SS2.p7.1.1" class="ltx_text">We shall show that the numerator of (<a href="#S6.E16" title="Equation 16 ‣ Proof. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) is positive. This will contradict Gieseker semistability of <math id="S6.SS2.p7.m1" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>.
For each index <math id="S6.SS2.p7.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, let <math id="S6.SS2.p7.m3" class="ltx_Math" alttext="\vec{v}_{j}\vcentcolon=[\langle\psi,\chi_{i}^{\lambda}\rangle]_{i=1}^{r_{j}}\in\mathbb{R}^{r_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>v</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub><mo>:=</mo><msubsup><mrow><mo stretchy="false">[</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>r</mi><mi>j</mi></msub></msup></mrow><annotation encoding="application/x-tex">\vec{v}_{j}\vcentcolon=[\langle\psi,\chi_{i}^{\lambda}\rangle]_{i=1}^{r_{j}}\in\mathbb{R}^{r_{j}}</annotation></semantics></math> and set <math id="S6.SS2.p7.m4" class="ltx_Math" alttext="\vec{1}_{j}\in\mathbb{R}^{r_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>r</mi><mi>j</mi></msub></msup></mrow><annotation encoding="application/x-tex">\vec{1}_{j}\in\mathbb{R}^{r_{j}}</annotation></semantics></math> to be the vector with all coordinates equal to <math id="S6.SS2.p7.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. The numerator in (<a href="#S6.E16" title="Equation 16 ‣ Proof. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) is</span></p>
<table id="S6.EGx9" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S6.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex101.m1" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{b}\left(\sum_{i=1}^{r_{j}}\left(\langle\psi,\chi^{\lambda}_{i,j}\rangle\right)^{2}\right)-\frac{1}{r_{j}}\left(\sum_{i=1}^{r_{j}}\langle\psi,\chi_{i,j}^{\lambda}\rangle\right)^{2}=\sum_{j=1}^{b}\frac{1}{r_{j}}\left[\left(\vec{1}_{j}\cdot_{\mathbb{R}}\vec{1}_{j}\right)\left(\vec{v}_{j}\cdot_{\mathbb{R}}\vec{v}_{j}\right)-\left(\vec{1}_{j}\cdot_{\mathbb{R}}\vec{v}_{j}\right)^{2}\right]" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><mrow><mo lspace="0em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></munderover><msup><mrow><mo>(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msub><mi>r</mi><mi>j</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></munderover><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><mrow><mfrac><mn>1</mn><msub><mi>r</mi><mi>j</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ℝ</mi></msub><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>v</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ℝ</mi></msub><msub><mover accent="true"><mi>v</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>−</mo><msup><mrow><mo>(</mo><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ℝ</mi></msub><msub><mover accent="true"><mi>v</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{b}\left(\sum_{i=1}^{r_{j}}\left(\langle\psi,\chi^{\lambda}_{i,j}\rangle\right)^{2}\right)-\frac{1}{r_{j}}\left(\sum_{i=1}^{r_{j}}\langle\psi,\chi_{i,j}^{\lambda}\rangle\right)^{2}=\sum_{j=1}^{b}\frac{1}{r_{j}}\left[\left(\vec{1}_{j}\cdot_{\mathbb{R}}\vec{1}_{j}\right)\left(\vec{v}_{j}\cdot_{\mathbb{R}}\vec{v}_{j}\right)-\left(\vec{1}_{j}\cdot_{\mathbb{R}}\vec{v}_{j}\right)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p7.2" class="ltx_p"><span id="S6.SS2.p7.2.1" class="ltx_text">where <math id="S6.SS2.p7.m6" class="ltx_math_unparsed" alttext="\cdot_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mo>⋅</mo><msub><mrow></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">\cdot_{\mathbb{R}}</annotation></semantics></math> denotes the standard inner product on <math id="S6.SS2.p7.m7" class="ltx_Math" alttext="\mathbb{R}^{r_{j}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><msub><mi>r</mi><mi>j</mi></msub></msup><annotation encoding="application/x-tex">\mathbb{R}^{r_{j}}</annotation></semantics></math>. The Cauchy-Schwarz inequality implies that the quantity above is always nonnegative and, moreover, it is strictly positive if there exists some index <math id="S6.SS2.p7.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> such that <math id="S6.SS2.p7.m9" class="ltx_Math" alttext="\vec{1}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\vec{1}_{j}</annotation></semantics></math> and <math id="S6.SS2.p7.m10" class="ltx_Math" alttext="\vec{v}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>v</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\vec{v}_{j}</annotation></semantics></math> are not scalar multiples of each other. Therefore, <math id="S6.SS2.p7.m11" class="ltx_Math" alttext="\nu_{d-1}(N\psi)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu_{d-1}(N\psi)&gt;0</annotation></semantics></math> whenever <math id="S6.SS2.p7.m12" class="ltx_Math" alttext="\langle\psi,\chi_{i,j}^{\lambda}\rangle\neq\langle\psi,\chi_{l,j}^{\lambda}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>≠</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\langle\psi,\chi_{i,j}^{\lambda}\rangle\neq\langle\psi,\chi_{l,j}^{\lambda}\rangle</annotation></semantics></math> for some <math id="S6.SS2.p7.m13" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="S6.SS2.p7.m14" class="ltx_Math" alttext="i\neq l" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">i\neq l</annotation></semantics></math>. We are left to show that there are <math id="S6.SS2.p7.m15" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and two indexes <math id="S6.SS2.p7.m16" class="ltx_Math" alttext="i\neq l" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">i\neq l</annotation></semantics></math> satisfying this condition.</span></p>
</div>
<div id="S6.SS2.p8" class="ltx_para">
<p id="S6.SS2.p8.1" class="ltx_p"><span id="S6.SS2.p8.1.1" class="ltx_text">Let <math id="S6.SS2.p8.m1" class="ltx_Math" alttext="\{\zeta_{l,j}\}" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><msub><mi>ζ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow><annotation encoding="application/x-tex">\{\zeta_{l,j}\}</annotation></semantics></math> denote the subset of <math id="S6.SS2.p8.m2" class="ltx_Math" alttext="\{\chi_{i,j}\}" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><msub><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow><annotation encoding="application/x-tex">\{\chi_{i,j}\}</annotation></semantics></math> consisting of <math id="S6.SS2.p8.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>-highest weights for an irreducible component of the representation <math id="S6.SS2.p8.m4" class="ltx_Math" alttext="\rho_{j}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\rho_{j}</annotation></semantics></math>. Each <math id="S6.SS2.p8.m5" class="ltx_Math" alttext="\zeta_{l,j}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\zeta_{l,j}</annotation></semantics></math> can be uniquely expressed as a linear combination <math id="S6.SS2.p8.m6" class="ltx_Math" alttext="\sum_{i=1}^{h}x_{z_{i}}z_{i}^{\vee}+\sum_{\alpha\in\Delta}x_{\alpha}\alpha" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></msubsup><mrow><msub><mi>x</mi><msub><mi>z</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mi>i</mi><mo>∨</mo></msubsup></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>α</mi><mo>∈</mo><mi mathvariant="normal">Δ</mi></mrow></msub><mrow><msub><mi>x</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{h}x_{z_{i}}z_{i}^{\vee}+\sum_{\alpha\in\Delta}x_{\alpha}\alpha</annotation></semantics></math>, where all coefficients <math id="S6.SS2.p8.m7" class="ltx_Math" alttext="x_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>α</mi></msub><annotation encoding="application/x-tex">x_{\alpha}</annotation></semantics></math> are nonnegative. Since the parabolic <math id="S6.SS2.p8.m8" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math> is proper, we can choose some <math id="S6.SS2.p8.m9" class="ltx_Math" alttext="\alpha\in I_{P_{\lambda}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><msub><mi>I</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow><annotation encoding="application/x-tex">\alpha\in I_{P_{\lambda}}</annotation></semantics></math>. Since <math id="S6.SS2.p8.m10" class="ltx_Math" alttext="\bigoplus\rho_{j}" display="inline" intent=":literal"><semantics><mrow><mo>⨁</mo><msub><mi>ρ</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\bigoplus\rho_{j}</annotation></semantics></math> is faithful, at least one of the <math id="S6.SS2.p8.m11" class="ltx_Math" alttext="\zeta_{l,j}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\zeta_{l,j}</annotation></semantics></math> must have a nonzero coefficient <math id="S6.SS2.p8.m12" class="ltx_Math" alttext="x_{\alpha}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>α</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{\alpha}&gt;0</annotation></semantics></math>; we fix such <math id="S6.SS2.p8.m13" class="ltx_Math" alttext="l,j" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">l,j</annotation></semantics></math>. The restriction <math id="S6.SS2.p8.m14" class="ltx_Math" alttext="\chi_{l,j}^{\lambda}\in X^{*}(Z_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>χ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup><mo>∈</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi_{l,j}^{\lambda}\in X^{*}(Z_{\lambda})</annotation></semantics></math> is a <math id="S6.SS2.p8.m15" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math>-dominant character such that the coefficient of <math id="S6.SS2.p8.m16" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is not <math id="S6.SS2.p8.m17" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. Since <math id="S6.SS2.p8.m18" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> is in the interior of the the <math id="S6.SS2.p8.m19" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math>-dominant cone in <math id="S6.SS2.p8.m20" class="ltx_Math" alttext="X_{*}(Z_{\lambda})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X_{*}(Z_{\lambda})_{\mathbb{R}}</annotation></semantics></math>, it follows that <math id="S6.SS2.p8.m21" class="ltx_Math" alttext="\langle\psi,\chi_{l,j}^{\lambda}\rangle&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\langle\psi,\chi_{l,j}^{\lambda}\rangle&gt;0</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p9" class="ltx_para">
<p id="S6.SS2.p9.1" class="ltx_p"><span id="S6.SS2.p9.1.1" class="ltx_text">Let <math id="S6.SS2.p9.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> denote the Weyl group of <math id="S6.SS2.p9.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> permutting the set of characters <math id="S6.SS2.p9.m3" class="ltx_Math" alttext="\{\chi_{i,j}\}_{i=1}^{r_{j}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><msub><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><annotation encoding="application/x-tex">\{\chi_{i,j}\}_{i=1}^{r_{j}}</annotation></semantics></math> of the representation <math id="S6.SS2.p9.m4" class="ltx_Math" alttext="\rho_{j}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\rho_{j}</annotation></semantics></math>. Let <math id="S6.SS2.p9.m5" class="ltx_Math" alttext="W_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">W_{P_{\lambda}}</annotation></semantics></math> denote the subgroup of <math id="S6.SS2.p9.m6" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> generated by the reflections of the simple roots in <math id="S6.SS2.p9.m7" class="ltx_Math" alttext="I_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">I_{P_{\lambda}}</annotation></semantics></math>. <math id="S6.SS2.p9.m8" class="ltx_Math" alttext="W_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">W_{P_{\lambda}}</annotation></semantics></math> acts on the characters <math id="S6.SS2.p9.m9" class="ltx_Math" alttext="X^{*}(Z_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X^{*}(Z_{\lambda})</annotation></semantics></math>, and the action is transitive on the set of Weyl chambers in <math id="S6.SS2.p9.m10" class="ltx_Math" alttext="X^{*}(Z_{\lambda})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X^{*}(Z_{\lambda})_{\mathbb{R}}</annotation></semantics></math>. The set of restrictions <math id="S6.SS2.p9.m11" class="ltx_Math" alttext="\{\chi_{i,j}^{\lambda}\}_{i=1}^{r_{j}}\subset X^{*}(Z_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><mo>⊂</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\chi_{i,j}^{\lambda}\}_{i=1}^{r_{j}}\subset X^{*}(Z_{\lambda})</annotation></semantics></math> is preserved by <math id="S6.SS2.p9.m12" class="ltx_Math" alttext="W_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">W_{P_{\lambda}}</annotation></semantics></math>. The character <math id="S6.SS2.p9.m13" class="ltx_Math" alttext="\chi_{l,j}^{\lambda}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup><annotation encoding="application/x-tex">\chi_{l,j}^{\lambda}</annotation></semantics></math> is not fixed by the action of <math id="S6.SS2.p9.m14" class="ltx_Math" alttext="W_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">W_{P_{\lambda}}</annotation></semantics></math>, because the coefficient of <math id="S6.SS2.p9.m15" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is not <math id="S6.SS2.p9.m16" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. Therefore, there exists some <math id="S6.SS2.p9.m17" class="ltx_Math" alttext="w\in W_{P_{\lambda}}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msub><mi>W</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow><annotation encoding="application/x-tex">w\in W_{P_{\lambda}}</annotation></semantics></math> such that <math id="S6.SS2.p9.m18" class="ltx_Math" alttext="\chi_{i,j}^{\lambda}\vcentcolon=w\cdot\chi_{l,j}^{\lambda}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup><mo>:=</mo><mrow><mi>w</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>χ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\chi_{i,j}^{\lambda}\vcentcolon=w\cdot\chi_{l,j}^{\lambda}</annotation></semantics></math> is contained in the <math id="S6.SS2.p9.m19" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math>-anti-dominant cone of <math id="S6.SS2.p9.m20" class="ltx_Math" alttext="X^{*}(Z_{\lambda})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X^{*}(Z_{\lambda})_{\mathbb{R}}</annotation></semantics></math>. This implies that <math id="S6.SS2.p9.m21" class="ltx_Math" alttext="\langle\psi,\chi_{i,j}^{\lambda}\rangle&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\langle\psi,\chi_{i,j}^{\lambda}\rangle&lt;0</annotation></semantics></math>. Since <math id="S6.SS2.p9.m22" class="ltx_Math" alttext="\langle\psi,\chi_{i,j}^{\lambda}\rangle&lt;0&lt;\langle\psi,\chi_{l,j}^{\lambda}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>&lt;</mo><mn>0</mn><mo>&lt;</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\langle\psi,\chi_{i,j}^{\lambda}\rangle&lt;0&lt;\langle\psi,\chi_{l,j}^{\lambda}\rangle</annotation></semantics></math>, we conclude that <math id="S6.SS2.p9.m23" class="ltx_Math" alttext="\langle\psi,\chi_{i}^{\lambda}\rangle\neq\langle\psi,\chi_{j}^{\lambda}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>≠</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>j</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\langle\psi,\chi_{i}^{\lambda}\rangle\neq\langle\psi,\chi_{j}^{\lambda}\rangle</annotation></semantics></math>, as desired.
∎</span></p>
</div>
</div>
<div id="S6.SS2.p10" class="ltx_para">
<p id="S6.SS2.p10.1" class="ltx_p">The following example shows that the converse is not true.</p>
</div>
<div id="S6.Thmthm7" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm7.2" class="ltx_text ltx_font_bold">Example 6.7</span></span><span id="S6.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm7.p1" class="ltx_para">
<p id="S6.Thmthm7.p1.1" class="ltx_p"><span id="S6.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">We construct a principal <math id="S6.Thmthm7.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf which is Gieseker unstable, but the underlying rational
principal bundle is stable in the sense of Ramanathan (Definition <a href="#S6.Thmthm5" title="Definition 6.5 ([]). ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.5</span></a>). Let <math id="S6.Thmthm7.p1.m2" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> be a vector space over <math id="S6.Thmthm7.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Set <math id="S6.Thmthm7.p1.m4" class="ltx_Math" alttext="V=W\oplus W" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><mi>W</mi><mo>⊕</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">V=W\oplus W</annotation></semantics></math>
and <math id="S6.Thmthm7.p1.m5" class="ltx_Math" alttext="G=\GL(W)\times\GL(W)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">G=\GL(W)\times\GL(W)</annotation></semantics></math>.
We define <math id="S6.Thmthm7.p1.m6" class="ltx_Math" alttext="\rho:G\rightarrow\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>G</mi><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:G\rightarrow\GL(V)</annotation></semantics></math> to be the faithful
representation given by <math id="S6.Thmthm7.p1.m7" class="ltx_Math" alttext="\rho(A,B)=\left(\begin{array}[]{cc}A&amp;0\\
0&amp;B\\
\end{array}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mi>A</mi></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mi>B</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(A,B)=\left(\begin{array}[]{cc}A&amp;0\\
0&amp;B\\
\end{array}\right)</annotation></semantics></math>. Let <math id="S6.Thmthm7.p1.m8" class="ltx_Math" alttext="(\mathcal{E},\mathcal{E}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{E},\mathcal{E}^{\prime})</annotation></semantics></math> be a pair of slope stable vector
bundles of rank <math id="S6.Thmthm7.p1.m9" class="ltx_Math" alttext="\dim W" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">dim</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">\dim W</annotation></semantics></math> on <math id="S6.Thmthm7.p1.m10" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and
with <math id="S6.Thmthm7.p1.m11" class="ltx_Math" alttext="d=\deg\mathcal{E}&gt;\deg\mathcal{E}^{\prime}=d^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>&gt;</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>′</mo></msup></mrow><mo>=</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">d=\deg\mathcal{E}&gt;\deg\mathcal{E}^{\prime}=d^{\prime}</annotation></semantics></math>.
This pair defines a principal <math id="S6.Thmthm7.p1.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S6.Thmthm7.p1.m13" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> on <math id="S6.Thmthm7.p1.m14" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.
In particular, it defines a principal <math id="S6.Thmthm7.p1.m15" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf.
It is stable in the sense of Ramanathan for the identity representation of <math id="S6.Thmthm7.p1.m16" class="ltx_Math" alttext="\GL(W)\times\GL(W)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\GL(W)\times\GL(W)</annotation></semantics></math>).
However it is not Gieseker semistable in the sense of Definition
<a href="#S6.Thmthm4" title="Definition 6.4. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a>.</span></p>
</div>
</div>
<div id="S6.SS2.p11" class="ltx_para">
<p id="S6.SS2.p11.1" class="ltx_p">In order to obtain a reasonable notion of stability, it is useful to impose the condition that <math id="S6.SS2.p11.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central in the sense of <a href="#S2.Thmthm1" title="Definition 2.1. ‣ 2.1. Notation ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>. First, we note that under this additional condition we can check semistability only using cocharacters of the derived subgroup of <math id="S6.SS2.p11.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmthm8" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm8.2" class="ltx_text ltx_font_bold">Proposition 6.8</span></span><span id="S6.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm8.p1" class="ltx_para">
<p id="S6.Thmthm8.p1.1" class="ltx_p"><span id="S6.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmthm8.p1.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be an algebraically closed field, and suppose that <math id="S6.Thmthm8.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central. Then in the semistability condition of Definition <a href="#S6.Thmthm4" title="Definition 6.4. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a> it is enough
to look at cocharacters <math id="S6.Thmthm8.p1.m3" class="ltx_Math" alttext="\lambda:(\mathbb{G}_{m})_{K}\longrightarrow[G_{K},G_{K}]" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mi>K</mi></msub><mo stretchy="false">⟶</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda:(\mathbb{G}_{m})_{K}\longrightarrow[G_{K},G_{K}]</annotation></semantics></math> whose image is in the derived subgroup <math id="S6.Thmthm8.p1.m4" class="ltx_Math" alttext="[G_{K},G_{K}]\subset G_{K}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>⊂</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[G_{K},G_{K}]\subset G_{K}.</annotation></semantics></math></span></p>
</div>
</div>
<div id="S6.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.p12" class="ltx_para">
<p id="S6.SS2.p12.1" class="ltx_p"><span id="S6.SS2.p12.1.1" class="ltx_text">Let <math id="S6.SS2.p12.m1" class="ltx_Math" alttext="Z\subset G_{K}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">Z\subset G_{K}</annotation></semantics></math> be the center and <math id="S6.SS2.p12.m2" class="ltx_Math" alttext="[G_{K},G_{K}]\subset G_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>⊂</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">[G_{K},G_{K}]\subset G_{K}</annotation></semantics></math> be
the
commutator subgroup. Consider the exact sequence</span></p>
<table id="S6.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex102.m1" class="ltx_Math" alttext="1\longrightarrow F\longrightarrow Z\times[G_{K},G_{K}]\longrightarrow G_{K}\longrightarrow 1" display="block" intent=":literal"><semantics><mrow><mn>1</mn><mo stretchy="false">⟶</mo><mi>F</mi><mo stretchy="false">⟶</mo><mrow><mi>Z</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">⟶</mo><msub><mi>G</mi><mi>K</mi></msub><mo stretchy="false">⟶</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">1\longrightarrow F\longrightarrow Z\times[G_{K},G_{K}]\longrightarrow G_{K}\longrightarrow 1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p12.2" class="ltx_p"><span id="S6.SS2.p12.2.1" class="ltx_text">where <math id="S6.SS2.p12.m3" class="ltx_Math" alttext="F=Z\cap[G_{K},G_{K}]" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mi>Z</mi><mo>∩</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F=Z\cap[G_{K},G_{K}]</annotation></semantics></math> is a finite group (it is the
center of the semisimple group <math id="S6.SS2.p12.m4" class="ltx_Math" alttext="[G_{K},G_{K}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[G_{K},G_{K}]</annotation></semantics></math>).
Let <math id="S6.SS2.p12.m5" class="ltx_Math" alttext="\lambda:(\mathbb{G}_{m})_{K}\to G_{K}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mi>K</mi></msub><mo stretchy="false">→</mo><msub><mi>G</mi><mi>K</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda:(\mathbb{G}_{m})_{K}\to G_{K}</annotation></semantics></math> be a cocharacter. Since <math id="S6.SS2.p12.m6" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is
finite, there is an integer <math id="S6.SS2.p12.m7" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> such that
<math id="S6.SS2.p12.m8" class="ltx_Math" alttext="\lambda^{N}" display="inline" intent=":literal"><semantics><msup><mi>λ</mi><mi>N</mi></msup><annotation encoding="application/x-tex">\lambda^{N}</annotation></semantics></math> lifts to <math id="S6.SS2.p12.m9" class="ltx_Math" alttext="Z\times[G_{K},G_{K}]" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">Z\times[G_{K},G_{K}]</annotation></semantics></math>.
If we replace <math id="S6.SS2.p12.m10" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> by <math id="S6.SS2.p12.m11" class="ltx_Math" alttext="\lambda^{N}" display="inline" intent=":literal"><semantics><msup><mi>λ</mi><mi>N</mi></msup><annotation encoding="application/x-tex">\lambda^{N}</annotation></semantics></math> then the parabolic
subgroup <math id="S6.SS2.p12.m12" class="ltx_Math" alttext="\mathcal{G}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\lambda}</annotation></semantics></math> associated to <math id="S6.SS2.p12.m13" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> does not change. The only change in
the associated filtration
<math id="S6.SS2.p12.m14" class="ltx_Math" alttext="(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> is that the indexes are multiplied by <math id="S6.SS2.p12.m15" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, and
the expression (<a href="#S6.E14" title="Equation 14 ‣ Definition 6.4. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) does not change.
Therefore, to check (semi)stability we can assume that the
cocharacter <math id="S6.SS2.p12.m16" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> lifts to the product
<math id="S6.SS2.p12.m17" class="ltx_Math" alttext="Z\times[G_{K},G_{K}]" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">Z\times[G_{K},G_{K}]</annotation></semantics></math>.
Assume <math id="S6.SS2.p12.m18" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> lifts, and
write <math id="S6.SS2.p12.m19" class="ltx_Math" alttext="\lambda=(\lambda_{1},\lambda_{2})" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda=(\lambda_{1},\lambda_{2})</annotation></semantics></math> where
<math id="S6.SS2.p12.m20" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> is the lift to <math id="S6.SS2.p12.m21" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> and <math id="S6.SS2.p12.m22" class="ltx_Math" alttext="\lambda_{2}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\lambda_{2}</annotation></semantics></math> is the lift to
<math id="S6.SS2.p12.m23" class="ltx_Math" alttext="[G_{K},G_{K}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[G_{K},G_{K}]</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p13" class="ltx_para">
<p id="S6.SS2.p13.1" class="ltx_p"><span id="S6.SS2.p13.1.1" class="ltx_text">We claim that the filtrations associated to <math id="S6.SS2.p13.m1" class="ltx_Math" alttext="(\lambda_{1},\lambda_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{1},\lambda_{2})</annotation></semantics></math>
and <math id="S6.SS2.p13.m2" class="ltx_Math" alttext="(1,\lambda_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,\lambda_{2})</annotation></semantics></math> on each <math id="S6.SS2.p13.m3" class="ltx_Math" alttext="V^{i}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>i</mi></msup><annotation encoding="application/x-tex">V^{i}</annotation></semantics></math> only differ by a constant
shift in the indexes.
Indeed, since <math id="S6.SS2.p13.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central, the image of the composition
<math id="S6.SS2.p13.m5" class="ltx_Math" alttext="\rho_{i}\circ\lambda_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>λ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\rho_{i}\circ\lambda_{1}</annotation></semantics></math> lies in the center of <math id="S6.SS2.p13.m6" class="ltx_Math" alttext="\GL(V^{i})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{i})</annotation></semantics></math>, so
<math id="S6.SS2.p13.m7" class="ltx_Math" alttext="(\mathbb{G}_{m})_{K}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mi>K</mi></msub><annotation encoding="application/x-tex">(\mathbb{G}_{m})_{K}</annotation></semantics></math> acts on <math id="S6.SS2.p13.m8" class="ltx_Math" alttext="V^{i}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>i</mi></msup><annotation encoding="application/x-tex">V^{i}</annotation></semantics></math>, via <math id="S6.SS2.p13.m9" class="ltx_Math" alttext="\rho_{i}\circ(\lambda_{1},1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{i}\circ(\lambda_{1},1)</annotation></semantics></math>, with a fixed
weight <math id="S6.SS2.p13.m10" class="ltx_Math" alttext="m_{i}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>i</mi></msub><annotation encoding="application/x-tex">m_{i}</annotation></semantics></math>. If <math id="S6.SS2.p13.m11" class="ltx_Math" alttext="v\in V^{i}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mi>V</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">v\in V^{i}</annotation></semantics></math> is a vector where <math id="S6.SS2.p13.m12" class="ltx_Math" alttext="(\mathbb{G}_{m})_{K}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mi>K</mi></msub><annotation encoding="application/x-tex">(\mathbb{G}_{m})_{K}</annotation></semantics></math> acts
with weight <math id="S6.SS2.p13.m13" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> via <math id="S6.SS2.p13.m14" class="ltx_Math" alttext="\rho_{i}\circ(\lambda_{1},\lambda_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{i}\circ(\lambda_{1},\lambda_{2})</annotation></semantics></math>,
then the action, via
<math id="S6.SS2.p13.m15" class="ltx_Math" alttext="\rho_{i}\circ(1,\lambda_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{i}\circ(1,\lambda_{2})</annotation></semantics></math>, has weight <math id="S6.SS2.p13.m16" class="ltx_Math" alttext="m-m_{i}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>−</mo><msub><mi>m</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">m-m_{i}</annotation></semantics></math>.
Therefore, the filtrations <math id="S6.SS2.p13.m17" class="ltx_Math" alttext="(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> induced by <math id="S6.SS2.p13.m18" class="ltx_Math" alttext="\rho_{i}\circ(1,\lambda_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{i}\circ(1,\lambda_{2})</annotation></semantics></math> and
<math id="S6.SS2.p13.m19" class="ltx_Math" alttext="\rho_{i}\circ(\lambda_{1},\lambda_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{i}\circ(\lambda_{1},\lambda_{2})</annotation></semantics></math> just differ by a shift by <math id="S6.SS2.p13.m20" class="ltx_Math" alttext="m_{i}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>i</mi></msub><annotation encoding="application/x-tex">m_{i}</annotation></semantics></math>, as
claimed.</span></p>
</div>
<div id="S6.SS2.p14" class="ltx_para">
<p id="S6.SS2.p14.1" class="ltx_p"><span id="S6.SS2.p14.1.1" class="ltx_text">Finally, since the sum in
(<a href="#S6.E14" title="Equation 14 ‣ Definition 6.4. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) does not change by a shift by <math id="S6.SS2.p14.m1" class="ltx_Math" alttext="m_{i}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>i</mi></msub><annotation encoding="application/x-tex">m_{i}</annotation></semantics></math>
on each <math id="S6.SS2.p14.m2" class="ltx_Math" alttext="V^{i}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>i</mi></msup><annotation encoding="application/x-tex">V^{i}</annotation></semantics></math>, we may assume that <math id="S6.SS2.p14.m3" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> is equal to the
constant <math id="S6.SS2.p14.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. In other words, we may assume that <math id="S6.SS2.p14.m5" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> factors
through <math id="S6.SS2.p14.m6" class="ltx_Math" alttext="[G_{K},G_{K}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[G_{K},G_{K}]</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S6.SS2.p15" class="ltx_para">
<p id="S6.SS2.p15.1" class="ltx_p">Proposition <a href="#S6.Thmthm8" title="Proposition 6.8. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.8</span></a> shows that the following definition is consistent with our earlier notions.</p>
</div>
<div id="S6.Thmthm9" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm9.2" class="ltx_text ltx_font_bold">Definition 6.9</span></span><span id="S6.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm9.p1" class="ltx_para">
<p id="S6.Thmthm9.p1.1" class="ltx_p"><span id="S6.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">Suppose that <math id="S6.Thmthm9.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central. Let <math id="S6.Thmthm9.p1.m2" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be an algebraically closed field.
A principal <math id="S6.Thmthm9.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S6.Thmthm9.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> is
Gieseker stable (respectively, Gieseker semistable)
if for all nontrivial cocharacters <math id="S6.Thmthm9.p1.m5" class="ltx_Math" alttext="\lambda:(\mathbb{G}_{m})_{K}\longrightarrow[G_{K},G_{K}]" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mi>K</mi></msub><mo stretchy="false">⟶</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mi>K</mi></msub><mo>,</mo><msub><mi>G</mi><mi>K</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda:(\mathbb{G}_{m})_{K}\longrightarrow[G_{K},G_{K}]</annotation></semantics></math> and all weighted parabolic reductions <math id="S6.Thmthm9.p1.m6" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math>
with associated underlying filtrations <math id="S6.Thmthm9.p1.m7" class="ltx_Math" alttext="(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{i}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> of <math id="S6.Thmthm9.p1.m8" class="ltx_Math" alttext="\mathcal{F}^{i}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\mathcal{F}^{i}</annotation></semantics></math>,
(as in Definition <a href="#S3.Thmthm15" title="Definition 3.15. ‣ 3.3. Filtrations of 
          
            ρ
          
        -sheaves in the split case ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.15</span></a>) we have</span></p>
<table id="S6.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex103.m1" class="ltx_Math" alttext="\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}\left(\rk(\mathcal{F}^{i})\cdot P_{\mathcal{F}^{i}_{m}}-\rk(\mathcal{F}^{i}_{m})\cdot P_{\mathcal{F}^{i}}\right)&lt;0\hskip 10.00002pt\hskip 10.00002pt(\text{respectively, $\leq$})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mo>(</mo><mrow><mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>P</mi><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup></msub></mrow><mo>−</mo><mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>P</mi><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mtext class="ltx_mathvariant_italic">respectively, </mtext><mo>≤</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}\left(\rk(\mathcal{F}^{i})\cdot P_{\mathcal{F}^{i}_{m}}-\rk(\mathcal{F}^{i}_{m})\cdot P_{\mathcal{F}^{i}}\right)&lt;0\hskip 10.00002pt\hskip 10.00002pt(\text{respectively, $\leq$})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm9.p1.2" class="ltx_p"><span id="S6.Thmthm9.p1.2.1" class="ltx_text ltx_font_italic">A principal <math id="S6.Thmthm9.p1.m9" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf is slope stable (respectively, semistable)
if we replace the numerical condition
with</span></p>
<table id="S6.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex104.m1" class="ltx_Math" alttext="\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}\left(\rk(\mathcal{F}^{i})\cdot\deg{\mathcal{F}^{i}_{m}}-\rk(\mathcal{F}^{i}_{m})\cdot\deg{\mathcal{F}^{i}}\right)&lt;0\hskip 10.00002pt\hskip 10.00002pt(\text{respectively, $\leq$})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mo>(</mo><mrow><mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup></mrow></mrow><mo>−</mo><mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>i</mi></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mtext class="ltx_mathvariant_italic">respectively, </mtext><mo>≤</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{b}\sum_{m\in\mathbb{Z}}\left(\rk(\mathcal{F}^{i})\cdot\deg{\mathcal{F}^{i}_{m}}-\rk(\mathcal{F}^{i}_{m})\cdot\deg{\mathcal{F}^{i}}\right)&lt;0\hskip 10.00002pt\hskip 10.00002pt(\text{respectively, $\leq$}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm9.p1.3" class="ltx_p"><span id="S6.Thmthm9.p1.3.1" class="ltx_text ltx_font_italic">We say that a principal <math id="S6.Thmthm9.p1.m10" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf is Gieseker unstable (resp. slope unstable) if it is not Gieseker semistable (resp. it is not slope semistable).</span></p>
</div>
</div>
<div id="S6.SS2.p16" class="ltx_para">
<p id="S6.SS2.p16.1" class="ltx_p">We immediately obtain that slope stable implies Gieseker stable, and Gieseker semistable implies slope semistable.</p>
</div>
<div id="S6.SS2.p17" class="ltx_para">
<p id="S6.SS2.p17.1" class="ltx_p">In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">GLSS10</a>, §1.1, p. 282]</cite>
it is assumed that the field is algebraically
closed, <math id="S6.SS2.p17.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is an arbitrary nonconnected reductive group, and the homomorphism <math id="S6.SS2.p17.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is assumed to be central.
Furthermore, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">GLSS10</a>]</cite> requires that the image of <math id="S6.SS2.p17.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> lies in the
special linear group <math id="S6.SS2.p17.m4" class="ltx_Math" alttext="\left(\prod_{i=1}^{b}\GL(V^{i})\right)\cap\SL(\bigoplus_{i=1}^{b}V^{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>∩</mo><mrow><mi mathsize="0.800em">SL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo lspace="0em">⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><msup><mi>V</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\prod_{i=1}^{b}\GL(V^{i})\right)\cap\SL(\bigoplus_{i=1}^{b}V^{i})</annotation></semantics></math>.
But this is not an essential condition. If we are given a
representation <math id="S6.SS2.p17.m5" class="ltx_Math" alttext="\rho=(\rho_{1},\ldots,\rho_{b})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ρ</mi><mi>b</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho=(\rho_{1},\ldots,\rho_{b})</annotation></semantics></math> we can add one more
summand <math id="S6.SS2.p17.m6" class="ltx_Math" alttext="V^{b+1}=k" display="inline" intent=":literal"><semantics><mrow><msup><mi>V</mi><mrow><mi>b</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">V^{b+1}=k</annotation></semantics></math> and the representation</p>
<table id="S6.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex105.m1" class="ltx_math_unparsed" alttext="\rho^{\prime}=(\rho_{1},\ldots,\rho_{b},(\det(\rho_{1})\cdots\det(\rho_{b}))^{-1})" display="block" intent=":literal"><semantics><mrow><msup><mi>ρ</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ρ</mi><mi>b</mi></msub><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.0835em">⋯</mo><mo lspace="0.0835em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mi>b</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho^{\prime}=(\rho_{1},\ldots,\rho_{b},(\det(\rho_{1})\cdots\det(\rho_{b}))^{-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p17.2" class="ltx_p">will automatically land in the special linear group. A <math id="S6.SS2.p17.m7" class="ltx_Math" alttext="\rho^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ρ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\rho^{\prime}</annotation></semantics></math>-sheaf is
<math id="S6.SS2.p17.m8" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf together with an isomorphism
<math id="S6.SS2.p17.m9" class="ltx_math_unparsed" alttext="\det(\mathcal{F}^{1})\otimes\cdots\otimes\det(\mathcal{F}^{b})\cong(\mathcal{F}^{b+1})^{\vee}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo>⊗</mo><mo lspace="0.055em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>b</mi></msup><mo stretchy="false">)</mo></mrow><mo>≅</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>b</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>∨</mo></msup></mrow><annotation encoding="application/x-tex">\det(\mathcal{F}^{1})\otimes\cdots\otimes\det(\mathcal{F}^{b})\cong(\mathcal{F}^{b+1})^{\vee}</annotation></semantics></math>. The <math id="S6.SS2.p17.m10" class="ltx_Math" alttext="\rho^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ρ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\rho^{\prime}</annotation></semantics></math>-sheaf
is (semi)stable in the sense of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">GLSS10</a>]</cite>
if and only if the corresponding <math id="S6.SS2.p17.m11" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf is
(semi)stable. Therefore, all the comparisons that are made in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">GLSS10</a>, §6]</cite>
also hold for our notion of semistability in the case when <math id="S6.SS2.p17.m12" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central. The following corollary follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">GLSS10</a>, Lemma 2.5.4 and Remark 2.5.5]</cite>.</p>
</div>
<div id="S6.Thmthm10" class="ltx_theorem ltx_theorem_coroll">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm10.2" class="ltx_text ltx_font_bold">Corollary 6.10</span></span><span id="S6.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm10.p1" class="ltx_para">
<p id="S6.Thmthm10.p1.1" class="ltx_p"><span id="S6.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S6.Thmthm10.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central, then a principal <math id="S6.Thmthm10.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf
is slope (semi)stable if and only if the underlying rational principal
bundle is slope (semi)stable in the sense of Ramanathan (Definition <a href="#S6.Thmthm5" title="Definition 6.5 ([]). ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.5</span></a>). ∎</span></p>
</div>
</div>
<div id="S6.SS2.p18" class="ltx_para">
<p id="S6.SS2.p18.1" class="ltx_p">We end this section by comparing our notion of leading term filtration with previous work in the literature. We return to our interpretation of <math id="S6.SS2.p18.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves as pairs <math id="S6.SS2.p18.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> as in <a href="#S6.Thmthm1" title="Definition 6.1. ‣ 6.1. Generalization: 
          
            ρ
          
        -sheaves for products of general linear groups ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a>.</p>
</div>
<div id="S6.Thmthm11" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm11.2" class="ltx_text ltx_font_bold">Proposition 6.11</span></span><span id="S6.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm11.p1" class="ltx_para">
<p id="S6.Thmthm11.p1.1" class="ltx_p"><span id="S6.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">Suppose that the representation <math id="S6.Thmthm11.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central. Let <math id="S6.Thmthm11.p1.m2" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be a field extension such that <math id="S6.Thmthm11.p1.m3" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is split. Let <math id="S6.Thmthm11.p1.m4" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be a <math id="S6.Thmthm11.p1.m5" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S6.Thmthm11.p1.m6" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> and choose a big open subset <math id="S6.Thmthm11.p1.m7" class="ltx_Math" alttext="U\subset X_{K}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><msub><mi>X</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">U\subset X_{K}</annotation></semantics></math> such that <math id="S6.Thmthm11.p1.m8" class="ltx_Math" alttext="\mathcal{F}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{F}|_{U}</annotation></semantics></math> is locally-free. Let <math id="S6.Thmthm11.p1.m9" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> denote the rational <math id="S6.Thmthm11.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S6.Thmthm11.p1.m11" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> corresponding to <math id="S6.Thmthm11.p1.m12" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> and suppose that <math id="S6.Thmthm11.p1.m13" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is (slope) unstable in the sense of Ramanathan. If <math id="S6.Thmthm11.p1.m14" class="ltx_Math" alttext="f=(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> is the leading term HN weighted parabolic reduction of <math id="S6.Thmthm11.p1.m15" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>, then <math id="S6.Thmthm11.p1.m16" class="ltx_Math" alttext="\mathcal{G}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\lambda}</annotation></semantics></math> is the canonical (slope) parabolic reduction of <math id="S6.Thmthm11.p1.m17" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> as defined in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AAB02</a>]</cite>.</span></p>
</div>
</div>
<div id="S6.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.p19" class="ltx_para">
<p id="S6.SS2.p19.1" class="ltx_p"><span id="S6.SS2.p19.1.1" class="ltx_text">We will use the setup and notation from Propositions <a href="#S4.Thmthm25" title="Proposition 4.25. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.25</span></a> and <a href="#S6.Thmthm6" title="Proposition 6.6. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a>. The group <math id="S6.SS2.p19.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> acts on each vector space <math id="S6.SS2.p19.m2" class="ltx_Math" alttext="V^{j}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>j</mi></msup><annotation encoding="application/x-tex">V^{j}</annotation></semantics></math> via the homomorphism <math id="S6.SS2.p19.m3" class="ltx_Math" alttext="\rho_{j}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\rho_{j}</annotation></semantics></math>. For each <math id="S6.SS2.p19.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, we denote by <math id="S6.SS2.p19.m5" class="ltx_Math" alttext="(\chi_{i,j})_{i=1}^{r_{j}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><annotation encoding="application/x-tex">(\chi_{i,j})_{i=1}^{r_{j}}</annotation></semantics></math> the tuple of weights of the split maximal torus <math id="S6.SS2.p19.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> acting on <math id="S6.SS2.p19.m7" class="ltx_Math" alttext="V^{j}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>j</mi></msup><annotation encoding="application/x-tex">V^{j}</annotation></semantics></math> (with possible repetitions). Since the representation <math id="S6.SS2.p19.m8" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is faithful, the collection of all the weights <math id="S6.SS2.p19.m9" class="ltx_Math" alttext="(\chi_{i,j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\chi_{i,j})</annotation></semantics></math> determines a positive definite inner product <math id="S6.SS2.p19.m10" class="ltx_math_unparsed" alttext="\cdot_{\chi}" display="inline" intent=":literal"><semantics><mrow><mo>⋅</mo><msub><mrow></mrow><mi>χ</mi></msub></mrow><annotation encoding="application/x-tex">\cdot_{\chi}</annotation></semantics></math> on <math id="S6.SS2.p19.m11" class="ltx_Math" alttext="X_{*}(T)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X_{*}(T)_{\mathbb{R}}</annotation></semantics></math> given by</span></p>
<table id="S6.Ex106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex106.m1" class="ltx_Math" alttext="\delta\cdot_{\chi}\gamma\vcentcolon=\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle\delta,\chi_{i,j}\rangle\cdot\langle\gamma,\chi_{i,j}\rangle" display="block" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>χ</mi></msub><mi>γ</mi></mrow><mo rspace="0.111em">:=</mo><mrow><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></munderover><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msub><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>γ</mi><mo>,</mo><msub><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\cdot_{\chi}\gamma\vcentcolon=\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle\delta,\chi_{i,j}\rangle\cdot\langle\gamma,\chi_{i,j}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p19.2" class="ltx_p"><span id="S6.SS2.p19.2.1" class="ltx_text">which is invariant under the action of the Weyl group <math id="S6.SS2.p19.m12" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>. We can restrict this inner product to <math id="S6.SS2.p19.m13" class="ltx_Math" alttext="X_{*}(Z_{\lambda})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X_{*}(Z_{\lambda})_{\mathbb{R}}</annotation></semantics></math> in order to obtain a <math id="S6.SS2.p19.m14" class="ltx_Math" alttext="W_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">W_{P_{\lambda}}</annotation></semantics></math>-invariant positive definite inner product.</span></p>
</div>
<div id="S6.SS2.p20" class="ltx_para">
<p id="S6.SS2.p20.1" class="ltx_p"><span id="S6.SS2.p20.1.1" class="ltx_text">Recall that we have</span></p>
<table id="S6.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(17)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E17.m1" class="ltx_Math" alttext="\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle\delta,\chi^{\lambda}_{i,j}\rangle\cdot(c_{i,j}-c_{j})}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle\delta,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>c</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><msup><mrow><mo>(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle\delta,\chi^{\lambda}_{i,j}\rangle\cdot(c_{i,j}-c_{j})}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle\delta,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p20.2" class="ltx_p"><span id="S6.SS2.p20.2.1" class="ltx_text">where we define <math id="S6.SS2.p20.m1" class="ltx_Math" alttext="c_{i,j}=\langle\psi,\chi_{i,j}^{\lambda}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">c_{i,j}=\langle\psi,\chi_{i,j}^{\lambda}\rangle</annotation></semantics></math> and <math id="S6.SS2.p20.m2" class="ltx_Math" alttext="c_{j}=\frac{1}{r_{j}}\langle\psi,\sum_{i=1}^{r_{j}}\chi_{i,j}^{\lambda}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>j</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><msub><mi>r</mi><mi>j</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>ψ</mi><mo rspace="0em">,</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{j}=\frac{1}{r_{j}}\langle\psi,\sum_{i=1}^{r_{j}}\chi_{i,j}^{\lambda}\rangle</annotation></semantics></math>. Set <math id="S6.SS2.p20.m3" class="ltx_math_unparsed" alttext="\det_{j}=\det(V^{j})\circ\rho_{j}=\sum_{i=1}^{r_{j}}\chi_{i,j}" display="inline" intent=":literal"><semantics><mrow><msub><mo>det</mo><mi>j</mi></msub><mo lspace="0.278em" rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>j</mi></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><msub><mi>ρ</mi><mi>j</mi></msub><mo rspace="0.111em">=</mo><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><msub><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\det_{j}=\det(V^{j})\circ\rho_{j}=\sum_{i=1}^{r_{j}}\chi_{i,j}</annotation></semantics></math>. Rewrite (<a href="#S6.E17" title="Equation 17 ‣ Proof. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) as</span></p>
<table id="S6.EGx10" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S6.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex107.m1" class="ltx_Math" alttext="\displaystyle\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle\delta,\chi^{\lambda}_{i,j}\rangle\cdot\langle\psi,\chi_{i,j}^{\lambda}\rangle-\frac{1}{r_{j}}\langle\delta,\det_{j}\rangle\cdot\langle\psi,\det_{j}\rangle}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle\delta,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}=" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>b</mi></msup><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><msub><mi>r</mi><mi>j</mi></msub></msup><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mi>δ</mi><mo>,</mo><mi>χ</mi><msup><mrow></mrow><mi>λ</mi></msup><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo><mo rspace="0.222em">⋅</mo><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mi>ψ</mi><mo>,</mo><mi>χ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mrow></mrow><mi>λ</mi></msup><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo><mo>−</mo><mfrac><mn>1</mn><msub><mi>r</mi><mi>j</mi></msub></mfrac><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mi>δ</mi><mo>,</mo><mo lspace="0em" rspace="0em">det</mo><msub><mrow></mrow><mi>j</mi></msub><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo><mo rspace="0.222em">⋅</mo><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mi>ψ</mi><mo>,</mo><mo lspace="0em" rspace="0em">det</mo><msub><mrow></mrow><mi>j</mi></msub><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>r</mi><mi>j</mi></msub></msubsup><msup><mrow><mo>(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mfrac></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\langle\delta,\chi^{\lambda}_{i,j}\rangle\cdot\langle\psi,\chi_{i,j}^{\lambda}\rangle-\frac{1}{r_{j}}\langle\delta,\det_{j}\rangle\cdot\langle\psi,\det_{j}\rangle}{\sqrt{\sum_{j=1}^{b}\sum_{i=1}^{r_{j}}\left(\langle\delta,\chi^{\lambda}_{i,j}\rangle\right)^{2}}}=</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S6.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(18)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E18.m1" class="ltx_Math" alttext="\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\delta\cdot_{\chi}\psi-\sum_{j=1}^{b}\frac{1}{r_{j}}\langle\delta,\det_{j}\rangle\cdot\langle\psi,\det_{j}\rangle}{\sqrt{\delta\cdot_{\chi}\delta}}" display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow></mrow><mi>χ</mi></msub><mi>ψ</mi><mo rspace="0.055em">−</mo><mo>∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>b</mi></msup><mfrac><mn>1</mn><msub><mi>r</mi><mi>j</mi></msub></mfrac><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mi>δ</mi><mo>,</mo><mo lspace="0em" rspace="0em">det</mo><msub><mrow></mrow><mi>j</mi></msub><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo><mo rspace="0.222em">⋅</mo><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mi>ψ</mi><mo>,</mo><mo lspace="0em" rspace="0em">det</mo><msub><mrow></mrow><mi>j</mi></msub><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><msqrt><mrow><mi>δ</mi><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>χ</mi></msub><mi>δ</mi></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\delta\cdot_{\chi}\psi-\sum_{j=1}^{b}\frac{1}{r_{j}}\langle\delta,\det_{j}\rangle\cdot\langle\psi,\det_{j}\rangle}{\sqrt{\delta\cdot_{\chi}\delta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p20.3" class="ltx_p"><span id="S6.SS2.p20.3.1" class="ltx_text">Recall that</span></p>
<table id="S6.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex108.m1" class="ltx_Math" alttext="X_{*}(Z_{\lambda})_{\mathbb{R}}=\bigoplus_{l=1}^{h}\mathbb{R}z_{l}\oplus\bigoplus_{n\in J_{P_{\lambda}}}\mathbb{R}\omega_{n}^{\vee}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></munderover><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>l</mi></msub></mrow></mrow><mo rspace="0.055em">⊕</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></munder><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z_{\lambda})_{\mathbb{R}}=\bigoplus_{l=1}^{h}\mathbb{R}z_{l}\oplus\bigoplus_{n\in J_{P_{\lambda}}}\mathbb{R}\omega_{n}^{\vee}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p20.4" class="ltx_p"><span id="S6.SS2.p20.4.1" class="ltx_text">Choose a pair <math id="S6.SS2.p20.m4" class="ltx_Math" alttext="z_{l}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>l</mi></msub><annotation encoding="application/x-tex">z_{l}</annotation></semantics></math> and <math id="S6.SS2.p20.m5" class="ltx_Math" alttext="\omega_{n}^{\vee}" display="inline" intent=":literal"><semantics><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup><annotation encoding="application/x-tex">\omega_{n}^{\vee}</annotation></semantics></math>. Let <math id="S6.SS2.p20.m6" class="ltx_Math" alttext="s_{n}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>n</mi></msub><annotation encoding="application/x-tex">s_{n}</annotation></semantics></math> denote the simple reflection of <math id="S6.SS2.p20.m7" class="ltx_Math" alttext="X_{*}(T)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X_{*}(T)_{\mathbb{R}}</annotation></semantics></math> determined by the root <math id="S6.SS2.p20.m8" class="ltx_Math" alttext="\alpha_{n}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\alpha_{n}</annotation></semantics></math>. Since <math id="S6.SS2.p20.m9" class="ltx_math_unparsed" alttext="\cdot_{\chi}" display="inline" intent=":literal"><semantics><mrow><mo>⋅</mo><msub><mrow></mrow><mi>χ</mi></msub></mrow><annotation encoding="application/x-tex">\cdot_{\chi}</annotation></semantics></math> is <math id="S6.SS2.p20.m10" class="ltx_Math" alttext="W_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">W_{P_{\lambda}}</annotation></semantics></math>-invariant, we have</span></p>
<table id="S6.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex109.m1" class="ltx_Math" alttext="z_{l}\cdot_{\chi}\omega_{n}^{\vee}=(s_{n}z_{l})\cdot_{\chi}(s_{n}\omega_{n}^{\vee})=z_{l}\cdot_{\chi}(-\omega_{n}^{\vee})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>z</mi><mi>l</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>χ</mi></msub><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>s</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>l</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>s</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>z</mi><mi>l</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">z_{l}\cdot_{\chi}\omega_{n}^{\vee}=(s_{n}z_{l})\cdot_{\chi}(s_{n}\omega_{n}^{\vee})=z_{l}\cdot_{\chi}(-\omega_{n}^{\vee}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p20.5" class="ltx_p"><span id="S6.SS2.p20.5.1" class="ltx_text">This shows that <math id="S6.SS2.p20.m11" class="ltx_Math" alttext="z_{l}\cdot_{\chi}\omega_{n}^{\vee}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>z</mi><mi>l</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>χ</mi></msub><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">z_{l}\cdot_{\chi}\omega_{n}^{\vee}=0</annotation></semantics></math>, and so the central cocharacters <math id="S6.SS2.p20.m12" class="ltx_Math" alttext="X_{*}(Z)_{\mathbb{R}}=\bigoplus_{i=1}^{h}\mathbb{R}z_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></msubsup><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z)_{\mathbb{R}}=\bigoplus_{i=1}^{h}\mathbb{R}z_{i}</annotation></semantics></math> are orthogonal to the fundamental coweights. Therefore, the projection <math id="S6.SS2.p20.m13" class="ltx_Math" alttext="\pi_{Z}:X_{*}(Z_{\lambda})_{\mathbb{R}}\rightarrow\bigoplus_{n\in J_{P_{\lambda}}}\mathbb{R}\omega_{n}^{\vee}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msub><mo>⨁</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></msub><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{Z}:X_{*}(Z_{\lambda})_{\mathbb{R}}\rightarrow\bigoplus_{n\in J_{P_{\lambda}}}\mathbb{R}\omega_{n}^{\vee}</annotation></semantics></math> is an orthogonal projection with respect to <math id="S6.SS2.p20.m14" class="ltx_math_unparsed" alttext="\cdot_{\chi}" display="inline" intent=":literal"><semantics><mrow><mo>⋅</mo><msub><mrow></mrow><mi>χ</mi></msub></mrow><annotation encoding="application/x-tex">\cdot_{\chi}</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p21" class="ltx_para">
<p id="S6.SS2.p21.1" class="ltx_p"><span id="S6.SS2.p21.1.1" class="ltx_text">By assumption, the central torus <math id="S6.SS2.p21.m1" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> maps to the center of <math id="S6.SS2.p21.m2" class="ltx_Math" alttext="\prod_{j=1}^{b}\GL(V^{j})" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>j</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\prod_{j=1}^{b}\GL(V^{j})</annotation></semantics></math>. For every index <math id="S6.SS2.p21.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>, since <math id="S6.SS2.p21.m4" class="ltx_Math" alttext="\rho_{j}\circ z_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>z</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">\rho_{j}\circ z_{l}</annotation></semantics></math> lands in the center of <math id="S6.SS2.p21.m5" class="ltx_Math" alttext="\GL(V^{j})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>j</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{j})</annotation></semantics></math>, we must have <math id="S6.SS2.p21.m6" class="ltx_Math" alttext="\langle z_{l},\chi_{i,j}\rangle=\langle z_{l},\chi_{p,j}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><msub><mi>z</mi><mi>l</mi></msub><mo>,</mo><msub><mi>χ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>=</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><msub><mi>z</mi><mi>l</mi></msub><mo>,</mo><msub><mi>χ</mi><mrow><mi>p</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\langle z_{l},\chi_{i,j}\rangle=\langle z_{l},\chi_{p,j}\rangle</annotation></semantics></math> for any <math id="S6.SS2.p21.m7" class="ltx_Math" alttext="i,p" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">i,p</annotation></semantics></math>. It follows that <math id="S6.SS2.p21.m8" class="ltx_math_unparsed" alttext="\langle z_{l},\det_{j}\rangle=r_{j}\langle z_{l},\chi_{1,j}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><msub><mi>z</mi><mi>l</mi></msub><mo>,</mo><msub><mo lspace="0em" rspace="0em">det</mo><mi>j</mi></msub><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>=</mo><msub><mi>r</mi><mi>j</mi></msub><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><msub><mi>z</mi><mi>l</mi></msub><mo>,</mo><msub><mi>χ</mi><mrow><mn>1</mn><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\langle z_{l},\det_{j}\rangle=r_{j}\langle z_{l},\chi_{1,j}\rangle</annotation></semantics></math> for the fixed index <math id="S6.SS2.p21.m9" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math>. This implies that</span></p>
<table id="S6.Ex110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex110.m1" class="ltx_math_unparsed" alttext="\delta\cdot_{\chi}\psi-\sum_{j=1}^{b}\frac{1}{r_{j}}\langle\delta,{\det}_{j}\rangle\cdot\langle\psi,{\det}_{j}\rangle=\pi_{Z}(\delta)\cdot_{\chi}\pi_{Z}(\psi)" display="block" intent=":literal"><semantics><mrow><mi>δ</mi><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>χ</mi></msub><mi>ψ</mi><mo rspace="0.055em">−</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover><mfrac><mn>1</mn><msub><mi>r</mi><mi>j</mi></msub></mfrac><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mi>δ</mi><mo>,</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">det</mo><mi>j</mi></munder><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mi>ψ</mi><mo>,</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">det</mo><mi>j</mi></munder><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>=</mo><msub><mi>π</mi><mi>Z</mi></msub><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><msub><mi>π</mi><mi>Z</mi></msub><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\cdot_{\chi}\psi-\sum_{j=1}^{b}\frac{1}{r_{j}}\langle\delta,{\det}_{j}\rangle\cdot\langle\psi,{\det}_{j}\rangle=\pi_{Z}(\delta)\cdot_{\chi}\pi_{Z}(\psi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p21.2" class="ltx_p"><span id="S6.SS2.p21.2.1" class="ltx_text">Therefore, (<a href="#S6.E18" title="Equation 18 ‣ Proof. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) turns out to be:</span></p>
<table id="S6.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(19)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E19.m1" class="ltx_Math" alttext="\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\pi_{Z}(\delta)\cdot_{\chi}\pi_{Z}(\psi)}{\sqrt{\delta\cdot_{\chi}\delta}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><msqrt><mrow><mi>δ</mi><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>χ</mi></msub><mi>δ</mi></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\pi_{Z}(\delta)\cdot_{\chi}\pi_{Z}(\psi)}{\sqrt{\delta\cdot_{\chi}\delta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.SS2.p22" class="ltx_para">
<p id="S6.SS2.p22.1" class="ltx_p"><span id="S6.SS2.p22.1.1" class="ltx_text">By Corollary <a href="#S6.Thmthm10" title="Corollary 6.10. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.10</span></a>, the <math id="S6.SS2.p22.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S6.SS2.p22.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> is unstable. Using the proof of Proposition <a href="#S6.Thmthm8" title="Proposition 6.8. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.8</span></a> we can conclude that the image of <math id="S6.SS2.p22.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is not contained in the center of <math id="S6.SS2.p22.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Therefore the parabolic <math id="S6.SS2.p22.m5" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math> is a proper subgroup of <math id="S6.SS2.p22.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. We denote by <math id="S6.SS2.p22.m7" class="ltx_Math" alttext="f=(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> the leading term HN weighted parabolic reduction of <math id="S6.SS2.p22.m8" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>. To prove that <math id="S6.SS2.p22.m9" class="ltx_Math" alttext="\mathcal{G}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\lambda}</annotation></semantics></math> is the canonical parabolic reduction of the rational <math id="S6.SS2.p22.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S6.SS2.p22.m11" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>, we need to show the following (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AAB02</a>, Thm. 6]</cite>):</span></p>
<ol id="S6.I2" class="ltx_enumerate">
<li id="S6.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S6.I2.i1.p1" class="ltx_para">
<p id="S6.I2.i1.p1.1" class="ltx_p">The linear functional <math id="S6.I2.i1.p1.m1" class="ltx_Math" alttext="\psi\in X_{*}(Z_{\lambda})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>∈</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\psi\in X_{*}(Z_{\lambda})_{\mathbb{R}}</annotation></semantics></math> lies in the interior <math id="S6.I2.i1.p1.m2" class="ltx_Math" alttext="\Int(\mathcal{C}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Int(\mathcal{C}_{\lambda})</annotation></semantics></math> of the dominant cone <math id="S6.I2.i1.p1.m3" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S6.I2.i2.p1" class="ltx_para">
<p id="S6.I2.i2.p1.1" class="ltx_p">The rational <math id="S6.I2.i2.p1.m1" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>-bundle <math id="S6.I2.i2.p1.m2" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}</annotation></semantics></math> is slope semistable.</p>
</div></li>
</ol>
<p id="S6.SS2.p22.2" class="ltx_p"><span id="S6.SS2.p22.2.1" class="ltx_text">We proceed with the proof of these statements.</span></p>
</div>
<div id="S6.SS2.p23" class="ltx_para">
<p id="S6.SS2.p23.1" class="ltx_p"><span id="S6.SS2.p23.1.1" class="ltx_text">(i) Since <math id="S6.SS2.p23.m1" class="ltx_Math" alttext="f=(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> maximizes <math id="S6.SS2.p23.m2" class="ltx_Math" alttext="\nu(f)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(f)</annotation></semantics></math> in the interior of <math id="S6.SS2.p23.m3" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math>, we know that <math id="S6.SS2.p23.m4" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is a critical point of <math id="S6.SS2.p23.m5" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math>. It follows from Cauchy-Schwarz that this critical point is a scalar multiple of <math id="S6.SS2.p23.m6" class="ltx_Math" alttext="\pi_{Z}(\psi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{Z}(\psi)</annotation></semantics></math>. We must have <math id="S6.SS2.p23.m7" class="ltx_Math" alttext="\lambda=Q\cdot\pi_{Z}(\psi)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mrow><mi>Q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>π</mi><mi>Z</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda=Q\cdot\pi_{Z}(\psi)</annotation></semantics></math> for some constant <math id="S6.SS2.p23.m8" class="ltx_Math" alttext="Q&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Q&gt;0</annotation></semantics></math>, because <math id="S6.SS2.p23.m9" class="ltx_Math" alttext="\nu(f)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu(f)&gt;0</annotation></semantics></math> and then <math id="S6.SS2.p23.m10" class="ltx_Math" alttext="\nu_{d-1}(\lambda)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\lambda)\geq 0</annotation></semantics></math>. Since <math id="S6.SS2.p23.m11" class="ltx_Math" alttext="\lambda\in\Int(\mathcal{C}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mi mathsize="0.800em">Int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\in\Int(\mathcal{C}_{\lambda})</annotation></semantics></math> by definition, it follows that <math id="S6.SS2.p23.m12" class="ltx_Math" alttext="\pi_{Z}(\psi)\in\Int(\mathcal{C}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi mathsize="0.800em">Int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{Z}(\psi)\in\Int(\mathcal{C}_{\lambda})</annotation></semantics></math>. Therefore <math id="S6.SS2.p23.m13" class="ltx_Math" alttext="\psi\in\Int(\mathcal{C}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>∈</mo><mrow><mi mathsize="0.800em">Int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi\in\Int(\mathcal{C}_{\lambda})</annotation></semantics></math>, as desired.</span></p>
</div>
<div id="S6.SS2.p24" class="ltx_para">
<p id="S6.SS2.p24.1" class="ltx_p"><span id="S6.SS2.p24.1.1" class="ltx_text">(ii) Suppose for the sake of contradiction that <math id="S6.SS2.p24.m1" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}</annotation></semantics></math> is not slope semistable. Let <math id="S6.SS2.p24.m2" class="ltx_Math" alttext="\mathcal{G}_{\overline{P}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>P</mi><mo stretchy="true">¯</mo></mover></msub><annotation encoding="application/x-tex">\mathcal{G}_{\overline{P}}</annotation></semantics></math> be the canonical slope parabolic reduction of <math id="S6.SS2.p24.m3" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}</annotation></semantics></math> for some proper parabolic subgroup <math id="S6.SS2.p24.m4" class="ltx_Math" alttext="\overline{P}\subset L_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>P</mi><mo stretchy="true">¯</mo></mover><mo>⊂</mo><msub><mi>L</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">\overline{P}\subset L_{\lambda}</annotation></semantics></math>, as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AAB02</a>]</cite>. This reduction is defined over a big open subset. After shrinking the original open subset <math id="S6.SS2.p24.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, we can assume that everything is defined over <math id="S6.SS2.p24.m6" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p25" class="ltx_para">
<p id="S6.SS2.p25.1" class="ltx_p"><span id="S6.SS2.p25.1.1" class="ltx_text">Let <math id="S6.SS2.p25.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> denote the inverse image of <math id="S6.SS2.p25.m2" class="ltx_Math" alttext="\overline{P}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>P</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{P}</annotation></semantics></math> under the canonical quotient map <math id="S6.SS2.p25.m3" class="ltx_Math" alttext="P_{\lambda}\twoheadrightarrow L_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>λ</mi></msub><mo stretchy="false">↠</mo><msub><mi>L</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">P_{\lambda}\twoheadrightarrow L_{\lambda}</annotation></semantics></math>. Note that <math id="S6.SS2.p25.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is a parabolic subgroup of <math id="S6.SS2.p25.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> (cf. second paragraph of the proof of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BH04</a>, Prop. 3.1]</cite>). Let <math id="S6.SS2.p25.m6" class="ltx_Math" alttext="\iota:P\hookrightarrow P_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>P</mi><mo stretchy="false">↪</mo><msub><mi>P</mi><mi>λ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\iota:P\hookrightarrow P_{\lambda}</annotation></semantics></math> denote the inclusion and let <math id="S6.SS2.p25.m7" class="ltx_Math" alttext="q:P\twoheadrightarrow\overline{P}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>P</mi><mo stretchy="false">↠</mo><mover accent="true"><mi>P</mi><mo stretchy="true">¯</mo></mover></mrow></mrow><annotation encoding="application/x-tex">q:P\twoheadrightarrow\overline{P}</annotation></semantics></math> denote the quotient map. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BH04</a>, Lem. 2.1]</cite>, there exists a unique <math id="S6.SS2.p25.m8" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>-parabolic reduction <math id="S6.SS2.p25.m9" class="ltx_Math" alttext="\mathcal{G}_{P}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>P</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{P}</annotation></semantics></math> of <math id="S6.SS2.p25.m10" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> such that <math id="S6.SS2.p25.m11" class="ltx_Math" alttext="\iota_{*}(\mathcal{G}_{P})=\mathcal{G}_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ι</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>P</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">\iota_{*}(\mathcal{G}_{P})=\mathcal{G}_{\lambda}</annotation></semantics></math> and <math id="S6.SS2.p25.m12" class="ltx_Math" alttext="q_{*}(\mathcal{G}_{P})=\mathcal{G}_{\overline{P}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>P</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>P</mi><mo stretchy="true">¯</mo></mover></msub></mrow><annotation encoding="application/x-tex">q_{*}(\mathcal{G}_{P})=\mathcal{G}_{\overline{P}}</annotation></semantics></math>. Let <math id="S6.SS2.p25.m13" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> be the unique Levi subgroup of <math id="S6.SS2.p25.m14" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> containing the maximal torus <math id="S6.SS2.p25.m15" class="ltx_Math" alttext="T\subset P_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⊂</mo><msub><mi>P</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">T\subset P_{\lambda}</annotation></semantics></math>, and let <math id="S6.SS2.p25.m16" class="ltx_Math" alttext="Z_{L}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>L</mi></msub><annotation encoding="application/x-tex">Z_{L}</annotation></semantics></math> denote the maximal central torus of <math id="S6.SS2.p25.m17" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. The canonical inclusion <math id="S6.SS2.p25.m18" class="ltx_Math" alttext="Z_{\lambda}\subset Z_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>λ</mi></msub><mo>⊂</mo><msub><mi>Z</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">Z_{\lambda}\subset Z_{L}</annotation></semantics></math> induces an inclusion <math id="S6.SS2.p25.m19" class="ltx_Math" alttext="X_{*}(Z_{\lambda})_{\mathbb{R}}\subset X_{*}(Z_{L})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo>⊂</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z_{\lambda})_{\mathbb{R}}\subset X_{*}(Z_{L})_{\mathbb{R}}</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p26" class="ltx_para">
<p id="S6.SS2.p26.1" class="ltx_p"><span id="S6.SS2.p26.1.1" class="ltx_text">Since <math id="S6.SS2.p26.m1" class="ltx_Math" alttext="\lambda=Q\cdot\pi_{Z}(\psi)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mrow><mi>Q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>π</mi><mi>Z</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda=Q\cdot\pi_{Z}(\psi)</annotation></semantics></math> for <math id="S6.SS2.p26.m2" class="ltx_Math" alttext="Q&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Q&gt;0</annotation></semantics></math>, (<a href="#S6.E19" title="Equation 19 ‣ Proof. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) is given by</span></p>
<table id="S6.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex111.m1" class="ltx_Math" alttext="\nu_{d-1}(\lambda)=\frac{1}{\sqrt{A_{d}}(d-1)!}\cdot\sqrt{\pi_{Z}(\psi)\cdot_{\chi}\pi_{Z}(\psi)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\lambda)=\frac{1}{\sqrt{A_{d}}(d-1)!}\cdot\sqrt{\pi_{Z}(\psi)\cdot_{\chi}\pi_{Z}(\psi)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.SS2.p27" class="ltx_para">
<p id="S6.SS2.p27.1" class="ltx_p"><span id="S6.SS2.p27.1.1" class="ltx_text">On the other hand, let</span></p>
<table id="S6.Ex112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex112.m1" class="ltx_Math" alttext="\psi_{L}=z+\sum_{n\in J_{P}}a_{n}\omega_{n}^{\vee}\in X_{*}(Z_{L})_{\mathbb{R}}=X_{*}(Z)_{\mathbb{R}}\oplus\bigoplus_{n\in J_{P}}\mathbb{R}\omega_{n}^{\vee}" display="block" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>L</mi></msub><mo>=</mo><mrow><mi>z</mi><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi>J</mi><mi>P</mi></msub></mrow></munder><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow></mrow><mo>∈</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo>=</mo><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo rspace="0.055em">⊕</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi>J</mi><mi>P</mi></msub></mrow></munder><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{L}=z+\sum_{n\in J_{P}}a_{n}\omega_{n}^{\vee}\in X_{*}(Z_{L})_{\mathbb{R}}=X_{*}(Z)_{\mathbb{R}}\oplus\bigoplus_{n\in J_{P}}\mathbb{R}\omega_{n}^{\vee}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p27.2" class="ltx_p"><span id="S6.SS2.p27.2.1" class="ltx_text">be the linear functional corresponding to the <math id="S6.SS2.p27.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-bundle <math id="S6.SS2.p27.m2" class="ltx_Math" alttext="\mathcal{G}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{L}</annotation></semantics></math> defined as in the proof of Lemma <a href="#S4.Thmthm24" title="Lemma 4.24. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.24</span></a>. Here <math id="S6.SS2.p27.m3" class="ltx_Math" alttext="z\in X_{*}(Z)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">z\in X_{*}(Z)_{\mathbb{R}}</annotation></semantics></math> and <math id="S6.SS2.p27.m4" class="ltx_Math" alttext="a_{n}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">a_{n}\in\mathbb{R}</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p28" class="ltx_para">
<p id="S6.SS2.p28.1" class="ltx_p"><span id="S6.SS2.p28.1.1" class="ltx_text">By construction, <math id="S6.SS2.p28.m1" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}</annotation></semantics></math> is isomorphic to the <math id="S6.SS2.p28.m2" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>-bundle obtained from <math id="S6.SS2.p28.m3" class="ltx_Math" alttext="\mathcal{G}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{L}</annotation></semantics></math> by extension of structure group via the inclusion <math id="S6.SS2.p28.m4" class="ltx_Math" alttext="L\subset L_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><msub><mi>L</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">L\subset L_{\lambda}</annotation></semantics></math>. This implies that <math id="S6.SS2.p28.m5" class="ltx_Math" alttext="\psi=z+\sum_{n\in J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>=</mo><mrow><mi>z</mi><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></msub><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi=z+\sum_{n\in J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}</annotation></semantics></math>, hence</span></p>
<table id="S6.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(20)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E20.m1" class="ltx_Math" alttext="\psi_{L}=\psi+\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}" display="block" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>L</mi></msub><mo>=</mo><mrow><mi>ψ</mi><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow></munder><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{L}=\psi+\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p28.2" class="ltx_p"><span id="S6.SS2.p28.2.1" class="ltx_text">In particular we have <math id="S6.SS2.p28.m6" class="ltx_Math" alttext="a_{n}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{n}&gt;0</annotation></semantics></math> for all <math id="S6.SS2.p28.m7" class="ltx_Math" alttext="n\in J_{P_{\lambda}}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow><annotation encoding="application/x-tex">n\in J_{P_{\lambda}}</annotation></semantics></math>, because <math id="S6.SS2.p28.m8" class="ltx_Math" alttext="\psi\in\Int(\mathcal{C}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>∈</mo><mrow><mi mathsize="0.800em">Int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi\in\Int(\mathcal{C}_{\lambda})</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p29" class="ltx_para">
<p id="S6.SS2.p29.1" class="ltx_p"><span id="S6.SS2.p29.1.1" class="ltx_text">We know that the bundle <math id="S6.SS2.p29.m1" class="ltx_Math" alttext="q_{*}(\mathcal{G}_{P})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>P</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{*}(\mathcal{G}_{P})</annotation></semantics></math> is the canonical slope parabolic reduction of <math id="S6.SS2.p29.m2" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}</annotation></semantics></math>. This implies that <math id="S6.SS2.p29.m3" class="ltx_Math" alttext="a_{n}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{n}&gt;0</annotation></semantics></math> for all the other indexes <math id="S6.SS2.p29.m4" class="ltx_Math" alttext="n\in J_{P}\setminus J_{P_{\lambda}}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">n\in J_{P}\setminus J_{P_{\lambda}}</annotation></semantics></math>. We conclude that <math id="S6.SS2.p29.m5" class="ltx_Math" alttext="\psi_{L}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\psi_{L}</annotation></semantics></math> is in the interior of the <math id="S6.SS2.p29.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>-dominant cone <math id="S6.SS2.p29.m7" class="ltx_Math" alttext="\mathcal{C}_{P}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>P</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{P}</annotation></semantics></math>. This shows that there exists some positive integer <math id="S6.SS2.p29.m8" class="ltx_Math" alttext="N&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">N&gt;0</annotation></semantics></math> such that the tuple <math id="S6.SS2.p29.m9" class="ltx_Math" alttext="f^{\prime}=(N\cdot\pi_{Z}(\psi_{L}),\mathcal{G}_{P})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>π</mi><mi>Z</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>P</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{\prime}=(N\cdot\pi_{Z}(\psi_{L}),\mathcal{G}_{P})</annotation></semantics></math> is a well-defined weighted parabolic reduction of <math id="S6.SS2.p29.m10" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>. The version of (<a href="#S6.E19" title="Equation 19 ‣ Proof. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) for this parabolic reduction yields</span></p>
<table id="S6.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex113.m1" class="ltx_Math" alttext="\nu_{d-1}(f^{\prime})=\frac{1}{\sqrt{A_{d}}(d-1)!}\cdot\sqrt{\pi_{Z}(\psi_{L})\cdot_{\chi}\pi_{Z}(\psi_{L})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>L</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nu_{d-1}(f^{\prime})=\frac{1}{\sqrt{A_{d}}(d-1)!}\cdot\sqrt{\pi_{Z}(\psi_{L})\cdot_{\chi}\pi_{Z}(\psi_{L})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.SS2.p30" class="ltx_para">
<p id="S6.SS2.p30.1" class="ltx_p"><span id="S6.SS2.p30.1.1" class="ltx_text">Equation (<a href="#S6.E20" title="Equation 20 ‣ Proof. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>) implies
<math id="S6.SS2.p30.m1" class="ltx_Math" alttext="\pi_{Z}(\psi_{L})=\pi_{Z}(\psi)+\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow></msub><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{Z}(\psi_{L})=\pi_{Z}(\psi)+\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}</annotation></semantics></math>, therefore:</span></p>
<table id="S6.EGx11" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S6.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex114.m1" class="ltx_Math" alttext="\displaystyle\pi_{Z}(\psi_{L})\cdot_{\chi}\pi_{Z}(\psi_{L})=\pi_{Z}(\psi)\cdot_{\chi}\pi_{Z}(\psi)+2\pi_{Z}(\psi)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)+" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>L</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow></munder><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{Z}(\psi_{L})\cdot_{\chi}\pi_{Z}(\psi_{L})=\pi_{Z}(\psi)\cdot_{\chi}\pi_{Z}(\psi)+2\pi_{Z}(\psi)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(21)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E21.m1" class="ltx_Math" alttext="\displaystyle\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow></munder><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow><mo rspace="0.055em">)</mo></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow></munder><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p30.2" class="ltx_p"><span id="S6.SS2.p30.2.1" class="ltx_text">Note that <math id="S6.SS2.p30.m2" class="ltx_math_unparsed" alttext="\cdot_{\chi}" display="inline" intent=":literal"><semantics><mrow><mo>⋅</mo><msub><mrow></mrow><mi>χ</mi></msub></mrow><annotation encoding="application/x-tex">\cdot_{\chi}</annotation></semantics></math> is a Weyl group invariant positive definite inner product on <math id="S6.SS2.p30.m3" class="ltx_Math" alttext="X_{*}(T)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X_{*}(T)_{\mathbb{R}}</annotation></semantics></math>. In particular we must have <math id="S6.SS2.p30.m4" class="ltx_Math" alttext="\omega_{l}^{\vee}\cdot_{\chi}\omega_{n}^{\vee}\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ω</mi><mi>l</mi><mo>∨</mo></msubsup><msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>χ</mi></msub><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\omega_{l}^{\vee}\cdot_{\chi}\omega_{n}^{\vee}\geq 0</annotation></semantics></math> for all <math id="S6.SS2.p30.m5" class="ltx_Math" alttext="l,n" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">l,n</annotation></semantics></math>. Since <math id="S6.SS2.p30.m6" class="ltx_Math" alttext="a_{n}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{n}&gt;0</annotation></semantics></math> for all <math id="S6.SS2.p30.m7" class="ltx_Math" alttext="n\in J_{P}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><msub><mi>J</mi><mi>P</mi></msub></mrow><annotation encoding="application/x-tex">n\in J_{P}</annotation></semantics></math>, it follows that</span></p>
<table id="S6.EGx12" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S6.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex115.m1" class="ltx_Math" alttext="\displaystyle\pi_{Z}(\psi)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)=\left(\sum_{l\in J_{P_{\lambda}}}a_{l}\omega_{l}^{\vee}\right)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)\geq 0" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow></munder><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></munder><mrow><msub><mi>a</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>l</mi><mo>∨</mo></msubsup></mrow></mrow><mo rspace="0.055em">)</mo></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow></munder><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{Z}(\psi)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)=\left(\sum_{l\in J_{P_{\lambda}}}a_{l}\omega_{l}^{\vee}\right)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)\geq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p30.3" class="ltx_p"><span id="S6.SS2.p30.3.1" class="ltx_text">On the other hand, since <math id="S6.SS2.p30.m8" class="ltx_math_unparsed" alttext="\cdot_{\chi}" display="inline" intent=":literal"><semantics><mrow><mo>⋅</mo><msub><mrow></mrow><mi>χ</mi></msub></mrow><annotation encoding="application/x-tex">\cdot_{\chi}</annotation></semantics></math> is positive definite we have</span></p>
<table id="S6.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex116.m1" class="ltx_Math" alttext="\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow></munder><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow><mo rspace="0.055em">)</mo></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi>J</mi><mi>P</mi></msub><mo>∖</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></mrow></munder><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>n</mi><mo>∨</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)\cdot_{\chi}\left(\sum_{n\in J_{P}\setminus J_{P_{\lambda}}}a_{n}\omega_{n}^{\vee}\right)&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p30.4" class="ltx_p"><span id="S6.SS2.p30.4.1" class="ltx_text">Plugging the last two inequalities in (<a href="#S6.E21" title="Equation 21 ‣ Proof. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) we get <math id="S6.SS2.p30.m9" class="ltx_Math" alttext="\pi_{Z}(\psi_{L})\cdot_{\chi}\pi_{Z}(\psi_{L})&gt;\pi_{Z}(\psi)\cdot_{\chi}\pi_{Z}(\psi)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>L</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mrow><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⋅</mo><mi>χ</mi></msub><mrow><msub><mi>π</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{Z}(\psi_{L})\cdot_{\chi}\pi_{Z}(\psi_{L})&gt;\pi_{Z}(\psi)\cdot_{\chi}\pi_{Z}(\psi)</annotation></semantics></math>. Therefore <math id="S6.SS2.p30.m10" class="ltx_Math" alttext="\nu_{d-1}(f^{\prime})&gt;\nu_{d-1}(\lambda)=\nu_{d-1}(f)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(f^{\prime})&gt;\nu_{d-1}(\lambda)=\nu_{d-1}(f)</annotation></semantics></math>.
Hence, the leading coefficient of <math id="S6.SS2.p30.m11" class="ltx_Math" alttext="\nu(f^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(f^{\prime})</annotation></semantics></math> is strictly bigger than the leading coefficient of <math id="S6.SS2.p30.m12" class="ltx_Math" alttext="\nu(f)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(f)</annotation></semantics></math>, thus contradicting the maximality of <math id="S6.SS2.p30.m13" class="ltx_Math" alttext="\nu(f)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(f)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S6.Thmthm12" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm12.2" class="ltx_text ltx_font_bold">Remark 6.12</span></span><span id="S6.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm12.p1" class="ltx_para">
<p id="S6.Thmthm12.p1.1" class="ltx_p"><span id="S6.Thmthm12.p1.1.1" class="ltx_text ltx_font_italic">When the representation <math id="S6.Thmthm12.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central, Proposition <a href="#S6.Thmthm11" title="Proposition 6.11. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.11</span></a> shows that the leading term HN <math id="S6.Thmthm12.p1.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification of <math id="S6.Thmthm12.p1.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> is a refinement of the slope stratification for the stack of <math id="S6.Thmthm12.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles defined in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">GN18</a>, <a href="#bib.bibx21" title="" class="ltx_ref">GN16</a>]</cite> in the split case.</span></p>
</div>
</div>
</section>
</section>
<section id="S7" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">7. </span>Gieseker-Harder-Narasimhan filtrations for <math id="S7.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves</h2>

<div id="S7.p1" class="ltx_para">
<p id="S7.p1.1" class="ltx_p">In this section we describe a procedure that iterates the leading term HN filtration in order to construct a finer filtration for <math id="S7.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves, called the Gieseker-Harder-Narasimhan filtration (GHN filtration). We prove that this filtration induces a stratification of <math id="S7.p1.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> by locally closed substacks. To understand the notation and constructions in this section, it might help the reader to look beforehand at the examples at the end of Subsection <a href="#S7.SS3" title="7.3. The GHN filtration for 
          
            ρ
          
        -sheaves ‣ 7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a> and in Subsection <a href="#S7.SS4" title="7.4. Example of Gieseker-Harder-Narasimhan filtration ‣ 7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.4</span></a>.</p>
</div>
<section id="S7.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.1. </span>Lexicographic filtrations</h3>

<div id="S7.SS1.p1" class="ltx_para">
<p id="S7.SS1.p1.1" class="ltx_p">Fix a positive integer <math id="S7.SS1.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. We equip the group <math id="S7.SS1.p1.m2" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math> with the lexicographic order where two tuples <math id="S7.SS1.p1.m3" class="ltx_Math" alttext="\vec{m}=(m_{i})_{i=1}^{q},\vec{n}=(n_{i})_{i=1}^{q}\in\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup></mrow><mo>,</mo><mrow><mover accent="true"><mi>n</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\vec{m}=(m_{i})_{i=1}^{q},\vec{n}=(n_{i})_{i=1}^{q}\in\mathbb{Z}^{q}</annotation></semantics></math> satisfy <math id="S7.SS1.p1.m4" class="ltx_Math" alttext="\vec{m}&gt;\vec{n}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>&gt;</mo><mover accent="true"><mi>n</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><annotation encoding="application/x-tex">\vec{m}&gt;\vec{n}</annotation></semantics></math> if and only if there exists an index <math id="S7.SS1.p1.m5" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> such that <math id="S7.SS1.p1.m6" class="ltx_Math" alttext="m_{j}&gt;n_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>j</mi></msub><mo>&gt;</mo><msub><mi>n</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">m_{j}&gt;n_{j}</annotation></semantics></math> and <math id="S7.SS1.p1.m7" class="ltx_Math" alttext="m_{i}=n_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>=</mo><msub><mi>n</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">m_{i}=n_{i}</annotation></semantics></math> for all <math id="S7.SS1.p1.m8" class="ltx_Math" alttext="i&lt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&lt;j</annotation></semantics></math>. The lexicographic order endows <math id="S7.SS1.p1.m9" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math> with the structure of a totally well-ordered abelian group. For <math id="S7.SS1.p1.m10" class="ltx_Math" alttext="\vec{m}=(m_{1},m_{2},\ldots,m_{q-1},m_{q})\in\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>m</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>m</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">\vec{m}=(m_{1},m_{2},\ldots,m_{q-1},m_{q})\in\mathbb{Z}^{q}</annotation></semantics></math>, we define the successor by <math id="S7.SS1.p1.m11" class="ltx_Math" alttext="\vec{m}+1:=(m_{1},m_{2},\ldots,m_{q-1},m_{q}+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>+</mo><mn>1</mn></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>m</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msub><mi>m</mi><mi>q</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{m}+1:=(m_{1},m_{2},\ldots,m_{q-1},m_{q}+1)</annotation></semantics></math>.</p>
</div>
<div id="S7.SS1.p2" class="ltx_para">
<p id="S7.SS1.p2.1" class="ltx_p">Let <math id="S7.SS1.p2.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be a field extension and let <math id="S7.SS1.p2.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> be a torsion-free sheaf on <math id="S7.SS1.p2.m3" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm1.2" class="ltx_text ltx_font_bold">Definition 7.1</span></span><span id="S7.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm1.p1" class="ltx_para">
<p id="S7.Thmthm1.p1.1" class="ltx_p"><span id="S7.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">A lexicographic <math id="S7.Thmthm1.p1.m1" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration of <math id="S7.Thmthm1.p1.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is a sequence of subsheaves <math id="S7.Thmthm1.p1.m3" class="ltx_Math" alttext="f=(\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">f=(\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> indexed by <math id="S7.Thmthm1.p1.m4" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math> such that the following are satisfied.</span></p>
<ol id="S7.I1" class="ltx_enumerate">
<li id="S7.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I1.i1.p1" class="ltx_para">
<p id="S7.I1.i1.p1.1" class="ltx_p"><math id="S7.I1.i1.p1.m1" class="ltx_Math" alttext="\mathcal{F}_{\vec{m}}\subset\mathcal{F}_{\vec{n}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>n</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\vec{m}}\subset\mathcal{F}_{\vec{n}}</annotation></semantics></math><span id="S7.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> whenever </span><math id="S7.I1.i1.p1.m2" class="ltx_Math" alttext="\vec{m}&gt;\vec{n}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>&gt;</mo><mover accent="true"><mi>n</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><annotation encoding="application/x-tex">\vec{m}&gt;\vec{n}</annotation></semantics></math><span id="S7.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S7.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I1.i2.p1" class="ltx_para">
<p id="S7.I1.i2.p1.1" class="ltx_p"><span id="S7.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">There exists an </span><math id="S7.I1.i2.p1.m1" class="ltx_Math" alttext="M_{max}\in\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">M_{max}\in\mathbb{Z}^{q}</annotation></semantics></math><span id="S7.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> such that </span><math id="S7.I1.i2.p1.m2" class="ltx_Math" alttext="\mathcal{F}_{\vec{m}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\vec{m}}=0</annotation></semantics></math><span id="S7.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> for all </span><math id="S7.I1.i2.p1.m3" class="ltx_Math" alttext="\vec{m}&gt;M_{max}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>&gt;</mo><msub><mi>M</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\vec{m}&gt;M_{max}</annotation></semantics></math><span id="S7.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">, and there exists an </span><math id="S7.I1.i2.p1.m4" class="ltx_Math" alttext="M_{min}\in\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">M_{min}\in\mathbb{Z}^{q}</annotation></semantics></math><span id="S7.I1.i2.p1.1.5" class="ltx_text ltx_font_italic"> such that </span><math id="S7.I1.i2.p1.m5" class="ltx_Math" alttext="\mathcal{F}_{\vec{m}}=\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\vec{m}}=\mathcal{F}</annotation></semantics></math><span id="S7.I1.i2.p1.1.6" class="ltx_text ltx_font_italic"> for all </span><math id="S7.I1.i2.p1.m6" class="ltx_Math" alttext="\vec{m}&lt;M_{min}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>&lt;</mo><msub><mi>M</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\vec{m}&lt;M_{min}</annotation></semantics></math><span id="S7.I1.i2.p1.1.7" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S7.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S7.I1.i3.p1" class="ltx_para">
<p id="S7.I1.i3.p1.1" class="ltx_p"><span id="S7.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">For all </span><math id="S7.I1.i3.p1.m1" class="ltx_Math" alttext="\vec{m}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{m}</annotation></semantics></math><span id="S7.I1.i3.p1.1.2" class="ltx_text ltx_font_italic">, we have that </span><math id="S7.I1.i3.p1.m2" class="ltx_Math" alttext="\mathcal{F}_{\vec{m}}/\mathcal{F}_{\vec{m}+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\vec{m}}/\mathcal{F}_{\vec{m}+1}</annotation></semantics></math><span id="S7.I1.i3.p1.1.3" class="ltx_text ltx_font_italic"> is torsion-free.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S7.SS1.p3" class="ltx_para">
<p id="S7.SS1.p3.1" class="ltx_p">The associated graded of a lexicographic <math id="S7.SS1.p3.m1" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.SS1.p3.m2" class="ltx_Math" alttext="f=(\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">f=(\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> is defined as <math id="S7.SS1.p3.m3" class="ltx_Math" alttext="\text{gr}(f)\vcentcolon=\bigoplus_{\vec{m}\in\mathbb{Z}^{q}}\mathcal{F}_{\vec{m}}/\mathcal{F}_{\vec{m}+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>gr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><mrow><msub><mo>⨁</mo><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\text{gr}(f)\vcentcolon=\bigoplus_{\vec{m}\in\mathbb{Z}^{q}}\mathcal{F}_{\vec{m}}/\mathcal{F}_{\vec{m}+1}</annotation></semantics></math>. Conditions (2) and (3) in Definition <a href="#S7.Thmthm1" title="Definition 7.1. ‣ 7.1. Lexicographic filtrations ‣ 7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> ensure that <math id="S7.SS1.p3.m4" class="ltx_Math" alttext="\text{gr}(f)" display="inline" intent=":literal"><semantics><mrow><mtext>gr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}(f)</annotation></semantics></math> is a torsion-free sheaf with the same rank as <math id="S7.SS1.p3.m5" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>. Note that <math id="S7.SS1.p3.m6" class="ltx_Math" alttext="\text{gr}(f)" display="inline" intent=":literal"><semantics><mrow><mtext>gr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}(f)</annotation></semantics></math> is naturally equipped with a <math id="S7.SS1.p3.m7" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-grading. We say that <math id="S7.SS1.p3.m8" class="ltx_Math" alttext="\vec{m}\in\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">\vec{m}\in\mathbb{Z}^{q}</annotation></semantics></math> is a jumping point of <math id="S7.SS1.p3.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> if the quotient <math id="S7.SS1.p3.m10" class="ltx_Math" alttext="\mathcal{F}_{\vec{m}}/\mathcal{F}_{\vec{m}+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\vec{m}}/\mathcal{F}_{\vec{m}+1}</annotation></semantics></math> is not the zero sheaf. There are finitely many jumping points.</p>
</div>
<div id="S7.Thmthm2" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm2.2" class="ltx_text ltx_font_bold">Definition 7.2</span></span><span id="S7.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm2.p1" class="ltx_para">
<p id="S7.Thmthm2.p1.1" class="ltx_p"><span id="S7.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmthm2.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> be a lexicographic <math id="S7.Thmthm2.p1.m2" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration. Let <math id="S7.Thmthm2.p1.m3" class="ltx_Math" alttext="\vec{p}=(p_{i})_{i=1}^{q}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup></mrow><annotation encoding="application/x-tex">\vec{p}=(p_{i})_{i=1}^{q}</annotation></semantics></math> be a tuple of positive rational numbers. For all coordinates <math id="S7.Thmthm2.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we can scale the weights of <math id="S7.Thmthm2.p1.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> at the <math id="S7.Thmthm2.p1.m6" class="ltx_Math" alttext="i^{th}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">i^{th}</annotation></semantics></math> coordinate by the rational number <math id="S7.Thmthm2.p1.m7" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math>. Doing this for all <math id="S7.Thmthm2.p1.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> yields a lexicographic multi-weighted filtration denoted by <math id="S7.Thmthm2.p1.m9" class="ltx_Math" alttext="\vec{p}\cdot f" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">\vec{p}\cdot f</annotation></semantics></math> that could possibly have rational weights. If <math id="S7.Thmthm2.p1.m10" class="ltx_Math" alttext="\vec{p}\cdot f" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">\vec{p}\cdot f</annotation></semantics></math> has integer weights, then we say that the lexicographic <math id="S7.Thmthm2.p1.m11" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.Thmthm2.p1.m12" class="ltx_Math" alttext="\vec{p}\cdot f" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">\vec{p}\cdot f</annotation></semantics></math> is obtained by scaling the weights of <math id="S7.Thmthm2.p1.m13" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> by <math id="S7.Thmthm2.p1.m14" class="ltx_Math" alttext="\vec{p}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>p</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{p}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS1.p4" class="ltx_para">
<p id="S7.SS1.p4.1" class="ltx_p">The scheme <math id="S7.SS1.p4.m1" class="ltx_Math" alttext="\mathbb{A}_{k}^{q}=\Spec(k[t_{1},t_{2},\ldots,t_{q}])" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mi>k</mi><mi>q</mi></msubsup><mo>=</mo><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>q</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{A}_{k}^{q}=\Spec(k[t_{1},t_{2},\ldots,t_{q}])</annotation></semantics></math> admits an action of <math id="S7.SS1.p4.m2" class="ltx_Math" alttext="\mathbb{G}_{m}^{q}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔾</mi><mi>m</mi><mi>q</mi></msubsup><annotation encoding="application/x-tex">\mathbb{G}_{m}^{q}</annotation></semantics></math> over <math id="S7.SS1.p4.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, where the <math id="S7.SS1.p4.m4" class="ltx_Math" alttext="i^{th}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">i^{th}</annotation></semantics></math> coordinate of <math id="S7.SS1.p4.m5" class="ltx_Math" alttext="\mathbb{G}_{m}^{q}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔾</mi><mi>m</mi><mi>q</mi></msubsup><annotation encoding="application/x-tex">\mathbb{G}_{m}^{q}</annotation></semantics></math> acts with weight <math id="S7.SS1.p4.m6" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math> on <math id="S7.SS1.p4.m7" class="ltx_Math" alttext="t_{i}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>i</mi></msub><annotation encoding="application/x-tex">t_{i}</annotation></semantics></math> and weight <math id="S7.SS1.p4.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> on the other coordinates. Set <math id="S7.SS1.p4.m9" class="ltx_Math" alttext="\Theta^{q}_{k}\vcentcolon=\left[\,\mathbb{A}^{q}_{k}/\,\mathbb{G}_{m}^{q}\right]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>k</mi><mi>q</mi></msubsup><mo>:=</mo><mrow><mo rspace="0.130em">[</mo><mrow><msubsup><mi>𝔸</mi><mi>k</mi><mi>q</mi></msubsup><mo rspace="0.352em">/</mo><msubsup><mi>𝔾</mi><mi>m</mi><mi>q</mi></msubsup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta^{q}_{k}\vcentcolon=\left[\,\mathbb{A}^{q}_{k}/\,\mathbb{G}_{m}^{q}\right]</annotation></semantics></math> and denote by <math id="S7.SS1.p4.m10" class="ltx_Math" alttext="\Theta^{q}_{K}\vcentcolon=\left[\,\mathbb{A}^{q}_{K}/\,(\mathbb{G}_{m}^{q})_{K}\right]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><mo>:=</mo><mrow><mo rspace="0.130em">[</mo><mrow><msubsup><mi>𝔸</mi><mi>K</mi><mi>q</mi></msubsup><mo rspace="0.352em">/</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔾</mi><mi>m</mi><mi>q</mi></msubsup><mo stretchy="false">)</mo></mrow><mi>K</mi></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\vcentcolon=\left[\,\mathbb{A}^{q}_{K}/\,(\mathbb{G}_{m}^{q})_{K}\right]</annotation></semantics></math> the base change. A multi-graded version of the Rees construction in Proposition <a href="#S3.Thmthm8" title="Proposition 3.8. ‣ 3.2. Filtrations of 
          
            ρ
          
        -sheaves ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a> can be applied to associate to any lexicographic <math id="S7.SS1.p4.m11" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration a morphism of stacks <math id="S7.SS1.p4.m12" class="ltx_Math" alttext="\Theta^{q}_{K}\rightarrow\Coh^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><mo stretchy="false">→</mo><mrow><msup><mi mathsize="0.800em">Coh</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\rightarrow\Coh^{tf}(X)</annotation></semantics></math> in the following way.</p>
</div>
<div id="S7.Thmthm3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm3.2" class="ltx_text ltx_font_bold">Definition 7.3</span></span><span id="S7.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm3.p1" class="ltx_para">
<p id="S7.Thmthm3.p1.1" class="ltx_p"><span id="S7.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">Given a lexicographic <math id="S7.Thmthm3.p1.m1" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.Thmthm3.p1.m2" class="ltx_Math" alttext="f=(\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">f=(\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> of <math id="S7.Thmthm3.p1.m3" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>, we set multi-graded Rees construction <math id="S7.Thmthm3.p1.m4" class="ltx_Math" alttext="\widetilde{\mathcal{F}}_{f}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}_{f}</annotation></semantics></math> to be the <math id="S7.Thmthm3.p1.m5" class="ltx_Math" alttext="\mathbb{G}_{m}^{q}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔾</mi><mi>m</mi><mi>q</mi></msubsup><annotation encoding="application/x-tex">\mathbb{G}_{m}^{q}</annotation></semantics></math>-equivariant <math id="S7.Thmthm3.p1.m6" class="ltx_Math" alttext="\mathbb{A}^{q}_{K}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mi>K</mi><mi>q</mi></msubsup><annotation encoding="application/x-tex">\mathbb{A}^{q}_{K}</annotation></semantics></math>-flat sheaf on <math id="S7.Thmthm3.p1.m7" class="ltx_Math" alttext="\mathbb{A}^{q}_{K}\times X" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mi>K</mi><mi>q</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbb{A}^{q}_{K}\times X</annotation></semantics></math> defined by</span></p>
<table id="S7.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex117.m1" class="ltx_Math" alttext="\widetilde{\mathcal{F}}_{f}=\bigoplus_{\vec{m}\in\mathbb{Z}^{q}}\left(\mathcal{F}_{\vec{m}}\cdot\prod_{i=1}^{q}t_{i}^{m_{i}}\right)" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">⨁</mo><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></munder><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo lspace="0.222em" rspace="0.055em">⋅</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></munderover><msubsup><mi>t</mi><mi>i</mi><msub><mi>m</mi><mi>i</mi></msub></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}_{f}=\bigoplus_{\vec{m}\in\mathbb{Z}^{q}}\left(\mathcal{F}_{\vec{m}}\cdot\prod_{i=1}^{q}t_{i}^{m_{i}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S7.SS1.p5" class="ltx_para">
<p id="S7.SS1.p5.1" class="ltx_p">Note that this is a coherent sheaf by condition (2) in Definition <a href="#S7.Thmthm1" title="Definition 7.1. ‣ 7.1. Lexicographic filtrations ‣ 7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>. If <math id="S7.SS1.p5.m1" class="ltx_Math" alttext="\vec{1}_{K}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>K</mi></msub><annotation encoding="application/x-tex">\vec{1}_{K}</annotation></semantics></math> denotes the point <math id="S7.SS1.p5.m2" class="ltx_Math" alttext="(1,1,\ldots,1)\in\mathbb{A}^{q}_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>𝔸</mi><mi>K</mi><mi>q</mi></msubsup></mrow><annotation encoding="application/x-tex">(1,1,\ldots,1)\in\mathbb{A}^{q}_{K}</annotation></semantics></math>, the fiber at <math id="S7.SS1.p5.m3" class="ltx_Math" alttext="\vec{1}_{K}\times X" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>K</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\vec{1}_{K}\times X</annotation></semantics></math> is isomorphic to the original sheaf <math id="S7.SS1.p5.m4" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> and the fiber at <math id="S7.SS1.p5.m5" class="ltx_Math" alttext="0_{K}\times X" display="inline" intent=":literal"><semantics><mrow><msub><mn>0</mn><mi>K</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">0_{K}\times X</annotation></semantics></math> is the <math id="S7.SS1.p5.m6" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-graded sheaf <math id="S7.SS1.p5.m7" class="ltx_Math" alttext="\text{gr}(f)" display="inline" intent=":literal"><semantics><mrow><mtext>gr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}(f)</annotation></semantics></math>. The locus of points in <math id="S7.SS1.p5.m8" class="ltx_Math" alttext="\mathbb{A}^{q}_{K}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mi>K</mi><mi>q</mi></msubsup><annotation encoding="application/x-tex">\mathbb{A}^{q}_{K}</annotation></semantics></math> such that the fiber of <math id="S7.SS1.p5.m9" class="ltx_Math" alttext="\widetilde{\mathcal{F}}_{f}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}_{f}</annotation></semantics></math> is torsion-free is open by the slicing criterion for flatness <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Sta23</a>, <a href="https://stacks.math.columbia.edu/tag/046Y" title="" class="ltx_ref ltx_href">Tag 046Y</a>]</cite>, and the fiber at the origin <math id="S7.SS1.p5.m10" class="ltx_Math" alttext="0_{K}" display="inline" intent=":literal"><semantics><msub><mn>0</mn><mi>K</mi></msub><annotation encoding="application/x-tex">0_{K}</annotation></semantics></math> is torsion-free by condition (3) in Definition <a href="#S7.Thmthm1" title="Definition 7.1. ‣ 7.1. Lexicographic filtrations ‣ 7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>. By <math id="S7.SS1.p5.m11" class="ltx_Math" alttext="\mathbb{G}^{q}_{m}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔾</mi><mi>m</mi><mi>q</mi></msubsup><annotation encoding="application/x-tex">\mathbb{G}^{q}_{m}</annotation></semantics></math>-equivariance, it follows that <math id="S7.SS1.p5.m12" class="ltx_Math" alttext="\widetilde{\mathcal{F}}_{f}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}_{f}</annotation></semantics></math> is a family of torsion-free sheaves. So indeed <math id="S7.SS1.p5.m13" class="ltx_Math" alttext="\widetilde{\mathcal{F}}_{f}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}_{f}</annotation></semantics></math> represents a morphism <math id="S7.SS1.p5.m14" class="ltx_Math" alttext="\Theta^{q}_{K}\rightarrow\Coh^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><mo stretchy="false">→</mo><mrow><msup><mi mathsize="0.800em">Coh</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\rightarrow\Coh^{tf}(X)</annotation></semantics></math>.</p>
</div>
<div id="S7.SS1.p6" class="ltx_para">
<p id="S7.SS1.p6.1" class="ltx_p">More generally, a lexicographic <math id="S7.SS1.p6.m1" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.SS1.p6.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> of a tuple <math id="S7.SS1.p6.m3" class="ltx_Math" alttext="\mathcal{F}^{\bullet}=(\mathcal{F}_{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}=(\mathcal{F}_{i})_{i=1}^{b}</annotation></semantics></math> of torsion-free sheaves on <math id="S7.SS1.p6.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> is defined to be a tuple <math id="S7.SS1.p6.m5" class="ltx_Math" alttext="f=(f_{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">f=(f_{i})_{i=1}^{b}</annotation></semantics></math> where <math id="S7.SS1.p6.m6" class="ltx_Math" alttext="f_{i}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>i</mi></msub><annotation encoding="application/x-tex">f_{i}</annotation></semantics></math> is a lexicographic <math id="S7.SS1.p6.m7" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration of <math id="S7.SS1.p6.m8" class="ltx_Math" alttext="\mathcal{F}^{i}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\mathcal{F}^{i}</annotation></semantics></math>. Here it also makes sense to scale the weights by a tuple <math id="S7.SS1.p6.m9" class="ltx_Math" alttext="\vec{p}=(p_{j})_{j=1}^{q}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup></mrow><annotation encoding="application/x-tex">\vec{p}=(p_{j})_{j=1}^{q}</annotation></semantics></math> of rational numbers; we just scale the weights of each <math id="S7.SS1.p6.m10" class="ltx_Math" alttext="f_{i}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>i</mi></msub><annotation encoding="application/x-tex">f_{i}</annotation></semantics></math> by <math id="S7.SS1.p6.m11" class="ltx_Math" alttext="\vec{p}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>p</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{p}</annotation></semantics></math>. If <math id="S7.SS1.p6.m12" class="ltx_Math" alttext="\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}</annotation></semantics></math> is a point in <math id="S7.SS1.p6.m13" class="ltx_Math" alttext="\prod_{i=1}^{b}\Coh^{tf}_{r_{i}}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mi mathsize="0.800em">Coh</mi><msub><mi>r</mi><mi>i</mi></msub><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{b}\Coh^{tf}_{r_{i}}(X)</annotation></semantics></math>, then the multi-graded Rees construction applied to each component yields a morphism <math id="S7.SS1.p6.m14" class="ltx_Math" alttext="\Theta^{q}_{K}\rightarrow\prod_{i=1}^{b}\Coh^{tf}_{r_{i}}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><mo rspace="0.111em" stretchy="false">→</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mi mathsize="0.800em">Coh</mi><msub><mi>r</mi><mi>i</mi></msub><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\rightarrow\prod_{i=1}^{b}\Coh^{tf}_{r_{i}}(X)</annotation></semantics></math> represented by a tuple <math id="S7.SS1.p6.m15" class="ltx_Math" alttext="\widetilde{\mathcal{F}^{\bullet}}_{f}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}^{\bullet}}_{f}</annotation></semantics></math> such that the fiber at <math id="S7.SS1.p6.m16" class="ltx_Math" alttext="\vec{1}_{K}\times X" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>K</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\vec{1}_{K}\times X</annotation></semantics></math> recovers <math id="S7.SS1.p6.m17" class="ltx_Math" alttext="\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}</annotation></semantics></math>.</p>
</div>
<div id="S7.SS1.p7" class="ltx_para">
<p id="S7.SS1.p7.1" class="ltx_p">Fix a tuple <math id="S7.SS1.p7.m1" class="ltx_Math" alttext="V^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">V^{\bullet}</annotation></semantics></math> of <math id="S7.SS1.p7.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-vector spaces and let <math id="S7.SS1.p7.m3" class="ltx_Math" alttext="\rho:G\rightarrow\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>G</mi><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:G\rightarrow\GL(V^{\bullet})</annotation></semantics></math> be faithful representation, as in Section <a href="#S6" title="6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Let <math id="S7.SS1.p7.m4" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be a <math id="S7.SS1.p7.m5" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S7.SS1.p7.m6" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> and suppose that we are given a lexicographic <math id="S7.SS1.p7.m7" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.SS1.p7.m8" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> of <math id="S7.SS1.p7.m9" class="ltx_Math" alttext="\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}</annotation></semantics></math>. Applying the multi-graded Rees construction, we obtain a homomorphism <math id="S7.SS1.p7.m10" class="ltx_Math" alttext="\Theta^{q}_{K}\rightarrow\prod_{i=1}^{b}\Coh^{tf}_{r_{i}}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><mo rspace="0.111em" stretchy="false">→</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><msubsup><mi mathsize="0.800em">Coh</mi><msub><mi>r</mi><mi>i</mi></msub><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\rightarrow\prod_{i=1}^{b}\Coh^{tf}_{r_{i}}(X)</annotation></semantics></math> represented by a tuple <math id="S7.SS1.p7.m11" class="ltx_Math" alttext="\widetilde{\mathcal{F}^{\bullet}}_{f}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}^{\bullet}}_{f}</annotation></semantics></math>. If <math id="S7.SS1.p7.m12" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> is a big open subset of <math id="S7.SS1.p7.m13" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> such that <math id="S7.SS1.p7.m14" class="ltx_Math" alttext="\text{gr}(f)" display="inline" intent=":literal"><semantics><mrow><mtext>gr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}(f)</annotation></semantics></math> is locally-free, the restriction <math id="S7.SS1.p7.m15" class="ltx_Math" alttext="\widetilde{\mathcal{F}^{\bullet}}_{f}|_{\Theta^{q}_{K}\times U}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}^{\bullet}}_{f}|_{\Theta^{q}_{K}\times U}</annotation></semantics></math> is a tuple of locally-free sheaves, which we can view as a <math id="S7.SS1.p7.m16" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math>-bundle on <math id="S7.SS1.p7.m17" class="ltx_Math" alttext="\Theta^{q}_{K}\times_{K}U" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>U</mi></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\times_{K}U</annotation></semantics></math>. The section <math id="S7.SS1.p7.m18" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> induces a <math id="S7.SS1.p7.m19" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reduction of structure group of the restriction <math id="S7.SS1.p7.m20" class="ltx_Math" alttext="\widetilde{\mathcal{F}^{\bullet}}_{f}|_{\vec{1}_{K}\times_{K}U}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="1.140em" stretchy="false">→</mo></mover><mi>K</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>U</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}^{\bullet}}_{f}|_{\vec{1}_{K}\times_{K}U}</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm4" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm4.2" class="ltx_text ltx_font_bold">Definition 7.4</span></span><span id="S7.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm4.p1" class="ltx_para">
<p id="S7.Thmthm4.p1.1" class="ltx_p"><span id="S7.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">We say that <math id="S7.Thmthm4.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is a lexicographic <math id="S7.Thmthm4.p1.m2" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration of <math id="S7.Thmthm4.p1.m3" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> if the <math id="S7.Thmthm4.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reduction of <math id="S7.Thmthm4.p1.m5" class="ltx_Math" alttext="\widetilde{\mathcal{F}^{\bullet}}_{f}|_{\vec{1}_{K}\times_{K}U}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="1.140em" stretchy="false">→</mo></mover><mi>K</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>U</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}^{\bullet}}_{f}|_{\vec{1}_{K}\times_{K}U}</annotation></semantics></math> induced by <math id="S7.Thmthm4.p1.m6" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> extends to a <math id="S7.Thmthm4.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reduction defined over <math id="S7.Thmthm4.p1.m8" class="ltx_Math" alttext="\Theta^{q}_{K}\times U" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\times U</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS1.p8" class="ltx_para">
<p id="S7.SS1.p8.1" class="ltx_p">Since the <math id="S7.SS1.p8.m1" class="ltx_Math" alttext="(\mathbb{G}_{m}^{q})_{K}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔾</mi><mi>m</mi><mi>q</mi></msubsup><mo stretchy="false">)</mo></mrow><mi>K</mi></msub><annotation encoding="application/x-tex">(\mathbb{G}_{m}^{q})_{K}</annotation></semantics></math>-orbit of <math id="S7.SS1.p8.m2" class="ltx_Math" alttext="\vec{1}_{K}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>K</mi></msub><annotation encoding="application/x-tex">\vec{1}_{K}</annotation></semantics></math> is scheme-theoretically dense in <math id="S7.SS1.p8.m3" class="ltx_Math" alttext="\mathbb{A}^{q}_{K}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mi>K</mi><mi>q</mi></msubsup><annotation encoding="application/x-tex">\mathbb{A}^{q}_{K}</annotation></semantics></math>, if such extension exists then it must be unique. So, again, being a filtration of <math id="S7.SS1.p8.m4" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> is a property, not a structure.</p>
</div>
</section>
<section id="S7.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.2. </span>Multi-weighted parabolic reductions</h3>

<div id="S7.SS2.p1" class="ltx_para">
<p id="S7.SS2.p1.1" class="ltx_p">For this subsection we fix a field extension <math id="S7.SS2.p1.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math>.</p>
</div>
<div id="S7.SS2.p2" class="ltx_para">
<p id="S7.SS2.p2.1" class="ltx_p">Let <math id="S7.SS2.p2.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> be a reductive group over <math id="S7.SS2.p2.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and let <math id="S7.SS2.p2.m3" class="ltx_Math" alttext="\vec{\lambda}=(\lambda_{i})_{i=1}^{q}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup></mrow><annotation encoding="application/x-tex">\vec{\lambda}=(\lambda_{i})_{i=1}^{q}</annotation></semantics></math> be a tuple of <math id="S7.SS2.p2.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> cocharacters of <math id="S7.SS2.p2.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. The first cocharacter <math id="S7.SS2.p2.m6" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> defines a parabolic subgroup <math id="S7.SS2.p2.m7" class="ltx_Math" alttext="P_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">P_{\lambda_{1}}</annotation></semantics></math> with corresponding Levi subgroup <math id="S7.SS2.p2.m8" class="ltx_Math" alttext="L_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">L_{\lambda_{1}}</annotation></semantics></math>. We denote by <math id="S7.SS2.p2.m9" class="ltx_Math" alttext="q_{\lambda_{1}}:P_{\lambda_{1}}\rightarrow L_{\lambda_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo stretchy="false">→</mo><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">q_{\lambda_{1}}:P_{\lambda_{1}}\rightarrow L_{\lambda_{1}}</annotation></semantics></math> the quotient morphism. Suppose that the cocharacter <math id="S7.SS2.p2.m10" class="ltx_Math" alttext="\lambda_{2}:\mathbb{G}_{m}\rightarrow H" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">→</mo><mi>H</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda_{2}:\mathbb{G}_{m}\rightarrow H</annotation></semantics></math> factors through the subgroup <math id="S7.SS2.p2.m11" class="ltx_Math" alttext="L_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">L_{\lambda_{1}}</annotation></semantics></math> and let <math id="S7.SS2.p2.m12" class="ltx_Math" alttext="\overline{\lambda_{2}}:\mathbb{G}_{m}\rightarrow L_{\lambda_{1}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="true">¯</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">→</mo><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\overline{\lambda_{2}}:\mathbb{G}_{m}\rightarrow L_{\lambda_{1}}</annotation></semantics></math> be the corresponding cocharacter. This induces a parabolic subgroup <math id="S7.SS2.p2.m13" class="ltx_Math" alttext="P_{\overline{\lambda_{2}}}\subset L_{\lambda_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mover accent="true"><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="true">¯</mo></mover></msub><mo>⊂</mo><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">P_{\overline{\lambda_{2}}}\subset L_{\lambda_{1}}</annotation></semantics></math> with corresponding Levi subgroup <math id="S7.SS2.p2.m14" class="ltx_Math" alttext="L_{\overline{\lambda_{2}}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mover accent="true"><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="true">¯</mo></mover></msub><annotation encoding="application/x-tex">L_{\overline{\lambda_{2}}}</annotation></semantics></math>. The preimage <math id="S7.SS2.p2.m15" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2})}:=(q_{\lambda_{1}})^{-1}(P_{\overline{\lambda_{2}}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>:=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mover accent="true"><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="true">¯</mo></mover></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2})}:=(q_{\lambda_{1}})^{-1}(P_{\overline{\lambda_{2}}})</annotation></semantics></math> is a parabolic subgroup of <math id="S7.SS2.p2.m16" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> contained in <math id="S7.SS2.p2.m17" class="ltx_Math" alttext="P_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">P_{\lambda_{1}}</annotation></semantics></math> (cf. second paragraph of the proof of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BH04</a>, Prop. 3.1]</cite>). We set <math id="S7.SS2.p2.m18" class="ltx_Math" alttext="L_{(\lambda_{1},\lambda_{2})}\vcentcolon=L_{\overline{\lambda_{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>:=</mo><msub><mi>L</mi><mover accent="true"><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="true">¯</mo></mover></msub></mrow><annotation encoding="application/x-tex">L_{(\lambda_{1},\lambda_{2})}\vcentcolon=L_{\overline{\lambda_{2}}}</annotation></semantics></math>, the joint centralizer of <math id="S7.SS2.p2.m19" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> and <math id="S7.SS2.p2.m20" class="ltx_Math" alttext="\lambda_{2}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\lambda_{2}</annotation></semantics></math>. By definition, <math id="S7.SS2.p2.m21" class="ltx_Math" alttext="L_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">L_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math> is a Levi subgroup of <math id="S7.SS2.p2.m22" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math>; we denote by <math id="S7.SS2.p2.m23" class="ltx_Math" alttext="q_{(\lambda_{1},\lambda_{2})}:P_{(\lambda_{1},\lambda_{2})}\rightarrow L_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">→</mo><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">q_{(\lambda_{1},\lambda_{2})}:P_{(\lambda_{1},\lambda_{2})}\rightarrow L_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math> the quotient morphism. If the cocharacter <math id="S7.SS2.p2.m24" class="ltx_Math" alttext="\lambda_{3}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\lambda_{3}</annotation></semantics></math> factors through the <math id="S7.SS2.p2.m25" class="ltx_Math" alttext="L_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">L_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math>, then we can similarly use <math id="S7.SS2.p2.m26" class="ltx_Math" alttext="q_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">q_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math> to define a smaller parabolic subgroup <math id="S7.SS2.p2.m27" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2},\lambda_{3})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2},\lambda_{3})}</annotation></semantics></math> with Levi subgroup <math id="S7.SS2.p2.m28" class="ltx_Math" alttext="L_{(\lambda_{1},\lambda_{2},\lambda_{3})}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">L_{(\lambda_{1},\lambda_{2},\lambda_{3})}</annotation></semantics></math> given by the joint centralizer of the cocharacters <math id="S7.SS2.p2.m29" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math>, <math id="S7.SS2.p2.m30" class="ltx_Math" alttext="\lambda_{2}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\lambda_{2}</annotation></semantics></math> and <math id="S7.SS2.p2.m31" class="ltx_Math" alttext="\lambda_{3}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\lambda_{3}</annotation></semantics></math>, and iterate this process.</p>
</div>
<div id="S7.Thmthm5" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm5.2" class="ltx_text ltx_font_bold">Definition 7.5</span></span><span id="S7.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm5.p1" class="ltx_para">
<p id="S7.Thmthm5.p1.1" class="ltx_p"><span id="S7.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">We say that the tuple <math id="S7.Thmthm5.p1.m1" class="ltx_Math" alttext="\vec{\lambda}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{\lambda}</annotation></semantics></math> is nested if at the <math id="S7.Thmthm5.p1.m2" class="ltx_Math" alttext="i^{th}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">i^{th}</annotation></semantics></math> step of the procedure described above we have that <math id="S7.Thmthm5.p1.m3" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math> factors through the subgroup <math id="S7.Thmthm5.p1.m4" class="ltx_Math" alttext="L_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i-1})}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">L_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i-1})}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS2.p3" class="ltx_para">
<p id="S7.SS2.p3.1" class="ltx_p">For a nested tuple <math id="S7.SS2.p3.m1" class="ltx_Math" alttext="\vec{\lambda}=(\lambda_{1},\ldots,\lambda_{q})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{\lambda}=(\lambda_{1},\ldots,\lambda_{q})</annotation></semantics></math>, this procedure terminates at the <math id="S7.SS2.p3.m2" class="ltx_Math" alttext="q^{th}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">q^{th}</annotation></semantics></math> step and yields a parabolic subgroup <math id="S7.SS2.p3.m3" class="ltx_Math" alttext="P_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">P_{\vec{\lambda}}</annotation></semantics></math> of <math id="S7.SS2.p3.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> with Levi subgroup <math id="S7.SS2.p3.m5" class="ltx_Math" alttext="L_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">L_{\vec{\lambda}}</annotation></semantics></math>. Furthermore these groups fit into nested chains of subgroups:</p>
<table id="S7.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex118.m1" class="ltx_Math" alttext="P_{\vec{\lambda}}\subset P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}\subset\cdots\subset P_{(\lambda_{1},\lambda_{2})}\subset P_{\lambda_{1}}\subset H" display="block" intent=":literal"><semantics><mrow><msub><mi>P</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>⊂</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></msub><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊂</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>⊂</mo><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo>⊂</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">P_{\vec{\lambda}}\subset P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}\subset\cdots\subset P_{(\lambda_{1},\lambda_{2})}\subset P_{\lambda_{1}}\subset H</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S7.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex119.m1" class="ltx_Math" alttext="L_{\vec{\lambda}}\subset L_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}\subset\cdots\subset L_{(\lambda_{1},\lambda_{2})}\subset L_{\lambda_{1}}\subset H" display="block" intent=":literal"><semantics><mrow><msub><mi>L</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>⊂</mo><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></msub><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊂</mo><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>⊂</mo><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo>⊂</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">L_{\vec{\lambda}}\subset L_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}\subset\cdots\subset L_{(\lambda_{1},\lambda_{2})}\subset L_{\lambda_{1}}\subset H</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S7.Thmthm6" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm6.2" class="ltx_text ltx_font_bold">Definition 7.6</span></span><span id="S7.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm6.p1" class="ltx_para">
<p id="S7.Thmthm6.p1.1" class="ltx_p"><span id="S7.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmthm6.p1.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> be a <math id="S7.Thmthm6.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-scheme. Let <math id="S7.Thmthm6.p1.m3" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> be an <math id="S7.Thmthm6.p1.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>-bundle on <math id="S7.Thmthm6.p1.m5" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. A <math id="S7.Thmthm6.p1.m6" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction of <math id="S7.Thmthm6.p1.m7" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> consists of a pair <math id="S7.Thmthm6.p1.m8" class="ltx_Math" alttext="(\vec{\lambda},\mathcal{H}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vec{\lambda},\mathcal{H}_{\vec{\lambda}})</annotation></semantics></math>, where <math id="S7.Thmthm6.p1.m9" class="ltx_Math" alttext="\vec{\lambda}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{\lambda}</annotation></semantics></math> is a tuple of nested cocharacters of <math id="S7.Thmthm6.p1.m10" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and <math id="S7.Thmthm6.p1.m11" class="ltx_Math" alttext="\mathcal{H}_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">\mathcal{H}_{\vec{\lambda}}</annotation></semantics></math> is a reduction of structure group of <math id="S7.Thmthm6.p1.m12" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> to the subgroup <math id="S7.Thmthm6.p1.m13" class="ltx_Math" alttext="P_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">P_{\vec{\lambda}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS2.p4" class="ltx_para">
<p id="S7.SS2.p4.1" class="ltx_p">Let <math id="S7.SS2.p4.m1" class="ltx_Math" alttext="\theta:H\rightarrow F" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>H</mi><mo stretchy="false">→</mo><mi>F</mi></mrow></mrow><annotation encoding="application/x-tex">\theta:H\rightarrow F</annotation></semantics></math> be a homomorphism of reductive groups over <math id="S7.SS2.p4.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Let <math id="S7.SS2.p4.m3" class="ltx_Math" alttext="\vec{\lambda}=(\lambda_{i})_{i=1}^{q}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup></mrow><annotation encoding="application/x-tex">\vec{\lambda}=(\lambda_{i})_{i=1}^{q}</annotation></semantics></math> be a nested tuple of cocharacters of <math id="S7.SS2.p4.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. We set <math id="S7.SS2.p4.m5" class="ltx_Math" alttext="\theta_{*}(\vec{\lambda})=(\theta\circ\lambda_{i})_{i=1}^{q}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>θ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup></mrow><annotation encoding="application/x-tex">\theta_{*}(\vec{\lambda})=(\theta\circ\lambda_{i})_{i=1}^{q}</annotation></semantics></math>, which can be checked to be a nested tuple of cocharacters of <math id="S7.SS2.p4.m6" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. The homomorphism <math id="S7.SS2.p4.m7" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> restricts to a well-defined homomorphism <math id="S7.SS2.p4.m8" class="ltx_Math" alttext="\theta:P_{\vec{\lambda}}\rightarrow P_{\theta_{*}(\vec{\lambda})}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>P</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">→</mo><msub><mi>P</mi><mrow><msub><mi>θ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\theta:P_{\vec{\lambda}}\rightarrow P_{\theta_{*}(\vec{\lambda})}</annotation></semantics></math>. Let <math id="S7.SS2.p4.m9" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> be a <math id="S7.SS2.p4.m10" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-scheme and let <math id="S7.SS2.p4.m11" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> be a <math id="S7.SS2.p4.m12" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>-bundle on <math id="S7.SS2.p4.m13" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. Given a <math id="S7.SS2.p4.m14" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS2.p4.m15" class="ltx_Math" alttext="(\vec{\lambda},\mathcal{H}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vec{\lambda},\mathcal{H}_{\vec{\lambda}})</annotation></semantics></math> of <math id="S7.SS2.p4.m16" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math>, we can associate a <math id="S7.SS2.p4.m17" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS2.p4.m18" class="ltx_Math" alttext="(\theta_{*}(\vec{\lambda}),\theta_{*}\mathcal{H}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>θ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>θ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\theta_{*}(\vec{\lambda}),\theta_{*}\mathcal{H}_{\vec{\lambda}})</annotation></semantics></math> of <math id="S7.SS2.p4.m19" class="ltx_Math" alttext="\theta_{*}\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">\theta_{*}\mathcal{H}</annotation></semantics></math>. Here <math id="S7.SS2.p4.m20" class="ltx_Math" alttext="\theta_{*}\mathcal{H}_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub></mrow><annotation encoding="application/x-tex">\theta_{*}\mathcal{H}_{\vec{\lambda}}</annotation></semantics></math> is the parabolic reduction obtained from <math id="S7.SS2.p4.m21" class="ltx_Math" alttext="\mathcal{H}_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">\mathcal{H}_{\vec{\lambda}}</annotation></semantics></math> via the restriction <math id="S7.SS2.p4.m22" class="ltx_Math" alttext="\theta:P_{\vec{\lambda}}\rightarrow P_{\theta_{*}(\vec{\lambda})}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>P</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">→</mo><msub><mi>P</mi><mrow><msub><mi>θ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\theta:P_{\vec{\lambda}}\rightarrow P_{\theta_{*}(\vec{\lambda})}</annotation></semantics></math>.</p>
</div>
<div id="S7.SS2.p5" class="ltx_para">
<p id="S7.SS2.p5.1" class="ltx_p">We now return to our original group <math id="S7.SS2.p5.m1" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math>. Suppose that we are given a <math id="S7.SS2.p5.m2" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math>-bundle <math id="S7.SS2.p5.m3" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> on <math id="S7.SS2.p5.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. Given a <math id="S7.SS2.p5.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS2.p5.m6" class="ltx_Math" alttext="(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})</annotation></semantics></math> as above, we shall construct a <math id="S7.SS2.p5.m7" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math>-bundle on <math id="S7.SS2.p5.m8" class="ltx_Math" alttext="\Theta^{q}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\times_{K}Y</annotation></semantics></math> by iterating the Rees construction.</p>
</div>
<div id="S7.SS2.p6" class="ltx_para">
<p id="S7.SS2.p6.1" class="ltx_p">Take the last cocharacter <math id="S7.SS2.p6.m1" class="ltx_Math" alttext="\lambda_{q}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\lambda_{q}</annotation></semantics></math> of <math id="S7.SS2.p6.m2" class="ltx_Math" alttext="\vec{\lambda}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{\lambda}</annotation></semantics></math> and consider the <math id="S7.SS2.p6.m3" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant <math id="S7.SS2.p6.m4" class="ltx_Math" alttext="P_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">P_{\vec{\lambda}}</annotation></semantics></math>-bundle <math id="S7.SS2.p6.m5" class="ltx_Math" alttext="\widetilde{\mathcal{G}}^{1}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mn>1</mn></msup><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}^{1}</annotation></semantics></math> on <math id="S7.SS2.p6.m6" class="ltx_Math" alttext="\mathbb{A}^{1}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mi>K</mi><mn>1</mn></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\mathbb{A}^{1}_{K}\times_{K}Y</annotation></semantics></math> given by the Rees construction <math id="S7.SS2.p6.m7" class="ltx_Math" alttext="\Rees(\mathcal{G}_{\vec{\lambda}},\lambda_{q})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Rees</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>,</mo><msub><mi>λ</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Rees(\mathcal{G}_{\vec{\lambda}},\lambda_{q})</annotation></semantics></math>. Using <math id="S7.SS2.p6.m8" class="ltx_Math" alttext="P_{\vec{\lambda}}\subset P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>⊂</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">P_{\vec{\lambda}}\subset P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}</annotation></semantics></math>, we extend the structure group of <math id="S7.SS2.p6.m9" class="ltx_Math" alttext="\widetilde{\mathcal{G}}^{1}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mn>1</mn></msup><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}^{1}</annotation></semantics></math> to the bigger parabolic <math id="S7.SS2.p6.m10" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}</annotation></semantics></math>. Given that the subsequent cocharacter <math id="S7.SS2.p6.m11" class="ltx_Math" alttext="\lambda_{q-1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\lambda_{q-1}</annotation></semantics></math> factors through <math id="S7.SS2.p6.m12" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}</annotation></semantics></math>, we apply the Rees construction to the <math id="S7.SS2.p6.m13" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}</annotation></semantics></math>-bundle <math id="S7.SS2.p6.m14" class="ltx_Math" alttext="\widetilde{\mathcal{G}}^{1}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mn>1</mn></msup><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}^{1}</annotation></semantics></math> on <math id="S7.SS2.p6.m15" class="ltx_Math" alttext="\mathbb{A}^{1}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mi>K</mi><mn>1</mn></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\mathbb{A}^{1}_{K}\times_{K}Y</annotation></semantics></math> using the cocharacter <math id="S7.SS2.p6.m16" class="ltx_Math" alttext="\lambda_{q-1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\lambda_{q-1}</annotation></semantics></math>. This way we obtain the <math id="S7.SS2.p6.m17" class="ltx_Math" alttext="\mathbb{G}_{m}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔾</mi><mi>m</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\mathbb{G}_{m}^{2}</annotation></semantics></math>-equivariant <math id="S7.SS2.p6.m18" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-1})}</annotation></semantics></math>-bundle <math id="S7.SS2.p6.m19" class="ltx_Math" alttext="\widetilde{\mathcal{G}}^{2}\vcentcolon=\Rees(\widetilde{\mathcal{G}}^{1},\lambda_{q-1})" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mn>2</mn></msup><mo>:=</mo><mrow><mi mathsize="0.800em">Rees</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mn>1</mn></msup><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}^{2}\vcentcolon=\Rees(\widetilde{\mathcal{G}}^{1},\lambda_{q-1})</annotation></semantics></math> on <math id="S7.SS2.p6.m20" class="ltx_Math" alttext="\mathbb{A}^{2}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mi>K</mi><mn>2</mn></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\mathbb{A}^{2}_{K}\times_{K}Y</annotation></semantics></math>. We iterate this procedure: at the <math id="S7.SS2.p6.m21" class="ltx_Math" alttext="i^{th}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">i^{th}</annotation></semantics></math> step we have a <math id="S7.SS2.p6.m22" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-i})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-i})}</annotation></semantics></math>-bundle <math id="S7.SS2.p6.m23" class="ltx_Math" alttext="\widetilde{\mathcal{G}}^{i}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mi>i</mi></msup><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}^{i}</annotation></semantics></math> on <math id="S7.SS2.p6.m24" class="ltx_Math" alttext="\mathbb{A}^{i}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mi>K</mi><mi>i</mi></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\mathbb{A}^{i}_{K}\times_{K}Y</annotation></semantics></math> and we apply the Rees construction using the cocharacter <math id="S7.SS2.p6.m25" class="ltx_Math" alttext="\lambda_{q-i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\lambda_{q-i}</annotation></semantics></math> to get the <math id="S7.SS2.p6.m26" class="ltx_Math" alttext="\mathbb{G}_{m}^{i+1}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔾</mi><mi>m</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\mathbb{G}_{m}^{i+1}</annotation></semantics></math>-equivariant <math id="S7.SS2.p6.m27" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-i-1})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{q-i-1})}</annotation></semantics></math>-bundle <math id="S7.SS2.p6.m28" class="ltx_Math" alttext="\widetilde{\mathcal{G}}^{i+1}\vcentcolon=\Rees(\widetilde{\mathcal{G}}^{i},\lambda_{q-i})" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>:=</mo><mrow><mi mathsize="0.800em">Rees</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mi>i</mi></msup><mo>,</mo><msub><mi>λ</mi><mrow><mi>q</mi><mo>−</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}^{i+1}\vcentcolon=\Rees(\widetilde{\mathcal{G}}^{i},\lambda_{q-i})</annotation></semantics></math> on <math id="S7.SS2.p6.m29" class="ltx_Math" alttext="\mathbb{A}^{i+1}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mi>K</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\mathbb{A}^{i+1}_{K}\times_{K}Y</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm7" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm7.2" class="ltx_text ltx_font_bold">Definition 7.7</span></span><span id="S7.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm7.p1" class="ltx_para">
<p id="S7.Thmthm7.p1.1" class="ltx_p"><span id="S7.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">We denote by <math id="S7.Thmthm7.p1.m1" class="ltx_Math" alttext="\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Rees</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>,</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})</annotation></semantics></math> the <math id="S7.Thmthm7.p1.m2" class="ltx_Math" alttext="P_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">P_{\lambda_{1}}</annotation></semantics></math>-bundle on <math id="S7.Thmthm7.p1.m3" class="ltx_Math" alttext="\Theta^{q}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\times_{K}Y</annotation></semantics></math> obtained at the <math id="S7.Thmthm7.p1.m4" class="ltx_Math" alttext="q^{th}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">q^{th}</annotation></semantics></math> step of the procedure described above.</span></p>
</div>
</div>
<div id="S7.SS2.p7" class="ltx_para">
<p id="S7.SS2.p7.1" class="ltx_p">By construction, the restriction <math id="S7.SS2.p7.m1" class="ltx_Math" alttext="\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})|_{\vec{1}_{K}\times_{K}Y}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><mi mathsize="0.800em">Rees</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>,</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="1.140em" stretchy="false">→</mo></mover><mi>K</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow></msub><annotation encoding="application/x-tex">\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})|_{\vec{1}_{K}\times_{K}Y}</annotation></semantics></math> is canonically isomorphic to the <math id="S7.SS2.p7.m2" class="ltx_Math" alttext="P_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">P_{\lambda_{1}}</annotation></semantics></math>-bundle obtained via <math id="S7.SS2.p7.m3" class="ltx_Math" alttext="\mathcal{G}_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">\mathcal{G}_{\vec{\lambda}}</annotation></semantics></math> using the inclusion <math id="S7.SS2.p7.m4" class="ltx_Math" alttext="P_{\vec{\lambda}}\subset P_{\lambda_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>⊂</mo><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">P_{\vec{\lambda}}\subset P_{\lambda_{1}}</annotation></semantics></math>. We can extend the structure group from <math id="S7.SS2.p7.m5" class="ltx_Math" alttext="P_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">P_{\lambda_{1}}</annotation></semantics></math> to <math id="S7.SS2.p7.m6" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> in order to obtain a <math id="S7.SS2.p7.m7" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math>-bundle <math id="S7.SS2.p7.m8" class="ltx_Math" alttext="\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})\times^{P_{\lambda_{1}}}G_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">Rees</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>,</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msup><mo rspace="0.222em">×</mo><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub></msup><msub><mi>G</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})\times^{P_{\lambda_{1}}}G_{K}</annotation></semantics></math> on <math id="S7.SS2.p7.m9" class="ltx_Math" alttext="\Theta^{q}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\times_{K}Y</annotation></semantics></math>. The restriction to <math id="S7.SS2.p7.m10" class="ltx_Math" alttext="\vec{1}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>K</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\vec{1}_{K}\times_{K}Y</annotation></semantics></math> is canonically isomorphic to the original <math id="S7.SS2.p7.m11" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math>-bundle <math id="S7.SS2.p7.m12" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm8" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm8.2" class="ltx_text ltx_font_bold">Example 7.8</span></span><span id="S7.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm8.p1" class="ltx_para">
<p id="S7.Thmthm8.p1.1" class="ltx_p"><span id="S7.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">If the group is a general linear group <math id="S7.Thmthm8.p1.m1" class="ltx_Math" alttext="\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V)</annotation></semantics></math>, this process can be described more concretely as follows. Let <math id="S7.Thmthm8.p1.m2" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> be a <math id="S7.Thmthm8.p1.m3" class="ltx_Math" alttext="\GL(V)_{K}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><msub><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\GL(V)_{K}</annotation></semantics></math>-bundle on <math id="S7.Thmthm8.p1.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. We can think of <math id="S7.Thmthm8.p1.m5" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> as a vector bundle of constant rank. Let <math id="S7.Thmthm8.p1.m6" class="ltx_Math" alttext="(\vec{\lambda},\mathcal{E}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vec{\lambda},\mathcal{E}_{\vec{\lambda}})</annotation></semantics></math> be a <math id="S7.Thmthm8.p1.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction of <math id="S7.Thmthm8.p1.m8" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>. For each index <math id="S7.Thmthm8.p1.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we set <math id="S7.Thmthm8.p1.m10" class="ltx_Math" alttext="\mathcal{E}_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i})}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathcal{E}_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i})}</annotation></semantics></math> to be the <math id="S7.Thmthm8.p1.m11" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i})}</annotation></semantics></math>-parabolic reduction of <math id="S7.Thmthm8.p1.m12" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> obtained from <math id="S7.Thmthm8.p1.m13" class="ltx_Math" alttext="\mathcal{E}_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">\mathcal{E}_{\vec{\lambda}}</annotation></semantics></math> by extending the structure group <math id="S7.Thmthm8.p1.m14" class="ltx_Math" alttext="P_{\vec{\lambda}}\subset P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>⊂</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">P_{\vec{\lambda}}\subset P_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i})}</annotation></semantics></math>. The pair <math id="S7.Thmthm8.p1.m15" class="ltx_Math" alttext="\left(\lambda_{i},\mathcal{E}_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i})}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\lambda_{i},\mathcal{E}_{(\lambda_{1},\lambda_{2},\ldots,\lambda_{i})}\right)</annotation></semantics></math> amounts to <math id="S7.Thmthm8.p1.m16" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-weighted filtration <math id="S7.Thmthm8.p1.m17" class="ltx_Math" alttext="(\mathcal{E}^{(i)}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{E}^{(i)}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> of <math id="S7.Thmthm8.p1.m18" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>. We use this to define a lexicographic <math id="S7.Thmthm8.p1.m19" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.Thmthm8.p1.m20" class="ltx_Math" alttext="f=(\mathcal{E}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">f=(\mathcal{E}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> of <math id="S7.Thmthm8.p1.m21" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> by vector subbundles where for a tuple <math id="S7.Thmthm8.p1.m22" class="ltx_Math" alttext="\vec{m}=(m_{i})_{i=1}^{q}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup></mrow><annotation encoding="application/x-tex">\vec{m}=(m_{i})_{i=1}^{q}</annotation></semantics></math>, we set <math id="S7.Thmthm8.p1.m23" class="ltx_Math" alttext="\mathcal{E}_{\vec{m}}=\bigcap_{i=1}^{q}\mathcal{E}^{(i)}_{m_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>⋂</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></msubsup><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>m</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\vec{m}}=\bigcap_{i=1}^{q}\mathcal{E}^{(i)}_{m_{i}}</annotation></semantics></math>. Then we apply the multi-graded Rees construction to <math id="S7.Thmthm8.p1.m24" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> in order to obtain a vector bundle <math id="S7.Thmthm8.p1.m25" class="ltx_Math" alttext="\widetilde{\mathcal{E}}_{f}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{E}}_{f}</annotation></semantics></math> on <math id="S7.Thmthm8.p1.m26" class="ltx_Math" alttext="\Theta^{q}_{K}\times_{K}Y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Theta^{q}_{K}\times_{K}Y</annotation></semantics></math>. The <math id="S7.Thmthm8.p1.m27" class="ltx_Math" alttext="\GL(V)_{K}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><msub><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\GL(V)_{K}</annotation></semantics></math>-bundle <math id="S7.Thmthm8.p1.m28" class="ltx_Math" alttext="\widetilde{\mathcal{E}}_{f}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{E}}_{f}</annotation></semantics></math> is precisely <math id="S7.Thmthm8.p1.m29" class="ltx_Math" alttext="\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})\times^{P_{\lambda_{1}}}\GL(V)_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">Rees</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>,</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msup><mo rspace="0.222em">×</mo><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub></msup><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><msub><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow><mi>K</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})\times^{P_{\lambda_{1}}}\GL(V)_{K}</annotation></semantics></math>. A similar description holds for <math id="S7.Thmthm8.p1.m30" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math>-bundles, by applying this construction to each component of a tuple <math id="S7.Thmthm8.p1.m31" class="ltx_Math" alttext="\mathcal{E}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{E}^{\bullet}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS2.p8" class="ltx_para">
<p id="S7.SS2.p8.1" class="ltx_p">Now let <math id="S7.SS2.p8.m1" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be a <math id="S7.SS2.p8.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf over <math id="S7.SS2.p8.m3" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> and let <math id="S7.SS2.p8.m4" class="ltx_Math" alttext="f=(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">f=(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> be a lexicographic <math id="S7.SS2.p8.m5" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration of <math id="S7.SS2.p8.m6" class="ltx_Math" alttext="\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}</annotation></semantics></math>. Let <math id="S7.SS2.p8.m7" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be a big open subset of <math id="S7.SS2.p8.m8" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> where the tuple <math id="S7.SS2.p8.m9" class="ltx_Math" alttext="\text{gr}(f)" display="inline" intent=":literal"><semantics><mrow><mtext>gr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}(f)</annotation></semantics></math> is locally-free. Then the restriction <math id="S7.SS2.p8.m10" class="ltx_Math" alttext="(\widetilde{\mathcal{F}^{\bullet}}_{f})|_{\Theta^{q}_{K}\times_{K}U}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>K</mi><mi>q</mi></msubsup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>U</mi></mrow></msub><annotation encoding="application/x-tex">(\widetilde{\mathcal{F}^{\bullet}}_{f})|_{\Theta^{q}_{K}\times_{K}U}</annotation></semantics></math> is locally-free, so we can view it as a <math id="S7.SS2.p8.m11" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math>-bundle. Since <math id="S7.SS2.p8.m12" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> is a filtration of the <math id="S7.SS2.p8.m13" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf, this <math id="S7.SS2.p8.m14" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math>-bundle comes equipped with a canonical reduction of structure group <math id="S7.SS2.p8.m15" class="ltx_Math" alttext="\widetilde{\mathcal{G}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}</annotation></semantics></math> to <math id="S7.SS2.p8.m16" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math>. Let <math id="S7.SS2.p8.m17" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> be the <math id="S7.SS2.p8.m18" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math>-bundle on <math id="S7.SS2.p8.m19" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> corresponding to the <math id="S7.SS2.p8.m20" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S7.SS2.p8.m21" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> (equivalently <math id="S7.SS2.p8.m22" class="ltx_Math" alttext="\mathcal{G}=\widetilde{\mathcal{G}}|_{\vec{1}_{K}\times_{K}U}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><msub><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">|</mo></mrow><mrow><msub><mover accent="true"><mn>1</mn><mo mathsize="1.140em" stretchy="false">→</mo></mover><mi>K</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>U</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{G}=\widetilde{\mathcal{G}}|_{\vec{1}_{K}\times_{K}U}</annotation></semantics></math>).</p>
</div>
<div id="S7.Thmthm9" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm9.2" class="ltx_text ltx_font_bold">Definition 7.9</span></span><span id="S7.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm9.p1" class="ltx_para">
<p id="S7.Thmthm9.p1.1" class="ltx_p"><span id="S7.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">We say that the lexicographic filtration <math id="S7.Thmthm9.p1.m1" class="ltx_Math" alttext="f=(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">f=(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> comes from a <math id="S7.Thmthm9.p1.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.Thmthm9.p1.m3" class="ltx_Math" alttext="(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})</annotation></semantics></math> of <math id="S7.Thmthm9.p1.m4" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> if <math id="S7.Thmthm9.p1.m5" class="ltx_Math" alttext="\widetilde{\mathcal{G}}=\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})\times^{P_{\lambda_{1}}}G_{K}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mo>=</mo><mrow><mrow><mi mathsize="0.800em">Rees</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>,</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msup><mo rspace="0.222em">×</mo><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub></msup><msub><mi>G</mi><mi>K</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}=\Rees(\mathcal{G}_{\vec{\lambda}},\vec{\lambda})\times^{P_{\lambda_{1}}}G_{K}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS2.p9" class="ltx_para">
<p id="S7.SS2.p9.1" class="ltx_p">More explicitly, if <math id="S7.SS2.p9.m1" class="ltx_Math" alttext="j:U\hookrightarrow X_{K}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">↪</mo><msub><mi>X</mi><mi>K</mi></msub></mrow></mrow><annotation encoding="application/x-tex">j:U\hookrightarrow X_{K}</annotation></semantics></math> is a big open subset where the tuple <math id="S7.SS2.p9.m2" class="ltx_Math" alttext="\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}</annotation></semantics></math> is locally-free, a <math id="S7.SS2.p9.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS2.p9.m4" class="ltx_Math" alttext="(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})</annotation></semantics></math> induces a <math id="S7.SS2.p9.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS2.p9.m6" class="ltx_Math" alttext="(\rho_{*}(\vec{\lambda}),\rho_{*}\mathcal{G}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>ρ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\rho_{*}(\vec{\lambda}),\rho_{*}\mathcal{G}_{\vec{\lambda}})</annotation></semantics></math> of the <math id="S7.SS2.p9.m7" class="ltx_Math" alttext="\GL(V^{\bullet})_{K}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})_{K}</annotation></semantics></math>-bundle <math id="S7.SS2.p9.m8" class="ltx_Math" alttext="\mathcal{F}^{\bullet}|_{U}=:\mathcal{E}^{\bullet}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∙</mo></msup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}|_{U}=:\mathcal{E}^{\bullet}</annotation></semantics></math>. We define a lexicographic <math id="S7.SS2.p9.m9" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.SS2.p9.m10" class="ltx_Math" alttext="(\mathcal{E}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{E}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> of <math id="S7.SS2.p9.m11" class="ltx_Math" alttext="\mathcal{E}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{E}^{\bullet}</annotation></semantics></math> associated to the <math id="S7.SS2.p9.m12" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS2.p9.m13" class="ltx_Math" alttext="(\rho_{*}(\vec{\lambda}),\rho_{*}\mathcal{G}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>ρ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\rho_{*}(\vec{\lambda}),\rho_{*}\mathcal{G}_{\vec{\lambda}})</annotation></semantics></math> and, for each <math id="S7.SS2.p9.m14" class="ltx_Math" alttext="\vec{m}\in\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">\vec{m}\in\mathbb{Z}^{q}</annotation></semantics></math>, set <math id="S7.SS2.p9.m15" class="ltx_Math" alttext="\widetilde{\mathcal{E}}^{\bullet}_{\vec{m}}\vcentcolon=j_{*}(\mathcal{E}^{\bullet}_{\vec{m}})\cap\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo mathsize="0.800em">~</mo></mover><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo>:=</mo><mrow><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{E}}^{\bullet}_{\vec{m}}\vcentcolon=j_{*}(\mathcal{E}^{\bullet}_{\vec{m}})\cap\mathcal{F}^{\bullet}</annotation></semantics></math> (the intersection being taken for each coordinate of the tuple). This defines a lexicographic <math id="S7.SS2.p9.m16" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration of <math id="S7.SS2.p9.m17" class="ltx_Math" alttext="\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}</annotation></semantics></math>, and <math id="S7.SS2.p9.m18" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}=(\widetilde{\mathcal{E}}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo mathsize="0.800em">~</mo></mover><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}=(\widetilde{\mathcal{E}}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> exactly when <math id="S7.SS2.p9.m19" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> comes from the <math id="S7.SS2.p9.m20" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS2.p9.m21" class="ltx_Math" alttext="(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})</annotation></semantics></math>.</p>
</div>
</section>
<section id="S7.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.3. </span>The GHN filtration for <math id="S7.SS3.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves</h3>

<div id="S7.SS3.p1" class="ltx_para">
<p id="S7.SS3.p1.1" class="ltx_p">Fix a tuple <math id="S7.SS3.p1.m1" class="ltx_Math" alttext="V^{\bullet}=(V^{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><msup><mi>V</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">V^{\bullet}=(V^{i})_{i=1}^{b}</annotation></semantics></math> of vector spaces over <math id="S7.SS3.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and let <math id="S7.SS3.p1.m3" class="ltx_Math" alttext="\rho:G\rightarrow\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>G</mi><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:G\rightarrow\GL(V^{\bullet})</annotation></semantics></math> be a faithful representation. In this subsection, we recursively apply the leading term HN filtration to the associated graded Levi sheaves in order to obtain a sequence of multi-weighted parabolic reductions of <math id="S7.SS3.p1.m4" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p2" class="ltx_para">
<p id="S7.SS3.p2.1" class="ltx_p">Let <math id="S7.SS3.p2.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be a field extension such that <math id="S7.SS3.p2.m2" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is split and let <math id="S7.SS3.p2.m3" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be an unstable <math id="S7.SS3.p2.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S7.SS3.p2.m5" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. Let us proceed to describe the recursive construction of the GHN filtration of <math id="S7.SS3.p2.m6" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p3" class="ltx_para">
<p id="S7.SS3.p3.1" class="ltx_p"><span id="S7.SS3.p3.1.1" class="ltx_text ltx_underline">First Step</span>: Let <math id="S7.SS3.p3.m1" class="ltx_Math" alttext="f_{can,1}:=(\mathcal{F}^{\bullet}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo>:=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f_{can,1}:=(\mathcal{F}^{\bullet}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> be the leading term HN filtration of <math id="S7.SS3.p3.m2" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> and let <math id="S7.SS3.p3.m3" class="ltx_Math" alttext="(\lambda_{1},\mathcal{G}_{\lambda_{1}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{1},\mathcal{G}_{\lambda_{1}})</annotation></semantics></math> be the corresponding weighted parabolic reduction. The cocharacter <math id="S7.SS3.p3.m4" class="ltx_Math" alttext="\rho\circ\lambda_{1}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>λ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\rho\circ\lambda_{1}</annotation></semantics></math> induces a grading on each vector space <math id="S7.SS3.p3.m5" class="ltx_Math" alttext="V^{i}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>i</mi></msup><annotation encoding="application/x-tex">V^{i}</annotation></semantics></math>. This induces a nontrivial direct sum decomposition of the tuple <math id="S7.SS3.p3.m6" class="ltx_Math" alttext="V^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">V^{\bullet}</annotation></semantics></math>. Indeed, if the decomposition was trivial then <math id="S7.SS3.p3.m7" class="ltx_Math" alttext="\rho\circ\lambda_{1}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>λ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\rho\circ\lambda_{1}</annotation></semantics></math> would be a cocharacter of the center of <math id="S7.SS3.p3.m8" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math> and using the same reasoning as in Proposition <a href="#S6.Thmthm8" title="Proposition 6.8. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.8</span></a> we would get <math id="S7.SS3.p3.m9" class="ltx_Math" alttext="\nu(f_{can,1})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu(f_{can,1})=0</annotation></semantics></math>, contradicting the fact that <math id="S7.SS3.p3.m10" class="ltx_Math" alttext="f_{can,1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">f_{can,1}</annotation></semantics></math> is destabilizing.</p>
</div>
<div id="S7.SS3.p4" class="ltx_para">
<p id="S7.SS3.p4.1" class="ltx_p">We can think of this direct sum decomposition as a finer tuple <math id="S7.SS3.p4.m1" class="ltx_Math" alttext="V_{\lambda_{1}}^{\bullet}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><msub><mi>λ</mi><mn>1</mn></msub><mo>∙</mo></msubsup><annotation encoding="application/x-tex">V_{\lambda_{1}}^{\bullet}</annotation></semantics></math> of direct summands, where we have increased the number of indexes. The group <math id="S7.SS3.p4.m2" class="ltx_Math" alttext="\GL(V^{\bullet}_{\lambda_{1}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><msub><mi>λ</mi><mn>1</mn></msub><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet}_{\lambda_{1}})</annotation></semantics></math> is the Levi subgroup of <math id="S7.SS3.p4.m3" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math> determined by the cocharacter <math id="S7.SS3.p4.m4" class="ltx_Math" alttext="\rho\circ\lambda_{1}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>λ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\rho\circ\lambda_{1}</annotation></semantics></math> which, by definition, contains the image of the Levi <math id="S7.SS3.p4.m5" class="ltx_Math" alttext="L_{\lambda_{1}}\subset G" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo>⊂</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">L_{\lambda_{1}}\subset G</annotation></semantics></math> under <math id="S7.SS3.p4.m6" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>. We denote by <math id="S7.SS3.p4.m7" class="ltx_Math" alttext="\rho_{\lambda_{1}}:L_{\lambda_{1}}\rightarrow\GL(V^{\bullet}_{\lambda_{1}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><msub><mi>λ</mi><mn>1</mn></msub><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{\lambda_{1}}:L_{\lambda_{1}}\rightarrow\GL(V^{\bullet}_{\lambda_{1}})</annotation></semantics></math> the restriction to <math id="S7.SS3.p4.m8" class="ltx_Math" alttext="L_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">L_{\lambda_{1}}</annotation></semantics></math> of the homomorphism <math id="S7.SS3.p4.m9" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p5" class="ltx_para">
<p id="S7.SS3.p5.1" class="ltx_p">The description of the associated graded <math id="S7.SS3.p5.m1" class="ltx_Math" alttext="f_{can,1}|_{0}=\left(\bigoplus_{m\in\mathbb{Z}}\mathcal{F}^{\bullet}_{m}/\mathcal{F}^{\bullet}_{m+1},\text{gr}(\sigma)\right)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msub><mi>f</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>=</mo><mrow><mo>(</mo><mrow><mrow><msub><mo lspace="0em">⨁</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>∙</mo></msubsup></mrow><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo>∙</mo></msubsup></mrow><mo>,</mo><mrow><mtext>gr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{can,1}|_{0}=\left(\bigoplus_{m\in\mathbb{Z}}\mathcal{F}^{\bullet}_{m}/\mathcal{F}^{\bullet}_{m+1},\text{gr}(\sigma)\right)</annotation></semantics></math> given at the end of Subsection <a href="#S3.SS3" title="3.3. Filtrations of 
          
            ρ
          
        -sheaves in the split case ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> shows that we can canonically view <math id="S7.SS3.p5.m2" class="ltx_Math" alttext="f_{can,1}|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>f</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">f_{can,1}|_{0}</annotation></semantics></math> as a <math id="S7.SS3.p5.m3" class="ltx_Math" alttext="\rho_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\rho_{\lambda_{1}}</annotation></semantics></math>-sheaf for the Levi <math id="S7.SS3.p5.m4" class="ltx_Math" alttext="L_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">L_{\lambda_{1}}</annotation></semantics></math>. We call this the <math id="S7.SS3.p5.m5" class="ltx_Math" alttext="1^{st}" display="inline" intent=":literal"><semantics><msup><mn>1</mn><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><annotation encoding="application/x-tex">1^{st}</annotation></semantics></math> associated graded Levi sheaf and denote it by <math id="S7.SS3.p5.m6" class="ltx_Math" alttext="\text{gr}_{1}(\mathcal{F}^{\bullet},\sigma):=(\text{gr}_{1}(\mathcal{F}^{\bullet}),\text{gr}_{1}(\sigma))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{1}(\mathcal{F}^{\bullet},\sigma):=(\text{gr}_{1}(\mathcal{F}^{\bullet}),\text{gr}_{1}(\sigma))</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p6" class="ltx_para">
<p id="S7.SS3.p6.1" class="ltx_p"><span id="S7.SS3.p6.1.1" class="ltx_text ltx_underline">Second Step</span>: It might happen that the <math id="S7.SS3.p6.m1" class="ltx_Math" alttext="\rho_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\rho_{\lambda_{1}}</annotation></semantics></math>-sheaf <math id="S7.SS3.p6.m2" class="ltx_Math" alttext="\text{gr}_{1}(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{1}(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> is unstable (see <a href="#S4.Thmthm33" title="Example 4.33. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Example</span> <span class="ltx_text ltx_ref_tag">4.33</span></a>). If that is the case, we can consider the leading term HN filtration <math id="S7.SS3.p6.m3" class="ltx_Math" alttext="f_{can,2}=(\text{gr}_{1}(\mathcal{F}^{\bullet})_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>2</mn></mrow></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f_{can,2}=(\text{gr}_{1}(\mathcal{F}^{\bullet})_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> of the <math id="S7.SS3.p6.m4" class="ltx_Math" alttext="\rho_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\rho_{\lambda_{1}}</annotation></semantics></math>-sheaf <math id="S7.SS3.p6.m5" class="ltx_Math" alttext="\text{gr}_{1}(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{1}(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>. This is by definition a <math id="S7.SS3.p6.m6" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-filtration of <math id="S7.SS3.p6.m7" class="ltx_Math" alttext="\text{gr}_{1}(\mathcal{F}^{\bullet})" display="inline" intent=":literal"><semantics><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{1}(\mathcal{F}^{\bullet})</annotation></semantics></math>. Note that <math id="S7.SS3.p6.m8" class="ltx_Math" alttext="(L_{\lambda_{1}})_{K}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><mi>K</mi></msub><annotation encoding="application/x-tex">(L_{\lambda_{1}})_{K}</annotation></semantics></math> must also be split, and therefore there exists a weighted parabolic reduction <math id="S7.SS3.p6.m9" class="ltx_Math" alttext="(\lambda_{2},\mathcal{G}_{\lambda_{2}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>λ</mi><mn>2</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{2},\mathcal{G}_{\lambda_{2}})</annotation></semantics></math> of <math id="S7.SS3.p6.m10" class="ltx_Math" alttext="\text{gr}_{1}(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{1}(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> that induces the leading term HN filtration <math id="S7.SS3.p6.m11" class="ltx_Math" alttext="(\text{gr}_{1}(\mathcal{F}^{\bullet})_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\text{gr}_{1}(\mathcal{F}^{\bullet})_{m})_{m\in\mathbb{Z}}</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p7" class="ltx_para">
<p id="S7.SS3.p7.1" class="ltx_p">By construction we can think of <math id="S7.SS3.p7.m1" class="ltx_Math" alttext="(\lambda_{1},\lambda_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{1},\lambda_{2})</annotation></semantics></math> as a nested pair. We set <math id="S7.SS3.p7.m2" class="ltx_Math" alttext="L_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">L_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math> to be the Levi subgroup of <math id="S7.SS3.p7.m3" class="ltx_Math" alttext="L_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">L_{\lambda_{1}}</annotation></semantics></math> centralizing <math id="S7.SS3.p7.m4" class="ltx_Math" alttext="\lambda_{2}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\lambda_{2}</annotation></semantics></math> and denote by <math id="S7.SS3.p7.m5" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math> the preimage under <math id="S7.SS3.p7.m6" class="ltx_Math" alttext="q_{\lambda_{1}}:P_{\lambda_{1}}\rightarrow L_{\lambda_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo stretchy="false">→</mo><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">q_{\lambda_{1}}:P_{\lambda_{1}}\rightarrow L_{\lambda_{1}}</annotation></semantics></math> of <math id="S7.SS3.p7.m7" class="ltx_Math" alttext="P_{\lambda_{2}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><msub><mi>λ</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">P_{\lambda_{2}}</annotation></semantics></math>. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BH04</a>, Lem. 2.1]</cite>, the <math id="S7.SS3.p7.m8" class="ltx_Math" alttext="P_{\lambda_{2}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><msub><mi>λ</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">P_{\lambda_{2}}</annotation></semantics></math>-parabolic reduction <math id="S7.SS3.p7.m9" class="ltx_Math" alttext="\mathcal{G}_{\lambda_{2}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>λ</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{\lambda_{2}}</annotation></semantics></math> lifts to a unique <math id="S7.SS3.p7.m10" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math>-parabolic reduction <math id="S7.SS3.p7.m11" class="ltx_Math" alttext="\mathcal{G}_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathcal{G}_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math> that recovers the <math id="S7.SS3.p7.m12" class="ltx_Math" alttext="P_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">P_{\lambda_{1}}</annotation></semantics></math>-reduction <math id="S7.SS3.p7.m13" class="ltx_Math" alttext="\mathcal{G}_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{\lambda_{1}}</annotation></semantics></math> under the extension of groups <math id="S7.SS3.p7.m14" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2})}\subset P_{\lambda_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>⊂</mo><msub><mi>P</mi><msub><mi>λ</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2})}\subset P_{\lambda_{1}}</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p8" class="ltx_para">
<p id="S7.SS3.p8.1" class="ltx_p">Each piece in the <math id="S7.SS3.p8.m1" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-filtration <math id="S7.SS3.p8.m2" class="ltx_Math" alttext="(\text{gr}_{1}(\mathcal{F}^{\bullet}_{m}))_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\text{gr}_{1}(\mathcal{F}^{\bullet}_{m}))_{m\in\mathbb{Z}}</annotation></semantics></math> of the associated graded <math id="S7.SS3.p8.m3" class="ltx_Math" alttext="\text{gr}_{1}(\mathcal{F}^{\bullet})=\bigoplus_{m\in\mathbb{Z}}\mathcal{F}^{\bullet}_{m}/\mathcal{F}_{m+1}^{\bullet}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>⨁</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>∙</mo></msubsup></mrow><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo>∙</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{1}(\mathcal{F}^{\bullet})=\bigoplus_{m\in\mathbb{Z}}\mathcal{F}^{\bullet}_{m}/\mathcal{F}_{m+1}^{\bullet}</annotation></semantics></math> can be lifted to the original <math id="S7.SS3.p8.m4" class="ltx_Math" alttext="\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}</annotation></semantics></math> by taking the preimages in each subquotient. This way we obtain a lexicographic <math id="S7.SS3.p8.m5" class="ltx_Math" alttext="\mathbb{Z}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{Z}^{2}</annotation></semantics></math>-filtration <math id="S7.SS3.p8.m6" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{(m_{1},m_{2})})_{(m_{1},m_{2})\in\mathbb{Z}^{2}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℤ</mi><mn>2</mn></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{(m_{1},m_{2})})_{(m_{1},m_{2})\in\mathbb{Z}^{2}}</annotation></semantics></math> of the original tuple <math id="S7.SS3.p8.m7" class="ltx_Math" alttext="\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}</annotation></semantics></math>. This is the lexicographic filtration coming from the 2-weighted parabolic reduction <math id="S7.SS3.p8.m8" class="ltx_Math" alttext="\left((\lambda_{1},\lambda_{2}),\mathcal{G}_{(\lambda_{1},\lambda_{2})}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">\left((\lambda_{1},\lambda_{2}),\mathcal{G}_{(\lambda_{1},\lambda_{2})}\right)</annotation></semantics></math>. In particular <math id="S7.SS3.p8.m9" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{(m_{1},m_{2})})_{(m_{1},m_{2})\in\mathbb{Z}^{2}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℤ</mi><mn>2</mn></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{(m_{1},m_{2})})_{(m_{1},m_{2})\in\mathbb{Z}^{2}}</annotation></semantics></math> is actually a lexicographic <math id="S7.SS3.p8.m10" class="ltx_Math" alttext="\mathbb{Z}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{Z}^{2}</annotation></semantics></math>-filtration of <math id="S7.SS3.p8.m11" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p9" class="ltx_para">
<p id="S7.SS3.p9.1" class="ltx_p">The cocharacter <math id="S7.SS3.p9.m1" class="ltx_Math" alttext="\lambda_{2}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\lambda_{2}</annotation></semantics></math> induces a nontrivial direct sum decomposition of the tuple <math id="S7.SS3.p9.m2" class="ltx_Math" alttext="V^{\bullet}_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><msub><mi>λ</mi><mn>1</mn></msub><mo>∙</mo></msubsup><annotation encoding="application/x-tex">V^{\bullet}_{\lambda_{1}}</annotation></semantics></math>. We can think of this decomposition as a (strictly) finer tuple <math id="S7.SS3.p9.m3" class="ltx_Math" alttext="V^{\bullet}_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">V^{\bullet}_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math> of direct summands. The restriction of <math id="S7.SS3.p9.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> to the Levi subgroup <math id="S7.SS3.p9.m5" class="ltx_Math" alttext="L_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">L_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math> factors through <math id="S7.SS3.p9.m6" class="ltx_Math" alttext="\GL(V^{\bullet}_{(\lambda_{1},\lambda_{2})})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet}_{(\lambda_{1},\lambda_{2})})</annotation></semantics></math>, which is a smaller Levi subgroup of <math id="S7.SS3.p9.m7" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math> contained in the Levi <math id="S7.SS3.p9.m8" class="ltx_Math" alttext="\GL(V^{\bullet}_{\lambda_{1}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><msub><mi>λ</mi><mn>1</mn></msub><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet}_{\lambda_{1}})</annotation></semantics></math>. We denote this restriction by <math id="S7.SS3.p9.m9" class="ltx_Math" alttext="\rho_{(\lambda_{1},\lambda_{2})}:L_{(\lambda_{1},\lambda_{2})}\rightarrow\GL(V^{\bullet}_{(\lambda_{1},\lambda_{2})})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{(\lambda_{1},\lambda_{2})}:L_{(\lambda_{1},\lambda_{2})}\rightarrow\GL(V^{\bullet}_{(\lambda_{1},\lambda_{2})})</annotation></semantics></math>. The associated graded <math id="S7.SS3.p9.m10" class="ltx_Math" alttext="f_{can,2}|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>f</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>2</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">f_{can,2}|_{0}</annotation></semantics></math> acquires canonically the structure of a <math id="S7.SS3.p9.m11" class="ltx_Math" alttext="\rho_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\rho_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math>-sheaf, denoted by <math id="S7.SS3.p9.m12" class="ltx_Math" alttext="\text{gr}_{2}(\mathcal{F}^{\bullet},\sigma):=(\text{gr}_{2}(\mathcal{F}^{\bullet}),\text{gr}_{2}(\sigma))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext>gr</mtext><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mtext>gr</mtext><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mtext>gr</mtext><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{2}(\mathcal{F}^{\bullet},\sigma):=(\text{gr}_{2}(\mathcal{F}^{\bullet}),\text{gr}_{2}(\sigma))</annotation></semantics></math>. We call this the <math id="S7.SS3.p9.m13" class="ltx_Math" alttext="2^{nd}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><annotation encoding="application/x-tex">2^{nd}</annotation></semantics></math> associated graded Levi sheaf. We have that <math id="S7.SS3.p9.m14" class="ltx_Math" alttext="\text{gr}_{2}(\mathcal{F}^{\bullet})" display="inline" intent=":literal"><semantics><mrow><msub><mtext>gr</mtext><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{2}(\mathcal{F}^{\bullet})</annotation></semantics></math> is the associated graded for the lexicographic <math id="S7.SS3.p9.m15" class="ltx_Math" alttext="\mathbb{Z}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{Z}^{2}</annotation></semantics></math>-filtration <math id="S7.SS3.p9.m16" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{(m_{1},m_{2})})_{(m_{1},m_{2})\in\mathbb{Z}^{2}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℤ</mi><mn>2</mn></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{(m_{1},m_{2})})_{(m_{1},m_{2})\in\mathbb{Z}^{2}}</annotation></semantics></math> that we have defined. Moreover, its corresponding <math id="S7.SS3.p9.m17" class="ltx_Math" alttext="L_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">L_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math>-rational bundle is the same as the one obtained from the <math id="S7.SS3.p9.m18" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math>-parabolic reduction <math id="S7.SS3.p9.m19" class="ltx_Math" alttext="\mathcal{G}_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathcal{G}_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math> via the Levi quotient map <math id="S7.SS3.p9.m20" class="ltx_Math" alttext="P_{(\lambda_{1},\lambda_{2})}\rightarrow L_{(\lambda_{1},\lambda_{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">→</mo><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">P_{(\lambda_{1},\lambda_{2})}\rightarrow L_{(\lambda_{1},\lambda_{2})}</annotation></semantics></math>. So we can view <math id="S7.SS3.p9.m21" class="ltx_Math" alttext="\text{gr}_{2}(\mathcal{F}^{\bullet})" display="inline" intent=":literal"><semantics><mrow><msub><mtext>gr</mtext><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{2}(\mathcal{F}^{\bullet})</annotation></semantics></math> as the associated graded of the 2-weighted parabolic reduction <math id="S7.SS3.p9.m22" class="ltx_Math" alttext="\left((\lambda_{1},\lambda_{2}),\mathcal{G}_{(\lambda_{1},\lambda_{2})}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">\left((\lambda_{1},\lambda_{2}),\mathcal{G}_{(\lambda_{1},\lambda_{2})}\right)</annotation></semantics></math> <span id="footnote9" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">9</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">9</sup>
              <span class="ltx_tag ltx_tag_note">9</span>
              
              
              
              
              
              
              
            We entrust the reader with the precise formulation of what this means.</span></span></span>.</p>
</div>
<div id="S7.SS3.p10" class="ltx_para">
<p id="S7.SS3.p10.1" class="ltx_p"><span id="S7.SS3.p10.1.1" class="ltx_text ltx_underline">Recursion</span>: If <math id="S7.SS3.p10.m1" class="ltx_Math" alttext="\text{gr}_{2}(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mtext>gr</mtext><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{2}(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> is not Gieseker semistable, then we can iterate this construction and consider the leading term HN filtration <math id="S7.SS3.p10.m2" class="ltx_Math" alttext="f_{can,3}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">f_{can,3}</annotation></semantics></math>, and so on. At the <math id="S7.SS3.p10.m3" class="ltx_Math" alttext="j^{th}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">j^{th}</annotation></semantics></math> step of this iteration we have a <math id="S7.SS3.p10.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS3.p10.m5" class="ltx_Math" alttext="((\lambda_{1},\ldots,\lambda_{j}),\mathcal{G}_{(\lambda_{1},\ldots,\lambda_{j})})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((\lambda_{1},\ldots,\lambda_{j}),\mathcal{G}_{(\lambda_{1},\ldots,\lambda_{j})})</annotation></semantics></math> of <math id="S7.SS3.p10.m6" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>. The associated underlying lexicographic <math id="S7.SS3.p10.m7" class="ltx_Math" alttext="\mathbb{Z}^{j}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>j</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{j}</annotation></semantics></math>-filtration <math id="S7.SS3.p10.m8" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{j}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>j</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{j}}</annotation></semantics></math> coming from <math id="S7.SS3.p10.m9" class="ltx_Math" alttext="((\lambda_{1},\ldots,\lambda_{j}),\mathcal{G}_{(\lambda_{1},\ldots,\lambda_{j}}))" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((\lambda_{1},\ldots,\lambda_{j}),\mathcal{G}_{(\lambda_{1},\ldots,\lambda_{j}}))</annotation></semantics></math> is uniquely determined up to scaling the weights. Recall that <math id="S7.SS3.p10.m10" class="ltx_Math" alttext="(\lambda_{1},\ldots,\lambda_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{1},\ldots,\lambda_{j})</annotation></semantics></math> determines a Levi subgroup <math id="S7.SS3.p10.m11" class="ltx_Math" alttext="L_{(\lambda_{1},\ldots,\lambda_{j})}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">L_{(\lambda_{1},\ldots,\lambda_{j})}</annotation></semantics></math> that centralizes all the cocharacters in the tuple. We have an induced direct sum decomposition <math id="S7.SS3.p10.m12" class="ltx_Math" alttext="V^{\bullet}_{(\lambda_{1},\ldots,\lambda_{j})}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">V^{\bullet}_{(\lambda_{1},\ldots,\lambda_{j})}</annotation></semantics></math>, so that the representation <math id="S7.SS3.p10.m13" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> restricted to <math id="S7.SS3.p10.m14" class="ltx_Math" alttext="L_{(\lambda_{1},\ldots,\lambda_{j})}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">L_{(\lambda_{1},\ldots,\lambda_{j})}</annotation></semantics></math> factors as <math id="S7.SS3.p10.m15" class="ltx_Math" alttext="\rho_{(\lambda_{1},\ldots,\lambda_{j})}:L_{(\lambda_{1},\ldots,\lambda_{j})}\rightarrow\GL(V^{\bullet}_{(\lambda_{1},\ldots,\lambda_{j})})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>L</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{(\lambda_{1},\ldots,\lambda_{j})}:L_{(\lambda_{1},\ldots,\lambda_{j})}\rightarrow\GL(V^{\bullet}_{(\lambda_{1},\ldots,\lambda_{j})})</annotation></semantics></math>. We also have a <math id="S7.SS3.p10.m16" class="ltx_Math" alttext="j^{th}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">j^{th}</annotation></semantics></math> associated graded Levi <math id="S7.SS3.p10.m17" class="ltx_Math" alttext="\rho_{(\lambda_{1},\ldots,\lambda_{j})}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\rho_{(\lambda_{1},\ldots,\lambda_{j})}</annotation></semantics></math>-sheaf <math id="S7.SS3.p10.m18" class="ltx_Math" alttext="(\text{gr}_{j}(\mathcal{F}^{\bullet}),\text{gr}_{j}(\sigma))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mtext>gr</mtext><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mtext>gr</mtext><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\text{gr}_{j}(\mathcal{F}^{\bullet}),\text{gr}_{j}(\sigma))</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p11" class="ltx_para">
<p id="S7.SS3.p11.1" class="ltx_p"><span id="S7.SS3.p11.1.1" class="ltx_text ltx_underline">Termination</span>: At each step of the process, the nontrivial direct sum decomposition of <math id="S7.SS3.p11.m1" class="ltx_Math" alttext="V^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">V^{\bullet}</annotation></semantics></math> is finer than in the previous step. Since the vector spaces <math id="S7.SS3.p11.m2" class="ltx_Math" alttext="V^{i}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>i</mi></msup><annotation encoding="application/x-tex">V^{i}</annotation></semantics></math> are finite dimensional, this process must terminate eventually. Suppose that it terminates at the <math id="S7.SS3.p11.m3" class="ltx_Math" alttext="q^{th}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">q^{th}</annotation></semantics></math> step to yield a <math id="S7.SS3.p11.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS3.p11.m5" class="ltx_Math" alttext="\left(\vec{\lambda},\mathcal{G}_{\vec{\lambda}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\vec{\lambda},\mathcal{G}_{\vec{\lambda}}\right)</annotation></semantics></math>. We call this a Gieseker-Harder-Narasimhan (multi-weighted) parabolic reduction of <math id="S7.SS3.p11.m6" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>. The corresponding <math id="S7.SS3.p11.m7" class="ltx_Math" alttext="q^{th}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">q^{th}</annotation></semantics></math> associated graded Levi <math id="S7.SS3.p11.m8" class="ltx_Math" alttext="\rho_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">\rho_{\vec{\lambda}}</annotation></semantics></math>-sheaf <math id="S7.SS3.p11.m9" class="ltx_Math" alttext="(\text{gr}_{q}(\mathcal{F}^{\bullet}),\text{gr}_{q}(\sigma))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mtext>gr</mtext><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mtext>gr</mtext><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\text{gr}_{q}(\mathcal{F}^{\bullet}),\text{gr}_{q}(\sigma))</annotation></semantics></math> is called the Gieseker-Harder-Narasimhan associated Levi of <math id="S7.SS3.p11.m10" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>. By construction, <math id="S7.SS3.p11.m11" class="ltx_Math" alttext="(\text{gr}_{q}(\mathcal{F}^{\bullet}),\text{gr}_{q}(\sigma))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mtext>gr</mtext><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mtext>gr</mtext><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\text{gr}_{q}(\mathcal{F}^{\bullet}),\text{gr}_{q}(\sigma))</annotation></semantics></math> is Gieseker semistable. We call the lexicographic <math id="S7.SS3.p11.m12" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.SS3.p11.m13" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> the (multi-weighted) Gieseker-Harder-Narasimhan filtration of the <math id="S7.SS3.p11.m14" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S7.SS3.p11.m15" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>. This filtration is uniquely determined up to scaling the weights by a rational tuple <math id="S7.SS3.p11.m16" class="ltx_Math" alttext="\vec{p}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>p</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{p}</annotation></semantics></math>, because of the uniqueness of the leading term HN filtration up to scaling at each step of the process.</p>
</div>
<div id="S7.SS3.p12" class="ltx_para">
<p id="S7.SS3.p12.1" class="ltx_p">This construction is recorded in the following definition.</p>
</div>
<div id="S7.Thmthm10" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm10.2" class="ltx_text ltx_font_bold">Definition 7.10</span></span><span id="S7.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm10.p1" class="ltx_para">
<p id="S7.Thmthm10.p1.1" class="ltx_p"><span id="S7.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">Suppose that the field extension <math id="S7.Thmthm10.p1.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> is algebraically closed and let <math id="S7.Thmthm10.p1.m2" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be a <math id="S7.Thmthm10.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S7.Thmthm10.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. The Gieseker-Harder-Narasimhan filtration of <math id="S7.Thmthm10.p1.m5" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> is the unique (up to scaling of the weights) lexicographic <math id="S7.Thmthm10.p1.m6" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.Thmthm10.p1.m7" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> of <math id="S7.Thmthm10.p1.m8" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> constructed above. Its Gieseker-Harder-Narasimhan associated Levi <math id="S7.Thmthm10.p1.m9" class="ltx_Math" alttext="\rho_{\vec{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><annotation encoding="application/x-tex">\rho_{\vec{\lambda}}</annotation></semantics></math>-sheaf, as described above, is Gieseker semistable.</span></p>
</div>
<div id="S7.Thmthm10.p2" class="ltx_para">
<p id="S7.Thmthm10.p2.1" class="ltx_p"><span id="S7.Thmthm10.p2.1.1" class="ltx_text ltx_font_italic">If <math id="S7.Thmthm10.p2.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> is not algebraically closed, then by uniqueness we can descend the GHN filtration of the base change to any algebraic closure of <math id="S7.Thmthm10.p2.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Therefore we obtain a unique (up to scaling the weights) lexicographic <math id="S7.Thmthm10.p2.m3" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration <math id="S7.Thmthm10.p2.m4" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math>, which we call the GHN filtration of <math id="S7.Thmthm10.p2.m5" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.Thmthm11" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm11.2" class="ltx_text ltx_font_bold">Remark 7.11</span></span><span id="S7.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm11.p1" class="ltx_para">
<p id="S7.Thmthm11.p1.1" class="ltx_p"><span id="S7.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">In particular, when the <math id="S7.Thmthm11.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S7.Thmthm11.p1.m2" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> is Gieseker semistable, the GHN filtration constructed above produces a trivial filtration as in Definition <a href="#S4.Thmthm32" title="Definition 4.32. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.32</span></a> .</span></p>
</div>
</div>
<div id="S7.Thmthm12" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm12.2" class="ltx_text ltx_font_bold">Remark 7.12</span></span><span id="S7.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm12.p1" class="ltx_para">
<p id="S7.Thmthm12.p1.1" class="ltx_p"><span id="S7.Thmthm12.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S7.Thmthm12.p1.m1" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is split then, by construction, the GHN filtration <math id="S7.Thmthm12.p1.m2" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> comes from a <math id="S7.Thmthm12.p1.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.Thmthm12.p1.m4" class="ltx_Math" alttext="(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS3.p13" class="ltx_para">
<p id="S7.SS3.p13.1" class="ltx_p">We end this subsection by explicitly describing the procedure for the construction of the GHN filtration in this case of torsion-free sheaves (as in <a href="#S4.Thmthm33" title="Example 4.33. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Example</span> <span class="ltx_text ltx_ref_tag">4.33</span></a>). Let <math id="S7.SS3.p13.m1" class="ltx_Math" alttext="0=\mathcal{F}^{\text{l-term}}_{0}\subset\mathcal{F}^{\text{l-term}}_{1}\subset\mathcal{F}^{\text{l-term}}_{2}\subset\cdots\subset\mathcal{F}^{\text{l-term}}_{j_{1}}=\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn><mtext>l-term</mtext></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext>l-term</mtext></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn><mtext>l-term</mtext></msubsup><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>j</mi><mn>1</mn></msub><mtext>l-term</mtext></msubsup><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">0=\mathcal{F}^{\text{l-term}}_{0}\subset\mathcal{F}^{\text{l-term}}_{1}\subset\mathcal{F}^{\text{l-term}}_{2}\subset\cdots\subset\mathcal{F}^{\text{l-term}}_{j_{1}}=\mathcal{F}</annotation></semantics></math>
be the unweighted leading term filtration, with leading term index <math id="S7.SS3.p13.m2" class="ltx_Math" alttext="i_{1}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>1</mn></msub><annotation encoding="application/x-tex">i_{1}</annotation></semantics></math>. By assigning weights as above, this yields the leading term HN filtration <math id="S7.SS3.p13.m3" class="ltx_math_unparsed" alttext="(\,^{(1)}\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\,^{(1)}\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> of <math id="S7.SS3.p13.m4" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>, whose associated cocharacter is <math id="S7.SS3.p13.m5" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math>. The <math id="S7.SS3.p13.m6" class="ltx_Math" alttext="1^{st}" display="inline" intent=":literal"><semantics><msup><mn>1</mn><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><annotation encoding="application/x-tex">1^{st}</annotation></semantics></math> associated graded Levi <math id="S7.SS3.p13.m7" class="ltx_Math" alttext="\rho_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\rho_{\lambda_{1}}</annotation></semantics></math>-sheaf consists of the tuple</p>
<table id="S7.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex120.m1" class="ltx_Math" alttext="\text{gr}_{1}(\mathcal{F})=\left(\mathcal{F}^{\text{l-term}}_{i}/\mathcal{F}^{\text{l-term}}_{i-1}\right)_{i=1}^{j_{1}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo>(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi><mtext>l-term</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mtext>l-term</mtext></msubsup></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>j</mi><mn>1</mn></msub></msubsup></mrow><annotation encoding="application/x-tex">\text{gr}_{1}(\mathcal{F})=\left(\mathcal{F}^{\text{l-term}}_{i}/\mathcal{F}^{\text{l-term}}_{i-1}\right)_{i=1}^{j_{1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p13.2" class="ltx_p">The leading term HN filtration of <math id="S7.SS3.p13.m8" class="ltx_Math" alttext="\text{gr}_{1}(\mathcal{F})" display="inline" intent=":literal"><semantics><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{1}(\mathcal{F})</annotation></semantics></math> is obtained by taking the leading term filtration of each element <math id="S7.SS3.p13.m9" class="ltx_Math" alttext="\mathcal{F}^{\text{l-term}}_{i}/\mathcal{F}^{\text{l-term}}_{i-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi><mtext>l-term</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mtext>l-term</mtext></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\text{l-term}}_{i}/\mathcal{F}^{\text{l-term}}_{i-1}</annotation></semantics></math> in the tuple. Each corresponding leading term index will be strictly smaller than <math id="S7.SS3.p13.m10" class="ltx_Math" alttext="i_{1}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>1</mn></msub><annotation encoding="application/x-tex">i_{1}</annotation></semantics></math>. The sheaves appearing in the leading term filtration of <math id="S7.SS3.p13.m11" class="ltx_Math" alttext="\mathcal{F}^{\text{l-term}}_{i}/\mathcal{F}^{\text{l-term}}_{i-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi><mtext>l-term</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mtext>l-term</mtext></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\text{l-term}}_{i}/\mathcal{F}^{\text{l-term}}_{i-1}</annotation></semantics></math> are of the form <math id="S7.SS3.p13.m12" class="ltx_Math" alttext="\mathcal{F}^{\text{HN}}_{h}/\mathcal{F}^{\text{l-term}}_{i-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>h</mi><mtext>HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mtext>l-term</mtext></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\text{HN}}_{h}/\mathcal{F}^{\text{l-term}}_{i-1}</annotation></semantics></math> for some index <math id="S7.SS3.p13.m13" class="ltx_Math" alttext="1\leq h\leq n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>h</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq h\leq n</annotation></semantics></math>. We denote the corresponding lexicographic <math id="S7.SS3.p13.m14" class="ltx_Math" alttext="\mathbb{Z}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{Z}^{2}</annotation></semantics></math>-filtration of <math id="S7.SS3.p13.m15" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> by <math id="S7.SS3.p13.m16" class="ltx_math_unparsed" alttext="(\,^{(2)}\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{2}}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mn>2</mn></msup></mrow></msub><annotation encoding="application/x-tex">(\,^{(2)}\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{2}}</annotation></semantics></math>. Let <math id="S7.SS3.p13.m17" class="ltx_Math" alttext="\vec{m}_{1}&gt;\vec{m}_{2}&gt;\cdots&gt;\vec{m}_{j_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mn>1</mn></msub><mo>&gt;</mo><msub><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mn>2</mn></msub><mo rspace="0.1389em">&gt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&gt;</mo><msub><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><msub><mi>j</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">\vec{m}_{1}&gt;\vec{m}_{2}&gt;\cdots&gt;\vec{m}_{j_{2}}</annotation></semantics></math> denote the jumping points of <math id="S7.SS3.p13.m18" class="ltx_math_unparsed" alttext="(\,^{(2)}\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{2}}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mn>2</mn></msup></mrow></msub><annotation encoding="application/x-tex">(\,^{(2)}\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{2}}</annotation></semantics></math>. The unweighted filtration</p>
<table id="S7.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex121.m1" class="ltx_math_unparsed" alttext="0\subset\,^{(2)}\mathcal{F}_{\vec{m}_{1}}\subset\,^{(2)}\mathcal{F}_{\vec{m}_{2}}\subset\cdots\subset\,^{(2)}\mathcal{F}_{\vec{m}_{j_{2}}}=\mathcal{F}" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo rspace="0.408em">⊂</mo><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mrow></mrow><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mn>1</mn></msub></msub><mo rspace="0.408em">⊂</mo><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mrow></mrow><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mn>2</mn></msub></msub><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em" rspace="0.408em">⊂</mo><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mrow></mrow><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><msub><mi>j</mi><mn>2</mn></msub></msub></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">0\subset\,^{(2)}\mathcal{F}_{\vec{m}_{1}}\subset\,^{(2)}\mathcal{F}_{\vec{m}_{2}}\subset\cdots\subset\,^{(2)}\mathcal{F}_{\vec{m}_{j_{2}}}=\mathcal{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p13.3" class="ltx_p">is coarser than the Gieseker-Harder-Narasimhan filtration, but finer than the leading term filtration. The reduced Hilbert polynomials of the graded pieces are strictly increasing, and each graded piece <math id="S7.SS3.p13.m19" class="ltx_Math" alttext="{}^{(2)}\mathcal{F}_{\vec{m}_{i}}/\,^{(2)}\mathcal{F}_{\vec{m}_{i-1}}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi class="ltx_font_mathcaligraphic">ℱ</mi><mprescripts></mprescripts><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mi>i</mi></msub><mrow></mrow><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mmultiscripts><msup><mo rspace="0.352em">/</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></mrow><annotation encoding="application/x-tex">{}^{(2)}\mathcal{F}_{\vec{m}_{i}}/\,^{(2)}\mathcal{F}_{\vec{m}_{i-1}}</annotation></semantics></math> is semistable up to a degree <math id="S7.SS3.p13.m20" class="ltx_Math" alttext="i_{2}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>2</mn></msub><annotation encoding="application/x-tex">i_{2}</annotation></semantics></math> in the Hilbert polynomial that is strictly smaller than the degree <math id="S7.SS3.p13.m21" class="ltx_Math" alttext="i_{1}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>1</mn></msub><annotation encoding="application/x-tex">i_{1}</annotation></semantics></math> in the previous step. The <math id="S7.SS3.p13.m22" class="ltx_Math" alttext="2^{nd}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><annotation encoding="application/x-tex">2^{nd}</annotation></semantics></math> associated graded Levi sheaf is <math id="S7.SS3.p13.m23" class="ltx_Math" alttext="\text{gr}_{2}(\mathcal{F})=\left({}^{(2)}\mathcal{F}_{\vec{m}_{i}}/\,^{(2)}\mathcal{F}_{\vec{m}_{i-1}}\right)_{i=1}^{j_{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext>gr</mtext><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo>(</mo><mrow><mmultiscripts><mi class="ltx_font_mathcaligraphic">ℱ</mi><mprescripts></mprescripts><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mi>i</mi></msub><mrow></mrow><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mmultiscripts><msup><mo rspace="0.352em">/</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>j</mi><mn>2</mn></msub></msubsup></mrow><annotation encoding="application/x-tex">\text{gr}_{2}(\mathcal{F})=\left({}^{(2)}\mathcal{F}_{\vec{m}_{i}}/\,^{(2)}\mathcal{F}_{\vec{m}_{i-1}}\right)_{i=1}^{j_{2}}</annotation></semantics></math>. We iterate this procedure, at each step we take the leading term filtration of the graded pieces.</p>
</div>
<div id="S7.SS3.p14" class="ltx_para">
<p id="S7.SS3.p14.1" class="ltx_p">Suppose that this process terminates at the <math id="S7.SS3.p14.m1" class="ltx_Math" alttext="q^{th}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">q^{th}</annotation></semantics></math> step. Let <math id="S7.SS3.p14.m2" class="ltx_math_unparsed" alttext="(\,^{(q)}\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\,^{(q)}\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> be the GHN filtration obtained at this <math id="S7.SS3.p14.m3" class="ltx_Math" alttext="q^{th}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">q^{th}</annotation></semantics></math> step. Denote by <math id="S7.SS3.p14.m4" class="ltx_Math" alttext="\vec{m}_{1}&gt;\vec{m}_{2}&gt;\cdots&gt;\vec{m}_{j_{q}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mn>1</mn></msub><mo>&gt;</mo><msub><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mn>2</mn></msub><mo rspace="0.1389em">&gt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&gt;</mo><msub><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><msub><mi>j</mi><mi>q</mi></msub></msub></mrow><annotation encoding="application/x-tex">\vec{m}_{1}&gt;\vec{m}_{2}&gt;\cdots&gt;\vec{m}_{j_{q}}</annotation></semantics></math> the jumping points of the GHN filtration. Consider the unweighted filtration</p>
<table id="S7.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(22)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E22.m1" class="ltx_math_unparsed" alttext="0\subset\,^{(q)}\mathcal{F}_{\vec{m}_{1}}\subset\,^{(q)}\mathcal{F}_{\vec{m}_{2}}\subset\cdots\subset\,^{(q)}\mathcal{F}_{\vec{m}_{j_{q}}}=\mathcal{F}." display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo rspace="0.408em">⊂</mo><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mrow></mrow><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mn>1</mn></msub></msub><mo rspace="0.408em">⊂</mo><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mrow></mrow><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mn>2</mn></msub></msub><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em" rspace="0.408em">⊂</mo><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mrow></mrow><msub><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><msub><mi>j</mi><mi>q</mi></msub></msub></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\subset\,^{(q)}\mathcal{F}_{\vec{m}_{1}}\subset\,^{(q)}\mathcal{F}_{\vec{m}_{2}}\subset\cdots\subset\,^{(q)}\mathcal{F}_{\vec{m}_{j_{q}}}=\mathcal{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p14.2" class="ltx_p">The reduced Hilbert polynomials of the graded pieces of this filtration are strictly increasing by construction. Moreover, each graded piece must be Gieseker semistable, because the <math id="S7.SS3.p14.m5" class="ltx_Math" alttext="q^{th}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">q^{th}</annotation></semantics></math> step is the last one of the procedure. Hence, this filtration is the classical Gieseker-Harder-Narasimhan filtration of <math id="S7.SS3.p14.m6" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>. The associated <math id="S7.SS3.p14.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weights in the GHN filtration encode information about how high the degree of the difference of reduced Hilbert polynomials is between two consecutive graded pieces.</p>
</div>
<div id="S7.SS3.p15" class="ltx_para">
<p id="S7.SS3.p15.1" class="ltx_p">We have therefore shown the following.</p>
</div>
<div id="S7.Thmthm13" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm13.2" class="ltx_text ltx_font_bold">Proposition 7.13</span></span><span id="S7.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm13.p1" class="ltx_para">
<p id="S7.Thmthm13.p1.1" class="ltx_p"><span id="S7.Thmthm13.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmthm13.p1.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> be a torsion-free sheaf. Let <math id="S7.Thmthm13.p1.m2" class="ltx_math_unparsed" alttext="(\,^{(q)}\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><msup><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\,^{(q)}\mathcal{F}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> be the GHN filtration. The corresponding unweighted filtration (<a href="#S7.E22" title="Equation 22 ‣ 7.3. The GHN filtration for 
          
            ρ
          
        -sheaves ‣ 7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) coincides with the classical Gieseker-Harder-Narasimhan filtration of <math id="S7.Thmthm13.p1.m3" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>. ∎</span></p>
</div>
</div>
</section>
<section id="S7.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.4. </span>Example of Gieseker-Harder-Narasimhan filtration</h3>

<div id="S7.SS4.p1" class="ltx_para">
<p id="S7.SS4.p1.1" class="ltx_p">We compare the different filtrations that we have
considered in an example. Let <math id="S7.SS4.p1.m1" class="ltx_Math" alttext="G=\SO(7)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G=\SO(7)</annotation></semantics></math> and let <math id="S7.SS4.p1.m2" class="ltx_Math" alttext="\rho:\SO(7)\to\GL(7)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:\SO(7)\to\GL(7)</annotation></semantics></math> be
the standard representation. Set <math id="S7.SS4.p1.m3" class="ltx_Math" alttext="X=\mathbb{P}^{3}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><msup><mi>ℙ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">X=\mathbb{P}^{3}</annotation></semantics></math>,
and let <math id="S7.SS4.p1.m4" class="ltx_Math" alttext="L\cong\mathbb{P}^{1}\subset\mathbb{P}^{3}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>≅</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo>⊂</mo><msup><mi>ℙ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">L\cong\mathbb{P}^{1}\subset\mathbb{P}^{3}</annotation></semantics></math> be a fixed line. Choose
two different points <math id="S7.SS4.p1.m5" class="ltx_Math" alttext="Z=\{p,p^{\prime}\}\subset\mathbb{P}^{3}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>=</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mi>p</mi><mo>,</mo><msup><mi>p</mi><mo>′</mo></msup><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow><mo>⊂</mo><msup><mi>ℙ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">Z=\{p,p^{\prime}\}\subset\mathbb{P}^{3}</annotation></semantics></math>. We denote by <math id="S7.SS4.p1.m6" class="ltx_Math" alttext="\mathcal{I}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\mathcal{I}_{L}</annotation></semantics></math> the ideal
sheaf of <math id="S7.SS4.p1.m7" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, <math id="S7.SS4.p1.m8" class="ltx_Math" alttext="\mathcal{I}_{p}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>p</mi></msub><annotation encoding="application/x-tex">\mathcal{I}_{p}</annotation></semantics></math> the ideal sheaf of <math id="S7.SS4.p1.m9" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, and
<math id="S7.SS4.p1.m10" class="ltx_Math" alttext="\mathcal{I}_{Z}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>Z</mi></msub><annotation encoding="application/x-tex">\mathcal{I}_{Z}</annotation></semantics></math> the ideal sheaf of <math id="S7.SS4.p1.m11" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>. Set</p>
<table id="S7.Ex122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex122.m1" class="ltx_Math" alttext="\mathcal{F}=\mathcal{I}_{L}\oplus\mathcal{I}_{Z}\oplus\mathcal{I}_{p}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>L</mi></msub><mo>⊕</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>Z</mi></msub><mo>⊕</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>p</mi></msub><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{F}=\mathcal{I}_{L}\oplus\mathcal{I}_{Z}\oplus\mathcal{I}_{p}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS4.p1.2" class="ltx_p">Let <math id="S7.SS4.p1.m12" class="ltx_Math" alttext="\varphi:\mathcal{F}\otimes\mathcal{F}\to\mathcal{O}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow></mrow><annotation encoding="application/x-tex">\varphi:\mathcal{F}\otimes\mathcal{F}\to\mathcal{O}</annotation></semantics></math> be the symmetric
bilinear form defined by the matrix with <math id="S7.SS4.p1.m13" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>’s in the antidiagonal and zeros everywhere else.
Set <math id="S7.SS4.p1.m14" class="ltx_Math" alttext="U=\mathbb{P}^{3}\setminus(L\cup Z)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mrow><msup><mi>ℙ</mi><mn>3</mn></msup><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>∪</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U=\mathbb{P}^{3}\setminus(L\cup Z)</annotation></semantics></math>. The sheaf <math id="S7.SS4.p1.m15" class="ltx_Math" alttext="\mathcal{F}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{F}|_{U}</annotation></semantics></math> is locally free, and in fact trivial.
Let <math id="S7.SS4.p1.m16" class="ltx_Math" alttext="\varphi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>φ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\varphi^{\prime}</annotation></semantics></math> be the canonical trivialization of <math id="S7.SS4.p1.m17" class="ltx_Math" alttext="\det\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">det</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">\det\mathcal{F}</annotation></semantics></math>. Clearly <math id="S7.SS4.p1.m18" class="ltx_math_unparsed" alttext="\det\varphi=\varphi^{\prime}{}^{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">det</mo><mi>φ</mi><mo>=</mo><mi>φ</mi><msup><mrow></mrow><mo>′</mo></msup><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\det\varphi=\varphi^{\prime}{}^{2}</annotation></semantics></math>,
hence the pair <math id="S7.SS4.p1.m19" class="ltx_Math" alttext="(\varphi,\varphi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>φ</mi><mo>,</mo><msup><mi>φ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\varphi,\varphi^{\prime})</annotation></semantics></math> induces a reduction of the trivial <math id="S7.SS4.p1.m20" class="ltx_Math" alttext="\GL(7)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(7)</annotation></semantics></math>-bundle
to <math id="S7.SS4.p1.m21" class="ltx_Math" alttext="\SO(7)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\SO(7)</annotation></semantics></math>.
The rational <math id="S7.SS4.p1.m22" class="ltx_Math" alttext="\SO(7)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\SO(7)</annotation></semantics></math>-bundle
<math id="S7.SS4.p1.m23" class="ltx_Math" alttext="\mathcal{G}\to U" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">→</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">\mathcal{G}\to U</annotation></semantics></math>
which it defines is trivial. Let <math id="S7.SS4.p1.m24" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> denote the canonical isomorphism between
<math id="S7.SS4.p1.m25" class="ltx_Math" alttext="\rho_{*}(\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{*}(\mathcal{G})</annotation></semantics></math> and <math id="S7.SS4.p1.m26" class="ltx_Math" alttext="\mathcal{F}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{F}|_{U}</annotation></semantics></math>.</p>
</div>
<div id="S7.SS4.p2" class="ltx_para">
<p id="S7.SS4.p2.1" class="ltx_p">The principal <math id="S7.SS4.p2.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf
<math id="S7.SS4.p2.m2" class="ltx_Math" alttext="(\mathcal{G},\mathcal{F},\psi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{G},\mathcal{F},\psi)</annotation></semantics></math> is slope semistable
(Definition <a href="#S6.Thmthm9" title="Definition 6.9. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.9</span></a>). The rational principal
<math id="S7.SS4.p2.m3" class="ltx_Math" alttext="\SO(7)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\SO(7)</annotation></semantics></math>-bundle <math id="S7.SS4.p2.m4" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is trivial, hence also slope semistable
(Definition <a href="#S6.Thmthm5" title="Definition 6.5 ([]). ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.5</span></a>). Hence the
Harder-Narasimhan canonical reduction defined in
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AAB02</a>]</cite> is trivial.</p>
</div>
<div id="S7.SS4.p3" class="ltx_para">
<p id="S7.SS4.p3.1" class="ltx_p">The Hilbert polynomials are</p>
<table id="S7.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex123.m1" class="ltx_Math" alttext="\displaystyle P_{\mathcal{O}}(n)=\frac{1}{6}(n^{3}+6n^{2}+10n+3)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>n</mi><mn>3</mn></msup><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{\mathcal{O}}(n)=\frac{1}{6}(n^{3}+6n^{2}+10n+3)</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex123.m2" class="ltx_Math" alttext="\displaystyle P_{\mathcal{I}_{p}}(n)=\frac{1}{6}(n^{3}+6n^{2}+10n-3)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>p</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>n</mi><mn>3</mn></msup><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{\mathcal{I}_{p}}(n)=\frac{1}{6}(n^{3}+6n^{2}+10n-3)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex124.m1" class="ltx_Math" alttext="\displaystyle P_{\mathcal{I}_{Z}}(n)=\frac{1}{6}(n^{3}+6n^{2}+10n-9)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>Z</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>n</mi><mn>3</mn></msup><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><mn>9</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{\mathcal{I}_{Z}}(n)=\frac{1}{6}(n^{3}+6n^{2}+10n-9)</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex124.m2" class="ltx_Math" alttext="\displaystyle P_{\mathcal{I}_{L}}(n)=\frac{1}{6}(n^{3}+6n^{2}-\;6n-3)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>L</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>n</mi><mn>3</mn></msup><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mn> 6</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{\mathcal{I}_{L}}(n)=\frac{1}{6}(n^{3}+6n^{2}-\;6n-3)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS4.p3.2" class="ltx_p">Note that the three first polynomials only differ in the last term, and
the last polynomial differs in the last two terms.</p>
</div>
<div id="S7.SS4.p4" class="ltx_para">
<p id="S7.SS4.p4.1" class="ltx_p">The principal <math id="S7.SS4.p4.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf
<math id="S7.SS4.p4.m2" class="ltx_Math" alttext="(\mathcal{G},\mathcal{F},\psi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{G},\mathcal{F},\psi)</annotation></semantics></math> is Gieseker unstable
(Definition <a href="#S6.Thmthm4" title="Definition 6.4. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a>).
We will now calculate the leading term HN filtration. We work in the standard basis where the bilinear form is given by the matrix above. We will use cocharacters
of <math id="S7.SS4.p4.m3" class="ltx_Math" alttext="\SO(7)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\SO(7)</annotation></semantics></math> of the form</p>
<table id="S7.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex125.m1" class="ltx_Math" alttext="\operatorname{diag}\operatorname{(}t^{a},t^{b},t^{c},1,t^{-c},t^{-b},t^{-a})" display="block" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mi>diag</mi><mo lspace="0.167em">⁡</mo><mrow><mi>(</mi><mo lspace="0.167em">⁡</mo><msup><mi>t</mi><mi>a</mi></msup></mrow></mrow><mo>,</mo><msup><mi>t</mi><mi>b</mi></msup><mo>,</mo><msup><mi>t</mi><mi>c</mi></msup><mo>,</mo><mn>1</mn><mo>,</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>c</mi></mrow></msup><mo>,</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>b</mi></mrow></msup><mo>,</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>a</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\operatorname{diag}\operatorname{(}t^{a},t^{b},t^{c},1,t^{-c},t^{-b},t^{-a})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS4.p4.2" class="ltx_p">with <math id="S7.SS4.p4.m4" class="ltx_Math" alttext="a\geq b\geq c\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≥</mo><mi>b</mi><mo>≥</mo><mi>c</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a\geq b\geq c\geq 0</annotation></semantics></math>. The associated
filtration <math id="S7.SS4.p4.m5" class="ltx_Math" alttext="\mathcal{F}_{m}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{m}</annotation></semantics></math> satisfies
<math id="S7.SS4.p4.m6" class="ltx_Math" alttext="\mathcal{F}_{m}^{\perp}=\mathcal{F}_{-m+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>⟂</mo></msubsup><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{m}^{\perp}=\mathcal{F}_{-m+1}</annotation></semantics></math>, where we recall that
<math id="S7.SS4.p4.m7" class="ltx_math_unparsed" alttext="\mathcal{F}_{i}{}^{\perp}:=\ker\big(\mathcal{F}\stackrel{{\scriptstyle\varphi}}{{\longrightarrow}}\mathcal{F}^{\vee}\longrightarrow\mathcal{F}_{i}{}^{\vee}\big)." display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mmultiscripts><mo>:=</mo><mprescripts></mprescripts><mrow></mrow><mo>⟂</mo></mmultiscripts><mi>ker</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover><mo stretchy="false">⟶</mo><mi>φ</mi></mover><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup><mo stretchy="false">⟶</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mmultiscripts><mo maxsize="1.200em" minsize="1.200em">)</mo><mprescripts></mprescripts><mrow></mrow><mo>∨</mo></mmultiscripts></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{F}_{i}{}^{\perp}:=\ker\big(\mathcal{F}\stackrel{{\scriptstyle\varphi}}{{\longrightarrow}}\mathcal{F}^{\vee}\longrightarrow\mathcal{F}_{i}{}^{\vee}\big).</annotation></semantics></math> The leading term HN
filtration is</p>
<table id="S7.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex126.m1" class="ltx_Math" alttext="\overbrace{\mathcal{F}}^{\mathcal{F}_{-1}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{I}_{Z}\oplus\mathcal{I}_{p}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}_{0}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}}^{\mathcal{F}_{1}}" display="block" intent=":literal"><semantics><mrow><mover><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msub></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>Z</mi></msub><mo>⊕</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>p</mi></msub><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msub></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub></mover></mrow><annotation encoding="application/x-tex">\overbrace{\mathcal{F}}^{\mathcal{F}_{-1}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{I}_{Z}\oplus\mathcal{I}_{p}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}_{0}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}}^{\mathcal{F}_{1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS4.p4.3" class="ltx_p">where <math id="S7.SS4.p4.m8" class="ltx_Math" alttext="\mathcal{F}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{F}_{1}</annotation></semantics></math> is the last summand in <math id="S7.SS4.p4.m9" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>,
and <math id="S7.SS4.p4.m10" class="ltx_Math" alttext="\mathcal{F}_{1}^{\perp}=\mathcal{F}_{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mo>⟂</mo></msubsup><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{1}^{\perp}=\mathcal{F}_{0}</annotation></semantics></math>.
By definition of leading term HN filtration, this is the unique
filtration, with <math id="S7.SS4.p4.m11" class="ltx_Math" alttext="\mathcal{F}_{m}^{\perp}=\mathcal{F}_{-m+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>⟂</mo></msubsup><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{m}^{\perp}=\mathcal{F}_{-m+1}</annotation></semantics></math>, which
gives a maximum of the numerical function (<a href="#S4.E3" title="Equation 3 ‣ Proposition 4.4. ‣ 4.1. The numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>).</p>
</div>
<div id="S7.SS4.p5" class="ltx_para">
<p id="S7.SS4.p5.1" class="ltx_p">This filtration has been obtained by the cocharacter
<math id="S7.SS4.p5.m1" class="ltx_Math" alttext="\lambda_{1}=\operatorname{diag}(t,1,1,1,1,1,t^{-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{1}=\operatorname{diag}(t,1,1,1,1,1,t^{-1})</annotation></semantics></math>. The associated
Levi is <math id="S7.SS4.p5.m2" class="ltx_Math" alttext="L_{\lambda_{1}}=\mathbb{G}_{m}\times\SO(5)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo>=</mo><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{\lambda_{1}}=\mathbb{G}_{m}\times\SO(5)</annotation></semantics></math>,
the representation <math id="S7.SS4.p5.m3" class="ltx_Math" alttext="\rho_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\rho_{\lambda_{1}}</annotation></semantics></math> is</p>
<table id="S7.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex127.m1" class="ltx_Math" alttext="\rho_{\lambda_{1}}:\mathbb{G}_{m}\times\SO(5)\longrightarrow\GL(1)\times\GL(5)\times\GL(1),\;\;(t,g)\mapsto(t,g,t^{-1})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟶</mo><mrow><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="0.607em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>g</mi><mo>,</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{\lambda_{1}}:\mathbb{G}_{m}\times\SO(5)\longrightarrow\GL(1)\times\GL(5)\times\GL(1),\;\;(t,g)\mapsto(t,g,t^{-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS4.p5.2" class="ltx_p">and the associated graded
sheaf is</p>
<table id="S7.Ex128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex128.m1" class="ltx_math_unparsed" alttext="\overbrace{\mathcal{I}_{L}}^{\mathcal{F}^{-1}:=\mathcal{F}_{-1}/\mathcal{F}_{0}}\hskip 10.00002pt\oplus\hskip 10.00002pt\overbrace{\mathcal{I}_{Z}\oplus\mathcal{I}_{p}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}^{0}:=\mathcal{F}_{0}/\mathcal{F}_{1}}\hskip 10.00002pt\oplus\hskip 10.00002pt\overbrace{\mathcal{O}}^{\mathcal{F}^{1}:=\mathcal{F}_{1}}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>L</mi></msub><mo stretchy="true">⏞</mo></mover><msup><mrow></mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>:=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msub></mrow></mrow></msup><mo>⊕</mo><mover accent="true"><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>Z</mi></msub><mo>⊕</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>p</mi></msub><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow><mo stretchy="true">⏞</mo></mover><msup><mrow></mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msup><mo>:=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub></mrow></mrow></msup><mo>⊕</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="true">⏞</mo></mover><msup><mrow></mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msup><mo>:=</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overbrace{\mathcal{I}_{L}}^{\mathcal{F}^{-1}:=\mathcal{F}_{-1}/\mathcal{F}_{0}}\hskip 10.00002pt\oplus\hskip 10.00002pt\overbrace{\mathcal{I}_{Z}\oplus\mathcal{I}_{p}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}^{0}:=\mathcal{F}_{0}/\mathcal{F}_{1}}\hskip 10.00002pt\oplus\hskip 10.00002pt\overbrace{\mathcal{O}}^{\mathcal{F}^{1}:=\mathcal{F}_{1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS4.p5.3" class="ltx_p">The <math id="S7.SS4.p5.m4" class="ltx_Math" alttext="\SO(5)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\SO(5)</annotation></semantics></math>-sheaf defined by <math id="S7.SS4.p5.m5" class="ltx_Math" alttext="\mathcal{F}^{0}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\mathcal{F}^{0}</annotation></semantics></math> is not Gieseker stable.
Its leading term HN filtration is given by the cocharacter
<math id="S7.SS4.p5.m6" class="ltx_Math" alttext="\lambda_{2}=\operatorname{diag}(t^{2},t,1,t^{-1},t^{-2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>2</mn></msub><mo>=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mn>2</mn></msup><mo>,</mo><mi>t</mi><mo>,</mo><mn>1</mn><mo>,</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{2}=\operatorname{diag}(t^{2},t,1,t^{-1},t^{-2})</annotation></semantics></math> and it is</p>
<table id="S7.EGx14" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S7.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex129.m1" class="ltx_Math" alttext="\displaystyle\overbrace{\mathcal{F}^{0}}^{\mathcal{F}^{0}_{-2}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{I}_{p}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}^{0}_{-1}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}^{0}_{0}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}^{0}_{1}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}}^{\mathcal{F}^{0}_{2}}" display="block" intent=":literal"><semantics><mrow><mover><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msup><mo stretchy="true">⏞</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo>−</mo><mn>2</mn></mrow><mn>0</mn></msubsup></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>p</mi></msub><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow><mo stretchy="true">⏞</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo>−</mo><mn>1</mn></mrow><mn>0</mn></msubsup></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow><mo stretchy="true">⏞</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn><mn>0</mn></msubsup></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow><mo stretchy="true">⏞</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mn>0</mn></msubsup></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="true">⏞</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn><mn>0</mn></msubsup></mover></mrow><annotation encoding="application/x-tex">\displaystyle\overbrace{\mathcal{F}^{0}}^{\mathcal{F}^{0}_{-2}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{I}_{p}\oplus\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}^{0}_{-1}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}\oplus\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}^{0}_{0}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}\oplus\mathcal{O}}^{\mathcal{F}^{0}_{1}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}}^{\mathcal{F}^{0}_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S7.SS4.p6" class="ltx_para">
<p id="S7.SS4.p6.1" class="ltx_p">Finally, the (multi-weighted) Gieseker-Harder-Narasimhan filtration is</p>
<table id="S7.EGx15" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S7.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex130.m1" class="ltx_Math" alttext="\displaystyle\overbrace{\mathcal{F}}^{\mathcal{F}_{(-1,0)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{I}_{Z}\oplus\mathcal{I}_{p}\oplus\mathcal{O}^{\oplus 4}}^{\mathcal{F}_{(0,-2)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{I}_{p}\oplus\mathcal{O}^{\oplus 4}}^{\mathcal{F}_{(0,-1)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}^{\oplus 4}}^{\mathcal{F}_{(0,0)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}^{\oplus 3}}^{\mathcal{F}_{(0,1)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}^{\oplus 2}}^{\mathcal{F}_{(0,2)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}}^{\mathcal{F}_{(1,0)}}" display="block" intent=":literal"><semantics><mrow><mover><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>Z</mi></msub><mo>⊕</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>p</mi></msub><mo>⊕</mo><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>⊕</mo><mn>4</mn></mrow></msup></mrow><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo rspace="0em">,</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></msub></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>p</mi></msub><mo>⊕</mo><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>⊕</mo><mn>4</mn></mrow></msup></mrow><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo rspace="0em">,</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>⊕</mo><mn>4</mn></mrow></msup><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>⊕</mo><mn>3</mn></mrow></msup><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>⊕</mo><mn>2</mn></mrow></msup><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msub></mover><mspace style="width:1em;" width="1em"></mspace><mo>⊃</mo><mspace style="width:1em;" width="1em"></mspace><mover><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="true">⏞</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub></mover></mrow><annotation encoding="application/x-tex">\displaystyle\overbrace{\mathcal{F}}^{\mathcal{F}_{(-1,0)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{I}_{Z}\oplus\mathcal{I}_{p}\oplus\mathcal{O}^{\oplus 4}}^{\mathcal{F}_{(0,-2)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{I}_{p}\oplus\mathcal{O}^{\oplus 4}}^{\mathcal{F}_{(0,-1)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}^{\oplus 4}}^{\mathcal{F}_{(0,0)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}^{\oplus 3}}^{\mathcal{F}_{(0,1)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}^{\oplus 2}}^{\mathcal{F}_{(0,2)}}\hskip 10.00002pt\supset\hskip 10.00002pt\overbrace{\mathcal{O}}^{\mathcal{F}_{(1,0)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS4.p6.2" class="ltx_p">The process stops here because the associated Levi principal sheaf is Gieseker semistable. Indeed, the Levi is
<math id="S7.SS4.p6.m1" class="ltx_Math" alttext="L_{\lambda_{2}}=\mathbb{G}_{m}\times(\mathbb{G}_{m}\times\mathbb{G}_{m})\subset\mathbb{G}_{m}\times\SO(5)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><msub><mi>λ</mi><mn>2</mn></msub></msub><mo>=</mo><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mi mathsize="0.800em">SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{\lambda_{2}}=\mathbb{G}_{m}\times(\mathbb{G}_{m}\times\mathbb{G}_{m})\subset\mathbb{G}_{m}\times\SO(5)</annotation></semantics></math>, the representation is</p>
<table id="S7.Ex131" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex131.m1" class="ltx_Math" alttext="\rho_{\lambda_{2}}:\mathbb{G}_{m}\times(\mathbb{G}_{m}\times\mathbb{G}_{m})\longrightarrow\GL(1)^{\times 7},\;\;\;(a,b,c)\mapsto(a,b,c,1,c^{-1},b^{-1},a^{-1})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><msub><mi>λ</mi><mn>2</mn></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mn>7</mn></mrow></msup></mrow></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mn>1</mn><mo>,</mo><msup><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>b</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{\lambda_{2}}:\mathbb{G}_{m}\times(\mathbb{G}_{m}\times\mathbb{G}_{m})\longrightarrow\GL(1)^{\times 7},\;\;\;(a,b,c)\mapsto(a,b,c,1,c^{-1},b^{-1},a^{-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS4.p6.3" class="ltx_p">and the associated graded is isomorphic to <math id="S7.SS4.p6.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S7.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.5. </span>The GHN filtration in families</h3>

<div id="S7.SS5.p1" class="ltx_para">
<p id="S7.SS5.p1.1" class="ltx_p">In this subsection we define a notion of relative GHN filtrations. We prove that relative GHN filtrations induce a stratification of <math id="S7.SS5.p1.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> by locally closed substacks.</p>
</div>
<div id="S7.SS5.p2" class="ltx_para">
<p id="S7.SS5.p2.1" class="ltx_p">Let <math id="S7.SS5.p2.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="S7.SS5.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme. Let <math id="S7.SS5.p2.m3" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be a <math id="S7.SS5.p2.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S7.SS5.p2.m5" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm14" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm14.2" class="ltx_text ltx_font_bold">Definition 7.14</span></span><span id="S7.Thmthm14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm14.p1" class="ltx_para">
<p id="S7.Thmthm14.p1.1" class="ltx_p"><span id="S7.Thmthm14.p1.1.1" class="ltx_text ltx_font_italic">A relative lexicographic <math id="S7.Thmthm14.p1.m1" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration of the underlying tuple of sheaves <math id="S7.Thmthm14.p1.m2" class="ltx_Math" alttext="\mathcal{F}^{\bullet}=(\mathcal{F}_{i})_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}=(\mathcal{F}_{i})_{i=1}^{b}</annotation></semantics></math> is a sequence of tuples of subsheaves <math id="S7.Thmthm14.p1.m3" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> satisfying the following conditions</span></p>
<ol id="S7.I2" class="ltx_enumerate">
<li id="S7.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I2.i1.p1" class="ltx_para">
<p id="S7.I2.i1.p1.1" class="ltx_p"><math id="S7.I2.i1.p1.m1" class="ltx_Math" alttext="\mathcal{F}^{\bullet}_{\vec{m}}\subset\mathcal{F}^{\bullet}_{\vec{n}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>n</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}_{\vec{m}}\subset\mathcal{F}^{\bullet}_{\vec{n}}</annotation></semantics></math><span id="S7.I2.i1.p1.1.1" class="ltx_text ltx_font_italic"> whenever </span><math id="S7.I2.i1.p1.m2" class="ltx_Math" alttext="\vec{m}&gt;\vec{n}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>&gt;</mo><mover accent="true"><mi>n</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><annotation encoding="application/x-tex">\vec{m}&gt;\vec{n}</annotation></semantics></math><span id="S7.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S7.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I2.i2.p1" class="ltx_para">
<p id="S7.I2.i2.p1.1" class="ltx_p"><span id="S7.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">There exists some </span><math id="S7.I2.i2.p1.m1" class="ltx_Math" alttext="M_{max}\in\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">M_{max}\in\mathbb{Z}^{q}</annotation></semantics></math><span id="S7.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> such that </span><math id="S7.I2.i2.p1.m2" class="ltx_Math" alttext="\mathcal{F}^{\bullet}_{\vec{m}}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}_{\vec{m}}=0</annotation></semantics></math><span id="S7.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> for all </span><math id="S7.I2.i2.p1.m3" class="ltx_Math" alttext="\vec{m}&gt;M_{max}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>&gt;</mo><msub><mi>M</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\vec{m}&gt;M_{max}</annotation></semantics></math><span id="S7.I2.i2.p1.1.4" class="ltx_text ltx_font_italic">. Similarly, there exists some </span><math id="S7.I2.i2.p1.m4" class="ltx_Math" alttext="M_{min}\in\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">M_{min}\in\mathbb{Z}^{q}</annotation></semantics></math><span id="S7.I2.i2.p1.1.5" class="ltx_text ltx_font_italic"> such that </span><math id="S7.I2.i2.p1.m5" class="ltx_Math" alttext="\mathcal{F}^{\bullet}_{\vec{m}}=\mathcal{F}^{\bullet}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}_{\vec{m}}=\mathcal{F}^{\bullet}</annotation></semantics></math><span id="S7.I2.i2.p1.1.6" class="ltx_text ltx_font_italic"> for all </span><math id="S7.I2.i2.p1.m6" class="ltx_Math" alttext="\vec{m}&lt;M_{min}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>&lt;</mo><msub><mi>M</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\vec{m}&lt;M_{min}</annotation></semantics></math><span id="S7.I2.i2.p1.1.7" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S7.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S7.I2.i3.p1" class="ltx_para">
<p id="S7.I2.i3.p1.1" class="ltx_p"><span id="S7.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">For all </span><math id="S7.I2.i3.p1.m1" class="ltx_Math" alttext="\vec{m}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>m</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{m}</annotation></semantics></math><span id="S7.I2.i3.p1.1.2" class="ltx_text ltx_font_italic">, we have that </span><math id="S7.I2.i3.p1.m2" class="ltx_Math" alttext="\mathcal{F}^{\bullet}_{\vec{m}}/\mathcal{F}^{\bullet}_{\vec{m}+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>+</mo><mn>1</mn></mrow><mo>∙</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}_{\vec{m}}/\mathcal{F}^{\bullet}_{\vec{m}+1}</annotation></semantics></math><span id="S7.I2.i3.p1.1.3" class="ltx_text ltx_font_italic"> is a tuple of families of torsion-free sheaves on </span><math id="S7.I2.i3.p1.m3" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math><span id="S7.I2.i3.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S7.SS5.p3" class="ltx_para">
<p id="S7.SS5.p3.1" class="ltx_p">For any such filtration <math id="S7.SS5.p3.m1" class="ltx_Math" alttext="f=(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">f=(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math>, we can apply the multi-graded Rees construction in order to obtain a tuple <math id="S7.SS5.p3.m2" class="ltx_Math" alttext="\widetilde{\mathcal{F}^{\bullet}}_{f}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}^{\bullet}}_{f}</annotation></semantics></math> of families of torsion-free sheaves on <math id="S7.SS5.p3.m3" class="ltx_Math" alttext="\Theta^{q}\times X_{S}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Θ</mi><mi>q</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>X</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">\Theta^{q}\times X_{S}</annotation></semantics></math>. Let <math id="S7.SS5.p3.m4" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be a big open subset of <math id="S7.SS5.p3.m5" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math> where the associated graded <math id="S7.SS5.p3.m6" class="ltx_Math" alttext="\text{gr}(f)" display="inline" intent=":literal"><semantics><mrow><mtext>gr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{gr}(f)</annotation></semantics></math> is locally-free. One can use <math id="S7.SS5.p3.m7" class="ltx_Math" alttext="\mathbb{G}_{m}^{q}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔾</mi><mi>m</mi><mi>q</mi></msubsup><annotation encoding="application/x-tex">\mathbb{G}_{m}^{q}</annotation></semantics></math>-equivariance to conclude that the restriction <math id="S7.SS5.p3.m8" class="ltx_Math" alttext="(\widetilde{\mathcal{F}^{\bullet}}_{f})|_{\Theta^{q}\times U}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mrow><msup><mi mathvariant="normal">Θ</mi><mi>q</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow></msub><annotation encoding="application/x-tex">(\widetilde{\mathcal{F}^{\bullet}}_{f})|_{\Theta^{q}\times U}</annotation></semantics></math> is locally-free. In particular, it can be viewed as a <math id="S7.SS5.p3.m9" class="ltx_Math" alttext="\GL(V^{\bullet})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>∙</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V^{\bullet})</annotation></semantics></math>-bundle. The section <math id="S7.SS5.p3.m10" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> gives a <math id="S7.SS5.p3.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reduction of structure group of <math id="S7.SS5.p3.m12" class="ltx_Math" alttext="(\widetilde{\mathcal{F}^{\bullet}}_{f})|_{\vec{1}\times U}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo mathsize="0.800em">~</mo></mover><mi>f</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mrow><mover accent="true"><mn>1</mn><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow></msub><annotation encoding="application/x-tex">(\widetilde{\mathcal{F}^{\bullet}}_{f})|_{\vec{1}\times U}</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm15" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm15.2" class="ltx_text ltx_font_bold">Definition 7.15</span></span><span id="S7.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm15.p1" class="ltx_para">
<p id="S7.Thmthm15.p1.1" class="ltx_p"><span id="S7.Thmthm15.p1.1.1" class="ltx_text ltx_font_italic">We say that <math id="S7.Thmthm15.p1.m1" class="ltx_Math" alttext="f=(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">f=(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> is a relative lexicographic <math id="S7.Thmthm15.p1.m2" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration of the <math id="S7.Thmthm15.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S7.Thmthm15.p1.m4" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> if the <math id="S7.Thmthm15.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reduction induced by <math id="S7.Thmthm15.p1.m6" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> extends (uniquely) to <math id="S7.Thmthm15.p1.m7" class="ltx_Math" alttext="\Theta_{k}^{q}\times U" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Θ</mi><mi>k</mi><mi>q</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">\Theta_{k}^{q}\times U</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS5.p4" class="ltx_para">
<p id="S7.SS5.p4.1" class="ltx_p">We can also define relative <math id="S7.SS5.p4.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted reductions for <math id="S7.SS5.p4.m2" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> in a similar way as in the case when <math id="S7.SS5.p4.m3" class="ltx_Math" alttext="S=\Spec(K)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S=\Spec(K)</annotation></semantics></math>. One can say as well when a relative lexicographic <math id="S7.SS5.p4.m4" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration of <math id="S7.SS5.p4.m5" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> comes from a <math id="S7.SS5.p4.m6" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-weighted parabolic reduction <math id="S7.SS5.p4.m7" class="ltx_Math" alttext="(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>λ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mover accent="true"><mi>λ</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\vec{\lambda},\mathcal{G}_{\vec{\lambda}})</annotation></semantics></math>, we omit the details.</p>
</div>
<div id="S7.Thmthm16" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm16.2" class="ltx_text ltx_font_bold">Definition 7.16</span></span><span id="S7.Thmthm16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm16.p1" class="ltx_para">
<p id="S7.Thmthm16.p1.1" class="ltx_p"><span id="S7.Thmthm16.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmthm16.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and <math id="S7.Thmthm16.p1.m2" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be as above and let <math id="S7.Thmthm16.p1.m3" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> be a lexicographic <math id="S7.Thmthm16.p1.m4" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration of <math id="S7.Thmthm16.p1.m5" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>, where we might allow a different choice of <math id="S7.Thmthm16.p1.m6" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> over each connected component of <math id="S7.Thmthm16.p1.m7" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. We say that <math id="S7.Thmthm16.p1.m8" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> is a GHN filtration for <math id="S7.Thmthm16.p1.m9" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> if for all points <math id="S7.Thmthm16.p1.m10" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math> the restriction <math id="S7.Thmthm16.p1.m11" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}}|_{X_{s}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}}|_{X_{s}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> is the GHN filtration of <math id="S7.Thmthm16.p1.m12" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.Thmthm17" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm17.2" class="ltx_text ltx_font_bold">Definition 7.17</span></span><span id="S7.Thmthm17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm17.p1" class="ltx_para">
<p id="S7.Thmthm17.p1.1" class="ltx_p"><span id="S7.Thmthm17.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmthm17.p1.m1" class="ltx_Math" alttext="H\rightarrow S" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">H\rightarrow S</annotation></semantics></math> be a locally closed stratification of <math id="S7.Thmthm17.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. We say that the <math id="S7.Thmthm17.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-scheme <math id="S7.Thmthm17.p1.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is universal for GHN filtrations of <math id="S7.Thmthm17.p1.m5" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> if it represents the functor that classifies pairs <math id="S7.Thmthm17.p1.m6" class="ltx_Math" alttext="\left(T,\left[(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}]\right]\right)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">𝑂𝑃𝐸𝑁</mo><mrow><mo>(</mo><mi>T</mi><mo>,</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><mo stretchy="false">]</mo></mrow><mo>]</mo></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(T,\left[(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}]\right]\right)</annotation></semantics></math>, where <math id="S7.Thmthm17.p1.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is a <math id="S7.Thmthm17.p1.m8" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-scheme and <math id="S7.Thmthm17.p1.m9" class="ltx_Math" alttext="\left[(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}\right]" display="inline" intent=":literal"><semantics><mrow><mo>[</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><mo>]</mo></mrow><annotation encoding="application/x-tex">\left[(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}\right]</annotation></semantics></math> is an equivalence class of relative GHN filtrations of <math id="S7.Thmthm17.p1.m10" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}|_{X_{T}},\sigma|_{X_{T}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}|_{X_{T}},\sigma|_{X_{T}})</annotation></semantics></math>, up to scaling the weights.</span></p>
</div>
</div>
<div id="S7.Thmthm18" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm18.2" class="ltx_text ltx_font_bold">Theorem 7.18</span></span><span id="S7.Thmthm18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm18.p1" class="ltx_para">
<p id="S7.Thmthm18.p1.1" class="ltx_p"><span id="S7.Thmthm18.p1.1.1" class="ltx_text ltx_font_italic">The relative GHN filtrations induce a stratification of <math id="S7.Thmthm18.p1.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> by locally closed substacks. Equivalently, for any <math id="S7.Thmthm18.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme <math id="S7.Thmthm18.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and every <math id="S7.Thmthm18.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S7.Thmthm18.p1.m5" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> there exists a unique locally closed stratification <math id="S7.Thmthm18.p1.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> of <math id="S7.Thmthm18.p1.m7" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> that is universal for GHN filtrations of <math id="S7.Thmthm18.p1.m8" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>.</span></p>
</div>
<div id="S7.Thmthm18.p2" class="ltx_para">
<p id="S7.Thmthm18.p2.1" class="ltx_p"><span id="S7.Thmthm18.p2.1.1" class="ltx_text ltx_font_italic">If, in addition, <math id="S7.Thmthm18.p2.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is locally of finite type over a field extension <math id="S7.Thmthm18.p2.m2" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> such that <math id="S7.Thmthm18.p2.m3" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is split, then the restriction of the universal relative GHN filtration<span id="footnote10" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">10</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">10</sup>
                  <span class="ltx_tag ltx_tag_note"><span id="footnote10.1" class="ltx_text ltx_font_upright">10</span></span>
                  
                  
                  
                  
                  
                  
                  
                <span id="footnote10.10" class="ltx_text ltx_font_upright">More precisely, we choose a representative up to scaling.
</span></span></span></span> to each connected component of the stratification comes from a relative multi-weighted parabolic reduction.</span></p>
</div>
</div>
<div id="S7.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS5.p5" class="ltx_para">
<p id="S7.SS5.p5.1" class="ltx_p"><span id="S7.SS5.p5.1.1" class="ltx_text">Let <math id="S7.SS5.p5.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="S7.SS5.p5.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme and let <math id="S7.SS5.p5.m3" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> be a <math id="S7.SS5.p5.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S7.SS5.p5.m5" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>. We will denote by <math id="S7.SS5.p5.m6" class="ltx_Math" alttext="\RelGies(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">RelGies</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\RelGies(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> the functor that parametrizes pairs <math id="S7.SS5.p5.m7" class="ltx_Math" alttext="\left(T,[(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}]\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mi>T</mi><mo>,</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(T,[(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}]\right)</annotation></semantics></math>, where <math id="S7.SS5.p5.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is a <math id="S7.SS5.p5.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-scheme and <math id="S7.SS5.p5.m10" class="ltx_Math" alttext="[(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}]</annotation></semantics></math> is an equivalence class of relative GHN filtrations of <math id="S7.SS5.p5.m11" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}|_{X_{T}},\sigma|_{X_{T}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}|_{X_{T}},\sigma|_{X_{T}})</annotation></semantics></math> up to scaling the weights. We would like to show that <math id="S7.SS5.p5.m12" class="ltx_Math" alttext="\RelGies(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">RelGies</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\RelGies(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> is represented by a locally closed stratification of <math id="S7.SS5.p5.m13" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. Since locally closed immersions satisfy étale descent, we can check this after base-changing to a field extension <math id="S7.SS5.p5.m14" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> such that <math id="S7.SS5.p5.m15" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is split. After replacing <math id="S7.SS5.p5.m16" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> with <math id="S7.SS5.p5.m17" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, we can assume without loss of generality that <math id="S7.SS5.p5.m18" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is split. Moreover, since <math id="S7.SS5.p5.m19" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> is locally of finite type over <math id="S7.SS5.p5.m20" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, we can reduce to the case when <math id="S7.SS5.p5.m21" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is of finite type over <math id="S7.SS5.p5.m22" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. We will construct <math id="S7.SS5.p5.m23" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> recursively.</span></p>
</div>
<div id="S7.SS5.p6" class="ltx_para">
<p id="S7.SS5.p6.1" class="ltx_p"><span id="S7.SS5.p6.1.1" class="ltx_text ltx_underline">First Step</span><span id="S7.SS5.p6.1.2" class="ltx_text">: We denote by <math id="S7.SS5.p6.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> the locally closed stratification of <math id="S7.SS5.p6.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> that is universal for leading term HN filtrations of <math id="S7.SS5.p6.m3" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math> (Proposition <a href="#S4.Thmthm37" title="Proposition 4.37. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.37</span></a>). There is a natural forgetful functor <math id="S7.SS5.p6.m4" class="ltx_Math" alttext="\RelGies(\mathcal{F}^{\bullet},\sigma)\rightarrow H_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">RelGies</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>H</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\RelGies(\mathcal{F}^{\bullet},\sigma)\rightarrow H_{1}</annotation></semantics></math> given by sending a relative GHN filtration <math id="S7.SS5.p6.m5" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mover accent="true"><mi>m</mi><mo mathsize="1.140em" stretchy="false">→</mo></mover><mo>∈</mo><msup><mi>ℤ</mi><mi>q</mi></msup></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{\vec{m}})_{\vec{m}\in\mathbb{Z}^{q}}</annotation></semantics></math> to the relative leading term HN filtration <math id="S7.SS5.p6.m6" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> defined by</span></p>
<table id="S7.Ex132" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex132.m1" class="ltx_Math" alttext="\mathcal{F}^{\bullet}_{m}\vcentcolon=\bigcup_{(m_{2},m_{3},\ldots,m_{q})\in\mathbb{Z}^{q-1}}\mathcal{F}_{(m,m_{2},\ldots,m_{q})}" display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>∙</mo></msubsup><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>2</mn></msub><mo>,</mo><msub><mi>m</mi><mn>3</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>m</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℤ</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>m</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\bullet}_{m}\vcentcolon=\bigcup_{(m_{2},m_{3},\ldots,m_{q})\in\mathbb{Z}^{q-1}}\mathcal{F}_{(m,m_{2},\ldots,m_{q})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS5.p6.2" class="ltx_p"><span id="S7.SS5.p6.2.1" class="ltx_text">The fact that this is a relative leading term HN filtration follows from the pointwise construction of the GHN filtration and the fact that pulling back to a fiber commutes with taking unions.</span></p>
</div>
<div id="S7.SS5.p7" class="ltx_para">
<p id="S7.SS5.p7.1" class="ltx_p"><span id="S7.SS5.p7.1.1" class="ltx_text">Choose a representative <math id="S7.SS5.p7.m1" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> for the universal leading term HN filtration of <math id="S7.SS5.p7.m2" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}|_{X_{H_{1}}},\sigma|_{X_{H_{1}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><msub><mi>H</mi><mn>1</mn></msub></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><msub><mi>H</mi><mn>1</mn></msub></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}|_{X_{H_{1}}},\sigma|_{X_{H_{1}}})</annotation></semantics></math>. By the last statement in Proposition <a href="#S4.Thmthm37" title="Proposition 4.37. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.37</span></a>, the restriction of <math id="S7.SS5.p7.m3" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> to each component of <math id="S7.SS5.p7.m4" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> comes from a relative weighted parabolic reduction <math id="S7.SS5.p7.m5" class="ltx_Math" alttext="(\lambda_{1},\mathcal{G}_{\lambda_{1}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{1},\mathcal{G}_{\lambda_{1}})</annotation></semantics></math>. We can use this to define, on each component of <math id="S7.SS5.p7.m6" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>, a relative <math id="S7.SS5.p7.m7" class="ltx_Math" alttext="1^{st}" display="inline" intent=":literal"><semantics><msup><mn>1</mn><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><annotation encoding="application/x-tex">1^{st}</annotation></semantics></math> associated graded Levi <math id="S7.SS5.p7.m8" class="ltx_Math" alttext="\rho_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\rho_{\lambda_{1}}</annotation></semantics></math>-sheaf, in exactly the same way as in the construction of the GHN filtration in Subsection <a href="#S7.SS3" title="7.3. The GHN filtration for 
          
            ρ
          
        -sheaves ‣ 7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a>. Putting all of these together for all connected components, we obtain what we can call a relative <math id="S7.SS5.p7.m9" class="ltx_Math" alttext="1^{st}" display="inline" intent=":literal"><semantics><msup><mn>1</mn><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><annotation encoding="application/x-tex">1^{st}</annotation></semantics></math> associated graded Levi <math id="S7.SS5.p7.m10" class="ltx_Math" alttext="\rho_{\lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><msub><mi>λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\rho_{\lambda_{1}}</annotation></semantics></math>-sheaf <math id="S7.SS5.p7.m11" class="ltx_Math" alttext="\text{gr}_{1}\vcentcolon=\text{gr}_{1}(\mathcal{F}^{\bullet}|_{X_{H_{1}}},\sigma|_{X_{H_{1}}})" display="inline" intent=":literal"><semantics><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo>:=</mo><mrow><msub><mtext>gr</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><msub><mi>H</mi><mn>1</mn></msub></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><msub><mi>H</mi><mn>1</mn></msub></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{gr}_{1}\vcentcolon=\text{gr}_{1}(\mathcal{F}^{\bullet}|_{X_{H_{1}}},\sigma|_{X_{H_{1}}})</annotation></semantics></math> defined on <math id="S7.SS5.p7.m12" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>, where we allow a different choice of the cocharacter <math id="S7.SS5.p7.m13" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> over each connected component of <math id="S7.SS5.p7.m14" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>.</span></p>
</div>
<div id="S7.SS5.p8" class="ltx_para">
<p id="S7.SS5.p8.1" class="ltx_p"><span id="S7.SS5.p8.1.1" class="ltx_text ltx_underline">Second Step</span><span id="S7.SS5.p8.1.2" class="ltx_text">: We can apply Proposition <a href="#S4.Thmthm37" title="Proposition 4.37. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.37</span></a> to the restriction of <math id="S7.SS5.p8.m1" class="ltx_Math" alttext="\text{gr}_{1}" display="inline" intent=":literal"><semantics><msub><mtext>gr</mtext><mn>1</mn></msub><annotation encoding="application/x-tex">\text{gr}_{1}</annotation></semantics></math> on each connected component in order to obtain a refinement <math id="S7.SS5.p8.m2" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math> of the stratification <math id="S7.SS5.p8.m3" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>. The scheme <math id="S7.SS5.p8.m4" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math> is universal for the leading term HN filtration of <math id="S7.SS5.p8.m5" class="ltx_Math" alttext="\text{gr}_{1}" display="inline" intent=":literal"><semantics><msub><mtext>gr</mtext><mn>1</mn></msub><annotation encoding="application/x-tex">\text{gr}_{1}</annotation></semantics></math>, hence we can choose a representative <math id="S7.SS5.p8.m6" class="ltx_Math" alttext="f_{2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>2</mn></msub><annotation encoding="application/x-tex">f_{2}</annotation></semantics></math> for the universal filtration. By the last statement of Proposition <a href="#S4.Thmthm37" title="Proposition 4.37. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.37</span></a>, the restriction of <math id="S7.SS5.p8.m7" class="ltx_Math" alttext="f_{2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>2</mn></msub><annotation encoding="application/x-tex">f_{2}</annotation></semantics></math> to each connected component of <math id="S7.SS5.p8.m8" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math> comes from a weighted reduction <math id="S7.SS5.p8.m9" class="ltx_Math" alttext="(\lambda_{2},\mathcal{G}_{\lambda_{2}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>λ</mi><mn>2</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{2},\mathcal{G}_{\lambda_{2}})</annotation></semantics></math> of <math id="S7.SS5.p8.m10" class="ltx_Math" alttext="\text{gr}_{1}" display="inline" intent=":literal"><semantics><msub><mtext>gr</mtext><mn>1</mn></msub><annotation encoding="application/x-tex">\text{gr}_{1}</annotation></semantics></math>. The procedure to construct the GHN filtration can be applied verbatim to this relative situation. In particular, we can construct a relative lexicographic <math id="S7.SS5.p8.m11" class="ltx_Math" alttext="\mathbb{Z}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{Z}^{2}</annotation></semantics></math>-filtration of <math id="S7.SS5.p8.m12" class="ltx_Math" alttext="(\mathcal{F}^{\bullet}|_{X_{H_{2}}},\sigma|_{X_{H_{2}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><msub><mi>H</mi><mn>2</mn></msub></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><msub><mi>H</mi><mn>2</mn></msub></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet}|_{X_{H_{2}}},\sigma|_{X_{H_{2}}})</annotation></semantics></math>. This lexicographic filtration comes from a 2-weighted parabolic reduction <math id="S7.SS5.p8.m13" class="ltx_Math" alttext="((\lambda_{1},\lambda_{2}),\mathcal{G}_{(\lambda_{1},\lambda_{2})})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((\lambda_{1},\lambda_{2}),\mathcal{G}_{(\lambda_{1},\lambda_{2})})</annotation></semantics></math>. By construction, <math id="S7.SS5.p8.m14" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math> is universal for lexicographic <math id="S7.SS5.p8.m15" class="ltx_Math" alttext="\mathbb{Z}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{Z}^{2}</annotation></semantics></math>-filtrations obtained in the second step of the construction of the GHN filtration. We can define a forgetful morphism <math id="S7.SS5.p8.m16" class="ltx_Math" alttext="\RelGies(\mathcal{F}^{\bullet},\sigma)\rightarrow H_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">RelGies</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>H</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\RelGies(\mathcal{F}^{\bullet},\sigma)\rightarrow H_{2}</annotation></semantics></math> in the same way as in the case of the first step <math id="S7.SS5.p8.m17" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>. In this case we remember the first two coordinates of the <math id="S7.SS5.p8.m18" class="ltx_Math" alttext="\mathbb{Z}^{q}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mi>q</mi></msup><annotation encoding="application/x-tex">\mathbb{Z}^{q}</annotation></semantics></math>-filtration and take the union over the other coordinates.</span></p>
</div>
<div id="S7.SS5.p9" class="ltx_para">
<p id="S7.SS5.p9.1" class="ltx_p"><span id="S7.SS5.p9.1.1" class="ltx_text ltx_underline">Recursion</span><span id="S7.SS5.p9.1.2" class="ltx_text">: Now we can iterate as in the construction of the (pointwise) GHN filtration. This process must terminate by the same reasoning as in Subsection <a href="#S7.SS3" title="7.3. The GHN filtration for 
          
            ρ
          
        -sheaves ‣ 7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a>, namely, the dimensions of the vector spaces in the tuple <math id="S7.SS5.p9.m1" class="ltx_Math" alttext="V^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">V^{\bullet}</annotation></semantics></math> are finite. If it terminates at the <math id="S7.SS5.p9.m2" class="ltx_Math" alttext="q^{th}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">q^{th}</annotation></semantics></math> step, then the corresponding locally closed stratification <math id="S7.SS5.p9.m3" class="ltx_Math" alttext="H_{q}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>q</mi></msub><annotation encoding="application/x-tex">H_{q}</annotation></semantics></math> is universal for GHN filtrations of <math id="S7.SS5.p9.m4" class="ltx_Math" alttext="(\mathcal{F}^{\bullet},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∙</mo></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}^{\bullet},\sigma)</annotation></semantics></math>. Furthermore, on each connected component of <math id="S7.SS5.p9.m5" class="ltx_Math" alttext="H_{q}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>q</mi></msub><annotation encoding="application/x-tex">H_{q}</annotation></semantics></math> the restriction of (a representative up to scaling of) the universal GHN filtration comes from a relative multi-weighted parabolic reduction.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Gieseker-Harder-Narasimhan filtrations in positive characteristic</h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p">Many of the arguments in this article do not use the hypothesis that the characteristic of <math id="A1.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is <math id="A1.p1.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. In this appendix we explain what needs to be modified in order to define Gieseker-Harder-Narasimhan filtrations in positive characteristic. We can show that <math id="A1.p1.m3" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> defines a weak <math id="A1.p1.m4" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification on <math id="A1.p1.m5" class="ltx_Math" alttext="\text{Bun}_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mtext>Bun</mtext><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Bun}_{\rho}(X)</annotation></semantics></math> (as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Defn. 2.23]</cite>). This allows us to define the GHN filtration of a <math id="A1.p1.m6" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf after maybe passing to a purely inseparable extension of the ground field.</p>
</div>
<div id="A1.p2" class="ltx_para">
<p id="A1.p2.1" class="ltx_p">Fix an arbitrary field <math id="A1.p2.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. We use the same setup and notation as in the characteristic <math id="A1.p2.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> case (<math id="A1.p2.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a polarized smooth projective geometrically irreducible <math id="A1.p2.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-variety, <math id="A1.p2.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a connected reductive group over <math id="A1.p2.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, and <math id="A1.p2.m7" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is a faithful representation of <math id="A1.p2.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>). Note that everything in Subsection <a href="#S2.SS2" title="2.2. Big open sets and torsion-free sheaves ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a> applies to general <math id="A1.p2.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div>
<div id="A1.p3" class="ltx_para">
<p id="A1.p3.1" class="ltx_p">The construction of <math id="A1.p3.m1" class="ltx_Math" alttext="\text{Red}_{G}(\mathcal{F})" display="inline" intent=":literal"><semantics><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Red}_{G}(\mathcal{F})</annotation></semantics></math> in Subsection <a href="#S2.SS3" title="2.3. The scheme of 
          
            G
          
        -reductions ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> can be done in a similar way in arbitrary characteristic. The proofs of all the results in Subsection <a href="#S2.SS3" title="2.3. The scheme of 
          
            G
          
        -reductions ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> remain valid, with the only exception that in Lemma <a href="#S2.Thmthm15" title="Lemma 2.15. ‣ 2.3. The scheme of 
          
            G
          
        -reductions ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.15</span></a> it is no longer clear that the natural base-change morphism <math id="A1.p3.m2" class="ltx_Math" alttext="\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}\to\text{Red}_{G}(\mathcal{F}|_{X_{T}})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">×</mo><msub><mi>X</mi><mi>S</mi></msub></msub><msub><mi>X</mi><mi>T</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}\to\text{Red}_{G}(\mathcal{F}|_{X_{T}})</annotation></semantics></math> is necessarily an isomorphism. This is because it is no longer true that formation of <math id="A1.p3.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariants commutes with arbitrary base-change. We note, however, that for any big open <math id="A1.p3.m4" class="ltx_Math" alttext="U\subset X_{S}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><msub><mi>X</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">U\subset X_{S}</annotation></semantics></math> such that <math id="A1.p3.m5" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is locally free, the restriction <math id="A1.p3.m6" class="ltx_Math" alttext="\text{Red}_{G}(\mathcal{F})\times_{X_{S}}U_{T}\to\text{Red}_{G}(\mathcal{F}|_{X_{T}})_{U_{T}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">×</mo><msub><mi>X</mi><mi>S</mi></msub></msub><msub><mi>U</mi><mi>T</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow><msub><mi>U</mi><mi>T</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\text{Red}_{G}(\mathcal{F})\times_{X_{S}}U_{T}\to\text{Red}_{G}(\mathcal{F}|_{X_{T}})_{U_{T}}</annotation></semantics></math> is an isomorphism. This is because both sides are naturally identified with the quotient <math id="A1.p3.m7" class="ltx_Math" alttext="\mathcal{P}|_{U_{T}}/G" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">|</mo></mrow><msub><mi>U</mi><mi>T</mi></msub></msub><mo>/</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\mathcal{P}|_{U_{T}}/G</annotation></semantics></math> by Proposition <a href="#S2.Thmthm16" title="Proposition 2.16. ‣ 2.3. The scheme of 
          
            G
          
        -reductions ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.16</span></a>. This is used to show the following lemma.</p>
</div>
<div id="A1.Thmthm1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm1.2" class="ltx_text ltx_font_bold">Lemma A.1</span></span><span id="A1.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm1.p1" class="ltx_para">
<p id="A1.Thmthm1.p1.1" class="ltx_p"><span id="A1.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A1.Thmthm1.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="A1.Thmthm1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme, and let <math id="A1.Thmthm1.p1.m3" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> be a relative torsion-free sheaf of rank <math id="A1.Thmthm1.p1.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> on <math id="A1.Thmthm1.p1.m5" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>. For any <math id="A1.Thmthm1.p1.m6" class="ltx_Math" alttext="T\to S" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">T\to S</annotation></semantics></math>, there is a natural bijection between the following two sets</span></p>
<ol id="A1.I1" class="ltx_enumerate">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A)</span> 
<div id="A1.I1.i1.p1" class="ltx_para">
<p id="A1.I1.i1.p1.1" class="ltx_p"><span id="A1.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">Sections of the structure morphism </span><math id="A1.I1.i1.p1.m1" class="ltx_Math" alttext="\text{Red}_{G}(\mathcal{F}|_{X_{T}})\to X_{T}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext class="ltx_mathvariant_italic">Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>X</mi><mi>T</mi></msub></mrow><annotation encoding="application/x-tex">\text{Red}_{G}(\mathcal{F}|_{X_{T}})\to X_{T}</annotation></semantics></math><span id="A1.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(B)</span> 
<div id="A1.I1.i2.p1" class="ltx_para">
<p id="A1.I1.i2.p1.1" class="ltx_p"><span id="A1.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">Sections of the structure morphism </span><math id="A1.I1.i2.p1.m1" class="ltx_Math" alttext="\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}\to X_{T}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mtext class="ltx_mathvariant_italic">Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">×</mo><msub><mi>X</mi><mi>S</mi></msub></msub><msub><mi>X</mi><mi>T</mi></msub></mrow><mo stretchy="false">→</mo><msub><mi>X</mi><mi>T</mi></msub></mrow><annotation encoding="application/x-tex">\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}\to X_{T}</annotation></semantics></math><span id="A1.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="A1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.p4" class="ltx_para">
<p id="A1.p4.1" class="ltx_p"><span id="A1.p4.1.1" class="ltx_text">Let <math id="A1.p4.m1" class="ltx_Math" alttext="U\subset X_{S}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><msub><mi>X</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">U\subset X_{S}</annotation></semantics></math> denote a big open subset such that <math id="A1.p4.m2" class="ltx_Math" alttext="\mathcal{F}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{F}|_{U}</annotation></semantics></math> is locally-free. By Lemma <a href="#S2.Thmthm3" title="Lemma 2.3. ‣ 2.2. Big open sets and torsion-free sheaves ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> (c), sections in the set (A) are in correspondence with sections <math id="A1.p4.m3" class="ltx_Math" alttext="U_{T}\to\text{Red}_{G}(\mathcal{F}|_{X_{T}})_{U_{T}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>T</mi></msub><mo stretchy="false">→</mo><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow><msub><mi>U</mi><mi>T</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">U_{T}\to\text{Red}_{G}(\mathcal{F}|_{X_{T}})_{U_{T}}</annotation></semantics></math> defined on the big open <math id="A1.p4.m4" class="ltx_Math" alttext="U_{T}\subset X_{T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>T</mi></msub><mo>⊂</mo><msub><mi>X</mi><mi>T</mi></msub></mrow><annotation encoding="application/x-tex">U_{T}\subset X_{T}</annotation></semantics></math>. Since the base-change morphism <math id="A1.p4.m5" class="ltx_Math" alttext="\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}\to\text{Red}_{G}(\mathcal{F}|_{X_{T}})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">×</mo><msub><mi>X</mi><mi>S</mi></msub></msub><msub><mi>X</mi><mi>T</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}\to\text{Red}_{G}(\mathcal{F}|_{X_{T}})</annotation></semantics></math> restricts to an isomorphism over the open set <math id="A1.p4.m6" class="ltx_Math" alttext="U_{T}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>T</mi></msub><annotation encoding="application/x-tex">U_{T}</annotation></semantics></math>, these sections are in bijection with sections <math id="A1.p4.m7" class="ltx_Math" alttext="U_{T}\to\text{Red}_{G}(\mathcal{F})\times_{X_{S}}U_{T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>T</mi></msub><mo stretchy="false">→</mo><mrow><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">×</mo><msub><mi>X</mi><mi>S</mi></msub></msub><msub><mi>U</mi><mi>T</mi></msub></mrow></mrow><annotation encoding="application/x-tex">U_{T}\to\text{Red}_{G}(\mathcal{F})\times_{X_{S}}U_{T}</annotation></semantics></math>. Another application of Lemma <a href="#S2.Thmthm3" title="Lemma 2.3. ‣ 2.2. Big open sets and torsion-free sheaves ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> (c) shows that all such sections extend uniquely to a morphism <math id="A1.p4.m8" class="ltx_Math" alttext="X_{T}\to\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>T</mi></msub><mo stretchy="false">→</mo><mrow><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">×</mo><msub><mi>X</mi><mi>S</mi></msub></msub><msub><mi>X</mi><mi>T</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X_{T}\to\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}</annotation></semantics></math> as in (B).
∎</span></p>
</div>
</div>
<div id="A1.p5" class="ltx_para">
<p id="A1.p5.1" class="ltx_p">In other words, even though the schemes <math id="A1.p5.m1" class="ltx_Math" alttext="\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">×</mo><msub><mi>X</mi><mi>S</mi></msub></msub><msub><mi>X</mi><mi>T</mi></msub></mrow><annotation encoding="application/x-tex">\text{Red}_{G}(\mathcal{F})\times_{X_{S}}X_{T}</annotation></semantics></math> and <math id="A1.p5.m2" class="ltx_Math" alttext="\text{Red}_{G}(\mathcal{F}|_{X_{T}})" display="inline" intent=":literal"><semantics><mrow><msub><mtext>Red</mtext><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Red}_{G}(\mathcal{F}|_{X_{T}})</annotation></semantics></math> are not necessarily isomorphic, they have the same sections over <math id="A1.p5.m3" class="ltx_Math" alttext="X_{T}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>T</mi></msub><annotation encoding="application/x-tex">X_{T}</annotation></semantics></math> because they are isomorphic over a big open subset.</p>
</div>
<div id="A1.Thmthm2" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm2.2" class="ltx_text ltx_font_bold">Definition A.2</span></span><span id="A1.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm2.p1" class="ltx_para">
<p id="A1.Thmthm2.p1.1" class="ltx_p"><span id="A1.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">A <math id="A1.Thmthm2.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf is a pair <math id="A1.Thmthm2.p1.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> where</span></p>
<ol id="A1.I2" class="ltx_enumerate">
<li id="A1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A1.I2.i1.p1" class="ltx_para">
<p id="A1.I2.i1.p1.1" class="ltx_p"><math id="A1.I2.i1.p1.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math><span id="A1.I2.i1.p1.1.1" class="ltx_text ltx_font_italic"> is a family of torsion-free sheaves of rank </span><math id="A1.I2.i1.p1.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math><span id="A1.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> on </span><math id="A1.I2.i1.p1.m3" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math><span id="A1.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A1.I2.i2.p1" class="ltx_para">
<p id="A1.I2.i2.p1.1" class="ltx_p"><math id="A1.I2.i2.p1.m1" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math><span id="A1.I2.i2.p1.1.1" class="ltx_text ltx_font_italic"> is a section of the structure morphism </span><math id="A1.I2.i2.p1.m2" class="ltx_Math" alttext="\Red_{G}(\mathcal{F})\rightarrow X_{S}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>X</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">\Red_{G}(\mathcal{F})\rightarrow X_{S}</annotation></semantics></math><span id="A1.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="A1.Thmthm2.p1.2" class="ltx_p"><span id="A1.Thmthm2.p1.2.1" class="ltx_text ltx_font_italic">The stack <math id="A1.Thmthm2.p1.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> is the pseudofunctor from <math id="A1.Thmthm2.p1.m4" class="ltx_Math" alttext="\left(\Aff_{k}\right)^{op}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><msub><mi mathsize="0.800em">Aff</mi><mi>k</mi></msub><mo>)</mo></mrow><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><annotation encoding="application/x-tex">\left(\Aff_{k}\right)^{op}</annotation></semantics></math> into groupoids that sends an affine scheme <math id="A1.Thmthm2.p1.m5" class="ltx_Math" alttext="T\in\Aff_{k}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><msub><mi mathsize="0.800em">Aff</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">T\in\Aff_{k}</annotation></semantics></math> to <math id="A1.Thmthm2.p1.m6" class="ltx_Math" alttext="\Bun_{\rho}(X)\,(T)=\left[\;\;\text{groupoid of $\rho$-sheaves $(\mathcal{F},\sigma)$ on $X_{S}$}\;\;\;\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.130em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mrow><mtext class="ltx_mathvariant_italic">groupoid of </mtext><mi>ρ</mi><mtext class="ltx_mathvariant_italic">-sheaves </mtext><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mtext class="ltx_mathvariant_italic"> on </mtext><msub><mi>X</mi><mi>S</mi></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)\,(T)=\left[\;\;\text{groupoid of $\rho$-sheaves $(\mathcal{F},\sigma)$ on $X_{S}$}\;\;\;\right]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.p6" class="ltx_para">
<p id="A1.p6.1" class="ltx_p">Once we know Lemma <a href="#A1.Thmthm1" title="Lemma A.1. ‣ Appendix A Gieseker-Harder-Narasimhan filtrations in positive characteristic ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>, everything in Section <a href="#S3" title="3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> applies verbatim. Similarly, the definitions and arguments in Subsections <a href="#S4.SS1" title="4.1. The numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, <a href="#S4.SS2" title="4.2. Affine Grassmannians for 
          
            ρ
          
        -sheaves ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, <a href="#S4.SS3" title="4.3. Monotonicity of the numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> and <a href="#S4.SS4" title="4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> apply without a change. Hence we have the following result in arbitrary characteristic</p>
</div>
<div id="A1.Thmthm3" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm3.2" class="ltx_text ltx_font_bold">Proposition A.3</span></span><span id="A1.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm3.p1" class="ltx_para">
<p id="A1.Thmthm3.p1.1" class="ltx_p"><span id="A1.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">The polynomial numerical invariant <math id="A1.Thmthm3.p1.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> on the stack <math id="A1.Thmthm3.p1.m2" class="ltx_Math" alttext="\text{Bun}_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mtext class="ltx_mathvariant_italic">Bun</mtext><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Bun}_{\rho}(X)</annotation></semantics></math> is strictly <math id="A1.Thmthm3.p1.m3" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-monotone, strictly <math id="A1.Thmthm3.p1.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-monotone, and satisfies the HN boundedness condition. ∎</span></p>
</div>
</div>
<div id="A1.p7" class="ltx_para">
<p id="A1.p7.1" class="ltx_p">Proposition <a href="#A1.Thmthm3" title="Proposition A.3. ‣ Appendix A Gieseker-Harder-Narasimhan filtrations in positive characteristic ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a> yields the necessary hypotheses to apply <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Thm. 2.26]</cite> (or <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">HL14</a>, Thm. B]</cite>). This yields the following theorem (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Defn. 2.23]</cite> for a definition of weak <math id="A1.p7.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification).</p>
</div>
<div id="A1.Thmthm4" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm4.2" class="ltx_text ltx_font_bold">Theorem A.4</span></span><span id="A1.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm4.p1" class="ltx_para">
<p id="A1.Thmthm4.p1.1" class="ltx_p"><span id="A1.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">The polynomial numerical invariant <math id="A1.Thmthm4.p1.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> defines a weak <math id="A1.Thmthm4.p1.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification on the stack <math id="A1.Thmthm4.p1.m3" class="ltx_Math" alttext="\text{Bun}_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mtext class="ltx_mathvariant_italic">Bun</mtext><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Bun}_{\rho}(X)</annotation></semantics></math>. ∎</span></p>
</div>
</div>
<div id="A1.p8" class="ltx_para">
<p id="A1.p8.1" class="ltx_p">Note that in this case we only get a weak <math id="A1.p8.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification. In particular, the corresponding notion of leading term HN filtration of a <math id="A1.p8.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="A1.p8.m3" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> is not necessarily defined over the field <math id="A1.p8.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> of definition of <math id="A1.p8.m5" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>; one might need to allow to pass to a finite purely inseparable extension of <math id="A1.p8.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. This is to be expected for small characteristics, because of the failure of Behrend’s conjecture even in the case when <math id="A1.p8.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a curve <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx26" title="" class="ltx_ref">Hei08a</a>]</cite>. We note that it is still the case that the leading HN filtration is unique up to scaling, even though it might not be defined over the ground field.</p>
</div>
<div id="A1.p9" class="ltx_para">
<p id="A1.p9.1" class="ltx_p">The analogous definition of relative leading HN filtrations (Definition <a href="#S4.Thmthm32" title="Definition 4.32. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.32</span></a>) applies in arbitrary characteristic. However, since we are working with a weak <math id="A1.p9.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification, the universal stratification <math id="A1.p9.m2" class="ltx_Math" alttext="H\to S" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">H\to S</annotation></semantics></math> is no longer a locally closed immersion. Instead, we get that the universal morphism <math id="A1.p9.m3" class="ltx_Math" alttext="H\to S" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">H\to S</annotation></semantics></math> parametrizing relative leading term HN filtrations is surjective, radicial and of finite type. Each connected component of <math id="A1.p9.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is finite over its image.</p>
</div>
<div id="A1.p10" class="ltx_para">
<p id="A1.p10.1" class="ltx_p">As long as the characteristic of <math id="A1.p10.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is not too small, the proofs in Section <a href="#S5.SS1" title="5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> can still be applied to show Theorem <a href="#S5.Thmthm7" title="Theorem 5.7. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.7</span></a>. More precisely, we just need that condition (2) in Proposition <a href="#S5.Thmthm2" title="Proposition 5.2. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> holds.</p>
</div>
<div id="A1.Thmthm5" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm5.2" class="ltx_text ltx_font_bold">Theorem A.5</span></span><span id="A1.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm5.p1" class="ltx_para">
<p id="A1.Thmthm5.p1.1" class="ltx_p"><span id="A1.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">Choose an algebraic closure <math id="A1.Thmthm5.p1.m1" class="ltx_Math" alttext="\overline{k}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{k}</annotation></semantics></math> of <math id="A1.Thmthm5.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Let <math id="A1.Thmthm5.p1.m3" class="ltx_Math" alttext="Z\subset G_{\overline{k}}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub></mrow><annotation encoding="application/x-tex">Z\subset G_{\overline{k}}</annotation></semantics></math> denote the maximal central torus of the base-change <math id="A1.Thmthm5.p1.m4" class="ltx_Math" alttext="G_{\overline{k}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><annotation encoding="application/x-tex">G_{\overline{k}}</annotation></semantics></math>. Suppose that the characteristic of <math id="A1.Thmthm5.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> does not divide the order of the kernel of the simply-connected cover <math id="A1.Thmthm5.p1.m6" class="ltx_Math" alttext="\widetilde{G_{\overline{k}}/Z}\to G_{\overline{k}}/Z" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo>/</mo><mi>Z</mi></mrow><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">→</mo><mrow><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo>/</mo><mi>Z</mi></mrow></mrow><annotation encoding="application/x-tex">\widetilde{G_{\overline{k}}/Z}\to G_{\overline{k}}/Z</annotation></semantics></math> of the semisimple group <math id="A1.Thmthm5.p1.m7" class="ltx_Math" alttext="G_{\overline{k}}/Z" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover></msub><mo>/</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">G_{\overline{k}}/Z</annotation></semantics></math>. Then the morphism <math id="A1.Thmthm5.p1.m8" class="ltx_Math" alttext="\text{Bun}_{\rho}(X)\to\Spec(k)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext class="ltx_mathvariant_italic">Bun</mtext><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{Bun}_{\rho}(X)\to\Spec(k)</annotation></semantics></math> satisfies the existence part of the valuative criterion for properness <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Sta23</a>, <a href="https://stacks.math.columbia.edu/tag/0CLK" title="" class="ltx_ref ltx_href">Tag 0CLK</a>]</cite> in the case of complete discrete valuation rings (as in Theorem <a href="#S5.Thmthm7" title="Theorem 5.7. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.7</span></a>). ∎</span></p>
</div>
</div>
<div id="A1.p11" class="ltx_para">
<p id="A1.p11.1" class="ltx_p">The definitions and constructions in Sections <a href="#S6" title="6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> and <a href="#S7" title="7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> apply similarly. The only change is that the GHN filtration of a <math id="A1.p11.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="A1.p11.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> need not be defined over the field <math id="A1.p11.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> of definition, but again one might need to pass to a finite purely inseparable extension. The analogue of Theorem <a href="#S7.Thmthm18" title="Theorem 7.18. ‣ 7.5. The GHN filtration in families ‣ 7. Gieseker-Harder-Narasimhan filtrations for 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.18</span></a> still holds; the only thing that needs to be modified is to replace the locally closed stratification <math id="A1.p11.m4" class="ltx_Math" alttext="H\to S" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">H\to S</annotation></semantics></math> with a surjective radicial morphism of finite type.</p>
</div>
<div id="A1.p12" class="ltx_para">
<p id="A1.p12.1" class="ltx_p">Finally, we note that the proof of Proposition <a href="#S6.Thmthm11" title="Proposition 6.11. ‣ 6.2. Comparison with previous work ‣ 6. Generalization to products of general linear groups and comparison with previous work ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.11</span></a> applies to arbitrary characteristic. This means that if the representation <math id="A1.p12.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is central, then the stratification of <math id="A1.p12.m2" class="ltx_Math" alttext="\text{Bun}_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mtext>Bun</mtext><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Bun}_{\rho}(X)</annotation></semantics></math> by radicial morphisms induced by our Gieseker-Harder-Narasimhan filtrations refines the theory developed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx21" title="" class="ltx_ref">GN16</a>]</cite> in arbitrary characteristic.</p>
</div>
<div id="A1.Thmthm6" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm6.2" class="ltx_text ltx_font_bold">Remark A.6</span></span><span id="A1.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm6.p1" class="ltx_para">
<p id="A1.Thmthm6.p1.1" class="ltx_p"><span id="A1.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Using the same techniques, one could generalize the results in this appendix to the case when <math id="A1.Thmthm6.p1.m1" class="ltx_Math" alttext="X\to S" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">X\to S</annotation></semantics></math> is a smooth projective morphism with geometrically connected fibers over an arbitrary base-scheme <math id="A1.Thmthm6.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, <math id="A1.Thmthm6.p1.m3" class="ltx_Math" alttext="G\to S" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">G\to S</annotation></semantics></math> is a reductive group scheme with connected fibers, and <math id="A1.Thmthm6.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is a faithful representation <math id="A1.Thmthm6.p1.m5" class="ltx_Math" alttext="\rho:G\hookrightarrow\prod_{i}GL(V^{i})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>G</mi><mo rspace="0.111em" stretchy="false">↪</mo><mrow><msub><mo>∏</mo><mi>i</mi></msub><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:G\hookrightarrow\prod_{i}GL(V^{i})</annotation></semantics></math> for some vector bundles <math id="A1.Thmthm6.p1.m6" class="ltx_Math" alttext="V^{i}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mi>i</mi></msup><annotation encoding="application/x-tex">V^{i}</annotation></semantics></math> on <math id="A1.Thmthm6.p1.m7" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. We have chosen not to pursue this level of generality in this paper.</span></p>
</div>
</div>
</section>
