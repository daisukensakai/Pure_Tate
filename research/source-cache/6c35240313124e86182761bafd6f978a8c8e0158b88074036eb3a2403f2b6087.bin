</table>
</div></li>
<li id="S4.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(M3)</span> 
<div id="S4.I4.i3.p1" class="ltx_para">
<p id="S4.I4.i3.p1.1" class="ltx_p"><span id="S4.I4.i3.p1.1.1" class="ltx_text ltx_font_italic">Let </span><math id="S4.I4.i3.p1.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math><span id="S4.I4.i3.p1.1.2" class="ltx_text ltx_font_italic"> be a finite extension of the residue field of </span><math id="S4.I4.i3.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math><span id="S4.I4.i3.p1.1.3" class="ltx_text ltx_font_italic">. For any </span><math id="S4.I4.i3.p1.m3" class="ltx_Math" alttext="a\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">a\geq 1</annotation></semantics></math><span id="S4.I4.i3.p1.1.4" class="ltx_text ltx_font_italic"> and any finite </span><math id="S4.I4.i3.p1.m4" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math><span id="S4.I4.i3.p1.1.5" class="ltx_text ltx_font_italic">-equivariant morphism </span><math id="S4.I4.i3.p1.m5" class="ltx_Math" alttext="\mathbb{P}^{1}_{\kappa}[a]\to\Sigma_{(0,0)}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ℙ</mi><mi>κ</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{P}^{1}_{\kappa}[a]\to\Sigma_{(0,0)}</annotation></semantics></math><span id="S4.I4.i3.p1.1.6" class="ltx_text ltx_font_italic">, we have </span><math id="S4.I4.i3.p1.m6" class="ltx_Math" alttext="\nu\left(\;\widetilde{\varphi}|_{\left[\infty/\mathbb{G}_{m}\right]}\;\right)\geq\nu\left(\;\widetilde{\varphi}|_{\left[0/\mathbb{G}_{m}\right]}\;\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mrow><mover accent="true"><mi>φ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">|</mo></mrow><mrow><mo>[</mo><mrow><mi mathvariant="normal">∞</mi><mo>/</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><mo>]</mo></mrow></msub><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mrow><mover accent="true"><mi>φ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">|</mo></mrow><mrow><mo>[</mo><mrow><mn>0</mn><mo>/</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><mo>]</mo></mrow></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu\left(\;\widetilde{\varphi}|_{\left[\infty/\mathbb{G}_{m}\right]}\;\right)\geq\nu\left(\;\widetilde{\varphi}|_{\left[0/\mathbb{G}_{m}\right]}\;\right)</annotation></semantics></math><span id="S4.I4.i3.p1.1.7" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.Thmthm15" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm15.2" class="ltx_text ltx_font_bold">Proposition 4.15</span></span><span id="S4.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm15.p1" class="ltx_para">
<p id="S4.Thmthm15.p1.1" class="ltx_p"><span id="S4.Thmthm15.p1.1.1" class="ltx_text ltx_font_italic">The invariant <math id="S4.Thmthm15.p1.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> on the stack <math id="S4.Thmthm15.p1.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> is both strictly <math id="S4.Thmthm15.p1.m3" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-monotone and strictly <math id="S4.Thmthm15.p1.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-monotone.</span></p>
</div>
</div>
<div id="S4.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS3.p5" class="ltx_para">
<p id="S4.SS3.p5.1" class="ltx_p"><span id="S4.SS3.p5.1.1" class="ltx_text">The argument is a variation of the one in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, §4.3]</cite> using our version of the affine Grassmannian. We let <math id="S4.SS3.p5.m1" class="ltx_Math" alttext="Y=Y_{\Theta_{R}}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><msub><mi>Y</mi><msub><mi mathvariant="normal">Θ</mi><mi>R</mi></msub></msub></mrow><annotation encoding="application/x-tex">Y=Y_{\Theta_{R}}</annotation></semantics></math> or <math id="S4.SS3.p5.m2" class="ltx_Math" alttext="Y_{\overline{ST}_{R}}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><msub><mover accent="true"><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="true">¯</mo></mover><mi>R</mi></msub></msub><annotation encoding="application/x-tex">Y_{\overline{ST}_{R}}</annotation></semantics></math>. Suppose that we are given a morphism <math id="S4.SS3.p5.m3" class="ltx_Math" alttext="f:\left[\left(\,Y\setminus(0,0)\,\right)/\,\mathbb{G}_{m}\right]\rightarrow\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo>[</mo><mrow><mrow><mo rspace="0.130em">(</mo><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo rspace="0.130em" stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo rspace="0.352em">/</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><mo>]</mo></mrow><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f:\left[\left(\,Y\setminus(0,0)\,\right)/\,\mathbb{G}_{m}\right]\rightarrow\Bun_{\rho}(X)</annotation></semantics></math>. This consists of the data of a <math id="S4.SS3.p5.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S4.SS3.p5.m5" class="ltx_Math" alttext="(\mathcal{E},\zeta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{E},\zeta)</annotation></semantics></math> on <math id="S4.SS3.p5.m6" class="ltx_Math" alttext="X_{Y\setminus(0,0)}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">X_{Y\setminus(0,0)}</annotation></semantics></math> that is <math id="S4.SS3.p5.m7" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant with respect to the action of <math id="S4.SS3.p5.m8" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math> on <math id="S4.SS3.p5.m9" class="ltx_Math" alttext="Y\setminus(0,0)" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y\setminus(0,0)</annotation></semantics></math>. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Lem. 4.7(i)]</cite>, there is a <math id="S4.SS3.p5.m10" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant family of torsion-free sheaves <math id="S4.SS3.p5.m11" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> on <math id="S4.SS3.p5.m12" class="ltx_Math" alttext="X_{Y}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>Y</mi></msub><annotation encoding="application/x-tex">X_{Y}</annotation></semantics></math>, a <math id="S4.SS3.p5.m13" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-stable <math id="S4.SS3.p5.m14" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>-flat effective Cartier divisor <math id="S4.SS3.p5.m15" class="ltx_Math" alttext="D\hookrightarrow X_{Y}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo stretchy="false">↪</mo><msub><mi>X</mi><mi>Y</mi></msub></mrow><annotation encoding="application/x-tex">D\hookrightarrow X_{Y}</annotation></semantics></math> and a <math id="S4.SS3.p5.m16" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant monomorphism <math id="S4.SS3.p5.m17" class="ltx_Math" alttext="\theta:\mathcal{F}|_{X_{Y\setminus(0,0)}}\rightarrow\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub></msub><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">\theta:\mathcal{F}|_{X_{Y\setminus(0,0)}}\rightarrow\mathcal{E}</annotation></semantics></math> such that <math id="S4.SS3.p5.m18" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is an isomorphism away from <math id="S4.SS3.p5.m19" class="ltx_Math" alttext="D_{Y\setminus(0,0)}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">D_{Y\setminus(0,0)}</annotation></semantics></math>. Set <math id="S4.SS3.p5.m20" class="ltx_Math" alttext="Q\vcentcolon=X_{Y}\setminus D" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>:=</mo><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>∖</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">Q\vcentcolon=X_{Y}\setminus D</annotation></semantics></math>. The isomorphism <math id="S4.SS3.p5.m21" class="ltx_Math" alttext="\theta|_{Q_{Y\setminus(0,0)}}" display="inline" intent=":literal"><semantics><msub><mrow><mi>θ</mi><mo stretchy="false">|</mo></mrow><msub><mi>Q</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub></msub><annotation encoding="application/x-tex">\theta|_{Q_{Y\setminus(0,0)}}</annotation></semantics></math> induces a <math id="S4.SS3.p5.m22" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant identification <math id="S4.SS3.p5.m23" class="ltx_Math" alttext="\Red_{G}(\mathcal{E})|_{Q_{Y\setminus(0,0)}}\xrightarrow{\sim}\Red_{G}(\mathcal{F})|_{Q_{Y\setminus(0,0)}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><msub><mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><msub><mi>Q</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub></msub></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><msub><mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><msub><mi>Q</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\Red_{G}(\mathcal{E})|_{Q_{Y\setminus(0,0)}}\xrightarrow{\sim}\Red_{G}(\mathcal{F})|_{Q_{Y\setminus(0,0)}}</annotation></semantics></math>. We have a <math id="S4.SS3.p5.m24" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant section induced by <math id="S4.SS3.p5.m25" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math>:</span></p>
<table id="S4.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex31.m1" class="ltx_Math" alttext="\sigma_{Q_{Y\setminus(0,0)}}:Q_{Y\setminus(0,0)}\xrightarrow{\zeta|_{Q_{Y\setminus(0,0)}}}\Red_{G}(\mathcal{E})|_{Q_{Y\setminus(0,0)}}\xrightarrow{\sim}\Red_{G}(\mathcal{F})|_{Q_{Y\setminus(0,0)}}" display="block" intent=":literal"><semantics><mrow><msub><mi>σ</mi><msub><mi>Q</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>Q</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mover accent="true"><mo>→</mo><msub><mrow><mi mathsize="0.700em">ζ</mi><mo maxsize="0.700em" minsize="0.700em" stretchy="true">|</mo></mrow><msub><mi mathsize="0.710em">Q</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub></msub></mover><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><msub><mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><msub><mi>Q</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub></msub></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><msub><mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><msub><mi>Q</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma_{Q_{Y\setminus(0,0)}}:Q_{Y\setminus(0,0)}\xrightarrow{\zeta|_{Q_{Y\setminus(0,0)}}}\Red_{G}(\mathcal{E})|_{Q_{Y\setminus(0,0)}}\xrightarrow{\sim}\Red_{G}(\mathcal{F})|_{Q_{Y\setminus(0,0)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p5.2" class="ltx_p"><span id="S4.SS3.p5.2.1" class="ltx_text">The local ring <math id="S4.SS3.p5.m26" class="ltx_Math" alttext="\mathcal{O}_{Y,(0,0)}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>Y</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\mathcal{O}_{Y,(0,0)}</annotation></semantics></math> at <math id="S4.SS3.p5.m27" class="ltx_Math" alttext="(0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0)</annotation></semantics></math> has depth <math id="S4.SS3.p5.m28" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>. For any point <math id="S4.SS3.p5.m29" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> in the fiber <math id="S4.SS3.p5.m30" class="ltx_Math" alttext="Q_{(0,0)}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">Q_{(0,0)}</annotation></semantics></math>, the local ring <math id="S4.SS3.p5.m31" class="ltx_Math" alttext="\mathcal{O}_{Q,u}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>Q</mi><mo>,</mo><mi>u</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{O}_{Q,u}</annotation></semantics></math> is flat over <math id="S4.SS3.p5.m32" class="ltx_Math" alttext="\mathcal{O}_{Y,(0,0)}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>Y</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\mathcal{O}_{Y,(0,0)}</annotation></semantics></math>. It follows that <math id="S4.SS3.p5.m33" class="ltx_Math" alttext="\mathcal{O}_{Q,u}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>Q</mi><mo>,</mo><mi>u</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{O}_{Q,u}</annotation></semantics></math> has depth at least <math id="S4.SS3.p5.m34" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> for all <math id="S4.SS3.p5.m35" class="ltx_Math" alttext="u\in Q_{(0,0)}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><msub><mi>Q</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">u\in Q_{(0,0)}</annotation></semantics></math>. The same type of argument as in Lemma <a href="#S2.Thmthm3" title="Lemma 2.3. ‣ 2.2. Big open sets and torsion-free sheaves ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> (c) shows that the <math id="S4.SS3.p5.m36" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant section <math id="S4.SS3.p5.m37" class="ltx_Math" alttext="\sigma_{Q_{Y\setminus(0,0)}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><msub><mi>Q</mi><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub></msub><annotation encoding="application/x-tex">\sigma_{Q_{Y\setminus(0,0)}}</annotation></semantics></math> extends uniquely to a <math id="S4.SS3.p5.m38" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant section <math id="S4.SS3.p5.m39" class="ltx_Math" alttext="\sigma:Q\rightarrow\Red_{G}(\mathcal{F})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Q</mi><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma:Q\rightarrow\Red_{G}(\mathcal{F})</annotation></semantics></math>. We now have all of the necessary data to form the affine grassmannian <math id="S4.SS3.p5.m40" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F},\sigma}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow></msub><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F},\sigma}</annotation></semantics></math>. Since everything is <math id="S4.SS3.p5.m41" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant, the ind-scheme <math id="S4.SS3.p5.m42" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F},\sigma}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow></msub><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F},\sigma}</annotation></semantics></math> acquires a natural <math id="S4.SS3.p5.m43" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-action.</span></p>
</div>
<div id="S4.SS3.p6" class="ltx_para">
<p id="S4.SS3.p6.1" class="ltx_p"><span id="S4.SS3.p6.1.1" class="ltx_text">The data of the <math id="S4.SS3.p6.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S4.SS3.p6.m2" class="ltx_Math" alttext="(\mathcal{E},\zeta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{E},\zeta)</annotation></semantics></math> and the monomorphism <math id="S4.SS3.p6.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is by definition a <math id="S4.SS3.p6.m4" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant section <math id="S4.SS3.p6.m5" class="ltx_Math" alttext="s:Y\setminus(0,0)\rightarrow\Gr_{X_{Y},D,\mathcal{F},\sigma}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">s:Y\setminus(0,0)\rightarrow\Gr_{X_{Y},D,\mathcal{F},\sigma}</annotation></semantics></math> of the structure morphism <math id="S4.SS3.p6.m6" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F},\sigma}\rightarrow Y" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow></msub><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F},\sigma}\rightarrow Y</annotation></semantics></math>. By construction, the composition <math id="S4.SS3.p6.m7" class="ltx_Math" alttext="Y\setminus(0,0)\xrightarrow{s}\Gr_{X_{Y},D,\mathcal{F},\sigma}\xrightarrow{\Forget}\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑠</mo></mover><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow></msub><mover accent="true"><mo>→</mo><mo mathsize="0.800em">Forget</mo></mover><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y\setminus(0,0)\xrightarrow{s}\Gr_{X_{Y},D,\mathcal{F},\sigma}\xrightarrow{\Forget}\Bun_{\rho}(X)</annotation></semantics></math> is the original <math id="S4.SS3.p6.m8" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant morphism <math id="S4.SS3.p6.m9" class="ltx_Math" alttext="f:Y\setminus(0,0)\rightarrow\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f:Y\setminus(0,0)\rightarrow\Bun_{\rho}(X)</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS3.p7" class="ltx_para">
<p id="S4.SS3.p7.1" class="ltx_p"><span id="S4.SS3.p7.1.1" class="ltx_text">It follows from the definition of <math id="S4.SS3.p7.m1" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F}}^{\leq N,P}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F}}^{\leq N,P}</annotation></semantics></math> that the <math id="S4.SS3.p7.m2" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-action on <math id="S4.SS3.p7.m3" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F},\sigma}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow></msub><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F},\sigma}</annotation></semantics></math> preserves each stratum <math id="S4.SS3.p7.m4" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}</annotation></semantics></math>. Since <math id="S4.SS3.p7.m5" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is affine and connected, the map <math id="S4.SS3.p7.m6" class="ltx_Math" alttext="s:Y\setminus(0,0)\rightarrow\Gr_{X_{Y},D,\mathcal{F},\sigma}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">s:Y\setminus(0,0)\rightarrow\Gr_{X_{Y},D,\mathcal{F},\sigma}</annotation></semantics></math> factors through <math id="S4.SS3.p7.m7" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}</annotation></semantics></math> for some <math id="S4.SS3.p7.m8" class="ltx_Math" alttext="N\gg 0" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≫</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">N\gg 0</annotation></semantics></math> and <math id="S4.SS3.p7.m9" class="ltx_Math" alttext="P\in\mathbb{Q}[n]" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P\in\mathbb{Q}[n]</annotation></semantics></math>. Therefore, we have the following commutative diagram with <math id="S4.SS3.p7.m10" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant morphisms.</span></p>
</div>
<div id="S4.SS3.p8" class="ltx_para">
<table id="S4.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S4.Ex32.m1.pic1" class="ltx_picture ltx_markedasmath" height="79.73" overflow="visible" style="vertical-align:-37.31px" version="1.1" viewBox="0 0 328.24 79.73" width="328.24"><g transform="translate(0,79.73) matrix(1 0 0 -1 0 0) translate(164.12,0) translate(0,37.31)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -164.12 -28.79)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 74.62)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.72)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 25.93 0) translate(16.34,0) matrix(1.0 0.0 0.0 1.0 -10.38 0)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">  </span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 84.52 0) translate(80.4,0) matrix(1.0 0.0 0.0 1.0 -41.24 0)"><foreignObject style="--ltx-fo-width:4.96em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.62" overflow="visible" transform="matrix(1 0 0 -1 0 11.66)" width="68.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex32.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 212.12 0) translate(74.67,0) matrix(1.0 0.0 0.0 1.0 -35.5 0)"><foreignObject style="--ltx-fo-width:4.13em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="57.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex32.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Bun_{\rho}(X)}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Bun_{\rho}(X)}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 66.09)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(42.26,0) matrix(1.0 0.0 0.0 1.0 -36.3 0)"><foreignObject style="--ltx-fo-width:4.25em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="58.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex32.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces Y\setminus(0,0)}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces Y\setminus(0,0)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 113.29 0) translate(51.64,0) matrix(1.0 0.0 0.0 1.0 -12.47 0)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="11.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex32.m1.pic1.m5" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces Y}" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces Y}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 0.8 11.29 L 0.8 -13.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 0.8 -13.71)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 48.28 24.04 L 80.38 24.04"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 80.65 24.04)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 43.26 29.99)"><foreignObject style="--ltx-fo-width:3.09em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="42.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex32.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\Forget}" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">Forget</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\Forget}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -91.41 -13.07 L -31.4 11.08"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.92772 0.37328 -0.37328 0.92772 -31.14 11.18)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -69.62 2.36)"><foreignObject style="--ltx-fo-width:0.38em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex32.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces s}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">s</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces s}</annotation></semantics></math></span></span></foreignObject></g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.39998pt" transform="matrix(1.0 0.0 0.0 1.0 -67.83 -25.33)"><foreignObject style="--ltx-fo-width:2.78em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="38.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex32.m1.pic1.m8" class="ltx_Math" alttext="\xhookrightarrow{\;\;\;\;\;\;\;\;\;\;}" display="inline" intent=":literal"><semantics><mover accent="true"><mo class="ltx_mathvariant_italic" mathvariant="italic">↪</mo><mphantom></mphantom></mover><annotation encoding="application/x-tex">\xhookrightarrow{\;\;\;\;\;\;\;\;\;\;}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS3.p9" class="ltx_para">
<p id="S4.SS3.p9.1" class="ltx_p"><span id="S4.SS3.p9.1.1" class="ltx_text">Let <math id="S4.SS3.p9.m1" class="ltx_Math" alttext="\Sigma\subset\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⊂</mo><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Sigma\subset\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}</annotation></semantics></math> denote the scheme theoretic image of <math id="S4.SS3.p9.m2" class="ltx_Math" alttext="Y\setminus(0,0)" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y\setminus(0,0)</annotation></semantics></math> in <math id="S4.SS3.p9.m3" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}</annotation></semantics></math>. Note that <math id="S4.SS3.p9.m4" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is a reduced <math id="S4.SS3.p9.m5" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-scheme with a natural structure morphism to <math id="S4.SS3.p9.m6" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. The map <math id="S4.SS3.p9.m7" class="ltx_Math" alttext="\Sigma\rightarrow Y" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Sigma\rightarrow Y</annotation></semantics></math> is projective, because <math id="S4.SS3.p9.m8" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}</annotation></semantics></math> is projective over <math id="S4.SS3.p9.m9" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> and <math id="S4.SS3.p9.m10" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is a closed subscheme of <math id="S4.SS3.p9.m11" class="ltx_Math" alttext="\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup><annotation encoding="application/x-tex">\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}</annotation></semantics></math>. By construction, the morphism <math id="S4.SS3.p9.m12" class="ltx_Math" alttext="\Sigma\rightarrow Y" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Sigma\rightarrow Y</annotation></semantics></math> is <math id="S4.SS3.p9.m13" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant and restricts to an isomorphism over the open <math id="S4.SS3.p9.m14" class="ltx_Math" alttext="Y\setminus(0,0)" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y\setminus(0,0)</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS3.p10" class="ltx_para">
<p id="S4.SS3.p10.1" class="ltx_p"><span id="S4.SS3.p10.1.1" class="ltx_text">The composition <math id="S4.SS3.p10.m1" class="ltx_Math" alttext="\Sigma\rightarrow\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}\xrightarrow{\Forget}\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msubsup><mi mathsize="0.800em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup><mover accent="true"><mo>→</mo><mo mathsize="0.800em">Forget</mo></mover><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Sigma\rightarrow\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}\xrightarrow{\Forget}\Bun_{\rho}(X)</annotation></semantics></math> restricts to the original <math id="S4.SS3.p10.m2" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>-equivariant morphism <math id="S4.SS3.p10.m3" class="ltx_Math" alttext="f:Y\setminus(0,0)\rightarrow\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f:Y\setminus(0,0)\rightarrow\Bun_{\rho}(X)</annotation></semantics></math> over the open subset <math id="S4.SS3.p10.m4" class="ltx_Math" alttext="Y\setminus(0,0)\,\subset\,\Sigma" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Y</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo rspace="0.130em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.408em">⊂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">Y\setminus(0,0)\,\subset\,\Sigma</annotation></semantics></math>. We therefore obtain a morphism <math id="S4.SS3.p10.m5" class="ltx_Math" alttext="\widetilde{f}:\left[\Sigma/\,\mathbb{G}_{m}\right]\rightarrow\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo mathsize="0.800em">~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo>[</mo><mrow><mi mathvariant="normal">Σ</mi><mo rspace="0.352em">/</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><mo>]</mo></mrow><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{f}:\left[\Sigma/\,\mathbb{G}_{m}\right]\rightarrow\Bun_{\rho}(X)</annotation></semantics></math> satisfying condition (M2) in Definition <a href="#S4.Thmthm14" title="Definition 4.14 (Monotonicity). ‣ 4.3. Monotonicity of the numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a>.</span></p>
</div>
<div id="S4.SS3.p11" class="ltx_para">
<p id="S4.SS3.p11.1" class="ltx_p"><span id="S4.SS3.p11.1.1" class="ltx_text">We are left to check condition (M3) in Definition <a href="#S4.Thmthm14" title="Definition 4.14 (Monotonicity). ‣ 4.3. Monotonicity of the numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a>. By Corollary <a href="#S4.Thmthm13" title="Corollary 4.13. ‣ 4.2. Affine Grassmannians for 
          
            ρ
          
        -sheaves ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.13</span></a>, there exists some <math id="S4.SS3.p11.m1" class="ltx_Math" alttext="M\gg 0" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>≫</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M\gg 0</annotation></semantics></math> such that for all <math id="S4.SS3.p11.m2" class="ltx_Math" alttext="n\geq M" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">n\geq M</annotation></semantics></math> the restriction <math id="S4.SS3.p11.m3" class="ltx_Math" alttext="L_{n}^{\vee}|_{\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}}" display="inline" intent=":literal"><semantics><msub><mrow><msubsup><mi>L</mi><mi>n</mi><mo>∨</mo></msubsup><mo stretchy="false">|</mo></mrow><msubsup><mi mathsize="1.140em">Gr</mi><mrow><msub><mi>X</mi><mi>Y</mi></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi></mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mi>P</mi></mrow></msubsup></msub><annotation encoding="application/x-tex">L_{n}^{\vee}|_{\Gr_{X_{Y},D,\mathcal{F},\sigma}^{\leq N,P}}</annotation></semantics></math> is <math id="S4.SS3.p11.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>-ample, and therefore we can conclude (M3) exactly as in the end of the proof of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Thm. 4.8]</cite>.
∎</span></p>
</div>
</div>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.4. </span>HN boundedness</h3>

<div id="S4.SS4.p1" class="ltx_para">
<p id="S4.SS4.p1.1" class="ltx_p">We start by recalling the definition of HN boundedness (see also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">HL14</a>, §5]</cite> or <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, §2.5]</cite>).</p>
</div>
<div id="S4.Thmthm16" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm16.2" class="ltx_text ltx_font_bold">Definition 4.16</span></span><span id="S4.Thmthm16.3" class="ltx_text ltx_font_bold"> </span>(HN Boundedness)<span id="S4.Thmthm16.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm16.p1" class="ltx_para">
<p id="S4.Thmthm16.p1.1" class="ltx_p"><span id="S4.Thmthm16.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm16.p1.m1" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> be an algebraic stack locally of finite type over <math id="S4.Thmthm16.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Let <math id="S4.Thmthm16.p1.m3" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> be a polynomial numerical invariant on <math id="S4.Thmthm16.p1.m4" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math>. We say that <math id="S4.Thmthm16.p1.m5" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> satisfies the HN boundedness condition if the following is true.</span></p>
</div>
<div id="S4.Thmthm16.p2" class="ltx_para">
<p id="S4.Thmthm16.p2.1" class="ltx_p"><span id="S4.Thmthm16.p2.1.1" class="ltx_text ltx_font_italic">Choose an algebraically closed field extension <math id="S4.Thmthm16.p2.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math>. Let <math id="S4.Thmthm16.p2.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a scheme of finite type over <math id="S4.Thmthm16.p2.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and let <math id="S4.Thmthm16.p2.m4" class="ltx_Math" alttext="g:S\rightarrow\mathcal{M}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></mrow><annotation encoding="application/x-tex">g:S\rightarrow\mathcal{M}</annotation></semantics></math> be a morphism. Then, there exists a quasicompact open substack <math id="S4.Thmthm16.p2.m5" class="ltx_Math" alttext="\mathcal{U}_{S}\subset\mathcal{M}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>S</mi></msub><mo>⊂</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow><annotation encoding="application/x-tex">\mathcal{U}_{S}\subset\mathcal{M}</annotation></semantics></math> such that the following holds:
For all closed points <math id="S4.Thmthm16.p2.m6" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math> and all nondegenerate filtrations <math id="S4.Thmthm16.p2.m7" class="ltx_Math" alttext="f:\Theta\rightarrow\mathcal{M}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Θ</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\Theta\rightarrow\mathcal{M}</annotation></semantics></math> of the point <math id="S4.Thmthm16.p2.m8" class="ltx_Math" alttext="g(s)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(s)</annotation></semantics></math> with <math id="S4.Thmthm16.p2.m9" class="ltx_Math" alttext="\nu(f)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu(f)&gt;0</annotation></semantics></math>, there exists another filtration <math id="S4.Thmthm16.p2.m10" class="ltx_Math" alttext="f^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>′</mo></msup><annotation encoding="application/x-tex">f^{\prime}</annotation></semantics></math> of <math id="S4.Thmthm16.p2.m11" class="ltx_Math" alttext="g(s)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(s)</annotation></semantics></math> satisfying <math id="S4.Thmthm16.p2.m12" class="ltx_Math" alttext="\nu(f^{\prime})\geq\nu(f)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(f^{\prime})\geq\nu(f)</annotation></semantics></math> and <math id="S4.Thmthm16.p2.m13" class="ltx_Math" alttext="f^{\prime}(0)\in\mathcal{U}_{S}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">f^{\prime}(0)\in\mathcal{U}_{S}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS4.p2" class="ltx_para">
<p id="S4.SS4.p2.1" class="ltx_p">In the case of <math id="S4.SS4.p2.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> we can reduce HN boundedness to a more concrete statement.</p>
</div>
<div id="S4.Thmthm17" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm17.2" class="ltx_text ltx_font_bold">Lemma 4.17</span></span><span id="S4.Thmthm17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm17.p1" class="ltx_para">
<p id="S4.Thmthm17.p1.1" class="ltx_p"><span id="S4.Thmthm17.p1.1.1" class="ltx_text ltx_font_italic">In order to show that <math id="S4.Thmthm17.p1.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> satisfies HN boundedness on the stack <math id="S4.Thmthm17.p1.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>, it is sufficient to prove the following statement.</span></p>
</div>
<div id="S4.Thmthm17.p2" class="ltx_para">
<p id="S4.Thmthm17.p2.1" class="ltx_p"><span id="S4.Thmthm17.p2.1.1" class="ltx_text ltx_font_italic">(*) Let <math id="S4.Thmthm17.p2.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be an algebraically closed field extension of <math id="S4.Thmthm17.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Let <math id="S4.Thmthm17.p2.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a scheme of finite type over <math id="S4.Thmthm17.p2.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Let <math id="S4.Thmthm17.p2.m5" class="ltx_Math" alttext="g:S\rightarrow\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g:S\rightarrow\Bun_{\rho}(X)</annotation></semantics></math> be a morphism represented by a <math id="S4.Thmthm17.p2.m6" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S4.Thmthm17.p2.m7" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> on <math id="S4.Thmthm17.p2.m8" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>. Then, there exists a real number <math id="S4.Thmthm17.p2.m9" class="ltx_Math" alttext="C_{S}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>S</mi></msub><annotation encoding="application/x-tex">C_{S}</annotation></semantics></math> such that the following holds:
For all closed points <math id="S4.Thmthm17.p2.m10" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math> and all nondegenerate weighted parabolic reductions <math id="S4.Thmthm17.p2.m11" class="ltx_Math" alttext="f=(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> of the point <math id="S4.Thmthm17.p2.m12" class="ltx_Math" alttext="(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math> with <math id="S4.Thmthm17.p2.m13" class="ltx_Math" alttext="\nu(f)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu(f)&gt;0</annotation></semantics></math>, there exists another weighted parabolic reduction <math id="S4.Thmthm17.p2.m14" class="ltx_Math" alttext="f^{\prime}=(\lambda^{\prime},\mathcal{G}_{\lambda^{\prime}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>λ</mi><mo>′</mo></msup><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>λ</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{\prime}=(\lambda^{\prime},\mathcal{G}_{\lambda^{\prime}})</annotation></semantics></math> of <math id="S4.Thmthm17.p2.m15" class="ltx_Math" alttext="(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math> with underlying associated filtration <math id="S4.Thmthm17.p2.m16" class="ltx_Math" alttext="(\mathcal{F}^{\prime}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\prime}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> such that the following are satisfied.</span></p>
<ol id="S4.I5" class="ltx_enumerate">
<li id="S4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I5.i1.p1" class="ltx_para">
<p id="S4.I5.i1.p1.1" class="ltx_p"><math id="S4.I5.i1.p1.m1" class="ltx_Math" alttext="\nu(f^{\prime})\geq\nu(f)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(f^{\prime})\geq\nu(f)</annotation></semantics></math><span id="S4.I5.i1.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I5.i2.p1" class="ltx_para">
<p id="S4.I5.i2.p1.1" class="ltx_p"><span id="S4.I5.i2.p1.1.1" class="ltx_text ltx_font_italic">We have </span><math id="S4.I5.i2.p1.m1" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{F}^{\prime}_{m}/\mathcal{F}^{\prime}_{m+1})\geq C_{S}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mo>′</mo></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>C</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{F}^{\prime}_{m}/\mathcal{F}^{\prime}_{m+1})\geq C_{S}</annotation></semantics></math><span id="S4.I5.i2.p1.1.2" class="ltx_text ltx_font_italic"> for all </span><math id="S4.I5.i2.p1.m2" class="ltx_Math" alttext="m\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">m\in\mathbb{Z}</annotation></semantics></math><span id="S4.I5.i2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS4.p3" class="ltx_para">
<p id="S4.SS4.p3.1" class="ltx_p"><span id="S4.SS4.p3.1.1" class="ltx_text">We can replace <math id="S4.SS4.p3.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> by <math id="S4.SS4.p3.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> in order to assume that the ground field is algebraically closed. Then, all reductive groups are automatically split. By Proposition <a href="#S3.Thmthm16" title="Proposition 3.16. ‣ 3.3. Filtrations of 
          
            ρ
          
        -sheaves in the split case ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.16</span></a>, all filtrations of <math id="S4.SS4.p3.m3" class="ltx_Math" alttext="(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math> arise from weighted parabolic reductions of <math id="S4.SS4.p3.m4" class="ltx_Math" alttext="(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math>. Let <math id="S4.SS4.p3.m5" class="ltx_Math" alttext="\mathfrak{S}" display="inline" intent=":literal"><semantics><mi>𝔖</mi><annotation encoding="application/x-tex">\mathfrak{S}</annotation></semantics></math> denote the set of all pairs <math id="S4.SS4.p3.m6" class="ltx_Math" alttext="(s,f^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,f^{\prime})</annotation></semantics></math>, where <math id="S4.SS4.p3.m7" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math> is a closed point and <math id="S4.SS4.p3.m8" class="ltx_Math" alttext="f^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>′</mo></msup><annotation encoding="application/x-tex">f^{\prime}</annotation></semantics></math> is a weighted parabolic reduction of <math id="S4.SS4.p3.m9" class="ltx_Math" alttext="(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math> satisfying <math id="S4.SS4.p3.m10" class="ltx_Math" alttext="(2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2)</annotation></semantics></math> above. It suffices to show that the set of associated graded points <math id="S4.SS4.p3.m11" class="ltx_Math" alttext="\mathfrak{S}_{2}\vcentcolon=\left\{\;f^{\prime}(0)\;\text{ for $(s,f^{\prime})\in\mathfrak{S}$}\;\;\right\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔖</mi><mn>2</mn></msub><mo>:=</mo><mrow><mo rspace="0.220em">{</mo><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo lspace="0.220em" rspace="0em">​</mo><mrow><mtext> for </mtext><mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>𝔖</mi></mrow></mrow></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{S}_{2}\vcentcolon=\left\{\;f^{\prime}(0)\;\text{ for $(s,f^{\prime})\in\mathfrak{S}$}\;\;\right\}</annotation></semantics></math>
is contained in a quasicompact open substack of <math id="S4.SS4.p3.m12" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>. Recall that we have a forgetful morphism <math id="S4.SS4.p3.m13" class="ltx_Math" alttext="\Forget:\Bun_{\rho}(X)\rightarrow\Coh_{r}^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Forget</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi mathsize="0.800em">Coh</mi><mi>r</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Forget:\Bun_{\rho}(X)\rightarrow\Coh_{r}^{tf}(X)</annotation></semantics></math> into the stack of rank <math id="S4.SS4.p3.m14" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> torsion-free sheaves on <math id="S4.SS4.p3.m15" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. By Proposition <a href="#S3.Thmthm6" title="Proposition 3.6. ‣ 3.1. Principal 
          
            ρ
          
        -sheaves and the moduli stack 
          
            
              ⁢
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>, the morphism <math id="S4.SS4.p3.m16" class="ltx_Math" alttext="\Forget" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">Forget</mi><annotation encoding="application/x-tex">\Forget</annotation></semantics></math> is of finite type. Hence it is sufficient to prove that the set <math id="S4.SS4.p3.m17" class="ltx_Math" alttext="\mathfrak{S}_{3}\vcentcolon=\left\{\;\;\Forget(f^{\prime}(0))\;\text{ for $(s,f^{\prime})\in\mathfrak{S}$}\;\;\right\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔖</mi><mn>3</mn></msub><mo>:=</mo><mrow><mo rspace="0.440em">{</mo><mrow><mrow><mi mathsize="0.800em">Forget</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.220em" rspace="0em">​</mo><mrow><mtext> for </mtext><mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>𝔖</mi></mrow></mrow></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{S}_{3}\vcentcolon=\left\{\;\;\Forget(f^{\prime}(0))\;\text{ for $(s,f^{\prime})\in\mathfrak{S}$}\;\;\right\}</annotation></semantics></math> is contained in a quasicompact open substack of <math id="S4.SS4.p3.m18" class="ltx_Math" alttext="\Coh_{r}^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">Coh</mi><mi>r</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Coh_{r}^{tf}(X)</annotation></semantics></math>. Let <math id="S4.SS4.p3.m19" class="ltx_Math" alttext="\mathfrak{S}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔖</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathfrak{S}^{\prime}</annotation></semantics></math> denote the set of pairs <math id="S4.SS4.p3.m20" class="ltx_Math" alttext="(s,(\mathcal{F}_{m})_{m\in\mathbb{Z}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,(\mathcal{F}_{m})_{m\in\mathbb{Z}})</annotation></semantics></math>, where <math id="S4.SS4.p3.m21" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math> is a closed point and <math id="S4.SS4.p3.m22" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> is a decreasing <math id="S4.SS4.p3.m23" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-filtration of the sheaf <math id="S4.SS4.p3.m24" class="ltx_Math" alttext="\mathcal{F}|_{X_{s}}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{F}|_{X_{s}}</annotation></semantics></math> such that <math id="S4.SS4.p3.m25" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{F}_{m}/\mathcal{F}_{m+1})\geq C_{S}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>C</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{F}_{m}/\mathcal{F}_{m+1})\geq C_{S}</annotation></semantics></math> for all <math id="S4.SS4.p3.m26" class="ltx_Math" alttext="m\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">m\in\mathbb{Z}</annotation></semantics></math>. It is sufficient to prove that the set of sheaves</span></p>
<table id="S4.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex33.m1" class="ltx_Math" alttext="\mathfrak{S}^{\prime}_{1}=\left\{\;\;\;\bigoplus_{m\in\mathbb{Z}}\mathcal{F}_{m}/\mathcal{F}_{m+1}\;\text{ \; \; \; for $(s,(\mathcal{F}_{m})_{m\in\mathbb{Z}})\in\mathfrak{S}^{\prime}$ }\;\;\;\right\}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝔖</mi><mn>1</mn><mo>′</mo></msubsup><mo>=</mo><mrow><mo rspace="0.493em">{</mo><mrow><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mtext> for </mtext><mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>𝔖</mi><mo>′</mo></msup></mrow><mtext> </mtext></mrow></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{S}^{\prime}_{1}=\left\{\;\;\;\bigoplus_{m\in\mathbb{Z}}\mathcal{F}_{m}/\mathcal{F}_{m+1}\;\text{ \; \; \; for $(s,(\mathcal{F}_{m})_{m\in\mathbb{Z}})\in\mathfrak{S}^{\prime}$ }\;\;\;\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p3.2" class="ltx_p"><span id="S4.SS4.p3.2.1" class="ltx_text">is contained in a quasicompact open substack of <math id="S4.SS4.p3.m27" class="ltx_Math" alttext="\Coh_{r}^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">Coh</mi><mi>r</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Coh_{r}^{tf}(X)</annotation></semantics></math>. This follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Lemma 5.4]</cite>.
∎</span></p>
</div>
</div>
<div id="S4.SS4.p4" class="ltx_para">
<p id="S4.SS4.p4.1" class="ltx_p">To prove HN boundedness for <math id="S4.SS4.p4.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> in Proposition <a href="#S4.Thmthm25" title="Proposition 4.25. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.25</span></a>, we need to understand how the numerical invariant changes for parabolic subgroups associated to different filtrations. We will use Lemma <a href="#S4.Thmthm17" title="Lemma 4.17. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.17</span></a>. After replacing <math id="S4.SS4.p4.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> with the extension <math id="S4.SS4.p4.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, we can assume that the ground field is algebraically closed (in particular all tori are automatically split). Fix a <math id="S4.SS4.p4.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S4.SS4.p4.m5" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> on <math id="S4.SS4.p4.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Let <math id="S4.SS4.p4.m7" class="ltx_Math" alttext="j:U\hookrightarrow X" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">↪</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">j:U\hookrightarrow X</annotation></semantics></math> be a big open subset such that <math id="S4.SS4.p4.m8" class="ltx_Math" alttext="\mathcal{F}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{F}|_{U}</annotation></semantics></math> is locally-free. We will develop some setup and prove some preliminary lemmas before the proof of HN boundedness.</p>
</div>
<div id="S4.SS4.p5" class="ltx_para">
<p id="S4.SS4.p5.1" class="ltx_p">Let <math id="S4.SS4.p5.m1" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> denote the maximal central torus of <math id="S4.SS4.p5.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Let <math id="S4.SS4.p5.m3" class="ltx_Math" alttext="X_{*}(Z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z)</annotation></semantics></math> denote the group of cocharacters of <math id="S4.SS4.p5.m4" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>. We denote by <math id="S4.SS4.p5.m5" class="ltx_Math" alttext="X^{*}(Z)" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X^{*}(Z)</annotation></semantics></math> the dual group of characters of <math id="S4.SS4.p5.m6" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>. Set <math id="S4.SS4.p5.m7" class="ltx_Math" alttext="X_{*}(Z)_{\mathbb{R}}\vcentcolon=X_{*}(Z)\otimes\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo>:=</mo><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z)_{\mathbb{R}}\vcentcolon=X_{*}(Z)\otimes\mathbb{R}</annotation></semantics></math> and similarly <math id="S4.SS4.p5.m8" class="ltx_Math" alttext="X^{*}(Z)_{\mathbb{R}}\vcentcolon=X^{*}(Z)\otimes\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo>:=</mo><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">X^{*}(Z)_{\mathbb{R}}\vcentcolon=X^{*}(Z)\otimes\mathbb{R}</annotation></semantics></math>. We fix once and for all a basis <math id="S4.SS4.p5.m9" class="ltx_Math" alttext="z_{1},\ldots,z_{h}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">z_{1},\ldots,z_{h}</annotation></semantics></math> of <math id="S4.SS4.p5.m10" class="ltx_Math" alttext="X_{*}(Z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z)</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.p6" class="ltx_para">
<p id="S4.SS4.p6.1" class="ltx_p">Let <math id="S4.SS4.p6.m1" class="ltx_Math" alttext="f=(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> be a weighted parabolic filtration of <math id="S4.SS4.p6.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>, and let <math id="S4.SS4.p6.m3" class="ltx_Math" alttext="P_{\lambda}\subset G" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>λ</mi></msub><mo>⊂</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">P_{\lambda}\subset G</annotation></semantics></math> be the parabolic subgroup associated to <math id="S4.SS4.p6.m4" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>. Choose a maximal torus <math id="S4.SS4.p6.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> of <math id="S4.SS4.p6.m6" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math> containing the image of the cocharacter <math id="S4.SS4.p6.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>. Set <math id="S4.SS4.p6.m8" class="ltx_Math" alttext="T^{\prime}:=T\cap[G,G]" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>:=</mo><mrow><mi>T</mi><mo>∩</mo><mrow><mo stretchy="false">[</mo><mrow><mi>G</mi><mo>,</mo><mi>G</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T^{\prime}:=T\cap[G,G]</annotation></semantics></math>, the intersection of <math id="S4.SS4.p6.m9" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> with the derived subgroup <math id="S4.SS4.p6.m10" class="ltx_Math" alttext="[G,G]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>G</mi><mo>,</mo><mi>G</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[G,G]</annotation></semantics></math> of <math id="S4.SS4.p6.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Denote the groups of cocharacters of <math id="S4.SS4.p6.m12" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and <math id="S4.SS4.p6.m13" class="ltx_Math" alttext="T^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>′</mo></msup><annotation encoding="application/x-tex">T^{\prime}</annotation></semantics></math> by <math id="S4.SS4.p6.m14" class="ltx_Math" alttext="X_{*}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X_{*}(T)</annotation></semantics></math> and <math id="S4.SS4.p6.m15" class="ltx_Math" alttext="X_{*}(T^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X_{*}(T^{\prime})</annotation></semantics></math> respectively. Observe that there are natural inclusions <math id="S4.SS4.p6.m16" class="ltx_Math" alttext="X_{*}(Z)_{\mathbb{R}}\hookrightarrow X_{*}(T)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo stretchy="false">↪</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z)_{\mathbb{R}}\hookrightarrow X_{*}(T)_{\mathbb{R}}</annotation></semantics></math> and <math id="S4.SS4.p6.m17" class="ltx_Math" alttext="X_{*}(T^{\prime})_{\mathbb{R}}\hookrightarrow X_{*}(T)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo stretchy="false">↪</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X_{*}(T^{\prime})_{\mathbb{R}}\hookrightarrow X_{*}(T)_{\mathbb{R}}</annotation></semantics></math>. These induce a direct sum decomposition <math id="S4.SS4.p6.m18" class="ltx_Math" alttext="X_{*}(T)_{\mathbb{R}}=X_{*}(Z)_{\mathbb{R}}\oplus X_{*}(T^{\prime})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo>=</mo><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo>⊕</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{*}(T)_{\mathbb{R}}=X_{*}(Z)_{\mathbb{R}}\oplus X_{*}(T^{\prime})_{\mathbb{R}}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.p7" class="ltx_para">
<p id="S4.SS4.p7.1" class="ltx_p">Choose a Borel subgroup <math id="S4.SS4.p7.m1" class="ltx_Math" alttext="B\supset T" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⊃</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">B\supset T</annotation></semantics></math> contained in <math id="S4.SS4.p7.m2" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math>. This yields a set of simple roots <math id="S4.SS4.p7.m3" class="ltx_Math" alttext="\Delta=\{\alpha_{1},\alpha_{2},\ldots,\alpha_{l}\}\subset X_{*}(T^{\prime})_{\mathbb{R}}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>α</mi><mi>l</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow><mo>⊂</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mi>ℝ</mi><mo>∨</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta=\{\alpha_{1},\alpha_{2},\ldots,\alpha_{l}\}\subset X_{*}(T^{\prime})_{\mathbb{R}}^{\vee}</annotation></semantics></math>, where <math id="S4.SS4.p7.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> is the rank of <math id="S4.SS4.p7.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, which form a basis for <math id="S4.SS4.p7.m6" class="ltx_Math" alttext="X^{*}(T^{\prime})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X^{*}(T^{\prime})_{\mathbb{R}}</annotation></semantics></math>. Denote by <math id="S4.SS4.p7.m7" class="ltx_Math" alttext="\omega_{i}^{\vee}\in X_{*}(T^{\prime})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ω</mi><mi>i</mi><mo>∨</mo></msubsup><mo>∈</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\omega_{i}^{\vee}\in X_{*}(T^{\prime})_{\mathbb{R}}</annotation></semantics></math> the fundamental coweight dual to the simple root <math id="S4.SS4.p7.m8" class="ltx_Math" alttext="\alpha_{i}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\alpha_{i}</annotation></semantics></math> and define the ordered basis <math id="S4.SS4.p7.m9" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> of the vector space <math id="S4.SS4.p7.m10" class="ltx_Math" alttext="X_{*}(T)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X_{*}(T)_{\mathbb{R}}</annotation></semantics></math> as <math id="S4.SS4.p7.m11" class="ltx_Math" alttext="\mathcal{B}=(z_{1},z_{2},\ldots,z_{h},\omega_{1}^{\vee},\omega_{2}^{\vee},\ldots,\omega^{\vee}_{l})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><msub><mi>z</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><mi>h</mi></msub><mo>,</mo><msubsup><mi>ω</mi><mn>1</mn><mo>∨</mo></msubsup><mo>,</mo><msubsup><mi>ω</mi><mn>2</mn><mo>∨</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>ω</mi><mi>l</mi><mo>∨</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{B}=(z_{1},z_{2},\ldots,z_{h},\omega_{1}^{\vee},\omega_{2}^{\vee},\ldots,\omega^{\vee}_{l})</annotation></semantics></math>.
This induces a dual basis <math id="S4.SS4.p7.m12" class="ltx_Math" alttext="\mathcal{B}^{\vee}=(z_{1}^{\vee},z_{2}^{\vee},\ldots,z_{h}^{\vee},\alpha_{1},\alpha_{2},\ldots,\alpha_{l})" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∨</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mn>1</mn><mo>∨</mo></msubsup><mo>,</mo><msubsup><mi>z</mi><mn>2</mn><mo>∨</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>z</mi><mi>h</mi><mo>∨</mo></msubsup><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>α</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{B}^{\vee}=(z_{1}^{\vee},z_{2}^{\vee},\ldots,z_{h}^{\vee},\alpha_{1},\alpha_{2},\ldots,\alpha_{l})</annotation></semantics></math> on the dual vector space <math id="S4.SS4.p7.m13" class="ltx_Math" alttext="X^{*}(T)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X^{*}(T)_{\mathbb{R}}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.p8" class="ltx_para">
<p id="S4.SS4.p8.1" class="ltx_p">The torus <math id="S4.SS4.p8.m1" class="ltx_Math" alttext="T\subset G" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⊂</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">T\subset G</annotation></semantics></math> acts on the representation <math id="S4.SS4.p8.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>. Choose a decomposition of <math id="S4.SS4.p8.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> as a direct sum of one-dimensional weight spaces <math id="S4.SS4.p8.m4" class="ltx_Math" alttext="V=\bigoplus_{i=1}^{r}V_{\chi_{i}}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><msub><mi>V</mi><msub><mi>χ</mi><mi>i</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">V=\bigoplus_{i=1}^{r}V_{\chi_{i}}</annotation></semantics></math> where <math id="S4.SS4.p8.m5" class="ltx_Math" alttext="(\chi_{i})_{i=1}^{r}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">(\chi_{i})_{i=1}^{r}</annotation></semantics></math> is an ordered <math id="S4.SS4.p8.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>-tuple of characters in <math id="S4.SS4.p8.m7" class="ltx_Math" alttext="X^{*}(T)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X^{*}(T)_{\mathbb{R}}</annotation></semantics></math> with some possible repetitions.</p>
</div>
<div id="S4.Thmthm18" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm18.2" class="ltx_text ltx_font_bold">Definition 4.18</span></span><span id="S4.Thmthm18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm18.p1" class="ltx_para">
<p id="S4.Thmthm18.p1.1" class="ltx_p"><span id="S4.Thmthm18.p1.1.1" class="ltx_text ltx_font_italic">Using coordinates in the dual basis <math id="S4.Thmthm18.p1.m1" class="ltx_Math" alttext="\mathcal{B}^{\vee}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∨</mo></msup><annotation encoding="application/x-tex">\mathcal{B}^{\vee}</annotation></semantics></math>, we denote by <math id="S4.Thmthm18.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> the <math id="S4.Thmthm18.p1.m3" class="ltx_Math" alttext="(h+l)\times r" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>h</mi><mo>+</mo><mi>l</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">(h+l)\times r</annotation></semantics></math>-matrix with coefficients in <math id="S4.Thmthm18.p1.m4" class="ltx_Math" alttext="\mathbb{Q}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">\mathbb{Q}</annotation></semantics></math> corresponding to the tuple <math id="S4.Thmthm18.p1.m5" class="ltx_Math" alttext="(\chi_{i})_{i=1}^{r}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">(\chi_{i})_{i=1}^{r}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS4.p9" class="ltx_para">
<p id="S4.SS4.p9.1" class="ltx_p">The matrix <math id="S4.SS4.p9.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> does not depend on the choice of torus <math id="S4.SS4.p9.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and Borel subgroup <math id="S4.SS4.p9.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> (once we fix the basis of <math id="S4.SS4.p9.m4" class="ltx_Math" alttext="X_{*}(Z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z)</annotation></semantics></math>), because all torus-Borel pairs <math id="S4.SS4.p9.m5" class="ltx_Math" alttext="T\subset B" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⊂</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">T\subset B</annotation></semantics></math> are conjugate in <math id="S4.SS4.p9.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.p10" class="ltx_para">
<p id="S4.SS4.p10.1" class="ltx_p">The parabolic <math id="S4.SS4.p10.m1" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math> determines a subset <math id="S4.SS4.p10.m2" class="ltx_Math" alttext="I_{P_{\lambda}}\subset\Delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><mo>⊂</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">I_{P_{\lambda}}\subset\Delta</annotation></semantics></math> consisting of those simple roots <math id="S4.SS4.p10.m3" class="ltx_Math" alttext="\alpha_{i}\in\Delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>i</mi></msub><mo>∈</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">\alpha_{i}\in\Delta</annotation></semantics></math> such that the root group <math id="S4.SS4.p10.m4" class="ltx_Math" alttext="U_{-\alpha_{i}}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mrow><mo>−</mo><msub><mi>α</mi><mi>i</mi></msub></mrow></msub><annotation encoding="application/x-tex">U_{-\alpha_{i}}</annotation></semantics></math> corresponding to <math id="S4.SS4.p10.m5" class="ltx_Math" alttext="-\alpha_{i}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>α</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">-\alpha_{i}</annotation></semantics></math> is not contained in <math id="S4.SS4.p10.m6" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math> (e.g. we have <math id="S4.SS4.p10.m7" class="ltx_Math" alttext="I_{B}=\Delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>B</mi></msub><mo>=</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">I_{B}=\Delta</annotation></semantics></math> and <math id="S4.SS4.p10.m8" class="ltx_Math" alttext="I_{G}=\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>G</mi></msub><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">I_{G}=\emptyset</annotation></semantics></math>). Let <math id="S4.SS4.p10.m9" class="ltx_Math" alttext="J_{P_{\lambda}}\subset\{1,2,\ldots,l\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><mo>⊂</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>l</mi></mrow><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow></mrow><annotation encoding="application/x-tex">J_{P_{\lambda}}\subset\{1,2,\ldots,l\}</annotation></semantics></math> be the set of indexes such that <math id="S4.SS4.p10.m10" class="ltx_Math" alttext="I_{P_{\lambda}}=\{\alpha_{j}\;\mid\;j\in J_{P_{\lambda}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><mo>=</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><msub><mi>α</mi><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0.220em">∣</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow></mrow><annotation encoding="application/x-tex">I_{P_{\lambda}}=\{\alpha_{j}\;\mid\;j\in J_{P_{\lambda}}\}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm19" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm19.2" class="ltx_text ltx_font_bold">Definition 4.19</span></span><span id="S4.Thmthm19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm19.p1" class="ltx_para">
<p id="S4.Thmthm19.p1.1" class="ltx_p"><span id="S4.Thmthm19.p1.1.1" class="ltx_text ltx_font_italic">We define <math id="S4.Thmthm19.p1.m1" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math> to be the closed <math id="S4.Thmthm19.p1.m2" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math>-span of the cone of <math id="S4.Thmthm19.p1.m3" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math>-dominant coweights in <math id="S4.Thmthm19.p1.m4" class="ltx_Math" alttext="X_{*}(T)_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X_{*}(T)_{\mathbb{R}}</annotation></semantics></math>, with the origin removed:</span></p>
<table id="S4.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex34.m1" class="ltx_Math" alttext="\mathcal{C}_{\lambda}=\left(\sum_{i=1}^{h}\mathbb{R}z_{i}+\sum_{j\in J_{P_{\lambda}}}\mathbb{R}^{\geq 0}\omega^{\vee}_{j}\right)\setminus\{0\}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></munderover><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>i</mi></msub></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi>J</mi><msub><mi>P</mi><mi>λ</mi></msub></msub></mrow></munder><mrow><msup><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>j</mi><mo>∨</mo></msubsup></mrow></mrow></mrow><mo>)</mo></mrow><mo>∖</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mn>0</mn><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}=\left(\sum_{i=1}^{h}\mathbb{R}z_{i}+\sum_{j\in J_{P_{\lambda}}}\mathbb{R}^{\geq 0}\omega^{\vee}_{j}\right)\setminus\{0\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS4.p11" class="ltx_para">
<p id="S4.SS4.p11.1" class="ltx_p">For any cocharacter <math id="S4.SS4.p11.m1" class="ltx_Math" alttext="\delta\in\mathcal{C}_{\lambda}\cap X_{*}(T)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo>∩</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\in\mathcal{C}_{\lambda}\cap X_{*}(T)</annotation></semantics></math>, let <math id="S4.SS4.p11.m2" class="ltx_Math" alttext="P_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">P_{\delta}</annotation></semantics></math> be its associated parabolic subgroup. Note that <math id="S4.SS4.p11.m3" class="ltx_Math" alttext="P_{\delta}\supset P_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>δ</mi></msub><mo>⊃</mo><msub><mi>P</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">P_{\delta}\supset P_{\lambda}</annotation></semantics></math>. To every such <math id="S4.SS4.p11.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> we can associate a weighted parabolic reduction <math id="S4.SS4.p11.m5" class="ltx_Math" alttext="(\delta,\mathcal{G}_{\delta})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\delta,\mathcal{G}_{\delta})</annotation></semantics></math>, where <math id="S4.SS4.p11.m6" class="ltx_Math" alttext="\mathcal{G}_{\delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\delta}</annotation></semantics></math> is the <math id="S4.SS4.p11.m7" class="ltx_Math" alttext="P_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">P_{\delta}</annotation></semantics></math>-bundle obtained from the <math id="S4.SS4.p11.m8" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math>-bundle <math id="S4.SS4.p11.m9" class="ltx_Math" alttext="\mathcal{G}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\lambda}</annotation></semantics></math> via extension of structure group. The evaluation of the numerical invariant <math id="S4.SS4.p11.m10" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> on these weighted parabolic reductions <math id="S4.SS4.p11.m11" class="ltx_Math" alttext="(\delta,\mathcal{G}_{\delta})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\delta,\mathcal{G}_{\delta})</annotation></semantics></math> defines a function</p>
<table id="S4.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex35.m1" class="ltx_Math" alttext="\nu:\mathcal{C}_{\lambda}\cap X_{*}(T)\rightarrow\mathbb{R}[n],\;\;\;\delta\mapsto\nu(\delta,\mathcal{G}_{\delta})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ν</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo>∩</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>ℝ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mi>δ</mi><mo stretchy="false">↦</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nu:\mathcal{C}_{\lambda}\cap X_{*}(T)\rightarrow\mathbb{R}[n],\;\;\;\delta\mapsto\nu(\delta,\mathcal{G}_{\delta}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p11.2" class="ltx_p">By the formula in Proposition <a href="#S4.Thmthm4" title="Proposition 4.4. ‣ 4.1. The numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>, the polynomial <math id="S4.SS4.p11.m12" class="ltx_Math" alttext="\nu(\delta,\mathcal{G}_{\delta})" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(\delta,\mathcal{G}_{\delta})</annotation></semantics></math> has degree less than or equal to <math id="S4.SS4.p11.m13" class="ltx_Math" alttext="d-1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d-1</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm20" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm20.2" class="ltx_text ltx_font_bold">Definition 4.20</span></span><span id="S4.Thmthm20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm20.p1" class="ltx_para">
<p id="S4.Thmthm20.p1.1" class="ltx_p"><span id="S4.Thmthm20.p1.1.1" class="ltx_text ltx_font_italic">We define <math id="S4.Thmthm20.p1.m1" class="ltx_Math" alttext="\nu_{d-1}:\mathcal{C}_{\lambda}\cap X_{*}(T)\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo>∩</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}:\mathcal{C}_{\lambda}\cap X_{*}(T)\rightarrow\mathbb{R}</annotation></semantics></math> to be the function that associates to each <math id="S4.Thmthm20.p1.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> the degree <math id="S4.Thmthm20.p1.m3" class="ltx_Math" alttext="(d-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d-1)</annotation></semantics></math>-coefficient of the polynomial <math id="S4.Thmthm20.p1.m4" class="ltx_Math" alttext="\nu(\delta,\mathcal{G}_{\delta})" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(\delta,\mathcal{G}_{\delta})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS4.p12" class="ltx_para">
<p id="S4.SS4.p12.1" class="ltx_p">We denote by <math id="S4.SS4.p12.m1" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math> the unique Levi subgroup of the parabolic <math id="S4.SS4.p12.m2" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math> containing the maximal torus <math id="S4.SS4.p12.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, as described in Subsection <a href="#S3.SS3" title="3.3. Filtrations of 
          
            ρ
          
        -sheaves in the split case ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>. Let <math id="S4.SS4.p12.m4" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math> be the maximal central torus of <math id="S4.SS4.p12.m5" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>. For each <math id="S4.SS4.p12.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, let <math id="S4.SS4.p12.m7" class="ltx_Math" alttext="\chi_{i}^{\lambda}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><annotation encoding="application/x-tex">\chi_{i}^{\lambda}</annotation></semantics></math> be the restriction of the character <math id="S4.SS4.p12.m8" class="ltx_Math" alttext="\chi_{i}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\chi_{i}</annotation></semantics></math> to <math id="S4.SS4.p12.m9" class="ltx_Math" alttext="X_{*}(Z_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z_{\lambda})</annotation></semantics></math>. Set <math id="S4.SS4.p12.m10" class="ltx_Math" alttext="V_{\chi^{\lambda}_{i}}=\bigoplus_{\{j\,\mid\,\chi^{\lambda}_{j}=\chi^{\lambda}_{i}\}}V_{\chi^{\lambda}_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>j</mi><mo fence="true" lspace="0.130em" rspace="0.130em">∣</mo><mrow><msubsup><mi>χ</mi><mi>j</mi><mi>λ</mi></msubsup><mo>=</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><msub><mi>V</mi><msubsup><mi>χ</mi><mi>j</mi><mi>λ</mi></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">V_{\chi^{\lambda}_{i}}=\bigoplus_{\{j\,\mid\,\chi^{\lambda}_{j}=\chi^{\lambda}_{i}\}}V_{\chi^{\lambda}_{j}}</annotation></semantics></math>. We have a <math id="S4.SS4.p12.m11" class="ltx_Math" alttext="X^{*}(Z_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X^{*}(Z_{\lambda})</annotation></semantics></math>-grading on the vector space <math id="S4.SS4.p12.m12" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> with weight decomposition:</p>
<table id="S4.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex36.m1" class="ltx_Math" alttext="V=\bigoplus_{\{[\chi^{\lambda}_{i}]\}}V_{\chi^{\lambda}_{i}}" display="block" intent=":literal"><semantics><mrow><mi>V</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></munder><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">V=\bigoplus_{\{[\chi^{\lambda}_{i}]\}}V_{\chi^{\lambda}_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p12.2" class="ltx_p">Here the index set <math id="S4.SS4.p12.m13" class="ltx_Math" alttext="\{[\chi^{\lambda}_{i}]\}" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow><annotation encoding="application/x-tex">\{[\chi^{\lambda}_{i}]\}</annotation></semantics></math> runs over the set of all restrictions <math id="S4.SS4.p12.m14" class="ltx_Math" alttext="\chi^{\lambda}_{i}\in X^{*}(Z_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo>∈</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi^{\lambda}_{i}\in X^{*}(Z_{\lambda})</annotation></semantics></math> without repetitions, and <math id="S4.SS4.p12.m15" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math> acts on <math id="S4.SS4.p12.m16" class="ltx_Math" alttext="V_{\chi^{\lambda}_{i}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">V_{\chi^{\lambda}_{i}}</annotation></semantics></math> with weight <math id="S4.SS4.p12.m17" class="ltx_Math" alttext="\chi^{\lambda}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><annotation encoding="application/x-tex">\chi^{\lambda}_{i}</annotation></semantics></math>. Note that each <math id="S4.SS4.p12.m18" class="ltx_Math" alttext="V_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">V_{\chi_{i}^{\lambda}}</annotation></semantics></math> is a representation of <math id="S4.SS4.p12.m19" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>, because <math id="S4.SS4.p12.m20" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math> is central in <math id="S4.SS4.p12.m21" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>. Let <math id="S4.SS4.p12.m22" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}</annotation></semantics></math> denote the <math id="S4.SS4.p12.m23" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>-bundle on <math id="S4.SS4.p12.m24" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> obtained from <math id="S4.SS4.p12.m25" class="ltx_Math" alttext="\mathcal{G}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\lambda}</annotation></semantics></math> via the natural quotient morphism <math id="S4.SS4.p12.m26" class="ltx_Math" alttext="P_{\lambda}\twoheadrightarrow L_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>λ</mi></msub><mo stretchy="false">↠</mo><msub><mi>L</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">P_{\lambda}\twoheadrightarrow L_{\lambda}</annotation></semantics></math>. Let <math id="S4.SS4.p12.m27" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}V_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>L</mi><mi>λ</mi></msub></msup><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}V_{\chi_{i}^{\lambda}}</annotation></semantics></math> denote the associated vector bundle on <math id="S4.SS4.p12.m28" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm21" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm21.2" class="ltx_text ltx_font_bold">Definition 4.21</span></span><span id="S4.Thmthm21.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm21.p1" class="ltx_para">
<p id="S4.Thmthm21.p1.1" class="ltx_p"><span id="S4.Thmthm21.p1.1.1" class="ltx_text ltx_font_italic">We define <math id="S4.Thmthm21.p1.m1" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i}^{\lambda}}</annotation></semantics></math> to be the reflexive extension <math id="S4.Thmthm21.p1.m2" class="ltx_Math" alttext="j_{*}\left(\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}V_{\chi_{i}^{\lambda}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>L</mi><mi>λ</mi></msub></msup><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">j_{*}\left(\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}V_{\chi_{i}^{\lambda}}\right)</annotation></semantics></math> on <math id="S4.Thmthm21.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS4.p13" class="ltx_para">
<p id="S4.SS4.p13.1" class="ltx_p">We will denote by <math id="S4.SS4.p13.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> the hyperplane class in <math id="S4.SS4.p13.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> corresponding to the ample line bundle <math id="S4.SS4.p13.m3" class="ltx_Math" alttext="\mathcal{O}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(1)</annotation></semantics></math>, and denote by <math id="S4.SS4.p13.m4" class="ltx_Math" alttext="c_{1}(\mathcal{E}_{\chi_{i}^{\lambda}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c_{1}(\mathcal{E}_{\chi_{i}^{\lambda}})</annotation></semantics></math> the first Chern class of <math id="S4.SS4.p13.m5" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i}^{\lambda}}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm22" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm22.2" class="ltx_text ltx_font_bold">Lemma 4.22</span></span><span id="S4.Thmthm22.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm22.p1" class="ltx_para">
<p id="S4.Thmthm22.p1.1" class="ltx_p"><span id="S4.Thmthm22.p1.1.1" class="ltx_text ltx_font_italic">Set <math id="S4.Thmthm22.p1.m1" class="ltx_Math" alttext="c_{i}\vcentcolon=\frac{c_{1}(\mathcal{E}_{\chi^{\lambda}_{i}})\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi^{\lambda}_{i}})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>:=</mo><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mi mathsize="1.140em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">c_{i}\vcentcolon=\frac{c_{1}(\mathcal{E}_{\chi^{\lambda}_{i}})\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi^{\lambda}_{i}})}</annotation></semantics></math> and <math id="S4.Thmthm22.p1.m2" class="ltx_Math" alttext="c\vcentcolon=\frac{c_{1}(\mathcal{F})\cdot H^{d-1}}{r}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>:=</mo><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mi>r</mi></mfrac></mrow><annotation encoding="application/x-tex">c\vcentcolon=\frac{c_{1}(\mathcal{F})\cdot H^{d-1}}{r}</annotation></semantics></math>. Then, we have</span></p>
<table id="S4.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E4.m1" class="ltx_Math" alttext="\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{i=1}^{r}\langle\delta,\chi^{\lambda}_{i}\rangle\cdot(c_{i}-c)}{\sqrt{\sum_{i=1}^{r}\left(\langle\delta,\chi^{\lambda}_{i}\rangle\right)^{2}}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mrow><mo lspace="0em" maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><msup><mrow><mo lspace="0em">(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{i=1}^{r}\langle\delta,\chi^{\lambda}_{i}\rangle\cdot(c_{i}-c)}{\sqrt{\sum_{i=1}^{r}\left(\langle\delta,\chi^{\lambda}_{i}\rangle\right)^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm22.p1.2" class="ltx_p"><span id="S4.Thmthm22.p1.2.1" class="ltx_text ltx_font_italic">In particular, the function <math id="S4.Thmthm22.p1.m3" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math> can be naturally interpreted as a scale-invariant continuous function on the whole cone <math id="S4.Thmthm22.p1.m4" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math> of dominant coweights with real coefficients.</span></p>
</div>
</div>
<div id="S4.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS4.p14" class="ltx_para">
<p id="S4.SS4.p14.1" class="ltx_p"><span id="S4.SS4.p14.1.1" class="ltx_text">For any <math id="S4.SS4.p14.m1" class="ltx_Math" alttext="\delta\in\mathcal{C}_{\lambda}\cap X_{*}(T)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo>∩</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\in\mathcal{C}_{\lambda}\cap X_{*}(T)</annotation></semantics></math>, denote by <math id="S4.SS4.p14.m2" class="ltx_Math" alttext="L_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">L_{\delta}</annotation></semantics></math> the unique Levi subgroup of the parabolic <math id="S4.SS4.p14.m3" class="ltx_Math" alttext="P_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">P_{\delta}</annotation></semantics></math> containing the maximal torus <math id="S4.SS4.p14.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>. Note that <math id="S4.SS4.p14.m5" class="ltx_Math" alttext="L_{\lambda}\subset L_{\delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>λ</mi></msub><mo>⊂</mo><msub><mi>L</mi><mi>δ</mi></msub></mrow><annotation encoding="application/x-tex">L_{\lambda}\subset L_{\delta}</annotation></semantics></math>. Denote by <math id="S4.SS4.p14.m6" class="ltx_Math" alttext="Z_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">Z_{\delta}</annotation></semantics></math> the maximal central torus of <math id="S4.SS4.p14.m7" class="ltx_Math" alttext="L_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">L_{\delta}</annotation></semantics></math>. Let <math id="S4.SS4.p14.m8" class="ltx_Math" alttext="\mathcal{G}_{L_{\delta}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>δ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\delta}}</annotation></semantics></math> be the <math id="S4.SS4.p14.m9" class="ltx_Math" alttext="L_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">L_{\delta}</annotation></semantics></math>–bundle obtained from <math id="S4.SS4.p14.m10" class="ltx_Math" alttext="\mathcal{G}_{\delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\delta}</annotation></semantics></math> via the quotient <math id="S4.SS4.p14.m11" class="ltx_Math" alttext="P_{\delta}\twoheadrightarrow L_{\delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>δ</mi></msub><mo stretchy="false">↠</mo><msub><mi>L</mi><mi>δ</mi></msub></mrow><annotation encoding="application/x-tex">P_{\delta}\twoheadrightarrow L_{\delta}</annotation></semantics></math>. Observe that <math id="S4.SS4.p14.m12" class="ltx_Math" alttext="\mathcal{G}_{L_{\delta}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>δ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\delta}}</annotation></semantics></math> is obtained from <math id="S4.SS4.p14.m13" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}</annotation></semantics></math> by extending the structure group via <math id="S4.SS4.p14.m14" class="ltx_Math" alttext="L_{\lambda}\hookrightarrow L_{\delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>λ</mi></msub><mo stretchy="false">↪</mo><msub><mi>L</mi><mi>δ</mi></msub></mrow><annotation encoding="application/x-tex">L_{\lambda}\hookrightarrow L_{\delta}</annotation></semantics></math>. Let <math id="S4.SS4.p14.m15" class="ltx_Math" alttext="\mathcal{E}_{U}^{\delta}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>U</mi><mi>δ</mi></msubsup><annotation encoding="application/x-tex">\mathcal{E}_{U}^{\delta}</annotation></semantics></math> be the vector bundle on <math id="S4.SS4.p14.m16" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> obtained by extending the structure group via the inclusion <math id="S4.SS4.p14.m17" class="ltx_Math" alttext="L_{\delta}\hookrightarrow G\xrightarrow{\rho}\GL(V)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>δ</mi></msub><mo stretchy="false">↪</mo><mi>G</mi><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝜌</mo></mover><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{\delta}\hookrightarrow G\xrightarrow{\rho}\GL(V)</annotation></semantics></math>. For all <math id="S4.SS4.p14.m18" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> we have a canonical identification <math id="S4.SS4.p14.m19" class="ltx_Math" alttext="\mathcal{E}_{U}^{\delta}\cong\mathcal{E}^{\lambda}_{U}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>U</mi><mi>δ</mi></msubsup><mo>≅</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>U</mi><mi>λ</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{E}_{U}^{\delta}\cong\mathcal{E}^{\lambda}_{U}</annotation></semantics></math>. Hence we will denote all such <math id="S4.SS4.p14.m20" class="ltx_Math" alttext="\mathcal{E}^{\delta}_{U}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>U</mi><mi>δ</mi></msubsup><annotation encoding="application/x-tex">\mathcal{E}^{\delta}_{U}</annotation></semantics></math> by the same notation <math id="S4.SS4.p14.m21" class="ltx_Math" alttext="\mathcal{E}_{U}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{U}</annotation></semantics></math>. Let <math id="S4.SS4.p14.m22" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> be the reflexive sheaf on <math id="S4.SS4.p14.m23" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> obtained by pushing forward <math id="S4.SS4.p14.m24" class="ltx_Math" alttext="\mathcal{E}_{U}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{U}</annotation></semantics></math> under the open inclusion <math id="S4.SS4.p14.m25" class="ltx_Math" alttext="U\hookrightarrow X" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo stretchy="false">↪</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">U\hookrightarrow X</annotation></semantics></math>. Let <math id="S4.SS4.p14.m26" class="ltx_Math" alttext="(\mathcal{F}^{\delta}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\delta}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> be the underlying filtration of <math id="S4.SS4.p14.m27" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> associated to the weighted parabolic reduction <math id="S4.SS4.p14.m28" class="ltx_Math" alttext="(\delta,\mathcal{G}_{\delta})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>δ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\delta,\mathcal{G}_{\delta})</annotation></semantics></math>. The description of the associated graded at the end of Subsection <a href="#S3.SS3" title="3.3. Filtrations of 
          
            ρ
          
        -sheaves in the split case ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> shows that there is an identification <math id="S4.SS4.p14.m29" class="ltx_Math" alttext="\left(\bigoplus_{m\in\mathbb{Z}}\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1}\right)|_{U}\xrightarrow{\sim}\mathcal{E}_{U}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mrow><mo>(</mo><mrow><mrow><msub><mo lspace="0em">⨁</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup></mrow><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo>)</mo></mrow><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>U</mi></msub></mrow><annotation encoding="application/x-tex">\left(\bigoplus_{m\in\mathbb{Z}}\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1}\right)|_{U}\xrightarrow{\sim}\mathcal{E}_{U}</annotation></semantics></math> of associated graded sheaves on <math id="S4.SS4.p14.m30" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. This induces a natural identification <math id="S4.SS4.p14.m31" class="ltx_Math" alttext="\bigoplus_{m\in\mathbb{Z}}(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})^{\vee\vee}\xrightarrow{\sim}\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>⨁</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">\bigoplus_{m\in\mathbb{Z}}(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})^{\vee\vee}\xrightarrow{\sim}\mathcal{E}</annotation></semantics></math> of reflexive sheaves on <math id="S4.SS4.p14.m32" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. We will describe a <math id="S4.SS4.p14.m33" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-grading on <math id="S4.SS4.p14.m34" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> determined by the action of the cocharacter <math id="S4.SS4.p14.m35" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>. The inclusion <math id="S4.SS4.p14.m36" class="ltx_Math" alttext="Z_{\lambda}\hookrightarrow T" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">↪</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">Z_{\lambda}\hookrightarrow T</annotation></semantics></math> induces
an inclusion <math id="S4.SS4.p14.m37" class="ltx_Math" alttext="X_{\ast}(Z_{\lambda})\hookrightarrow X_{\ast}(T)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{\ast}(Z_{\lambda})\hookrightarrow X_{\ast}(T)</annotation></semantics></math>. Recall that <math id="S4.SS4.p14.m38" class="ltx_Math" alttext="\chi_{i}^{\lambda}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><annotation encoding="application/x-tex">\chi_{i}^{\lambda}</annotation></semantics></math> denotes the restriction of each character <math id="S4.SS4.p14.m39" class="ltx_Math" alttext="\chi_{i}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\chi_{i}</annotation></semantics></math> to <math id="S4.SS4.p14.m40" class="ltx_Math" alttext="X_{\ast}(Z_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X_{\ast}(Z_{\lambda})</annotation></semantics></math>. We have a <math id="S4.SS4.p14.m41" class="ltx_Math" alttext="X^{*}(Z_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X^{*}(Z_{\lambda})</annotation></semantics></math>-grading on the vector space <math id="S4.SS4.p14.m42" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> with weight decomposition <math id="S4.SS4.p14.m43" class="ltx_Math" alttext="V=\bigoplus_{\{[\chi^{\lambda}_{i}]\}}V_{\chi^{\lambda}_{i}}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">V=\bigoplus_{\{[\chi^{\lambda}_{i}]\}}V_{\chi^{\lambda}_{i}}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p15" class="ltx_para">
<p id="S4.SS4.p15.1" class="ltx_p"><span id="S4.SS4.p15.1.1" class="ltx_text">For any representative <math id="S4.SS4.p15.m1" class="ltx_Math" alttext="\chi_{i}^{\lambda}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><annotation encoding="application/x-tex">\chi_{i}^{\lambda}</annotation></semantics></math> of <math id="S4.SS4.p15.m2" class="ltx_Math" alttext="[\chi^{\lambda}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\chi^{\lambda}_{i}]</annotation></semantics></math> we have <math id="S4.SS4.p15.m3" class="ltx_Math" alttext="V_{\chi^{\lambda}_{i}}=\bigoplus_{\{j\,\mid\,\chi^{\lambda}_{j}=\chi^{\lambda}_{i}\}}V_{\chi^{\lambda}_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>j</mi><mo fence="true" lspace="0.130em" rspace="0.130em">∣</mo><mrow><msubsup><mi>χ</mi><mi>j</mi><mi>λ</mi></msubsup><mo>=</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><msub><mi>V</mi><msubsup><mi>χ</mi><mi>j</mi><mi>λ</mi></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">V_{\chi^{\lambda}_{i}}=\bigoplus_{\{j\,\mid\,\chi^{\lambda}_{j}=\chi^{\lambda}_{i}\}}V_{\chi^{\lambda}_{j}}</annotation></semantics></math>. Hence <math id="S4.SS4.p15.m4" class="ltx_Math" alttext="\dim(V_{\chi^{\lambda}_{i}})=\#\{j\;\mid\;\chi^{\lambda}_{j}=\chi^{\lambda}_{i}\,\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathsize="0.800em">#</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mi>j</mi><mo fence="true" lspace="0.220em" rspace="0.220em">∣</mo><mrow><msubsup><mi>χ</mi><mi>j</mi><mi>λ</mi></msubsup><mo>=</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\dim(V_{\chi^{\lambda}_{i}})=\#\{j\;\mid\;\chi^{\lambda}_{j}=\chi^{\lambda}_{i}\,\}</annotation></semantics></math>. Since <math id="S4.SS4.p15.m5" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math> is central in <math id="S4.SS4.p15.m6" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>, the action of <math id="S4.SS4.p15.m7" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math> on <math id="S4.SS4.p15.m8" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> preserves each <math id="S4.SS4.p15.m9" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math>-weight space <math id="S4.SS4.p15.m10" class="ltx_Math" alttext="V_{\chi^{\lambda}_{i}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">V_{\chi^{\lambda}_{i}}</annotation></semantics></math>, hence each <math id="S4.SS4.p15.m11" class="ltx_Math" alttext="V_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">V_{\chi_{i}^{\lambda}}</annotation></semantics></math> is a representation of <math id="S4.SS4.p15.m12" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>. This way we get the grading</span></p>
<table id="S4.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex37.m1" class="ltx_Math" alttext="\mathcal{E}_{U}=\bigoplus_{\{[\chi^{\lambda}_{i}]\}}\mathcal{E}_{U,\chi^{\lambda}_{i}}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>U</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{U}=\bigoplus_{\{[\chi^{\lambda}_{i}]\}}\mathcal{E}_{U,\chi^{\lambda}_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p15.2" class="ltx_p"><span id="S4.SS4.p15.2.1" class="ltx_text">where <math id="S4.SS4.p15.m13" class="ltx_Math" alttext="\mathcal{E}_{U,\chi^{\lambda}_{i}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow></msub><annotation encoding="application/x-tex">\mathcal{E}_{U,\chi^{\lambda}_{i}}</annotation></semantics></math> is the vector bundle <math id="S4.SS4.p15.m14" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}V_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>L</mi><mi>λ</mi></msub></msup><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}V_{\chi_{i}^{\lambda}}</annotation></semantics></math> associated to the representation <math id="S4.SS4.p15.m15" class="ltx_Math" alttext="V_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">V_{\chi_{i}^{\lambda}}</annotation></semantics></math> and <math id="S4.SS4.p15.m16" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math> acts with weight <math id="S4.SS4.p15.m17" class="ltx_Math" alttext="\chi^{\lambda}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><annotation encoding="application/x-tex">\chi^{\lambda}_{i}</annotation></semantics></math> on <math id="S4.SS4.p15.m18" class="ltx_Math" alttext="\mathcal{E}_{U,\chi^{\lambda}_{i}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow></msub><annotation encoding="application/x-tex">\mathcal{E}_{U,\chi^{\lambda}_{i}}</annotation></semantics></math>. Note that <math id="S4.SS4.p15.m19" class="ltx_Math" alttext="\rk(\mathcal{E}_{U,\chi^{\lambda}_{i}})=\dim(V_{\chi_{i}^{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rk(\mathcal{E}_{U,\chi^{\lambda}_{i}})=\dim(V_{\chi_{i}^{\lambda}})</annotation></semantics></math>. This grading extends uniquely to a grading of the reflexive extension</span></p>
<table id="S4.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex38.m1" class="ltx_Math" alttext="\bigoplus_{m\in\mathbb{Z}}(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})^{\vee\vee}\cong\mathcal{E}=\bigoplus_{\{[\chi^{\lambda}_{i}]\}}\mathcal{E}_{\chi^{\lambda}_{i}}" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup></mrow><mo>≅</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">\bigoplus_{m\in\mathbb{Z}}(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})^{\vee\vee}\cong\mathcal{E}=\bigoplus_{\{[\chi^{\lambda}_{i}]\}}\mathcal{E}_{\chi^{\lambda}_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.p16" class="ltx_para">
<p id="S4.SS4.p16.1" class="ltx_p"><span id="S4.SS4.p16.1.1" class="ltx_text">The cocharacter <math id="S4.SS4.p16.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> acts on <math id="S4.SS4.p16.m2" class="ltx_Math" alttext="\mathcal{E}_{U}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{U}</annotation></semantics></math> via its natural inclusion in <math id="S4.SS4.p16.m3" class="ltx_Math" alttext="Z_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">Z_{\delta}</annotation></semantics></math>. Using <math id="S4.SS4.p16.m4" class="ltx_Math" alttext="Z_{\delta}\hookrightarrow Z_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>δ</mi></msub><mo stretchy="false">↪</mo><msub><mi>Z</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">Z_{\delta}\hookrightarrow Z_{\lambda}</annotation></semantics></math>, we can view <math id="S4.SS4.p16.m5" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> as a cocharacter of <math id="S4.SS4.p16.m6" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math>. It follows from our discussion that <math id="S4.SS4.p16.m7" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> acts with weight <math id="S4.SS4.p16.m8" class="ltx_Math" alttext="\langle\delta,\chi^{\lambda}_{i}\rangle" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\delta,\chi^{\lambda}_{i}\rangle</annotation></semantics></math> on <math id="S4.SS4.p16.m9" class="ltx_Math" alttext="\mathcal{E}_{U,\chi^{\lambda}_{i}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow></msub><annotation encoding="application/x-tex">\mathcal{E}_{U,\chi^{\lambda}_{i}}</annotation></semantics></math>. This shows that</span></p>
<table id="S4.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex39.m1" class="ltx_Math" alttext="(\mathcal{F}_{m}^{\delta}/\mathcal{F}_{m+1}^{\delta})|_{U}=\bigoplus_{\{[\chi^{\lambda}_{i}]\;\mid\;\langle\delta,\chi^{\lambda}_{i}\rangle=m\}}\mathcal{E}_{U,\chi^{\lambda}_{i}}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><mo fence="true" lspace="0.220em" rspace="0.220em">∣</mo><mrow><mrow><mo maxsize="1.140em" minsize="1.140em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="1.140em" minsize="1.140em" stretchy="true">⟩</mo></mrow><mo>=</mo><mi>m</mi></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>U</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">(\mathcal{F}_{m}^{\delta}/\mathcal{F}_{m+1}^{\delta})|_{U}=\bigoplus_{\{[\chi^{\lambda}_{i}]\;\mid\;\langle\delta,\chi^{\lambda}_{i}\rangle=m\}}\mathcal{E}_{U,\chi^{\lambda}_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p16.2" class="ltx_p"><span id="S4.SS4.p16.2.1" class="ltx_text">and therefore</span></p>
<table id="S4.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E5.m1" class="ltx_Math" alttext="(\mathcal{F}_{m}^{\delta}/\mathcal{F}_{m+1}^{\delta})^{\vee\vee}=\bigoplus_{\{[\chi^{\lambda}_{i}]\;\mid\;\langle\delta,\chi^{\lambda}_{i}\rangle=m\}}\mathcal{E}_{\chi^{\lambda}_{i}}" display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><mo fence="true" lspace="0.220em" rspace="0.220em">∣</mo><mrow><mrow><mo maxsize="1.140em" minsize="1.140em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="1.140em" minsize="1.140em" stretchy="true">⟩</mo></mrow><mo>=</mo><mi>m</mi></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">(\mathcal{F}_{m}^{\delta}/\mathcal{F}_{m+1}^{\delta})^{\vee\vee}=\bigoplus_{\{[\chi^{\lambda}_{i}]\;\mid\;\langle\delta,\chi^{\lambda}_{i}\rangle=m\}}\mathcal{E}_{\chi^{\lambda}_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p16.3" class="ltx_p"><span id="S4.SS4.p16.3.1" class="ltx_text">Observe that we have equality of slopes <math id="S4.SS4.p16.m10" class="ltx_Math" alttext="\widehat{\mu}_{d-1}\left(\mathcal{F}_{m}^{\delta}/\mathcal{F}_{m+1}^{\delta}\right)=\widehat{\mu}_{d-1}\left((\mathcal{F}_{m}^{\delta}/\mathcal{F}_{m+1}^{\delta})^{\vee\vee}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}\left(\mathcal{F}_{m}^{\delta}/\mathcal{F}_{m+1}^{\delta}\right)=\widehat{\mu}_{d-1}\left((\mathcal{F}_{m}^{\delta}/\mathcal{F}_{m+1}^{\delta})^{\vee\vee}\right)</annotation></semantics></math>. Taking the degree <math id="S4.SS4.p16.m11" class="ltx_Math" alttext="d-1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d-1</annotation></semantics></math> coefficient in the formula (<a href="#S4.E3" title="Equation 3 ‣ Proposition 4.4. ‣ 4.1. The numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) in Proposition <a href="#S4.Thmthm4" title="Proposition 4.4. ‣ 4.1. The numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>, we get</span></p>
<table id="S4.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E6.m1" class="ltx_Math" alttext="\nu_{d-1}(\delta)=\frac{\sqrt{A_{d}}}{(d-1)!}\,\cdot\,\frac{\sum\limits_{m\in\mathbb{Z}}m\cdot\left(\widehat{\mu}_{d-1}(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})-\widehat{\mu}_{d-1}(\mathcal{F})\right)\cdot\rk(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})}{\sqrt{\sum\limits_{m\in\mathbb{Z}}m^{2}\cdot\rk(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><msqrt><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><msup><mi>m</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\delta)=\frac{\sqrt{A_{d}}}{(d-1)!}\,\cdot\,\frac{\sum\limits_{m\in\mathbb{Z}}m\cdot\left(\widehat{\mu}_{d-1}(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})-\widehat{\mu}_{d-1}(\mathcal{F})\right)\cdot\rk(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})}{\sqrt{\sum\limits_{m\in\mathbb{Z}}m^{2}\cdot\rk(\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p16.4" class="ltx_p"><span id="S4.SS4.p16.4.1" class="ltx_text">Using the description of the quotients <math id="S4.SS4.p16.m12" class="ltx_Math" alttext="\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mi>δ</mi></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mi>δ</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\delta}_{m}/\mathcal{F}^{\delta}_{m+1}</annotation></semantics></math> in terms of the <math id="S4.SS4.p16.m13" class="ltx_Math" alttext="\mathcal{E}_{\chi^{\lambda}_{i}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi^{\lambda}_{i}}</annotation></semantics></math>, we can rewrite <math id="S4.SS4.p16.m14" class="ltx_Math" alttext="(\ref{eqn_2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mtext class="ltx_mathvariant_italic"><a href="#S4.E6" title="Equation 6 ‣ Proof. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\ref{eqn_2})</annotation></semantics></math> as:</span></p>
<table id="S4.EGx4" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S4.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex40.m1" class="ltx_Math" alttext="\displaystyle\nu_{d-1}(\delta)=\frac{\sqrt{A_{d}}}{(d-1)!}\,\cdot\,\frac{\sum\limits_{m\in\mathbb{Z}}\sum\limits_{\{[\chi_{i}^{\lambda}]\;\mid\;\langle\delta,\chi_{i}^{\lambda}\rangle=m\}}m\cdot\left(\widehat{\mu}_{d-1}(\mathcal{E}_{\chi^{\lambda}_{i}})-\widehat{\mu}_{d-1}(\mathcal{F})\right)\cdot\#\{j\;\mid\;\chi^{\lambda}_{j}=\chi^{\lambda}_{i}\,\}}{\sqrt{\sum_{m\in\mathbb{Z}}m^{2}\cdot\#\{j\;\mid\;\langle\delta,\chi^{\lambda}_{i}\rangle=m\,\}}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><munder><mo lspace="0.167em" movablelimits="false">∑</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><mo fence="true" lspace="0.220em" rspace="0.220em">∣</mo><mrow><mrow><mo maxsize="1.140em" minsize="1.140em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="1.140em" minsize="1.140em" stretchy="true">⟩</mo></mrow><mo>=</mo><mi>m</mi></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></munder><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">#</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mi>j</mi><mo fence="true" lspace="0.220em" rspace="0.220em">∣</mo><mrow><msubsup><mi>χ</mi><mi>j</mi><mi>λ</mi></msubsup><mo>=</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow></mrow></mrow></mrow></mrow><msqrt><mrow><mrow><msub><mo>∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msup><mi>m</mi><mn>2</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">#</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mi>j</mi><mo fence="true" lspace="0.220em" rspace="0.220em">∣</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>=</mo><mi>m</mi></mrow><mo lspace="0.130em" maxsize="0.800em" minsize="0.800em">}</mo></mrow></mrow></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nu_{d-1}(\delta)=\frac{\sqrt{A_{d}}}{(d-1)!}\,\cdot\,\frac{\sum\limits_{m\in\mathbb{Z}}\sum\limits_{\{[\chi_{i}^{\lambda}]\;\mid\;\langle\delta,\chi_{i}^{\lambda}\rangle=m\}}m\cdot\left(\widehat{\mu}_{d-1}(\mathcal{E}_{\chi^{\lambda}_{i}})-\widehat{\mu}_{d-1}(\mathcal{F})\right)\cdot\#\{j\;\mid\;\chi^{\lambda}_{j}=\chi^{\lambda}_{i}\,\}}{\sqrt{\sum_{m\in\mathbb{Z}}m^{2}\cdot\#\{j\;\mid\;\langle\delta,\chi^{\lambda}_{i}\rangle=m\,\}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S4.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E7.m1" class="ltx_Math" alttext="=\frac{\sqrt{A_{d}}}{(d-1)!}\,\cdot\,\frac{\sum\limits_{i=1}^{r}\langle\delta,\chi^{\lambda}_{i}\rangle\cdot\left(\widehat{\mu}_{d-1}(\mathcal{E}_{\chi^{\lambda}_{i}})-\widehat{\mu}_{d-1}(\mathcal{F})\right)}{\sqrt{\sum_{i=1}^{r}\left(\langle\delta,\chi^{\lambda}_{i}\rangle\right)^{2}}}" display="block" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><mo lspace="0em" maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><msup><mrow><mo lspace="0em">(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">=\frac{\sqrt{A_{d}}}{(d-1)!}\,\cdot\,\frac{\sum\limits_{i=1}^{r}\langle\delta,\chi^{\lambda}_{i}\rangle\cdot\left(\widehat{\mu}_{d-1}(\mathcal{E}_{\chi^{\lambda}_{i}})-\widehat{\mu}_{d-1}(\mathcal{F})\right)}{\sqrt{\sum_{i=1}^{r}\left(\langle\delta,\chi^{\lambda}_{i}\rangle\right)^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p16.5" class="ltx_p"><span id="S4.SS4.p16.5.1" class="ltx_text">Observe that in the sum above we are indexing over all <math id="S4.SS4.p16.m15" class="ltx_Math" alttext="\chi_{i}^{\lambda}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><annotation encoding="application/x-tex">\chi_{i}^{\lambda}</annotation></semantics></math> with repetitions. This is done in order to account for the ranks.</span></p>
</div>
<div id="S4.SS4.p17" class="ltx_para">
<p id="S4.SS4.p17.1" class="ltx_p"><span id="S4.SS4.p17.1.1" class="ltx_text">We can further rewrite this by using the Hirzebruch-Riemann-Roch theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">Ful98</a>, Ch. 15]</cite>. Let <math id="S4.SS4.p17.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> denote the hyperplane class on <math id="S4.SS4.p17.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> corresponding to the line bundle <math id="S4.SS4.p17.m3" class="ltx_Math" alttext="\mathcal{O}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(1)</annotation></semantics></math>. Let <math id="S4.SS4.p17.m4" class="ltx_Math" alttext="t_{1}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>1</mn></msub><annotation encoding="application/x-tex">t_{1}</annotation></semantics></math> be the degree <math id="S4.SS4.p17.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> term of the Todd class of <math id="S4.SS4.p17.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. For any torsion-free sheaf <math id="S4.SS4.p17.m7" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> on <math id="S4.SS4.p17.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with first Chern class <math id="S4.SS4.p17.m9" class="ltx_Math" alttext="c_{1}(\mathcal{A})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c_{1}(\mathcal{A})</annotation></semantics></math>, Hirzebruch-Riemann-Roch implies that</span></p>
<table id="S4.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex41.m1" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{A})=\frac{1}{A_{d}\,\rk(\mathcal{A})}c_{1}(\mathcal{A})\cdot H^{d-1}+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mrow><msub><mi>A</mi><mi>d</mi></msub><mo lspace="0.297em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mrow><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{A})=\frac{1}{A_{d}\,\rk(\mathcal{A})}c_{1}(\mathcal{A})\cdot H^{d-1}+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p17.2" class="ltx_p"><span id="S4.SS4.p17.2.1" class="ltx_text">Using this formula for <math id="S4.SS4.p17.m10" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i}^{\lambda}}</annotation></semantics></math> and <math id="S4.SS4.p17.m11" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> yields</span></p>
<table id="S4.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex42.m1" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{E}_{\chi^{\lambda}_{i}})-\widehat{\mu}_{d-1}(\mathcal{F}|_{X_{s}})=\frac{1}{A_{d}}\cdot\left(\frac{c_{1}(\mathcal{E}_{\chi^{\lambda}_{i}})\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi^{\lambda}_{i}})}-\frac{c_{1}(\mathcal{F})\cdot H^{d-1}}{r}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>−</mo><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mi>r</mi></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{E}_{\chi^{\lambda}_{i}})-\widehat{\mu}_{d-1}(\mathcal{F}|_{X_{s}})=\frac{1}{A_{d}}\cdot\left(\frac{c_{1}(\mathcal{E}_{\chi^{\lambda}_{i}})\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi^{\lambda}_{i}})}-\frac{c_{1}(\mathcal{F})\cdot H^{d-1}}{r}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p17.3" class="ltx_p"><span id="S4.SS4.p17.3.1" class="ltx_text">Using <math id="S4.SS4.p17.m12" class="ltx_Math" alttext="c_{i}=\frac{c_{1}(\mathcal{E}_{\chi^{\lambda}_{i}})\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi^{\lambda}_{i}})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>=</mo><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mi mathsize="1.140em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">c_{i}=\frac{c_{1}(\mathcal{E}_{\chi^{\lambda}_{i}})\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi^{\lambda}_{i}})}</annotation></semantics></math> and <math id="S4.SS4.p17.m13" class="ltx_Math" alttext="c=\frac{c_{1}(\mathcal{F})\cdot H^{d-1}}{r}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mi>r</mi></mfrac></mrow><annotation encoding="application/x-tex">c=\frac{c_{1}(\mathcal{F})\cdot H^{d-1}}{r}</annotation></semantics></math>, we can rewrite (<a href="#S4.E7" title="Equation 7 ‣ Proof. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) as:</span></p>
<table id="S4.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex43.m1" class="ltx_Math" alttext="\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{i=1}^{r}\langle\delta,\chi^{\lambda}_{i}\rangle\cdot(c_{i}-c)}{\sqrt{\sum_{i=1}^{r}\left(\langle\delta,\chi^{\lambda}_{i}\rangle\right)^{2}}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mrow><mo lspace="0em" maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" rspace="0.055em" stretchy="true">⟩</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><msup><mrow><mo lspace="0em">(</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><mi>δ</mi><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\delta)=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{\sum_{i=1}^{r}\langle\delta,\chi^{\lambda}_{i}\rangle\cdot(c_{i}-c)}{\sqrt{\sum_{i=1}^{r}\left(\langle\delta,\chi^{\lambda}_{i}\rangle\right)^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p17.4" class="ltx_p"><span id="S4.SS4.p17.4.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S4.SS4.p18" class="ltx_para">
<p id="S4.SS4.p18.1" class="ltx_p">For each <math id="S4.SS4.p18.m1" class="ltx_Math" alttext="\delta\in X_{*}(T)\cap\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\delta\in X_{*}(T)\cap\mathcal{C}_{\lambda}</annotation></semantics></math>, the inclusion <math id="S4.SS4.p18.m2" class="ltx_Math" alttext="Z_{\delta}\hookrightarrow T" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>δ</mi></msub><mo stretchy="false">↪</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">Z_{\delta}\hookrightarrow T</annotation></semantics></math> induces an identification</p>
<table id="S4.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex44.m1" class="ltx_Math" alttext="X_{*}(Z_{\delta})_{\mathbb{R}}=\bigoplus_{i=1}^{h}\mathbb{R}z_{i}\oplus\bigoplus_{j\in J_{P_{\delta}}}\mathbb{R}\omega_{j}^{\vee}\hookrightarrow X_{*}(Z_{\lambda})_{\mathbb{R}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>δ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></munderover><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>i</mi></msub></mrow></mrow><mo rspace="0.055em">⊕</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi>J</mi><msub><mi>P</mi><mi>δ</mi></msub></msub></mrow></munder><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>j</mi><mo>∨</mo></msubsup></mrow></mrow></mrow><mo stretchy="false">↪</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X_{*}(Z_{\delta})_{\mathbb{R}}=\bigoplus_{i=1}^{h}\mathbb{R}z_{i}\oplus\bigoplus_{j\in J_{P_{\delta}}}\mathbb{R}\omega_{j}^{\vee}\hookrightarrow X_{*}(Z_{\lambda})_{\mathbb{R}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p18.2" class="ltx_p">where the last inclusion comes from <math id="S4.SS4.p18.m3" class="ltx_Math" alttext="Z_{\delta}\subset Z_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>δ</mi></msub><mo>⊂</mo><msub><mi>Z</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">Z_{\delta}\subset Z_{\lambda}</annotation></semantics></math>. Let us denote by <math id="S4.SS4.p18.m4" class="ltx_Math" alttext="\chi^{\delta}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>i</mi><mi>δ</mi></msubsup><annotation encoding="application/x-tex">\chi^{\delta}_{i}</annotation></semantics></math> the restriction of each character <math id="S4.SS4.p18.m5" class="ltx_Math" alttext="\chi_{i}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\chi_{i}</annotation></semantics></math> to <math id="S4.SS4.p18.m6" class="ltx_Math" alttext="X_{*}(Z_{\delta})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>δ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><annotation encoding="application/x-tex">X_{*}(Z_{\delta})_{\mathbb{R}}</annotation></semantics></math>. In coordinates of the basis <math id="S4.SS4.p18.m7" class="ltx_Math" alttext="\mathcal{B}^{\vee}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∨</mo></msup><annotation encoding="application/x-tex">\mathcal{B}^{\vee}</annotation></semantics></math>, the tuple <math id="S4.SS4.p18.m8" class="ltx_Math" alttext="(\chi_{i}^{\delta})_{i=1}^{r}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msubsup><mi>χ</mi><mi>i</mi><mi>δ</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">(\chi_{i}^{\delta})_{i=1}^{r}</annotation></semantics></math> is the matrix <math id="S4.SS4.p18.m9" class="ltx_Math" alttext="M_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">M_{\delta}</annotation></semantics></math> obtained from <math id="S4.SS4.p18.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> by deleting the rows corresponding to <math id="S4.SS4.p18.m11" class="ltx_Math" alttext="\Delta\setminus I_{P_{\delta}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∖</mo><msub><mi>I</mi><msub><mi>P</mi><mi>δ</mi></msub></msub></mrow><annotation encoding="application/x-tex">\Delta\setminus I_{P_{\delta}}</annotation></semantics></math>. Note that the set of all such possible matrices <math id="S4.SS4.p18.m12" class="ltx_Math" alttext="M_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">M_{\delta}</annotation></semantics></math> as we vary <math id="S4.SS4.p18.m13" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> is finite, because there are only finitely many possibilities for the set of indexes <math id="S4.SS4.p18.m14" class="ltx_Math" alttext="J_{P_{\delta}}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><msub><mi>P</mi><mi>δ</mi></msub></msub><annotation encoding="application/x-tex">J_{P_{\delta}}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.p19" class="ltx_para">
<p id="S4.SS4.p19.1" class="ltx_p">As a consequence of Lemma <a href="#S4.Thmthm22" title="Lemma 4.22. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.22</span></a> we get the following immediate corollary.</p>
</div>
<div id="S4.Thmthm23" class="ltx_theorem ltx_theorem_coroll">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm23.2" class="ltx_text ltx_font_bold">Corollary 4.23</span></span><span id="S4.Thmthm23.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm23.p1" class="ltx_para">
<p id="S4.Thmthm23.p1.1" class="ltx_p"><span id="S4.Thmthm23.p1.1.1" class="ltx_text ltx_font_italic">Set <math id="S4.Thmthm23.p1.m1" class="ltx_Math" alttext="\vec{a}=[c_{i}]_{i=1}^{r}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><msubsup><mrow><mo stretchy="false">[</mo><msub><mi>c</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup></mrow><annotation encoding="application/x-tex">\vec{a}=[c_{i}]_{i=1}^{r}</annotation></semantics></math> to be the row vector of size <math id="S4.Thmthm23.p1.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> with the <math id="S4.Thmthm23.p1.m3" class="ltx_Math" alttext="i^{th}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">i^{th}</annotation></semantics></math> element given by <math id="S4.Thmthm23.p1.m4" class="ltx_Math" alttext="c_{i}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>i</mi></msub><annotation encoding="application/x-tex">c_{i}</annotation></semantics></math>, and let <math id="S4.Thmthm23.p1.m5" class="ltx_Math" alttext="\vec{1}" display="inline" intent=":literal"><semantics><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{1}</annotation></semantics></math> denote the row vector of size <math id="S4.Thmthm23.p1.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> such that all entries are <math id="S4.Thmthm23.p1.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. Let <math id="S4.Thmthm23.p1.m8" class="ltx_Math" alttext="\vec{x}=[x_{i}]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>x</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{x}=[x_{i}]</annotation></semantics></math> be the column vector of the coordinates of <math id="S4.Thmthm23.p1.m9" class="ltx_Math" alttext="\delta\in\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">\delta\in\mathcal{C}_{\lambda}</annotation></semantics></math> in the basis <math id="S4.Thmthm23.p1.m10" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math>. Then we can express <math id="S4.Thmthm23.p1.m11" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math> in terms of the matrix <math id="S4.Thmthm23.p1.m12" class="ltx_Math" alttext="M_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">M_{\lambda}</annotation></semantics></math> as follows.</span></p>
<table id="S4.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E8.m1" class="ltx_Math" alttext="\nu_{d-1}(\vec{x})=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{(\vec{a}-c\vec{1})M_{\lambda}\vec{x}}{\sqrt{\vec{x}^{T}M_{\lambda}^{T}M_{\lambda}\vec{x}}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msqrt><msub><mi>A</mi><mi>d</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.352em" rspace="0.352em">⋅</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>x</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><msqrt><mrow><msup><mover accent="true"><mi>x</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>x</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\vec{x})=\frac{1}{\sqrt{A_{d}}(d-1)!}\,\cdot\,\frac{(\vec{a}-c\vec{1})M_{\lambda}\vec{x}}{\sqrt{\vec{x}^{T}M_{\lambda}^{T}M_{\lambda}\vec{x}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm23.p1.2" class="ltx_p"><span id="S4.Thmthm23.p1.2.1" class="ltx_text ltx_font_italic">∎</span></p>
</div>
</div>
<div id="S4.Thmthm24" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm24.2" class="ltx_text ltx_font_bold">Lemma 4.24</span></span><span id="S4.Thmthm24.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm24.p1" class="ltx_para">
<p id="S4.Thmthm24.p1.1" class="ltx_p"><span id="S4.Thmthm24.p1.1.1" class="ltx_text ltx_font_italic">There exists a linear functional <math id="S4.Thmthm24.p1.m1" class="ltx_Math" alttext="\psi:X^{*}(Z_{\lambda})_{\mathbb{R}}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\psi:X^{*}(Z_{\lambda})_{\mathbb{R}}\rightarrow\mathbb{R}</annotation></semantics></math> such that <math id="S4.Thmthm24.p1.m2" class="ltx_Math" alttext="c_{i}=\psi(\chi_{i}^{\lambda})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{i}=\psi(\chi_{i}^{\lambda})</annotation></semantics></math> for all <math id="S4.Thmthm24.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS4.p20" class="ltx_para">
<p id="S4.SS4.p20.1" class="ltx_p"><span id="S4.SS4.p20.1.1" class="ltx_text">Recall that <math id="S4.SS4.p20.m1" class="ltx_Math" alttext="j:U\hookrightarrow X_{s}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">↪</mo><msub><mi>X</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">j:U\hookrightarrow X_{s}</annotation></semantics></math> is a big open set and <math id="S4.SS4.p20.m2" class="ltx_Math" alttext="X_{s}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>s</mi></msub><annotation encoding="application/x-tex">X_{s}</annotation></semantics></math> is smooth. The pushforward <math id="S4.SS4.p20.m3" class="ltx_Math" alttext="j_{*}" display="inline" intent=":literal"><semantics><msub><mi>j</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">j_{*}</annotation></semantics></math> induces an isomorphism of Picard groups <math id="S4.SS4.p20.m4" class="ltx_Math" alttext="j_{*}:\Pic(U)\rightarrow\Pic(X_{s})" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi mathsize="0.800em">Pic</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">Pic</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">j_{*}:\Pic(U)\rightarrow\Pic(X_{s})</annotation></semantics></math>. Let <math id="S4.SS4.p20.m5" class="ltx_Math" alttext="X^{*}(L_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X^{*}(L_{\lambda})</annotation></semantics></math> be the group of characters of the Levi subgroup <math id="S4.SS4.p20.m6" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>. The <math id="S4.SS4.p20.m7" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>-bundle <math id="S4.SS4.p20.m8" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}</annotation></semantics></math> on <math id="S4.SS4.p20.m9" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> induces a homomorphism <math id="S4.SS4.p20.m10" class="ltx_Math" alttext="X^{*}(L_{\lambda})\rightarrow\Pic(U)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">Pic</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X^{*}(L_{\lambda})\rightarrow\Pic(U)</annotation></semantics></math> where any character <math id="S4.SS4.p20.m11" class="ltx_Math" alttext="\chi\in X^{*}(L_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>∈</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi\in X^{*}(L_{\lambda})</annotation></semantics></math> is mapped to the associated line bundle <math id="S4.SS4.p20.m12" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}\chi" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>L</mi><mi>λ</mi></msub></msup><mi>χ</mi></mrow><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}\chi</annotation></semantics></math>. By post-composing with <math id="S4.SS4.p20.m13" class="ltx_Math" alttext="j_{\ast}" display="inline" intent=":literal"><semantics><msub><mi>j</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">j_{\ast}</annotation></semantics></math> we get a homomorphism</span></p>
<table id="S4.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex45.m1" class="ltx_Math" alttext="X^{*}(L_{\lambda})\rightarrow\Pic(U)\rightarrow\Pic(X_{s})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">Pic</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathsize="0.800em">Pic</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X^{*}(L_{\lambda})\rightarrow\Pic(U)\rightarrow\Pic(X_{s})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p20.2" class="ltx_p"><span id="S4.SS4.p20.2.1" class="ltx_text">On the other hand, the first Chern class induces a homomorphism</span></p>
<table id="S4.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex46.m1" class="ltx_Math" alttext="\Pic(X_{s})\rightarrow\mathbb{Z},\;\;\mathcal{L}\mapsto c_{1}(\mathcal{L})\cdot H^{d-1}\in\mathbb{Z}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi mathsize="0.800em">Pic</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow><mo rspace="0.607em">,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">↦</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>∈</mo><mi>ℤ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pic(X_{s})\rightarrow\mathbb{Z},\;\;\mathcal{L}\mapsto c_{1}(\mathcal{L})\cdot H^{d-1}\in\mathbb{Z}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p20.3" class="ltx_p"><span id="S4.SS4.p20.3.1" class="ltx_text">We compose this with the previous map to get a homomorphism</span></p>
<table id="S4.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex47.m1" class="ltx_Math" alttext="\varphi:X^{*}(L_{\lambda})\rightarrow\mathbb{Z},\;\;\chi\mapsto c_{1}\left(j_{*}(\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}\chi)\right)\cdot H^{d-1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><mo rspace="0.607em">,</mo><mrow><mi>χ</mi><mo stretchy="false">↦</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>L</mi><mi>λ</mi></msub></msup><mi>χ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi:X^{*}(L_{\lambda})\rightarrow\mathbb{Z},\;\;\chi\mapsto c_{1}\left(j_{*}(\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}\chi)\right)\cdot H^{d-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p20.4" class="ltx_p"><span id="S4.SS4.p20.4.1" class="ltx_text">Tensor with <math id="S4.SS4.p20.m14" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math> to obtain a linear functional <math id="S4.SS4.p20.m15" class="ltx_Math" alttext="\varphi_{\mathbb{R}}:X^{*}(L_{\lambda})_{\mathbb{R}}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>ℝ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\varphi_{\mathbb{R}}:X^{*}(L_{\lambda})_{\mathbb{R}}\rightarrow\mathbb{R}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p21" class="ltx_para">
<p id="S4.SS4.p21.1" class="ltx_p"><span id="S4.SS4.p21.1.1" class="ltx_text">The inclusion <math id="S4.SS4.p21.m1" class="ltx_Math" alttext="Z_{\lambda}\hookrightarrow L_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">↪</mo><msub><mi>L</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">Z_{\lambda}\hookrightarrow L_{\lambda}</annotation></semantics></math> yields a restriction map on characters <math id="S4.SS4.p21.m2" class="ltx_Math" alttext="\res:X^{*}(L_{\lambda})_{\mathbb{R}}\rightarrow X^{*}(Z_{\lambda})_{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">res</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℝ</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\res:X^{*}(L_{\lambda})_{\mathbb{R}}\rightarrow X^{*}(Z_{\lambda})_{\mathbb{R}}</annotation></semantics></math>. This morphism <math id="S4.SS4.p21.m3" class="ltx_Math" alttext="\res" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">res</mi><annotation encoding="application/x-tex">\res</annotation></semantics></math> is an isomorphism since the inclusion induces an isogeny between <math id="S4.SS4.p21.m4" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math> and <math id="S4.SS4.p21.m5" class="ltx_Math" alttext="L_{\lambda}/\,[L_{\lambda},L_{\lambda}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>λ</mi></msub><mo rspace="0.352em">/</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>L</mi><mi>λ</mi></msub><mo>,</mo><msub><mi>L</mi><mi>λ</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">L_{\lambda}/\,[L_{\lambda},L_{\lambda}]</annotation></semantics></math>. We set <math id="S4.SS4.p21.m6" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> to be the linear functional</span></p>
<table id="S4.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex48.m1" class="ltx_Math" alttext="\psi=\varphi_{\mathbb{R}}\circ(\res)^{-1}:X^{*}(Z_{\lambda})\rightarrow\mathbb{R},\;\;\;\;\;\overline{\chi}\mapsto\varphi_{\mathbb{R}}(\chi)=c_{1}\left(j_{*}(\,\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}\chi)\right)\cdot H^{d-1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>ψ</mi><mo>=</mo><mrow><msub><mi>φ</mi><mi>ℝ</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mrow><mo stretchy="false">(</mo><mi mathsize="0.800em">res</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><mo rspace="1.267em">,</mo><mrow><mover accent="true"><mi>χ</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">↦</mo><mrow><msub><mi>φ</mi><mi>ℝ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.130em" stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>L</mi><mi>λ</mi></msub></msup><mi>χ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi=\varphi_{\mathbb{R}}\circ(\res)^{-1}:X^{*}(Z_{\lambda})\rightarrow\mathbb{R},\;\;\;\;\;\overline{\chi}\mapsto\varphi_{\mathbb{R}}(\chi)=c_{1}\left(j_{*}(\,\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}\chi)\right)\cdot H^{d-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p21.2" class="ltx_p"><span id="S4.SS4.p21.2.1" class="ltx_text">for a character <math id="S4.SS4.p21.m7" class="ltx_Math" alttext="\overline{\chi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>χ</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{\chi}</annotation></semantics></math> of <math id="S4.SS4.p21.m8" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math> that comes from the restriction of a character <math id="S4.SS4.p21.m9" class="ltx_Math" alttext="\chi" display="inline" intent=":literal"><semantics><mi>χ</mi><annotation encoding="application/x-tex">\chi</annotation></semantics></math> of <math id="S4.SS4.p21.m10" class="ltx_Math" alttext="L_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">L_{\lambda}</annotation></semantics></math>. We are left to prove that <math id="S4.SS4.p21.m11" class="ltx_Math" alttext="\psi(\chi_{i}^{\lambda})=c_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\psi(\chi_{i}^{\lambda})=c_{i}</annotation></semantics></math> for all <math id="S4.SS4.p21.m12" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p22" class="ltx_para">
<p id="S4.SS4.p22.1" class="ltx_p"><span id="S4.SS4.p22.1.1" class="ltx_text">By definition <math id="S4.SS4.p22.m1" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i}^{\lambda}}|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i}^{\lambda}}|_{U}</annotation></semantics></math> is the associated vector bundle <math id="S4.SS4.p22.m2" class="ltx_Math" alttext="\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}V_{\chi^{\lambda}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>L</mi><mi>λ</mi></msub></msub><msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>L</mi><mi>λ</mi></msub></msup><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">\mathcal{G}_{L_{\lambda}}\times^{L_{\lambda}}V_{\chi^{\lambda}_{i}}</annotation></semantics></math>. Hence we have
<math id="S4.SS4.p22.m3" class="ltx_Math" alttext="\det(\mathcal{E}_{\chi^{\lambda}_{i}}|_{U})=\mathcal{G}_{\lambda}\times^{L_{\lambda}}\det(V_{\chi_{i}^{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo lspace="0.222em">×</mo><mrow><mmultiscripts><mo lspace="0.055em">det</mo><mprescripts></mprescripts><mrow></mrow><msub><mi>L</mi><mi>λ</mi></msub></mmultiscripts><mo lspace="0em">⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\det(\mathcal{E}_{\chi^{\lambda}_{i}}|_{U})=\mathcal{G}_{\lambda}\times^{L_{\lambda}}\det(V_{\chi_{i}^{\lambda}})</annotation></semantics></math>. Therefore:</span></p>
<table id="S4.EGx5" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S4.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex49.m1" class="ltx_Math" alttext="\displaystyle c_{i}=\frac{c_{1}(\mathcal{E}_{\chi^{\lambda}_{i}})\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi^{\lambda}_{i}})}=\frac{c_{1}(\det(\mathcal{E}_{\chi^{\lambda}_{i}}))\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}=\frac{c_{1}(j_{*}\det(\mathcal{E}_{\chi^{\lambda}_{i}}|_{U}))\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}=\frac{\varphi_{\mathbb{R}}\left(\det(V_{\chi_{i}^{\lambda}})\right)}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}" display="block" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>=</mo><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mi>φ</mi><mi>ℝ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo lspace="0em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle c_{i}=\frac{c_{1}(\mathcal{E}_{\chi^{\lambda}_{i}})\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi^{\lambda}_{i}})}=\frac{c_{1}(\det(\mathcal{E}_{\chi^{\lambda}_{i}}))\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}=\frac{c_{1}(j_{*}\det(\mathcal{E}_{\chi^{\lambda}_{i}}|_{U}))\cdot H^{d-1}}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}=\frac{\varphi_{\mathbb{R}}\left(\det(V_{\chi_{i}^{\lambda}})\right)}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.p23" class="ltx_para">
<p id="S4.SS4.p23.1" class="ltx_p"><span id="S4.SS4.p23.1.1" class="ltx_text">As a representation of <math id="S4.SS4.p23.m1" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math>, the weight space <math id="S4.SS4.p23.m2" class="ltx_Math" alttext="V_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">V_{\chi_{i}^{\lambda}}</annotation></semantics></math> is a direct sum of <math id="S4.SS4.p23.m3" class="ltx_Math" alttext="\rk(\mathcal{E}_{\chi_{i}^{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rk(\mathcal{E}_{\chi_{i}^{\lambda}})</annotation></semantics></math>-many copies of the character <math id="S4.SS4.p23.m4" class="ltx_Math" alttext="\chi^{\lambda}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><annotation encoding="application/x-tex">\chi^{\lambda}_{i}</annotation></semantics></math>. Hence <math id="S4.SS4.p23.m5" class="ltx_Math" alttext="\det(V_{\chi_{i}^{\lambda}})=\rk(\mathcal{E}_{\chi_{i}^{\lambda}})\cdot\chi_{i}^{\lambda}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\det(V_{\chi_{i}^{\lambda}})=\rk(\mathcal{E}_{\chi_{i}^{\lambda}})\cdot\chi_{i}^{\lambda}</annotation></semantics></math> as a <math id="S4.SS4.p23.m6" class="ltx_Math" alttext="Z_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Z_{\lambda}</annotation></semantics></math>-character. This means</span></p>
<table id="S4.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex50.m1" class="ltx_Math" alttext="c_{i}=\frac{\varphi_{\mathbb{R}}\left(\det(V_{\chi_{i}^{\lambda}})\right)}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}=\frac{\psi\left(\rk(\mathcal{E}_{\chi_{i}^{\lambda}})\cdot\chi_{i}^{\lambda}\right)}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}=\psi(\chi_{i}^{\lambda})" display="block" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>=</mo><mfrac><mrow><msub><mi>φ</mi><mi>ℝ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo lspace="0em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo>)</mo></mrow></mrow><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{i}=\frac{\varphi_{\mathbb{R}}\left(\det(V_{\chi_{i}^{\lambda}})\right)}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}=\frac{\psi\left(\rk(\mathcal{E}_{\chi_{i}^{\lambda}})\cdot\chi_{i}^{\lambda}\right)}{\rk(\mathcal{E}_{\chi_{i}^{\lambda}})}=\psi(\chi_{i}^{\lambda})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p23.2" class="ltx_p"><span id="S4.SS4.p23.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S4.SS4.p24" class="ltx_para">
<p id="S4.SS4.p24.1" class="ltx_p">We are now ready to prove the main proposition of this subsection.</p>
</div>
<div id="S4.Thmthm25" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm25.2" class="ltx_text ltx_font_bold">Proposition 4.25</span></span><span id="S4.Thmthm25.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm25.p1" class="ltx_para">
<p id="S4.Thmthm25.p1.1" class="ltx_p"><span id="S4.Thmthm25.p1.1.1" class="ltx_text ltx_font_italic">The polynomial numerical invariant <math id="S4.Thmthm25.p1.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> on the stack <math id="S4.Thmthm25.p1.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> satisfies the HN boundedness condition.</span></p>
</div>
</div>
<div id="S4.SS4.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS4.p25" class="ltx_para">
<p id="S4.SS4.p25.1" class="ltx_p"><span id="S4.SS4.p25.1.1" class="ltx_text">We shall prove property (*) in Lemma <a href="#S4.Thmthm17" title="Lemma 4.17. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.17</span></a>. Fix an algebraically closed extension <math id="S4.SS4.p25.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> and a scheme <math id="S4.SS4.p25.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> of finite type over <math id="S4.SS4.p25.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. After replacing <math id="S4.SS4.p25.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> with the extension <math id="S4.SS4.p25.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, we can assume that the ground field <math id="S4.SS4.p25.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is algebraically closed. Fix a family <math id="S4.SS4.p25.m7" class="ltx_Math" alttext="g:S\rightarrow\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g:S\rightarrow\Bun_{\rho}(X)</annotation></semantics></math> represented by a <math id="S4.SS4.p25.m8" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S4.SS4.p25.m9" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> on <math id="S4.SS4.p25.m10" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p26" class="ltx_para">
<p id="S4.SS4.p26.1" class="ltx_p"><span id="S4.SS4.p26.1.1" class="ltx_text">Choose a closed point <math id="S4.SS4.p26.m1" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math>. Let <math id="S4.SS4.p26.m2" class="ltx_Math" alttext="f=(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> be a nondegenerate weighted reduction of <math id="S4.SS4.p26.m3" class="ltx_Math" alttext="(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math>. Let <math id="S4.SS4.p26.m4" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be a big open subset of <math id="S4.SS4.p26.m5" class="ltx_Math" alttext="X_{s}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>s</mi></msub><annotation encoding="application/x-tex">X_{s}</annotation></semantics></math> where <math id="S4.SS4.p26.m6" class="ltx_Math" alttext="\mathcal{F}|_{X_{s}}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{F}|_{X_{s}}</annotation></semantics></math> is locally-free and <math id="S4.SS4.p26.m7" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> is defined. Suppose that <math id="S4.SS4.p26.m8" class="ltx_Math" alttext="\nu(f)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu(f)&gt;0</annotation></semantics></math>. The first step will be to construct another weighted parabolic reduction <math id="S4.SS4.p26.m9" class="ltx_Math" alttext="f^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>′</mo></msup><annotation encoding="application/x-tex">f^{\prime}</annotation></semantics></math> that satisfies <math id="S4.SS4.p26.m10" class="ltx_Math" alttext="\nu(f^{\prime})\geq\nu(f)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(f^{\prime})\geq\nu(f)</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p27" class="ltx_para">
<p id="S4.SS4.p27.1" class="ltx_p"><span id="S4.SS4.p27.1.1" class="ltx_text">Let <math id="S4.SS4.p27.m1" class="ltx_Math" alttext="P_{\lambda}\subset G" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>λ</mi></msub><mo>⊂</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">P_{\lambda}\subset G</annotation></semantics></math> the parabolic subgroup associated to the cocharacter <math id="S4.SS4.p27.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>. Note that the discussion and lemmas before the proposition apply to the weighted parabolic reduction <math id="S4.SS4.p27.m3" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> of <math id="S4.SS4.p27.m4" class="ltx_Math" alttext="(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math>. The scale-invariant continuous function <math id="S4.SS4.p27.m5" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math> (see (<a href="#S4.E4" title="Equation 4 ‣ Lemma 4.22. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) in Lemma <a href="#S4.Thmthm22" title="Lemma 4.22. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.22</span></a>) attains a maximal value <math id="S4.SS4.p27.m6" class="ltx_Math" alttext="\nu_{d-1}(\delta^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\delta^{*})</annotation></semantics></math> for some <math id="S4.SS4.p27.m7" class="ltx_Math" alttext="\delta^{*}" display="inline" intent=":literal"><semantics><msup><mi>δ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\delta^{*}</annotation></semantics></math> on the domain <math id="S4.SS4.p27.m8" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math> (by restricting to the compact intersection of <math id="S4.SS4.p27.m9" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math> with the unit sphere).
We can assume without loss of generality that the maximum <math id="S4.SS4.p27.m10" class="ltx_Math" alttext="\delta^{*}" display="inline" intent=":literal"><semantics><msup><mi>δ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\delta^{*}</annotation></semantics></math> is in the interior of the cone <math id="S4.SS4.p27.m11" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math>. Otherwise, let <math id="S4.SS4.p27.m12" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> be the unique facet of <math id="S4.SS4.p27.m13" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math> such that <math id="S4.SS4.p27.m14" class="ltx_Math" alttext="\delta^{*}\in\Int(F)" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>∈</mo><mrow><mi mathsize="0.800em">Int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta^{*}\in\Int(F)</annotation></semantics></math>. This facet <math id="S4.SS4.p27.m15" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is the smaller cone of dominant coweights of a parabolic subgroup <math id="S4.SS4.p27.m16" class="ltx_Math" alttext="P_{\delta^{*}}\supset P_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><msup><mi>δ</mi><mo>∗</mo></msup></msub><mo>⊃</mo><msub><mi>P</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">P_{\delta^{*}}\supset P_{\lambda}</annotation></semantics></math>. Then we can replace <math id="S4.SS4.p27.m17" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> with a <math id="S4.SS4.p27.m18" class="ltx_Math" alttext="\delta^{*}" display="inline" intent=":literal"><semantics><msup><mi>δ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\delta^{*}</annotation></semantics></math> and replace the parabolic reduction <math id="S4.SS4.p27.m19" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> with <math id="S4.SS4.p27.m20" class="ltx_Math" alttext="(\delta^{*},\mathcal{G}_{\delta^{*}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>δ</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\delta^{*},\mathcal{G}_{\delta^{*}})</annotation></semantics></math> for the bigger parabolic.</span></p>
</div>
<div id="S4.SS4.p28" class="ltx_para">
<p id="S4.SS4.p28.1" class="ltx_p"><span id="S4.SS4.p28.1.1" class="ltx_text">Since the maximum <math id="S4.SS4.p28.m1" class="ltx_Math" alttext="\delta^{*}" display="inline" intent=":literal"><semantics><msup><mi>δ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\delta^{*}</annotation></semantics></math> is in the interior of <math id="S4.SS4.p28.m2" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math>, it must be a critical point of the function <math id="S4.SS4.p28.m3" class="ltx_Math" alttext="\nu_{d-1}:\mathcal{C}_{\lambda}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}:\mathcal{C}_{\lambda}\rightarrow\mathbb{R}</annotation></semantics></math> as in (<a href="#S4.E8" title="Equation 8 ‣ Corollary 4.23. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) in Corollary <a href="#S4.Thmthm23" title="Corollary 4.23. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.23</span></a>. If <math id="S4.SS4.p28.m4" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math> is not identically <math id="S4.SS4.p28.m5" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> (equivalently <math id="S4.SS4.p28.m6" class="ltx_Math" alttext="(\vec{a}-c\vec{1})M_{\lambda}\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(\vec{a}-c\vec{1})M_{\lambda}\neq 0</annotation></semantics></math> in (<a href="#S4.E8" title="Equation 8 ‣ Corollary 4.23. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>)), the computation of the gradient yields the coordinates <math id="S4.SS4.p28.m7" class="ltx_Math" alttext="\vec{z}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>z</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{z}</annotation></semantics></math> of a critical point, up to scaling:</span></p>
<table id="S4.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(9)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E9.m1" class="ltx_Math" alttext="\vec{z}=(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}(\vec{a}^{T}-c\vec{1}^{T})" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>z</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vec{z}=(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}(\vec{a}^{T}-c\vec{1}^{T})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.p29" class="ltx_para">
<p id="S4.SS4.p29.1" class="ltx_p"><span id="S4.SS4.p29.1.1" class="ltx_text">We consider three cases to construct a modified weighted parabolic reduction <math id="S4.SS4.p29.m1" class="ltx_Math" alttext="f^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>′</mo></msup><annotation encoding="application/x-tex">f^{\prime}</annotation></semantics></math>:</span></p>
<ol id="S4.I6" class="ltx_enumerate">
<li id="S4.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(C1)</span> 
<div id="S4.I6.i1.p1" class="ltx_para">
<p id="S4.I6.i1.p1.1" class="ltx_p">Suppose that <math id="S4.I6.i1.p1.m1" class="ltx_Math" alttext="\nu_{d-1}(\lambda)\neq\nu_{d-1}(\delta^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\lambda)\neq\nu_{d-1}(\delta^{*})</annotation></semantics></math>. Then <math id="S4.I6.i1.p1.m2" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math> is not identically <math id="S4.I6.i1.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. Since all of the matrices and vectors in (<a href="#S4.E9" title="Equation 9 ‣ Proof. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) have rational coordinates, we can scale <math id="S4.I6.i1.p1.m4" class="ltx_Math" alttext="\delta^{*}" display="inline" intent=":literal"><semantics><msup><mi>δ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\delta^{*}</annotation></semantics></math> to have rational coordinates. After further scaling, we can assume that <math id="S4.I6.i1.p1.m5" class="ltx_Math" alttext="\delta^{*}" display="inline" intent=":literal"><semantics><msup><mi>δ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\delta^{*}</annotation></semantics></math> is a cocharacter in <math id="S4.I6.i1.p1.m6" class="ltx_Math" alttext="\mathcal{C}_{\lambda}\cap X_{*}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><mo>∩</mo><mrow><msub><mi>X</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}\cap X_{*}(T)</annotation></semantics></math>. It has coordinates</p>
<table id="S4.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex51.m1" class="ltx_Math" alttext="\vec{y}=q\vec{z}=q(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}(\vec{a}^{T}-c\vec{1}^{T})" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>z</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><mo>=</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vec{y}=q\vec{z}=q(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}(\vec{a}^{T}-c\vec{1}^{T})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I6.i1.p1.2" class="ltx_p">for <math id="S4.I6.i1.p1.m7" class="ltx_Math" alttext="q\in\mathbb{Q}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><msub><mi>ℚ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">q\in\mathbb{Q}_{&gt;0}</annotation></semantics></math> (the negative multiples correspond to minimal critical points). Set the modified weighted parabolic reduction to be <math id="S4.I6.i1.p1.m8" class="ltx_Math" alttext="f^{\prime}=(\delta^{*},\mathcal{G}_{\delta^{*}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>δ</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{\prime}=(\delta^{*},\mathcal{G}_{\delta^{*}})</annotation></semantics></math> with <math id="S4.I6.i1.p1.m9" class="ltx_Math" alttext="\nu_{d-1}(\delta^{*})&gt;\nu_{d-1}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\delta^{*})&gt;\nu_{d-1}(\lambda)</annotation></semantics></math>. By construction we have <math id="S4.I6.i1.p1.m10" class="ltx_Math" alttext="\nu(f^{\prime})&gt;\nu(f)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(f^{\prime})&gt;\nu(f)</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(C2)</span> 
<div id="S4.I6.i2.p1" class="ltx_para">
<p id="S4.I6.i2.p1.1" class="ltx_p">Suppose that <math id="S4.I6.i2.p1.m1" class="ltx_Math" alttext="\nu_{d-1}(\lambda)=\nu_{d-1}(\delta^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\lambda)=\nu_{d-1}(\delta^{*})</annotation></semantics></math> and the function <math id="S4.I6.i2.p1.m2" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math> is not identically <math id="S4.I6.i2.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. Then <math id="S4.I6.i2.p1.m4" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is a critical point for <math id="S4.I6.i2.p1.m5" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math> in the interior of the cone <math id="S4.I6.i2.p1.m6" class="ltx_Math" alttext="\mathcal{C}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\lambda}</annotation></semantics></math> with coordinates <math id="S4.I6.i2.p1.m7" class="ltx_Math" alttext="\vec{y}=q\vec{z}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>z</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\vec{y}=q\vec{z}</annotation></semantics></math>. In this case we define the weighted parabolic reduction <math id="S4.I6.i2.p1.m8" class="ltx_Math" alttext="f^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>′</mo></msup><annotation encoding="application/x-tex">f^{\prime}</annotation></semantics></math> to be the original <math id="S4.I6.i2.p1.m9" class="ltx_Math" alttext="f=(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> and set <math id="S4.I6.i2.p1.m10" class="ltx_Math" alttext="\delta^{*}=\lambda" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>=</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">\delta^{*}=\lambda</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(C3)</span> 
<div id="S4.I6.i3.p1" class="ltx_para">
<p id="S4.I6.i3.p1.1" class="ltx_p">Suppose that <math id="S4.I6.i3.p1.m1" class="ltx_Math" alttext="\nu_{d-1}(\lambda)=\nu_{d-1}(\delta^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu_{d-1}(\lambda)=\nu_{d-1}(\delta^{*})</annotation></semantics></math> and <math id="S4.I6.i3.p1.m2" class="ltx_Math" alttext="\nu_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\nu_{d-1}</annotation></semantics></math> is identically <math id="S4.I6.i3.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. In this case
<math id="S4.I6.i3.p1.m4" class="ltx_Math" alttext="\vec{z}=0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>z</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\vec{z}=0</annotation></semantics></math>. We set <math id="S4.I6.i3.p1.m5" class="ltx_Math" alttext="f^{\prime}=f" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo>=</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">f^{\prime}=f</annotation></semantics></math> and denote <math id="S4.I6.i3.p1.m6" class="ltx_Math" alttext="\delta^{*}=\lambda" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>=</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">\delta^{*}=\lambda</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S4.SS4.p30" class="ltx_para">
<p id="S4.SS4.p30.1" class="ltx_p"><span id="S4.SS4.p30.1.1" class="ltx_text">Let <math id="S4.SS4.p30.m1" class="ltx_Math" alttext="f^{\prime}=(\delta^{*},\mathcal{G}_{\delta^{*}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>δ</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{\prime}=(\delta^{*},\mathcal{G}_{\delta^{*}})</annotation></semantics></math> with maximizing <math id="S4.SS4.p30.m2" class="ltx_Math" alttext="\delta^{*}" display="inline" intent=":literal"><semantics><msup><mi>δ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\delta^{*}</annotation></semantics></math> as explained for each case above. Let <math id="S4.SS4.p30.m3" class="ltx_Math" alttext="(\mathcal{F}_{m}^{\delta^{*}})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m}^{\delta^{*}})_{m\in\mathbb{Z}}</annotation></semantics></math> be its corresponding filtration with associated graded <math id="S4.SS4.p30.m4" class="ltx_Math" alttext="\bigoplus_{m\in\mathbb{Z}}\mathcal{F}^{\delta^{*}}_{m}/\mathcal{F}^{\delta^{*}}_{m+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>⨁</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\bigoplus_{m\in\mathbb{Z}}\mathcal{F}^{\delta^{*}}_{m}/\mathcal{F}^{\delta^{*}}_{m+1}</annotation></semantics></math>.
We are left to find a uniform lower bound for the slopes <math id="S4.SS4.p30.m5" class="ltx_Math" alttext="\hat{\mu}_{d-1}(\mathcal{F}^{\delta^{*}}_{m}/\mathcal{F}^{\delta^{*}}_{m+1})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mu}_{d-1}(\mathcal{F}^{\delta^{*}}_{m}/\mathcal{F}^{\delta^{*}}_{m+1})</annotation></semantics></math>. Since the slope of <math id="S4.SS4.p30.m6" class="ltx_Math" alttext="\mathcal{F}^{\delta^{*}}_{m}/\mathcal{F}^{\delta^{*}}_{m+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\delta^{*}}_{m}/\mathcal{F}^{\delta^{*}}_{m+1}</annotation></semantics></math> is the same as the slope of its reflexive hull <math id="S4.SS4.p30.m7" class="ltx_Math" alttext="(\mathcal{F}^{\delta^{*}}_{m}/\mathcal{F}^{\delta^{*}}_{m+1})^{\vee\vee}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup><annotation encoding="application/x-tex">(\mathcal{F}^{\delta^{*}}_{m}/\mathcal{F}^{\delta^{*}}_{m+1})^{\vee\vee}</annotation></semantics></math>, this is equivalent to giving a uniform lower bound for</span></p>
<table id="S4.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex52.m1" class="ltx_Math" alttext="\widehat{\mu}_{d-1}\left((\mathcal{F}_{m}^{\delta^{*}}/\mathcal{F}_{m+1}^{\delta^{*}})^{\vee\vee}\right)=\widehat{\mu}_{d-1}\left(\bigoplus_{\{[\chi^{\lambda}_{i}]\;\mid\;\langle\delta^{*},\chi^{\lambda}_{i}\rangle=m\}}\mathcal{E}_{\chi^{\lambda}_{i}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">⨁</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">]</mo></mrow><mo fence="true" lspace="0.220em" rspace="0.220em">∣</mo><mrow><mrow><mo maxsize="1.140em" minsize="1.140em" stretchy="true">⟨</mo><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="1.140em" minsize="1.140em" stretchy="true">⟩</mo></mrow><mo>=</mo><mi>m</mi></mrow><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}\left((\mathcal{F}_{m}^{\delta^{*}}/\mathcal{F}_{m+1}^{\delta^{*}})^{\vee\vee}\right)=\widehat{\mu}_{d-1}\left(\bigoplus_{\{[\chi^{\lambda}_{i}]\;\mid\;\langle\delta^{*},\chi^{\lambda}_{i}\rangle=m\}}\mathcal{E}_{\chi^{\lambda}_{i}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p30.2" class="ltx_p"><span id="S4.SS4.p30.2.1" class="ltx_text">(See Equation (<a href="#S4.E5" title="Equation 5 ‣ Proof. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) in the proof of Lemma <a href="#S4.Thmthm22" title="Lemma 4.22. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.22</span></a>). By additivity of degrees and ranks, it suffices to give a uniform lower bound for the slope <math id="S4.SS4.p30.m8" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i}^{\lambda}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i}^{\lambda}})</annotation></semantics></math> of each direct summand above. Hirzebruch-Riemann-Roch implies that</span></p>
<table id="S4.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex53.m1" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i}^{\lambda}})=\frac{1}{A_{d}}\left(c_{i}+t_{1}\cdot H^{d-1}\right)\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>+</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo rspace="0.220em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i}^{\lambda}})=\frac{1}{A_{d}}\left(c_{i}+t_{1}\cdot H^{d-1}\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p30.3" class="ltx_p"><span id="S4.SS4.p30.3.1" class="ltx_text">Therefore it suffices to give a lower bound for the numbers <math id="S4.SS4.p30.m9" class="ltx_Math" alttext="c_{i}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>i</mi></msub><annotation encoding="application/x-tex">c_{i}</annotation></semantics></math>. Denote the coordinates in <math id="S4.SS4.p30.m10" class="ltx_Math" alttext="\mathcal{B}^{\vee}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∨</mo></msup><annotation encoding="application/x-tex">\mathcal{B}^{\vee}</annotation></semantics></math> of the linear functional <math id="S4.SS4.p30.m11" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> of Lemma <a href="#S4.Thmthm24" title="Lemma 4.24. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.24</span></a> by the column vector <math id="S4.SS4.p30.m12" class="ltx_Math" alttext="\vec{\psi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ψ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{\psi}</annotation></semantics></math>. Observe that <math id="S4.SS4.p30.m13" class="ltx_Math" alttext="\psi(\chi_{i}^{\lambda})=c_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\psi(\chi_{i}^{\lambda})=c_{i}</annotation></semantics></math> translates into <math id="S4.SS4.p30.m14" class="ltx_Math" alttext="\vec{a}^{T}=M_{\lambda}\vec{\psi}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup><mo>=</mo><mrow><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ψ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\vec{a}^{T}=M_{\lambda}\vec{\psi}</annotation></semantics></math>. We shall prove uniform bounds for the vector <math id="S4.SS4.p30.m15" class="ltx_Math" alttext="\vec{a}=[c_{i}]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mrow><mo stretchy="false">[</mo><msub><mi>c</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{a}=[c_{i}]</annotation></semantics></math>.
In cases (C1) and (C2) the coordinates <math id="S4.SS4.p30.m16" class="ltx_Math" alttext="\vec{y}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>y</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{y}</annotation></semantics></math> of <math id="S4.SS4.p30.m17" class="ltx_Math" alttext="\delta^{*}" display="inline" intent=":literal"><semantics><msup><mi>δ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\delta^{*}</annotation></semantics></math> are given by</span></p>
<table id="S4.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex54.m1" class="ltx_Math" alttext="\vec{y}=q\vec{z}=q(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}(\vec{a}^{T}-c\vec{1})" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>z</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><mo>=</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vec{y}=q\vec{z}=q(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}(\vec{a}^{T}-c\vec{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p30.4" class="ltx_p"><span id="S4.SS4.p30.4.1" class="ltx_text">We can plug-in <math id="S4.SS4.p30.m18" class="ltx_Math" alttext="\vec{a}^{T}=M_{\lambda}\vec{\psi}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup><mo>=</mo><mrow><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ψ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\vec{a}^{T}=M_{\lambda}\vec{\psi}</annotation></semantics></math> to obtain the following:</span></p>
<table id="S4.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex55.m1" class="ltx_Math" alttext="\vec{y}=q(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}M_{\lambda}\vec{\psi}-qc(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}=q\vec{\psi}-qc(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ψ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><mo>−</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup></mrow></mrow><mo>=</mo><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ψ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><mo>−</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\vec{y}=q(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}M_{\lambda}\vec{\psi}-qc(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}=q\vec{\psi}-qc(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p30.5" class="ltx_p"><span id="S4.SS4.p30.5.1" class="ltx_text">Multiply both sides by <math id="S4.SS4.p30.m19" class="ltx_Math" alttext="M_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">M_{\lambda}</annotation></semantics></math> to get</span></p>
<table id="S4.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(10)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E10.m1" class="ltx_Math" alttext="\vec{a}^{T}=M_{\lambda}\vec{\psi}=\frac{1}{q}M_{\lambda}\vec{y}+cM_{\lambda}(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup><mo>=</mo><mrow><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ψ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>q</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>y</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\vec{a}^{T}=M_{\lambda}\vec{\psi}=\frac{1}{q}M_{\lambda}\vec{y}+cM_{\lambda}(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p30.6" class="ltx_p"><span id="S4.SS4.p30.6.1" class="ltx_text">Since the family <math id="S4.SS4.p30.m20" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is bounded, we see that <math id="S4.SS4.p30.m21" class="ltx_Math" alttext="c=\frac{c_{1}(\mathcal{F}|_{X_{s}})\cdot H^{d-1}}{r}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mfrac><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mi>r</mi></mfrac></mrow><annotation encoding="application/x-tex">c=\frac{c_{1}(\mathcal{F}|_{X_{s}})\cdot H^{d-1}}{r}</annotation></semantics></math> admits uniform upper and lower bounds that do not depend on <math id="S4.SS4.p30.m22" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>. Also we know that there are finitely many possibilities for the matrix <math id="S4.SS4.p30.m23" class="ltx_Math" alttext="M_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">M_{\lambda}</annotation></semantics></math>, one for each possible choice of subset <math id="S4.SS4.p30.m24" class="ltx_Math" alttext="I_{P_{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><msub><mi>P</mi><mi>λ</mi></msub></msub><annotation encoding="application/x-tex">I_{P_{\lambda}}</annotation></semantics></math> of simple roots corresponding to the parabolic <math id="S4.SS4.p30.m25" class="ltx_Math" alttext="P_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">P_{\lambda}</annotation></semantics></math>. This gives uniform upper and lower bounds <math id="S4.SS4.p30.m26" class="ltx_Math" alttext="C_{max}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><annotation encoding="application/x-tex">C_{max}</annotation></semantics></math> and <math id="S4.SS4.p30.m27" class="ltx_Math" alttext="C_{min}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">C_{min}</annotation></semantics></math> for the coefficients of matrix of the second term <math id="S4.SS4.p30.m28" class="ltx_Math" alttext="cM_{\lambda}(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup></mrow><annotation encoding="application/x-tex">cM_{\lambda}(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}</annotation></semantics></math> in (<a href="#S4.E10" title="Equation 10 ‣ Proof. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>), independent of <math id="S4.SS4.p30.m29" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and the weighted parabolic reduction <math id="S4.SS4.p30.m30" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p31" class="ltx_para">
<p id="S4.SS4.p31.1" class="ltx_p"><span id="S4.SS4.p31.1.1" class="ltx_text">The <math id="S4.SS4.p31.m1" class="ltx_Math" alttext="i^{th}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">i^{th}</annotation></semantics></math> coefficient of the row vector <math id="S4.SS4.p31.m2" class="ltx_Math" alttext="M_{\lambda}\vec{y}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>y</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow><annotation encoding="application/x-tex">M_{\lambda}\vec{y}</annotation></semantics></math> is the weight <math id="S4.SS4.p31.m3" class="ltx_Math" alttext="\langle\delta^{*},\chi_{i}^{\lambda}\rangle" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\delta^{*},\chi_{i}^{\lambda}\rangle</annotation></semantics></math> of the sheaf <math id="S4.SS4.p31.m4" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i}^{\lambda}}</annotation></semantics></math>. From (<a href="#S4.E10" title="Equation 10 ‣ Proof. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) we get for each index <math id="S4.SS4.p31.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>:</span></p>
<table id="S4.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex56.m1" class="ltx_Math" alttext="C_{min}+\frac{1}{q}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})\leq c_{i}\leq C_{max}+\frac{1}{q}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>q</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><msub><mi>c</mi><mi>i</mi></msub><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>q</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{min}+\frac{1}{q}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})\leq c_{i}\leq C_{max}+\frac{1}{q}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p31.2" class="ltx_p"><span id="S4.SS4.p31.2.1" class="ltx_text">We can add <math id="S4.SS4.p31.m6" class="ltx_Math" alttext="t_{1}\cdot H^{d-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">t_{1}\cdot H^{d-1}</annotation></semantics></math> to get</span></p>
<table id="S4.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(11)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E11.m1" class="ltx_Math" alttext="C_{min}+\frac{1}{q}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})+t_{1}\cdot H^{d-1}\leq A_{d}\cdot\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i}^{\lambda}})\leq C_{max}+\frac{1}{q}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})+t_{1}\cdot H^{d-1}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>q</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>A</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>+</mo><mrow><mfrac><mn>1</mn><mi>q</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{min}+\frac{1}{q}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})+t_{1}\cdot H^{d-1}\leq A_{d}\cdot\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i}^{\lambda}})\leq C_{max}+\frac{1}{q}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})+t_{1}\cdot H^{d-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p31.3" class="ltx_p"><span id="S4.SS4.p31.3.1" class="ltx_text">Let <math id="S4.SS4.p31.m7" class="ltx_Math" alttext="\wgt(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\wgt(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})</annotation></semantics></math> be the smallest weight among all of the <math id="S4.SS4.p31.m8" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i}^{\lambda}}</annotation></semantics></math>. Since <math id="S4.SS4.p31.m9" class="ltx_Math" alttext="q&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q&gt;0</annotation></semantics></math>, we obtain</span></p>
<table id="S4.EGx6" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S4.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex57.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{A_{d}}C_{min}+\frac{1}{qA_{d}}\wgt(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}\leq\frac{1}{A_{d}}C_{min}+\frac{1}{qA_{d}}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}\leq\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i}^{\lambda}})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>d</mi></msub></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>≤</mo><mrow><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>d</mi></msub></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>≤</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{A_{d}}C_{min}+\frac{1}{qA_{d}}\wgt(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}\leq\frac{1}{A_{d}}C_{min}+\frac{1}{qA_{d}}\wgt(\mathcal{E}_{\chi_{i}^{\lambda}})+\frac{1}{A_{d}}t_{1}\cdot H^{d-1}\leq\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i}^{\lambda}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p31.4" class="ltx_p"><span id="S4.SS4.p31.4.1" class="ltx_text">for each <math id="S4.SS4.p31.m10" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
So it suffices to give a uniform lower bound for <math id="S4.SS4.p31.m11" class="ltx_Math" alttext="\frac{1}{qA_{d}}\wgt(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>d</mi></msub></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{qA_{d}}\wgt(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})</annotation></semantics></math>. Replace <math id="S4.SS4.p31.m12" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><mi>i</mi><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i}^{\lambda}}</annotation></semantics></math> by <math id="S4.SS4.p31.m13" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i_{min}}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i_{min}}^{\lambda}}</annotation></semantics></math> in the upper inequality of (<a href="#S4.E11" title="Equation 11 ‣ Proof. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) to get</span></p>
<table id="S4.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex58.m1" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})-\frac{1}{A_{d}}C_{max}-\frac{1}{A_{d}}t_{1}\cdot H^{d-1}\leq\frac{1}{qA_{d}}\wgt(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub></mrow><mo>−</mo><mrow><mrow><mfrac><mn>1</mn><msub><mi>A</mi><mi>d</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>d</mi></msub></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.800em">wt</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0.220em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})-\frac{1}{A_{d}}C_{max}-\frac{1}{A_{d}}t_{1}\cdot H^{d-1}\leq\frac{1}{qA_{d}}\wgt(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p31.5" class="ltx_p"><span id="S4.SS4.p31.5.1" class="ltx_text">Therefore we just need to give a uniform lower bound for <math id="S4.SS4.p31.m14" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p32" class="ltx_para">
<p id="S4.SS4.p32.1" class="ltx_p"><span id="S4.SS4.p32.1.1" class="ltx_text">Set <math id="S4.SS4.p32.m1" class="ltx_Math" alttext="m_{min}:=\langle\delta^{*},\chi_{i_{min}}^{\lambda}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>:=</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟨</mo><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">m_{min}:=\langle\delta^{*},\chi_{i_{min}}^{\lambda}\rangle</annotation></semantics></math>. Note that <math id="S4.SS4.p32.m2" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i_{min}}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i_{min}}^{\lambda}}</annotation></semantics></math> is a direct summand of the reflexive hull of the graded piece <math id="S4.SS4.p32.m3" class="ltx_Math" alttext="\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}}</annotation></semantics></math> of the filtration <math id="S4.SS4.p32.m4" class="ltx_Math" alttext="(\mathcal{F}^{\delta^{*}}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\delta^{*}}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math>. We can think of <math id="S4.SS4.p32.m5" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i_{min}}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i_{min}}^{\lambda}}</annotation></semantics></math> as a quotient of the reflexive hull <math id="S4.SS4.p32.m6" class="ltx_Math" alttext="(\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}})^{\vee\vee}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>∨</mo><mo lspace="0em">⁣</mo><mo>∨</mo></mrow></msup><annotation encoding="application/x-tex">(\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}})^{\vee\vee}</annotation></semantics></math>, and there is a corresponding quotient sheaf <math id="S4.SS4.p32.m7" class="ltx_Math" alttext="\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}}\twoheadrightarrow\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><mo stretchy="false">↠</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}}\twoheadrightarrow\mathcal{Q}</annotation></semantics></math> with the same slope as <math id="S4.SS4.p32.m8" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i_{min}}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i_{min}}^{\lambda}}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p33" class="ltx_para">
<p id="S4.SS4.p33.1" class="ltx_p"><span id="S4.SS4.p33.1.1" class="ltx_text">Since the weight of <math id="S4.SS4.p33.m1" class="ltx_Math" alttext="\mathcal{E}_{\chi_{i_{min}}^{\lambda}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><annotation encoding="application/x-tex">\mathcal{E}_{\chi_{i_{min}}^{\lambda}}</annotation></semantics></math> is minimal, it follows that <math id="S4.SS4.p33.m2" class="ltx_Math" alttext="\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}}</annotation></semantics></math> is the nontrivial graded piece with the smallest weight. This implies that <math id="S4.SS4.p33.m3" class="ltx_Math" alttext="\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><msup><mi>δ</mi><mo>∗</mo></msup></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><msub><mi>m</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow><msup><mi>δ</mi><mo>∗</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\delta^{*}}_{m_{{min}}}/\mathcal{F}_{m_{min}+1}^{\delta^{*}}</annotation></semantics></math> is a quotient of <math id="S4.SS4.p33.m4" class="ltx_Math" alttext="\mathcal{F}|_{X_{s}}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{F}|_{X_{s}}</annotation></semantics></math>. Hence <math id="S4.SS4.p33.m5" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> is also a quotient of <math id="S4.SS4.p33.m6" class="ltx_Math" alttext="\mathcal{F}|_{X_{s}}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{F}|_{X_{s}}</annotation></semantics></math>. It follows that</span></p>
<table id="S4.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex59.m1" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})=\widehat{\mu}_{d-1}(\mathcal{Q})\geq\widehat{\mu}_{d-1}(\mathcal{F}|_{X_{s}})_{min}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msubsup><mi>χ</mi><msub><mi>i</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mi>λ</mi></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{E}_{\chi_{i_{min}}^{\lambda}})=\widehat{\mu}_{d-1}(\mathcal{Q})\geq\widehat{\mu}_{d-1}(\mathcal{F}|_{X_{s}})_{min}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p33.2" class="ltx_p"><span id="S4.SS4.p33.2.1" class="ltx_text">where <math id="S4.SS4.p33.m7" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{F}|_{X_{s}})_{min}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{F}|_{X_{s}})_{min}</annotation></semantics></math> is the smallest slope appearing among the associated graded pieces of the Gieseker-Harder-Narasimhan filtration of <math id="S4.SS4.p33.m8" class="ltx_Math" alttext="\mathcal{F}|_{X_{s}}" display="inline" intent=":literal"><semantics><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{F}|_{X_{s}}</annotation></semantics></math> (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx30" title="" class="ltx_ref">HL97</a>, Def. 1.3.2]</cite>). The quantity <math id="S4.SS4.p33.m9" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{F}|_{X_{s}})_{min}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{F}|_{X_{s}})_{min}</annotation></semantics></math> is uniformly bounded as we vary <math id="S4.SS4.p33.m10" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math>, by constructibility of the locus of each fixed Harder-Narasimhan type (see e.g. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx42" title="" class="ltx_ref">Nit11</a>]</cite>). This concludes the proof of cases (C1) and (C2).</span></p>
</div>
<div id="S4.SS4.p34" class="ltx_para">
<p id="S4.SS4.p34.1" class="ltx_p"><span id="S4.SS4.p34.1.1" class="ltx_text">If we are in case (C3) we have <math id="S4.SS4.p34.m1" class="ltx_Math" alttext="\vec{z}=0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>z</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\vec{z}=0</annotation></semantics></math> (see (<a href="#S4.E9" title="Equation 9 ‣ Proof. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>)). Then:</span></p>
<table id="S4.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex60.m1" class="ltx_Math" alttext="(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{a}^{T}=c(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup></mrow><mo>=</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup></mrow></mrow><annotation encoding="application/x-tex">(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{a}^{T}=c(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p34.2" class="ltx_p"><span id="S4.SS4.p34.2.1" class="ltx_text">Using <math id="S4.SS4.p34.m2" class="ltx_Math" alttext="\vec{a}^{T}=M_{\lambda}\vec{\psi}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup><mo>=</mo><mrow><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ψ</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\vec{a}^{T}=M_{\lambda}\vec{\psi}</annotation></semantics></math> we get <math id="S4.SS4.p34.m3" class="ltx_Math" alttext="\vec{a}^{T}=cM_{\lambda}(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>a</mi><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup><mo>=</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>λ</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mn>1</mn><mo mathsize="0.800em" stretchy="false">→</mo></mover><mi>T</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\vec{a}^{T}=cM_{\lambda}(M_{\lambda}^{T}M_{\lambda})^{-1}M_{\lambda}^{T}\vec{1}^{T}</annotation></semantics></math>, which is the second term in (<a href="#S4.E10" title="Equation 10 ‣ Proof. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) and is bounded by our discussion of the cases before.
∎</span></p>
</div>
</div>
</section>
<section id="S4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.5. </span><math id="S4.SS5.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification, semistability and leading term filtrations</h3>

<div id="S4.SS5.p1" class="ltx_para">
<p id="S4.SS5.p1.1" class="ltx_p">After all of our work in this section, we can now construct a <math id="S4.SS5.p1.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification on <math id="S4.SS5.p1.m2" class="ltx_Math" alttext="\text{Bun}_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mtext>Bun</mtext><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Bun}_{\rho}(X)</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm26" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm26.2" class="ltx_text ltx_font_bold">Definition 4.26</span></span><span id="S4.Thmthm26.3" class="ltx_text ltx_font_bold"> </span>(<math id="S4.Thmthm26.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">HL14</a>, Defn. 2.1.2]</cite>)<span id="S4.Thmthm26.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm26.p1" class="ltx_para">
<p id="S4.Thmthm26.p1.1" class="ltx_p"><span id="S4.Thmthm26.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm26.p1.m1" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> be an algebraic stack locally of finite type and with affine diagonal over <math id="S4.Thmthm26.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. A <math id="S4.Thmthm26.p1.m3" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification of <math id="S4.Thmthm26.p1.m4" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> consists of a collection of open substacks <math id="S4.Thmthm26.p1.m5" class="ltx_Math" alttext="(\mathcal{M}_{\leq c})_{c\in\Gamma}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>c</mi><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{M}_{\leq c})_{c\in\Gamma}</annotation></semantics></math> indexed by a totally ordered set <math id="S4.Thmthm26.p1.m6" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>. We require the following conditions to be satisfied</span></p>
<ol id="S4.I7" class="ltx_enumerate">
<li id="S4.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I7.i1.p1" class="ltx_para">
<p id="S4.I7.i1.p1.1" class="ltx_p"><math id="S4.I7.i1.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{\leq c}\subset\mathcal{M}_{\leq c^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>c</mi></mrow></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo>≤</mo><msup><mi>c</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}_{\leq c}\subset\mathcal{M}_{\leq c^{\prime}}</annotation></semantics></math><span id="S4.I7.i1.p1.1.1" class="ltx_text ltx_font_italic"> for all </span><math id="S4.I7.i1.p1.m2" class="ltx_Math" alttext="c&lt;c^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><msup><mi>c</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">c&lt;c^{\prime}</annotation></semantics></math><span id="S4.I7.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I7.i2.p1" class="ltx_para">
<p id="S4.I7.i2.p1.1" class="ltx_p"><math id="S4.I7.i2.p1.m1" class="ltx_Math" alttext="\mathcal{M}=\bigcup_{c\in\Gamma}\mathcal{M}_{\leq c}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>⋃</mo><mrow><mi>c</mi><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>c</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}=\bigcup_{c\in\Gamma}\mathcal{M}_{\leq c}</annotation></semantics></math><span id="S4.I7.i2.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I7.i3.p1" class="ltx_para">
<p id="S4.I7.i3.p1.1" class="ltx_p"><span id="S4.I7.i3.p1.1.1" class="ltx_text ltx_font_italic">For all </span><math id="S4.I7.i3.p1.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math><span id="S4.I7.i3.p1.1.2" class="ltx_text ltx_font_italic">, there exists a </span><math id="S4.I7.i3.p1.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math><span id="S4.I7.i3.p1.1.3" class="ltx_text ltx_font_italic">-stratum </span><math id="S4.I7.i3.p1.m3" class="ltx_Math" alttext="\mathfrak{S}_{c}\subset\text{Filt}(\mathcal{M}_{\leq c})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔖</mi><mi>c</mi></msub><mo>⊂</mo><mrow><mtext class="ltx_mathvariant_italic">Filt</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{S}_{c}\subset\text{Filt}(\mathcal{M}_{\leq c})</annotation></semantics></math><span id="S4.I7.i3.p1.1.4" class="ltx_text ltx_font_italic"> of </span><math id="S4.I7.i3.p1.m4" class="ltx_Math" alttext="\mathcal{M}_{\leq c}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{\leq c}</annotation></semantics></math><span id="S4.I7.i3.p1.1.5" class="ltx_text ltx_font_italic"> (in the sense of </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.I7.i3.p1.1.6" class="ltx_text ltx_font_italic">[</span><a href="#bib.bibx31" title="" class="ltx_ref">HL14</a><span id="S4.I7.i3.p1.1.7" class="ltx_text ltx_font_italic">, Defn. 2.1.1]</span></cite><span id="S4.I7.i3.p1.1.8" class="ltx_text ltx_font_italic">) such that</span></p>
<table id="S4.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex61.m1" class="ltx_Math" alttext="\mathcal{M}_{\leq c}\setminus\text{ev}_{1}(\mathfrak{S}_{c})=\bigcup_{c^{\prime}&lt;c}\mathcal{M}_{\leq c^{\prime}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>c</mi></mrow></msub><mo>∖</mo><mrow><msub><mtext class="ltx_mathvariant_italic">ev</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔖</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⋃</mo><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>&lt;</mo><mi>c</mi></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo>≤</mo><msup><mi>c</mi><mo>′</mo></msup></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{\leq c}\setminus\text{ev}_{1}(\mathfrak{S}_{c})=\bigcup_{c^{\prime}&lt;c}\mathcal{M}_{\leq c^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S4.I7.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I7.i4.p1" class="ltx_para">
<p id="S4.I7.i4.p1.1" class="ltx_p"><span id="S4.I7.i4.p1.1.1" class="ltx_text ltx_font_italic">For every point </span><math id="S4.I7.i4.p1.m1" class="ltx_Math" alttext="p\in\mathcal{M}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow><annotation encoding="application/x-tex">p\in\mathcal{M}</annotation></semantics></math><span id="S4.I7.i4.p1.1.2" class="ltx_text ltx_font_italic">, the set </span><math id="S4.I7.i4.p1.m2" class="ltx_Math" alttext="\left\{c\in\Gamma\,\mid\,p\in\mathcal{M}_{\leq c}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mrow><mi>c</mi><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow><mo fence="true" lspace="0.130em" rspace="0.130em">∣</mo><mrow><mi>p</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>c</mi></mrow></msub></mrow><mo>}</mo></mrow><annotation encoding="application/x-tex">\left\{c\in\Gamma\,\mid\,p\in\mathcal{M}_{\leq c}\right\}</annotation></semantics></math><span id="S4.I7.i4.p1.1.3" class="ltx_text ltx_font_italic"> has a minimal element.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.Thmthm27" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm27.2" class="ltx_text ltx_font_bold">Theorem 4.27</span></span><span id="S4.Thmthm27.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm27.p1" class="ltx_para">
<p id="S4.Thmthm27.p1.1" class="ltx_p"><span id="S4.Thmthm27.p1.1.1" class="ltx_text ltx_font_italic">The polynomial numerical invariant <math id="S4.Thmthm27.p1.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> defines a <math id="S4.Thmthm27.p1.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification on the stack <math id="S4.Thmthm27.p1.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS5.p2" class="ltx_para">
<p id="S4.SS5.p2.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Thm. 2.26]</cite><span id="S4.SS5.p2.1.1" class="ltx_text"> (or <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">HL14</a>, Thm. B]</cite>) shows that it suffices to check that <math id="S4.SS5.p2.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> satisfies HN boundedness and is strictly <math id="S4.SS5.p2.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-monotone on the stack <math id="S4.SS5.p2.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>. This follows by Propositions <a href="#S4.Thmthm25" title="Proposition 4.25. ‣ 4.4. HN boundedness ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.25</span></a> and <a href="#S4.Thmthm15" title="Proposition 4.15. ‣ 4.3. Monotonicity of the numerical invariant ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.15</span></a>.
∎</span></p>
</div>
</div>
<div id="S4.SS5.p3" class="ltx_para">
<p id="S4.SS5.p3.1" class="ltx_p">The following is a translation of the notion of <math id="S4.SS5.p3.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-semistability from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">HL14</a>, §2.1]</cite> for our numerical invariant <math id="S4.SS5.p3.m2" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm28" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm28.2" class="ltx_text ltx_font_bold">Definition 4.28</span></span><span id="S4.Thmthm28.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm28.p1" class="ltx_para">
<p id="S4.Thmthm28.p1.1" class="ltx_p"><span id="S4.Thmthm28.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm28.p1.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be an algebraically closed field extension. Let <math id="S4.Thmthm28.p1.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S4.Thmthm28.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S4.Thmthm28.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. We say that <math id="S4.Thmthm28.p1.m5" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> is Gieseker semistable if for all weighted parabolic reductions <math id="S4.Thmthm28.p1.m6" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> with associated underlying filtrations <math id="S4.Thmthm28.p1.m7" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> (as in Definition <a href="#S3.Thmthm15" title="Definition 3.15. ‣ 3.3. Filtrations of 
          
            ρ
          
        -sheaves in the split case ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.15</span></a>) we have</span></p>
<table id="S4.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex62.m1" class="ltx_Math" alttext="\sum_{m\in\mathbb{Z}}m\cdot(\overline{p}_{\mathcal{F}_{m}/\mathcal{F}_{m+1}}-\overline{p}_{\mathcal{F}})\cdot\rk(\mathcal{F}_{m}/\mathcal{F}_{m+1})\leq 0" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{m\in\mathbb{Z}}m\cdot(\overline{p}_{\mathcal{F}_{m}/\mathcal{F}_{m+1}}-\overline{p}_{\mathcal{F}})\cdot\rk(\mathcal{F}_{m}/\mathcal{F}_{m+1})\leq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm28.p1.2" class="ltx_p"><span id="S4.Thmthm28.p1.2.1" class="ltx_text ltx_font_italic">In general, if <math id="S4.Thmthm28.p1.m8" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> is any field extension, then we say that a <math id="S4.Thmthm28.p1.m9" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S4.Thmthm28.p1.m10" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> on <math id="S4.Thmthm28.p1.m11" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> is Gieseker semistable if the pullback <math id="S4.Thmthm28.p1.m12" class="ltx_Math" alttext="(\mathcal{F}|_{X_{\overline{K}}},\sigma|_{X_{\overline{K}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mover accent="true"><mi>K</mi><mo stretchy="true">¯</mo></mover></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mover accent="true"><mi>K</mi><mo stretchy="true">¯</mo></mover></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{\overline{K}}},\sigma|_{X_{\overline{K}}})</annotation></semantics></math> is semistable for any algebraic closure <math id="S4.Thmthm28.p1.m13" class="ltx_Math" alttext="\overline{K}\supset K" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>K</mi><mo stretchy="true">¯</mo></mover><mo>⊃</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">\overline{K}\supset K</annotation></semantics></math>.
A <math id="S4.Thmthm28.p1.m14" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S4.Thmthm28.p1.m15" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> on <math id="S4.Thmthm28.p1.m16" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math> is called unstable if it is not Gieseker semistable.</span></p>
</div>
</div>
<div id="S4.SS5.p4" class="ltx_para">
<p id="S4.SS5.p4.1" class="ltx_p">The summation by parts argument in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Prop. 4.1]</cite> shows that the expression in Definition <a href="#S4.Thmthm28" title="Definition 4.28. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.28</span></a> can be rewritten as</p>
<table id="S4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(12)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E12.m1" class="ltx_Math" alttext="\sum_{m\in\mathbb{Z}}m\cdot(\overline{p}_{\mathcal{F}_{m}/\mathcal{F}_{m+1}}-\overline{p}_{\mathcal{F}})\cdot\rk(\mathcal{F}_{m}/\mathcal{F}_{m+1})=\sum_{m\in\mathbb{Z}}(\overline{p}_{\mathcal{F}_{m}}-\overline{p}_{\mathcal{F}})\cdot\rk(\mathcal{F}_{m})" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub></msub><mo>−</mo><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi mathsize="0.800em">rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{m\in\mathbb{Z}}m\cdot(\overline{p}_{\mathcal{F}_{m}/\mathcal{F}_{m+1}}-\overline{p}_{\mathcal{F}})\cdot\rk(\mathcal{F}_{m}/\mathcal{F}_{m+1})=\sum_{m\in\mathbb{Z}}(\overline{p}_{\mathcal{F}_{m}}-\overline{p}_{\mathcal{F}})\cdot\rk(\mathcal{F}_{m})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS5.p5" class="ltx_para">
<p id="S4.SS5.p5.1" class="ltx_p">By Theorem <a href="#S4.Thmthm27" title="Theorem 4.27. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.27</span></a>, the polynomial numerical invariant <math id="S4.SS5.p5.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> defines a <math id="S4.SS5.p5.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification on <math id="S4.SS5.p5.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>. In particular the locus of semistable <math id="S4.SS5.p5.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves is an open substack, which we will denote by <math id="S4.SS5.p5.m5" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss}</annotation></semantics></math>. Note that <math id="S4.SS5.p5.m6" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss}</annotation></semantics></math> is a disjoint union of open and closed substacks where the Hilbert polynomial of the underlying torsion-free sheaf is constant. For every rational polynomial <math id="S4.SS5.p5.m7" class="ltx_Math" alttext="P\in\mathbb{Q}[n]" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P\in\mathbb{Q}[n]</annotation></semantics></math>, we will denote by <math id="S4.SS5.p5.m8" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss,P}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>,</mo><mi>P</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss,P}</annotation></semantics></math> the open and closed substack of <math id="S4.SS5.p5.m9" class="ltx_Math" alttext="\Bun_{\rho}(X)^{ss}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)^{ss}</annotation></semantics></math> parametrizing Gieseker semistable <math id="S4.SS5.p5.m10" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves <math id="S4.SS5.p5.m11" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> such that the Hilbert polynomial of <math id="S4.SS5.p5.m12" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is <math id="S4.SS5.p5.m13" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.</p>
</div>
<div id="S4.SS5.p6" class="ltx_para">
<p id="S4.SS5.p6.1" class="ltx_p">We will next explain what it means to have a <math id="S4.SS5.p6.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification on <math id="S4.SS5.p6.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> in terms of canonical filtrations.</p>
</div>
<div id="S4.Thmthm29" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm29.2" class="ltx_text ltx_font_bold">Definition 4.29</span></span><span id="S4.Thmthm29.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm29.p1" class="ltx_para">
<p id="S4.Thmthm29.p1.1" class="ltx_p"><span id="S4.Thmthm29.p1.1.1" class="ltx_text ltx_font_italic">Suppose that <math id="S4.Thmthm29.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is algebraically closed. Let <math id="S4.Thmthm29.p1.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be an unstable <math id="S4.Thmthm29.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S4.Thmthm29.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. A weighted parabolic reduction <math id="S4.Thmthm29.p1.m5" class="ltx_Math" alttext="f=(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> is called canonical if the polynomial invariant <math id="S4.Thmthm29.p1.m6" class="ltx_Math" alttext="\nu(f)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(f)</annotation></semantics></math> is maximal among all weighted parabolic reductions of <math id="S4.Thmthm29.p1.m7" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>. We say that the associated underlying filtration <math id="S4.Thmthm29.p1.m8" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> to <math id="S4.Thmthm29.p1.m9" class="ltx_Math" alttext="f=(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f=(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> is a canonical filtration of <math id="S4.Thmthm29.p1.m10" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.p7" class="ltx_para">
<p id="S4.SS5.p7.1" class="ltx_p">We already know that a weighted parabolic reduction <math id="S4.SS5.p7.m1" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> determines a unique underlying filtration <math id="S4.SS5.p7.m2" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math>. By Proposition <a href="#S3.Thmthm9" title="Proposition 3.9. ‣ 3.2. Filtrations of 
          
            ρ
          
        -sheaves ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.9</span></a>, the converse is true. Namely, the underlying filtration <math id="S4.SS5.p7.m3" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> uniquely determines the weighted parabolic reduction <math id="S4.SS5.p7.m4" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> over an open subset <math id="S4.SS5.p7.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> where <math id="S4.SS5.p7.m6" class="ltx_Math" alttext="\bigoplus_{m\in\mathbb{Z}}\mathcal{F}_{m}/\mathcal{F}_{m+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>⨁</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\bigoplus_{m\in\mathbb{Z}}\mathcal{F}_{m}/\mathcal{F}_{m+1}</annotation></semantics></math> is locally-free. Hence the data of a canonical weighted parabolic reduction is equivalent to specifying its underlying canonical filtration.</p>
</div>
<div id="S4.Thmthm30" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm30.2" class="ltx_text ltx_font_bold">Definition 4.30</span></span><span id="S4.Thmthm30.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm30.p1" class="ltx_para">
<p id="S4.Thmthm30.p1.1" class="ltx_p"><span id="S4.Thmthm30.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm30.p1.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be an arbitrary field extension. Let <math id="S4.Thmthm30.p1.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be an unstable <math id="S4.Thmthm30.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S4.Thmthm30.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. A <math id="S4.Thmthm30.p1.m5" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-weighted filtration <math id="S4.Thmthm30.p1.m6" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> of <math id="S4.Thmthm30.p1.m7" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is called a canonical filtration if for any algebraic closure <math id="S4.Thmthm30.p1.m8" class="ltx_Math" alttext="\overline{K}\supset K" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>K</mi><mo stretchy="true">¯</mo></mover><mo>⊃</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">\overline{K}\supset K</annotation></semantics></math> we have that <math id="S4.Thmthm30.p1.m9" class="ltx_Math" alttext="(\mathcal{F}_{m}|_{X_{\overline{K}}})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mover accent="true"><mi>K</mi><mo stretchy="true">¯</mo></mover></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m}|_{X_{\overline{K}}})_{m\in\mathbb{Z}}</annotation></semantics></math> is a canonical filtration of <math id="S4.Thmthm30.p1.m10" class="ltx_Math" alttext="(\mathcal{F}|_{X_{\overline{K}}},\sigma|_{X_{\overline{K}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mover accent="true"><mi>K</mi><mo stretchy="true">¯</mo></mover></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mover accent="true"><mi>K</mi><mo stretchy="true">¯</mo></mover></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{\overline{K}}},\sigma|_{X_{\overline{K}}})</annotation></semantics></math></span></p>
</div>
</div>
<div id="S4.SS5.p8" class="ltx_para">
<p id="S4.SS5.p8.1" class="ltx_p">The fact that <math id="S4.SS5.p8.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> defines a <math id="S4.SS5.p8.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification on <math id="S4.SS5.p8.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> implies that any field valued point of <math id="S4.SS5.p8.m4" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> admits a <math id="S4.SS5.p8.m5" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math>-maximizing <math id="S4.SS5.p8.m6" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-filtration that is unique up to scaling the weights. We can use our concrete descriptions of <math id="S4.SS5.p8.m7" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-filtrations for <math id="S4.SS5.p8.m8" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> to translate this into the following.</p>
</div>
<div id="S4.Thmthm31" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm31.2" class="ltx_text ltx_font_bold">Proposition 4.31</span></span><span id="S4.Thmthm31.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm31.p1" class="ltx_para">
<p id="S4.Thmthm31.p1.1" class="ltx_p"><span id="S4.Thmthm31.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm31.p1.m1" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> be an arbitrary field extension. Let <math id="S4.Thmthm31.p1.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S4.Thmthm31.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S4.Thmthm31.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. Then, <math id="S4.Thmthm31.p1.m5" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> admits a canonical filtration <math id="S4.Thmthm31.p1.m6" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> which is uniquely determined up to scaling all of the indexes by a constant rational number.</span></p>
</div>
<div id="S4.Thmthm31.p2" class="ltx_para">
<p id="S4.Thmthm31.p2.1" class="ltx_p"><span id="S4.Thmthm31.p2.1.1" class="ltx_text ltx_font_italic">Furthermore, if the group <math id="S4.Thmthm31.p2.m1" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is split, then there exists a (uniquely determined) canonical weighted parabolic reduction <math id="S4.Thmthm31.p2.m2" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> defined over <math id="S4.Thmthm31.p2.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> such that its associated underlying filtration is <math id="S4.Thmthm31.p2.m4" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm32" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm32.2" class="ltx_text ltx_font_bold">Definition 4.32</span></span><span id="S4.Thmthm32.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm32.p1" class="ltx_para">
<p id="S4.Thmthm32.p1.1" class="ltx_p"><span id="S4.Thmthm32.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm32.p1.m1" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be field valued point of <math id="S4.Thmthm32.p1.m2" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math>. Suppose that <math id="S4.Thmthm32.p1.m3" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> is unstable. We call the canonical filtration <math id="S4.Thmthm32.p1.m4" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> the leading term HN filtration of <math id="S4.Thmthm32.p1.m5" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>. It is uniquely determined up to scaling the weights, by Proposition <a href="#S4.Thmthm31" title="Proposition 4.31. ‣ 4.5. 
          
            Θ
          
        -stratification, semistability and leading term filtrations ‣ 4. 
        
          Θ
        
      -stratification on 
        
          
            
              
              Bun
              ρ
            
            
              
              
                (
                X
                ) ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.31</span></a>.</span></p>
</div>
<div id="S4.Thmthm32.p2" class="ltx_para">
<p id="S4.Thmthm32.p2.1" class="ltx_p"><span id="S4.Thmthm32.p2.1.1" class="ltx_text ltx_font_italic">On the other hand, if <math id="S4.Thmthm32.p2.m1" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> is Gieseker semistable, then we define the leading term HN filtration to be <math id="S4.Thmthm32.p2.m2" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> where</span></p>
<table id="S4.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex63.m1" class="ltx_Math" alttext="\mathcal{F}_{m}=\begin{cases}\mathcal{F}\text{ \; \; if m $\leq$ 0}\;\\
0\;\;\;\;\;\;\;\text{otherwise}\;\end{cases}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mtext class="ltx_mathvariant_italic"> if m </mtext><mo>≤</mo><mtext class="ltx_mathvariant_italic"> 0</mtext></mrow></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mspace style="width:1.54em;" width="1.54em"></mspace><mtext class="ltx_mathvariant_italic">otherwise</mtext></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{m}=\begin{cases}\mathcal{F}\text{ \; \; if m $\leq$ 0}\;\\
0\;\;\;\;\;\;\;\text{otherwise}\;\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS5.p9" class="ltx_para">
<p id="S4.SS5.p9.1" class="ltx_p">One should think of the leading term HN filtration as an analogue of the slope filtration. Here the coefficient of degree <math id="S4.SS5.p9.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in the reduced Hilbert polynomial plays the role of the slope. This is made precise in the following</p>
</div>
<div id="S4.Thmthm33" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm33.2" class="ltx_text ltx_font_bold">Example 4.33</span></span><span id="S4.Thmthm33.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm33.p1" class="ltx_para">
<p id="S4.Thmthm33.p1.1" class="ltx_p"><span id="S4.Thmthm33.p1.1.1" class="ltx_text ltx_font_italic">Suppose that <math id="S4.Thmthm33.p1.m1" class="ltx_Math" alttext="G=\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G=\GL(V)</annotation></semantics></math> and <math id="S4.Thmthm33.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is the identity. Then <math id="S4.Thmthm33.p1.m3" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> is equivalent to the stack <math id="S4.Thmthm33.p1.m4" class="ltx_Math" alttext="\Coh_{r}^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">Coh</mi><mi>r</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Coh_{r}^{tf}(X)</annotation></semantics></math> of torsion-free sheaves of rank <math id="S4.Thmthm33.p1.m5" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> on <math id="S4.Thmthm33.p1.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. In this case Proposition <a href="#S3.Thmthm8" title="Proposition 3.8. ‣ 3.2. Filtrations of 
          
            ρ
          
        -sheaves ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a> gives a description of a filtration of a torsion-free sheaf <math id="S4.Thmthm33.p1.m7" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> in <math id="S4.Thmthm33.p1.m8" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> as a decreasing <math id="S4.Thmthm33.p1.m9" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-filtration of <math id="S4.Thmthm33.p1.m10" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> by saturated subsheaves <math id="S4.Thmthm33.p1.m11" class="ltx_Math" alttext="\mathcal{F}_{m}\subset\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>⊂</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">\mathcal{F}_{m}\subset\mathcal{F}</annotation></semantics></math>. The proof of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Prop. 5.16]</cite> shows that a torsion-free sheaf in <math id="S4.Thmthm33.p1.m12" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> is Gieseker semistable in our sense if and only if it is Gieseker semistable in the sense of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx30" title="" class="ltx_ref">HL97</a>, Defn. 1.2.4]</cite>.</span></p>
</div>
<div id="S4.Thmthm33.p2" class="ltx_para">
<p id="S4.Thmthm33.p2.1" class="ltx_p"><span id="S4.Thmthm33.p2.1.1" class="ltx_text ltx_font_italic">The leading term HN filtration for torsion-free sheaves in <math id="S4.Thmthm33.p2.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> recovers the weighted leading term filtration described in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">HLHJ21</a>, Thm. 5.11]</cite>, which we reproduce here. Let</span></p>
<table id="S4.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex64.m1" class="ltx_Math" alttext="0=\mathcal{F}^{\text{HN}}_{0}\subset\mathcal{F}^{\text{HN}}_{1}\subset\mathcal{F}^{\text{HN}}_{2}\subset\cdots\subset\mathcal{F}^{\text{HN}}_{n}=\mathcal{F}" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>n</mi><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">0=\mathcal{F}^{\text{HN}}_{0}\subset\mathcal{F}^{\text{HN}}_{1}\subset\mathcal{F}^{\text{HN}}_{2}\subset\cdots\subset\mathcal{F}^{\text{HN}}_{n}=\mathcal{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm33.p2.2" class="ltx_p"><span id="S4.Thmthm33.p2.2.1" class="ltx_text ltx_font_italic">denote the Gieseker-Harder-Narasimhan filtration of <math id="S4.Thmthm33.p2.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx30" title="" class="ltx_ref">HL97</a>, Thm. 1.3.4]</cite>).
Then we have</span></p>
<table id="S4.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex65.m1" class="ltx_Math" alttext="\overline{p}_{\mathcal{F}_{1}^{\text{HN}}}&gt;\overline{p}_{\mathcal{F}_{2}^{\text{HN}}/\mathcal{F}_{1}^{\text{HN}}}&gt;\cdots&gt;\overline{p}_{\mathcal{F}_{n}^{\text{HN}}/\mathcal{F}_{n-1}^{\text{HN}}}" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></msub><mo>&gt;</mo><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></mrow></msub><mo rspace="0.1389em">&gt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&gt;</mo><msub><mover accent="true"><mi>p</mi><mo stretchy="true">¯</mo></mover><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>n</mi><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{p}_{\mathcal{F}_{1}^{\text{HN}}}&gt;\overline{p}_{\mathcal{F}_{2}^{\text{HN}}/\mathcal{F}_{1}^{\text{HN}}}&gt;\cdots&gt;\overline{p}_{\mathcal{F}_{n}^{\text{HN}}/\mathcal{F}_{n-1}^{\text{HN}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm33.p2.3" class="ltx_p"><span id="S4.Thmthm33.p2.3.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm33.p2.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> denote the minimal index such that</span></p>
<table id="S4.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex66.m1" class="ltx_Math" alttext="\widehat{\mu}_{h}(\mathcal{F}_{1}^{\text{HN}})=\widehat{\mu}_{h}(\mathcal{F}_{2}^{\text{HN}}/\mathcal{F}_{1}^{\text{HN}})=\cdots=\widehat{\mu}_{h}(\mathcal{F}_{n}^{\text{HN}}/\mathcal{F}_{n-1}^{\text{HN}})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>n</mi><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{h}(\mathcal{F}_{1}^{\text{HN}})=\widehat{\mu}_{h}(\mathcal{F}_{2}^{\text{HN}}/\mathcal{F}_{1}^{\text{HN}})=\cdots=\widehat{\mu}_{h}(\mathcal{F}_{n}^{\text{HN}}/\mathcal{F}_{n-1}^{\text{HN}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm33.p2.4" class="ltx_p"><span id="S4.Thmthm33.p2.4.1" class="ltx_text ltx_font_italic">for all <math id="S4.Thmthm33.p2.m4" class="ltx_Math" alttext="h&gt;i" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>&gt;</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">h&gt;i</annotation></semantics></math>. In other words, <math id="S4.Thmthm33.p2.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is the largest integer such that the <math id="S4.Thmthm33.p2.m6" class="ltx_Math" alttext="i^{th}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">i^{th}</annotation></semantics></math> slopes of the graded pieces of the filtration are not all equal. We have</span></p>
<table id="S4.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex67.m1" class="ltx_Math" alttext="\widehat{\mu}_{i}(\mathcal{F}_{1}^{\text{HN}})\geq\widehat{\mu}_{i}(\mathcal{F}_{2}^{\text{HN}}/\mathcal{F}_{1}^{\text{HN}})\geq\cdots\geq\widehat{\mu}_{i}(\mathcal{F}_{n}^{\text{HN}}/\mathcal{F}_{n-1}^{\text{HN}})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>n</mi><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{i}(\mathcal{F}_{1}^{\text{HN}})\geq\widehat{\mu}_{i}(\mathcal{F}_{2}^{\text{HN}}/\mathcal{F}_{1}^{\text{HN}})\geq\cdots\geq\widehat{\mu}_{i}(\mathcal{F}_{n}^{\text{HN}}/\mathcal{F}_{n-1}^{\text{HN}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm33.p2.5" class="ltx_p"><span id="S4.Thmthm33.p2.5.1" class="ltx_text ltx_font_italic">where at least one of the inequalities above is strict.</span></p>
</div>
<div id="S4.Thmthm33.p3" class="ltx_para">
<p id="S4.Thmthm33.p3.1" class="ltx_p"><span id="S4.Thmthm33.p3.1.1" class="ltx_text ltx_font_italic">We define indexes <math id="S4.Thmthm33.p3.m1" class="ltx_Math" alttext="h_{0}&lt;h_{1}&lt;h_{2}&lt;\cdots&lt;h_{j}=n" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>0</mn></msub><mo>&lt;</mo><msub><mi>h</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>h</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>h</mi><mi>j</mi></msub><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">h_{0}&lt;h_{1}&lt;h_{2}&lt;\cdots&lt;h_{j}=n</annotation></semantics></math> as follows. We let <math id="S4.Thmthm33.p3.m2" class="ltx_Math" alttext="h_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h_{0}=0</annotation></semantics></math>, and let</span></p>
<table id="S4.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex68.m1" class="ltx_math_unparsed" alttext="\{h_{m}\}_{m=1}^{j}=\left\{\;1\leq l\leq n\;\left|\;\widehat{\mu}_{i}(\mathcal{F}_{l+1}^{\text{HN}}/\mathcal{F}_{l}^{\text{HN}})&lt;\widehat{\mu}_{i}(\mathcal{F}_{l}^{\text{HN}}/\mathcal{F}_{l-1}^{\text{HN}})\right.\right\}" display="block" intent=":literal"><semantics><mrow><msubsup><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><msub><mi>h</mi><mi>m</mi></msub><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></msubsup><mo>=</mo><mrow><mo>{</mo><mn> 1</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>n</mi><mo fence="false" lspace="0.220em" rspace="0.387em">|</mo><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>l</mi><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>l</mi><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\{h_{m}\}_{m=1}^{j}=\left\{\;1\leq l\leq n\;\left|\;\widehat{\mu}_{i}(\mathcal{F}_{l+1}^{\text{HN}}/\mathcal{F}_{l}^{\text{HN}})&lt;\widehat{\mu}_{i}(\mathcal{F}_{l}^{\text{HN}}/\mathcal{F}_{l-1}^{\text{HN}})\right.\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm33.p3.2" class="ltx_p"><span id="S4.Thmthm33.p3.2.1" class="ltx_text ltx_font_italic">This ensures that <math id="S4.Thmthm33.p3.m3" class="ltx_Math" alttext="\widehat{\mu}_{i}(\mathcal{F}_{h_{k}}^{\text{HN}}/\mathcal{F}_{h_{k-1}}^{\text{HN}})&gt;\widehat{\mu}_{i}(\mathcal{F}_{h_{k+1}}^{\text{HN}}/\mathcal{F}_{h_{k}}^{\text{HN}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>h</mi><mi>k</mi></msub><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>h</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>h</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>h</mi><mi>k</mi></msub><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{i}(\mathcal{F}_{h_{k}}^{\text{HN}}/\mathcal{F}_{h_{k-1}}^{\text{HN}})&gt;\widehat{\mu}_{i}(\mathcal{F}_{h_{k+1}}^{\text{HN}}/\mathcal{F}_{h_{k}}^{\text{HN}})</annotation></semantics></math>. For each <math id="S4.Thmthm33.p3.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, we set <math id="S4.Thmthm33.p3.m5" class="ltx_Math" alttext="\mathcal{F}^{\text{l-term}}_{k}=\mathcal{F}^{\text{HN}}_{h_{k}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>h</mi><mi>k</mi></msub><mtext class="ltx_mathvariant_italic">HN</mtext></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\text{l-term}}_{k}=\mathcal{F}^{\text{HN}}_{h_{k}}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.Thmthm33.p4" class="ltx_para">
<p id="S4.Thmthm33.p4.1" class="ltx_p"><span id="S4.Thmthm33.p4.1.1" class="ltx_text ltx_font_italic">The filtration</span></p>
<table id="S4.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex69.m1" class="ltx_Math" alttext="0=\mathcal{F}^{\text{l-term}}_{0}\subset\mathcal{F}^{\text{l-term}}_{1}\subset\mathcal{F}^{\text{l-term}}_{2}\subset\cdots\subset\mathcal{F}^{\text{l-term}}_{j}=\mathcal{F}" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">0=\mathcal{F}^{\text{l-term}}_{0}\subset\mathcal{F}^{\text{l-term}}_{1}\subset\mathcal{F}^{\text{l-term}}_{2}\subset\cdots\subset\mathcal{F}^{\text{l-term}}_{j}=\mathcal{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm33.p4.2" class="ltx_p"><span id="S4.Thmthm33.p4.2.1" class="ltx_text ltx_font_italic">is called the unweighted leading term filtration of <math id="S4.Thmthm33.p4.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>. We call <math id="S4.Thmthm33.p4.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> the leading term index.</span></p>
</div>
<div id="S4.Thmthm33.p5" class="ltx_para">
<p id="S4.Thmthm33.p5.1" class="ltx_p"><span id="S4.Thmthm33.p5.1.1" class="ltx_text ltx_font_italic">We remark that, if <math id="S4.Thmthm33.p5.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is slope unstable, then <math id="S4.Thmthm33.p5.m2" class="ltx_Math" alttext="i=d-1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=d-1</annotation></semantics></math> (recall that <math id="S4.Thmthm33.p5.m3" class="ltx_Math" alttext="\widehat{\mu}_{d-1}(\mathcal{F})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{d-1}(\mathcal{F})</annotation></semantics></math> is the slope of <math id="S4.Thmthm33.p5.m4" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>), and the leading term filtration is the slope-Harder-Narasimhan filtration.</span></p>
</div>
<div id="S4.Thmthm33.p6" class="ltx_para">
<p id="S4.Thmthm33.p6.1" class="ltx_p"><span id="S4.Thmthm33.p6.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm33.p6.m1" class="ltx_Math" alttext="\mathcal{F}\in\Bun_{\rho}(X)=\Coh_{r}^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∈</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi mathsize="0.800em">Coh</mi><mi>r</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}\in\Bun_{\rho}(X)=\Coh_{r}^{tf}(X)</annotation></semantics></math> and assume that <math id="S4.Thmthm33.p6.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is unstable. Suppose that the unweighted leading term filtration for <math id="S4.Thmthm33.p6.m3" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is given by</span></p>
<table id="S4.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex70.m1" class="ltx_Math" alttext="0=\mathcal{F}^{\text{l-term}}_{0}\subset\mathcal{F}^{\text{l-term}}_{1}\subset\mathcal{F}^{\text{l-term}}_{2}\subset\cdots\subset\mathcal{F}^{\text{l-term}}_{j}=\mathcal{F}" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">0=\mathcal{F}^{\text{l-term}}_{0}\subset\mathcal{F}^{\text{l-term}}_{1}\subset\mathcal{F}^{\text{l-term}}_{2}\subset\cdots\subset\mathcal{F}^{\text{l-term}}_{j}=\mathcal{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm33.p6.2" class="ltx_p"><span id="S4.Thmthm33.p6.2.1" class="ltx_text ltx_font_italic">with leading slope <math id="S4.Thmthm33.p6.m4" class="ltx_Math" alttext="\widehat{\mu}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\widehat{\mu}_{i}</annotation></semantics></math>. Set <math id="S4.Thmthm33.p6.m5" class="ltx_Math" alttext="\mu=\widehat{\mu}_{i}(\mathcal{F})" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu=\widehat{\mu}_{i}(\mathcal{F})</annotation></semantics></math>, <math id="S4.Thmthm33.p6.m6" class="ltx_Math" alttext="\mu_{k}=\widehat{\mu}_{i}\left(\mathcal{F}^{\text{l-term}}_{k}/\mathcal{F}^{\text{l-term}}_{k-1}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo mathsize="0.800em">^</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup><mo>/</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{k}=\widehat{\mu}_{i}\left(\mathcal{F}^{\text{l-term}}_{k}/\mathcal{F}^{\text{l-term}}_{k-1}\right)</annotation></semantics></math>. Choose a positive rational number <math id="S4.Thmthm33.p6.m7" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> such that <math id="S4.Thmthm33.p6.m8" class="ltx_Math" alttext="L\cdot\mu\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>μ</mi></mrow><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">L\cdot\mu\in\mathbb{Z}</annotation></semantics></math> and <math id="S4.Thmthm33.p6.m9" class="ltx_Math" alttext="L\cdot\mu_{k}\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">L\cdot\mu_{k}\in\mathbb{Z}</annotation></semantics></math> for all <math id="S4.Thmthm33.p6.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</span></p>
</div>
<div id="S4.Thmthm33.p7" class="ltx_para">
<p id="S4.Thmthm33.p7.1" class="ltx_p"><span id="S4.Thmthm33.p7.1.1" class="ltx_text ltx_font_italic">Then, we define the weighted leading term filtration <math id="S4.Thmthm33.p7.m1" class="ltx_Math" alttext="(\mathcal{F}^{\text{Can}}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mtext class="ltx_mathvariant_italic">Can</mtext></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}^{\text{Can}}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> as follows (up to scaling of the weights).</span></p>
<ol id="S4.I8" class="ltx_enumerate">
<li id="S4.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I8.i1.p1" class="ltx_para">
<p id="S4.I8.i1.p1.1" class="ltx_p"><math id="S4.I8.i1.p1.m1" class="ltx_Math" alttext="\mathcal{F}^{\text{Can}}_{m}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mtext class="ltx_mathvariant_italic">Can</mtext></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\text{Can}}_{m}=0</annotation></semantics></math><span id="S4.I8.i1.p1.1.1" class="ltx_text ltx_font_italic"> for </span><math id="S4.I8.i1.p1.m2" class="ltx_Math" alttext="m&gt;L(\mu_{1}-\mu)" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>&gt;</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m&gt;L(\mu_{1}-\mu)</annotation></semantics></math><span id="S4.I8.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I8.i2.p1" class="ltx_para">
<p id="S4.I8.i2.p1.1" class="ltx_p"><span id="S4.I8.i2.p1.1.1" class="ltx_text ltx_font_italic">Let </span><math id="S4.I8.i2.p1.m1" class="ltx_Math" alttext="1\leq k\leq j-1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq k\leq j-1</annotation></semantics></math><span id="S4.I8.i2.p1.1.2" class="ltx_text ltx_font_italic">. For each </span><math id="S4.I8.i2.p1.m2" class="ltx_Math" alttext="L(\mu_{k}-\mu)\geq m&gt;L(\mu_{k+1}-\mu)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>m</mi><mo>&gt;</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L(\mu_{k}-\mu)\geq m&gt;L(\mu_{k+1}-\mu)</annotation></semantics></math><span id="S4.I8.i2.p1.1.3" class="ltx_text ltx_font_italic">, we set </span><math id="S4.I8.i2.p1.m3" class="ltx_Math" alttext="\mathcal{F}^{\text{Can}}_{m}=\mathcal{F}^{\text{l-term}}_{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mtext class="ltx_mathvariant_italic">Can</mtext></msubsup><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>k</mi><mtext class="ltx_mathvariant_italic">l-term</mtext></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\text{Can}}_{m}=\mathcal{F}^{\text{l-term}}_{k}</annotation></semantics></math><span id="S4.I8.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I8.i3.p1" class="ltx_para">
<p id="S4.I8.i3.p1.1" class="ltx_p"><math id="S4.I8.i3.p1.m1" class="ltx_Math" alttext="\mathcal{F}^{\text{Can}}_{m}=\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi><mtext class="ltx_mathvariant_italic">Can</mtext></msubsup><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">\mathcal{F}^{\text{Can}}_{m}=\mathcal{F}</annotation></semantics></math><span id="S4.I8.i3.p1.1.1" class="ltx_text ltx_font_italic"> for </span><math id="S4.I8.i3.p1.m2" class="ltx_Math" alttext="L(\mu_{j}-\mu)\geq m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mi>j</mi></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">L(\mu_{j}-\mu)\geq m</annotation></semantics></math><span id="S4.I8.i3.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S4.Thmthm33.p7.2" class="ltx_p"><span id="S4.Thmthm33.p7.2.1" class="ltx_text ltx_font_italic">In other words, the weighted leading term filtration is given by the leading term filtration and the <math id="S4.Thmthm33.p7.m2" class="ltx_Math" alttext="k^{th}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">k^{th}</annotation></semantics></math> jump happens at the integer <math id="S4.Thmthm33.p7.m3" class="ltx_Math" alttext="L(\mu_{k}-\mu)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(\mu_{k}-\mu)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.p10" class="ltx_para">
<p id="S4.SS5.p10.1" class="ltx_p">The existence of a <math id="S4.SS5.p10.m1" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification also implies that the notion of leading term HN filtration behaves well in families. In order to explain this precisely, we need to first define what is a filtration of a family of <math id="S4.SS5.p10.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaves.
Let <math id="S4.SS5.p10.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="S4.SS5.p10.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme and let <math id="S4.SS5.p10.m5" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S4.SS5.p10.m6" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S4.SS5.p10.m7" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>. A filtration of <math id="S4.SS5.p10.m8" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is a <math id="S4.SS5.p10.m9" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-weighted filtration <math id="S4.SS5.p10.m10" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> of <math id="S4.SS5.p10.m11" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> satisfying the following.</p>
<ol id="S4.I9" class="ltx_enumerate">
<li id="S4.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I9.i1.p1" class="ltx_para">
<p id="S4.I9.i1.p1.1" class="ltx_p"><math id="S4.I9.i1.p1.m1" class="ltx_Math" alttext="\mathcal{F}_{m+1}\subset\mathcal{F}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{m+1}\subset\mathcal{F}_{m}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I9.i2.p1" class="ltx_para">
<p id="S4.I9.i2.p1.1" class="ltx_p"><math id="S4.I9.i2.p1.m1" class="ltx_Math" alttext="\mathcal{F}_{m}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{F}_{m}=0</annotation></semantics></math> for <math id="S4.I9.i2.p1.m2" class="ltx_Math" alttext="m\gg 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≫</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\gg 0</annotation></semantics></math> and <math id="S4.I9.i2.p1.m3" class="ltx_Math" alttext="\mathcal{F}_{m}=\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">\mathcal{F}_{m}=\mathcal{F}</annotation></semantics></math> for <math id="S4.I9.i2.p1.m4" class="ltx_Math" alttext="m\ll 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≪</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\ll 0</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I9.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I9.i3.p1" class="ltx_para">
<p id="S4.I9.i3.p1.1" class="ltx_p"><math id="S4.I9.i3.p1.m1" class="ltx_Math" alttext="\mathcal{F}_{m}/\mathcal{F}_{m+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{m}/\mathcal{F}_{m+1}</annotation></semantics></math> is a <math id="S4.I9.i3.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-flat family of torsion-free sheaves.</p>
</div></li>
</ol>
</div>
<div id="S4.SS5.p11" class="ltx_para">
<p id="S4.SS5.p11.1" class="ltx_p">An argument similar to Proposition <a href="#S3.Thmthm8" title="Proposition 3.8. ‣ 3.2. Filtrations of 
          
            ρ
          
        -sheaves ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a> shows that the data of such filtration <math id="S4.SS5.p11.m1" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> is equivalent to the data of a morphism of stacks <math id="S4.SS5.p11.m2" class="ltx_Math" alttext="\Theta_{S}\rightarrow\Coh_{r}^{tf}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mi>S</mi></msub><mo stretchy="false">→</mo><mrow><msubsup><mi mathsize="0.800em">Coh</mi><mi>r</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta_{S}\rightarrow\Coh_{r}^{tf}(X)</annotation></semantics></math> such that the restriction to <math id="S4.SS5.p11.m3" class="ltx_Math" alttext="1_{S}" display="inline" intent=":literal"><semantics><msub><mn>1</mn><mi>S</mi></msub><annotation encoding="application/x-tex">1_{S}</annotation></semantics></math> recovers <math id="S4.SS5.p11.m4" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>. This amounts to a torsion-free sheaf <math id="S4.SS5.p11.m5" class="ltx_Math" alttext="\widetilde{\mathcal{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}</annotation></semantics></math> on <math id="S4.SS5.p11.m6" class="ltx_Math" alttext="X_{\Theta_{S}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><msub><mi mathvariant="normal">Θ</mi><mi>S</mi></msub></msub><annotation encoding="application/x-tex">X_{\Theta_{S}}</annotation></semantics></math>. Let <math id="S4.SS5.p11.m7" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be a big open subset of <math id="S4.SS5.p11.m8" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math> where <math id="S4.SS5.p11.m9" class="ltx_Math" alttext="\bigoplus_{m\in\mathbb{Z}}\mathcal{F}_{m}/\mathcal{F}_{m+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>⨁</mo><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\bigoplus_{m\in\mathbb{Z}}\mathcal{F}_{m}/\mathcal{F}_{m+1}</annotation></semantics></math> is locally-free. Then, the restriction <math id="S4.SS5.p11.m10" class="ltx_Math" alttext="\widetilde{\mathcal{F}}|_{U\times_{S}\Theta_{S}}" display="inline" intent=":literal"><semantics><msub><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">|</mo></mrow><mrow><mi>U</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></msub><msub><mi mathvariant="normal">Θ</mi><mi>S</mi></msub></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}|_{U\times_{S}\Theta_{S}}</annotation></semantics></math> is a <math id="S4.SS5.p11.m11" class="ltx_Math" alttext="\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V)</annotation></semantics></math>-bundle on <math id="S4.SS5.p11.m12" class="ltx_Math" alttext="U\times_{S}\Theta_{S}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></msub><msub><mi mathvariant="normal">Θ</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">U\times_{S}\Theta_{S}</annotation></semantics></math> and <math id="S4.SS5.p11.m13" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> induces a <math id="S4.SS5.p11.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reduction of structure group of the restriction <math id="S4.SS5.p11.m15" class="ltx_Math" alttext="\widetilde{\mathcal{F}}|_{U\times_{S}1_{S}}" display="inline" intent=":literal"><semantics><msub><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">|</mo></mrow><mrow><mi>U</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></msub><msub><mn>1</mn><mi>S</mi></msub></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}|_{U\times_{S}1_{S}}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm34" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm34.2" class="ltx_text ltx_font_bold">Definition 4.34</span></span><span id="S4.Thmthm34.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm34.p1" class="ltx_para">
<p id="S4.Thmthm34.p1.1" class="ltx_p"><span id="S4.Thmthm34.p1.1.1" class="ltx_text ltx_font_italic">We say that <math id="S4.Thmthm34.p1.m1" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> as above is a filtration of <math id="S4.Thmthm34.p1.m2" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> if the <math id="S4.Thmthm34.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reduction of structure group (uniquely) extends to <math id="S4.Thmthm34.p1.m4" class="ltx_Math" alttext="U\times_{S}\Theta_{S}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></msub><msub><mi mathvariant="normal">Θ</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">U\times_{S}\Theta_{S}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.p12" class="ltx_para">
<p id="S4.SS5.p12.1" class="ltx_p">An argument similar to Proposition <a href="#S3.Thmthm12" title="Proposition 3.12. ‣ 3.2. Filtrations of 
          
            ρ
          
        -sheaves ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.12</span></a> implies that such a filtration of <math id="S4.SS5.p12.m1" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> is equivalent to a morphism <math id="S4.SS5.p12.m2" class="ltx_Math" alttext="\Theta_{S}\rightarrow\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mi>S</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta_{S}\rightarrow\Bun_{\rho}(X)</annotation></semantics></math> such that the restriction to <math id="S4.SS5.p12.m3" class="ltx_Math" alttext="1_{S}" display="inline" intent=":literal"><semantics><msub><mn>1</mn><mi>S</mi></msub><annotation encoding="application/x-tex">1_{S}</annotation></semantics></math> recovers <math id="S4.SS5.p12.m4" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm35" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm35.2" class="ltx_text ltx_font_bold">Definition 4.35</span></span><span id="S4.Thmthm35.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm35.p1" class="ltx_para">
<p id="S4.Thmthm35.p1.1" class="ltx_p"><span id="S4.Thmthm35.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm35.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="S4.Thmthm35.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme and let <math id="S4.Thmthm35.p1.m3" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S4.Thmthm35.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S4.Thmthm35.p1.m5" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>. We say that a filtration <math id="S4.Thmthm35.p1.m6" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> of <math id="S4.Thmthm35.p1.m7" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> is a relative leading term HN filtration if for all points <math id="S4.Thmthm35.p1.m8" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math> the restriction <math id="S4.Thmthm35.p1.m9" class="ltx_Math" alttext="(\mathcal{F}_{m}|_{X_{s}})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m}|_{X_{s}})_{m\in\mathbb{Z}}</annotation></semantics></math> is the leading term HN filtration of <math id="S4.Thmthm35.p1.m10" class="ltx_Math" alttext="(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{s}},\sigma|_{X_{s}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.p13" class="ltx_para">
<p id="S4.SS5.p13.1" class="ltx_p">Suppose that <math id="S4.SS5.p13.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is a connected scheme of finite type over a field extension <math id="S4.SS5.p13.m2" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> and assume that <math id="S4.SS5.p13.m3" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is split. In this case, every relative filtration comes from a relative weighted parabolic reduction. Indeed, let <math id="S4.SS5.p13.m4" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S4.SS5.p13.m5" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S4.SS5.p13.m6" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>, and let <math id="S4.SS5.p13.m7" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> be a relative filtration of <math id="S4.SS5.p13.m8" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>. Let <math id="S4.SS5.p13.m9" class="ltx_Math" alttext="\widetilde{\mathcal{G}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}</annotation></semantics></math> denote the corresponding <math id="S4.SS5.p13.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S4.SS5.p13.m11" class="ltx_Math" alttext="\Theta_{K}\times_{K}U" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mi>K</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></msub><mi>U</mi></mrow><annotation encoding="application/x-tex">\Theta_{K}\times_{K}U</annotation></semantics></math> for some big open subset <math id="S4.SS5.p13.m12" class="ltx_Math" alttext="U\subset X_{S}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><msub><mi>X</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">U\subset X_{S}</annotation></semantics></math>. We denote by <math id="S4.SS5.p13.m13" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> the <math id="S4.SS5.p13.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S4.SS5.p13.m15" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> corresponding to <math id="S4.SS5.p13.m16" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> (i.e. the restriction <math id="S4.SS5.p13.m17" class="ltx_Math" alttext="\widetilde{\mathcal{G}}|_{1\times S}" display="inline" intent=":literal"><semantics><msub><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">|</mo></mrow><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}|_{1\times S}</annotation></semantics></math>). Since <math id="S4.SS5.p13.m18" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is geometrically connected and smooth, the fibers of <math id="S4.SS5.p13.m19" class="ltx_Math" alttext="X_{S}\rightarrow S" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>S</mi></msub><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">X_{S}\rightarrow S</annotation></semantics></math> are integral, hence the fibers of <math id="S4.SS5.p13.m20" class="ltx_Math" alttext="U\rightarrow S" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">U\rightarrow S</annotation></semantics></math> are also integral. Since <math id="S4.SS5.p13.m21" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is connected, we conclude that <math id="S4.SS5.p13.m22" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> is a connected scheme of finite type over <math id="S4.SS5.p13.m23" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.
Proposition <a href="#S3.Thmthm14" title="Proposition 3.14. ‣ 3.3. Filtrations of 
          
            ρ
          
        -sheaves in the split case ‣ 3. Principal 
        
          ρ
        
      -sheaves ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.14</span></a> shows that <math id="S4.SS5.p13.m24" class="ltx_Math" alttext="\widetilde{\mathcal{G}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}</annotation></semantics></math> arises from applying the Rees construction to a weighted parabolic reduction <math id="S4.SS5.p13.m25" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> of the <math id="S4.SS5.p13.m26" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S4.SS5.p13.m27" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> on <math id="S4.SS5.p13.m28" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. We call <math id="S4.SS5.p13.m29" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math> a relative weighted parabolic reduction of <math id="S4.SS5.p13.m30" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> and note that the filtration <math id="S4.SS5.p13.m31" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> is uniquely determined by <math id="S4.SS5.p13.m32" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math>. Then we say that the filtration <math id="S4.SS5.p13.m33" class="ltx_Math" alttext="(\mathcal{F}_{m})_{m\in\mathbb{Z}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><annotation encoding="application/x-tex">(\mathcal{F}_{m})_{m\in\mathbb{Z}}</annotation></semantics></math> comes from the relative weighted parabolic reduction <math id="S4.SS5.p13.m34" class="ltx_Math" alttext="(\lambda,\mathcal{G}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,\mathcal{G}_{\lambda})</annotation></semantics></math>.</p>
</div>
<div id="S4.SS5.p14" class="ltx_para">
<p id="S4.SS5.p14.1" class="ltx_p">Let <math id="S4.SS5.p14.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="S4.SS5.p14.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme and <math id="S4.SS5.p14.m3" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S4.SS5.p14.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S4.SS5.p14.m5" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math>. Let <math id="S4.SS5.p14.m6" class="ltx_Math" alttext="H\rightarrow S" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">H\rightarrow S</annotation></semantics></math> be a locally closed stratification of <math id="S4.SS5.p14.m7" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. This means that <math id="S4.SS5.p14.m8" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is the disjoint union of locally closed subschemes of <math id="S4.SS5.p14.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and the morphism <math id="S4.SS5.p14.m10" class="ltx_Math" alttext="H\rightarrow S" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">H\rightarrow S</annotation></semantics></math> is surjective.</p>
</div>
<div id="S4.Thmthm36" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm36.2" class="ltx_text ltx_font_bold">Definition 4.36</span></span><span id="S4.Thmthm36.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm36.p1" class="ltx_para">
<p id="S4.Thmthm36.p1.1" class="ltx_p"><span id="S4.Thmthm36.p1.1.1" class="ltx_text ltx_font_italic">We say that the <math id="S4.Thmthm36.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-scheme <math id="S4.Thmthm36.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is universal for leading term HN filtrations of <math id="S4.Thmthm36.p1.m3" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> if it represents the functor that classifies pairs <math id="S4.Thmthm36.p1.m4" class="ltx_Math" alttext="\left(T,[(\mathcal{F}_{m})_{m\in\mathbb{Z}}]\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mi>T</mi><mo>,</mo><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(T,[(\mathcal{F}_{m})_{m\in\mathbb{Z}}]\right)</annotation></semantics></math>, where <math id="S4.Thmthm36.p1.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is a <math id="S4.Thmthm36.p1.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-scheme and <math id="S4.Thmthm36.p1.m7" class="ltx_Math" alttext="[(\mathcal{F}_{m})_{m\in\mathbb{Z}}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[(\mathcal{F}_{m})_{m\in\mathbb{Z}}]</annotation></semantics></math> is an equivalence class of relative leading term HN filtrations of <math id="S4.Thmthm36.p1.m8" class="ltx_Math" alttext="(\mathcal{F}|_{X_{T}},\sigma|_{X_{T}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo>,</mo><msub><mrow><mi>σ</mi><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>T</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F}|_{X_{T}},\sigma|_{X_{T}})</annotation></semantics></math> up to rational scaling the weights.</span></p>
</div>
</div>
<div id="S4.SS5.p15" class="ltx_para">
<p id="S4.SS5.p15.1" class="ltx_p">The fact that the numerical invariant <math id="S4.SS5.p15.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> induces a <math id="S4.SS5.p15.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>-stratification implies the following property of the leading term HN filtration in families, called a “schematic stratification” in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx42" title="" class="ltx_ref">Nit11</a>, <a href="#bib.bibx20" title="" class="ltx_ref">GN14</a>, <a href="#bib.bibx22" title="" class="ltx_ref">GN18</a>]</cite>.</p>
</div>
<div id="S4.Thmthm37" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm37.2" class="ltx_text ltx_font_bold">Proposition 4.37</span></span><span id="S4.Thmthm37.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm37.p1" class="ltx_para">
<p id="S4.Thmthm37.p1.1" class="ltx_p"><span id="S4.Thmthm37.p1.1.1" class="ltx_text ltx_font_italic">Relative leading term HN filtrations induce a stratification of <math id="S4.Thmthm37.p1.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> by locally closed substacks. Equivalently, for any <math id="S4.Thmthm37.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-scheme <math id="S4.Thmthm37.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and every <math id="S4.Thmthm37.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S4.Thmthm37.p1.m5" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> on <math id="S4.Thmthm37.p1.m6" class="ltx_Math" alttext="X_{S}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>S</mi></msub><annotation encoding="application/x-tex">X_{S}</annotation></semantics></math> there is a unique locally closed stratification <math id="S4.Thmthm37.p1.m7" class="ltx_Math" alttext="H\to S" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">H\to S</annotation></semantics></math> that is universal for leading term HN filtrations of <math id="S4.Thmthm37.p1.m8" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>.</span></p>
</div>
<div id="S4.Thmthm37.p2" class="ltx_para">
<p id="S4.Thmthm37.p2.1" class="ltx_p"><span id="S4.Thmthm37.p2.1.1" class="ltx_text ltx_font_italic">If, in addition, <math id="S4.Thmthm37.p2.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is locally of finite type over a field extension <math id="S4.Thmthm37.p2.m2" class="ltx_Math" alttext="K\supset k" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊃</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">K\supset k</annotation></semantics></math> such that <math id="S4.Thmthm37.p2.m3" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is split, then the restriction of the universal relative leading term HN filtration<span id="footnote4" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">4</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">4</sup>
                  <span class="ltx_tag ltx_tag_note"><span id="footnote4.1" class="ltx_text ltx_font_upright">4</span></span>
                  
                  
                  
                  
                  
                  
                  
                <span id="footnote4.10" class="ltx_text ltx_font_upright">More precisely, we choose a representative up to scaling.
</span></span></span></span> to each connected component of the stratification <math id="S4.Thmthm37.p2.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> comes from a relative weighted parabolic reduction.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5. </span>Moduli space for the semistable locus</h2>

<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1. </span>Completeness of the stack <math id="S5.SS1.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math></h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">In this subsection we prove that the stack <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="\Bun_{\rho}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Bun</mi><mi>ρ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Bun_{\rho}(X)</annotation></semantics></math> satisfies the existence part of the valuative criterion for properness <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Sta23</a>, <a href="https://stacks.math.columbia.edu/tag/0CLK" title="" class="ltx_ref ltx_href">Tag 0CLK</a>]</cite> in the case of complete discrete valuation rings (see Theorem <a href="#S5.Thmthm7" title="Theorem 5.7. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.7</span></a>).</p>
</div>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.1" class="ltx_p">The ideas that we use in this section (purely ramified extensions, Bruhat-Tits buildings) already appear in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx12" title="" class="ltx_ref">BS02</a>, Section 6]</cite> (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx11" title="" class="ltx_ref">BP03</a>]</cite> for positive characteristic). Besides, V. Balaji has also considered extensions of families of principal bundles in higher dimensions, in the context of Donaldson-Uhlenbeck compactification <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx5" title="" class="ltx_ref">Bal07</a>]</cite>. The case of positive characteristic for curves has also been studied by J. Heinloth <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">Hei08b</a>, <a href="#bib.bibx28" title="" class="ltx_ref">Hei10</a>]</cite>. For torsion free sheaves, the valuative criteria was proved by S. Langton <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx38" title="" class="ltx_ref">Lan75</a>]</cite>.</p>
</div>
<div id="S5.SS1.p3" class="ltx_para">
<p id="S5.SS1.p3.1" class="ltx_p">Let <math id="S5.SS1.p3.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> be a complete discrete valuation <math id="S5.SS1.p3.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-algebra. We set <math id="S5.SS1.p3.m3" class="ltx_Math" alttext="K=\Frac(R)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mi mathsize="0.800em">Frac</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K=\Frac(R)</annotation></semantics></math>, and choose a uniformizer <math id="S5.SS1.p3.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>. By the Cohen structure theorem, <math id="S5.SS1.p3.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is isomorphic to the power series ring <math id="S5.SS1.p3.m6" class="ltx_Math" alttext="\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>π</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]</annotation></semantics></math>, where <math id="S5.SS1.p3.m7" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> is the residue field. Consider the base change <math id="S5.SS1.p3.m8" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math>. Let <math id="S5.SS1.p3.m9" class="ltx_Math" alttext="\eta_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">\eta_{\kappa}</annotation></semantics></math> denote the generic point of the special fiber <math id="S5.SS1.p3.m10" class="ltx_Math" alttext="X_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">X_{\kappa}</annotation></semantics></math>. Similarly, let <math id="S5.SS1.p3.m11" class="ltx_Math" alttext="\eta_{K}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>K</mi></msub><annotation encoding="application/x-tex">\eta_{K}</annotation></semantics></math> be the generic point of the generic fiber <math id="S5.SS1.p3.m12" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. Note that the local <math id="S5.SS1.p3.m13" class="ltx_Math" alttext="\mathcal{O}_{X_{R},\eta_{\kappa}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><annotation encoding="application/x-tex">\mathcal{O}_{X_{R},\eta_{\kappa}}</annotation></semantics></math> is a discrete valuation ring with generic point <math id="S5.SS1.p3.m14" class="ltx_Math" alttext="\eta_{K}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>K</mi></msub><annotation encoding="application/x-tex">\eta_{K}</annotation></semantics></math> and special point <math id="S5.SS1.p3.m15" class="ltx_Math" alttext="\eta_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">\eta_{\kappa}</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmthm1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm1.2" class="ltx_text ltx_font_bold">Lemma 5.1</span></span><span id="S5.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm1.p1" class="ltx_para">
<p id="S5.Thmthm1.p1.1" class="ltx_p"><span id="S5.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmthm1.p1.m1" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math> be a <math id="S5.Thmthm1.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf over <math id="S5.Thmthm1.p1.m3" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math>. Let <math id="S5.Thmthm1.p1.m4" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> be the corresponding <math id="S5.Thmthm1.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle over the generic fiber <math id="S5.Thmthm1.p1.m6" class="ltx_Math" alttext="\eta_{K}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>K</mi></msub><annotation encoding="application/x-tex">\eta_{K}</annotation></semantics></math>. The following statements are equivalent:</span></p>
<ol id="S5.I1" class="ltx_enumerate">
<li id="S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I1.i1.p1" class="ltx_para">
<p id="S5.I1.i1.p1.1" class="ltx_p"><span id="S5.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">There is a </span><math id="S5.I1.i1.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math><span id="S5.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">-sheaf on </span><math id="S5.I1.i1.p1.m2" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math><span id="S5.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> that restricts to </span><math id="S5.I1.i1.p1.m3" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math><span id="S5.I1.i1.p1.1.4" class="ltx_text ltx_font_italic"> over </span><math id="S5.I1.i1.p1.m4" class="ltx_Math" alttext="X_{K}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>K</mi></msub><annotation encoding="application/x-tex">X_{K}</annotation></semantics></math><span id="S5.I1.i1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I1.i2.p1" class="ltx_para">
<p id="S5.I1.i2.p1.1" class="ltx_p"><span id="S5.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">There is a </span><math id="S5.I1.i2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S5.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">-bundle on </span><math id="S5.I1.i2.p1.m2" class="ltx_Math" alttext="\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})</annotation></semantics></math><span id="S5.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> that restricts to </span><math id="S5.I1.i2.p1.m3" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math><span id="S5.I1.i2.p1.1.4" class="ltx_text ltx_font_italic"> over </span><math id="S5.I1.i2.p1.m4" class="ltx_Math" alttext="\eta_{K}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>K</mi></msub><annotation encoding="application/x-tex">\eta_{K}</annotation></semantics></math><span id="S5.I1.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS1.p4" class="ltx_para">
<p id="S5.SS1.p4.1" class="ltx_p"><math id="S5.SS1.p4.m1" class="ltx_Math" alttext="(1)\Longrightarrow(2)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟹</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(1)\Longrightarrow(2)</annotation></semantics></math><span id="S5.SS1.p4.1.1" class="ltx_text">. Suppose that <math id="S5.SS1.p4.m2" class="ltx_Math" alttext="(\widetilde{\mathcal{F}},\zeta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\widetilde{\mathcal{F}},\zeta)</annotation></semantics></math> is a <math id="S5.SS1.p4.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf on <math id="S5.SS1.p4.m4" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math> that extends <math id="S5.SS1.p4.m5" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>. Let <math id="S5.SS1.p4.m6" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> be a big open subset of <math id="S5.SS1.p4.m7" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math> where <math id="S5.SS1.p4.m8" class="ltx_Math" alttext="\widetilde{\mathcal{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}</annotation></semantics></math> is locally-free. Let <math id="S5.SS1.p4.m9" class="ltx_Math" alttext="\widetilde{\mathcal{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\mathcal{P}}</annotation></semantics></math> be the <math id="S5.SS1.p4.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S5.SS1.p4.m11" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> corresponding to the restriction of <math id="S5.SS1.p4.m12" class="ltx_Math" alttext="(\widetilde{\mathcal{F}},\zeta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\widetilde{\mathcal{F}},\zeta)</annotation></semantics></math>. Then <math id="S5.SS1.p4.m13" class="ltx_Math" alttext="\widetilde{\mathcal{P}}|_{\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})}" display="inline" intent=":literal"><semantics><msub><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{P}}|_{\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})}</annotation></semantics></math> is a <math id="S5.SS1.p4.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S5.SS1.p4.m15" class="ltx_Math" alttext="\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})</annotation></semantics></math> that extends <math id="S5.SS1.p4.m16" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p5" class="ltx_para">
<p id="S5.SS1.p5.1" class="ltx_p"><math id="S5.SS1.p5.m1" class="ltx_Math" alttext="(2)\Longrightarrow(1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟹</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(2)\Longrightarrow(1)</annotation></semantics></math><span id="S5.SS1.p5.1.1" class="ltx_text">. Suppose that there is a <math id="S5.SS1.p5.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S5.SS1.p5.m3" class="ltx_Math" alttext="\widetilde{\mathcal{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\mathcal{P}}</annotation></semantics></math> on <math id="S5.SS1.p5.m4" class="ltx_Math" alttext="\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})</annotation></semantics></math> that extends <math id="S5.SS1.p5.m5" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>. Let <math id="S5.SS1.p5.m6" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> be the corresponding <math id="S5.SS1.p5.m7" class="ltx_Math" alttext="\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V)</annotation></semantics></math>-bundle on <math id="S5.SS1.p5.m8" class="ltx_Math" alttext="\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})</annotation></semantics></math> obtained via extension of structure group using <math id="S5.SS1.p5.m9" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>. <math id="S5.SS1.p5.m10" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> is a vector bundle of rank <math id="S5.SS1.p5.m11" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> on <math id="S5.SS1.p5.m12" class="ltx_Math" alttext="\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})</annotation></semantics></math>. By construction we have a canonical identification <math id="S5.SS1.p5.m13" class="ltx_Math" alttext="\mathcal{A}|_{\eta_{K}}\xrightarrow{\sim}\mathcal{F}|_{\eta_{K}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>K</mi></msub></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>K</mi></msub></msub></mrow><annotation encoding="application/x-tex">\mathcal{A}|_{\eta_{K}}\xrightarrow{\sim}\mathcal{F}|_{\eta_{K}}</annotation></semantics></math>. Now <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx38" title="" class="ltx_ref">Lan75</a>, Prop. 6]</cite> implies that there is a (unique) family of torsion-free sheaves <math id="S5.SS1.p5.m14" class="ltx_Math" alttext="\widetilde{\mathcal{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}</annotation></semantics></math> on <math id="S5.SS1.p5.m15" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math> along with isomorphisms <math id="S5.SS1.p5.m16" class="ltx_Math" alttext="\widetilde{\mathcal{F}}|_{X_{K}}\xrightarrow{\sim}\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">|</mo></mrow><msub><mi>X</mi><mi>K</mi></msub></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}|_{X_{K}}\xrightarrow{\sim}\mathcal{F}</annotation></semantics></math> and <math id="S5.SS1.p5.m17" class="ltx_Math" alttext="\widetilde{\mathcal{F}}|_{\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})}\xrightarrow{\sim}\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{F}}|_{\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})}\xrightarrow{\sim}\mathcal{A}</annotation></semantics></math> that are compatible with the identification <math id="S5.SS1.p5.m18" class="ltx_Math" alttext="\mathcal{A}|_{\eta_{K}}\xrightarrow{\sim}\mathcal{F}|_{\eta_{K}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>K</mi></msub></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>K</mi></msub></msub></mrow><annotation encoding="application/x-tex">\mathcal{A}|_{\eta_{K}}\xrightarrow{\sim}\mathcal{F}|_{\eta_{K}}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p6" class="ltx_para">
<p id="S5.SS1.p6.1" class="ltx_p"><span id="S5.SS1.p6.1.1" class="ltx_text">We have a section <math id="S5.SS1.p6.m1" class="ltx_Math" alttext="s:\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})\rightarrow\Red_{G}(\widetilde{\mathcal{F}})|_{\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><msub><mrow><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mrow><mi mathsize="1.140em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><msub><mi>η</mi><mi>κ</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">s:\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})\rightarrow\Red_{G}(\widetilde{\mathcal{F}})|_{\Spec(\mathcal{O}_{X_{R},\eta_{\kappa}})}</annotation></semantics></math> corresponding to the <math id="S5.SS1.p6.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-reduction <math id="S5.SS1.p6.m3" class="ltx_Math" alttext="\widetilde{P}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>P</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{P}</annotation></semantics></math>. It identifies over the point <math id="S5.SS1.p6.m4" class="ltx_Math" alttext="\eta_{K}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>K</mi></msub><annotation encoding="application/x-tex">\eta_{K}</annotation></semantics></math> with the section <math id="S5.SS1.p6.m5" class="ltx_Math" alttext="\sigma:X_{K}\rightarrow\Red_{G}(\mathcal{F})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>X</mi><mi>K</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma:X_{K}\rightarrow\Red_{G}(\mathcal{F})</annotation></semantics></math>. Since <math id="S5.SS1.p6.m6" class="ltx_Math" alttext="\Red_{G}(\widetilde{\mathcal{F}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Red_{G}(\widetilde{\mathcal{F}})</annotation></semantics></math> is of finite type over <math id="S5.SS1.p6.m7" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math>, we can spread the compatible pair <math id="S5.SS1.p6.m8" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and <math id="S5.SS1.p6.m9" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> to a section</span></p>
<table id="S5.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex71.m1" class="ltx_Math" alttext="\widetilde{\sigma}:X_{R}\setminus Z\rightarrow\Red_{G}(\widetilde{\mathcal{F}})" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>σ</mi><mo mathsize="0.800em">~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>∖</mo><mi>Z</mi></mrow><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\sigma}:X_{R}\setminus Z\rightarrow\Red_{G}(\widetilde{\mathcal{F}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p6.2" class="ltx_p"><span id="S5.SS1.p6.2.1" class="ltx_text">defined away from a proper closed subscheme <math id="S5.SS1.p6.m10" class="ltx_Math" alttext="Z\subsetneq X_{\kappa}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊊</mo><msub><mi>X</mi><mi>κ</mi></msub></mrow><annotation encoding="application/x-tex">Z\subsetneq X_{\kappa}</annotation></semantics></math> of the special fiber <math id="S5.SS1.p6.m11" class="ltx_Math" alttext="X_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">X_{\kappa}</annotation></semantics></math>. Note that every point <math id="S5.SS1.p6.m12" class="ltx_Math" alttext="z\in Z" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">z\in Z</annotation></semantics></math> has codimension at least 2 in <math id="S5.SS1.p6.m13" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math>. Since <math id="S5.SS1.p6.m14" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math> is smooth over the regular scheme <math id="S5.SS1.p6.m15" class="ltx_Math" alttext="\Spec(R)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(R)</annotation></semantics></math>, it is itself regular <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Sta23</a>, <a href="https://stacks.math.columbia.edu/tag/07NF" title="" class="ltx_ref ltx_href">Tag 07NF</a>]</cite>. It follows that for every <math id="S5.SS1.p6.m16" class="ltx_Math" alttext="z\in Z" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">z\in Z</annotation></semantics></math>, the local ring <math id="S5.SS1.p6.m17" class="ltx_Math" alttext="\mathcal{O}_{X_{R},z}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>,</mo><mi>z</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{O}_{X_{R},z}</annotation></semantics></math> has depth at least 2. By the proof of Lemma <a href="#S2.Thmthm3" title="Lemma 2.3. ‣ 2.2. Big open sets and torsion-free sheaves ‣ 2. Preliminaries ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> (c), the section <math id="S5.SS1.p6.m18" class="ltx_Math" alttext="\widetilde{\sigma}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>σ</mi><mo mathsize="0.800em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{\sigma}</annotation></semantics></math> on <math id="S5.SS1.p6.m19" class="ltx_Math" alttext="X_{R}\setminus Z" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>R</mi></msub><mo>∖</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">X_{R}\setminus Z</annotation></semantics></math> uniquely extends to a section <math id="S5.SS1.p6.m20" class="ltx_Math" alttext="\zeta:X_{R}\rightarrow\Red_{G}(\widetilde{\mathcal{F}})" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>X</mi><mi>R</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi mathsize="0.800em">Red</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta:X_{R}\rightarrow\Red_{G}(\widetilde{\mathcal{F}})</annotation></semantics></math> defined over the whole <math id="S5.SS1.p6.m21" class="ltx_Math" alttext="X_{R}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>R</mi></msub><annotation encoding="application/x-tex">X_{R}</annotation></semantics></math>. The <math id="S5.SS1.p6.m22" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-sheaf <math id="S5.SS1.p6.m23" class="ltx_Math" alttext="(\widetilde{\mathcal{F}},\zeta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo mathsize="0.800em">~</mo></mover><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\widetilde{\mathcal{F}},\zeta)</annotation></semantics></math> restricts to <math id="S5.SS1.p6.m24" class="ltx_Math" alttext="(\mathcal{F},\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{F},\sigma)</annotation></semantics></math>, as desired.
∎</span></p>
</div>
</div>
<div id="S5.SS1.p7" class="ltx_para">
<p id="S5.SS1.p7.1" class="ltx_p">We would like to show that the extension result in Lemma <a href="#S5.Thmthm1" title="Lemma 5.1. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> (2) is true after maybe passing to a finite extension <math id="S5.SS1.p7.m1" class="ltx_Math" alttext="R^{\prime}\supset R" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>′</mo></msup><mo>⊃</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">R^{\prime}\supset R</annotation></semantics></math> of the discrete valuation ring <math id="S5.SS1.p7.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. In order to do so, we prove the following general result.<span id="footnote5" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">5</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">5</sup>
              <span class="ltx_tag ltx_tag_note">5</span>
              
              
              
              
              
              
              
            V. Balaji pointed out to us that Proposition <a href="#S5.Thmthm2" title="Proposition 5.2. ‣ 5.1. Completeness of the stack 
          
            
              
                
                Bun
                ρ
              
              
                
                
                  (
                  X
                  ) ‣ 5. Moduli space for the semistable locus ‣ The moduli stack of principal 
      
        ρ
      
    -sheaves and Gieseker-Harder-Narasimhan filtrations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> could also be deduced from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx45" title="" class="ltx_ref">RR84</a>, Proposition 3.12]</cite>.</span></span></span></p>
</div>
<div id="S5.Thmthm2" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm2.2" class="ltx_text ltx_font_bold">Proposition 5.2</span></span><span id="S5.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm2.p1" class="ltx_para">
<p id="S5.Thmthm2.p1.1" class="ltx_p"><span id="S5.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmthm2.p1.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> be a perfect field. Let <math id="S5.Thmthm2.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a quasi-split connected reductive group over <math id="S5.Thmthm2.p1.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>. Suppose that the two following conditions are satisfied:</span></p>
<ol id="S5.I2" class="ltx_enumerate">
<li id="S5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I2.i1.p1" class="ltx_para">
<p id="S5.I2.i1.p1.1" class="ltx_p"><span id="S5.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">The maximal central torus </span><math id="S5.I2.i1.p1.m1" class="ltx_Math" alttext="Z\subset G" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">Z\subset G</annotation></semantics></math><span id="S5.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> is split over </span><math id="S5.I2.i1.p1.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math><span id="S5.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I2.i2.p1" class="ltx_para">
<p id="S5.I2.i2.p1.1" class="ltx_p"><span id="S5.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">Let </span><math id="S5.I2.i2.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="S5.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> denote the kernel of of the simply-connected cover </span><math id="S5.I2.i2.p1.m2" class="ltx_Math" alttext="\widetilde{G/Z}\rightarrow G/Z" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>G</mi><mo>/</mo><mi>Z</mi></mrow><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">→</mo><mrow><mi>G</mi><mo>/</mo><mi>Z</mi></mrow></mrow><annotation encoding="application/x-tex">\widetilde{G/Z}\rightarrow G/Z</annotation></semantics></math><span id="S5.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> of the semisimple group </span><math id="S5.I2.i2.p1.m3" class="ltx_Math" alttext="G/Z" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>/</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">G/Z</annotation></semantics></math><span id="S5.I2.i2.p1.1.4" class="ltx_text ltx_font_italic">. The characteristic of </span><math id="S5.I2.i2.p1.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math><span id="S5.I2.i2.p1.1.5" class="ltx_text ltx_font_italic"> does not divide the order of </span><math id="S5.I2.i2.p1.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="S5.I2.i2.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S5.Thmthm2.p1.2" class="ltx_p"><span id="S5.Thmthm2.p1.2.1" class="ltx_text ltx_font_italic">Set <math id="S5.Thmthm2.p1.m4" class="ltx_Math" alttext="\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>π</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]</annotation></semantics></math> to be the formal power series ring. Let <math id="S5.Thmthm2.p1.m5" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> be a <math id="S5.Thmthm2.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on the fraction field <math id="S5.Thmthm2.p1.m7" class="ltx_Math" alttext="\Spec(\kappa(\hskip-1.99168pt({\pi})\hskip-1.99168pt))" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\kappa(\hskip-1.99168pt({\pi})\hskip-1.99168pt))</annotation></semantics></math>. Then, there exists some <math id="S5.Thmthm2.p1.m8" class="ltx_Math" alttext="m\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m\geq 1</annotation></semantics></math> such that the pullback of <math id="S5.Thmthm2.p1.m9" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> to <math id="S5.Thmthm2.p1.m10" class="ltx_Math" alttext="\Spec(\kappa(\hskip-1.99168pt({\pi^{\frac{1}{m}}})\hskip-1.99168pt))" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\kappa(\hskip-1.99168pt({\pi^{\frac{1}{m}}})\hskip-1.99168pt))</annotation></semantics></math> extends to a <math id="S5.Thmthm2.p1.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle on <math id="S5.Thmthm2.p1.m12" class="ltx_Math" alttext="\Spec(\kappa[\hskip-1.42262pt[{\pi^{\frac{1}{m}}}]\hskip-1.42262pt])" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\kappa[\hskip-1.42262pt[{\pi^{\frac{1}{m}}}]\hskip-1.42262pt])</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS1.p8" class="ltx_para">
<p id="S5.SS1.p8.1" class="ltx_p"><span id="S5.SS1.p8.1.1" class="ltx_text">Define <math id="S5.SS1.p8.m1" class="ltx_Math" alttext="K\vcentcolon=\kappa(\hskip-1.99168pt({\pi})\hskip-1.99168pt)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>:=</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K\vcentcolon=\kappa(\hskip-1.99168pt({\pi})\hskip-1.99168pt)</annotation></semantics></math> and <math id="S5.SS1.p8.m2" class="ltx_Math" alttext="\mathcal{O}_{K}=\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>K</mi></msub><mo>=</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>π</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}_{K}=\kappa[\hskip-1.42262pt[{\pi}]\hskip-1.42262pt]</annotation></semantics></math>. We fix the choice of a separable closure <math id="S5.SS1.p8.m3" class="ltx_Math" alttext="K_{s}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>s</mi></msub><annotation encoding="application/x-tex">K_{s}</annotation></semantics></math> of <math id="S5.SS1.p8.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Set <math id="S5.SS1.p8.m5" class="ltx_Math" alttext="K_{unr}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">K_{unr}</annotation></semantics></math> to be the maximal unramified extension of <math id="S5.SS1.p8.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> inside <math id="S5.SS1.p8.m7" class="ltx_Math" alttext="K_{s}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>s</mi></msub><annotation encoding="application/x-tex">K_{s}</annotation></semantics></math>. We will denote by <math id="S5.SS1.p8.m8" class="ltx_Math" alttext="\mathcal{O}_{K_{unr}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><annotation encoding="application/x-tex">\mathcal{O}_{K_{unr}}</annotation></semantics></math> the ring of integers of <math id="S5.SS1.p8.m9" class="ltx_Math" alttext="K_{unr}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">K_{unr}</annotation></semantics></math>. Let <math id="S5.SS1.p8.m10" class="ltx_Math" alttext="\Gamma_{K}:=\Gal(K_{s}/K)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Γ</mi><mi>K</mi></msub><mo>:=</mo><mrow><mi mathsize="0.800em">Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mi>s</mi></msub><mo>/</mo><mi>K</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{K}:=\Gal(K_{s}/K)</annotation></semantics></math> be the absolute Galois group of <math id="S5.SS1.p8.m11" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. We denote by <math id="S5.SS1.p8.m12" class="ltx_Math" alttext="\Gamma_{unr}\vcentcolon=\Gal(K_{unr}/K)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>:=</mo><mrow><mi mathsize="0.800em">Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>/</mo><mi>K</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{unr}\vcentcolon=\Gal(K_{unr}/K)</annotation></semantics></math> the unramified Galois group. We denote by <math id="S5.SS1.p8.m13" class="ltx_Math" alttext="H^{1}(K,G)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(K,G)</annotation></semantics></math> (resp. <math id="S5.SS1.p8.m14" class="ltx_Math" alttext="H^{1}(\mathcal{O}_{K},G)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>K</mi></msub><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\mathcal{O}_{K},G)</annotation></semantics></math> ) the pointed set of <math id="S5.SS1.p8.m15" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundles on <math id="S5.SS1.p8.m16" class="ltx_Math" alttext="\Spec(K)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(K)</annotation></semantics></math> (resp. <math id="S5.SS1.p8.m17" class="ltx_Math" alttext="\Spec(\mathcal{O}_{K})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>K</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(\mathcal{O}_{K})</annotation></semantics></math>). We have a natural restriction morphism <math id="S5.SS1.p8.m18" class="ltx_Math" alttext="H^{1}(\mathcal{O}_{K},G)\rightarrow H^{1}(K,G)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>K</mi></msub><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\mathcal{O}_{K},G)\rightarrow H^{1}(K,G)</annotation></semantics></math>. We are given an element <math id="S5.SS1.p8.m19" class="ltx_Math" alttext="\mathcal{P}\in H^{1}(K,G)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>∈</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}\in H^{1}(K,G)</annotation></semantics></math>. Our goal is to show that, after maybe replacing <math id="S5.SS1.p8.m20" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> with an extension <math id="S5.SS1.p8.m21" class="ltx_Math" alttext="K(\pi^{\frac{1}{m}})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(\pi^{\frac{1}{m}})</annotation></semantics></math>, there exists some <math id="S5.SS1.p8.m22" class="ltx_Math" alttext="\widetilde{\mathcal{P}}\in H^{1}(\mathcal{O}_{K},G)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo mathsize="0.800em">~</mo></mover><mo>∈</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>K</mi></msub><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{P}}\in H^{1}(\mathcal{O}_{K},G)</annotation></semantics></math> that restricts to <math id="S5.SS1.p8.m23" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p9" class="ltx_para">
<p id="S5.SS1.p9.1" class="ltx_p"><span id="S5.SS1.p9.1.1" class="ltx_text">Since <math id="S5.SS1.p9.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is smooth, the base-change <math id="S5.SS1.p9.m2" class="ltx_Math" alttext="\mathcal{P}_{K_{s}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><msub><mi>K</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{P}_{K_{s}}</annotation></semantics></math> is trivializable over <math id="S5.SS1.p9.m3" class="ltx_Math" alttext="\Spec(K_{s})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Spec(K_{s})</annotation></semantics></math>. The descent data for <math id="S5.SS1.p9.m4" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> yield a class in the nonabelian Galois cohomology set <math id="S5.SS1.p9.m5" class="ltx_Math" alttext="H^{1}(\Gamma_{K},G(K_{s}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mi>K</mi></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\Gamma_{K},G(K_{s}))</annotation></semantics></math>. Since <math id="S5.SS1.p9.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is connected and <math id="S5.SS1.p9.m7" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> is perfect, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">BT87</a>, 3.14 (3)]</cite> shows that <math id="S5.SS1.p9.m8" class="ltx_Math" alttext="H^{1}(\Gamma_{K},G(K_{s}))=H^{1}(\Gamma_{unr},G(K_{unr}))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mi>K</mi></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\Gamma_{K},G(K_{s}))=H^{1}(\Gamma_{unr},G(K_{unr}))</annotation></semantics></math>. So the torsor <math id="S5.SS1.p9.m9" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> comes from an unramified cohomology class <math id="S5.SS1.p9.m10" class="ltx_Math" alttext="\overline{c}\in H^{1}(\Gamma_{unr},G(K_{unr}))" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>c</mi><mo stretchy="true">¯</mo></mover><mo>∈</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\overline{c}\in H^{1}(\Gamma_{unr},G(K_{unr}))</annotation></semantics></math>. Notice that there is a natural action of <math id="S5.SS1.p9.m11" class="ltx_Math" alttext="\Gamma_{unr}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\Gamma_{unr}</annotation></semantics></math> on <math id="S5.SS1.p9.m12" class="ltx_Math" alttext="G(\mathcal{O}_{K_{unr}})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(\mathcal{O}_{K_{unr}})</annotation></semantics></math>. There is a map <math id="S5.SS1.p9.m13" class="ltx_Math" alttext="H^{1}(\Gamma_{unr},G(\mathcal{O}_{K_{unr}}))\rightarrow H^{1}(\Gamma_{unr},G(K_{unr}))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\Gamma_{unr},G(\mathcal{O}_{K_{unr}}))\rightarrow H^{1}(\Gamma_{unr},G(K_{unr}))</annotation></semantics></math> induced by the inclusion of <math id="S5.SS1.p9.m14" class="ltx_Math" alttext="\Gamma_{unr}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\Gamma_{unr}</annotation></semantics></math>-groups <math id="S5.SS1.p9.m15" class="ltx_Math" alttext="G(\mathcal{O}_{K_{unr}})\hookrightarrow G(K_{unr})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G(\mathcal{O}_{K_{unr}})\hookrightarrow G(K_{unr})</annotation></semantics></math>. Our goal is to show that, after maybe replacing <math id="S5.SS1.p9.m16" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> with <math id="S5.SS1.p9.m17" class="ltx_Math" alttext="K(\pi^{\frac{1}{m}})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(\pi^{\frac{1}{m}})</annotation></semantics></math>, we have that <math id="S5.SS1.p9.m18" class="ltx_Math" alttext="\overline{c}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>c</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{c}</annotation></semantics></math> comes from a class in <math id="S5.SS1.p9.m19" class="ltx_Math" alttext="H^{1}(\Gamma_{unr},G(\mathcal{O}_{K_{unr}}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\Gamma_{unr},G(\mathcal{O}_{K_{unr}}))</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p10" class="ltx_para">
<p id="S5.SS1.p10.1" class="ltx_p"><span id="S5.SS1.p10.1.1" class="ltx_text">Let us first suppose that <math id="S5.SS1.p10.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is semisimple. There is a finite unramified Galois extension <math id="S5.SS1.p10.m2" class="ltx_Math" alttext="L\supset K" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊃</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">L\supset K</annotation></semantics></math> contained in <math id="S5.SS1.p10.m3" class="ltx_Math" alttext="K_{unr}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">K_{unr}</annotation></semantics></math> such that <math id="S5.SS1.p10.m4" class="ltx_Math" alttext="\mathcal{P}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{L}</annotation></semantics></math> is trivializable. Let <math id="S5.SS1.p10.m5" class="ltx_Math" alttext="\mathcal{O}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\mathcal{O}_{L}</annotation></semantics></math> denote the ring of integers of <math id="S5.SS1.p10.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. Set <math id="S5.SS1.p10.m7" class="ltx_Math" alttext="\Gamma_{L/K}:=\Gal(L/K)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Γ</mi><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow></msub><mo>:=</mo><mrow><mi mathsize="0.800em">Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma_{L/K}:=\Gal(L/K)</annotation></semantics></math>. This is a finite quotient of <math id="S5.SS1.p10.m8" class="ltx_Math" alttext="\Gamma_{unr}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\Gamma_{unr}</annotation></semantics></math>. The descent data for <math id="S5.SS1.p10.m9" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> yield a class <math id="S5.SS1.p10.m10" class="ltx_Math" alttext="\overline{c}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>c</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{c}</annotation></semantics></math> in the nonabelian Galois cohomology set <math id="S5.SS1.p10.m11" class="ltx_Math" alttext="H^{1}(\Gamma_{L/K},G(L))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\Gamma_{L/K},G(L))</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p11" class="ltx_para">
<p id="S5.SS1.p11.1" class="ltx_p"><span id="S5.SS1.p11.1.1" class="ltx_text">Since <math id="S5.SS1.p11.m1" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is quasi-split, it follows that <math id="S5.SS1.p11.m2" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is residually quasi-split <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">BT87</a>, 2.2]</cite>. Therefore, we can use the description of unramified Galois cohomology given in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">BT87</a>]</cite>, we just need to be a bit careful if <math id="S5.SS1.p11.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is not simply-connected. We will denote by <math id="S5.SS1.p11.m4" class="ltx_Math" alttext="G^{00}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mn>00</mn></msup><annotation encoding="application/x-tex">G^{00}</annotation></semantics></math> the subgroup of <math id="S5.SS1.p11.m5" class="ltx_Math" alttext="G(K_{unr})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(K_{unr})</annotation></semantics></math> generated by the <math id="S5.SS1.p11.m6" class="ltx_Math" alttext="K_{unr}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">K_{unr}</annotation></semantics></math>-points of all parahoric subgroups of <math id="S5.SS1.p11.m7" class="ltx_Math" alttext="G_{K_{unr}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><annotation encoding="application/x-tex">G_{K_{unr}}</annotation></semantics></math>. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">BT87</a>, 1.8]</cite>, <math id="S5.SS1.p11.m8" class="ltx_Math" alttext="G^{00}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mn>00</mn></msup><annotation encoding="application/x-tex">G^{00}</annotation></semantics></math> admits the following description. Let <math id="S5.SS1.p11.m9" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> denote a maximal torus of <math id="S5.SS1.p11.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> over <math id="S5.SS1.p11.m11" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>. We can think of <math id="S5.SS1.p11.m12" class="ltx_Math" alttext="T_{K}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>K</mi></msub><annotation encoding="application/x-tex">T_{K}</annotation></semantics></math> as the centralizer of a maximal split torus of <math id="S5.SS1.p11.m13" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math>, since <math id="S5.SS1.p11.m14" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is quasi-split. Let <math id="S5.SS1.p11.m15" class="ltx_Math" alttext="j:\widetilde{G}\rightarrow G" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mover accent="true"><mi>G</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">→</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">j:\widetilde{G}\rightarrow G</annotation></semantics></math> be a simply connected cover of <math id="S5.SS1.p11.m16" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Then, we have <math id="S5.SS1.p11.m17" class="ltx_Math" alttext="G^{00}=T(\mathcal{O}_{K_{unr}})\cdot j(\widetilde{G}(K_{unr}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mn>00</mn></msup><mo>=</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>G</mi><mo mathsize="0.800em">~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">G^{00}=T(\mathcal{O}_{K_{unr}})\cdot j(\widetilde{G}(K_{unr}))</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p12" class="ltx_para">
<p id="S5.SS1.p12.1" class="ltx_p"><span id="S5.SS1.p12.1.1" class="ltx_text">Choose a cocycle <math id="S5.SS1.p12.m1" class="ltx_Math" alttext="c\in Z^{1}(\Gamma_{L/K},G(L))" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><msup><mi>Z</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c\in Z^{1}(\Gamma_{L/K},G(L))</annotation></semantics></math> representing <math id="S5.SS1.p12.m2" class="ltx_Math" alttext="\overline{c}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>c</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{c}</annotation></semantics></math>. We will show that, after maybe replacing <math id="S5.SS1.p12.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> with some ramified extension <math id="S5.SS1.p12.m4" class="ltx_Math" alttext="K(\pi^{\frac{1}{m}})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(\pi^{\frac{1}{m}})</annotation></semantics></math>, the cocycle <math id="S5.SS1.p12.m5" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> takes values in the subgroup <math id="S5.SS1.p12.m6" class="ltx_Math" alttext="G^{00}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mn>00</mn></msup><annotation encoding="application/x-tex">G^{00}</annotation></semantics></math>. Let <math id="S5.SS1.p12.m7" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> denote the finite kernel of the isogeny <math id="S5.SS1.p12.m8" class="ltx_Math" alttext="j:\widetilde{G}\rightarrow G" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mover accent="true"><mi>G</mi><mo mathsize="0.800em">~</mo></mover><mo stretchy="false">→</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">j:\widetilde{G}\rightarrow G</annotation></semantics></math>. Note that <math id="S5.SS1.p12.m9" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is a finite product of groups <math id="S5.SS1.p12.m10" class="ltx_Math" alttext="\mu_{j}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\mu_{j}</annotation></semantics></math> of <math id="S5.SS1.p12.m11" class="ltx_Math" alttext="j^{th}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">j^{th}</annotation></semantics></math> roots of unity. By assumption (2), the characteristic of <math id="S5.SS1.p12.m12" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> does not divide any of the orders of the <math id="S5.SS1.p12.m13" class="ltx_Math" alttext="\mu_{j}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\mu_{j}</annotation></semantics></math> appearing in <math id="S5.SS1.p12.m14" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. After maybe enlarging the unramified extension <math id="S5.SS1.p12.m15" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, we can assume that all of these roots of unity are contained in <math id="S5.SS1.p12.m16" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. So <math id="S5.SS1.p12.m17" class="ltx_Math" alttext="H_{L}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>L</mi></msub><annotation encoding="application/x-tex">H_{L}</annotation></semantics></math> is a finite constant étale group scheme. Since <math id="S5.SS1.p12.m18" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is smooth, the following sequence of groups is exact.</span></p>
<table id="S5.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex72.m1" class="ltx_Math" alttext="1\rightarrow H(K_{s})\rightarrow\widetilde{G}(K_{s})\rightarrow G(K_{s})\rightarrow 1" display="block" intent=":literal"><semantics><mrow><mn>1</mn><mo stretchy="false">→</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mover accent="true"><mi>G</mi><mo mathsize="0.800em">~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">1\rightarrow H(K_{s})\rightarrow\widetilde{G}(K_{s})\rightarrow G(K_{s})\rightarrow 1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p12.2" class="ltx_p"><span id="S5.SS1.p12.2.1" class="ltx_text">We can take <math id="S5.SS1.p12.m19" class="ltx_Math" alttext="\Gal(K_{s}/L)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mi>s</mi></msub><mo>/</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Gal(K_{s}/L)</annotation></semantics></math> invariants to get the following exact sequence of pointed sets</span></p>
<table id="S5.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex73.m1" class="ltx_Math" alttext="1\rightarrow H(L)\rightarrow\widetilde{G}(L)\rightarrow G(L)\rightarrow H^{1}\left(\Gal(K_{s}/L),H(K_{s})\right)" display="block" intent=":literal"><semantics><mrow><mn>1</mn><mo stretchy="false">→</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mover accent="true"><mi>G</mi><mo mathsize="0.800em">~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi mathsize="0.800em">Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mi>s</mi></msub><mo>/</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1\rightarrow H(L)\rightarrow\widetilde{G}(L)\rightarrow G(L)\rightarrow H^{1}\left(\Gal(K_{s}/L),H(K_{s})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p12.3" class="ltx_p"><span id="S5.SS1.p12.3.1" class="ltx_text">Hence the obstructions to lifting to <math id="S5.SS1.p12.m20" class="ltx_Math" alttext="\widetilde{G}(L)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>G</mi><mo mathsize="0.800em">~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{G}(L)</annotation></semantics></math> the finitely many elements in the image of the cocycle <math id="S5.SS1.p12.m21" class="ltx_Math" alttext="c\in Z^{1}(\Gamma_{L/K},G(L))" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><msup><mi>Z</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c\in Z^{1}(\Gamma_{L/K},G(L))</annotation></semantics></math> consist of finitely many cohomology classes in <math id="S5.SS1.p12.m22" class="ltx_Math" alttext="H^{1}\left(\Gal(K_{s}/L),H(K_{s})\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi mathsize="0.800em">Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mi>s</mi></msub><mo>/</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}\left(\Gal(K_{s}/L),H(K_{s})\right)</annotation></semantics></math>. By Kummer theory, these are killed after taking some cyclic extensions of <math id="S5.SS1.p12.m23" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. After further enlarging the unramified extension <math id="S5.SS1.p12.m24" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, we can assume that these cyclic extensions are totally ramified. Such cyclic extension must be of the form <math id="S5.SS1.p12.m25" class="ltx_Math" alttext="L(\pi_{L}^{\frac{1}{m}})" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>L</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(\pi_{L}^{\frac{1}{m}})</annotation></semantics></math> for some uniformizer <math id="S5.SS1.p12.m26" class="ltx_Math" alttext="\pi_{L}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\pi_{L}</annotation></semantics></math> of <math id="S5.SS1.p12.m27" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. Such uniformizer must be of the form <math id="S5.SS1.p12.m28" class="ltx_Math" alttext="\pi_{L}=u\pi" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>L</mi></msub><mo>=</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{L}=u\pi</annotation></semantics></math>, where <math id="S5.SS1.p12.m29" class="ltx_Math" alttext="u\in\mathcal{O}_{L}^{\times}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>L</mi><mo>×</mo></msubsup></mrow><annotation encoding="application/x-tex">u\in\mathcal{O}_{L}^{\times}</annotation></semantics></math>. After replacing <math id="S5.SS1.p12.m30" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> with <math id="S5.SS1.p12.m31" class="ltx_Math" alttext="L(u^{\frac{1}{m}})" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(u^{\frac{1}{m}})</annotation></semantics></math>, we can assume that the obstructions in <math id="S5.SS1.p12.m32" class="ltx_Math" alttext="H^{1}(\Gal(K_{s}/L),H(K_{s}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathsize="0.800em">Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mi>s</mi></msub><mo>/</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\Gal(K_{s}/L),H(K_{s}))</annotation></semantics></math> vanish on the extension <math id="S5.SS1.p12.m33" class="ltx_Math" alttext="L(\pi^{\frac{1}{m}})" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(\pi^{\frac{1}{m}})</annotation></semantics></math> for some <math id="S5.SS1.p12.m34" class="ltx_Math" alttext="m\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m\geq 1</annotation></semantics></math>. So after replacing <math id="S5.SS1.p12.m35" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> with some sufficiently big ramified extension <math id="S5.SS1.p12.m36" class="ltx_Math" alttext="K(\pi^{\frac{1}{m}})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(\pi^{\frac{1}{m}})</annotation></semantics></math>, we can assume that <math id="S5.SS1.p12.m37" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> takes values in the group <math id="S5.SS1.p12.m38" class="ltx_Math" alttext="j(\widetilde{G}(L))\subset G^{00}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>G</mi><mo mathsize="0.800em">~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msup><mi>G</mi><mn>00</mn></msup></mrow><annotation encoding="application/x-tex">j(\widetilde{G}(L))\subset G^{00}</annotation></semantics></math>. Hence <math id="S5.SS1.p12.m39" class="ltx_Math" alttext="\overline{c}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>c</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{c}</annotation></semantics></math> is a class in the Galois cohomology set <math id="S5.SS1.p12.m40" class="ltx_Math" alttext="H^{1}\left(\Gamma_{L/K},G^{00}\cap G(L)\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow></msub><mo>,</mo><mrow><msup><mi>G</mi><mn>00</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}\left(\Gamma_{L/K},G^{00}\cap G(L)\right)</annotation></semantics></math>. Since <math id="S5.SS1.p12.m41" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> is residually-quasisplit, the result <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">BT87</a>, 3.15]</cite> and the construction of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">BT87</a>, 3.4 Lem. 2]</cite> show that <math id="S5.SS1.p12.m42" class="ltx_Math" alttext="\overline{c}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>c</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{c}</annotation></semantics></math> is represented by a cocycle <math id="S5.SS1.p12.m43" class="ltx_Math" alttext="z\in Z^{1}(\Gamma_{L/K},P(\mathcal{O}_{L}))" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mrow><msup><mi>Z</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow></msub><mo>,</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z\in Z^{1}(\Gamma_{L/K},P(\mathcal{O}_{L}))</annotation></semantics></math> taking values in the group of <math id="S5.SS1.p12.m44" class="ltx_Math" alttext="\mathcal{O}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\mathcal{O}_{L}</annotation></semantics></math>-points of a parahoric <math id="S5.SS1.p12.m45" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> of <math id="S5.SS1.p12.m46" class="ltx_Math" alttext="G_{K}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>K</mi></msub><annotation encoding="application/x-tex">G_{K}</annotation></semantics></math> defined over <math id="S5.SS1.p12.m47" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. We can without loss of generality take <math id="S5.SS1.p12.m48" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> to be in the apartment corresponding to a maximal split torus <math id="S5.SS1.p12.m49" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> inside <math id="S5.SS1.p12.m50" class="ltx_Math" alttext="T_{K}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>K</mi></msub><annotation encoding="application/x-tex">T_{K}</annotation></semantics></math>, because <math id="S5.SS1.p12.m51" class="ltx_Math" alttext="G(K)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(K)</annotation></semantics></math> acts transitively on apartments. The argument in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx39" title="" class="ltx_ref">Lar95</a>, Lem. 2.4]</cite> (see also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx47" title="" class="ltx_ref">Ser96</a>, Proposition 8]</cite> and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx17" title="" class="ltx_ref">Gil94</a>, Lemma I.1.3.2]</cite>) shows that there exists some <math id="S5.SS1.p12.m52" class="ltx_Math" alttext="m\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m\geq 1</annotation></semantics></math> and some <math id="S5.SS1.p12.m53" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-rational cocharacter <math id="S5.SS1.p12.m54" class="ltx_Math" alttext="\lambda:\mathbb{G}_{m}\to S" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">→</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda:\mathbb{G}_{m}\to S</annotation></semantics></math> such that <math id="S5.SS1.p12.m55" class="ltx_Math" alttext="\lambda(\pi^{\frac{1}{m}})\in G(K[\pi^{\frac{1}{m}}])" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda(\pi^{\frac{1}{m}})\in G(K[\pi^{\frac{1}{m}}])</annotation></semantics></math> conjugates the base-changed parahoric <math id="S5.SS1.p12.m56" class="ltx_Math" alttext="P_{\mathcal{O}_{K(\pi^{\frac{1}{m}})}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow></msub></msub><annotation encoding="application/x-tex">P_{\mathcal{O}_{K(\pi^{\frac{1}{m}})}}</annotation></semantics></math> into the hyperspecial parahoric <math id="S5.SS1.p12.m57" class="ltx_Math" alttext="G_{\mathcal{O}_{K(\pi^{\frac{1}{m}})}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow></msub></msub><annotation encoding="application/x-tex">G_{\mathcal{O}_{K(\pi^{\frac{1}{m}})}}</annotation></semantics></math>. After replacing <math id="S5.SS1.p12.m58" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> with <math id="S5.SS1.p12.m59" class="ltx_Math" alttext="K(\pi^{\frac{1}{m}})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(\pi^{\frac{1}{m}})</annotation></semantics></math>, we can use the element <math id="S5.SS1.p12.m60" class="ltx_Math" alttext="\lambda(\pi^{\frac{1}{m}})" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mfrac><mn>1</mn><mi>m</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda(\pi^{\frac{1}{m}})</annotation></semantics></math> to conjugate the cocycle <math id="S5.SS1.p12.m61" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> into a cocycle <math id="S5.SS1.p12.m62" class="ltx_Math" alttext="z^{\prime}\in Z^{1}(\Gamma_{L/K},G(\mathcal{O}_{L}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mo>′</mo></msup><mo>∈</mo><mrow><msup><mi>Z</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z^{\prime}\in Z^{1}(\Gamma_{L/K},G(\mathcal{O}_{L}))</annotation></semantics></math>. This shows that <math id="S5.SS1.p12.m63" class="ltx_Math" alttext="\overline{c}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>c</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{c}</annotation></semantics></math> comes from a cohomology class in <math id="S5.SS1.p12.m64" class="ltx_Math" alttext="H^{1}(\Gamma_{L/K},G(\mathcal{O}_{L}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow></msub><mo>,</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\Gamma_{L/K},G(\mathcal{O}_{L}))</annotation></semantics></math>, and thus concludes the proof in the case when <math id="S5.SS1.p12.m65" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is semisimple.</span></p>
</div>
<div id="S5.SS1.p13" class="ltx_para">
<p id="S5.SS1.p13.1" class="ltx_p"><span id="S5.SS1.p13.1.1" class="ltx_text">We now deal with the general case. Let <math id="S5.SS1.p13.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be an arbitrary quasi-split connected reductive group over <math id="S5.SS1.p13.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>. Let <math id="S5.SS1.p13.m3" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> denote the maximal central torus of <math id="S5.SS1.p13.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. We have a short exact sequence of algebraic groups</span></p>
<table id="S5.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex74.m1" class="ltx_Math" alttext="1\rightarrow Z\rightarrow G\rightarrow\overline{G}\rightarrow 1" display="block" intent=":literal"><semantics><mrow><mn>1</mn><mo stretchy="false">→</mo><mi>Z</mi><mo stretchy="false">→</mo><mi>G</mi><mo stretchy="false">→</mo><mover accent="true"><mi>G</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">→</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">1\rightarrow Z\rightarrow G\rightarrow\overline{G}\rightarrow 1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p13.2" class="ltx_p"><span id="S5.SS1.p13.2.1" class="ltx_text">Here <math id="S5.SS1.p13.m5" class="ltx_Math" alttext="\overline{G}=G/Z" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>G</mi><mo stretchy="true">¯</mo></mover><mo>=</mo><mrow><mi>G</mi><mo>/</mo><mi>Z</mi></mrow></mrow><annotation encoding="application/x-tex">\overline{G}=G/Z</annotation></semantics></math> is a quasi-split semisimple group over <math id="S5.SS1.p13.m6" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> satisfying condition (2) in the statement of this proposition. By assumption, <math id="S5.SS1.p13.m7" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> is split, and so it is isomorphic to a finite product <math id="S5.SS1.p13.m8" class="ltx_Math" alttext="(\mathbb{G}_{m})^{h}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mi>h</mi></msup><annotation encoding="application/x-tex">(\mathbb{G}_{m})^{h}</annotation></semantics></math> of copies of <math id="S5.SS1.p13.m9" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math>. We have an exact sequence</span></p>
<table id="S5.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex75.m1" class="ltx_Math" alttext="1\rightarrow Z(K_{unr})\rightarrow G(K_{unr})\rightarrow\overline{G}(K_{unr})\rightarrow H^{1}(\Gamma_{K_{s}/K_{unr}},Z(K_{s}))" display="block" intent=":literal"><semantics><mrow><mn>1</mn><mo stretchy="false">→</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mover accent="true"><mi>G</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><msub><mi>K</mi><mi>s</mi></msub><mo>/</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></msub><mo>,</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1\rightarrow Z(K_{unr})\rightarrow G(K_{unr})\rightarrow\overline{G}(K_{unr})\rightarrow H^{1}(\Gamma_{K_{s}/K_{unr}},Z(K_{s}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p13.3" class="ltx_p"><span id="S5.SS1.p13.3.1" class="ltx_text">Hilbert’s Theorem 90 implies that <math id="S5.SS1.p13.m10" class="ltx_Math" alttext="H^{1}(\Gamma_{K_{s}/K_{unr}},Z(K_{s}))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mrow><msub><mi>K</mi><mi>s</mi></msub><mo>/</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></msub><mo>,</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{1}(\Gamma_{K_{s}/K_{unr}},Z(K_{s}))=0</annotation></semantics></math>, and so we have a short exact sequence of <math id="S5.SS1.p13.m11" class="ltx_Math" alttext="\Gamma_{unr}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\Gamma_{unr}</annotation></semantics></math>-groups</span></p>
<table id="S5.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex76.m1" class="ltx_Math" alttext="1\rightarrow Z(K_{unr})\rightarrow G(K_{unr})\rightarrow\overline{G}(K_{unr})\rightarrow 1" display="block" intent=":literal"><semantics><mrow><mn>1</mn><mo stretchy="false">→</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mover accent="true"><mi>G</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">1\rightarrow Z(K_{unr})\rightarrow G(K_{unr})\rightarrow\overline{G}(K_{unr})\rightarrow 1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p13.4" class="ltx_p"><span id="S5.SS1.p13.4.1" class="ltx_text">The same thing holds for <math id="S5.SS1.p13.m12" class="ltx_Math" alttext="\mathcal{O}_{K_{unr}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>K</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><annotation encoding="application/x-tex">\mathcal{O}_{K_{unr}}</annotation></semantics></math>-points. After taking <math id="S5.SS1.p13.m13" class="ltx_Math" alttext="\Gamma_{unr}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\Gamma_{unr}</annotation></semantics></math>-invariants and replacing <math id="S5.SS1.p13.m14" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> with <math id="S5.SS1.p13.m15" class="ltx_Math" alttext="(\mathbb{G}_{m})^{h}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mi>h</mi></msup><annotation encoding="application/x-tex">(\mathbb{G}_{m})^{h}</annotation></semantics></math>, we get a diagram of pointed sets</span></p>
<table id="S5.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
