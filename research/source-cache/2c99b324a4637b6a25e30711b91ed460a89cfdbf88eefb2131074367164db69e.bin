<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex160.m2" class="ltx_Math" alttext="\displaystyle\cong\mathsf{Lie}(x_{1},\dots,x_{n})[-n-1]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≅</mo><mrow><mrow><mi>𝖫𝗂𝖾</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo lspace="0em">−</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cong\mathsf{Lie}(x_{1},\dots,x_{n})[-n-1]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S8.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
