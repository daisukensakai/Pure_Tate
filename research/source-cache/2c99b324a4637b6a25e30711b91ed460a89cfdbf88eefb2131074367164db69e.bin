<td class="ltx_td ltx_align_right ltx_eqn_cell"><span class="ltx_inline-block"><svg id="S5.E24.m7.pic1" class="ltx_picture ltx_markedasmath" height="31.24" overflow="visible" style="vertical-align:-11.75px" version="1.1" viewBox="0 0 60.79 31.24" width="60.79"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,31.24) matrix(1 0 0 -1 0 0) translate(42.8,0) translate(0,15.62)"><path style="fill:none" d="M 1.96 0 C 1.96 1.08 1.08 1.96 0 1.96 C -1.08 1.96 -1.96 1.08 -1.96 0 C -1.96 -1.08 -1.08 -1.96 0 -1.96 C 1.08 -1.96 1.96 -1.08 1.96 0 Z M 0 0"></path><path style="fill:none" d="M -22.85 0 C -22.85 1.08 -23.72 1.96 -24.8 1.96 C -25.88 1.96 -26.76 1.08 -26.76 0 C -26.76 -1.08 -25.88 -1.96 -24.8 -1.96 C -23.72 -1.96 -22.85 -1.08 -22.85 0 Z M -24.8 0"></path><path style="fill:none" d="M -2.23 0 L -22.02 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 -12.12 0)"><path style="fill:none" d="M 0 3.18 L 0 -3.18"></path></g><path style="fill:none" d="M 2.23 0 L 17.72 0"></path><path style="fill:none" d="M 1.12 1.93 L 8.86 15.34"></path><path style="fill:none" d="M 1.12 -1.93 L 8.86 -15.34"></path><path style="fill:none" d="M -23.22 1.58 C -10.7 14.11 -38.91 14.11 -26.38 1.58"></path><path style="fill:none" d="M -27.04 0 L -42.52 0"></path><path style="fill:none" d="M -25.92 -1.93 L -33.66 -15.34"></path></g></svg></span></td>
