l:none" d="M -199.1 -7.24 L -199.1 16.56"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 -199.1 16.84)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 91.91 -19.5 L 124.02 -19.5"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 124.29 -19.5)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 3.46 -7.24 L 3.46 16.56"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 3.46 16.84)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 202.56 -7.24 L 202.56 16.56"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 202.56 16.84)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></span></p>
</span></div>
</span></div></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS4.p2.2" class="ltx_p">The arrows are once again coboundary maps in excision sequences arising from stratifications of moduli spaces.</p>
</div>
<div id="S8.SS4.p3" class="ltx_para">
<p id="S8.SS4.p3.1" class="ltx_p">As in our computation of <math id="S8.SS4.p3.m1" class="ltx_Math" alttext="H(J^{\star}_{0,n})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>J</mi><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(J^{\star}_{0,n})</annotation></semantics></math>, we find it helpful to tensor once again with <math id="S8.SS4.p3.m2" class="ltx_Math" alttext="\sgn_{n}" display="inline" intent=":literal"><semantics><msub><mi>sgn</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\sgn_{n}</annotation></semantics></math> and then give an algebraic interpretation for the resulting diagram. Let <math id="S8.SS4.p3.m3" class="ltx_Math" alttext="\tilde{J}^{\star}_{1,n}:=J^{\star}_{1,n}\otimes\sgn_{n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>J</mi><mo>~</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow><mo>⋆</mo></msubsup><mo>:=</mo><mrow><msubsup><mi>J</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>sgn</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{J}^{\star}_{1,n}:=J^{\star}_{1,n}\otimes\sgn_{n}</annotation></semantics></math>, with differential <math id="S8.SS4.p3.m4" class="ltx_Math" alttext="\tilde{\delta}=\tilde{\delta}_{split}+\tilde{\delta}_{join}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>δ</mi><mo>~</mo></mover><mo>=</mo><mrow><msub><mover accent="true"><mi>δ</mi><mo>~</mo></mover><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>+</mo><msub><mover accent="true"><mi>δ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{\delta}=\tilde{\delta}_{split}+\tilde{\delta}_{join}</annotation></semantics></math>. Similarly, let <math id="S8.SS4.p3.m5" class="ltx_Math" alttext="\tilde{V}_{i,k}:=V_{i,k}\otimes\sgn_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>:=</mo><mrow><msub><mi>V</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>sgn</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{V}_{i,k}:=V_{i,k}\otimes\sgn_{n}</annotation></semantics></math>. Recall that tensoring with <math id="S8.SS4.p3.m6" class="ltx_Math" alttext="\sgn_{n}" display="inline" intent=":literal"><semantics><msub><mi>sgn</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\sgn_{n}</annotation></semantics></math> amounts to equipping each generator with a total ordering of all of its edges, not just the structural edges, and imposing the usual relation that reordering the edges is multiplication by the sign of the induced permutation. We then have</p>
<table id="S8.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S8.Ex160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
