<th id="A2.Ex194.1.1.5.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><math id="A2.Ex194.m1.m10" class="ltx_Math" alttext="t^{6}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mn>6</mn></msup><annotation encoding="application/x-tex">t^{6}</annotation></semantics></math></th>
