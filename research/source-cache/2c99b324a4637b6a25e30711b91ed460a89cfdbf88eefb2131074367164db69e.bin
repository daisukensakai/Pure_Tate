l="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -1.64 27.56)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="6.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.Ex182.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\pi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">π</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\pi}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -41.85 11.55 L -41.85 -12.8"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -41.85 -13.08)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -53.01 -4.21)"><foreignObject style="--ltx-fo-width:0.57em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:10pt;" height="6.62" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="7.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.Ex182.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\Phi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em" mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\Phi}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -21.83 -13.36 L 21.67 11.28"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.87016 0.49277 -0.49277 0.87016 21.91 11.41)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 3.41 -10.78)"><foreignObject style="--ltx-fo-width:0.61em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:10pt;" height="6.62" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="8.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.Ex182.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces F}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">F</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces F}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
