{\lx@inpgf@ignorespaces}{{{{{}}{}{}{}{}{{}}}}}{{}}{}{}{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M -8.62 -8.62 L -19.69 -19.69}{fill:none} \lx@inpgf@ignorespaces
\lxSVG@closescope }}}\hbox{{\lxSVG@begingroup@{_scopebegin} {{}}{}
