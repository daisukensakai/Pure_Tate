\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\,." display="block" intent=":literal"><semantics><mrow><mrow><mtext> <svg style="vertical-align:-38.71px" height="67.59" overflow="visible" version="1.1" viewBox="0 0 43.98 67.59" width="43.98"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,67.59) matrix(1 0 0 -1 0 0) translate(24.02,0) translate(0,42.58)"> <path style="fill:none" d="M 12.92 11.81 C 12.92 18.95 7.14 24.73 0 24.73 C -7.14 24.73 -12.92 18.95 -12.92 11.81 C -12.92 4.67 -7.14 -1.11 0 -1.11 C 7.14 -1.11 12.92 4.67 12.92 11.81 Z M 0 11.81"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -4.32 7.08)"> <foreignObject style="--ltx-fo-width:0.63em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="8.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathvariant="normal">Γ</mi></span></span></foreignObject> </g> <path style="fill:none" d="M -8.45 1.67 L -19.69 -11.81"></path> <path style="fill:none" d="M -5.08 -0.37 L -9.84 -11.81"></path> <path style="fill:none" d="M 0 -1.39 L 0 -11.81"></path> <path style="fill:none" d="M 5.08 -0.37 L 9.84 -11.81"></path> <path style="fill:none" d="M 8.45 1.67 L 19.69 -11.81"></path> <path style="fill:none" d="M -19.69 -19.69 M -19.69 -19.69 C -19.32 -20.93 -18.45 -21.76 -17.22 -21.76 L -17.22 -21.76 C -15.99 -21.76 -15.13 -22.59 -14.76 -23.84 C -14.39 -22.59 -13.53 -21.76 -12.3 -21.76 L -12.3 -21.76 C -11.07 -21.76 -10.21 -20.93 -9.84 -19.69"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -19.4 -37.97)"> <foreignObject style="--ltx-fo-width:0.67em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi>S</mi></span></span></foreignObject> </g> </g> </svg> </mtext><mspace style="width:1em;" width="1em"></mspace><mo stretchy="false">↦</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mi>R</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo movablelimits="false">∑</mo><mtext> <svg style="vertical-align:-8.22px" height="52.13" overflow="visible" version="1.1" viewBox="0 0 60.18 52.13" width="60.18"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,52.13) matrix(1 0 0 -1 0 0) translate(40.22,0) translate(0,12.09)"> <path style="fill:none" d="M 12.92 11.81 C 12.92 18.95 7.14 24.73 0 24.73 C -7.14 24.73 -12.92 18.95 -12.92 11.81 C -12.92 4.67 -7.14 -1.11 0 -1.11 C 7.14 -1.11 12.92 4.67 12.92 11.81 Z M 0 11.81"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -4.32 7.08)"> <foreignObject style="--ltx-fo-width:0.63em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="8.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathvariant="normal">Γ</mi></span></span></foreignObject> </g> <path style="fill:none" d="M -9.33 2.48 C -50.52 -38.7 -50.52 62.33 -9.33 21.15"></path> <path style="fill:none" d="M -5.58 -0.15 C -37.13 -67.8 -37.13 91.43 -5.58 23.77"></path> <path style="fill:none" d="M 0 -1.39 L 0 -11.81"></path> <path style="fill:none" d="M 5.08 -0.37 L 9.