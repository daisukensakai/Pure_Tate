.24 Z M 141.73 47.24"></path></g><g stroke-width="1.6pt"><path style="fill:none" d="M 141.73 70.87 M 145.05 70.87 C 145.05 72.7 143.57 74.19 141.73 74.19 C 139.9 74.19 138.41 72.7 138.41 70.87 C 138.41 69.03 139.9 67.55 141.73 67.55 C 143.57 67.55 145.05 69.03 145.05 70.87 Z M 141.73 70.87"></path></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#FFFFFF"><path d="M 165.36 0 M 168.68 0 C 168.68 1.83 167.19 3.32 165.36 3.32 C 163.52 3.32 162.04 1.83 162.04 0 C 162.04 -1.83 163.52 -3.32 165.36 -3.32 C 167.19 -3.32 168.68 -1.83 168.68 0 Z M 165.36 0"></path></g><g stroke-width="1.6pt"><path style="fill:none" d="M 165.36 0 M 168.68 0 C 168.68 1.83 167.19 3.32 165.36 3.32 C 163.52 3.32 162.04 1.83 162.04 0 C 162.04 -1.83 163.52 -3.32 165.36 -3.32 C 167.19 -3.32 168.68 -1.83 168.68 0 Z M 165.36 0"></path></g><g stroke-width="1.6pt"><path style="fill:none" d="M 165.36 23.62 M 168.68 23.62 C 168.68 25.46 167.19 26.94 165.36 26.94 C 163.52 26.94 162.04 25.46 162.04 23.62 C 162.04 21.79 163.52 20.3 165.36 20.3 C 167.19 20.3 168.68 21.79 168.68 23.62 Z M 165.36 23.62"></path></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#FFFFFF"><path d="M 188.98 0 M 192.3 0 C 192.3 1.83 190.81 3.32 188.98 3.32 C 187.14 3.32 185.66 1.83 185.66 0 C 185.66 -1.83 187.14 -3.32 188.98 -3.32 C 190.81 -3.32 192.3 -1.83 192.3 0 Z M 188.98 0"></path></g><g stroke-width="1.6pt"><path style="fill:none" d="M 188.98 0 M 192.3 0 C 192.3 1.83 190.81 3.32 188.98 3.32 C 187.14 3.32 185.66 1.83 185.66 0 C 185.66 -1.83 187.14 -3.32 188.98 -3.32 C 190.81 -3.32 192.3 -1.83 192.3 0 Z M 188.98 0"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000" transform="matrix(1.5 0.0 0.0 1.5 432.11 335.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.47em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="6.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.pic4.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">?</span></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000" stroke-width="0.8pt"><path style="fill:none" d="M 425.2 0 L 447.72 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 448.27 0)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g></g></g></svg></span></div></div>
</figure>
<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">We now turn to the question of when <math id="S5.p1.m1" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> or <math id="S5.p1.m2" class="ltx_Math" alttext="\#\mathcal{M}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\mathcal{M}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> is given by a polynomial in <math id="S5.p1.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. In both cases, the tool for showing the point count is polynomial is to show all cohomology is Tate type and apply Lemma <a href="#S2.Thmthm14" title="Lemma 2.14. ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.14</span></a>.
Meanwhile, the tool for showing that the point count is not polynomial is to find some odd <math id="S5.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> for which <math id="S5.p1.m5" class="ltx_Math" alttext="\chi_{k}(\mathcal{M})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\chi_{k}(\mathcal{M})\neq 0</annotation></semantics></math> and apply Lemma <a href="#S2.Thmthm18" title="Lemma 2.18 (Proposition 2.3 of []). ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.18</span></a>.
Because of the vanishing results for odd <math id="S5.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> in Theorems <a href="#S4.Thmthm1" title="Theorem 4.1 (Arbarello–Cornalba []). ‣ 4. Cohomology in low weights ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> and <a href="#S4.Thmthm3" title="Theorem 4.3 (Bergström–Faber–Payne []). ‣ 4. Cohomology in low weights ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, to obtain non-vanishing in odd weight we will of course need to take <math id="S5.p1.m7" class="ltx_Math" alttext="k&gt;9" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&gt;</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">k&gt;9</annotation></semantics></math>.</p>
</div>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p">For <math id="S5.p2.m1" class="ltx_Math" alttext="\mathcal{M}=\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>=</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}=\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>, polynomial point counts are implied by <math id="S5.p2.m2" class="ltx_Math" alttext="H^{*}(\overline{\mathcal{M}}_{g,n})=RH^{*}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{*}(\overline{\mathcal{M}}_{g,n})=RH^{*}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>. We represent this with filled circles in the chart below. The positions in the chart below for <math id="S5.p2.m3" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> that receive filled circles are
all positions that are filled circles in the chart in Section <a href="#S3" title="3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> together with the pairs listed in Proposition <a href="#S3.Thmthm9" title="Proposition 3.9. ‣ 3.5. Interpreting the chart in cohomology ‣ 3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.9</span></a>.
Meanwhile, since <math id="S5.p2.m4" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> is smooth and proper, <math id="S5.p2.m5" class="ltx_Math" alttext="\chi_{k}(\overline{\mathcal{M}}_{g,n})=(-1)\dim H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">dim</mo><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi_{k}(\overline{\mathcal{M}}_{g,n})=(-1)\dim H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>.
The non-vanshing odd cohomology classes constructed in Theorems <a href="#S3.Thmthm7" title="Theorem 3.7 (Canning–L.–Payne []). ‣ 3.4. Non-tautological classes ‣ 3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a> and <a href="#S3.Thmthm8" title="Theorem 3.8 (Canning–L.–Payne–Willwacher []). ‣ 3.4. Non-tautological classes ‣ 3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a> give rise to the red exes
in the first chart for <math id="S5.p2.m6" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math>, representing cases where the point count is not polynomial. All positions off the page are also filled with red exes.</p>
</div>
<div id="S5.p3" class="ltx_para">
<p id="S5.p3.1" class="ltx_p">For <math id="S5.p3.m1" class="ltx_Math" alttext="\mathcal{M}=\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}=\mathcal{M}_{g,n}</annotation></semantics></math>, it is shown in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>, Theorem 1.5]</cite> that if <math id="S5.p3.m2" class="ltx_Math" alttext="3g+2n&lt;25" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>&lt;</mo><mn>25</mn></mrow><annotation encoding="application/x-tex">3g+2n&lt;25</annotation></semantics></math>, then the cohomology of <math id="S5.p3.m3" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> is Tate type, and hence these spaces have polynomial point count. These are represented by open circles in the second chart.
Since <math id="S5.p3.m4" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> is not proper,
the proof of this result requires some care. For example, although we know that <math id="S5.p3.m5" class="ltx_Math" alttext="\overline{\mathcal{M}}_{2,9}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>9</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{2,9}</annotation></semantics></math> has polynomial point count, it does not follow immediately that <math id="S5.p3.m6" class="ltx_Math" alttext="\mathcal{M}_{2,9}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>2</mn><mo>,</mo><mn>9</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{2,9}</annotation></semantics></math> has polynomial point count, as the boundary could have some non-polynomial contribution. One may be concerned that <math id="S5.p3.m7" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,11}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,11}</annotation></semantics></math> maps to the boundary of <math id="S5.p3.m8" class="ltx_Math" alttext="\overline{\mathcal{M}}_{2,9}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>9</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{2,9}</annotation></semantics></math> and <math id="S5.p3.m9" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,11}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,11}</annotation></semantics></math> has non-polynomial point count. However, as discussed in Section <a href="#S2.SS5" title="2.5. Comparing point counts of 
          
            
              
              
                ¯
                M
              
              
                
                  
                  
                  
                
                
                  g
                  ,
                  n
                
              
            
          
         and 
          
            
              
              M
              
                
                  
                  
                  
                
                
                  g
                  ,
                  n ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>, what matters for such calculations are the <em id="S5.p3.1.1" class="ltx_emph ltx_font_italic">equivariant</em> point counts of <math id="S5.p3.m10" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,11}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,11}</annotation></semantics></math>. Indeed,
the gluing map <math id="S5.p3.m11" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,11}\to\overline{\mathcal{M}}_{2,9}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>9</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,11}\to\overline{\mathcal{M}}_{2,9}</annotation></semantics></math> factors through the <math id="S5.p3.m12" class="ltx_Math" alttext="\mathbb{S}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathbb{S}_{2}</annotation></semantics></math>-quotient of <math id="S5.p3.m13" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,11}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,11}</annotation></semantics></math> that identifies the two possible orders of the points being glued together.
In this case, even though <math id="S5.p3.m14" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11})\neq 0</annotation></semantics></math>, it turns out that <math id="S5.p3.m15" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11})^{\mathbb{S}_{2}}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>𝕊</mi><mn>2</mn></msub></msup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11})^{\mathbb{S}_{2}}=0</annotation></semantics></math>. This is the reason behind why <math id="S5.p3.m16" class="ltx_Math" alttext="\mathcal{M}_{2,9}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>2</mn><mo>,</mo><mn>9</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{2,9}</annotation></semantics></math> still has polynomial point count.
In summary, to prove that the cohomology of <math id="S5.p3.m17" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> for <math id="S5.p3.m18" class="ltx_Math" alttext="3g+2n&lt;25" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>&lt;</mo><mn>25</mn></mrow><annotation encoding="application/x-tex">3g+2n&lt;25</annotation></semantics></math> is Tate type, it is essential to understand <em id="S5.p3.1.2" class="ltx_emph ltx_font_italic">equivariantly</em> the non-Tate cohomology of the <math id="S5.p3.m19" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g^{\prime},n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g^{\prime},n^{\prime}}</annotation></semantics></math> with <math id="S5.p3.m20" class="ltx_Math" alttext="2g^{\prime}+n^{\prime}\leq 2g+n" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>′</mo></msup></mrow><mo>+</mo><msup><mi>n</mi><mo>′</mo></msup></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">2g^{\prime}+n^{\prime}\leq 2g+n</annotation></semantics></math>.
Another other important input is that <math id="S5.p3.m21" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> has the CKgP, which implies by Lemma <a href="#S2.Thmthm10" title="Lemma 2.10 (Lemma 4.3 of []). ‣ 2.2. Comparing Chow and cohomology ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.10</span></a> that these non-Tate parts of the cohomology are pushed forward from the boundary, allowing us to understand them explicitly in terms of decorated graphs (with possibly non-tautological decorations).</p>
</div>
<div id="S5.p4" class="ltx_para">
<p id="S5.p4.1" class="ltx_p">It is expected that the point counts of <math id="S5.p4.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> are non-polynomial outside of this range.</p>
</div>
<div id="S5.Thmthm1" class="ltx_theorem ltx_theorem_conj">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm1.2" class="ltx_text ltx_font_bold">Conjecture 5.1</span></span><span id="S5.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm1.p1" class="ltx_para">
<p id="S5.Thmthm1.p1.1" class="ltx_p"><math id="S5.Thmthm1.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math><span id="S5.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic"> has polynomial point count if and only if <math id="S5.Thmthm1.p1.m2" class="ltx_Math" alttext="3g+2n&lt;25" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>&lt;</mo><mn>25</mn></mrow><annotation encoding="application/x-tex">3g+2n&lt;25</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.p5" class="ltx_para">
<p id="S5.p5.1" class="ltx_p">In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>]</cite>, Conjecture <a href="#S5.Thmthm1" title="Conjecture 5.1. ‣ 5. Applications to point counts ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> is proved in the case <math id="S5.p5.m1" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math> and computationally verified for all <math id="S5.p5.m2" class="ltx_Math" alttext="g+n&lt;150" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>+</mo><mi>n</mi></mrow><mo>&lt;</mo><mn>150</mn></mrow><annotation encoding="application/x-tex">g+n&lt;150</annotation></semantics></math>. We place a red <span id="S5.p5.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;"> ?</span> in the upper right of the chart for <math id="S5.p5.m3" class="ltx_Math" alttext="\#\mathcal{M}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\mathcal{M}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> to indicate that it remains unknown if all spaces off of the page should be given red exes, as predicted by Conjecture <a href="#S5.Thmthm1" title="Conjecture 5.1. ‣ 5. Applications to point counts ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>.</p>
</div>
<div id="S5.p6" class="ltx_para">
<p id="S5.p6.1" class="ltx_p">To prove the conjecture for <math id="S5.p6.m1" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math>, we study the asymptotic behavior of
a generating function for <math id="S5.p6.m2" class="ltx_Math" alttext="\chi_{11}(\mathcal{M}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>χ</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi_{11}(\mathcal{M}_{g,n})</annotation></semantics></math> given in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib45" title="" class="ltx_ref">45</a>]</cite>. In particular, we bound it away from zero for <math id="S5.p6.m3" class="ltx_Math" alttext="g&gt;500" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>&gt;</mo><mn>500</mn></mrow><annotation encoding="application/x-tex">g&gt;500</annotation></semantics></math> and compute the rest on a computer to prove that</p>
<table id="S5.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex1.m1" class="ltx_Math" alttext="\chi_{11}(\mathcal{M}_{g,0})\neq 0\text{ if and only if $g\geq 9$ and $g\neq 12$}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>χ</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mtext> if and only if </mtext><mrow><mi>g</mi><mo>≥</mo><mn>9</mn></mrow><mtext> and </mtext><mrow><mi>g</mi><mo>≠</mo><mn>12</mn></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\chi_{11}(\mathcal{M}_{g,0})\neq 0\text{ if and only if $g\geq 9$ and $g\neq 12$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p6.2" class="ltx_p">This proves all red exes besides <math id="S5.p6.m4" class="ltx_Math" alttext="(g,n)=(12,0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>12</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(g,n)=(12,0)</annotation></semantics></math> on the <math id="S5.p6.m5" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math> axis of the chart for <math id="S5.p6.m6" class="ltx_Math" alttext="\#\mathcal{M}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\mathcal{M}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math>. For <math id="S5.p6.m7" class="ltx_Math" alttext="(g,n)=(12,0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>12</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(g,n)=(12,0)</annotation></semantics></math>, we have <math id="S5.p6.m8" class="ltx_Math" alttext="\chi_{11}(\mathcal{M}_{12,0})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>12</mn><mo>,</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\chi_{11}(\mathcal{M}_{12,0})=0</annotation></semantics></math>!
Nevertheless, building upon Theorem <a href="#S4.Thmthm6" title="Theorem 4.6 (Canning–L.–Payne–Willwacher []). ‣ 4. Cohomology in low weights ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.6</span></a>, we prove that
<math id="S5.p6.m9" class="ltx_Math" alttext="\chi_{13}(\mathcal{M}_{12,0})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mn>13</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>12</mn><mo>,</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\chi_{13}(\mathcal{M}_{12,0})\neq 0</annotation></semantics></math>.
Similarly, it turns out that <math id="S5.p6.m10" class="ltx_Math" alttext="\chi_{11}(\mathcal{M}_{8,1})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>8</mn><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\chi_{11}(\mathcal{M}_{8,1})=0</annotation></semantics></math>, but <math id="S5.p6.m11" class="ltx_Math" alttext="\chi_{13}(\mathcal{M}_{8,1})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mn>13</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>8</mn><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\chi_{13}(\mathcal{M}_{8,1})\neq 0</annotation></semantics></math>. All other know red exes with <math id="S5.p6.m12" class="ltx_Math" alttext="g+n&lt;150" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>+</mo><mi>n</mi></mrow><mo>&lt;</mo><mn>150</mn></mrow><annotation encoding="application/x-tex">g+n&lt;150</annotation></semantics></math> are proved by showing <math id="S5.p6.m13" class="ltx_Math" alttext="\chi_{11}(\mathcal{M}_{g,n})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\chi_{11}(\mathcal{M}_{g,n})\neq 0</annotation></semantics></math> in a computer implementation.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1. </span>Approximate polynomiality</h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">As a consequence of the chart for <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math>, we see that there are only finitely many cases where <math id="S5.SS1.p1.m2" class="ltx_Math" alttext="g&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g&gt;0</annotation></semantics></math> and <math id="S5.SS1.p1.m3" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> is a polynomial in <math id="S5.SS1.p1.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. Nevertheless, we may ask about the overall shape and leading terms in the point count.
This is determined by the Galois representations that appear in <math id="S5.SS1.p1.m5" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> for high values of <math id="S5.SS1.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> (which differ from those in complementary low degrees by a Tate twist).
As a corollary of Theorem <a href="#S4.Thmthm8" title="Conjecture 4.8. ‣ 4. Cohomology in low weights ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.8</span></a>, the point counts of <math id="S5.SS1.p1.m7" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> are surprisingly well-approximated by a polynomial. The first corrections to polynomial behavior are in weight <math id="S5.SS1.p1.m8" class="ltx_Math" alttext="2\dim\overline{\mathcal{M}}_{g,n}-11" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">dim</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><mo>−</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">2\dim\overline{\mathcal{M}}_{g,n}-11</annotation></semantics></math>, but by Theorem <a href="#S4.Thmthm5" title="Theorem 4.5 (Canning–L.–Payne []). ‣ 4. Cohomology in low weights ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.5</span></a>, only show up when <math id="S5.SS1.p1.m9" class="ltx_Math" alttext="g=1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g=1</annotation></semantics></math>. That is for <math id="S5.SS1.p1.m10" class="ltx_Math" alttext="g\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">g\geq 2</annotation></semantics></math>, we have <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">16</a>, Corollary 1.3]</cite></p>
<table id="S5.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex2.m1" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})=P(q)+O(q^{\dim\overline{\mathcal{M}}_{g,n}-13/2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>q</mi><mrow><mrow><mo rspace="0.167em">dim</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>−</mo><mrow><mn>13</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})=P(q)+O(q^{\dim\overline{\mathcal{M}}_{g,n}-13/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2. </span>Further point counts in genus <math id="S5.SS2.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> and <math id="S5.SS2.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math></h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.1" class="ltx_p">Going beyond the shape of the point counts, Bergström and Faber have determined a compiled a list of the exact point counts of <math id="S5.SS2.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> and <math id="S5.SS2.p1.m2" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> for <math id="S5.SS2.p1.m3" class="ltx_Math" alttext="g\leq 3" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">g\leq 3</annotation></semantics></math> and many small values of <math id="S5.SS2.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite> and the references therein for an overview of the known results.</p>
</div>
<div id="S5.SS2.p2" class="ltx_para">
<p id="S5.SS2.p2.1" class="ltx_p">To illustrate one of the strategies, used in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite> in genus <math id="S5.SS2.p2.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, first suppose we knew that <math id="S5.SS2.p2.m2" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> were given by a polynomial in <math id="S5.SS2.p2.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, say</p>
<table id="S5.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex3.m1" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})=P(q)=a_{d}q^{d}+\ldots+a_{1}q+a_{0}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>a</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>d</mi></msup></mrow><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo><msub><mi>a</mi><mn>0</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})=P(q)=a_{d}q^{d}+\ldots+a_{1}q+a_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p2.2" class="ltx_p">but we did not know the coefficients <math id="S5.SS2.p2.m4" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math>.
We could determine the coefficients <math id="S5.SS2.p2.m5" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math> — and thus know <math id="S5.SS2.p2.m6" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> for all <math id="S5.SS2.p2.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> — just
by knowing <math id="S5.SS2.p2.m8" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> for finitely many values of <math id="S5.SS2.p2.m9" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, as we now explain. Indeed, for each value of <math id="S5.SS2.p2.m10" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> where the point count is known, plugging it in to the equation above yields a linear relation on the <math id="S5.SS2.p2.m11" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math>. With enough independent linear relations among the <math id="S5.SS2.p2.m12" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math>, one can solve the linear system.
There are also some other helpful relations.
Namely, by Lemma <a href="#S2.Thmthm16" title="Theorem 2.16 (van den Bogaart–Edixhoven []). ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.16</span></a> and Poincaré duality, we have <math id="S5.SS2.p2.m13" class="ltx_Math" alttext="a_{i}=a_{d-i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>=</mo><msub><mi>a</mi><mrow><mi>d</mi><mo>−</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">a_{i}=a_{d-i}</annotation></semantics></math>. Moreover, <math id="S5.SS2.p2.m14" class="ltx_Math" alttext="\sum_{i}a_{i}=\chi(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><msub><mi>a</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i}a_{i}=\chi(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>, and this integer-valued Euler characteristic is computable for small <math id="S5.SS2.p2.m15" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S5.SS2.p2.m16" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, giving another relation.</p>
</div>
<div id="S5.SS2.p3" class="ltx_para">
<p id="S5.SS2.p3.1" class="ltx_p">In theory, for small <math id="S5.SS2.p3.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> and <math id="S5.SS2.p3.m2" class="ltx_Math" alttext="g\leq 3" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">g\leq 3</annotation></semantics></math>, one can explicitly compute <math id="S5.SS2.p3.m3" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math>, relying on explicit models of the curves in low genus.
In order to work with contributions from the boundary, as in Section <a href="#S2.SS5" title="2.5. Comparing point counts of 
          
            
              
              
                ¯
                M
              
              
                
                  
                  
                  
                
                
                  g
                  ,
                  n
                
              
            
          
         and 
          
            
              
              M
              
                
                  
                  
                  
                
                
                  g
                  ,
                  n ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>, one should actually work with equivariant point counts, which amounts to counting points on twisted forms as well.
Inducting on the genus and number of markings, one can assume the contribution from the boundary is understood. The contribution from the interior <math id="S5.SS2.p3.m4" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> (and each twisted form) can be made very explicit in low genus.
For example, in genus <math id="S5.SS2.p3.m5" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, every curve is either hyperelliptic or a smooth plane quartic. For each small <math id="S5.SS2.p3.m6" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, there are only finitely many smooth plane quartics which can be enumerated and studied to obtain these point counts.</p>
</div>
<div id="S5.SS2.p4" class="ltx_para">
<p id="S5.SS2.p4.1" class="ltx_p">Even if we do not know the point count is a polynomial, a similar strategy works if <math id="S5.SS2.p4.m1" class="ltx_Math" alttext="\dim\overline{\mathcal{M}}_{g,n}\leq 22" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>≤</mo><mn>22</mn></mrow><annotation encoding="application/x-tex">\dim\overline{\mathcal{M}}_{g,n}\leq 22</annotation></semantics></math> and Conjecture <a href="#S2.Thmthm20" title="Conjecture 2.20. ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.20</span></a> holds. In this case, the Grothendieck–Lefschetz trace formula implies that <math id="S5.SS2.p4.m2" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> has the shape</p>
<table id="S5.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex4.m1" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})=\sum_{\mathsf{V}}a_{\mathsf{V}}\tr(\mathrm{Frob}_{q}^{*}|\mathsf{V})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>𝖵</mi></munder><mrow><msub><mi>a</mi><mi>𝖵</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>Frob</mi><mi>q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><mi>𝖵</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})=\sum_{\mathsf{V}}a_{\mathsf{V}}\tr(\mathrm{Frob}_{q}^{*}|\mathsf{V}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p4.2" class="ltx_p">where the sum runs over the Galois representations <math id="S5.SS2.p4.m3" class="ltx_Math" alttext="\mathsf{V}" display="inline" intent=":literal"><semantics><mi>𝖵</mi><annotation encoding="application/x-tex">\mathsf{V}</annotation></semantics></math> allowed by Conjecture <a href="#S2.Thmthm20" title="Conjecture 2.20. ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.20</span></a>. Here,
the integers <math id="S5.SS2.p4.m4" class="ltx_Math" alttext="a_{\mathsf{V}}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>𝖵</mi></msub><annotation encoding="application/x-tex">a_{\mathsf{V}}</annotation></semantics></math> are given by the alternating sum of the multiplicities of <math id="S5.SS2.p4.m5" class="ltx_Math" alttext="\mathsf{V}" display="inline" intent=":literal"><semantics><mi>𝖵</mi><annotation encoding="application/x-tex">\mathsf{V}</annotation></semantics></math> in the cohomology groups.
For the representations <math id="S5.SS2.p4.m6" class="ltx_Math" alttext="\mathsf{V}" display="inline" intent=":literal"><semantics><mi>𝖵</mi><annotation encoding="application/x-tex">\mathsf{V}</annotation></semantics></math> allowed by Conjecture <a href="#S2.Thmthm20" title="Conjecture 2.20. ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.20</span></a>, the trace of Frobenius is determined by coefficients of corresponding modular forms. Thus, in a similar fashion to the previous paragraph, each time <math id="S5.SS2.p4.m7" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{g,n}(\mathbb{F}_{q})</annotation></semantics></math> is known for some small value of <math id="S5.SS2.p4.m8" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, it gives rise to a linear relation among the coefficients <math id="S5.SS2.p4.m9" class="ltx_Math" alttext="a_{\mathsf{V}}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>𝖵</mi></msub><annotation encoding="application/x-tex">a_{\mathsf{V}}</annotation></semantics></math>. This strategy is carried out in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite> to determine the <math id="S5.SS2.p4.m10" class="ltx_Math" alttext="a_{\mathsf{V}}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>𝖵</mi></msub><annotation encoding="application/x-tex">a_{\mathsf{V}}</annotation></semantics></math> for <math id="S5.SS2.p4.m11" class="ltx_Math" alttext="g=3" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">g=3</annotation></semantics></math> and <math id="S5.SS2.p4.m12" class="ltx_Math" alttext="n\leq 14" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>14</mn></mrow><annotation encoding="application/x-tex">n\leq 14</annotation></semantics></math>. In fact, the equivariant versions of <math id="S5.SS2.p4.m13" class="ltx_Math" alttext="a_{\mathsf{V}}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>𝖵</mi></msub><annotation encoding="application/x-tex">a_{\mathsf{V}}</annotation></semantics></math> are determined. In the answers presented at the github link above,
the coefficients in the equivariant point count <math id="S5.SS2.p4.m14" class="ltx_Math" alttext="\#^{\mathbb{S}_{n}}\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>#</mi><msub><mi>𝕊</mi><mi>n</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\#^{\mathbb{S}_{n}}\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> are sums of irreducible <math id="S5.SS2.p4.m15" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math> representations; taking dimensions of these representations would give the coefficients <math id="S5.SS2.p4.m16" class="ltx_Math" alttext="a_{\mathsf{V}}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>𝖵</mi></msub><annotation encoding="application/x-tex">a_{\mathsf{V}}</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmthm2" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm2.2" class="ltx_text ltx_font_bold">Remark 5.2</span></span><span id="S5.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm2.p1" class="ltx_para">
<p id="S5.Thmthm2.p1.1" class="ltx_p">The hypothesis <math id="S5.Thmthm2.p1.m1" class="ltx_Math" alttext="n\leq 14" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>14</mn></mrow><annotation encoding="application/x-tex">n\leq 14</annotation></semantics></math> is used in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite> in order to know that <math id="S5.Thmthm2.p1.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{3,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{3,n}</annotation></semantics></math> is unirational. This forces the relations <math id="S5.Thmthm2.p1.m3" class="ltx_Math" alttext="a_{\mathsf{V}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>𝖵</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{\mathsf{V}}=0</annotation></semantics></math> for <math id="S5.Thmthm2.p1.m4" class="ltx_Math" alttext="\mathsf{V}=\mathsf{S}_{k}" display="inline" intent=":literal"><semantics><mrow><mi>𝖵</mi><mo>=</mo><msub><mi>𝖲</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\mathsf{V}=\mathsf{S}_{k}</annotation></semantics></math> or <math id="S5.Thmthm2.p1.m5" class="ltx_Math" alttext="\mathsf{S}_{j,k}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathsf{S}_{j,k}</annotation></semantics></math>. Instead, only the Tate twists <math id="S5.Thmthm2.p1.m6" class="ltx_Math" alttext="\mathsf{L}^{i}\mathsf{S}_{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝖫</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝖲</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\mathsf{L}^{i}\mathsf{S}_{k}</annotation></semantics></math> and <math id="S5.Thmthm2.p1.m7" class="ltx_Math" alttext="\mathsf{L}^{i}\mathsf{S}_{j,k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝖫</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝖲</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathsf{L}^{i}\mathsf{S}_{j,k}</annotation></semantics></math> with <math id="S5.Thmthm2.p1.m8" class="ltx_Math" alttext="i&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i&gt;0</annotation></semantics></math> can appear, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>, Section 7]</cite>. This means fewer relations from point counts are needed to solve the linear system and determine the <math id="S5.Thmthm2.p1.m9" class="ltx_Math" alttext="a_{\mathsf{V}}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>𝖵</mi></msub><annotation encoding="application/x-tex">a_{\mathsf{V}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S5.SS2.p5" class="ltx_para">
<p id="S5.SS2.p5.1" class="ltx_p">Although these results rely on Conjecture <a href="#S2.Thmthm20" title="Conjecture 2.20. ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.20</span></a>, they are known unconditionally in some cases. For example, in genus <math id="S5.SS2.p5.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, Conjecture <a href="#S2.Thmthm20" title="Conjecture 2.20. ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.20</span></a> (and an appropriate generalization to all weights) follows from work of Petersen <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib48" title="" class="ltx_ref">48</a>]</cite>. Moreover, by Theorem <a href="#S4.Thmthm7" title="Theorem 4.7 (Canning–L.–Payne []). ‣ 4. Cohomology in low weights ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a>, Conjecture <a href="#S2.Thmthm20" title="Conjecture 2.20. ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.20</span></a> holds whenever <math id="S5.SS2.p5.m2" class="ltx_Math" alttext="\dim\overline{\mathcal{M}}_{g,n}\leq 15" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>≤</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">\dim\overline{\mathcal{M}}_{g,n}\leq 15</annotation></semantics></math>. In particular, the results for <math id="S5.SS2.p5.m3" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{3,n}" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{3,n}</annotation></semantics></math> are unconditional for <math id="S5.SS2.p5.m4" class="ltx_Math" alttext="n\leq 9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n\leq 9</annotation></semantics></math>. In fact this can be improved further to <math id="S5.SS2.p5.m5" class="ltx_Math" alttext="n\leq 11" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">n\leq 11</annotation></semantics></math>, as we now explain. Using the open circles in the chart in Section <a href="#S3" title="3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and Lemma <a href="#S2.Thmthm10" title="Lemma 2.10 (Lemma 4.3 of []). ‣ 2.2. Comparing Chow and cohomology ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.10</span></a>, all classes in <math id="S5.SS2.p5.m6" class="ltx_Math" alttext="W_{k}H^{k}(\mathcal{M}_{3,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>3</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{k}H^{k}(\mathcal{M}_{3,n})</annotation></semantics></math> are tautological, hence of Tate type, for <math id="S5.SS2.p5.m7" class="ltx_Math" alttext="n\leq 11" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">n\leq 11</annotation></semantics></math>. Then Petersen’s results in genus <math id="S5.SS2.p5.m8" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> ensures that the image of push forward from the boundary is also among the allowed Galois representations, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>, Theorem 1.9]</cite> for more details.</p>
</div>
<div id="S5.SS2.p6" class="ltx_para">
<p id="S5.SS2.p6.1" class="ltx_p">As a final illustration of how the different invariants and results we have considered relate to each other, we give a proof of Proposition <a href="#S3.Thmthm9" title="Proposition 3.9. ‣ 3.5. Interpreting the chart in cohomology ‣ 3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.9</span></a>.</p>
</div>
<div id="S5.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Proposition <a href="#S3.Thmthm9" title="Proposition 3.9. ‣ 3.5. Interpreting the chart in cohomology ‣ 3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.9</span></a>.</h6>
<div id="S5.SS2.p7" class="ltx_para">
<p id="S5.SS2.p7.1" class="ltx_p"><span id="S5.SS2.p7.1.1" class="ltx_text">We first prove the claim that <math id="S5.SS2.p7.m1" class="ltx_Math" alttext="H^{*}(\overline{\mathcal{M}}_{3,9})=RH^{*}(\overline{\mathcal{M}}_{3,9})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mn>9</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mn>9</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{*}(\overline{\mathcal{M}}_{3,9})=RH^{*}(\overline{\mathcal{M}}_{3,9})</annotation></semantics></math>.
In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>, Theorem 8]</cite>, it is shown that all even cohomology of <math id="S5.SS2.p7.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{3,9}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mn>9</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{3,9}</annotation></semantics></math> is tautological. However, the results of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>, show that <math id="S5.SS2.p7.m3" class="ltx_Math" alttext="\#\overline{\mathcal{M}}_{3,9}(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mn>9</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#\overline{\mathcal{M}}_{3,9}(\mathbb{F}_{q})</annotation></semantics></math> is a polynomial in <math id="S5.SS2.p7.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. As discussed above, this result is unconditonal when <math id="S5.SS2.p7.m5" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math>.
Hence by Theorem <a href="#S2.Thmthm16" title="Theorem 2.16 (van den Bogaart–Edixhoven []). ‣ 2.4. Comparing cohomology and point counts ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.16</span></a>, all odd cohomology vanishes.</span></p>
</div>
<div id="S5.SS2.p8" class="ltx_para">
<p id="S5.SS2.p8.1" class="ltx_p"><span id="S5.SS2.p8.1.1" class="ltx_text">Now consider <math id="S5.SS2.p8.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{4,7}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>4</mn><mo>,</mo><mn>7</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{4,7}</annotation></semantics></math>. We have an exact sequence</span></p>
<table id="S5.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex5.m1" class="ltx_Math" alttext="H^{k-2}(\widetilde{\partial\mathcal{M}_{4,7}})\to H^{k}(\overline{\mathcal{M}}_{4,7})\to W_{k}H^{k}(\mathcal{M}_{4,7})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mrow><mo lspace="0em">∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>4</mn><mo>,</mo><mn>7</mn></mrow></msub></mrow><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>4</mn><mo>,</mo><mn>7</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>4</mn><mo>,</mo><mn>7</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{k-2}(\widetilde{\partial\mathcal{M}_{4,7}})\to H^{k}(\overline{\mathcal{M}}_{4,7})\to W_{k}H^{k}(\mathcal{M}_{4,7}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p8.2" class="ltx_p"><span id="S5.SS2.p8.2.1" class="ltx_text">By the open circle in the chart in Section <a href="#S3" title="3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and Remark <a href="#S3.Thmthm1" title="Remark 3.1. ‣ 3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, combined with Lemma <a href="#S2.Thmthm10" title="Lemma 2.10 (Lemma 4.3 of []). ‣ 2.2. Comparing Chow and cohomology ‣ 2. Relationships between the different invariants ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.10</span></a>, we see that <math id="S5.SS2.p8.m2" class="ltx_Math" alttext="W_{k}H^{k}(\mathcal{M}_{4,7})" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>4</mn><mo>,</mo><mn>7</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{k}H^{k}(\mathcal{M}_{4,7})</annotation></semantics></math> is generated by tautological classes. Thus, it suffices to show that all classes pushed forward from the boundary are tautological. We have just shown that <math id="S5.SS2.p8.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{3,9}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mn>9</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{3,9}</annotation></semantics></math> has tautological cohomology ring. Now consider a separating boundary divisor which is the image of a gluing map
<math id="S5.SS2.p8.m4" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g_{1},n_{1}+1}\times\overline{\mathcal{M}}_{g_{2},n_{2}+1}\to\overline{\mathcal{M}}_{4,7}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>4</mn><mo>,</mo><mn>7</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g_{1},n_{1}+1}\times\overline{\mathcal{M}}_{g_{2},n_{2}+1}\to\overline{\mathcal{M}}_{4,7}</annotation></semantics></math>. Every possible <math id="S5.SS2.p8.m5" class="ltx_Math" alttext="(g_{i},n_{i}+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>n</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g_{i},n_{i}+1)</annotation></semantics></math> occurs in a position where there is already a filled circle in the chart in Section <a href="#S3" title="3. When are the Chow or cohomology rings tautological? ‣ Chow rings, cohomology rings, and point counts of moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</span></p>
</div>
<div id="S5.SS2.p9" class="ltx_para">
<p id="S5.SS2.p9.1" class="ltx_p"><span id="S5.SS2.p9.1.1" class="ltx_text">The proofs for <math id="S5.SS2.p9.m1" class="ltx_Math" alttext="(g,n)=(5,5),(6,3),(7,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>6</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(g,n)=(5,5),(6,3),(7,1)</annotation></semantics></math> all proceed similarly. An open circle ensures all classes in <math id="S5.SS2.p9.m2" class="ltx_Math" alttext="W_{k}H^{k}(\mathcal{M}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{k}H^{k}(\mathcal{M}_{g,n})</annotation></semantics></math> are tautological. The previous case of the proposition
ensures classes from the irreducible boundary divisor are tautological. All separating boundary divisors are the images of products of moduli spaces that are already known to have tautological cohomology rings.
∎</span></p>
</div>
</div>
</section>
</section>
