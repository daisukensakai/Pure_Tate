0000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.20877921850137 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.20877921850137 L 0.27673578005007266 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(78.56,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:12.12em;--ltx-fo-height:0.83em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.89" overflow="visible" transform="matrix(1 0 0 -1 0 11.43)" width="167.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex27.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 166.27741236071114 -11.069600110696001 L 166.8308839208113 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(166.56,0) translate(0,-22.67) translate(4.15,0) translate(0,-3.07)"><foreignObject style="--ltx-fo-width:0.85em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.14em;font-size:10pt;" height="9.9" overflow="visible" transform="matrix(1 0 0 -1 0 8.02)" width="11.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex27.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\xi^{\prime\prime}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em">ξ</mi><mo mathsize="0.710em">′′</mo></msup><annotation encoding="application/x-tex">\scriptstyle{\xi^{\prime\prime}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(166.56,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 166.27741236071114 -33.20877921850137 L 166.8308839208113 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 166.27741236071114 -33.20877921850137 L 166.8308839208113 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(-42.81,0) translate(0,-45.33) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.59em;--ltx-fo-height:0.83em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.89" overflow="visible" transform="matrix(1 0 0 -1 0 11.43)" width="77.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex27.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{Gr^{i}_{L}CH^{q}(V)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{Gr^{i}_{L}CH^{q}(V)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 42.80832474601538 -45.60790187972404 L 42.80832474601538 -45.05443031962389" fill="none" stroke="#000000"></path><g transform="translate(53.39,0) translate(0,-36.79) translate(4.15,0) translate(0,-4.39)"><foreignObject style="--ltx-fo-width:1.49em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.79" overflow="visible" transform="matrix(1 0 0 -1 0 8.79)" width="20.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex27.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\Box^{q,i}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em" mathvariant="normal">□</mi><mrow><mi mathsize="0.710em">q</mi><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">i</mi></mrow></msup><annotation encoding="application/x-tex">\scriptstyle{\Box^{q,i}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(76.16,0) translate(0,-45.33)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 42.80832474601538 -45.60790187972404 L 76.15964178790257 -45.05443031962389" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 76.15964178790257 -45.60790187972404 L 76.15964178790257 -45.05443031962389" fill="none" stroke="#000000"></path><g transform="translate(76.16,0) translate(0,-45.33) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:12.47em;--ltx-fo-height:0.83em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.89" overflow="visible" transform="matrix(1 0 0 -1 0 11.43)" width="172.49"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex27.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{\Hodge(H^{i}(U,R^{2q-i}f_{*}{\mathbb{Q}}))(q))}" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo lspace="0em" rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\textstyle{\Hodge(H^{i}(U,R^{2q-i}f_{*}{\mathbb{Q}}))(q))}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p14.3" class="ltx_p"><span id="S1.p14.3.1" class="ltx_text">where <math id="S1.p14.m13" class="ltx_Math" alttext="\xi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ξ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\xi^{\prime}</annotation></semantics></math> and <math id="S1.p14.m14" class="ltx_Math" alttext="\xi^{\prime\prime}" display="inline" intent=":literal"><semantics><msup><mi>ξ</mi><mo>′′</mo></msup><annotation encoding="application/x-tex">\xi^{\prime\prime}</annotation></semantics></math> are products with
<math id="S1.p14.m15" class="ltx_Math" alttext="c_{1}({\mathcal{O}}_{X}(1))^{r-2p+i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>r</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo>+</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">c_{1}({\mathcal{O}}_{X}(1))^{r-2p+i}</annotation></semantics></math>. The map <math id="S1.p14.m16" class="ltx_Math" alttext="\xi^{\prime\prime}" display="inline" intent=":literal"><semantics><msup><mi>ξ</mi><mo>′′</mo></msup><annotation encoding="application/x-tex">\xi^{\prime\prime}</annotation></semantics></math> is an isomorphism because
<math id="S1.p14.m17" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> is. If
<math id="S1.p14.m18" class="ltx_Math" alttext="\Box^{p,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{p,i}</annotation></semantics></math> is surjective, then <math id="S1.p14.m19" class="ltx_Math" alttext="\Box^{q,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>q</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{q,i}</annotation></semantics></math> must also be
surjective. This allows to extend surjectivity of <math id="S1.p14.m20" class="ltx_Math" alttext="\Box^{p,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{p,i}</annotation></semantics></math> from
<math id="S1.p14.m21" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> to the parallelogram <math id="S1.p14.m22" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> bounded by <math id="S1.p14.m23" class="ltx_Math" alttext="i=0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i=0</annotation></semantics></math>, <math id="S1.p14.m24" class="ltx_Math" alttext="i=m" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=m</annotation></semantics></math>, <math id="S1.p14.m25" class="ltx_Math" alttext="i=2p" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">i=2p</annotation></semantics></math>, and <math id="S1.p14.m26" class="ltx_Math" alttext="i=2p-2r" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">i=2p-2r</annotation></semantics></math>.</span></p>
</div>
<div id="S1.p15" class="ltx_para">
<p id="S1.p15.1" class="ltx_p"><span id="S1.p15.1.1" class="ltx_text">To finish the proof, we have to show that if <math id="S1.p15.m1" class="ltx_Math" alttext="\Box^{p,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{p,i}</annotation></semantics></math> is
surjective for <math id="S1.p15.m2" class="ltx_Math" alttext="(p,i)\in P^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">(p,i)\in P^{\prime}</annotation></semantics></math>, then this holds for <math id="S1.p15.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.
Let <math id="S1.p15.m4" class="ltx_Math" alttext="i\leq m" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i\leq m</annotation></semantics></math>, <math id="S1.p15.m5" class="ltx_Math" alttext="\iota=2m-i" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mi>i</mi></mrow></mrow><annotation encoding="application/x-tex">\iota=2m-i</annotation></semantics></math>,
and <math id="S1.p15.m6" class="ltx_Math" alttext="q=p+m-i" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>m</mi></mrow><mo>−</mo><mi>i</mi></mrow></mrow><annotation encoding="application/x-tex">q=p+m-i</annotation></semantics></math>. The transformation <math id="S1.p15.m7" class="ltx_Math" alttext="(p,i)\mapsto(q,\iota)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>ι</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(p,i)\mapsto(q,\iota)</annotation></semantics></math> is a
reflection about <math id="S1.p15.m8" class="ltx_Math" alttext="i=m" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=m</annotation></semantics></math>, which preserves lines of slope <math id="S1.p15.m9" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>.
Therefore <math id="S1.p15.m10" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is the union of <math id="S1.p15.m11" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> and the image of <math id="S1.p15.m12" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> under this reflection.
If <math id="S1.p15.m13" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is a local system defined on <math id="S1.p15.m14" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, let
<math id="S1.p15.m15" class="ltx_math_unparsed" alttext="IH^{i}(Y,L)=H^{i}(Y,(j_{!*}L[m])[-m])" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><msup><mi>H</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>H</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>j</mi><mrow><mo rspace="0.055em">!</mo><mo>∗</mo></mrow></msub><mi>L</mi><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">IH^{i}(Y,L)=H^{i}(Y,(j_{!*}L[m])[-m])</annotation></semantics></math> denote intersection cohomology
(with the naive indexing convention).
We have a commutative diagram of vector spaces</span></p>
<table id="S1.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
