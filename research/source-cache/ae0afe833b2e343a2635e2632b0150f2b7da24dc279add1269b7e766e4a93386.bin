1em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="95.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex13.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{H^{0}(Y,R^{2p}F_{*}{\mathbb{Q}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H^{0}(Y,R^{2p}F_{*}{\mathbb{Q}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 135.24810423639218 -11.069600110696001 L 135.80157579649233 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(135.53,0) translate(0,-22.58) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.72" overflow="visible" transform="matrix(1 0 0 -1 0 6.78)" width="7.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex13.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\cong}" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">≅</mo><annotation encoding="application/x-tex">\scriptstyle{\cong}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(135.53,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 135.24810423639218 -33.20877921850137 L 135.80157579649233 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 135.24810423639218 -33.20877921850137 L 135.80157579649233 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(-50.66,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.72em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="93.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex13.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{Gr^{2}_{L}CH^{p+1}(X)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{Gr^{2}_{L}CH^{p+1}(X)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 50.65732169187595 -45.44072450073293 L 50.65732169187595 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(46.73,0) translate(0,-36.62) translate(4.15,0) translate(0,-4.39)"><foreignObject style="--ltx-fo-width:2.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.79" overflow="visible" transform="matrix(1 0 0 -1 0 8.79)" width="33.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex13.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\Box^{p+1,2}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em" mathvariant="normal">□</mi><mrow><mrow><mi mathsize="0.710em">p</mi><mo mathsize="0.710em">+</mo><mn mathsize="0.710em">1</mn></mrow><mo mathsize="0.710em">,</mo><mn mathsize="0.710em">2</mn></mrow></msup><annotation encoding="application/x-tex">\scriptstyle{\Box^{p+1,2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(83.87,0) translate(0,-45.16)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 50.65732169187595 -45.44072450073293 L 83.86610091037731 -44.887252940632784" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 83.86610091037731 -45.44072450073293 L 83.86610091037731 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(83.87,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.87em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="95.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex13.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{H^{2}(Y,R^{2p}F_{*}{\mathbb{Q}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H^{2}(Y,R^{2p}F_{*}{\mathbb{Q}})}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p8.2" class="ltx_p"><span id="S3.p8.2.1" class="ltx_text">where the isomorphism on the right is hard Lefschetz.
This implies surjectivity of <math id="S3.p8.m1" class="ltx_Math" alttext="\Box^{p+1,2}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">\Box^{p+1,2}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.p9" class="ltx_para">
<p id="S3.p9.1" class="ltx_p"><span id="S3.p9.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S3.Thmprop2" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmprop2.1" class="ltx_text ltx_font_bold">Proposition 3.2</span></span><span id="S3.Thmprop2.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmprop2.p1" class="ltx_para">
<p id="S3.Thmprop2.p1.1" class="ltx_p"><span id="S3.Thmprop2.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="S3.Thmprop2.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>,</span></p>
<table id="S3.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex14.m1" class="ltx_Math" alttext="Gr^{p}_{F}H^{1}(Y,R^{2p-1}F_{*}{\mathbb{C}})=0" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Gr^{p}_{F}H^{1}(Y,R^{2p-1}F_{*}{\mathbb{C}})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p10" class="ltx_para">
<p id="S3.p10.1" class="ltx_p"><span id="S3.p10.1.1" class="ltx_text">The local system <math id="S3.p10.m1" class="ltx_Math" alttext="R^{2p-1}F_{*}{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">R^{2p-1}F_{*}{\mathbb{C}}</annotation></semantics></math> corresponds to the <math id="S3.p10.m2" class="ltx_Math" alttext="SL_{2}({\mathbb{C}})^{d}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">SL_{2}({\mathbb{C}})^{d}</annotation></semantics></math>-module <math id="S3.p10.m3" class="ltx_math_unparsed" alttext="\wedge^{2p-1}(V^{\oplus n})" display="inline" intent=":literal"><semantics><mrow><msup><mo>∧</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mrow><mo>⊕</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\wedge^{2p-1}(V^{\oplus n})</annotation></semantics></math>.
We can decompose it into a sum of irreducible modules, and reduce to the problem of showing that</span></p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="H^{1}(M^{q}\xrightarrow{\phi}M^{q-1}\otimes\Omega_{Y}^{1})=0" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>M</mi><mi>q</mi></msup><mover accent="true"><mo>→</mo><mo class="ltx_mathvariant_italic" mathsize="0.700em" mathvariant="italic">ϕ</mo></mover><mrow><msup><mi>M</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mn>1</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{1}(M^{q}\xrightarrow{\phi}M^{q-1}\otimes\Omega_{Y}^{1})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p10.2" class="ltx_p"><span id="S3.p10.2.1" class="ltx_text">where</span></p>
<table id="S3.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex15.m1" class="ltx_Math" alttext="(M,\phi)=S^{2q-1}(E_{1},\theta)\otimes S^{r_{2}}(E_{2},0)\otimes\ldots S^{r_{d}}(E_{d},0)" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mrow><mrow><mrow><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><mi>θ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>S</mi><msub><mi>r</mi><mn>2</mn></msub></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mn>2</mn></msub><mo>,</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi mathvariant="normal">…</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><msub><mi>r</mi><mi>d</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>d</mi></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(M,\phi)=S^{2q-1}(E_{1},\theta)\otimes S^{r_{2}}(E_{2},0)\otimes\ldots S^{r_{d}}(E_{d},0)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S3.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex16.m1" class="ltx_Math" alttext="=S^{2q-1}(E_{1},\theta)\otimes(M^{\prime},0)" display="block" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><mi>θ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">=S^{2q-1}(E_{1},\theta)\otimes(M^{\prime},0)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p10.3" class="ltx_p"><span id="S3.p10.3.1" class="ltx_text">and <math id="S3.p10.m4" class="ltx_Math" alttext="q,r_{1},\ldots" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>,</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">q,r_{1},\ldots</annotation></semantics></math> are arbitrary.
Let <math id="S3.p10.m5" class="ltx_Math" alttext="I=(1,\ldots,1,0\ldots,0)" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn><mo>,</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I=(1,\ldots,1,0\ldots,0)</annotation></semantics></math> with <math id="S3.p10.m6" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> <math id="S3.p10.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>’s followed by <math id="S3.p10.m8" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> <math id="S3.p10.m9" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>’s.
Then we have an isomorphism of complexes</span></p>
<table id="S3.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex17.m1" class="ltx_math_unparsed" alttext="M^{q}\xrightarrow{\phi}M^{q-1}\otimes\Omega_{Y}^{1}\cong[E_{1}^{1}\xrightarrow{\sim}E_{1}^{0}\otimes\Omega_{Y}^{1}]\otimes E_{1}^{I}\otimes M^{\prime}" display="block" intent=":literal"><semantics><mrow><msup><mi>M</mi><mi>q</mi></msup><mover accent="true"><mo>→</mo><mo class="ltx_mathvariant_italic" mathsize="0.700em" mathvariant="italic">ϕ</mo></mover><msup><mi>M</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mn>1</mn></msubsup><mo>≅</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>E</mi><mn>1</mn><mn>1</mn></msubsup><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msubsup><mi>E</mi><mn>1</mn><mn>0</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mn>1</mn></msubsup><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>E</mi><mn>1</mn><mi>I</mi></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>M</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">M^{q}\xrightarrow{\phi}M^{q-1}\otimes\Omega_{Y}^{1}\cong[E_{1}^{1}\xrightarrow{\sim}E_{1}^{0}\otimes\Omega_{Y}^{1}]\otimes E_{1}^{I}\otimes M^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p10.4" class="ltx_p"><span id="S3.p10.4.1" class="ltx_text">This implies (<a href="#S3.E4" title="In Proof. ‣ 3. Families of abelian varieties over a Shimura curve ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>).</span></p>
</div>
<div id="S3.p11" class="ltx_para">
<p id="S3.p11.1" class="ltx_p"><span id="S3.p11.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of theorem <a href="#S3.Thmthm2" title="Theorem 3.2. ‣ 3. Families of abelian varieties over a Shimura curve ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>.</h6>
<div id="S3.p12" class="ltx_para">
<p id="S3.p12.1" class="ltx_p"><span id="S3.p12.1.1" class="ltx_text">This is a consequence of corollary <a href="#S1.Thmthm7" title="Corollary 1.7. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.7</span></a> and the last two propositions.
∎</span></p>
</div>
</div>
</section>
