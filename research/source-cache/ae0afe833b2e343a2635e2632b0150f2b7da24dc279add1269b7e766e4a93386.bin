eignObject style="--ltx-fo-width:8.82em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="121.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex14.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{\Hodge(H_{2p}(Z)(-p))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\Hodge(H_{2p}(Z)(-p))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 65.14257228075923 -44.55513622283408 L 65.14257228075923 -44.00166466273393" fill="none" stroke="#000000"></path><g transform="translate(98.35,0) translate(0,-44.28)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 65.14257228075923 -44.55513622283408 L 98.35135149926059 -44.00166466273393" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 98.35135149926059 -44.55513622283408 L 98.35135149926059 -44.00166466273393" fill="none" stroke="#000000"></path><g transform="translate(98.35,0) translate(0,-44.28) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.97em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="124.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex14.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{\Hodge(H_{2p}(X)(-p))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\Hodge(H_{2p}(X)(-p))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 230.75043058204045 -44.55513622283408 L 230.75043058204045 -44.00166466273393" fill="none" stroke="#000000"></path><g transform="translate(239.9,0) translate(0,-37.1) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.42em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex14.m1.pic1.m9" class="ltx_Math" alttext="\scriptstyle{\gamma}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">γ</mi><annotation encoding="application/x-tex">\scriptstyle{\gamma}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(263.96,0) translate(0,-44.28)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 230.75043058204045 -44.55513622283408 L 263.95923091412845 -44.00166466273393" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 263.95923091412845 -44.55513622283408 L 263.95923091412845 -44.00166466273393" fill="none" stroke="#000000"></path><g transform="translate(263.96,0) translate(0,-44.28) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.85em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="122.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex14.m1.pic1.m10" class="ltx_Math" alttext="\textstyle{\Hodge(H_{2p}(U)(-p))}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\Hodge(H_{2p}(U)(-p))}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p7.4" class="ltx_p"><span id="S1.p7.4.1" class="ltx_text">The first part of the lemma follows from the surjectivity of <math id="S1.p7.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and <math id="S1.p7.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, and
the five lemma.</span></p>
</div>
<div id="S1.p8" class="ltx_para">
<p id="S1.p8.1" class="ltx_p"><span id="S1.p8.1.1" class="ltx_text">We note that
<math id="S1.p8.m1" class="ltx_Math" alttext="Gr^{W}_{-2p}H_{2p-1}(Z)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Gr^{W}_{-2p}H_{2p-1}(Z)=0</annotation></semantics></math>, because <math id="S1.p8.m2" class="ltx_Math" alttext="Gr^{W}_{2p}H^{2p-1}_{c}(Z)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>H</mi><mi>c</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Gr^{W}_{2p}H^{2p-1}_{c}(Z)=0</annotation></semantics></math>.
Therefore <math id="S1.p8.m3" class="ltx_Math" alttext="Gr^{W}_{-2p}H_{2p}(X)\to Gr^{W}_{-2p}H_{2p}(U)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Gr^{W}_{-2p}H_{2p}(X)\to Gr^{W}_{-2p}H_{2p}(U)</annotation></semantics></math> is surjective.
Consequently <math id="S1.p8.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is surjective. This implies last part of the lemma.</span></p>
</div>
<div id="S1.p9" class="ltx_para">
<p id="S1.p9.1" class="ltx_p"><span id="S1.p9.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S1.p10" class="ltx_para">
<p id="S1.p10.1" class="ltx_p">Now, let us suppose that <math id="S1.p10.m1" class="ltx_Math" alttext="f:X\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:X\to Y</annotation></semantics></math> is a surjective morphism with
connected fibres between smooth projective varieties. We suppose also that
<math id="S1.p10.m2" class="ltx_Math" alttext="\dim Y&lt;\dim X" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>Y</mi></mrow><mo rspace="0.1389em">&lt;</mo><mrow><mo lspace="0.1389em" rspace="0.167em">dim</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\dim Y&lt;\dim X</annotation></semantics></math>. We can analyze
the Hodge structure <math id="S1.p10.m3" class="ltx_Math" alttext="H^{i}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{i}(X)</annotation></semantics></math> in terms of the map by applying the decomposition for Hodge
modules <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">Sa1</a>]</cite>, but we prefer to do this in a more canonical fashion.
First, let us choose a nonempty Zariski open subset <math id="S1.p10.m4" class="ltx_Math" alttext="U\subset Y" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">U\subset Y</annotation></semantics></math>, such that <math id="S1.p10.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>
is smooth over <math id="S1.p10.m6" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, and let <math id="S1.p10.m7" class="ltx_Math" alttext="V=f^{-1}U" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow></mrow><annotation encoding="application/x-tex">V=f^{-1}U</annotation></semantics></math>.
Then the Leray filtration is defined by</p>
<table id="S1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex15.m1" class="ltx_math_unparsed" alttext="L_{f}^{p}H^{i}(V,{\mathbb{Q}})=\im[H^{i}(U,\tau_{\leq i-p}{\mathbb{R}}f_{*}{\mathbb{Q}}\to H^{i}(U,{\mathbb{R}}f_{*}{\mathbb{Q}})=H^{i}(V,{\mathbb{Q}})]" display="block" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mi>f</mi><mi>p</mi></msubsup><msup><mi>H</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0em">im</mo><mrow><mo stretchy="false">[</mo><msup><mi>H</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><msub><mi>τ</mi><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>i</mi><mo>−</mo><mi>p</mi></mrow></mrow></msub><mi>ℝ</mi><msub><mi>f</mi><mo>∗</mo></msub><mi>ℚ</mi><mo stretchy="false">→</mo><msup><mi>H</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>ℝ</mi><msub><mi>f</mi><mo>∗</mo></msub><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>H</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{f}^{p}H^{i}(V,{\mathbb{Q}})=\im[H^{i}(U,\tau_{\leq i-p}{\mathbb{R}}f_{*}{\mathbb{Q}}\to H^{i}(U,{\mathbb{R}}f_{*}{\mathbb{Q}})=H^{i}(V,{\mathbb{Q}})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p10.2" class="ltx_p">We usually write <math id="S1.p10.m8" class="ltx_Math" alttext="L^{\bullet}=L_{f}^{\bullet}" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mo>∙</mo></msup><mo>=</mo><msubsup><mi>L</mi><mi>f</mi><mo>∙</mo></msubsup></mrow><annotation encoding="application/x-tex">L^{\bullet}=L_{f}^{\bullet}</annotation></semantics></math>.
By a theorem of Deligne <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx6" title="" class="ltx_ref">D1</a>]</cite>, the Leray spectral sequence degenerates, so that</p>
<table id="S1.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex16.m1" class="ltx_Math" alttext="Gr^{b}_{L}H^{a}(V)\cong H^{b}(U,R^{a-b}f_{*}{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>b</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>H</mi><mi>b</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mi>a</mi><mo>−</mo><mi>b</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Gr^{b}_{L}H^{a}(V)\cong H^{b}(U,R^{a-b}f_{*}{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p10.3" class="ltx_p">Furthermore, the author <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">A1</a>, cor 2.6]</cite> showed that <math id="S1.p10.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is a
filtration by submixed Hodge structures. Therefore <math id="S1.p10.m10" class="ltx_Math" alttext="Gr^{b}_{L}H^{a}(V)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>b</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Gr^{b}_{L}H^{a}(V)</annotation></semantics></math>
carry natural mixed Hodge structures. These can be seen to coincide with the ones constructed by Saito <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Sa2</a>]</cite>.
We define a Leray filtration on the Chow group in the most naive way.
Let <math id="S1.p10.m11" class="ltx_Math" alttext="L^{\bullet}CH^{p}(V)" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{\bullet}CH^{p}(V)</annotation></semantics></math> denote the preimage of <math id="S1.p10.m12" class="ltx_Math" alttext="L^{\bullet}H^{2p}(V,{\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{\bullet}H^{2p}(V,{\mathbb{Q}})</annotation></semantics></math> under
the cycle map</p>
<table id="S1.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex17.m1" class="ltx_Math" alttext="CH^{p}(V)\to H^{2p}(V,{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CH^{p}(V)\to H^{2p}(V,{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p10.4" class="ltx_p">Then we have an induced cycle map</p>
<table id="S1.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(1.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E1.m1" class="ltx_Math" alttext="\Box^{p,i}:Gr^{i}_{L}CH^{p}(V)\to H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Box^{p,i}:Gr^{i}_{L}CH^{p}(V)\to H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p10.5" class="ltx_p">Since <math id="S1.p10.m13" class="ltx_Math" alttext="\Box^{p,i}(\alpha)\equiv\Box(\alpha)\mod L^{i+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≡</mo><mrow><mrow><mi mathvariant="normal">□</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>mod</mo><msup><mi>L</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\Box^{p,i}(\alpha)\equiv\Box(\alpha)\mod L^{i+1}</annotation></semantics></math>, it
follows that the image lies in</p>
<table id="S1.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex18.m1" class="ltx_Math" alttext="\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))" display="block" intent=":literal"><semantics><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p10.6" class="ltx_p">When <math id="S1.p10.m14" class="ltx_Math" alttext="f:X\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:X\to Y</annotation></semantics></math> is defined over the above field <math id="S1.p10.m15" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, one
has an entirely parallel story for <math id="S1.p10.m16" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic cohomology. We have a
cycle map</p>
<table id="S1.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex19.m1" class="ltx_Math" alttext="\Box^{p,i}:Gr^{i}_{L}CH^{p}(\bar{V})\otimes{\mathbb{Q}}_{\ell}\to\Tate(H^{i}(\bar{U}_{et},R^{2p-i}\bar{f}_{*}{\mathbb{Q}}_{\ell})(p))" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>V</mi><mo>¯</mo></mover><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo rspace="0.1389em" stretchy="false">→</mo><mrow><mo lspace="0.1389em" rspace="0em">Tate</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>U</mi><mo>¯</mo></mover><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>f</mi><mo>¯</mo></mover><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Box^{p,i}:Gr^{i}_{L}CH^{p}(\bar{V})\otimes{\mathbb{Q}}_{\ell}\to\Tate(H^{i}(\bar{U}_{et},R^{2p-i}\bar{f}_{*}{\mathbb{Q}}_{\ell})(p))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S1.Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmlemma3.1" class="ltx_text ltx_font_bold">Lemma 1.3</span></span><span id="S1.Thmlemma3.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S1.Thmlemma3.p1" class="ltx_para">
<ol id="S1.I2" class="ltx_enumerate">
<li id="S1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S1.I2.i1.p1" class="ltx_para">
<p id="S1.I2.i1.p1.1" class="ltx_p"><span id="S1.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S1.I2.i1.p1.m1" class="ltx_Math" alttext="f_{i}:V_{i}\to U_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">→</mo><msub><mi>U</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f_{i}:V_{i}\to U_{i}</annotation></semantics></math><span id="S1.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> are two smooth projective maps, then
the exterior product is compatible with </span><math id="S1.I2.i1.p1.m2" class="ltx_Math" alttext="L^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">L^{\bullet}</annotation></semantics></math><span id="S1.I2.i1.p1.1.3" class="ltx_text ltx_font_italic"> in the sense that</span></p>
<table id="S1.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex20.m1" class="ltx_Math" alttext="L_{f_{1}}^{p}H^{i}(V_{1},{\mathbb{Q}})\otimes L_{f_{2}}^{q}H^{j}(V_{2},{\mathbb{Q}})\subseteq L_{f_{1}\times f_{2}}^{p+q}H^{i+j}(V_{1}\times V_{2},{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>L</mi><msub><mi>f</mi><mn>1</mn></msub><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo>,</mo><mi>ℚ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>L</mi><msub><mi>f</mi><mn>2</mn></msub><mi>q</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>2</mn></msub><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><msubsup><mi>L</mi><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>V</mi><mn>2</mn></msub></mrow><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{f_{1}}^{p}H^{i}(V_{1},{\mathbb{Q}})\otimes L_{f_{2}}^{q}H^{j}(V_{2},{\mathbb{Q}})\subseteq L_{f_{1}\times f_{2}}^{p+q}H^{i+j}(V_{1}\times V_{2},{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S1.I2.i2.p1" class="ltx_para">
<p id="S1.I2.i2.p1.1" class="ltx_p"><span id="S1.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">Furthermore</span></p>
<table id="S1.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex21.m1" class="ltx_Math" alttext="L^{r}H^{k}(V_{1}\times V_{2},{\mathbb{Q}})=\bigoplus_{i+j=k,p+q=r}L^{p}H^{i}(V_{1},{\mathbb{Q}})\otimes L^{q}H^{j}(V_{2},{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>L</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>V</mi><mn>2</mn></msub></mrow><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>=</mo><mi>k</mi></mrow><mo>,</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>=</mo><mi>r</mi></mrow></mrow></munder><mrow><msup><mi>L</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo>,</mo><mi>ℚ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>L</mi><mi>q</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>2</mn></msub><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L^{r}H^{k}(V_{1}\times V_{2},{\mathbb{Q}})=\bigoplus_{i+j=k,p+q=r}L^{p}H^{i}(V_{1},{\mathbb{Q}})\otimes L^{q}H^{j}(V_{2},{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S1.I2.i3.p1" class="ltx_para">
<p id="S1.I2.i3.p1.1" class="ltx_p"><span id="S1.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">There is a commutative diagram</span></p>
<table id="S1.Ex22" class="ltx_equation ltx_eqn_table">

