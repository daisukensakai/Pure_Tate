d="S1.Ex22.m1.pic1.m5" class="ltx_math_unparsed" alttext="\textstyle{H^{i}(U_{1},R^{2p-i}f_{1*}{\mathbb{Q}})\otimes H^{j}(U_{2},R^{2q-j}f_{2*}{\mathbb{Q}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>,</mo><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><msub><mi>f</mi><mrow><mn>1</mn><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msup><mi>H</mi><mi>j</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>,</mo><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mi>j</mi></mrow></msup><msub><mi>f</mi><mrow><mn>2</mn><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H^{i}(U_{1},R^{2p-i}f_{1*}{\mathbb{Q}})\otimes H^{j}(U_{2},R^{2q-j}f_{2*}{\mathbb{Q}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 126.06719890471496 -45.95866189452314 L 126.06719890471496 -45.405190334423" fill="none" stroke="#000000"></path><g transform="translate(159.28,0) translate(0,-45.68)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 126.06719890471496 -45.95866189452314 L 159.27597812321633 -45.405190334423" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 159.27597812321633 -45.95866189452314 L 159.27597812321633 -45.405190334423" fill="none" stroke="#000000"></path><g transform="translate(159.28,0) translate(0,-45.68) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:16.53em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.75" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="228.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex22.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{H^{i+j}(U_{1}\times U_{2},R^{2(p+q)-i-j}(f_{1}\times f_{2}){*}{\mathbb{Q}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>U</mi><mn>2</mn></msub></mrow><mo>,</mo><mrow><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>i</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">∗</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H^{i+j}(U_{1}\times U_{2},R^{2(p+q)-i-j}(f_{1}\times f_{2}){*}{\mathbb{Q}})}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S1.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S1.I2.i4.p1" class="ltx_para">
<p id="S1.I2.i4.p1.1" class="ltx_p"><span id="S1.I2.i4.p1.1.1" class="ltx_text ltx_font_italic">When </span><math id="S1.I2.i4.p1.m1" class="ltx_Math" alttext="U=U_{1}=U_{2}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><msub><mi>U</mi><mn>1</mn></msub><mo>=</mo><msub><mi>U</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">U=U_{1}=U_{2}</annotation></semantics></math><span id="S1.I2.i4.p1.1.2" class="ltx_text ltx_font_italic">, the same statements hold for the fibre
product </span><math id="S1.I2.i4.p1.m2" class="ltx_Math" alttext="V_{1}\times_{U}V_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>1</mn></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></msub><msub><mi>V</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">V_{1}\times_{U}V_{2}</annotation></semantics></math><span id="S1.I2.i4.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S1.p11" class="ltx_para">
<p id="S1.p11.1" class="ltx_p"><span id="S1.p11.1.1" class="ltx_text">The first two statements are formal consequences of the isomorphism</span></p>
<table id="S1.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex23.m1" class="ltx_math_unparsed" alttext="({\mathbb{R}}f_{1*}{\mathbb{Q}},\tau_{\leq})\boxtimes({\mathbb{R}}f_{2*}{\mathbb{Q}},\tau_{\leq})\cong({\mathbb{R}}(f_{1}\times f_{2})_{*}{\mathbb{Q}},\tau_{\leq})" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><msub><mi>f</mi><mrow><mn>1</mn><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi><mo>,</mo><msub><mi>τ</mi><mo>≤</mo></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊠</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><msub><mi>f</mi><mrow><mn>2</mn><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi><mo>,</mo><msub><mi>τ</mi><mo>≤</mo></msub><mo stretchy="false">)</mo></mrow><mo>≅</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><msub><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mi>ℚ</mi><mo>,</mo><msub><mi>τ</mi><mo>≤</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">({\mathbb{R}}f_{1*}{\mathbb{Q}},\tau_{\leq})\boxtimes({\mathbb{R}}f_{2*}{\mathbb{Q}},\tau_{\leq})\cong({\mathbb{R}}(f_{1}\times f_{2})_{*}{\mathbb{Q}},\tau_{\leq})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p11.2" class="ltx_p"><span id="S1.p11.2.1" class="ltx_text">in the filtered derived category. The third statement is a formal
consequence of the first two statements, and the compatibility of
<math id="S1.p11.m1" class="ltx_Math" alttext="\Box" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\Box</annotation></semantics></math> with external products. The fourth follows from the previous
statements by restricting to the diagonal embedding <math id="S1.p11.m2" class="ltx_Math" alttext="U\subset U\times U" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mrow><mi>U</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow></mrow><annotation encoding="application/x-tex">U\subset U\times U</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S1.p12" class="ltx_para">
<p id="S1.p12.1" class="ltx_p">Let <math id="S1.p12.m1" class="ltx_Math" alttext="n=\dim X" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0.167em">dim</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">n=\dim X</annotation></semantics></math>, <math id="S1.p12.m2" class="ltx_Math" alttext="m=\dim Y" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0.167em">dim</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">m=\dim Y</annotation></semantics></math>, and <math id="S1.p12.m3" class="ltx_Math" alttext="r=n-m" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mi>n</mi><mo>−</mo><mi>m</mi></mrow></mrow><annotation encoding="application/x-tex">r=n-m</annotation></semantics></math>.
Then the groups on the right of (<a href="#S1.E1" title="In 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>) will vanish for <math id="S1.p12.m4" class="ltx_Math" alttext="(p,i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,i)</annotation></semantics></math> outside the
closed parallelogram <math id="S1.p12.m5" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> in the <math id="S1.p12.m6" class="ltx_Math" alttext="(p,i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,i)</annotation></semantics></math>-plane bounded by the lines
<math id="S1.p12.m7" class="ltx_Math" alttext="i=0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i=0</annotation></semantics></math>, <math id="S1.p12.m8" class="ltx_Math" alttext="i=2m" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><annotation encoding="application/x-tex">i=2m</annotation></semantics></math>, <math id="S1.p12.m9" class="ltx_Math" alttext="i=2p" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">i=2p</annotation></semantics></math>, and <math id="S1.p12.m10" class="ltx_Math" alttext="i=2p-2r" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">i=2p-2r</annotation></semantics></math>.
Let <math id="S1.p12.m11" class="ltx_Math" alttext="Q\subset P" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⊂</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">Q\subset P</annotation></semantics></math> be the closed parallelogram bounded by the lines
<math id="S1.p12.m12" class="ltx_Math" alttext="i=0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i=0</annotation></semantics></math>, <math id="S1.p12.m13" class="ltx_Math" alttext="i=m" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=m</annotation></semantics></math>, <math id="S1.p12.m14" class="ltx_Math" alttext="i=2p" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">i=2p</annotation></semantics></math>, and <math id="S1.p12.m15" class="ltx_Math" alttext="i=2p-r" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">i=2p-r</annotation></semantics></math>. This is the lower left quarter
of <math id="S1.p12.m16" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.</p>
</div>
<div id="S1.Thmthm2" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmthm2.1" class="ltx_text ltx_font_bold">Theorem 1.2</span></span><span id="S1.Thmthm2.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S1.Thmthm2.p1" class="ltx_para">
<p id="S1.Thmthm2.p1.1" class="ltx_p"><span id="S1.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">When <math id="S1.Thmthm2.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is defined over <math id="S1.Thmthm2.p1.m2" class="ltx_Math" alttext="{\mathbb{C}}" display="inline" intent=":literal"><semantics><mi>ℂ</mi><annotation encoding="application/x-tex">{\mathbb{C}}</annotation></semantics></math>, and the cycle map</span></p>
<table id="S1.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex24.m1" class="ltx_Math" alttext="\Box^{p,i}:Gr^{i}_{L}CH^{p}(V)\to\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em" stretchy="false">→</mo><mrow><mo lspace="0.1389em" rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Box^{p,i}:Gr^{i}_{L}CH^{p}(V)\to\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.Thmthm2.p1.2" class="ltx_p"><span id="S1.Thmthm2.p1.2.1" class="ltx_text ltx_font_italic">is surjective for all <math id="S1.Thmthm2.p1.m3" class="ltx_Math" alttext="(p,i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,i)</annotation></semantics></math> in <math id="S1.Thmthm2.p1.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, the Hodge conjecture holds for
<math id="S1.Thmthm2.p1.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>.
When <math id="S1.Thmthm2.p1.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is defined over <math id="S1.Thmthm2.p1.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, and the cycle map</span></p>
<table id="S1.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex25.m1" class="ltx_Math" alttext="\Box_{\ell}^{p,i}:Gr^{i}_{L}CH^{p}(V)\otimes{\mathbb{Q}}_{\ell}\to\Tate(H^{i}(\bar{U}_{et},R^{2p-i}\bar{f}_{et,*}{\mathbb{Q}}_{\ell})(p))" display="block" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">□</mi><mi mathvariant="normal">ℓ</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo rspace="0.1389em" stretchy="false">→</mo><mrow><mo lspace="0.1389em" rspace="0em">Tate</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>U</mi><mo>¯</mo></mover><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>f</mi><mo>¯</mo></mover><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Box_{\ell}^{p,i}:Gr^{i}_{L}CH^{p}(V)\otimes{\mathbb{Q}}_{\ell}\to\Tate(H^{i}(\bar{U}_{et},R^{2p-i}\bar{f}_{et,*}{\mathbb{Q}}_{\ell})(p))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.Thmthm2.p1.3" class="ltx_p"><span id="S1.Thmthm2.p1.3.1" class="ltx_text ltx_font_italic">is surjective for all <math id="S1.Thmthm2.p1.m8" class="ltx_Math" alttext="(p,i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,i)</annotation></semantics></math> in <math id="S1.Thmthm2.p1.m9" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, the Tate conjecture holds for <math id="S1.Thmthm2.p1.m10" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S1.p13" class="ltx_para">
<p id="S1.p13.1" class="ltx_p"><span id="S1.p13.1.1" class="ltx_text">We just prove the first statement for the Hodge conjecture. The proof of the second statement is almost identical.
Suppose that we know that <math id="S1.p13.m1" class="ltx_Math" alttext="\Box^{p,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{p,i}</annotation></semantics></math> is surjective for all
<math id="S1.p13.m2" class="ltx_Math" alttext="(p,i)\in P" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">(p,i)\in P</annotation></semantics></math>.
By lemma <a href="#S1.Thmlemma1" title="Lemma 1.1. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>, <math id="S1.p13.m3" class="ltx_Math" alttext="\Hodge" display="inline" intent=":literal"><semantics><mo>Hodge</mo><annotation encoding="application/x-tex">\Hodge</annotation></semantics></math> is exact, so
we have a noncanonical isomorphism</span></p>
<table id="S1.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(1.2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E2.m1" class="ltx_Math" alttext="\begin{split}\Hodge(H^{2p}(V,{\mathbb{Q}})(p))&amp;=\bigoplus_{i}\Hodge(Gr^{i}_{L}(H^{2p}(V,{\mathbb{Q}})(p)))\\
&amp;=\bigoplus_{i}\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))\\
&amp;=\bigoplus_{i}\im Gr_{L}^{i}CH^{p}(V)\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mi>i</mi></munder><mrow><mo lspace="0em" rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mi>i</mi></munder><mrow><mo lspace="0em" rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.111em">=</mo><mo movablelimits="false">⨁</mo><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">im</mo><mi>G</mi><mi>r</mi><msub><mrow></mrow><mi>L</mi></msub><msup><mrow></mrow><mi>i</mi></msup><mi>C</mi><mi>H</mi><msup><mrow></mrow><mi>p</mi></msup><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\Hodge(H^{2p}(V,{\mathbb{Q}})(p))&amp;=\bigoplus_{i}\Hodge(Gr^{i}_{L}(H^{2p}(V,{\mathbb{Q}})(p)))\\
&amp;=\bigoplus_{i}\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))\\
&amp;=\bigoplus_{i}\im Gr_{L}^{i}CH^{p}(V)\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p13.2" class="ltx_p"><span id="S1.p13.2.1" class="ltx_text">This implies that the Hodge conjecture holds for <math id="S1.p13.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>.</span></p>
</div>
<div id="S1.p14" class="ltx_para">
<p id="S1.p14.1" class="ltx_p"><span id="S1.p14.1.1" class="ltx_text">It remains to show that surjectivity of <math id="S1.p14.m1" class="ltx_Math" alttext="\Box^{p,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{p,i}</annotation></semantics></math> for <math id="S1.p14.m2" class="ltx_Math" alttext="(p,i)\in Q" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">(p,i)\in Q</annotation></semantics></math> implies surjectivity for all points in <math id="S1.p14.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>. We do this in two steps. We
first assume <math id="S1.p14.m4" class="ltx_Math" alttext="2p-i\leq r" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow><mo>≤</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">2p-i\leq r</annotation></semantics></math>, and then we show that the condition of surjectivity of <math id="S1.p14.m5" class="ltx_Math" alttext="\Box^{p,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{p,i}</annotation></semantics></math> is
stable under the reflection <math id="S1.p14.m6" class="ltx_Math" alttext="(p,i)\mapsto(q,i)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(p,i)\mapsto(q,i)</annotation></semantics></math>, where <math id="S1.p14.m7" class="ltx_Math" alttext="q=r+i-p" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mrow><mi>r</mi><mo>+</mo><mi>i</mi></mrow><mo>−</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">q=r+i-p</annotation></semantics></math>.
Let <math id="S1.p14.m8" class="ltx_Math" alttext="{\mathcal{O}}_{Y}(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>Y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{Y}(1)</annotation></semantics></math> and <math id="S1.p14.m9" class="ltx_Math" alttext="{\mathcal{O}}_{X}(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{X}(1)</annotation></semantics></math> be ample divisors on <math id="S1.p14.m10" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> and
<math id="S1.p14.m11" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> respectively. Cup product with <math id="S1.p14.m12" class="ltx_Math" alttext="c_{1}({\mathcal{O}}_{X}(1))^{r-2p+i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>r</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo>+</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">c_{1}({\mathcal{O}}_{X}(1))^{r-2p+i}</annotation></semantics></math> induces an
isomorphism of local systems</span></p>
<table id="S1.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex26.m1" class="ltx_Math" alttext="\xi:R^{2p-i}f_{*}{\mathbb{Q}}\stackrel{{\scriptstyle\sim}}{{\to}}R^{2q-i}f_{*}{\mathbb{Q}}" display="block" intent=":literal"><semantics><mrow><mi>ξ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mover><mo stretchy="false">→</mo><mo>∼</mo></mover><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi:R^{2p-i}f_{*}{\mathbb{Q}}\stackrel{{\scriptstyle\sim}}{{\to}}R^{2q-i}f_{*}{\mathbb{Q}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p14.2" class="ltx_p"><span id="S1.p14.2.1" class="ltx_text">Together with lemma <a href="#S1.Thmlemma3" title="Lemma 1.3. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.3</span></a>, this gives rise to a commutative diagram</span></p>
<table id="S1.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
