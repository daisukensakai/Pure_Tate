(U_{\lambda},S^{2p-1}L)\otimes\Omega^{1}_{\lambda}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 182.05116180128553 -11.069600110696001 L 182.60463336138568 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(182.33,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 182.05116180128553 -33.20877921850137 L 182.60463336138568 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 182.05116180128553 -33.20877921850137 L 182.60463336138568 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(-49.19,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.51em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="90.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex19.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{Gr_{F}^{1}H^{1}(U_{\lambda},L)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>λ</mi></msub><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{Gr_{F}^{1}H^{1}(U_{\lambda},L)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 49.19039191951622 -45.44072450073293 L 49.19039191951622 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(76.77,0) translate(0,-37.52) translate(4.15,0) translate(0,-0.68)"><foreignObject style="--ltx-fo-width:1.48em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.2em;font-size:10pt;" height="6.98" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="20.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex19.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\kappa_{1,\lambda}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">κ</mi><mrow><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">λ</mi></mrow></msub><annotation encoding="application/x-tex">\scriptstyle{\kappa_{1,\lambda}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(116.06,0) translate(0,-45.16)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 49.19039191951622 -45.44072450073293 L 116.0575008431922 -44.887252940632784" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 116.0575008431922 -45.44072450073293 L 116.0575008431922 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(116.06,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.98em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="124.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex19.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{Gr_{F}^{0}H^{1}(U_{\lambda},L)\otimes\Omega^{1}_{\lambda}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>λ</mi></msub><mo>,</mo><mi>L</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>λ</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{Gr_{F}^{0}H^{1}(U_{\lambda},L)\otimes\Omega^{1}_{\lambda}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p12.5" class="ltx_p"><span id="S2.p12.5.1" class="ltx_text">It follows that injectivity of <math id="S2.p12.m2" class="ltx_Math" alttext="\kappa_{1,\lambda}(L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mrow><mn>1</mn><mo>,</mo><mi>λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{1,\lambda}(L)</annotation></semantics></math> on the bottom implies
injectivity of <math id="S2.p12.m3" class="ltx_Math" alttext="\kappa_{p,\lambda}(S^{2p-1}L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mrow><mi>p</mi><mo>,</mo><mi>λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{p,\lambda}(S^{2p-1}L)</annotation></semantics></math> on the top.
∎</span></p>
</div>
</div>
<div id="S2.p13" class="ltx_para">
<p id="S2.p13.1" class="ltx_p">Following standard usage, let us say that a point of <math id="S2.p13.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is very general,
if it lies outside a countable union of proper analytic subvarieties.</p>
</div>
<div id="S2.Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmlemma3.1" class="ltx_text ltx_font_bold">Lemma 2.3</span></span><span id="S2.Thmlemma3.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmlemma3.p1" class="ltx_para">
<p id="S2.Thmlemma3.p1.1" class="ltx_p"><span id="S2.Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="S2.Thmlemma3.p1.m1" class="ltx_Math" alttext="(\mathcal{L},V,\ldots)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{L},V,\ldots)</annotation></semantics></math> is an admissible rational variation of mixed Hodge structure over <math id="S2.Thmlemma3.p1.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>
such that for a very general point <math id="S2.Thmlemma3.p1.m3" class="ltx_Math" alttext="\lambda\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\Lambda</annotation></semantics></math>, the Kodaira-Spencer map</span></p>
<table id="S2.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex20.m1" class="ltx_Math" alttext="K=\kappa_{p,\lambda}(V):Gr_{F}^{p}V_{\lambda}\to Gr_{F}^{p-1}V_{\lambda}\otimes\Omega^{1}_{\lambda}" display="block" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><msub><mi>κ</mi><mrow><mi>p</mi><mo>,</mo><mi>λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>λ</mi></msub></mrow><mo stretchy="false">→</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>λ</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>λ</mi><mn>1</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">K=\kappa_{p,\lambda}(V):Gr_{F}^{p}V_{\lambda}\to Gr_{F}^{p-1}V_{\lambda}\otimes\Omega^{1}_{\lambda}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.Thmlemma3.p1.2" class="ltx_p"><span id="S2.Thmlemma3.p1.2.1" class="ltx_text ltx_font_italic">is injective. Then <math id="S2.Thmlemma3.p1.m4" class="ltx_Math" alttext="V_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">V_{\lambda}</annotation></semantics></math> has no nonzero Hodge cycles of weight <math id="S2.Thmlemma3.p1.m5" class="ltx_Math" alttext="2p" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">2p</annotation></semantics></math> for very general <math id="S2.Thmlemma3.p1.m6" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p14" class="ltx_para">
<p id="S2.p14.1" class="ltx_p"><span id="S2.p14.1.1" class="ltx_text">We can replace <math id="S2.p14.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> by <math id="S2.p14.m2" class="ltx_Math" alttext="Gr_{2p}^{W}V" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">Gr_{2p}^{W}V</annotation></semantics></math> and assume <math id="S2.p14.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is pure of weight <math id="S2.p14.m4" class="ltx_Math" alttext="2p" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">2p</annotation></semantics></math>.
Fix <math id="S2.p14.m5" class="ltx_Math" alttext="\lambda_{0}\in\Lambda" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>0</mn></msub><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\lambda_{0}\in\Lambda</annotation></semantics></math>, and replace <math id="S2.p14.m6" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> by a contractible open neighbourhood of <math id="S2.p14.m7" class="ltx_Math" alttext="\lambda_{0}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\lambda_{0}</annotation></semantics></math>.
Then (the restriction of) <math id="S2.p14.m8" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> is a constant sheaf of <math id="S2.p14.m9" class="ltx_Math" alttext="{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">{\mathbb{Q}}</annotation></semantics></math>-vector spaces. Therefore given <math id="S2.p14.m10" class="ltx_Math" alttext="\gamma\in\mathcal{L}_{\lambda_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mi>λ</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathcal{L}_{\lambda_{0}}</annotation></semantics></math>, it
extends to section of <math id="S2.p14.m11" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> (denoted by the same symbol) over <math id="S2.p14.m12" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>.
As <math id="S2.p14.m13" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> varies, <math id="S2.p14.m14" class="ltx_Math" alttext="F^{p}V_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msup><mi>F</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">F^{p}V_{\lambda}</annotation></semantics></math> varies holomorphically. Therefore
the locus</span></p>
<table id="S2.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex21.m1" class="ltx_math_unparsed" alttext="NL_{\gamma}=\{\lambda\in\Lambda\mid\gamma_{\lambda}\text{ is a
Hodge cycle}\}" display="block" intent=":literal"><semantics><mrow><mi>N</mi><msub><mi>L</mi><mi>γ</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>γ</mi><mi>λ</mi></msub><mtext> is a
Hodge cycle</mtext><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">NL_{\gamma}=\{\lambda\in\Lambda\mid\gamma_{\lambda}\text{ is a
Hodge cycle}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p14.2" class="ltx_p"><span id="S2.p14.2.1" class="ltx_text">is an analytic subvariety of <math id="S2.p14.m15" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>. Suppose that <math id="S2.p14.m16" class="ltx_Math" alttext="NL_{\gamma}=\Lambda" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>γ</mi></msub></mrow><mo>=</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">NL_{\gamma}=\Lambda</annotation></semantics></math> for some
<math id="S2.p14.m17" class="ltx_Math" alttext="\gamma\not=0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma\not=0</annotation></semantics></math>.
Then</span></p>
<table id="S2.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex22.m1" class="ltx_Math" alttext="K(\gamma)=\nabla(\gamma)\mod F^{p}=0" display="block" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>∇</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>mod</mo><msup><mi>F</mi><mi>p</mi></msup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">K(\gamma)=\nabla(\gamma)\mod F^{p}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p14.3" class="ltx_p"><span id="S2.p14.3.1" class="ltx_text">This contradicts the hypothesis of the lemma. Therefore <math id="S2.p14.m18" class="ltx_Math" alttext="NL_{\gamma}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>γ</mi></msub></mrow><annotation encoding="application/x-tex">NL_{\gamma}</annotation></semantics></math> is a proper subvariety.
Consequently a very general point lies in the complement of <math id="S2.p14.m19" class="ltx_Math" alttext="\bigcup_{\gamma\in\mathcal{L}_{\gamma_{0}}}NL_{\gamma}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⋃</mo><mrow><mi>γ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mi>γ</mi><mn>0</mn></msub></msub></mrow></msub><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>γ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\bigcup_{\gamma\in\mathcal{L}_{\gamma_{0}}}NL_{\gamma}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.p15" class="ltx_para">
<p id="S2.p15.1" class="ltx_p"><span id="S2.p15.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S2.Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmlemma4.1" class="ltx_text ltx_font_bold">Lemma 2.4</span></span><span id="S2.Thmlemma4.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmlemma4.p1" class="ltx_para">
<p id="S2.Thmlemma4.p1.1" class="ltx_p"><span id="S2.Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="S2.Thmlemma4.p1.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, the cycle map</span></p>
<table id="S2.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex23.m1" class="ltx_math_unparsed" alttext="\Box^{p,0}:Gr^{0}_{L}CH^{p}(V_{\lambda})\to H^{0}(U,R^{2p}F_{\lambda*}{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mn>0</mn></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>G</mi><msubsup><mi>r</mi><mi>L</mi><mn>0</mn></msubsup><mi>C</mi><msup><mi>H</mi><mi>p</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><msup><mi>R</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><msub><mi>F</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Box^{p,0}:Gr^{0}_{L}CH^{p}(V_{\lambda})\to H^{0}(U,R^{2p}F_{\lambda*}{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.Thmlemma4.p1.2" class="ltx_p"><span id="S2.Thmlemma4.p1.2.1" class="ltx_text ltx_font_italic">is surjective.</span></p>
</div>
</div>
<div id="S2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p16" class="ltx_para">
<p id="S2.p16.1" class="ltx_p"><span id="S2.p16.1.1" class="ltx_text">We will suppress <math id="S2.p16.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> in the argument below.
Let us write <math id="S2.p16.m2" class="ltx_Math" alttext="L={\mathbb{Q}}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><msup><mi>ℚ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">L={\mathbb{Q}}^{2}</annotation></semantics></math> with the standard action of <math id="S2.p16.m3" class="ltx_Math" alttext="SL_{2}({\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">SL_{2}({\mathbb{Q}})</annotation></semantics></math>. The
local system <math id="S2.p16.m4" class="ltx_Math" alttext="R^{1}f_{*}{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">R^{1}f_{*}{\mathbb{Q}}</annotation></semantics></math> can be identified with <math id="S2.p16.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, with monodromy
given by a homomorphism <math id="S2.p16.m6" class="ltx_Math" alttext="\mu:\pi_{1}(U)\to SL_{2}({\mathbb{Z}})\subset SL_{2}({\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu:\pi_{1}(U)\to SL_{2}({\mathbb{Z}})\subset SL_{2}({\mathbb{Q}})</annotation></semantics></math>. Non-isotriviality
implies that <math id="S2.p16.m7" class="ltx_Math" alttext="\im\mu" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">im</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">\im\mu</annotation></semantics></math> is Zariski dense. The Künneth formula, allows us
to identify</span></p>
<table id="S2.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.12)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E12.m1" class="ltx_Math" alttext="R^{k}F_{*}{\mathbb{Q}}=\bigoplus_{i_{1}+\ldots i_{n}=k}R^{i_{1}}f_{*}{\mathbb{Q}}\otimes\ldots\otimes R^{i_{n}}f_{*}{\mathbb{Q}}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mrow><msub><mi>i</mi><mn>1</mn></msub><mo>+</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mi>n</mi></msub></mrow></mrow><mo>=</mo><mi>k</mi></mrow></munder><mrow><mrow><msup><mi>R</mi><msub><mi>i</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><msup><mi>R</mi><msub><mi>i</mi><mi>n</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{k}F_{*}{\mathbb{Q}}=\bigoplus_{i_{1}+\ldots i_{n}=k}R^{i_{1}}f_{*}{\mathbb{Q}}\otimes\ldots\otimes R^{i_{n}}f_{*}{\mathbb{Q}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p16.2" class="ltx_p"><span id="S2.p16.2.1" class="ltx_text">Let us start with the case of <math id="S2.p16.m8" class="ltx_Math" alttext="n=k=2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mi>k</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n=k=2</annotation></semantics></math>. Then the decomposition becomes</span></p>
<table id="S2.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex24.m1" class="ltx_Math" alttext="R^{2}F_{*}{\mathbb{Q}}=L^{\otimes 2}\oplus(f_{*}{\mathbb{Q}}\otimes R^{2}f_{*}{\mathbb{Q}})\oplus(R^{2}f_{*}{\mathbb{Q}}\otimes f_{*}{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo>=</mo><mrow><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msup><mo>⊕</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊕</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>f</mi><mo>∗</mo></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{2}F_{*}{\mathbb{Q}}=L^{\otimes 2}\oplus(f_{*}{\mathbb{Q}}\otimes R^{2}f_{*}{\mathbb{Q}})\oplus(R^{2}f_{*}{\mathbb{Q}}\otimes f_{*}{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p16.3" class="ltx_p"><span id="S2.p16.3.1" class="ltx_text">So</span></p>
<table id="S2.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex25.m1" class="ltx_Math" alttext="H^{0}(U,R^{2}F_{*}{\mathbb{Q}})=H^{0}(L^{\otimes 2})\oplus H^{0}(f_{*}{\mathbb{Q}}\otimes R^{2}f_{*}{\mathbb{Q}})\oplus H^{0}(R^{2}f_{*}{\mathbb{Q}}\otimes f_{*}{\mathbb{Q}})\cong{\mathbb{Q}}^{3}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>f</mi><mo>∗</mo></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≅</mo><msup><mi>ℚ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">H^{0}(U,R^{2}F_{*}{\mathbb{Q}})=H^{0}(L^{\otimes 2})\oplus H^{0}(f_{*}{\mathbb{Q}}\otimes R^{2}f_{*}{\mathbb{Q}})\oplus H^{0}(R^{2}f_{*}{\mathbb{Q}}\otimes f_{*}{\mathbb{Q}})\cong{\mathbb{Q}}^{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p16.4" class="ltx_p"><span id="S2.p16.4.1" class="ltx_text">Let <math id="S2.p16.m9" class="ltx_Math" alttext="D\subset{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊂</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">D\subset{\mathcal{E}}</annotation></semantics></math> denote a section of <math id="S2.p16.m10" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, and let <math id="S2.p16.m11" class="ltx_Math" alttext="\Delta\subset{\mathcal{E}}\times_{Y}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⊂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Y</mi></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">\Delta\subset{\mathcal{E}}\times_{Y}{\mathcal{E}}</annotation></semantics></math> the image of <math id="S2.p16.m12" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math>
under the diagonal embedding.
Since <math id="S2.p16.m13" class="ltx_Math" alttext="[\Delta],p_{2}^{*}[D],p_{1}^{*}[D]\in H^{0}(R^{2}F_{*}{\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><msubsup><mi>p</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>D</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mrow><msubsup><mi>p</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>D</mi><mo stretchy="false">]</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">[\Delta],p_{2}^{*}[D],p_{1}^{*}[D]\in H^{0}(R^{2}F_{*}{\mathbb{Q}})</annotation></semantics></math> are easily seen to be linearly
independent, they necessarily span this space. A linear combination of these
classes give a generator</span></p>
<table id="S2.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.13)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E13.m1" class="ltx_math_unparsed" alttext="\Delta_{0}=[\Delta]-p_{1}^{*}[D]-p_{2}^{*}[D]\in H^{0}(L^{\otimes 2})=H^{0}(\wedge^{2}L)\cong{\mathbb{Q}}" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><msubsup><mi>p</mi><mn>1</mn><mo>∗</mo></msubsup><mrow><mo stretchy="false">[</mo><mi>D</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><msubsup><mi>p</mi><mn>2</mn><mo>∗</mo></msubsup><mrow><mo stretchy="false">[</mo><mi>D</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><msup><mo lspace="0em">∧</mo><mn>2</mn></msup><mi>L</mi><mo stretchy="false">)</mo></mrow><mo>≅</mo><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">\Delta_{0}=[\Delta]-p_{1}^{*}[D]-p_{2}^{*}[D]\in H^{0}(L^{\otimes 2})=H^{0}(\wedge^{2}L)\cong{\mathbb{Q}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.p17" class="ltx_para">
<p id="S2.p17.1" class="ltx_p"><span id="S2.p17.1.1" class="ltx_text">We now turn to the general case. Let <math id="S2.p17.m1" class="ltx_Math" alttext="p_{i}:T\to{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>T</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">p_{i}:T\to{\mathcal{E}}</annotation></semantics></math>, and <math id="S2.p17.m2" class="ltx_Math" alttext="p_{ij}:T\to{\mathcal{E}}\times_{Y}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>T</mi><mo stretchy="false">→</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Y</mi></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{ij}:T\to{\mathcal{E}}\times_{Y}{\mathcal{E}}</annotation></semantics></math> also denote the projections
onto the <math id="S2.p17.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th and <math id="S2.p17.m4" class="ltx_Math" alttext="ij" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">ij</annotation></semantics></math>th factors.
When <math id="S2.p17.m5" class="ltx_Math" alttext="k=2p" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">k=2p</annotation></semantics></math>, equation (<a href="#S2.E12" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.12</span></a>) can be written as</span></p>
<table id="S2.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex26.m1" class="ltx_Math" alttext="R^{2p}F_{*}{\mathbb{Q}}=\bigoplus_{q\leq p}\bigoplus_{\sigma}\sigma((f_{*}{\mathbb{Q}})^{\otimes n-2q-(p-q)}\otimes L^{\otimes 2q}\otimes(R^{2}f_{*}{\mathbb{Q}})^{\otimes(p-q)})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">⨁</mo><mrow><mi>q</mi><mo>≤</mo><mi>p</mi></mrow></munder><mrow><munder><mo movablelimits="false">⨁</mo><mi>σ</mi></munder><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mi>n</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo rspace="0.222em">⊗</mo><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{2p}F_{*}{\mathbb{Q}}=\bigoplus_{q\leq p}\bigoplus_{\sigma}\sigma((f_{*}{\mathbb{Q}})^{\otimes n-2q-(p-q)}\otimes L^{\otimes 2q}\otimes(R^{2}f_{*}{\mathbb{Q}})^{\otimes(p-q)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p17.2" class="ltx_p"><span id="S2.p17.2.1" class="ltx_text">where <math id="S2.p17.m6" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> runs over a suitable set of permutations depending on <math id="S2.p17.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>.
It follows that</span></p>
<table id="S2.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.14)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E14.m1" class="ltx_Math" alttext="H^{0}(U,R^{2p}F_{*}{\mathbb{Q}})=\bigoplus_{q}\bigoplus_{\sigma}H^{0}(U,L^{\otimes 2q})\otimes H^{0}(U,R^{2}f_{*}{\mathbb{Q}})^{\otimes(p-q)}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><mrow><munder><mo movablelimits="false" rspace="0em">⨁</mo><mi>q</mi></munder><mrow><munder><mo movablelimits="false">⨁</mo><mi>σ</mi></munder><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>H</mi><mn>0</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">H^{0}(U,R^{2p}F_{*}{\mathbb{Q}})=\bigoplus_{q}\bigoplus_{\sigma}H^{0}(U,L^{\otimes 2q})\otimes H^{0}(U,R^{2}f_{*}{\mathbb{Q}})^{\otimes(p-q)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p17.3" class="ltx_p"><span id="S2.p17.3.1" class="ltx_text">Invariant theory <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx14" title="" class="ltx_ref">FH</a>, prop F.13]</cite> tells us that <math id="S2.p17.m8" class="ltx_Math" alttext="H^{0}(L^{\otimes 2q})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}(L^{\otimes 2q})</annotation></semantics></math>
is generated by products of pullbacks of classes from
<math id="S2.p17.m9" class="ltx_Math" alttext="H^{0}(L^{\otimes 2})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}(L^{\otimes 2})</annotation></semantics></math> under various projections <math id="S2.p17.m10" class="ltx_Math" alttext="p_{ij}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">p_{ij}</annotation></semantics></math>. This means
that <math id="S2.p17.m11" class="ltx_Math" alttext="H^{0}(U,L^{\otimes 2p})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}(U,L^{\otimes 2p})</annotation></semantics></math> is spanned by products of
<math id="S2.p17.m12" class="ltx_Math" alttext="p_{ij}^{*}\Delta_{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">p_{ij}^{*}\Delta_{0}</annotation></semantics></math>.
Therefore the summands on the right of (<a href="#S2.E14" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.14</span></a>)
are generated by classes of the form <math id="S2.p17.m13" class="ltx_Math" alttext="p_{ij}^{*}\Delta_{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">p_{ij}^{*}\Delta_{0}</annotation></semantics></math> and <math id="S2.p17.m14" class="ltx_Math" alttext="p_{k}^{*}D" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>k</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">p_{k}^{*}D</annotation></semantics></math>.
This proves that <math id="S2.p17.m15" class="ltx_Math" alttext="H^{0}(U,R^{2p}F_{*}{\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}(U,R^{2p}F_{*}{\mathbb{Q}})</annotation></semantics></math> is spanned by algebraic cycles.</span></p>
</div>
<div id="S2.p18" class="ltx_para">
<p id="S2.p18.1" class="ltx_p"><span id="S2.p18.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S2.Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmlemma5.1" class="ltx_text ltx_font_bold">Lemma 2.5</span></span><span id="S2.Thmlemma5.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmlemma5.p1" class="ltx_para">
<p id="S2.Thmlemma5.p1.1" class="ltx_p"><span id="S2.Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">For very general <math id="S2.Thmlemma5.p1.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>,</span></p>
<table id="S2.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex27.m1" class="ltx_math_unparsed" alttext="\Hodge(H^{1}(U_{\lambda},R^{2p-1}F_{\lambda*}{\mathbb{C}})(p))=0" display="block" intent=":literal"><semantics><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>λ</mi></msub><mo>,</mo><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>F</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℂ</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Hodge(H^{1}(U_{\lambda},R^{2p-1}F_{\lambda*}{\mathbb{C}})(p))=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p19" class="ltx_para">
<p id="S2.p19.1" class="ltx_p"><span id="S2.p19.1.1" class="ltx_text">We will suppress <math id="S2.p19.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> again.
We can view <math id="S2.p19.m2" class="ltx_Math" alttext="GL_{2}({\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">GL_{2}({\mathbb{Q}})</annotation></semantics></math> as the (big) Mumford-Tate group of the
variation of Hodge structure <math id="S2.p19.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, or equivalently of a very
general fibre of <math id="S2.p19.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. We have that <math id="S2.p19.m5" class="ltx_Math" alttext="S^{n}L(i)=S^{n}L\otimes(\det L)^{-i}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>S</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>S</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">det</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">S^{n}L(i)=S^{n}L\otimes(\det L)^{-i}</annotation></semantics></math> is also a <math id="S2.p19.m6" class="ltx_Math" alttext="GL_{2}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">GL_{2}</annotation></semantics></math>-module. We can decompose</span></p>
<table id="S2.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.15)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E15.m1" class="ltx_Math" alttext="L^{\otimes 2p-1}=S^{2p-1}L\oplus S^{2p-3}L(-1)^{\oplus m_{1}}\oplus\ldots" display="block" intent=":literal"><semantics><mrow><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>=</mo><mrow><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>⊕</mo><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></msup></mrow><mo>⊕</mo><mi mathvariant="normal">…</mi></mrow></mrow><annotation encoding="application/x-tex">L^{\otimes 2p-1}=S^{2p-1}L\oplus S^{2p-3}L(-1)^{\oplus m_{1}}\oplus\ldots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p19.2" class="ltx_p"><span id="S2.p19.2.1" class="ltx_text">into a sum of irreducible <math id="S2.p19.m7" class="ltx_Math" alttext="GL_{2}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">GL_{2}</annotation></semantics></math>-modules. Lemmas
<a href="#S2.Thmlemma2" title="Lemma 2.2. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a> and <a href="#S2.Thmlemma3" title="Lemma 2.3. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> shows
that</span></p>
<table id="S2.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex28.m1" class="ltx_Math" alttext="\begin{split}\Hodge(H^{1}(S^{2p-1}L)(p))&amp;=0\\
\Hodge(H^{1}(S^{2p-3}L(p-1))&amp;=0\\
\ldots&amp;\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mi mathvariant="normal">…</mi></mtd><mtd></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\Hodge(H^{1}(S^{2p-1}L)(p))&amp;=0\\
\Hodge(H^{1}(S^{2p-3}L(p-1))&amp;=0\\
\ldots&amp;\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.p20" class="ltx_para">
<p id="S2.p20.1" class="ltx_p"><span id="S2.p20.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S2.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of theorem <a href="#S2.Thmthm1" title="Theorem 2.1. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>.</h6>
<div id="S2.p21" class="ltx_para">
<p id="S2.p21.1" class="ltx_p"><span id="S2.p21.1.1" class="ltx_text">Choose <math id="S2.p21.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> very general.
Since <math id="S2.p21.m2" class="ltx_Math" alttext="f_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">f_{\lambda}</annotation></semantics></math> is nonisotrivial, <math id="S2.p21.m3" class="ltx_Math" alttext="U_{\lambda}\subsetneqq Y_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>λ</mi></msub><mo>⫋</mo><msub><mi>Y</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">U_{\lambda}\subsetneqq Y_{\lambda}</annotation></semantics></math>. Therefore <math id="S2.p21.m4" class="ltx_math_unparsed" alttext="H^{i}(U_{\lambda},R^{j}f_{\lambda*}{\mathbb{Q}})=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>λ</mi></msub><mo>,</mo><msup><mi>R</mi><mi>j</mi></msup><msub><mi>f</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{i}(U_{\lambda},R^{j}f_{\lambda*}{\mathbb{Q}})=0</annotation></semantics></math> when <math id="S2.p21.m5" class="ltx_Math" alttext="i&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i&gt;1</annotation></semantics></math>.
The theorem is now a consequence of
theorem <a href="#S1.Thmthm2" title="Theorem 1.2. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a>, and lemmas <a href="#S1.Thmlemma2" title="Lemma 1.2. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a>,
<a href="#S2.Thmlemma4" title="Lemma 2.4. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a> and <a href="#S2.Thmlemma5" title="Lemma 2.5. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>.
∎</span></p>
</div>
</div>
<div id="S2.p22" class="ltx_para">
<p id="S2.p22.1" class="ltx_p">We will now discuss a few corollaries.</p>
</div>
<div id="S2.Thmthm2" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmthm2.1" class="ltx_text ltx_font_bold">Corollary 2.2</span></span><span id="S2.Thmthm2.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmthm2.p1" class="ltx_para">
<p id="S2.Thmthm2.p1.1" class="ltx_p"><span id="S2.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S2.Thmthm2.p1.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is very general, the Hodge conjecture holds for any desingularization of <math id="S2.Thmthm2.p1.m2" class="ltx_math_unparsed" alttext="{\mathcal{E}}_{\lambda}\times_{Y}{\mathcal{E}}_{\lambda}\times_{Y}{\mathcal{E}}_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><mi>Y</mi></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><mi>Y</mi></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{\lambda}\times_{Y}{\mathcal{E}}_{\lambda}\times_{Y}{\mathcal{E}}_{\lambda}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p23" class="ltx_para">
<p id="S2.p23.1" class="ltx_p"><span id="S2.p23.1.1" class="ltx_text">This follows from the theorem, remark <a href="#S1.Thmthm3" title="Remark 1.3. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.3</span></a>, and corollary <a href="#S1.Thmthm4" title="Corollary 1.4. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a>.
∎</span></p>
</div>
</div>
<div id="S2.p24" class="ltx_para">
<p id="S2.p24.1" class="ltx_p">Now, let us assume that
<math id="S2.p24.m1" class="ltx_Math" alttext="\Lambda=\{\lambda\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>λ</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Lambda=\{\lambda\}</annotation></semantics></math>
is a point. Then <math id="S2.p24.m2" class="ltx_Math" alttext="f:{\mathcal{E}}\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:{\mathcal{E}}\to Y</annotation></semantics></math> is an elliptic surface.
In this case, the assumption that <math id="S2.p24.m3" class="ltx_Math" alttext="\kappa_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\kappa_{\lambda}</annotation></semantics></math> is
injective is equivalent to</p>
<table id="S2.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex29.m1" class="ltx_Math" alttext="Gr^{1}_{F}H^{1}(U,R^{1}f_{*}{\mathbb{C}})=0" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Gr^{1}_{F}H^{1}(U,R^{1}f_{*}{\mathbb{C}})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p24.2" class="ltx_p">This condition occurs in the literature in a different form.
An elliptic surface <math id="S2.p24.m4" class="ltx_Math" alttext="f:{\mathcal{E}}\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:{\mathcal{E}}\to Y</annotation></semantics></math> is said to be extremal (c.f. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Mr</a>, p 75]</cite>) if the Picard number <math id="S2.p24.m5" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>
equals the Hodge number <math id="S2.p24.m6" class="ltx_Math" alttext="h^{11}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mn>11</mn></msup><annotation encoding="application/x-tex">h^{11}</annotation></semantics></math>, and the Mordell-Weil group <math id="S2.p24.m7" class="ltx_Math" alttext="MW({\mathcal{E}}/Y)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>/</mo><mi>Y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">MW({\mathcal{E}}/Y)</annotation></semantics></math>
(which is the group of sections) has rank <math id="S2.p24.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.</p>
</div>
<div id="S2.Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmlemma6.1" class="ltx_text ltx_font_bold">Lemma 2.6</span></span><span id="S2.Thmlemma6.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmlemma6.p1" class="ltx_para">
<p id="S2.Thmlemma6.p1.1" class="ltx_p"><span id="S2.Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">We have</span></p>
<table id="S2.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.16)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E16.m1" class="ltx_math_unparsed" alttext="\dim Gr^{1}_{F}H^{1}(U,R^{1}f_{*}{\mathbb{C}})=h^{11}(X)-\rho(X)+\rank MW({\mathcal{E}}/Y)" display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">dim</mo><mi>G</mi><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><msup><mi>R</mi><mn>1</mn></msup><msub><mi>f</mi><mo>∗</mo></msub><mi>ℂ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>h</mi><mn>11</mn></msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ρ</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mo lspace="0em" rspace="0.167em">rank</mo><mi>M</mi><mi>W</mi><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>/</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\dim Gr^{1}_{F}H^{1}(U,R^{1}f_{*}{\mathbb{C}})=h^{11}(X)-\rho(X)+\rank MW({\mathcal{E}}/Y)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.Thmlemma6.p1.2" class="ltx_p"><span id="S2.Thmlemma6.p1.2.1" class="ltx_text ltx_font_italic">The surface is extremal if and only if</span></p>
<table id="S2.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex30.m1" class="ltx_Math" alttext="Gr^{1}_{F}H^{1}(U,R^{1}f_{*}{\mathbb{C}})=0" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Gr^{1}_{F}H^{1}(U,R^{1}f_{*}{\mathbb{C}})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.8" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p25" class="ltx_para">
<p id="S2.p25.1" class="ltx_p"><span id="S2.p25.1.1" class="ltx_text">By Saito’s version of the
decomposition theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">Sa1</a>, p 857]</cite>, we can decompose <math id="S2.p25.m1" class="ltx_Math" alttext="{\mathbb{R}}f_{*}{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">{\mathbb{R}}f_{*}{\mathbb{Q}}</annotation></semantics></math>
as a sum of intersection cohomology complexes up to shift in the
constructible derived category, and moreover these complexes underly
pure Hodge modules.
By restricting this sum to <math id="S2.p25.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, we can identify some of
these components explicitly:</span></p>
<table id="S2.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.17)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E17.m1" class="ltx_Math" alttext="{\mathbb{R}}f_{*}{\mathbb{Q}}\cong\underbrace{{\mathbb{Q}}}_{f_{*}{\mathbb{Q}}}\oplus j_{*}j^{*}R^{1}f_{*}{\mathbb{Q}}[-1]\oplus\underbrace{{\mathbb{Q}}}_{j_{*}j^{*}R^{2}f_{*}{\mathbb{Q}}}[-2]\oplus M" display="block" intent=":literal"><semantics><mrow><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo>≅</mo><mrow><munder><munder accentunder="true"><mi>ℚ</mi><mo stretchy="true">⏟</mo></munder><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow></munder><mo>⊕</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>⊕</mo><mrow><munder><munder accentunder="true"><mi>ℚ</mi><mo stretchy="true">⏟</mo></munder><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>⊕</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}f_{*}{\mathbb{Q}}\cong\underbrace{{\mathbb{Q}}}_{f_{*}{\mathbb{Q}}}\oplus j_{*}j^{*}R^{1}f_{*}{\mathbb{Q}}[-1]\oplus\underbrace{{\mathbb{Q}}}_{j_{*}j^{*}R^{2}f_{*}{\mathbb{Q}}}[-2]\oplus M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p25.2" class="ltx_p"><span id="S2.p25.2.1" class="ltx_text">The, as yet undetermined, term <math id="S2.p25.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is supported on the finite set <math id="S2.p25.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.
This yields a (noncanonical) decomposition</span></p>
<table id="S2.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.18)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E18.m1" class="ltx_Math" alttext="H^{2}(X,{\mathbb{Q}})\cong f^{*}H^{2}(Y,{\mathbb{Q}})\oplus IH^{1}(R^{1}f_{*}{\mathbb{Q}})\oplus H^{0}(Y,j_{*}j^{*}R^{2}f_{*}{\mathbb{Q}})\oplus H^{2}(M)" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{2}(X,{\mathbb{Q}})\cong f^{*}H^{2}(Y,{\mathbb{Q}})\oplus IH^{1}(R^{1}f_{*}{\mathbb{Q}})\oplus H^{0}(Y,j_{*}j^{*}R^{2}f_{*}{\mathbb{Q}})\oplus H^{2}(M)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p25.3" class="ltx_p"><span id="S2.p25.3.1" class="ltx_text">The first summand on the
right is spanned by the fundamental class <math id="S2.p25.m5" class="ltx_Math" alttext="[X_{t}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[X_{t}]</annotation></semantics></math> of a fibre. The
third summand is spanned by the class <math id="S2.p25.m6" class="ltx_Math" alttext="[\sigma]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>σ</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\sigma]</annotation></semantics></math>.
To calculate <math id="S2.p25.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, we restrict to a point <math id="S2.p25.m8" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math>, and observe that <math id="S2.p25.m9" class="ltx_Math" alttext="H^{*}({\mathbb{R}}f_{*}{\mathbb{Q}}|_{s})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">|</mo></mrow><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}({\mathbb{R}}f_{*}{\mathbb{Q}}|_{s})</annotation></semantics></math> is the cohomology of the fibre <math id="S2.p25.m10" class="ltx_Math" alttext="X_{s}=f^{-1}(s)" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>s</mi></msub><mo>=</mo><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{s}=f^{-1}(s)</annotation></semantics></math> by proper
base change <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">Di</a>, p 41]</cite>. Therefore <math id="S2.p25.m11" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>
gives the excess cohomology not coming from the preceding terms in (<a href="#S2.E17" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.17</span></a>). Let</span></p>
<table id="S2.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex31.m1" class="ltx_Math" alttext="X_{s}=\sum_{i=1}^{m_{s}}n_{s,i}X_{s,i}" display="block" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>s</mi></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>m</mi><mi>s</mi></msub></munderover><mrow><msub><mi>n</mi><mrow><mi>s</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mrow><mi>s</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{s}=\sum_{i=1}^{m_{s}}n_{s,i}X_{s,i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p25.4" class="ltx_p"><span id="S2.p25.4.1" class="ltx_text">be the decomposition into irreducible components. Let <math id="S2.p25.m12" class="ltx_Math" alttext="D_{s}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>s</mi></msub><annotation encoding="application/x-tex">D_{s}</annotation></semantics></math> be a small disk
centered at <math id="S2.p25.m13" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, <math id="S2.p25.m14" class="ltx_Math" alttext="t\in D_{s}^{*}=D_{s}-\{s\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>D</mi><mi>s</mi><mo>∗</mo></msubsup><mo>=</mo><mrow><msub><mi>D</mi><mi>s</mi></msub><mo>−</mo><mrow><mo stretchy="false">{</mo><mi>s</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\in D_{s}^{*}=D_{s}-\{s\}</annotation></semantics></math>, and <math id="S2.p25.m15" class="ltx_Math" alttext="\gamma_{s}\in\pi_{1}(D_{s}^{*},t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>s</mi></msub><mo>∈</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>D</mi><mi>s</mi><mo>∗</mo></msubsup><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{s}\in\pi_{1}(D_{s}^{*},t)</annotation></semantics></math> a generator. We see that</span></p>
<table id="S2.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex32.m1" class="ltx_Math" alttext="H^{i}(X_{s},{\mathbb{Q}})=\begin{cases}{\mathbb{Q}}&amp;\text{if $i=0$}\\
H^{1}(X_{t},{\mathbb{Q}})^{\gamma_{s}}\cong(j_{*}j^{*}R^{1}f_{*}{\mathbb{Q}})_{s}&amp;\text{if $i=1$}\\
{\mathbb{Q}}^{m_{s}}&amp;\text{if $i=2$}\\
0&amp;\text{otherwise}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>s</mi></msub><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mi>ℚ</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo mathsize="0.700em">,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><msub><mi>γ</mi><mi>s</mi></msub></msup></mrow><mo>≅</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><msup><mi>ℚ</mi><msub><mi>m</mi><mi>s</mi></msub></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">H^{i}(X_{s},{\mathbb{Q}})=\begin{cases}{\mathbb{Q}}&amp;\text{if $i=0$}\\
H^{1}(X_{t},{\mathbb{Q}})^{\gamma_{s}}\cong(j_{*}j^{*}R^{1}f_{*}{\mathbb{Q}})_{s}&amp;\text{if $i=1$}\\
{\mathbb{Q}}^{m_{s}}&amp;\text{if $i=2$}\\
0&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p25.5" class="ltx_p"><span id="S2.p25.5.1" class="ltx_text">Therefore <math id="S2.p25.m16" class="ltx_Math" alttext="M\cong\bigoplus{\mathbb{Q}}_{s}^{m_{s}-1}[-2]" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo rspace="0.111em">≅</mo><mrow><mo>⨁</mo><mrow><msubsup><mi>ℚ</mi><mi>s</mi><mrow><msub><mi>m</mi><mi>s</mi></msub><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">M\cong\bigoplus{\mathbb{Q}}_{s}^{m_{s}-1}[-2]</annotation></semantics></math>.
From (<a href="#S2.E18" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.18</span></a>), we deduce that we have
a noncanonical decomposition</span></p>
<table id="S2.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.19)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E19.m1" class="ltx_Math" alttext="H^{2}(X)\cong IH^{1}(R^{1}f_{*}{\mathbb{Q}})\oplus{\mathbb{Q}}[\sigma]\oplus{\mathbb{Q}}[X_{t}]\oplus\bigoplus_{s}{\mathbb{Q}}^{m_{s}-1}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>σ</mi><mo stretchy="false">]</mo></mrow></mrow><mo>⊕</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.055em">⊕</mo><mrow><munder><mo movablelimits="false">⨁</mo><mi>s</mi></munder><msup><mi>ℚ</mi><mrow><msub><mi>m</mi><mi>s</mi></msub><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{2}(X)\cong IH^{1}(R^{1}f_{*}{\mathbb{Q}})\oplus{\mathbb{Q}}[\sigma]\oplus{\mathbb{Q}}[X_{t}]\oplus\bigoplus_{s}{\mathbb{Q}}^{m_{s}-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p25.6" class="ltx_p"><span id="S2.p25.6.1" class="ltx_text">We can see that the last two summands are spanned by divisor classes
supported on the fibres. Since the decomposition (<a href="#S2.E17" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.17</span></a>)
can be lifted to the derived category of mixed Hodge modules, we see that (<a href="#S2.E19" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.19</span></a>) becomes
an isomorphism of Hodge structures provided that all the summands in (<a href="#S2.E19" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.19</span></a>) except the
first are viewed as sums of the Tate structures <math id="S2.p25.m17" class="ltx_Math" alttext="{\mathbb{Q}}(-1)" display="inline" intent=":literal"><semantics><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{Q}}(-1)</annotation></semantics></math>.</span></p>
</div>
<div id="S2.p26" class="ltx_para">
<p id="S2.p26.1" class="ltx_p"><span id="S2.p26.1.1" class="ltx_text">Formula (<a href="#S2.E19" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.19</span></a>) implies</span></p>
<table id="S2.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.20)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E20.m1" class="ltx_Math" alttext="\dim Gr^{1}_{F}IH^{1}(R^{1}f_{*}{\mathbb{C}})=h^{11}(X)-2-\sum(m_{s}-1)" display="block" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>h</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>2</mn><mo rspace="0.055em">−</mo><mrow><mo movablelimits="false" rspace="0em">∑</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mi>s</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\dim Gr^{1}_{F}IH^{1}(R^{1}f_{*}{\mathbb{C}})=h^{11}(X)-2-\sum(m_{s}-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p26.2" class="ltx_p"><span id="S2.p26.2.1" class="ltx_text">When combined with lemma <a href="#S2.Thmlemma1" title="Lemma 2.1. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a> and the Shioda-Tate formula
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Mr</a>]</cite></span></p>
<table id="S2.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.21)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E21.m1" class="ltx_math_unparsed" alttext="\rank MW({\mathcal{E}}/Y)=\rho(X)-2-\sum(m_{s}-1)" display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">rank</mo><mi>M</mi><mi>W</mi><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>/</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>ρ</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>2</mn><mo rspace="0.055em">−</mo><mo movablelimits="false" rspace="0em">∑</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>s</mi></msub><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rank MW({\mathcal{E}}/Y)=\rho(X)-2-\sum(m_{s}-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p26.3" class="ltx_p"><span id="S2.p26.3.1" class="ltx_text">we obtain (<a href="#S2.E16" title="In Lemma 2.6. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.16</span></a>).
The second part of the lemma characterizing extremal surfaces follows
immediately from this and lemma <a href="#S2.Thmlemma1" title="Lemma 2.1. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>.
∎</span></p>
</div>
</div>
<div id="S2.p27" class="ltx_para">
<p id="S2.p27.1" class="ltx_p">A key set of examples is provided by:</p>
</div>
<div id="S2.Thmprop1" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmprop1.1" class="ltx_text ltx_font_bold">Proposition 2.1</span></span><span id="S2.Thmprop1.2" class="ltx_text ltx_font_bold"> </span>(Shioda)<span id="S2.Thmprop1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmprop1.p1" class="ltx_para">
<p id="S2.Thmprop1.p1.1" class="ltx_p"><span id="S2.Thmprop1.p1.1.1" class="ltx_text ltx_font_italic">Elliptic modular surfaces are extremal.</span></p>
</div>
</div>
<div id="S2.9" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p28" class="ltx_para">
<p id="S2.p28.1" class="ltx_p"><span id="S2.p28.1.1" class="ltx_text">The Mordell-Weil rank is zero by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">Sho</a>, thm 5.2]</cite>, and
<math id="S2.p28.m1" class="ltx_Math" alttext="\rho=h^{11}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><msup><mi>h</mi><mn>11</mn></msup></mrow><annotation encoding="application/x-tex">\rho=h^{11}</annotation></semantics></math> by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">Sho</a>, rmk, 7.8]</cite>.
∎</span></p>
</div>
</div>
<div id="S2.p29" class="ltx_para">
<p id="S2.p29.1" class="ltx_p">We can now state the first corollary of theorem <a href="#S2.Thmthm1" title="Theorem 2.1. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>.
This corollary applies to elliptic modular surfaces, so
we recover Gordon’s theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx15" title="" class="ltx_ref">G</a>]</cite>.</p>
</div>
<div id="S2.Thmthm3" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmthm3.1" class="ltx_text ltx_font_bold">Corollary 2.3</span></span><span id="S2.Thmthm3.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmthm3.p1" class="ltx_para">
<p id="S2.Thmthm3.p1.1" class="ltx_p"><span id="S2.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S2.Thmthm3.p1.m1" class="ltx_Math" alttext="f:{\mathcal{E}}\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:{\mathcal{E}}\to Y</annotation></semantics></math> is an extremal elliptic surface
then the Hodge conjecture holds for the complement <math id="S2.Thmthm3.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> of the
preimage of <math id="S2.Thmthm3.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> in <math id="S2.Thmthm3.p1.m4" class="ltx_math_unparsed" alttext="{\mathcal{E}}\times_{Y}{\mathcal{E}}\times_{Y}\ldots{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><mi>Y</mi></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><mi>Y</mi></msub><mi mathvariant="normal">…</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">{\mathcal{E}}\times_{Y}{\mathcal{E}}\times_{Y}\ldots{\mathcal{E}}</annotation></semantics></math>.; it holds for
any desingularization of <math id="S2.Thmthm3.p1.m5" class="ltx_math_unparsed" alttext="{\mathcal{E}}\times_{Y}{\mathcal{E}}\times_{Y}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><mi>Y</mi></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><mi>Y</mi></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">{\mathcal{E}}\times_{Y}{\mathcal{E}}\times_{Y}{\mathcal{E}}</annotation></semantics></math>, and it holds for the toroidal
resolution <math id="S2.Thmthm3.p1.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> when <math id="S2.Thmthm3.p1.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is semistable,</span></p>
</div>
</div>
<div id="S2.10" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p30" class="ltx_para">
<p id="S2.p30.1" class="ltx_p"><span id="S2.p30.1.1" class="ltx_text">When <math id="S2.p30.m1" class="ltx_Math" alttext="\Lambda=\{\lambda\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>λ</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Lambda=\{\lambda\}</annotation></semantics></math>, <math id="S2.p30.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is very general since
<math id="S2.p30.m3" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math> is the only proper analytic subset.
∎</span></p>
</div>
</div>
<div id="S2.p31" class="ltx_para">
<p id="S2.p31.1" class="ltx_p">We next consider families of elliptic K3 surfaces with the following features:</p>
<table id="S2.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex33.m1" class="ltx_Math" alttext="{\mathcal{E}}\xrightarrow{f}\mathbb{P}^{1}\times\Lambda=Y\to\Lambda" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑓</mo></mover><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Λ</mi></mrow><mo>=</mo><mi>Y</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">{\mathcal{E}}\xrightarrow{f}\mathbb{P}^{1}\times\Lambda=Y\to\Lambda</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p31.2" class="ltx_p">is a family of elliptic K3 surfaces over a curve <math id="S2.p31.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> such that:</p>
<ol id="S2.I2" class="ltx_enumerate">
<li id="S2.I2.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(EK1)</span> 
<div id="S2.I2.ix1.p1" class="ltx_para">
<p id="S2.I2.ix1.p1.1" class="ltx_p"><math id="S2.I2.ix1.p1.m1" class="ltx_math_unparsed" alttext="\rank MW({\mathcal{E}}_{\lambda}/\mathbb{P}^{1})=0" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">rank</mo><mi>M</mi><mi>W</mi><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo>/</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rank MW({\mathcal{E}}_{\lambda}/\mathbb{P}^{1})=0</annotation></semantics></math> for very general <math id="S2.I2.ix1.p1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>.</p>
</div></li>
<li id="S2.I2.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(EK2)</span> 
<div id="S2.I2.ix2.p1" class="ltx_para">
<p id="S2.I2.ix2.p1.1" class="ltx_p">There is a fibrewise isogeny between <math id="S2.I2.ix2.p1.m1" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math> and the family of Kummer surfaces
associated to a selfproduct of a nonisotrivial elliptic surface
<math id="S2.I2.ix2.p1.m2" class="ltx_Math" alttext="g:F\to\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>F</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Λ</mi></mrow></mrow><annotation encoding="application/x-tex">g:F\to\Lambda</annotation></semantics></math>. More precisely, there is an
algebraic correspondence</p>
<table id="S2.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex34.m1" class="ltx_Math" alttext="Z\in CH^{2}({\mathcal{E}}\times Km(F\times_{\Lambda}F/\Lambda))" display="block" intent=":literal"><semantics><mrow><mi>Z</mi><mo>∈</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>F</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Λ</mi></msub><mi>F</mi></mrow><mo>/</mo><mi mathvariant="normal">Λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\in CH^{2}({\mathcal{E}}\times Km(F\times_{\Lambda}F/\Lambda))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I2.ix2.p1.2" class="ltx_p">which induces a fibrewise isomorphism between the transcendental parts</p>
<table id="S2.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.22)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E22.m1" class="ltx_Math" alttext="H_{tr}^{2}({\mathcal{E}}_{\lambda},{\mathbb{Q}})\cong H_{tr}^{2}(Km(F_{\lambda}\times F_{\lambda}),{\mathbb{Q}})\cong H_{tr}^{2}(F_{\lambda}\times F_{\lambda},{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>H</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msubsup><mi>H</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>F</mi><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>F</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msubsup><mi>H</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>F</mi><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>F</mi><mi>λ</mi></msub></mrow><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{tr}^{2}({\mathcal{E}}_{\lambda},{\mathbb{Q}})\cong H_{tr}^{2}(Km(F_{\lambda}\times F_{\lambda}),{\mathbb{Q}})\cong H_{tr}^{2}(F_{\lambda}\times F_{\lambda},{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I2.ix2.p1.3" class="ltx_p">as Hodge structures. (Recall that the transcendental part <math id="S2.I2.ix2.p1.m3" class="ltx_Math" alttext="H^{2}_{tr}({\mathcal{E}},{\mathbb{Q}})=(NS({\mathcal{E}})\otimes{\mathbb{Q}})^{\perp}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>H</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⟂</mo></msup></mrow><annotation encoding="application/x-tex">H^{2}_{tr}({\mathcal{E}},{\mathbb{Q}})=(NS({\mathcal{E}})\otimes{\mathbb{Q}})^{\perp}</annotation></semantics></math>.)</p>
</div></li>
</ol>
<p id="S2.p31.3" class="ltx_p">Examples satisfying (EK1) and (EK2) include Hoyt’s <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx17" title="" class="ltx_ref">H</a>]</cite> defined by the affine equation</p>
<table id="S2.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex35.m1" class="ltx_Math" alttext="y^{2}=t(t-1)(t-\lambda)x(x-1)(x-t)" display="block" intent=":literal"><semantics><mrow><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y^{2}=t(t-1)(t-\lambda)x(x-1)(x-t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p31.4" class="ltx_p">For <math id="S2.p31.m2" class="ltx_Math" alttext="\lambda\in\Lambda={\mathbb{C}}-\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi><mo>=</mo><mrow><mi>ℂ</mi><mo>−</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\in\Lambda={\mathbb{C}}-\{0,1\}</annotation></semantics></math>, this defines an elliptic K3 surface <math id="S2.p31.m3" class="ltx_Math" alttext="{\mathcal{E}}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\lambda}</annotation></semantics></math> over the <math id="S2.p31.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-line.
Hoyt shows that this is birational to the quotient of an explicit Kummer surface <math id="S2.p31.m5" class="ltx_Math" alttext="Km(F_{\lambda}\times F_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>F</mi><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>F</mi><mi>λ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Km(F_{\lambda}\times F_{\lambda})</annotation></semantics></math> by an involution, and that the rank of the Mordell-Weil group <math id="S2.p31.m6" class="ltx_Math" alttext="MW({\mathcal{E}}_{\lambda}/\mathbb{P}^{1})" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo>/</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">MW({\mathcal{E}}_{\lambda}/\mathbb{P}^{1})</annotation></semantics></math> is zero unless
<math id="S2.p31.m7" class="ltx_Math" alttext="F_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">F_{\lambda}</annotation></semantics></math> has complex multiplication.</p>
</div>
<div id="S2.p32" class="ltx_para">
<p id="S2.p32.1" class="ltx_p">The families of K3 surfaces constructed by Dolgachev
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx10" title="" class="ltx_ref">Do</a>, Ex. 7.8, 7.9, 7.10]</cite> can also be seen to satisfy (EK1) and (EK2) above. The first condition is satisfied by construction (see the
remarks preceding <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx10" title="" class="ltx_ref">Do</a>, Ex. 7.8]</cite>);
for the second use <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx10" title="" class="ltx_ref">Do</a>, thm 7.6]</cite>.</p>
</div>
<div id="S2.Thmthm4" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmthm4.1" class="ltx_text ltx_font_bold">Corollary 2.4</span></span><span id="S2.Thmthm4.2" class="ltx_text ltx_font_bold"> </span>(to theorem <a href="#S2.Thmthm1" title="Theorem 2.1. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>)<span id="S2.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmthm4.p1" class="ltx_para">
<p id="S2.Thmthm4.p1.1" class="ltx_p"><span id="S2.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S2.Thmthm4.p1.m1" class="ltx_Math" alttext="{\mathcal{E}}\to\mathbb{P}^{1}\times\Lambda" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">→</mo><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Λ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}\to\mathbb{P}^{1}\times\Lambda</annotation></semantics></math> be a family satisfying (EK1) and (EK2). Suppose that <math id="S2.Thmthm4.p1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is very general.
The Hodge conjecture holds for <math id="S2.Thmthm4.p1.m3" class="ltx_Math" alttext="V_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">V_{\lambda}</annotation></semantics></math>, and for any desingularization of <math id="S2.Thmthm4.p1.m4" class="ltx_math_unparsed" alttext="{\mathcal{E}}_{\lambda}\times_{\mathbb{P}^{1}}{\mathcal{E}}_{\lambda}\times_{\mathbb{P}^{1}}{\mathcal{E}}_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{\lambda}\times_{\mathbb{P}^{1}}{\mathcal{E}}_{\lambda}\times_{\mathbb{P}^{1}}{\mathcal{E}}_{\lambda}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.11" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p33" class="ltx_para">
<p id="S2.p33.1" class="ltx_p"><span id="S2.p33.1.1" class="ltx_text">The correspondence <math id="S2.p33.m1" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> induces an inlcusion</span></p>
<table id="S2.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex36.m1" class="ltx_Math" alttext="H_{tr}^{2}({\mathcal{E}}_{\lambda},{\mathbb{Q}})\cong H_{tr}^{2}(F_{\lambda}\times F_{\lambda},{\mathbb{Q}})\subseteq S^{2}H^{1}(F_{\lambda},{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>H</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msubsup><mi>H</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>F</mi><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>F</mi><mi>λ</mi></msub></mrow><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>λ</mi></msub><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{tr}^{2}({\mathcal{E}}_{\lambda},{\mathbb{Q}})\cong H_{tr}^{2}(F_{\lambda}\times F_{\lambda},{\mathbb{Q}})\subseteq S^{2}H^{1}(F_{\lambda},{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p33.2" class="ltx_p"><span id="S2.p33.2.1" class="ltx_text">Let us choose <math id="S2.p33.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> very general. Then <math id="S2.p33.m3" class="ltx_Math" alttext="F_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">F_{\lambda}</annotation></semantics></math> will not have
complex multiplication, which implies that <math id="S2.p33.m4" class="ltx_Math" alttext="S^{2}H^{1}(F_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S^{2}H^{1}(F_{\lambda})</annotation></semantics></math> will be
a simple Hodge structure. Simplicity forces the above inclusion to be an
equality. It follows that
<math id="S2.p33.m5" class="ltx_Math" alttext="\dim H_{tr}^{2}({\mathcal{E}}_{\lambda},{\mathbb{Q}})=3" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mrow><msubsup><mi>H</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\dim H_{tr}^{2}({\mathcal{E}}_{\lambda},{\mathbb{Q}})=3</annotation></semantics></math>, and therefore
<math id="S2.p33.m6" class="ltx_Math" alttext="\rho({\mathcal{E}}_{\lambda})=19" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>19</mn></mrow><annotation encoding="application/x-tex">\rho({\mathcal{E}}_{\lambda})=19</annotation></semantics></math>.
Lemma <a href="#S2.Thmlemma6" title="Lemma 2.6. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.6</span></a> shows that
<math id="S2.p33.m7" class="ltx_math_unparsed" alttext="\dim Gr_{F}^{1}IH^{1}(R^{1}f_{\lambda*}{\mathbb{C}})=1" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">dim</mo><mi>G</mi><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mi>I</mi><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mn>1</mn></msup><msub><mi>f</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℂ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\dim Gr_{F}^{1}IH^{1}(R^{1}f_{\lambda*}{\mathbb{C}})=1</annotation></semantics></math>. The orthogonal complement of
<math id="S2.p33.m8" class="ltx_math_unparsed" alttext="IH^{1}(R^{1}f_{\lambda*}{\mathbb{C}})" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mn>1</mn></msup><msub><mi>f</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">IH^{1}(R^{1}f_{\lambda*}{\mathbb{C}})</annotation></semantics></math> is spanned by divisors by (<a href="#S2.E19" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.19</span></a>).
Therefore <math id="S2.p33.m9" class="ltx_math_unparsed" alttext="IH^{1}(R^{1}f_{\lambda*}{\mathbb{C}})" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mn>1</mn></msup><msub><mi>f</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">IH^{1}(R^{1}f_{\lambda*}{\mathbb{C}})</annotation></semantics></math> must
contain the <math id="S2.p33.m10" class="ltx_Math" alttext="(2,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2,0)</annotation></semantics></math> and <math id="S2.p33.m11" class="ltx_Math" alttext="(0,2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,2)</annotation></semantics></math> parts of <math id="S2.p33.m12" class="ltx_Math" alttext="H^{2}({\mathcal{E}}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2}({\mathcal{E}}_{\lambda})</annotation></semantics></math>. Consequently its dimension is <math id="S2.p33.m13" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> and
it meets <math id="S2.p33.m14" class="ltx_Math" alttext="H_{tr}^{2}({\mathcal{E}}_{\lambda})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{tr}^{2}({\mathcal{E}}_{\lambda})</annotation></semantics></math>. By simplicity of the latter, we
must have that</span></p>
<table id="S2.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex37.m1" class="ltx_math_unparsed" alttext="IH^{1}(R^{1}f_{\lambda*}{\mathbb{Q}})=H_{tr}^{2}({\mathcal{E}}_{\lambda})" display="block" intent=":literal"><semantics><mrow><mi>I</mi><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mn>1</mn></msup><msub><mi>f</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi>H</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">IH^{1}(R^{1}f_{\lambda*}{\mathbb{Q}})=H_{tr}^{2}({\mathcal{E}}_{\lambda})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p33.3" class="ltx_p"><span id="S2.p33.3.1" class="ltx_text">Therefore by lemma <a href="#S2.Thmlemma1" title="Lemma 2.1. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a> we have an isomorphism</span></p>
<table id="S2.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex38.m1" class="ltx_math_unparsed" alttext="Gr_{2}^{W}H^{1}(U_{\lambda},R^{1}f_{\lambda*}{\mathbb{Q}})\cong S^{2}H^{1}(F_{\lambda},{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mi>G</mi><msubsup><mi>r</mi><mn>2</mn><mi>W</mi></msubsup><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>λ</mi></msub><mo>,</mo><msup><mi>R</mi><mn>1</mn></msup><msub><mi>f</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><mo>≅</mo><msup><mi>S</mi><mn>2</mn></msup><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>λ</mi></msub><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Gr_{2}^{W}H^{1}(U_{\lambda},R^{1}f_{\lambda*}{\mathbb{Q}})\cong S^{2}H^{1}(F_{\lambda},{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p33.4" class="ltx_p"><span id="S2.p33.4.1" class="ltx_text">induced by <math id="S2.p33.m15" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>, and this leads to an isomorphism of
corresponding variations of Hodge structure, possibly over a
nonempty Zariski open
subset of <math id="S2.p33.m16" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>. Therefore it suffices to check injectivity of
the Kodaira-Spencer map</span></p>
<table id="S2.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex39.m1" class="ltx_Math" alttext="\kappa_{2,\lambda}(S^{2}R^{1}g_{*}{\mathbb{Q}}):Gr^{2}_{F}S^{2}H^{1}(F_{\lambda})\to Gr_{F}^{1}S^{2}H^{1}(F_{\lambda})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>κ</mi><mrow><mn>2</mn><mo>,</mo><mi>λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{2,\lambda}(S^{2}R^{1}g_{*}{\mathbb{Q}}):Gr^{2}_{F}S^{2}H^{1}(F_{\lambda})\to Gr_{F}^{1}S^{2}H^{1}(F_{\lambda})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p33.5" class="ltx_p"><span id="S2.p33.5.1" class="ltx_text">Using (<a href="#S2.E11" title="In 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.11</span></a>) and the formulas preceding it, we can see that
<math id="S2.p33.m17" class="ltx_Math" alttext="\kappa(S^{2}R^{1}g_{*}{\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa(S^{2}R^{1}g_{*}{\mathbb{Q}})</annotation></semantics></math> is the tensor product</span></p>
<table id="S2.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex40.m1" class="ltx_Math" alttext="\kappa_{1,\lambda}(R^{1}g_{*}{\mathbb{Q}})\otimes id:H^{0}(F_{\lambda},\Omega^{1})\otimes H^{1}(F_{\lambda},{\mathcal{O}})\to H^{1}(F_{\lambda},{\mathcal{O}})\otimes H^{1}(F_{\lambda},{\mathcal{O}})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>κ</mi><mrow><mn>1</mn><mo>,</mo><mi>λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>i</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>λ</mi></msub><mo>,</mo><msup><mi mathvariant="normal">Ω</mi><mn>1</mn></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>H</mi><mn>1</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>λ</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>λ</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>H</mi><mn>1</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>λ</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{1,\lambda}(R^{1}g_{*}{\mathbb{Q}})\otimes id:H^{0}(F_{\lambda},\Omega^{1})\otimes H^{1}(F_{\lambda},{\mathcal{O}})\to H^{1}(F_{\lambda},{\mathcal{O}})\otimes H^{1}(F_{\lambda},{\mathcal{O}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p33.6" class="ltx_p"><span id="S2.p33.6.1" class="ltx_text">and this is injective for general <math id="S2.p33.m18" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, because <math id="S2.p33.m19" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>
is nonisotrivial.</span></p>
</div>
<div id="S2.p34" class="ltx_para">
<p id="S2.p34.1" class="ltx_p"><span id="S2.p34.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S2.Thmthm5" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmthm5.1" class="ltx_text ltx_font_bold">Remark 2.5</span></span><span id="S2.Thmthm5.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmthm5.p1" class="ltx_para">
<p id="S2.Thmthm5.p1.1" class="ltx_p"><span id="S2.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">The conditions (EK1) and (EK2) force <math id="S2.Thmthm5.p1.m1" class="ltx_Math" alttext="\rho({\mathcal{E}}_{\lambda})=19&lt;h^{11}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>19</mn><mo>&lt;</mo><msup><mi>h</mi><mn>11</mn></msup></mrow><annotation encoding="application/x-tex">\rho({\mathcal{E}}_{\lambda})=19&lt;h^{11}</annotation></semantics></math> for very general
<math id="S2.Thmthm5.p1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, so these surfaces cannot be extremal. Conversely, using lemma <a href="#S2.Thmlemma6" title="Lemma 2.6. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.6</span></a>,
we can see that any nontrivial family of elliptic
K3 surfaces to which the theorem applies must have <math id="S2.Thmthm5.p1.m3" class="ltx_Math" alttext="\rho({\mathcal{E}}_{\lambda})=19" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>19</mn></mrow><annotation encoding="application/x-tex">\rho({\mathcal{E}}_{\lambda})=19</annotation></semantics></math> generically.</span></p>
</div>
</div>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3. </span>Families of abelian varieties over a Shimura curve</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">For our purposes, a Shimura variety <math id="S3.p1.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is a quotient of a Hermitian symmetric domain by an arithmetic group.
It can constructed from the following datum: a semisimple algebraic group <math id="S3.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> over <math id="S3.p1.m3" class="ltx_Math" alttext="{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">{\mathbb{Q}}</annotation></semantics></math>,
a homorphism (or conjugacy class of homomorphisms) <math id="S3.p1.m4" class="ltx_Math" alttext="h:U(1)\to G^{ad}({\mathbb{R}})" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>G</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h:U(1)\to G^{ad}({\mathbb{R}})</annotation></semantics></math> satisfying the axioms of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">Mi</a>, 4.4]</cite>,
and an arithmetic group <math id="S3.p1.m5" class="ltx_Math" alttext="\Gamma\subset G({\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊂</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma\subset G({\mathbb{Q}})</annotation></semantics></math>. (The group <math id="S3.p1.m6" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> is usually required to be a congruence group,
but we will not insist on this.)
If <math id="S3.p1.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is the stabilizer of <math id="S3.p1.m8" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> in the identity component <math id="S3.p1.m9" class="ltx_Math" alttext="G({\mathbb{R}})^{+}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">G({\mathbb{R}})^{+}</annotation></semantics></math>, the corresponding Shimura variety
<math id="S3.p1.m10" class="ltx_Math" alttext="Y=\Gamma\backslash G({\mathbb{R}})^{+}/K" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><mrow><mrow><mrow><mi mathvariant="normal">Γ</mi><mo lspace="0.222em" rspace="0.222em">\</mo><mi>G</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></msup></mrow><mo>/</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">Y=\Gamma\backslash G({\mathbb{R}})^{+}/K</annotation></semantics></math>.
For example, given a rational symplectic vector space <math id="S3.p1.m11" class="ltx_Math" alttext="(V,Q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V,Q)</annotation></semantics></math> of dimension <math id="S3.p1.m12" class="ltx_Math" alttext="2g" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">2g</annotation></semantics></math>,
let <math id="S3.p1.m13" class="ltx_Math" alttext="G=Sp(V,Q)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G=Sp(V,Q)</annotation></semantics></math>. We have a Shimura datum, where the set of homomorphisms <math id="S3.p1.m14" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> corresponds to
the set of Hodge structures of type <math id="S3.p1.m15" class="ltx_Math" alttext="\{(-1,0),(0,-1)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo rspace="0em">,</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(-1,0),(0,-1)\}</annotation></semantics></math> on <math id="S3.p1.m16" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, polarized by <math id="S3.p1.m17" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>.
If we fix a lattice <math id="S3.p1.m18" class="ltx_Math" alttext="L\subset V" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">L\subset V</annotation></semantics></math>, such that <math id="S3.p1.m19" class="ltx_Math" alttext="Q|_{L}" display="inline" intent=":literal"><semantics><msub><mrow><mi>Q</mi><mo stretchy="false">|</mo></mrow><mi>L</mi></msub><annotation encoding="application/x-tex">Q|_{L}</annotation></semantics></math> is principal, and let <math id="S3.p1.m20" class="ltx_Math" alttext="\Gamma\subset G({\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊂</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma\subset G({\mathbb{Q}})</annotation></semantics></math>, be the subgroup preserving <math id="S3.p1.m21" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>,
the corresponding Shimura variety is just the moduli space of principally polarized abelian varieties <math id="S3.p1.m22" class="ltx_Math" alttext="A_{g}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>g</mi></msub><annotation encoding="application/x-tex">A_{g}</annotation></semantics></math>.
We say that a Shimura variety <math id="S3.p1.m23" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is of Hodge type if there exists a faithful representation <math id="S3.p1.m24" class="ltx_Math" alttext="G\to Sp_{2g}({\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo stretchy="false">→</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G\to Sp_{2g}({\mathbb{Q}})</annotation></semantics></math>
which extends to a map of Shimura data.
Then we get an embedding of <math id="S3.p1.m25" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> into the moduli space of abelian varieties with level structure.
If level structure is fine, then we can pull back the universal family to get a family of abelian
varieties over <math id="S3.p1.m26" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>.</p>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">We now describe the main example of interest to us.
Let <math id="S3.p2.m1" class="ltx_Math" alttext="K/{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>/</mo><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">K/{\mathbb{Q}}</annotation></semantics></math> be a totally real number field of degree <math id="S3.p2.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.
Denote the <math id="S3.p2.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> distinct embeddings by <math id="S3.p2.m4" class="ltx_math_unparsed" alttext="\sigma_{i}:K\to{\mathbb{R}},i=1,\ldots d" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>ℝ</mi><mo>,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mi>d</mi></mrow><annotation encoding="application/x-tex">\sigma_{i}:K\to{\mathbb{R}},i=1,\ldots d</annotation></semantics></math>.
Fix a quaternion division algebra <math id="S3.p2.m5" class="ltx_Math" alttext="D/K" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>/</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">D/K</annotation></semantics></math> such that <math id="S3.p2.m6" class="ltx_Math" alttext="D\otimes_{\sigma_{1}}{\mathbb{R}}\cong M_{2}({\mathbb{R}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>σ</mi><mn>1</mn></msub></msub><mi>ℝ</mi></mrow><mo>≅</mo><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D\otimes_{\sigma_{1}}{\mathbb{R}}\cong M_{2}({\mathbb{R}})</annotation></semantics></math>
and <math id="S3.p2.m7" class="ltx_Math" alttext="D\otimes_{\sigma_{i}}{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>σ</mi><mi>i</mi></msub></msub><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">D\otimes_{\sigma_{i}}{\mathbb{R}}</annotation></semantics></math> is the Hamilton quaternions <math id="S3.p2.m8" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> for <math id="S3.p2.m9" class="ltx_Math" alttext="i=2,\ldots,d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">i=2,\ldots,d</annotation></semantics></math>.
If <math id="S3.p2.m10" class="ltx_Math" alttext="\bar{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{x}</annotation></semantics></math> denotes conjugation in <math id="S3.p2.m11" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, then</p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="G=D_{1}^{*}=\{x\in D\mid x\bar{x}=1\}" display="block" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><msubsup><mi>D</mi><mn>1</mn><mo>∗</mo></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>∈</mo><mi>D</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>x</mi><mo>¯</mo></mover></mrow><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">G=D_{1}^{*}=\{x\in D\mid x\bar{x}=1\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p2.2" class="ltx_p">is an algebraic group over <math id="S3.p2.m12" class="ltx_Math" alttext="{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">{\mathbb{Q}}</annotation></semantics></math> whose group of real points</p>
<table id="S3.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E1.m1" class="ltx_Math" alttext="G({\mathbb{R}})\cong SL_{2}({\mathbb{R}})\times(SU_{2})^{d-1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">G({\mathbb{R}})\cong SL_{2}({\mathbb{R}})\times(SU_{2})^{d-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p2.3" class="ltx_p">It follows that</p>
<table id="S3.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E2.m1" class="ltx_Math" alttext="G({\mathbb{C}})\cong SL_{2}({\mathbb{C}})^{d}" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">G({\mathbb{C}})\cong SL_{2}({\mathbb{C}})^{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p2.4" class="ltx_p">and</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="G^{ad}({\mathbb{R}})\cong PSL_{2}({\mathbb{R}})\times(PU_{2})^{d-1}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>G</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">G^{ad}({\mathbb{R}})\cong PSL_{2}({\mathbb{R}})\times(PU_{2})^{d-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p2.5" class="ltx_p">Let <math id="S3.p2.m13" class="ltx_Math" alttext="h:U(1)\to G^{ad}({\mathbb{R}})" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>G</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h:U(1)\to G^{ad}({\mathbb{R}})</annotation></semantics></math> be defined by</p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_Math" alttext="h(e^{i\theta})=\left(\begin{pmatrix}\cos\theta/2&amp;\sin\theta/2\\
-\sin\theta/2&amp;\cos\theta/2\end{pmatrix}\mod\pm I,1\right)" display="block" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo>/</mo><mn>2</mn></mrow></mrow></mtd><mtd><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo>/</mo><mn>2</mn></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mo>−</mo><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo>/</mo><mn>2</mn></mrow></mrow></mrow></mtd><mtd><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo>/</mo><mn>2</mn></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo rspace="0em">mod</mo><mrow><mo lspace="0em">±</mo><mi>I</mi></mrow></mrow><mo>,</mo><mn>1</mn><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">h(e^{i\theta})=\left(\begin{pmatrix}\cos\theta/2&amp;\sin\theta/2\\
-\sin\theta/2&amp;\cos\theta/2\end{pmatrix}\mod\pm I,1\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p2.6" class="ltx_p">with respect to (<a href="#S3.E3" title="In 3. Families of abelian varieties over a Shimura curve ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>). (For an explanation of <math id="S3.p2.m14" class="ltx_Math" alttext="\theta/2" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\theta/2</annotation></semantics></math>, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">Mi</a>, ex 1.10]</cite>.)
The pair <math id="S3.p2.m15" class="ltx_Math" alttext="(G,h)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,h)</annotation></semantics></math> defines a connected Shimura datum.
The corresponding symmetric space is the upper half plane <math id="S3.p2.m16" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math>.
To complete the description of the Shimura variety,
fix a maximal order <math id="S3.p2.m17" class="ltx_Math" alttext="{\mathcal{O}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒪</mi><annotation encoding="application/x-tex">{\mathcal{O}}</annotation></semantics></math> in <math id="S3.p2.m18" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>,
and a torsion free finite index subgroup of <math id="S3.p2.m19" class="ltx_Math" alttext="\Gamma\subseteq{\mathcal{O}}_{1}^{*}={\mathcal{O}}\cap D_{1}^{*}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊆</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mn>1</mn><mo>∗</mo></msubsup><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>∩</mo><msubsup><mi>D</mi><mn>1</mn><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Gamma\subseteq{\mathcal{O}}_{1}^{*}={\mathcal{O}}\cap D_{1}^{*}</annotation></semantics></math>.
Let <math id="S3.p2.m20" class="ltx_Math" alttext="Y=\Gamma\backslash{\mathbb{H}}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><mrow><mi mathvariant="normal">Γ</mi><mo lspace="0.222em" rspace="0.222em">\</mo><mi>ℍ</mi></mrow></mrow><annotation encoding="application/x-tex">Y=\Gamma\backslash{\mathbb{H}}</annotation></semantics></math>, where <math id="S3.p2.m21" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>
acts through projection to <math id="S3.p2.m22" class="ltx_Math" alttext="SL_{2}({\mathbb{R}})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">SL_{2}({\mathbb{R}})</annotation></semantics></math>.
<span id="S3.p2.6.1" class="ltx_text ltx_font_italic">We fix this notation for the remainder of this section.</span></p>
</div>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p">We first observe that
<math id="S3.p3.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is a projective algebraic curve, c.f. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx30" title="" class="ltx_ref">Sh</a>, chap 9]</cite>. We claim that
the curve <math id="S3.p3.m2" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is of Hodge type, so it would carry a
universal family of abelian varieties <math id="S3.p3.m3" class="ltx_Math" alttext="f:\mathcal{A}\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathcal{A}\to Y</annotation></semantics></math>.
An explicit construction of <math id="S3.p3.m4" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> was given in a paper of Viehweg-Zuo <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx34" title="" class="ltx_ref">VZ</a>]</cite>.
We outline the construction from section 5 of their paper,
because we will need to extract certain facts which were not explicitly stated.
The correstriction of <math id="S3.p3.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is the central simple <math id="S3.p3.m6" class="ltx_Math" alttext="{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">{\mathbb{Q}}</annotation></semantics></math>-algebra</p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\Cor(D)=[\bigotimes_{i}D\otimes_{\sigma_{i}}\overline{{\mathbb{Q}}}]^{Gal(\overline{{\mathbb{Q}}}/K)}" display="block" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Cor</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><munder><mo lspace="0em" movablelimits="false">⨂</mo><mi>i</mi></munder><mrow><mi>D</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>σ</mi><mi>i</mi></msub></msub><mover accent="true"><mi>ℚ</mi><mo stretchy="true">¯</mo></mover></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>ℚ</mi><mo stretchy="true">¯</mo></mover><mo>/</mo><mi>K</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\Cor(D)=[\bigotimes_{i}D\otimes_{\sigma_{i}}\overline{{\mathbb{Q}}}]^{Gal(\overline{{\mathbb{Q}}}/K)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p3.2" class="ltx_p">of dimension <math id="S3.p3.m7" class="ltx_Math" alttext="4^{d}" display="inline" intent=":literal"><semantics><msup><mn>4</mn><mi>d</mi></msup><annotation encoding="application/x-tex">4^{d}</annotation></semantics></math>.
In the simplest case, <math id="S3.p3.m8" class="ltx_Math" alttext="\Cor(D)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Cor</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Cor(D)</annotation></semantics></math> splits, which means that it is a matrix algebra
<math id="S3.p3.m9" class="ltx_Math" alttext="M_{2^{d}}({\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><msup><mn>2</mn><mi>d</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{2^{d}}({\mathbb{Q}})</annotation></semantics></math>. Then via the norm homomorphism <math id="S3.p3.m10" class="ltx_Math" alttext="Nm:D^{*}\to\Cor(D)^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>D</mi><mo>∗</mo></msup><mo rspace="0.1389em" stretchy="false">→</mo><mrow><mo lspace="0.1389em" rspace="0em">Cor</mo><msup><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">Nm:D^{*}\to\Cor(D)^{*}</annotation></semantics></math>, <math id="S3.p3.m11" class="ltx_Math" alttext="V={\mathbb{Q}}^{2^{d}}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><msup><mi>ℚ</mi><msup><mn>2</mn><mi>d</mi></msup></msup></mrow><annotation encoding="application/x-tex">V={\mathbb{Q}}^{2^{d}}</annotation></semantics></math> is a representation of <math id="S3.p3.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.
If <math id="S3.p3.m13" class="ltx_Math" alttext="\Cor(D)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Cor</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Cor(D)</annotation></semantics></math> does not split, then it will split over a suitable quadratic field <math id="S3.p3.m14" class="ltx_Math" alttext="{\mathbb{Q}}(\sqrt{b})" display="inline" intent=":literal"><semantics><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>b</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{Q}}(\sqrt{b})</annotation></semantics></math>. In this case,
<math id="S3.p3.m15" class="ltx_Math" alttext="V={\mathbb{Q}}(\sqrt{b})^{2^{d}}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msqrt><mi>b</mi></msqrt><mo stretchy="false">)</mo></mrow><msup><mn>2</mn><mi>d</mi></msup></msup></mrow></mrow><annotation encoding="application/x-tex">V={\mathbb{Q}}(\sqrt{b})^{2^{d}}</annotation></semantics></math> becomes a representation of <math id="S3.p3.m16" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.
Under (<a href="#S3.E1" title="In 3. Families of abelian varieties over a Shimura curve ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>), <math id="S3.p3.m17" class="ltx_Math" alttext="V\otimes_{\mathbb{Q}}{\mathbb{R}}\cong{\mathbb{R}}^{2}\otimes_{\mathbb{R}}V^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℚ</mi></msub><mi>ℝ</mi></mrow><mo>≅</mo><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℝ</mi></msub><msup><mi>V</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">V\otimes_{\mathbb{Q}}{\mathbb{R}}\cong{\mathbb{R}}^{2}\otimes_{\mathbb{R}}V^{\prime}</annotation></semantics></math>, where <math id="S3.p3.m18" class="ltx_Math" alttext="{\mathbb{R}}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\mathbb{R}}^{2}</annotation></semantics></math> is the standard representation
of <math id="S3.p3.m19" class="ltx_Math" alttext="SL_{2}({\mathbb{R}})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">SL_{2}({\mathbb{R}})</annotation></semantics></math>, and the second factor</p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_Math" alttext="V^{\prime}=\begin{cases}{\mathbb{R}}^{2^{d-1}}&amp;\text{if $\Cor(D)$ splits}\\
{\mathbb{R}}^{2^{d}}&amp;\text{otherwise}\end{cases}" display="block" intent=":literal"><semantics><mrow><msup><mi>V</mi><mo>′</mo></msup><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><msup><mi>ℝ</mi><msup><mn>2</mn><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mo rspace="0em">Cor</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mtext> splits</mtext></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><msup><mi>ℝ</mi><msup><mn>2</mn><mi>d</mi></msup></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">V^{\prime}=\begin{cases}{\mathbb{R}}^{2^{d-1}}&amp;\text{if $\Cor(D)$ splits}\\
{\mathbb{R}}^{2^{d}}&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p3.3" class="ltx_p">is a representation of <math id="S3.p3.m20" class="ltx_Math" alttext="SU_{2}^{d-1}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">SU_{2}^{d-1}</annotation></semantics></math>. The representation <math id="S3.p3.m21" class="ltx_Math" alttext="V^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mo>′</mo></msup><annotation encoding="application/x-tex">V^{\prime}</annotation></semantics></math> has no trivial factors,
so it carries an <math id="S3.p3.m22" class="ltx_Math" alttext="SU_{2}^{d-1}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">SU_{2}^{d-1}</annotation></semantics></math>-invariant inner product <math id="S3.p3.m23" class="ltx_Math" alttext="Q_{2}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>2</mn></msub><annotation encoding="application/x-tex">Q_{2}</annotation></semantics></math>,
which unique up to a scalar factor.
The complex representation</p>
<table id="S3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex5.m1" class="ltx_Math" alttext="V^{\prime}\otimes{\mathbb{C}}\cong\begin{cases}V_{2}\otimes\ldots\otimes V_{d-1}&amp;\text{if $\Cor(D)$ splits}\\
(V_{2}\otimes\ldots\otimes V_{d-1})^{\oplus 2}&amp;\text{otherwise}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>V</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow><mo>≅</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>V</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>V</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mo rspace="0em">Cor</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mtext> splits</mtext></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>V</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mn>2</mn></mrow></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">V^{\prime}\otimes{\mathbb{C}}\cong\begin{cases}V_{2}\otimes\ldots\otimes V_{d-1}&amp;\text{if $\Cor(D)$ splits}\\
(V_{2}\otimes\ldots\otimes V_{d-1})^{\oplus 2}&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p3.4" class="ltx_p">where <math id="S3.p3.m24" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> is the standard representation of <math id="S3.p3.m25" class="ltx_Math" alttext="SL_{2}({\mathbb{C}})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">SL_{2}({\mathbb{C}})</annotation></semantics></math> acting through the <math id="S3.p3.m26" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th factor of (<a href="#S3.E2" title="In 3. Families of abelian varieties over a Shimura curve ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>).
Let <math id="S3.p3.m27" class="ltx_Math" alttext="Q_{1}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>1</mn></msub><annotation encoding="application/x-tex">Q_{1}</annotation></semantics></math> denote the standard symplectic form on <math id="S3.p3.m28" class="ltx_Math" alttext="{\mathbb{R}}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\mathbb{R}}^{2}</annotation></semantics></math>.
A multiple of <math id="S3.p3.m29" class="ltx_Math" alttext="Q_{1}\otimes Q_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>Q</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">Q_{1}\otimes Q_{2}</annotation></semantics></math> will be a <math id="S3.p3.m30" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant <math id="S3.p3.m31" class="ltx_Math" alttext="{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">{\mathbb{Q}}</annotation></semantics></math> or <math id="S3.p3.m32" class="ltx_Math" alttext="{\mathbb{Q}}(\sqrt{b})" display="inline" intent=":literal"><semantics><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>b</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{Q}}(\sqrt{b})</annotation></semantics></math>-valued symplectic form <math id="S3.p3.m33" class="ltx_Math" alttext="Q_{3}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>3</mn></msub><annotation encoding="application/x-tex">Q_{3}</annotation></semantics></math> on <math id="S3.p3.m34" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>.
Setting <math id="S3.p3.m35" class="ltx_Math" alttext="Q=Q_{3}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><msub><mi>Q</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">Q=Q_{3}</annotation></semantics></math> in the first case, or <math id="S3.p3.m36" class="ltx_Math" alttext="Q=\tr_{{\mathbb{Q}}(\sqrt{b})/{\mathbb{Q}}}\circ Q_{3}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">tr</mo><mrow><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>b</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>ℚ</mi></mrow></msub><mo lspace="0em" rspace="0.222em">∘</mo><msub><mi>Q</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">Q=\tr_{{\mathbb{Q}}(\sqrt{b})/{\mathbb{Q}}}\circ Q_{3}</annotation></semantics></math> in the second gives an invariant <math id="S3.p3.m37" class="ltx_Math" alttext="{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">{\mathbb{Q}}</annotation></semantics></math>-valued form.
Hence, we have an injective homomorphism
of algebraic groups <math id="S3.p3.m38" class="ltx_Math" alttext="\rho:G\to Sp(V,{\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>G</mi><mo stretchy="false">→</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:G\to Sp(V,{\mathbb{Q}})</annotation></semantics></math>. This extends to a map of Shimura data, so <math id="S3.p3.m39" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is of Hodge type. Note that <math id="S3.p3.m40" class="ltx_Math" alttext="Sp(V,{\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Sp(V,{\mathbb{Q}})</annotation></semantics></math> is
isomorphic to <math id="S3.p3.m41" class="ltx_Math" alttext="Sp_{2^{d}}({\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><msup><mn>2</mn><mi>d</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Sp_{2^{d}}({\mathbb{Q}})</annotation></semantics></math> or <math id="S3.p3.m42" class="ltx_Math" alttext="Sp_{2^{d+1}}({\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><msup><mn>2</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Sp_{2^{d+1}}({\mathbb{Q}})</annotation></semantics></math> depending on the cases.
We summarize this discussion, along with some additional facts from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx34" title="" class="ltx_ref">VZ</a>, lemma 5.8, p 272]</cite>.</p>
</div>
<div id="S3.Thmthm1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm1.1" class="ltx_text ltx_font_bold">Theorem 3.1</span></span><span id="S3.Thmthm1.2" class="ltx_text ltx_font_bold"> </span>(Viehweg-Zuo)<span id="S3.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm1.p1" class="ltx_para">
<p id="S3.Thmthm1.p1.1" class="ltx_p"><span id="S3.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">There is an abelian scheme <math id="S3.Thmthm1.p1.m1" class="ltx_Math" alttext="f:\mathcal{A}\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathcal{A}\to Y</annotation></semantics></math> such that:</span></p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p"><span id="S3.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">The relative dimension of </span><math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math><span id="S3.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> is either </span><math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="2^{d-1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{d-1}</annotation></semantics></math><span id="S3.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">, if </span><math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="\Cor(D)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Cor</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Cor(D)</annotation></semantics></math><span id="S3.I1.i1.p1.1.4" class="ltx_text ltx_font_italic">
splits, or </span><math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="2^{d}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>d</mi></msup><annotation encoding="application/x-tex">2^{d}</annotation></semantics></math><span id="S3.I1.i1.p1.1.5" class="ltx_text ltx_font_italic"> otherwise.</span></p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p"><span id="S3.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">The local system </span><math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="R^{1}f_{*}{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">R^{1}f_{*}{\mathbb{Q}}</annotation></semantics></math><span id="S3.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> corresponds to a representation</span></p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex6.m1.pic1" class="ltx_picture ltx_markedasmath" height="65.78" overflow="visible" style="vertical-align:-51.42750310521741px" version="1.1" viewBox="9.59 51.43 102.90 65.78" width="102.90"><g transform="matrix(1 0 0 -1 9.590762275473052 65.78336963518964) translate(0,3.54) translate(9.59,0)"><g transform="translate(-8.48,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:0.63em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="8.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex6.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{\Gamma\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\textstyle{\Gamma\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 8.475183698338263 -0.27673578005007266 L 8.475183698338263 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(27.01,0) translate(0,7.18) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex6.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\rho}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">ρ</mi><annotation encoding="application/x-tex">\scriptstyle{\rho}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(42.8,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 8.475183698338263 -0.27673578005007266 L 42.79956260756106 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 42.79956260756106 -0.27673578005007266 L 42.79956260756106 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -7.687203531461879 L 0.27673578005007266 -7.687203531461879" fill="none" stroke="#000000"></path><g transform="translate(0,-33.67)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.6700477457581 L 0.27673578005007266 -7.687203531461879" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.6700477457581 L 0.27673578005007266 -33.6700477457581" fill="none" stroke="#000000"></path><g transform="translate(42.8,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:3.05em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="42.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex6.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{GL(V)}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{GL(V)}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(-9.59,0) translate(0,-43.74) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:0.79em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex6.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{G\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">\textstyle{G\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.590762275473052 -37.577496997479074 L 9.595111674320258 -37.566581273187786" fill="none" stroke="#000000"></path><g transform="translate(50.71,0) translate(0,-11.15)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -7.32 -1.41" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -4.32 -6.07" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.590762275473052 -37.577496997479074 L 50.712934879077594 -11.14645356605438" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 50.70505951126202 -11.15329436812474 L 50.712934879077594 -11.14645356605438" fill="none" stroke="#000000"></path></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I1.i2.p1.2" class="ltx_p"><span id="S3.I1.i2.p1.2.1" class="ltx_text ltx_font_italic">such that:</span></p>
<ol id="S3.I1.i2.I1" class="ltx_enumerate">
<li id="S3.I1.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S3.I1.i2.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i1.p1.1" class="ltx_p"><span id="S3.I1.i2.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">The representation of </span><math id="S3.I1.i2.I1.i1.p1.m1" class="ltx_Math" alttext="G({\mathbb{R}})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G({\mathbb{R}})</annotation></semantics></math><span id="S3.I1.i2.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> on </span><math id="S3.I1.i2.I1.i1.p1.m2" class="ltx_Math" alttext="V\otimes{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">V\otimes{\mathbb{R}}</annotation></semantics></math><span id="S3.I1.i2.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> is a tensor product </span><math id="S3.I1.i2.I1.i1.p1.m3" class="ltx_Math" alttext="{\mathbb{R}}^{2}\otimes V^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>V</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{R}}^{2}\otimes V^{\prime}</annotation></semantics></math><span id="S3.I1.i2.I1.i1.p1.1.4" class="ltx_text ltx_font_italic">,
where </span><math id="S3.I1.i2.I1.i1.p1.m4" class="ltx_Math" alttext="{\mathbb{R}}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\mathbb{R}}^{2}</annotation></semantics></math><span id="S3.I1.i2.I1.i1.p1.1.5" class="ltx_text ltx_font_italic"> is the standard representation of </span><math id="S3.I1.i2.I1.i1.p1.m5" class="ltx_Math" alttext="SL_{2}({\mathbb{R}})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">SL_{2}({\mathbb{R}})</annotation></semantics></math><span id="S3.I1.i2.I1.i1.p1.1.6" class="ltx_text ltx_font_italic">, and </span><math id="S3.I1.i2.I1.i1.p1.m6" class="ltx_Math" alttext="V^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mo>′</mo></msup><annotation encoding="application/x-tex">V^{\prime}</annotation></semantics></math><span id="S3.I1.i2.I1.i1.p1.1.7" class="ltx_text ltx_font_italic"> is an orthogonal representation of the remaining
factor of (</span><a href="#S3.E1" title="In 3. Families of abelian varieties over a Shimura curve ‣ Hodge cycles and the Leray filtration" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">3.1</span></a><span id="S3.I1.i2.I1.i1.p1.1.8" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="S3.I1.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S3.I1.i2.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i2.p1.1" class="ltx_p"><span id="S3.I1.i2.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">The representation of </span><math id="S3.I1.i2.I1.i2.p1.m1" class="ltx_Math" alttext="G({\mathbb{C}})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G({\mathbb{C}})</annotation></semantics></math><span id="S3.I1.i2.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> on </span><math id="S3.I1.i2.I1.i2.p1.m2" class="ltx_Math" alttext="V\otimes{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">V\otimes{\mathbb{C}}</annotation></semantics></math><span id="S3.I1.i2.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> is isomorphic to a sum of one (if </span><math id="S3.I1.i2.I1.i2.p1.m3" class="ltx_Math" alttext="\Cor(D)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Cor</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Cor(D)</annotation></semantics></math><span id="S3.I1.i2.I1.i2.p1.1.4" class="ltx_text ltx_font_italic"> splits) or two
copies (otherwise) of </span><math id="S3.I1.i2.I1.i2.p1.m4" class="ltx_Math" alttext="V_{1}\otimes\ldots\otimes V_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>V</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">V_{1}\otimes\ldots\otimes V_{d}</annotation></semantics></math><span id="S3.I1.i2.I1.i2.p1.1.5" class="ltx_text ltx_font_italic">, where </span><math id="S3.I1.i2.I1.i2.p1.m5" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math><span id="S3.I1.i2.I1.i2.p1.1.6" class="ltx_text ltx_font_italic"> is the standard representation of the </span><math id="S3.I1.i2.I1.i2.p1.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="S3.I1.i2.I1.i2.p1.1.7" class="ltx_text ltx_font_italic">th factor of (</span><a href="#S3.E2" title="In 3. Families of abelian varieties over a Shimura curve ‣ Hodge cycles and the Leray filtration" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">3.2</span></a><span id="S3.I1.i2.I1.i2.p1.1.8" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
</ol>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i3.p1.1" class="ltx_p"><span id="S3.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">The Zariski closure of </span><math id="S3.I1.i3.p1.m1" class="ltx_Math" alttext="\rho(\Gamma)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(\Gamma)</annotation></semantics></math><span id="S3.I1.i3.p1.1.2" class="ltx_text ltx_font_italic"> and the special Mumford-Tate group of a very general fibre of </span><math id="S3.I1.i3.p1.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math><span id="S3.I1.i3.p1.1.3" class="ltx_text ltx_font_italic"> are both equal to </span><math id="S3.I1.i3.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S3.I1.i3.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S3.I1.i4.p1" class="ltx_para">
<p id="S3.I1.i4.p1.1" class="ltx_p"><span id="S3.I1.i4.p1.1.1" class="ltx_text ltx_font_italic">Corresponding to the decomposition in (2b), the graded Higgs bundle associated to the variation of Hodge structure </span><math id="S3.I1.i4.p1.m1" class="ltx_Math" alttext="R^{1}f_{*}{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">R^{1}f_{*}{\mathbb{C}}</annotation></semantics></math><span id="S3.I1.i4.p1.1.2" class="ltx_text ltx_font_italic">
is a tensor product</span></p>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="(E_{1}^{0}\oplus E_{1}^{1},\theta)\otimes(E_{2}^{0},0)\otimes\ldots\otimes(E_{d}^{0},0)" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>E</mi><mn>1</mn><mn>0</mn></msubsup><mo>⊕</mo><msubsup><mi>E</mi><mn>1</mn><mn>1</mn></msubsup></mrow><mo>,</mo><mi>θ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>E</mi><mn>2</mn><mn>0</mn></msubsup><mo>,</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>E</mi><mi>d</mi><mn>0</mn></msubsup><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(E_{1}^{0}\oplus E_{1}^{1},\theta)\otimes(E_{2}^{0},0)\otimes\ldots\otimes(E_{d}^{0},0)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I1.i4.p1.2" class="ltx_p"><span id="S3.I1.i4.p1.2.1" class="ltx_text ltx_font_italic">Furthermore, </span><math id="S3.I1.i4.p1.m2" class="ltx_Math" alttext="\theta:E_{1}^{1}\to E_{1}^{0}\otimes\Omega_{Y}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>E</mi><mn>1</mn><mn>1</mn></msubsup><mo stretchy="false">→</mo><mrow><msubsup><mi>E</mi><mn>1</mn><mn>0</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mn>1</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta:E_{1}^{1}\to E_{1}^{0}\otimes\Omega_{Y}^{1}</annotation></semantics></math><span id="S3.I1.i4.p1.2.2" class="ltx_text ltx_font_italic"> is an
isomorphism.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p">Let <math id="S3.p4.m1" class="ltx_Math" alttext="F:X\to Y" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">F:X\to Y</annotation></semantics></math> be the <math id="S3.p4.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-fold fibre product <math id="S3.p4.m3" class="ltx_math_unparsed" alttext="\mathcal{A}\times_{Y}\ldots\times_{Y}\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><mi>Y</mi></msub><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><mi>Y</mi></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">\mathcal{A}\times_{Y}\ldots\times_{Y}\mathcal{A}</annotation></semantics></math>.
We note that <math id="S3.p4.m4" class="ltx_Math" alttext="\mathcal{A}\to Y" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\mathcal{A}\to Y</annotation></semantics></math>, and therefore <math id="S3.p4.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, is defined over a number field <math id="S3.p4.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.
This follows from the theory of canonical models <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">Mi</a>]</cite>, although we should
point out that since we are working with connected Shimura varieties, <math id="S3.p4.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> might be bigger than the reflex field.</p>
</div>
<div id="S3.Thmthm2" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm2.1" class="ltx_text ltx_font_bold">Theorem 3.2</span></span><span id="S3.Thmthm2.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm2.p1" class="ltx_para">
<p id="S3.Thmthm2.p1.1" class="ltx_p"><span id="S3.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">The Hodge and Tate conjectures holds for <math id="S3.Thmthm2.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.p5" class="ltx_para">
<p id="S3.p5.1" class="ltx_p">The proof follows the same basic strategy as the proof of
theorem <a href="#S2.Thmthm1" title="Theorem 2.1. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>. We first establish the preliminary results.</p>
</div>
<div id="S3.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmlemma1.1" class="ltx_text ltx_font_bold">Lemma 3.1</span></span><span id="S3.Thmlemma1.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmlemma1.p1" class="ltx_para">
<p id="S3.Thmlemma1.p1.1" class="ltx_p"><span id="S3.Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmlemma1.p1.m1" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> be standard representations of <math id="S3.Thmlemma1.p1.m2" class="ltx_Math" alttext="SL_{2}({\mathbb{C}})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">SL_{2}({\mathbb{C}})</annotation></semantics></math>, and let
<math id="S3.Thmlemma1.p1.m3" class="ltx_Math" alttext="V=V_{1}\otimes\ldots\otimes V_{d}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><msub><mi>V</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>V</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">V=V_{1}\otimes\ldots\otimes V_{d}</annotation></semantics></math> be viewed as an
<math id="S3.Thmlemma1.p1.m4" class="ltx_Math" alttext="H=SL_{2}({\mathbb{C}})^{d}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">H=SL_{2}({\mathbb{C}})^{d}</annotation></semantics></math>-module. Then invariant part of the tensor algebra</span></p>
<table id="S3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex8.m1" class="ltx_Math" alttext="(T^{*}V)^{H}" display="block" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow><mi>H</mi></msup><annotation encoding="application/x-tex">(T^{*}V)^{H}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmlemma1.p1.2" class="ltx_p"><span id="S3.Thmlemma1.p1.2.1" class="ltx_text ltx_font_italic">is generated by <math id="S3.Thmlemma1.p1.m5" class="ltx_Math" alttext="(V\otimes V)^{H}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow><mi>H</mi></msup><annotation encoding="application/x-tex">(V\otimes V)^{H}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p6" class="ltx_para">
<p id="S3.p6.1" class="ltx_p"><span id="S3.p6.1.1" class="ltx_text">We have an isomorphism</span></p>
<table id="S3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex9.m1" class="ltx_Math" alttext="(T^{*}V)^{H}=(T^{*}V_{1})^{SL_{2}({\mathbb{C}})}\otimes\ldots\otimes(T^{*}V_{d})^{SL_{2}({\mathbb{C}})}" display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow><mi>H</mi></msup><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mn>1</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo rspace="0.222em">⊗</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">(T^{*}V)^{H}=(T^{*}V_{1})^{SL_{2}({\mathbb{C}})}\otimes\ldots\otimes(T^{*}V_{d})^{SL_{2}({\mathbb{C}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p6.2" class="ltx_p"><span id="S3.p6.2.1" class="ltx_text">So the result follows from classical invariant theory <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx14" title="" class="ltx_ref">FH</a>, prop F.13]</cite>.
∎</span></p>
</div>
</div>
<div id="S3.Thmprop1" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmprop1.1" class="ltx_text ltx_font_bold">Proposition 3.1</span></span><span id="S3.Thmprop1.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmprop1.p1" class="ltx_para">
<p id="S3.Thmprop1.p1.1" class="ltx_p"><span id="S3.Thmprop1.p1.1.1" class="ltx_text ltx_font_italic">The cycle maps</span></p>
<table id="S3.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex10.m1" class="ltx_Math" alttext="\Box^{p,i}:Gr^{i}_{L}CH^{p}(X)\to H^{i}(Y,R^{2p-i}F_{*}{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Box^{p,i}:Gr^{i}_{L}CH^{p}(X)\to H^{i}(Y,R^{2p-i}F_{*}{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmprop1.p1.2" class="ltx_p"><span id="S3.Thmprop1.p1.2.1" class="ltx_text ltx_font_italic">are surjective for <math id="S3.Thmprop1.p1.m1" class="ltx_Math" alttext="i=0,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=0,2</annotation></semantics></math> and all <math id="S3.Thmprop1.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p"><span id="S3.p7.1.1" class="ltx_text">We first treat the case of <math id="S3.p7.m1" class="ltx_Math" alttext="i=0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i=0</annotation></semantics></math>. The surjectivity of <math id="S3.p7.m2" class="ltx_Math" alttext="\Box^{0,0}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msup><annotation encoding="application/x-tex">\Box^{0,0}</annotation></semantics></math>
is trivially true, and the surjectivity of <math id="S3.p7.m3" class="ltx_Math" alttext="\Box^{1,0}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msup><annotation encoding="application/x-tex">\Box^{1,0}</annotation></semantics></math>
is a consequence of the Lefschetz <math id="S3.p7.m4" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math> theorem. We have that
<math id="S3.p7.m5" class="ltx_math_unparsed" alttext="R^{i}f_{*}{\mathbb{Q}}=\wedge^{i}R^{1}f_{*}{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><msup><mrow></mrow><mi>i</mi></msup><mi>f</mi><msub><mrow></mrow><mo>∗</mo></msub><mi>ℚ</mi><mo rspace="0em">=</mo><mo lspace="0em">∧</mo><msup><mrow></mrow><mi>i</mi></msup><mi>R</mi><msup><mrow></mrow><mn>1</mn></msup><mi>f</mi><msub><mrow></mrow><mo>∗</mo></msub><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">R^{i}f_{*}{\mathbb{Q}}=\wedge^{i}R^{1}f_{*}{\mathbb{Q}}</annotation></semantics></math>. This together with the Künneth
formula and lemma <a href="#S3.Thmlemma1" title="Lemma 3.1. ‣ 3. Families of abelian varieties over a Shimura curve ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> implies that the product map</span></p>
<table id="S3.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex11.m1" class="ltx_Math" alttext="S^{p}H^{0}(Y,R^{2}F_{*}{\mathbb{Q}})\to H^{0}(Y,R^{2p}F_{*}{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>S</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S^{p}H^{0}(Y,R^{2}F_{*}{\mathbb{Q}})\to H^{0}(Y,R^{2p}F_{*}{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.2" class="ltx_p"><span id="S3.p7.2.1" class="ltx_text">is surjective. Therefore</span></p>
<table id="S3.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex12.m1" class="ltx_Math" alttext="S^{p}Gr^{0}_{L}CH^{1}(X)\to H^{0}(Y,R^{2p}F_{*}{\mathbb{Q}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>S</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S^{p}Gr^{0}_{L}CH^{1}(X)\to H^{0}(Y,R^{2p}F_{*}{\mathbb{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.3" class="ltx_p"><span id="S3.p7.3.1" class="ltx_text">is surjective. This implies the surjectivity of <math id="S3.p7.m6" class="ltx_Math" alttext="\Box^{p,0}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mn>0</mn></mrow></msup><annotation encoding="application/x-tex">\Box^{p,0}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.p8" class="ltx_para">
<p id="S3.p8.1" class="ltx_p"><span id="S3.p8.1.1" class="ltx_text">We have the commutative diagram</span></p>
<table id="S3.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex13.m1.pic1" class="ltx_picture ltx_markedasmath" height="73.17" overflow="visible" style="vertical-align:-56.23358883137886px" version="1.1" viewBox="50.66 56.23 237.84 73.17" width="237.84"><g transform="matrix(1 0 0 -1 50.657300578289316 73.17010571522157) translate(0,3.46) translate(50.66,0)"><g transform="translate(-43.65,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.71em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex13.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{Gr^{0}_{L}CH^{p}(X)\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{Gr^{0}_{L}CH^{p}(X)\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 43.65229814465287 -0.27673578005007266 L 43.65229814465287 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(52.64,0) translate(0,8.47) translate(4.15,0) translate(0,-4.32)"><foreignObject style="--ltx-fo-width:1.59em;--ltx-fo-height:0.62em;--ltx-fo-depth:0em;font-size:10pt;" height="8.63" overflow="visible" transform="matrix(1 0 0 -1 0 8.63)" width="21.95"><span class="ltx_fo