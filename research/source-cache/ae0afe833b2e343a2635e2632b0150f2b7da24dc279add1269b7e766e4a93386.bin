.47em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="6.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex28.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\pi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">π</mi><annotation encoding="application/x-tex">\scriptstyle{\pi}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(90.38,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 56.98616151346513 -0.27673578005007266 L 90.37514519391259 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 90.37514519391259 -0.27673578005007266 L 90.37514519391259 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.069600110696001 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(0,-22.77) translate(4.15,0) translate(0,-3.07)"><foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.14em;font-size:10pt;" height="9.9" overflow="visible" transform="matrix(1 0 0 -1 0 8.02)" width="9.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex28.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{\eta^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em">η</mi><mo mathsize="0.710em">′</mo></msup><annotation encoding="application/x-tex">\scriptstyle{\eta^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-33.42)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.41831045228613 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.41831045228613 L 0.27673578005007266 -33.41831045228613" fill="none" stroke="#000000"></path><g transform="translate(90.38,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:9.34em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="129.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex28.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{Gr^{W}_{2p}H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{Gr^{W}_{2p}H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 158.8559444306615 -11.569253138458645 L 159.40941599076163 -11.569253138458645" fill="none" stroke="#000000"></path><g transform="translate(159.13,0) translate(0,-22.77) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex28.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\eta}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">η</mi><annotation encoding="application/x-tex">\scriptstyle{\eta}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(159.13,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 158.8559444306615 -33.208800332088 L 159.40941599076163 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 158.8559444306615 -33.208800332088 L 159.40941599076163 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-57.08,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.65em;--ltx-fo-height:0.83em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.89" overflow="visible" transform="matrix(1 0 0 -1 0 11.43)" width="105.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex28.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{IH^{\iota}(Y,R^{2p-i}f_{*}{\mathbb{Q}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>ι</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{IH^{\iota}(Y,R^{2p-i}f_{*}{\mathbb{Q}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 57.07625318764486 -45.817433113508805 L 57.07625318764486 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(72.18,0) translate(0,-39.3) translate(4.15,0) translate(0,-2.09)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="6.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex28.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\pi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">π</mi><annotation encoding="application/x-tex">\scriptstyle{\pi}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(90.29,0) translate(0,-45.54)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 57.07625318764486 -45.817433113508805 L 90.28505351973286 -45.263961553408656" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 90.28505351973286 -45.817433113508805 L 90.28505351973286 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(90.29,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:9.35em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="129.39"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex28.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{Gr^{W}_{2q}H^{\iota}(U,R^{2p-i}f_{*}{\mathbb{Q}})}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>ι</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{Gr^{W}_{2q}H^{\iota}(U,R^{2p-i}f_{*}{\mathbb{Q}})}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p15.2" class="ltx_p"><span id="S1.p15.2.1" class="ltx_text">where the vertical maps are given by the product
with <math id="S1.p15.m16" class="ltx_Math" alttext="c_{1}({\mathcal{O}}_{Y}(1))^{m-i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>Y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">c_{1}({\mathcal{O}}_{Y}(1))^{m-i}</annotation></semantics></math>. The map <math id="S1.p15.m17" class="ltx_Math" alttext="\eta^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>η</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\eta^{\prime}</annotation></semantics></math> is an isomorphism by the hard Lefschetz
for intersection cohomology <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx4" title="" class="ltx_ref">BBD</a>, 6.2.10]</cite>. The maps labelled by
<math id="S1.p15.m18" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> are the natural ones; these are surjective by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx26" title="" class="ltx_ref">PS</a>]</cite> (plus the
comparison theorem in <math id="S1.p15.m19" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic case). These
facts imply that <math id="S1.p15.m20" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is surjective. Now consider the diagram</span></p>
<table id="S1.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S1.Ex29.m1.pic1" class="ltx_picture ltx_markedasmath" height="73.49" overflow="visible" style="vertical-align:-56.400766210369966px" version="1.1" viewBox="42.95 56.40 345.24 73.49" width="345.24"><g transform="matrix(1 0 0 -1 42.95084145581457 73.4896598489713) translate(0,3.46) translate(42.95,0)"><g transform="translate(-42.95,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.61em;--ltx-fo-height:0.83em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.89" overflow="visible" transform="matrix(1 0 0 -1 0 11.43)" width="77.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex29.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{Gr^{i}_{L}CH^{p}(V)\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{Gr^{i}_{L}CH^{p}(V)\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 42.9508625694012 -0.27673578005007266 L 42.9508625694012 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(78.31,0) translate(0,8.54) translate(4.15,0) translate(0,-4.39)"><foreignObject style="--ltx-fo-width:1.51em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.79" overflow="visible" transform="matrix(1 0 0 -1 0 8.79)" width="20.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex29.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\Box^{p,i}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em" mathvariant="normal">□</mi><mrow><mi mathsize="0.710em">p</mi><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">i</mi></mrow></msup><annotation encoding="application/x-tex">\scriptstyle{\Box^{p,i}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(101.24,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 42.9508625694012 -0.27673578005007266 L 101.23519295723719 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 101.23519295723719 -0.27673578005007266 L 101.23519295723719 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.069600110696001 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(0,-34.26)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.261565988977964 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.261565988977964 L 0.27673578005007266 -34.261565988977964" fill="none" stroke="#000000"></path><g transform="translate(101.24,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:12.12em;--ltx-fo-height:0.83em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.89" overflow="visible" transform="matrix(1 0 0 -1 0 11.43)" width="167.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex29.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\Hodge(H^{i}(U,R^{2p-i}f_{*}{\mathbb{Q}})(p))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 188.9490972370862 -11.069600110696001 L 189.50256879718634 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(189.23,0) translate(0,-22.67) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex29.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\eta}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">η</mi><annotation encoding="application/x-tex">\scriptstyle{\eta}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(189.23,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 188.9490972370862 -33.20877921850137 L 189.50256879718634 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 188.9490972370862 -33.20877921850137 L 189.50256879718634 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(-42.81,0) translate(0,-45.33) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.59em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="77.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex29.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{Gr^{\iota}_{L}CH^{q}(V)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>ι</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{Gr^{\iota}_{L}CH^{q}(V)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 42.80832474601538 -45.60790187972404 L 42.80832474601538 -45.05443031962389" fill="none" stroke="#000000"></path><g transform="translate(53.34,0) translate(0,-37.58) translate(4.15,0) translate(0,-3.6)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.52em;--ltx-fo-depth:0em;font-size:10pt;" height="7.21" overflow="visible" transform="matrix(1 0 0 -1 0 7.21)" width="20.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex29.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\Box^{q,\iota}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em" mathvariant="normal">□</mi><mrow><mi mathsize="0.710em">q</mi><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">ι</mi></mrow></msup><annotation encoding="application/x-tex">\scriptstyle{\Box^{q,\iota}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(76.16,0) translate(0,-45.33)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 42.80832474601538 -45.60790187972404 L 76.15964178790257 -45.05443031962389" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 76.15964178790257 -45.60790187972404 L 76.15964178790257 -45.05443031962389" fill="none" stroke="#000000"></path><g transform="translate(76.16,0) translate(0,-45.33) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:15.74em;--ltx-fo-height:0.83em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.89" overflow="visible" transform="matrix(1 0 0 -1 0 11.43)" width="217.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex29.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{\Hodge(H^{\iota}(U,R^{2p-i}f_{*}{\mathbb{Q}}))(p+m-i))}" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo lspace="0em" rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>ι</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>m</mi></mrow><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\textstyle{\Hodge(H^{\iota}(U,R^{2p-i}f_{*}{\mathbb{Q}}))(p+m-i))}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p15.3" class="ltx_p"><span id="S1.p15.3.1" class="ltx_text">where the vertical maps are again products with
<math id="S1.p15.m21" class="ltx_Math" alttext="c_{1}({\mathcal{O}}(1))^{m-i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">c_{1}({\mathcal{O}}(1))^{m-i}</annotation></semantics></math>. Since <math id="S1.p15.m22" class="ltx_Math" alttext="\Box^{p,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{p,i}</annotation></semantics></math> is surjective by assumption, and
<math id="S1.p15.m23" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is surjective by what we just proved, we can
conclude that <math id="S1.p15.m24" class="ltx_Math" alttext="\Box^{q,\iota}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>q</mi><mo>,</mo><mi>ι</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{q,\iota}</annotation></semantics></math> is surjective. Therefore the surjectivity condition
is preserved by the reflection <math id="S1.p15.m25" class="ltx_Math" alttext="(p,i)\mapsto(q,\iota)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>ι</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(p,i)\mapsto(q,\iota)</annotation></semantics></math>, and this
completes the proof.</span></p>
</div>
<div id="S1.p16" class="ltx_para">
<p id="S1.p16.1" class="ltx_p"><span id="S1.p16.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S1.Thmthm3" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmthm3.1" class="ltx_text ltx_font_bold">Remark 1.3</span></span><span id="S1.Thmthm3.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S1.Thmthm3.p1" class="ltx_para">
<p id="S1.Thmthm3.p1.1" class="ltx_p"><span id="S1.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">It is easy to see using a modification of (<a href="#S1.E2" title="In Proof. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a>) that conversely, if the Hodge conjecture holds for
<math id="S1.Thmthm3.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, then the <math id="S1.Thmthm3.p1.m2" class="ltx_Math" alttext="\Box^{p,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{p,i}</annotation></semantics></math> must surject onto the space of Hodge cycles
for all <math id="S1.Thmthm3.p1.m3" class="ltx_Math" alttext="(p,i)\in P" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">(p,i)\in P</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S1.Thmthm4" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmthm4.1" class="ltx_text ltx_font_bold">Corollary 1.4</span></span><span id="S1.Thmthm4.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S1.Thmthm4.p1" class="ltx_para">
<p id="S1.Thmthm4.p1.1" class="ltx_p"><span id="S1.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">Suppose that <math id="S1.Thmthm4.p1.m1" class="ltx_Math" alttext="\dim X=4" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">\dim X=4</annotation></semantics></math>, and <math id="S1.Thmthm4.p1.m2" class="ltx_Math" alttext="\dim Y=m" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>Y</mi></mrow><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">\dim Y=m</annotation></semantics></math>. If the cycle map</span></p>
<table id="S1.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex30.m1" class="ltx_Math" alttext="\Box^{2,m}:Gr^{m}_{L}CH^{2}(V)\to\Hodge(H^{m}(U,R^{4-m}f_{*}{\mathbb{Q}})(2))" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">□</mi><mrow><mn>2</mn><mo>,</mo><mi>m</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>m</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em" stretchy="false">→</mo><mrow><mo lspace="0.1389em" rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mn>4</mn><mo>−</mo><mi>m</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Box^{2,m}:Gr^{m}_{L}CH^{2}(V)\to\Hodge(H^{m}(U,R^{4-m}f_{*}{\mathbb{Q}})(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.Thmthm4.p1.2" class="ltx_p"><span id="S1.Thmthm4.p1.2.1" class="ltx_text ltx_font_italic">is surjective, then the Hodge conjecture holds for <math id="S1.Thmthm4.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.
In particular, this is the case if
<math id="S1.Thmthm4.p1.m4" class="ltx_Math" alttext="\Hodge(H^{m}(U,R^{4-m}f_{*}{\mathbb{Q}})(2))=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mrow><mn>4</mn><mo>−</mo><mi>m</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Hodge(H^{m}(U,R^{4-m}f_{*}{\mathbb{Q}})(2))=0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S1.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S1.p17" class="ltx_para">
<p id="S1.p17.1" class="ltx_p"><span id="S1.p17.1.1" class="ltx_text">It is well known that the Hodge conjecture holds for smooth
projective varieties of dimension at most three (by the Lefschetz
<math id="S1.p17.m1" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math> theorem, and the hard Lefschetz theorem). Therefore by
theorem <a href="#S1.Thmthm1" title="Theorem 1.1 (Jannsen). ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>, it holds for <math id="S1.p17.m2" class="ltx_Math" alttext="X-V" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>−</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">X-V</annotation></semantics></math>. So by
lemma <a href="#S1.Thmlemma2" title="Lemma 1.2. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a>, it suffices to prove the conjecture
for <math id="S1.p17.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>. Applying theorem <a href="#S1.Thmthm2" title="Theorem 1.2. ‣ 1. Hodge cycles and the Leray filtration ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a>, we have to check the surjectivity for
<math id="S1.p17.m4" class="ltx_Math" alttext="\Box^{p,i}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">\Box^{p,i}</annotation></semantics></math> for <math id="S1.p17.m5" class="ltx_Math" alttext="(p,i)\in Q" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">(p,i)\in Q</annotation></semantics></math>. For <math id="S1.p17.m6" class="ltx_Math" alttext="p=0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p=0</annotation></semantics></math>, this trivial, and for <math id="S1.p17.m7" class="ltx_Math" alttext="p=1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p=1</annotation></semantics></math>, this follows from the
Lefschetz <math id="S1.p17.m8" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math> theorem. It is easy to check by plotting <math id="S1.p17.m9" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, that
in each of the cases <math id="S1.p17.m10" class="ltx_Math" alttext="m=1,2,3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">m=1,2,3</annotation></semantics></math>,
there is exactly one point in <math id="S1.p17.m11" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> with <math id="S1.p17.m12" class="ltx_Math" alttext="p&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p&gt;1</annotation></semantics></math>, namely <math id="S1.p17.m13" class="ltx_Math" alttext="(2,1),(2,2),(2,3)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(2,1),(2,2),(2,3)</annotation></semantics></math> respectively.</span></p>
</div>
<div id="S1.p18" class="ltx_para">
<p id="S1.p18.1" class="ltx_p"><span id="S1.p18.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S1.p19" class="ltx_para">
<p id="S1.p19.1" class="ltx_p">When <math id="S1.p19.m1" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> is the moduli space of genus two curves with fine level structure, and
<math id="S1.p19.m2" class="ltx_Math" alttext="f:X\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:X\to Y</annotation></semantics></math> the universal family of curves, then <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">A2</a>, cor 3.2]</cite> shows that</p>
<table id="S1.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex31.m1" class="ltx_Math" alttext="\Hodge(H^{3}(U,R^{1}f_{*}{\mathbb{Q}})(2))\subset Gr_{F}^{2}H^{3}(U,R^{1}f_{*}{\mathbb{C}})=0" display="block" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Hodge(H^{3}(U,R^{1}f_{*}{\mathbb{Q}})(2))\subset Gr_{F}^{2}H^{3}(U,R^{1}f_{*}{\mathbb{C}})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p19.2" class="ltx_p">Therefore the Hodge conjecture holds for <math id="S1.p19.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.
The corollary also implies a result of Conte and Murre <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx5" title="" class="ltx_ref">CM</a>]</cite>
that the Hodge conjecture holds for uniruled fourfolds.
Similarly, the conjecture holds for fourfolds fibred by surfaces with
trivial geometric genus:</p>
</div>
<div id="S1.Thmthm5" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmthm5.1" class="ltx_text ltx_font_bold">Corollary 1.5</span></span><span id="S1.Thmthm5.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S1.Thmthm5.p1" class="ltx_para">
<p id="S1.Thmthm5.p1.1" class="ltx_p"><span id="S1.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">Suppose that <math id="S1.Thmthm5.p1.m1" class="ltx_Math" alttext="\dim X=4" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">\dim X=4</annotation></semantics></math>, and <math id="S1.Thmthm5.p1.m2" class="ltx_Math" alttext="\dim Y=2" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>Y</mi></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\dim Y=2</annotation></semantics></math>, and the general fibre of <math id="S1.Thmthm5.p1.m3" class="ltx_Math" alttext="f:X\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:X\to Y</annotation></semantics></math> is a surface with <math id="S1.Thmthm5.p1.m4" class="ltx_Math" alttext="p_{g}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>g</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{g}=0</annotation></semantics></math>.
Then the Hodge conjecture holds for <math id="S1.Thmthm5.p1.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S1.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S1.p20" class="ltx_para">
<p id="S1.p20.1" class="ltx_p"><span id="S1.p20.1.1" class="ltx_text">Given an irreducible component <math id="S1.p20.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> of the relative Hilbert scheme
<math id="S1.p20.m2" class="ltx_Math" alttext="Hilb_{X/Y}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>X</mi><mo>/</mo><mi>Y</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Hilb_{X/Y}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">Gr</a>, chap IV]</cite>, let <math id="S1.p20.m3" class="ltx_Math" alttext="\supp(T)\subseteq Y" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">supp</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\supp(T)\subseteq Y</annotation></semantics></math> denote its image in <math id="S1.p20.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>.
Let</span></p>
<table id="S1.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex32.m1" class="ltx_Math" alttext="C=\bigcup_{\supp(T)\subsetneqq Y}\supp(T)" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mrow><mo rspace="0em">supp</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⫋</mo><mi>Y</mi></mrow></munder><mrow><mo lspace="0em" rspace="0em">supp</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C=\bigcup_{\supp(T)\subsetneqq Y}\supp(T)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p20.2" class="ltx_p"><span id="S1.p20.2.1" class="ltx_text">as <math id="S1.p20.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> ranges over components of <math id="S1.p20.m6" class="ltx_Math" alttext="Hilb_{X/Y}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>X</mi><mo>/</mo><mi>Y</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Hilb_{X/Y}</annotation></semantics></math>.
Since <math id="S1.p20.m7" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is a countable union of proper subvarieties <math id="S1.p20.m8" class="ltx_Math" alttext="U-C\not=\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>−</mo><mi>C</mi></mrow><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">U-C\not=\emptyset</annotation></semantics></math>. Choose <math id="S1.p20.m9" class="ltx_Math" alttext="y\in U-C" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mrow><mi>U</mi><mo>−</mo><mi>C</mi></mrow></mrow><annotation encoding="application/x-tex">y\in U-C</annotation></semantics></math>. Since <math id="S1.p20.m10" class="ltx_Math" alttext="p_{g}(X_{y})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>y</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{g}(X_{y})=0</annotation></semantics></math>, by the Lefschetz <math id="S1.p20.m11" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math> theorem, there exist
irreducible divisors <math id="S1.p20.m12" class="ltx_Math" alttext="Z_{1},\ldots Z_{N}\subset X_{y}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mrow><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mi>N</mi></msub></mrow><mo>⊂</mo><msub><mi>X</mi><mi>y</mi></msub></mrow></mrow><annotation encoding="application/x-tex">Z_{1},\ldots Z_{N}\subset X_{y}</annotation></semantics></math> which span <math id="S1.p20.m13" class="ltx_Math" alttext="H^{2}(X_{y},{\mathbb{Q}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>y</mi></msub><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2}(X_{y},{\mathbb{Q}})</annotation></semantics></math>. Let
<math id="S1.p20.m14" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> be a component of <math id="S1.p20.m15" class="ltx_Math" alttext="Hilb_{X/Y}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>X</mi><mo>/</mo><mi>Y</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Hilb_{X/Y}</annotation></semantics></math> containing <math id="S1.p20.m16" class="ltx_Math" alttext="Z_{i}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>i</mi></msub><annotation encoding="application/x-tex">Z_{i}</annotation></semantics></math>. Then <math id="S1.p20.m17" class="ltx_Math" alttext="T_{i}\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">T_{i}\to Y</annotation></semantics></math>
is surjective. After replacing <math id="S1.p20.m18" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> by an intersection of ample
divisors we can assume that <math id="S1.p20.m19" class="ltx_Math" alttext="T_{i}\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">T_{i}\to Y</annotation></semantics></math> is generically finite.
Let <math id="S1.p20.m20" class="ltx_Math" alttext="\mathcal{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{Z}_{i}</annotation></semantics></math> denote the restriction of the universal family over <math id="S1.p20.m21" class="ltx_Math" alttext="Hilb_{X/Y}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>X</mi><mo>/</mo><mi>Y</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Hilb_{X/Y}</annotation></semantics></math> to <math id="S1.p20.m22" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math>.
Then <math id="S1.p20.m23" class="ltx_Math" alttext="\mathcal{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{Z}_{i}</annotation></semantics></math> is a relative divisor on <math id="S1.p20.m24" class="ltx_Math" alttext="X/Y" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>/</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">X/Y</annotation></semantics></math> such that <math id="S1.p20.m25" class="ltx_Math" alttext="[\mathcal{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\mathcal{Z}_{i}]</annotation></semantics></math> is
equal to a multiple of <math id="S1.p20.m26" class="ltx_Math" alttext="[Z_{i}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[Z_{i}]</annotation></semantics></math>. It follows that, after a finite base
change, <math id="S1.p20.m27" class="ltx_Math" alttext="[\mathcal{Z}_{1}],\ldots[\mathcal{Z}_{N}]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">𝒵</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>N</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[\mathcal{Z}_{1}],\ldots[\mathcal{Z}_{N}]</annotation></semantics></math> gives a basis of <math id="S1.p20.m28" class="ltx_Math" alttext="R^{2}f_{*}{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">R^{2}f_{*}{\mathbb{Q}}</annotation></semantics></math>, i.e. an isomorphism
<math id="S1.p20.m29" class="ltx_Math" alttext="{\mathbb{Q}}(-1)^{N}\cong R^{2}f_{*}{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{Q}}(-1)^{N}\cong R^{2}f_{*}{\mathbb{Q}}</annotation></semantics></math>. Therefore, we can identify</span></p>
<table id="S1.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex33.m1" class="ltx_Math" alttext="H^{2}(U,R^{2}f_{*}{\mathbb{Q}})\cong\bigoplus_{i}H^{2}(U,{\mathbb{Q}})\cup[\mathcal{Z}_{i}]" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≅</mo><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mi>i</mi></munder><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{2}(U,R^{2}f_{*}{\mathbb{Q}})\cong\bigoplus_{i}H^{2}(U,{\mathbb{Q}})\cup[\mathcal{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p20.3" class="ltx_p"><span id="S1.p20.3.1" class="ltx_text">The Lefschetz <math id="S1.p20.m30" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math> theorem now shows that</span></p>
<table id="S1.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex34.m1" class="ltx_Math" alttext="\Hodge(H^{2}(U,R^{2}f_{*}{\mathbb{Q}})(2))=\bigoplus_{i}\Hodge(H^{2}(U,{\mathbb{Q}})(1))\cup[\mathcal{Z}_{i}]" display="block" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mi>i</mi></munder><mrow><mo lspace="0em" rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">𝒵</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Hodge(H^{2}(U,R^{2}f_{*}{\mathbb{Q}})(2))=\bigoplus_{i}\Hodge(H^{2}(U,{\mathbb{Q}})(1))\cup[\mathcal{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p20.4" class="ltx_p"><span id="S1.p20.4.1" class="ltx_text">is spanned by algebraic cycles.</span></p>
</div>
<div id="S1.p21" class="ltx_para">
<p id="S1.p21.1" class="ltx_p"><span id="S1.p21.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S1.Thmthm6" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmthm6.1" class="ltx_text ltx_font_bold">Remark 1.6</span></span><span id="S1.Thmthm6.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S1.Thmthm6.p1" class="ltx_para">
<p id="S1.Thmthm6.p1.1" class="ltx_p"><span id="S1.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Define the transcendental part <math id="S1.Thmthm6.p1.m1" class="ltx_Math" alttext="T\subseteq R^{2}f_{*}{\mathbb{Q}}|_{U}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⊆</mo><msub><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℚ</mi></mrow><mo stretchy="false">|</mo></mrow><mi>U</mi></msub></mrow><annotation encoding="application/x-tex">T\subseteq R^{2}f_{*}{\mathbb{Q}}|_{U}</annotation></semantics></math> to be the smallest sub-variation of Hodge structure such <math id="S1.Thmthm6.p1.m2" class="ltx_Math" alttext="T_{y}^{20}=H^{20}(X_{y})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>y</mi><mn>20</mn></msubsup><mo>=</mo><mrow><msup><mi>H</mi><mn>20</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>y</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{y}^{20}=H^{20}(X_{y})</annotation></semantics></math> for some (hence all) <math id="S1.Thmthm6.p1.m3" class="ltx_Math" alttext="y\in U" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">y\in U</annotation></semantics></math>.
By essentially the same argument, the Hodge conjecture holds for <math id="S1.Thmthm6.p1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, if <math id="S1.Thmthm6.p1.m5" class="ltx_Math" alttext="\Hodge(H^{2}(U,T)(2))=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">Hodge</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Hodge(H^{2}(U,T)(2))=0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S1.Thmthm7" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmthm7.1" class="ltx_text ltx_font_bold">Corollary 1.7</span></span><span id="S1.Thmthm7.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S1.Thmthm7.p1" class="ltx_para">
<p id="S1.Thmthm7.p1.1" class="ltx_p"><span id="S1.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">Suppose that <math id="S1.Thmthm7.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is defined over <math id="S1.Thmthm7.p1.m2" class="ltx_Math" alttext="K\subset{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊂</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">K\subset{\mathbb{C}}</annotation></semantics></math>, and that <math id="S1.Thmthm7.p1.m3" class="ltx_Math" alttext="U=Y" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">U=Y</annotation></semantics></math>. Let <math id="S1.Thmthm7.p1.m4" class="ltx_Math" alttext="X_{\mathbb{C}}=X\times_{\Spec K}\Spec{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>ℂ</mi></msub><mo>=</mo><mrow><mi>X</mi><msub><mo lspace="0.222em">×</mo><mrow><mo rspace="0.167em">Spec</mo><mi>K</mi></mrow></msub><mrow><mo lspace="0.055em" rspace="0.167em">Spec</mo><mi>ℂ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{\mathbb{C}}=X\times_{\Spec K}\Spec{\mathbb{C}}</annotation></semantics></math> etc.
If</span></p>
<table id="S1.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex35.m1" class="ltx_Math" alttext="\Box^{p,i}:Gr^{i}_{L}CH^{p}(X_{\mathbb{C}})\otimes{\mathbb{C}}\to Gr^{p}_{F}H^{i}(Y_{{\mathbb{C}}},R^{2p-i}f_{{\mathbb{C}},*}{\mathbb{C}})" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">□</mi><mrow><mi>p</mi><mo>,</mo><mi>i</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>L</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℂ</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow><mo stretchy="false">→</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>ℂ</mi></msub><mo>,</mo><mrow><msup><mi>R</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi>ℂ</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Box^{p,i}:Gr^{i}_{L}CH^{p}(X_{\mathbb{C}})\otimes{\mathbb{C}}\to Gr^{p}_{F}H^{i}(Y_{{\mathbb{C}}},R^{2p-i}f_{{\mathbb{C}},*}{\mathbb{C}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.Thmthm7.p1.2" class="ltx_p"><span id="S1.Thmthm7.p1.2.1" class="ltx_text ltx_font_italic">is surjective for all <math id="S1.Thmthm7.p1.m5" class="ltx_Math" alttext="(p,i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,i)</annotation></semantics></math> in <math id="S1.Thmthm7.p1.m6" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, then the Hodge and Tate conjectures hold for <math id="S1.Thmthm7.p1.m7" class="ltx_Math" alttext="X_{\mathbb{C}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>ℂ</mi></msub><annotation encoding="application/x-tex">X_{\mathbb{C}}</annotation></semantics></math> and <math id="S1.Thmthm7.p1.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> respectively.</span></p>
</div>
</div>
<div id="S1.8" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S1.p22" class="ltx_para">
<p id="S1.p22.1" class="ltx_p"><span id="S1.p22.1.1" class="ltx_text">The statement for the Hodge conjecture is an immediate consequence of the theorem.
The assumption implies that</span></p>
<table id="S1.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex36.m1" class="ltx_Math" alttext="Gr^{p}_{F}H^{2p}(X_{\mathbb{C}},{\mathbb{C}})=H^{p}(\bar{X},\Omega_{\bar{X}}^{p})\otimes{\mathbb{C}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℂ</mi></msub><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>,</mo><msubsup><mi mathvariant="normal">Ω</mi><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mi>p</mi></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow></mrow><annotation encoding="application/x-tex">Gr^{p}_{F}H^{2p}(X_{\mathbb{C}},{\mathbb{C}})=H^{p}(\bar{X},\Omega_{\bar{X}}^{p})\otimes{\mathbb{C}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p22.2" class="ltx_p"><span id="S1.p22.2.1" class="ltx_text">is generated by a finite number of algebraic cycles on <math id="S1.p22.m1" class="ltx_Math" alttext="X_{\mathbb{C}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>ℂ</mi></msub><annotation encoding="application/x-tex">X_{\mathbb{C}}</annotation></semantics></math>, and therefore
a finite number of cycles on <math id="S1.p22.m2" class="ltx_Math" alttext="\bar{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{X}</annotation></semantics></math>. Tate’s conjecture is now a known consequence of Faltings’ theorem
on Hodge-Tate decompositions <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx11" title="" class="ltx_ref">F</a>]</cite>, which implies that</span></p>
<table id="S1.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex37.m1" class="ltx_Math" alttext="\dim\Tate(H^{2p}(\bar{X}_{et},{\mathbb{Q}}_{\ell})(p))\leq\dim H^{p}(\bar{X},\Omega_{\bar{X}}^{p})" display="block" intent=":literal"><semantics><mrow><mrow><mo rspace="0.0835em">dim</mo><mrow><mo lspace="0.0835em" rspace="0em">Tate</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.1389em">≤</mo><mrow><mo lspace="0.1389em" rspace="0.167em">dim</mo><mrow><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>,</mo><msubsup><mi mathvariant="normal">Ω</mi><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mi>p</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\dim\Tate(H^{2p}(\bar{X}_{et},{\mathbb{Q}}_{\ell})(p))\leq\dim H^{p}(\bar{X},\Omega_{\bar{X}}^{p})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p22.3" class="ltx_p"><span id="S1.p22.3.1" class="ltx_text">c.f. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">T</a>, pp 81-82]</cite>.
∎</span></p>
</div>
</div>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2. </span>Fibre products of elliptic surfaces</h2>

<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">We start by summarizing some facts from Hodge theory needed below. Let <math id="S2.p1.m1" class="ltx_Math" alttext="\pi:Y\to\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Λ</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:Y\to\Lambda</annotation></semantics></math> be a smooth projective curve over a smooth
base <math id="S2.p1.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>. Let <math id="S2.p1.m3" class="ltx_Math" alttext="S\subset Y" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">S\subset Y</annotation></semantics></math> be a divisor étale over <math id="S2.p1.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>, and <math id="S2.p1.m5" class="ltx_Math" alttext="U=Y-S" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mrow><mi>Y</mi><mo>−</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">U=Y-S</annotation></semantics></math>.
We recall that a mixed Hodge module on <math id="S2.p1.m6" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>, consists a bifiltered regular
holonomic left <math id="S2.p1.m7" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>-module <math id="S2.p1.m8" class="ltx_Math" alttext="(M,F,W)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,F,W)</annotation></semantics></math>, a filtered perverse sheaf <math id="S2.p1.m9" class="ltx_Math" alttext="(\mathcal{L},W)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>,</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{L},W)</annotation></semantics></math>,
and an isomorphism in the derived category</p>
<table id="S2.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex1.m1" class="ltx_Math" alttext="DR(M)=M\to M\otimes\Omega_{Y}^{1}\to M\otimes\Omega_{Y}^{2}\ldots\cong\mathcal{L}\otimes{\mathbb{C}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>M</mi><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mn>1</mn></msubsup></mrow><mo stretchy="false">→</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mn>2</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi></mrow><mo>≅</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow></mrow><annotation encoding="application/x-tex">DR(M)=M\to M\otimes\Omega_{Y}^{1}\to M\otimes\Omega_{Y}^{2}\ldots\cong\mathcal{L}\otimes{\mathbb{C}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p1.2" class="ltx_p">compatible with <math id="S2.p1.m10" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>. These are subject to some axioms that we will
not recall <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">Sa1</a>, <a href="#bib.bibx28" title="" class="ltx_ref">Sa2</a>]</cite>. The modules of interest to us arise as follows.
Let <math id="S2.p1.m11" class="ltx_Math" alttext="(\mathcal{L}_{U},V_{U},F_{U}^{\bullet},\nabla_{U})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>U</mi></msub><mo>,</mo><msub><mi>V</mi><mi>U</mi></msub><mo>,</mo><msubsup><mi>F</mi><mi>U</mi><mo>∙</mo></msubsup><mo>,</mo><msub><mo>∇</mo><mi>U</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{L}_{U},V_{U},F_{U}^{\bullet},\nabla_{U})</annotation></semantics></math> be
a polarizable variation of Hodge structure on <math id="S2.p1.m12" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>; here <math id="S2.p1.m13" class="ltx_Math" alttext="V_{U}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>U</mi></msub><annotation encoding="application/x-tex">V_{U}</annotation></semantics></math> denotes a vector
bundle, <math id="S2.p1.m14" class="ltx_Math" alttext="F_{U}^{\bullet}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mi>U</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">F_{U}^{\bullet}</annotation></semantics></math> a filtration on it, <math id="S2.p1.m15" class="ltx_Math" alttext="\nabla_{U}" display="inline" intent=":literal"><semantics><msub><mo>∇</mo><mi>U</mi></msub><annotation encoding="application/x-tex">\nabla_{U}</annotation></semantics></math> an integrable connection, and <math id="S2.p1.m16" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>
local system of <math id="S2.p1.m17" class="ltx_Math" alttext="{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">{\mathbb{Q}}</annotation></semantics></math>-vector spaces.
By Deligne, we have an extension of <math id="S2.p1.m18" class="ltx_Math" alttext="(V_{U},\nabla_{U})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>U</mi></msub><mo>,</mo><msub><mo>∇</mo><mi>U</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V_{U},\nabla_{U})</annotation></semantics></math> to an vector bundle
with logarithmic connection <math id="S2.p1.m19" class="ltx_Math" alttext="(V,\nabla)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mo>∇</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V,\nabla)</annotation></semantics></math> on <math id="S2.p1.m20" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> such that the eigenvalues of the residues lie in <math id="S2.p1.m21" class="ltx_Math" alttext="[0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,1)</annotation></semantics></math>. We filter
this by <math id="S2.p1.m22" class="ltx_Math" alttext="F^{p}V=V\cap j_{*}F_{U}^{p}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>F</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>=</mo><mrow><mi>V</mi><mo>∩</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mi>U</mi><mi>p</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">F^{p}V=V\cap j_{*}F_{U}^{p}</annotation></semantics></math>.
Then <math id="S2.p1.m23" class="ltx_math_unparsed" alttext="M=V(*S)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mi>V</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.222em">∗</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M=V(*S)</annotation></semantics></math> is a regular holonomic <math id="S2.p1.m24" class="ltx_Math" alttext="D_{Y}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>Y</mi></msub><annotation encoding="application/x-tex">D_{Y}</annotation></semantics></math>-module which corresponds under
Riemann-Hilbert to the perverse sheaf <math id="S2.p1.m25" class="ltx_Math" alttext="\mathcal{L}={\mathbb{R}}j_{*}\mathcal{L}_{U}[\dim Y]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo lspace="0em" rspace="0.167em">dim</mo><mi>Y</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}={\mathbb{R}}j_{*}\mathcal{L}_{U}[\dim Y]</annotation></semantics></math> tensored with <math id="S2.p1.m26" class="ltx_Math" alttext="{\mathbb{C}}" display="inline" intent=":literal"><semantics><mi>ℂ</mi><annotation encoding="application/x-tex">{\mathbb{C}}</annotation></semantics></math>.
When equipped with the Hodge filtration</p>
<table id="S2.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex2.m1" class="ltx_Math" alttext="F^{p}M=\sum_{i}F^{i}D_{Y}\cap F^{p+i}V" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>F</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><mrow><msup><mi>F</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>Y</mi></msub></mrow></mrow><mo>∩</mo><mrow><msup><mi>F</mi><mrow><mi>p</mi><mo>+</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">F^{p}M=\sum_{i}F^{i}D_{Y}\cap F^{p+i}V</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p1.3" class="ltx_p">and an appropriate weight filtration <math id="S2.p1.m27" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>, <math id="S2.p1.m28" class="ltx_Math" alttext="(M,\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,\mathcal{L})</annotation></semantics></math>
forms a mixed Hodge module <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Sa2</a>, §3]</cite>.
We have a filtered quasi-isomorphism</p>
<table id="S2.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E1.m1" class="ltx_Math" alttext="(V\otimes\Omega^{\bullet}_{Y}(\log S),F)\cong(DR(M),F)" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mo>∙</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo>≅</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(V\otimes\Omega^{\bullet}_{Y}(\log S),F)\cong(DR(M),F)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p1.4" class="ltx_p">where the two sides are filtered by</p>
<table id="S2.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex3.m1" class="ltx_Math" alttext="F^{p}(V\otimes\Omega_{Y}^{i}(\log S))=F^{p-i}V\otimes\Omega_{Y}^{i}(\log S)" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>F</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mi>i</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msup><mi>F</mi><mrow><mi>p</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mi>i</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F^{p}(V\otimes\Omega_{Y}^{i}(\log S))=F^{p-i}V\otimes\Omega_{Y}^{i}(\log S)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p1.5" class="ltx_p">and</p>
<table id="S2.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex4.m1" class="ltx_Math" alttext="F^{p}(M\otimes\Omega_{Y}^{i})=F^{p-i}M\otimes\Omega_{Y}^{i}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>F</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>F</mi><mrow><mi>p</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mi>i</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">F^{p}(M\otimes\Omega_{Y}^{i})=F^{p-i}M\otimes\Omega_{Y}^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p1.6" class="ltx_p">Saito <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">Sa1</a>, <a href="#bib.bibx28" title="" class="ltx_ref">Sa2</a>]</cite> has shown that mixed Hodge modules are stable under direct images,
and furthermore that <math id="S2.p1.m29" class="ltx_Math" alttext="{\mathbb{R}}\pi_{*}" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">{\mathbb{R}}\pi_{*}</annotation></semantics></math> applied to the second, and therefore also the first,
filtered complex of (<a href="#S2.E1" title="In 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>) is strict. These facts, together
with <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Sa2</a>, thm 0.2]</cite>, imply that
<math id="S2.p1.m30" class="ltx_Math" alttext="R^{1}(\pi|U)_{*}\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>π</mi><mo lspace="0em" rspace="0em">|</mo><mi>U</mi><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">R^{1}(\pi|U)_{*}\mathcal{L}</annotation></semantics></math> is an admissible variation of mixed Hodge structure
such that</p>
<table id="S2.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex5.m1" class="ltx_Math" alttext="Gr^{p}_{F}R^{1}(\pi_{U})_{*}\mathcal{L}\otimes{\mathbb{C}}\cong R^{i}\pi_{*}(Gr_{F}^{p}V\xrightarrow{Gr\nabla}Gr_{F}^{p-1}\otimes\Omega_{Y/\Lambda}^{1}(\log S))" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>U</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mover accent="true"><mo>→</mo><mrow><mi mathsize="0.700em">G</mi><mi mathsize="0.700em">r</mi><mo lspace="0.167em" mathsize="0.700em">∇</mo></mrow></mover><mrow><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mrow><mi>Y</mi><mo>/</mo><mi mathvariant="normal">Λ</mi></mrow><mn>1</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Gr^{p}_{F}R^{1}(\pi_{U})_{*}\mathcal{L}\otimes{\mathbb{C}}\cong R^{i}\pi_{*}(Gr_{F}^{p}V\xrightarrow{Gr\nabla}Gr_{F}^{p-1}\otimes\Omega_{Y/\Lambda}^{1}(\log S))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p1.7" class="ltx_p">When <math id="S2.p1.m31" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is point, these results go back to Zucker <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx35" title="" class="ltx_ref">Z</a>]</cite>, who showed additionally that in the geometric case,
the mixed Hodge structure
on <math id="S2.p1.m32" class="ltx_Math" alttext="H^{i}(U,\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{i}(U,\mathcal{L})</annotation></semantics></math> coincides with the one coming from the Leray spectral sequence.</p>
</div>
<div id="S2.p2" class="ltx_para">
<p id="S2.p2.1" class="ltx_p">Given an admissible variation of
mixed Hodge structure
<math id="S2.p2.m1" class="ltx_Math" alttext="(V_{U},F_{U}^{\bullet},\nabla_{U},\ldots)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>U</mi></msub><mo>,</mo><msubsup><mi>F</mi><mi>U</mi><mo>∙</mo></msubsup><mo>,</mo><msub><mo>∇</mo><mi>U</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V_{U},F_{U}^{\bullet},\nabla_{U},\ldots)</annotation></semantics></math> as above,
we will describe an associated “Kodaira-Spencer” map following the method of Katz and
Oda <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">KO</a>]</cite>.
It is convenient to pass to the graded
Higgs bundle <math id="S2.p2.m2" class="ltx_Math" alttext="E=\bigoplus E^{p}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo rspace="0.111em">=</mo><mrow><mo>⨁</mo><msup><mi>E</mi><mi>p</mi></msup></mrow></mrow><annotation encoding="application/x-tex">E=\bigoplus E^{p}</annotation></semantics></math>, where <math id="S2.p2.m3" class="ltx_Math" alttext="E^{p}=Gr_{F}^{p}V" display="inline" intent=":literal"><semantics><mrow><msup><mi>E</mi><mi>p</mi></msup><mo>=</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">E^{p}=Gr_{F}^{p}V</annotation></semantics></math>, with Higgs field <math id="S2.p2.m4" class="ltx_Math" alttext="\theta:E\to E\otimes\Omega_{Y}^{1}(\log S)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo stretchy="false">→</mo><mrow><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mn>1</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta:E\to E\otimes\Omega_{Y}^{1}(\log S)</annotation></semantics></math> given by the sum of <math id="S2.p2.m5" class="ltx_Math" alttext="Gr^{p}_{F}(\nabla):Gr^{p}_{F}V\to Gr^{p-1}_{F}V" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo>∇</mo><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo stretchy="false">→</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">Gr^{p}_{F}(\nabla):Gr^{p}_{F}V\to Gr^{p-1}_{F}V</annotation></semantics></math>, so that <math id="S2.p2.m6" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> has degree <math id="S2.p2.m7" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math>. To simplify notation, let us write <math id="S2.p2.m8" class="ltx_Math" alttext="\underline{\Omega}_{Y}^{p}=\Omega_{Y}^{p}(\log S)" display="inline" intent=":literal"><semantics><mrow><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mi>p</mi></msubsup><mo>=</mo><mrow><msubsup><mi mathvariant="normal">Ω</mi><mi>Y</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\Omega}_{Y}^{p}=\Omega_{Y}^{p}(\log S)</annotation></semantics></math> etc.
The pair <math id="S2.p2.m9" class="ltx_Math" alttext="(E,\theta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(E,\theta)</annotation></semantics></math> is indeed a Higgs bundle in the sense that
<math id="S2.p2.m10" class="ltx_Math" alttext="\theta\wedge\theta=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>θ</mi><mo>∧</mo><mi>θ</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\theta\wedge\theta=0</annotation></semantics></math>. Therefore it extends to give a complex</p>
<table id="S2.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E2.m1" class="ltx_Math" alttext="E\xrightarrow{\theta}E\otimes\underline{\Omega}_{Y}^{1}\xrightarrow{\theta}E\otimes\underline{\Omega}_{Y}^{2}\ldots" display="block" intent=":literal"><semantics><mrow><mi>E</mi><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝜃</mo></mover><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mn>1</mn></msubsup></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝜃</mo></mover><mrow><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mn>2</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi></mrow></mrow><annotation encoding="application/x-tex">E\xrightarrow{\theta}E\otimes\underline{\Omega}_{Y}^{1}\xrightarrow{\theta}E\otimes\underline{\Omega}_{Y}^{2}\ldots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p2.2" class="ltx_p">We define a filtration</p>
<table id="S2.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex6.m1" class="ltx_Math" alttext="K^{r}(V\otimes\underline{\Omega}_{Y}^{i})=V\otimes(\underline{\Omega}_{Y}^{i-r}\wedge\pi^{*}\underline{\Omega}_{\Lambda}^{r})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>K</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mrow><mi>i</mi><mo>−</mo><mi>r</mi></mrow></msubsup><mo>∧</mo><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi mathvariant="normal">Λ</mi><mi>r</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K^{r}(V\otimes\underline{\Omega}_{Y}^{i})=V\otimes(\underline{\Omega}_{Y}^{i-r}\wedge\pi^{*}\underline{\Omega}_{\Lambda}^{r})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p2.3" class="ltx_p">One can check that this is a filtration by subcomplexes of the de Rham complex <math id="S2.p2.m11" class="ltx_Math" alttext="(V\otimes\underline{\Omega}_{Y}^{\bullet},\nabla)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mo>∙</mo></msubsup></mrow><mo>,</mo><mo>∇</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V\otimes\underline{\Omega}_{Y}^{\bullet},\nabla)</annotation></semantics></math>.
The connecting map associated to</p>
<table id="S2.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E3.m1" class="ltx_Math" alttext="0\to K^{1}/K^{2}\to K^{0}/K^{2}\to K^{0}/K^{1}\to 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">→</mo><mrow><msup><mi>K</mi><mn>1</mn></msup><mo>/</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><mo stretchy="false">→</mo><mrow><msup><mi>K</mi><mn>0</mn></msup><mo>/</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><mo stretchy="false">→</mo><mrow><msup><mi>K</mi><mn>0</mn></msup><mo>/</mo><msup><mi>K</mi><mn>1</mn></msup></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\to K^{1}/K^{2}\to K^{0}/K^{2}\to K^{0}/K^{1}\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p2.4" class="ltx_p">induces a Gauss-Manin connection</p>
<table id="S2.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex7.m1" class="ltx_Math" alttext="{\mathbb{R}}^{1}\pi_{*}(V\otimes\underline{\Omega}^{\bullet}_{Y/\Lambda})\cong{\mathbb{R}}^{1}\pi_{*}K^{0}/K^{1}\to{\mathbb{R}}^{2}\pi_{*}K^{1}/K^{2}\cong{\mathbb{R}}^{1}\pi_{*}(V\otimes\underline{\Omega}^{\bullet}_{Y/\Lambda})\otimes\Omega_{\Lambda}^{1}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>ℝ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mrow><mi>Y</mi><mo>/</mo><mi mathvariant="normal">Λ</mi></mrow><mo>∙</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><msup><mi>ℝ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>0</mn></msup></mrow><mo>/</mo><msup><mi>K</mi><mn>1</mn></msup></mrow><mo stretchy="false">→</mo><mrow><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>1</mn></msup></mrow><mo>/</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><mo>≅</mo><mrow><mrow><msup><mi>ℝ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mrow><mi>Y</mi><mo>/</mo><mi mathvariant="normal">Λ</mi></mrow><mo>∙</mo></msubsup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi mathvariant="normal">Λ</mi><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}^{1}\pi_{*}(V\otimes\underline{\Omega}^{\bullet}_{Y/\Lambda})\cong{\mathbb{R}}^{1}\pi_{*}K^{0}/K^{1}\to{\mathbb{R}}^{2}\pi_{*}K^{1}/K^{2}\cong{\mathbb{R}}^{1}\pi_{*}(V\otimes\underline{\Omega}^{\bullet}_{Y/\Lambda})\otimes\Omega_{\Lambda}^{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p2.5" class="ltx_p">The associated graded of this with respect to <math id="S2.p2.m12" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is the Kodaira-Spencer map <math id="S2.p2.m13" class="ltx_Math" alttext="\kappa(V)=\sum\kappa_{p}(V)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>κ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa(V)=\sum\kappa_{p}(V)</annotation></semantics></math>.
We can construct <math id="S2.p2.m14" class="ltx_Math" alttext="\kappa_{p}(V)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{p}(V)</annotation></semantics></math> directly by applying <math id="S2.p2.m15" class="ltx_Math" alttext="Gr^{p}_{F}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup></mrow><annotation encoding="application/x-tex">Gr^{p}_{F}</annotation></semantics></math> to (<a href="#S2.E3" title="In 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a>) to obtain</p>
<table id="S2.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex8.m1" class="ltx_math_unparsed" alttext="0\to[0\to E^{p-1}\otimes\underline{\Omega}_{\Lambda}^{1}\ldots]\to[E^{p}\to E^{p-1}\otimes\underline{\Omega}_{Y}^{1}\ldots]\to[E^{p}\to E^{p-1}\otimes\underline{\Omega}_{Y/\Lambda}^{1}\ldots]\to 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">→</mo><msup><mi>E</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi mathvariant="normal">Λ</mi><mn>1</mn></msubsup><mi mathvariant="normal">…</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><msup><mi>E</mi><mi>p</mi></msup><mo stretchy="false">→</mo><msup><mi>E</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mn>1</mn></msubsup><mi mathvariant="normal">…</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><msup><mi>E</mi><mi>p</mi></msup><mo stretchy="false">→</mo><msup><mi>E</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mrow><mi>Y</mi><mo>/</mo><mi mathvariant="normal">Λ</mi></mrow><mn>1</mn></msubsup><mi mathvariant="normal">…</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\to[0\to E^{p-1}\otimes\underline{\Omega}_{\Lambda}^{1}\ldots]\to[E^{p}\to E^{p-1}\otimes\underline{\Omega}_{Y}^{1}\ldots]\to[E^{p}\to E^{p-1}\otimes\underline{\Omega}_{Y/\Lambda}^{1}\ldots]\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p2.6" class="ltx_p">and then forming the connecting map</p>
<table id="S2.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex9.m1" class="ltx_Math" alttext="{\mathbb{R}}^{1}\pi_{*}(E^{p}\xrightarrow{\theta}E^{p-1}\otimes\underline{\Omega}^{1}_{Y/\Lambda}\ldots)\xrightarrow{\kappa_{p}(V)}{\mathbb{R}}^{1}\pi_{*}(E^{p-1}\xrightarrow{\theta}E^{p-2}\otimes\underline{\Omega}^{1}_{Y/\Lambda}\ldots)\otimes\Omega_{\Lambda}^{1}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>ℝ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>E</mi><mi>p</mi></msup><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝜃</mo></mover><mrow><mrow><msup><mi>E</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mrow><mi>Y</mi><mo>/</mo><mi mathvariant="normal">Λ</mi></mrow><mn>1</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mrow><msub><mi mathsize="0.700em">κ</mi><mi mathsize="0.710em">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">V</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mrow><mrow><msup><mi>ℝ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>E</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝜃</mo></mover><mrow><mrow><msup><mi>E</mi><mrow><mi>p</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mrow><mi>Y</mi><mo>/</mo><mi mathvariant="normal">Λ</mi></mrow><mn>1</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi mathvariant="normal">Λ</mi><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}^{1}\pi_{*}(E^{p}\xrightarrow{\theta}E^{p-1}\otimes\underline{\Omega}^{1}_{Y/\Lambda}\ldots)\xrightarrow{\kappa_{p}(V)}{\mathbb{R}}^{1}\pi_{*}(E^{p-1}\xrightarrow{\theta}E^{p-2}\otimes\underline{\Omega}^{1}_{Y/\Lambda}\ldots)\otimes\Omega_{\Lambda}^{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p2.7" class="ltx_p">Let <math id="S2.p2.m16" class="ltx_Math" alttext="\kappa_{p,\lambda}(V)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mrow><mi>p</mi><mo>,</mo><mi>λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{p,\lambda}(V)</annotation></semantics></math> denote the fibre of this map at <math id="S2.p2.m17" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>.</p>
</div>
<div id="S2.p3" class="ltx_para">
<p id="S2.p3.1" class="ltx_p">We will now describe the basic set up, that will be fixed for the remainder of this section
We will be interested in families of elliptic surfaces. More precisely,
let <math id="S2.p3.m1" class="ltx_Math" alttext="{\mathcal{E}}\xrightarrow{f}Y\xrightarrow{\pi}\Lambda" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑓</mo></mover><mi>Y</mi><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝜋</mo></mover><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">{\mathcal{E}}\xrightarrow{f}Y\xrightarrow{\pi}\Lambda</annotation></semantics></math> be a pair of flat projective morphisms, <math id="S2.p3.m2" class="ltx_Math" alttext="S\subset Y" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">S\subset Y</annotation></semantics></math> a relative divisor and
<math id="S2.p3.m3" class="ltx_Math" alttext="\sigma:Y\to{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">\sigma:Y\to{\mathcal{E}}</annotation></semantics></math> a section, such that:</p>
<ol id="S2.I1" class="ltx_enumerate">
<li id="S2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S2.I1.i1.p1" class="ltx_para">
<p id="S2.I1.i1.p1.1" class="ltx_p"><math id="S2.I1.i1.p1.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is smooth.</p>
</div></li>
<li id="S2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S2.I1.i2.p1" class="ltx_para">
<p id="S2.I1.i2.p1.1" class="ltx_p"><math id="S2.I1.i2.p1.m1" class="ltx_Math" alttext="Y\to\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">Y\to\Lambda</annotation></semantics></math> is a smooth relative curve, and the restriction <math id="S2.I1.i2.p1.m2" class="ltx_Math" alttext="S\to\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">S\to\Lambda</annotation></semantics></math> is étale.</p>
</div></li>
<li id="S2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S2.I1.i3.p1" class="ltx_para">
<p id="S2.I1.i3.p1.1" class="ltx_p">For each <math id="S2.I1.i3.p1.m1" class="ltx_Math" alttext="\lambda\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\Lambda</annotation></semantics></math>, the fibre <math id="S2.I1.i3.p1.m2" class="ltx_Math" alttext="f_{\lambda}:{\mathcal{E}}_{\lambda}\to Y_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>λ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo stretchy="false">→</mo><msub><mi>Y</mi><mi>λ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f_{\lambda}:{\mathcal{E}}_{\lambda}\to Y_{\lambda}</annotation></semantics></math> is a relatively minimal nonisotrivial elliptic surface.</p>
</div></li>
<li id="S2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S2.I1.i4.p1" class="ltx_para">
<p id="S2.I1.i4.p1.1" class="ltx_p">For each <math id="S2.I1.i4.p1.m1" class="ltx_Math" alttext="\lambda\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\Lambda</annotation></semantics></math>, <math id="S2.I1.i4.p1.m2" class="ltx_Math" alttext="S_{\lambda}\subset Y_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>λ</mi></msub><mo>⊂</mo><msub><mi>Y</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">S_{\lambda}\subset Y_{\lambda}</annotation></semantics></math> is the discriminant of <math id="S2.I1.i4.p1.m3" class="ltx_Math" alttext="f_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">f_{\lambda}</annotation></semantics></math>.</p>
</div></li>
<li id="S2.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S2.I1.i5.p1" class="ltx_para">
<p id="S2.I1.i5.p1.1" class="ltx_p">The data <math id="S2.I1.i5.p1.m1" class="ltx_Math" alttext="{\mathcal{E}}\to Y\supset S" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">→</mo><mi>Y</mi><mo>⊃</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">{\mathcal{E}}\to Y\supset S</annotation></semantics></math> is topologically locally trivial over
<math id="S2.I1.i5.p1.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>. In particular, the sheaves <math id="S2.I1.i5.p1.m3" class="ltx_Math" alttext="R^{i}(\pi|_{U})_{*}(R^{1}f_{*}{\mathbb{C}})_{U}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi>π</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>U</mi></msub></mrow><annotation encoding="application/x-tex">R^{i}(\pi|_{U})_{*}(R^{1}f_{*}{\mathbb{C}})_{U}</annotation></semantics></math> are locally constant for all <math id="S2.I1.i5.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, where <math id="S2.I1.i5.p1.m5" class="ltx_Math" alttext="U=Y-S" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mrow><mi>Y</mi><mo>−</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">U=Y-S</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.1" class="ltx_p">The main results of Saito <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Sa2</a>, thm 0.1]</cite> shows that <math id="S2.p4.m1" class="ltx_Math" alttext="{\mathbb{R}}(\pi|_{U})_{*}R^{1}f_{*}{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi>π</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">{\mathbb{R}}(\pi|_{U})_{*}R^{1}f_{*}{\mathbb{C}}</annotation></semantics></math> can be lifted to the derived category
of mixed Hodge modules. Condition (5) above, when combined with <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Sa2</a>, thm 0.2]</cite>, ensures that the mixed Hodge module
associated to <math id="S2.p4.m2" class="ltx_Math" alttext="R^{i}(\pi|_{U})_{*}R^{1}f_{*}{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi>π</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">R^{i}(\pi|_{U})_{*}R^{1}f_{*}{\mathbb{C}}</annotation></semantics></math> is an admissible variation of mixed Hodge structure. Choosing <math id="S2.p4.m3" class="ltx_Math" alttext="\lambda\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\Lambda</annotation></semantics></math>,
we have the Kodaira-Spencer map</p>
<table id="S2.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E4.m1" class="ltx_math_unparsed" alttext="\kappa_{\lambda}=\kappa_{1,\lambda}(R^{1}f_{\lambda*}{\mathbb{Q}}):Gr^{1}_{F}H^{1}(U_{\lambda},R^{1}f_{\lambda*}{\mathbb{C}})\to Gr^{0}_{F}H^{1}(U_{\lambda},R^{1}f_{\lambda*}{\mathbb{C}})\otimes\Omega^{1}_{\lambda}" display="block" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>λ</mi></msub><mo>=</mo><msub><mi>κ</mi><mrow><mn>1</mn><mo>,</mo><mi>λ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mn>1</mn></msup><msub><mi>f</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>G</mi><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>λ</mi></msub><mo>,</mo><msup><mi>R</mi><mn>1</mn></msup><msub><mi>f</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℂ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mi>G</mi><msubsup><mi>r</mi><mi>F</mi><mn>0</mn></msubsup><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>λ</mi></msub><mo>,</mo><msup><mi>R</mi><mn>1</mn></msup><msub><mi>f</mi><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℂ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>λ</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">\kappa_{\lambda}=\kappa_{1,\lambda}(R^{1}f_{\lambda*}{\mathbb{Q}}):Gr^{1}_{F}H^{1}(U_{\lambda},R^{1}f_{\lambda*}{\mathbb{C}})\to Gr^{0}_{F}H^{1}(U_{\lambda},R^{1}f_{\lambda*}{\mathbb{C}})\otimes\Omega^{1}_{\lambda}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.p5" class="ltx_para">
<p id="S2.p5.1" class="ltx_p">Fix <math id="S2.p5.m1" class="ltx_Math" alttext="\lambda\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\Lambda</annotation></semantics></math> and an integer <math id="S2.p5.m2" class="ltx_Math" alttext="n&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n&gt;0</annotation></semantics></math>.
Let <math id="S2.p5.m3" class="ltx_Math" alttext="V_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">V_{\lambda}</annotation></semantics></math> be the preimage of <math id="S2.p5.m4" class="ltx_Math" alttext="U_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">U_{\lambda}</annotation></semantics></math> in the <math id="S2.p5.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-fold fibre product
<math id="S2.p5.m6" class="ltx_math_unparsed" alttext="T_{\lambda}={\mathcal{E}}_{\lambda}\times_{Y_{\lambda}}{\mathcal{E}}_{\lambda}\times_{Y_{\lambda}}\ldots{\mathcal{E}}_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mrow></mrow><mi>λ</mi></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><msub><mi>Y</mi><mi>λ</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><msub><mi>Y</mi><mi>λ</mi></msub></msub><mi mathvariant="normal">…</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">T_{\lambda}={\mathcal{E}}_{\lambda}\times_{Y_{\lambda}}{\mathcal{E}}_{\lambda}\times_{Y_{\lambda}}\ldots{\mathcal{E}}_{\lambda}</annotation></semantics></math>.
Suppose that <math id="S2.p5.m7" class="ltx_Math" alttext="f_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">f_{\lambda}</annotation></semantics></math> is semistable,
which means that the singular fibres have Kodaira type <math id="S2.p5.m8" class="ltx_Math" alttext="{}_{1}I_{b}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>I</mi><mprescripts></mprescripts><mi>b</mi><mrow></mrow><mn>1</mn><mrow></mrow></mmultiscripts><annotation encoding="application/x-tex">{}_{1}I_{b}</annotation></semantics></math>, i.e. they
are reduced polygons of rational curves.
Then <math id="S2.p5.m9" class="ltx_Math" alttext="T_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">T_{\lambda}</annotation></semantics></math> has singularities which are local analytically given by</p>
<table id="S2.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex10.m1" class="ltx_Math" alttext="x_{1}y_{1}=x_{2}y_{2}=\ldots" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mo>=</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">x_{1}y_{1}=x_{2}y_{2}=\ldots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p5.2" class="ltx_p">This can be resolved by blowing up an explicit monomial ideal
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx7" title="" class="ltx_ref">D2</a>, lem 5.5]</cite> to obtain a nonsingular variety <math id="S2.p5.m10" class="ltx_Math" alttext="X_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">X_{\lambda}</annotation></semantics></math>.
This is a special case of Mumford’s toroidal resolution <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">KKMS</a>, p
94]</cite>. We let <math id="S2.p5.m11" class="ltx_Math" alttext="F_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">F_{\lambda}</annotation></semantics></math> denote the projections <math id="S2.p5.m12" class="ltx_Math" alttext="V_{\lambda}\to Y_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>λ</mi></msub><mo stretchy="false">→</mo><msub><mi>Y</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">V_{\lambda}\to Y_{\lambda}</annotation></semantics></math> and <math id="S2.p5.m13" class="ltx_Math" alttext="X_{\lambda}\to Y_{\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>λ</mi></msub><mo stretchy="false">→</mo><msub><mi>Y</mi><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">X_{\lambda}\to Y_{\lambda}</annotation></semantics></math> (and this should
cause no confusion).</p>
</div>
<div id="S2.Thmthm1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmthm1.1" class="ltx_text ltx_font_bold">Theorem 2.1</span></span><span id="S2.Thmthm1.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmthm1.p1" class="ltx_para">
<p id="S2.Thmthm1.p1.1" class="ltx_p"><span id="S2.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">With the notation and assumptions as above, suppose furthermore that
for some
<math id="S2.Thmthm1.p1.m1" class="ltx_Math" alttext="\lambda\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\Lambda</annotation></semantics></math>, the Kodaira-Spencer map <math id="S2.Thmthm1.p1.m2" class="ltx_Math" alttext="\kappa_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\kappa_{\lambda}</annotation></semantics></math>, defined in (<a href="#S2.E4" title="In 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a>), is injective.
Then the Hodge conjecture holds for <math id="S2.Thmthm1.p1.m3" class="ltx_Math" alttext="V_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">V_{\lambda}</annotation></semantics></math>, when <math id="S2.Thmthm1.p1.m4" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is very general.
In addition, when <math id="S2.Thmthm1.p1.m5" class="ltx_Math" alttext="f_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">f_{\lambda}</annotation></semantics></math> is semistable,
the Hodge conjecture holds for the toroidal resolution <math id="S2.Thmthm1.p1.m6" class="ltx_Math" alttext="X_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">X_{\lambda}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.p6" class="ltx_para">
<p id="S2.p6.1" class="ltx_p">We will give the proof after some preliminaries.
Fix <math id="S2.p6.m1" class="ltx_Math" alttext="\lambda\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\Lambda</annotation></semantics></math>.
The local system given by restricting <math id="S2.p6.m2" class="ltx_math_unparsed" alttext="L=L_{\lambda}=R^{1}f_{\lambda*}{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mi>L</mi><msub><mrow></mrow><mi>λ</mi></msub><mo>=</mo><mi>R</mi><msup><mrow></mrow><mn>1</mn></msup><mi>f</mi><msub><mrow></mrow><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">L=L_{\lambda}=R^{1}f_{\lambda*}{\mathbb{Q}}</annotation></semantics></math> to <math id="S2.p6.m3" class="ltx_Math" alttext="U_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">U_{\lambda}</annotation></semantics></math> underlies a polarizable variation
of Hodge structures of type <math id="S2.p6.m4" class="ltx_Math" alttext="\{(1,0),(0,1)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(1,0),(0,1)\}</annotation></semantics></math>.
Zucker <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx35" title="" class="ltx_ref">Z</a>]</cite> constructed mixed Hodge structures on the various cohomologies
of <math id="S2.p6.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.
The next lemma shows that the key constituents of these Hodge structures coincide.</p>
</div>
<div id="S2.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmlemma1.1" class="ltx_text ltx_font_bold">Lemma 2.1</span></span><span id="S2.Thmlemma1.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmlemma1.p1" class="ltx_para">
<p id="S2.Thmlemma1.p1.1" class="ltx_p"><span id="S2.Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">We have isomorphisms</span></p>
<table id="S2.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E5.m1" class="ltx_Math" alttext="H^{1}(Y_{\lambda},L)\cong IH^{1}(Y_{\lambda},L)\cong Gr_{2}^{W}H^{1}(U_{\lambda},L)" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>λ</mi></msub><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>λ</mi></msub><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mn>2</mn><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>λ</mi></msub><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{1}(Y_{\lambda},L)\cong IH^{1}(Y_{\lambda},L)\cong Gr_{2}^{W}H^{1}(U_{\lambda},L)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.Thmlemma1.p1.2" class="ltx_p"><span id="S2.Thmlemma1.p1.2.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="S2.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.6)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E6.m1" class="ltx_Math" alttext="Gr^{1}_{F}H^{1}(Y_{\lambda},L)\cong Gr^{1}_{F}IH^{1}(Y_{\lambda},L)\cong Gr^{1}_{F}H^{1}(U_{\lambda},L)" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>λ</mi></msub><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>λ</mi></msub><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>λ</mi></msub><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Gr^{1}_{F}H^{1}(Y_{\lambda},L)\cong Gr^{1}_{F}IH^{1}(Y_{\lambda},L)\cong Gr^{1}_{F}H^{1}(U_{\lambda},L)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p7" class="ltx_para">
<p id="S2.p7.1" class="ltx_p"><span id="S2.p7.1.1" class="ltx_text">For notational simplicity, we write <math id="S2.p7.m1" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> and <math id="S2.p7.m2" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> instead of
<math id="S2.p7.m3" class="ltx_Math" alttext="U_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">U_{\lambda}</annotation></semantics></math> and <math id="S2.p7.m4" class="ltx_Math" alttext="Y_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">Y_{\lambda}</annotation></semantics></math> in the proof.
Let <math id="S2.p7.m5" class="ltx_Math" alttext="j:U\to Y" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">j:U\to Y</annotation></semantics></math> denote the inclusion.
We have natural morphisms</span></p>
<table id="S2.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex11.m1" class="ltx_Math" alttext="L\xrightarrow{\iota}j_{*}j^{*}L\xrightarrow{\iota^{\prime}}{\mathbb{R}}j_{*}j^{*}L" display="block" intent=":literal"><semantics><mrow><mi>L</mi><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝜄</mo></mover><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mover accent="true"><mo>→</mo><msup><mi mathsize="0.700em">ι</mi><mo mathsize="0.710em">′</mo></msup></mover><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">L\xrightarrow{\iota}j_{*}j^{*}L\xrightarrow{\iota^{\prime}}{\mathbb{R}}j_{*}j^{*}L</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p7.2" class="ltx_p"><span id="S2.p7.2.1" class="ltx_text">which are clearly isomorphisms over <math id="S2.p7.m6" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.
We claim that the first map <math id="S2.p7.m7" class="ltx_Math" alttext="\iota" display="inline" intent=":literal"><semantics><mi>ι</mi><annotation encoding="application/x-tex">\iota</annotation></semantics></math> is an isomorphism at each <math id="S2.p7.m8" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math>. Let
<math id="S2.p7.m9" class="ltx_Math" alttext="s^{\prime}\in Y" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">s^{\prime}\in Y</annotation></semantics></math> be a point close to <math id="S2.p7.m10" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, and <math id="S2.p7.m11" class="ltx_Math" alttext="T_{s}:H^{1}(X_{s^{\prime}})\to H^{1}(X_{s^{\prime}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{s}:H^{1}(X_{s^{\prime}})\to H^{1}(X_{s^{\prime}})</annotation></semantics></math> the monodromy about <math id="S2.p7.m12" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>. The map <math id="S2.p7.m13" class="ltx_Math" alttext="\iota_{s}:L_{s}\to j_{*}j^{*}L_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>L</mi><mi>s</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>s</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{s}:L_{s}\to j_{*}j^{*}L_{s}</annotation></semantics></math> can be identified with the specialization map <math id="S2.p7.m14" class="ltx_Math" alttext="H^{1}(X_{s})\to H^{1}(X_{s^{\prime}})^{T_{s}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow><msub><mi>T</mi><mi>s</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">H^{1}(X_{s})\to H^{1}(X_{s^{\prime}})^{T_{s}}</annotation></semantics></math>.
One can check that <math id="S2.p7.m15" class="ltx_Math" alttext="\iota_{s}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\iota_{s}</annotation></semantics></math> is an isomorphism by proceeding case by case
through Kodaira tables <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx21" title="" class="ltx_ref">Kd</a>, p 565, p 604]</cite> (or apply semistable reduction to reduce to checking for <math id="S2.p7.m16" class="ltx_Math" alttext="I_{n}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>n</mi></msub><annotation encoding="application/x-tex">I_{n}</annotation></semantics></math> type).
The “cone” of the second morphism <math id="S2.p7.m17" class="ltx_Math" alttext="\iota^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ι</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\iota^{\prime}</annotation></semantics></math> is <math id="S2.p7.m18" class="ltx_Math" alttext="R^{1}j_{*}j^{*}L[-1]" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>j</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">R^{1}j_{*}j^{*}L[-1]</annotation></semantics></math>,
which we decompose as <math id="S2.p7.m19" class="ltx_Math" alttext="\bigoplus_{s}V_{s}[-1]" display="inline" intent=":literal"><semantics><mrow><msub><mo>⨁</mo><mi>s</mi></msub><mrow><msub><mi>V</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bigoplus_{s}V_{s}[-1]</annotation></semantics></math> where <math id="S2.p7.m20" class="ltx_Math" alttext="V_{s}=H^{1}(X_{s^{\prime}})/\im(T_{s}-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>s</mi></msub><mo>=</mo><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mo lspace="0em" rspace="0em">im</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>s</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{s}=H^{1}(X_{s^{\prime}})/\im(T_{s}-1)</annotation></semantics></math>. Therefore
we get an exact sequence</span></p>
<table id="S2.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.7)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E7.m1" class="ltx_Math" alttext="0\to IH^{1}(Y,L)\xrightarrow{\iota^{\prime}}H^{1}(U,L)\to\bigoplus_{s}V_{s}" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">→</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><msup><mi mathsize="0.700em">ι</mi><mo mathsize="0.710em">′</mo></msup></mover><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><munder><mo movablelimits="false">⨁</mo><mi>s</mi></munder><msub><mi>V</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">0\to IH^{1}(Y,L)\xrightarrow{\iota^{\prime}}H^{1}(U,L)\to\bigoplus_{s}V_{s}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p7.3" class="ltx_p"><span id="S2.p7.3.1" class="ltx_text">A direct calculation using Kodaira’s tables shows that <math id="S2.p7.m21" class="ltx_Math" alttext="\dim V_{s}=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><msub><mi>V</mi><mi>s</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\dim V_{s}=1</annotation></semantics></math> when the fibre is of type <math id="S2.p7.m22" class="ltx_Math" alttext="I_{n}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>n</mi></msub><annotation encoding="application/x-tex">I_{n}</annotation></semantics></math> (which
is semistable), and zero
in other cases. To proceed further, we need to recall some of facts about Zucker’s mixed Hodge structure
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx35" title="" class="ltx_ref">Z</a>, §13]</cite>. The lowest weight of <math id="S2.p7.m23" class="ltx_Math" alttext="H^{1}(U,L)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(U,L)</annotation></semantics></math> is <math id="S2.p7.m24" class="ltx_Math" alttext="W_{2}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>2</mn></msub><annotation encoding="application/x-tex">W_{2}</annotation></semantics></math>, and it
coincides with image of <math id="S2.p7.m25" class="ltx_Math" alttext="\iota" display="inline" intent=":literal"><semantics><mi>ι</mi><annotation encoding="application/x-tex">\iota</annotation></semantics></math> in (<a href="#S2.E7" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.7</span></a>). This is enough
to prove that (<a href="#S2.E5" title="In Lemma 2.1. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>) holds.</span></p>
</div>
<div id="S2.p8" class="ltx_para">
<p id="S2.p8.1" class="ltx_p"><span id="S2.p8.1.1" class="ltx_text">A careful reading of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx35" title="" class="ltx_ref">Z</a>, §13]</cite> or
specializing the formulas on
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">SZ</a>, pp 515-516]</cite> to the pure case shows that
the spaces <math id="S2.p8.m1" class="ltx_Math" alttext="V_{s}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>s</mi></msub><annotation encoding="application/x-tex">V_{s}</annotation></semantics></math> are equipped
with mixed Hodge structures compatible with (<a href="#S2.E7" title="In Proof. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.7</span></a>). These
Hodge structures are
constructed so that for <math id="S2.p8.m2" class="ltx_Math" alttext="m&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m&gt;0</annotation></semantics></math>,</span></p>
<table id="S2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex12.m1" class="ltx_Math" alttext="Gr_{2+m}^{W}H^{1}(U,L)=\bigoplus_{s}Gr_{2+m}^{W}V_{s}\cong\bigoplus_{s}Gr^{W}_{m}[\Psi_{s}/(T_{s}-I)\Psi_{s}](-1)" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mrow><mn>2</mn><mo>+</mo><mi>m</mi></mrow><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mi>s</mi></munder><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mrow><mn>2</mn><mo>+</mo><mi>m</mi></mrow><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>s</mi></msub></mrow></mrow><mo rspace="0.111em">≅</mo><mrow><munder><mo movablelimits="false">⨁</mo><mi>s</mi></munder><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>m</mi><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>s</mi></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>s</mi></msub><mo>−</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ψ</mi><mi>s</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Gr_{2+m}^{W}H^{1}(U,L)=\bigoplus_{s}Gr_{2+m}^{W}V_{s}\cong\bigoplus_{s}Gr^{W}_{m}[\Psi_{s}/(T_{s}-I)\Psi_{s}](-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p8.2" class="ltx_p"><span id="S2.p8.2.1" class="ltx_text">where <math id="S2.p8.m3" class="ltx_Math" alttext="\Psi_{s}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\Psi_{s}</annotation></semantics></math> is the limit mixed Hodge structure associated to <math id="S2.p8.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>
at <math id="S2.p8.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>.
This implies that <math id="S2.p8.m6" class="ltx_Math" alttext="\dim Gr_{4}^{W}V_{s}=\dim V_{s}=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mn>4</mn><mi>W</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>s</mi></msub></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0.167em">dim</mo><msub><mi>V</mi><mi>s</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\dim Gr_{4}^{W}V_{s}=\dim V_{s}=1</annotation></semantics></math>
at a semistable fibre.
Therefore for dimension reasons, <math id="S2.p8.m7" class="ltx_Math" alttext="V_{s}={\mathbb{Q}}(-2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>s</mi></msub><mo>=</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{s}={\mathbb{Q}}(-2)</annotation></semantics></math>. Since <math id="S2.p8.m8" class="ltx_Math" alttext="Gr_{F}^{1}{\mathbb{C}}(-2)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Gr_{F}^{1}{\mathbb{C}}(-2)=0</annotation></semantics></math>,
we get (<a href="#S2.E6" title="In Lemma 2.1. ‣ 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.6</span></a>).
∎</span></p>
</div>
</div>
<div id="S2.p9" class="ltx_para">
<p id="S2.p9.1" class="ltx_p">Let <math id="S2.p9.m1" class="ltx_math_unparsed" alttext="M=f_{\lambda*}\omega_{{\mathcal{E}}_{\lambda}/Y_{\lambda}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mi>f</mi><msub><mrow></mrow><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi>ω</mi><msub><mrow></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>λ</mi></msub><mo>/</mo><msub><mi>Y</mi><mi>λ</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">M=f_{\lambda*}\omega_{{\mathcal{E}}_{\lambda}/Y_{\lambda}}</annotation></semantics></math>.
By Grothendieck duality, we have a canonical isomorphism <math id="S2.p9.m2" class="ltx_math_unparsed" alttext="R^{1}f_{\lambda*}{\mathcal{O}}\cong M^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><msup><mrow></mrow><mn>1</mn></msup><mi>f</mi><msub><mrow></mrow><mrow><mi>λ</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>≅</mo><mi>M</mi><msup><mrow></mrow><mo>∨</mo></msup></mrow><annotation encoding="application/x-tex">R^{1}f_{\lambda*}{\mathcal{O}}\cong M^{\vee}</annotation></semantics></math>.
The corresponding graded Higgs bundle <math id="S2.p9.m3" class="ltx_math_unparsed" alttext="(E,\theta:E\to E\otimes\underline{\Omega}^{1}_{Y_{\lambda}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>E</mi><mo stretchy="false">→</mo><mi>E</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><msub><mi>Y</mi><mi>λ</mi></msub><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(E,\theta:E\to E\otimes\underline{\Omega}^{1}_{Y_{\lambda}})</annotation></semantics></math>,
is given by <math id="S2.p9.m4" class="ltx_Math" alttext="E^{0}=M^{\vee}" display="inline" intent=":literal"><semantics><mrow><msup><mi>E</mi><mn>0</mn></msup><mo>=</mo><msup><mi>M</mi><mo>∨</mo></msup></mrow><annotation encoding="application/x-tex">E^{0}=M^{\vee}</annotation></semantics></math>, <math id="S2.p9.m5" class="ltx_Math" alttext="E^{1}=M" display="inline" intent=":literal"><semantics><mrow><msup><mi>E</mi><mn>1</mn></msup><mo>=</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">E^{1}=M</annotation></semantics></math>,
<math id="S2.p9.m6" class="ltx_Math" alttext="E=E^{0}\oplus E^{1}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>=</mo><mrow><msup><mi>E</mi><mn>0</mn></msup><mo>⊕</mo><msup><mi>E</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">E=E^{0}\oplus E^{1}</annotation></semantics></math>,</p>
<table id="S2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex13.m1" class="ltx_Math" alttext="\theta=\begin{pmatrix}0&amp;0\\
\phi&amp;0\end{pmatrix}" display="block" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mi>ϕ</mi></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta=\begin{pmatrix}0&amp;0\\
\phi&amp;0\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p9.2" class="ltx_p">where <math id="S2.p9.m7" class="ltx_Math" alttext="\phi:E^{1}\to E^{0}\otimes\underline{\Omega}^{1}_{Y_{\lambda}}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>E</mi><mn>1</mn></msup><mo stretchy="false">→</mo><mrow><msup><mi>E</mi><mn>0</mn></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><msub><mi>Y</mi><mi>λ</mi></msub><mn>1</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi:E^{1}\to E^{0}\otimes\underline{\Omega}^{1}_{Y_{\lambda}}</annotation></semantics></math> is given by cupping with the
Kodaira-Spencer class associated to <math id="S2.p9.m8" class="ltx_Math" alttext="f_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">f_{\lambda}</annotation></semantics></math>.
Since this map is assumed to be nonisotrivial, <math id="S2.p9.m9" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> is nonzero.</p>
</div>
<div id="S2.p10" class="ltx_para">
<p id="S2.p10.1" class="ltx_p">Let us analyze the tensor power <math id="S2.p10.m1" class="ltx_Math" alttext="L^{\otimes N}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>N</mi></mrow></msup><annotation encoding="application/x-tex">L^{\otimes N}</annotation></semantics></math>, which is a variation of Hodge structure of weight <math id="S2.p10.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>.
The corresponding graded Higgs bundle is <math id="S2.p10.m3" class="ltx_Math" alttext="(E,\theta)^{\otimes N}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>N</mi></mrow></msup><annotation encoding="application/x-tex">(E,\theta)^{\otimes N}</annotation></semantics></math>.
In more explicit terms, the underlying vector bundle is a sum of</p>
<table id="S2.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E8.m1" class="ltx_Math" alttext="E^{I}=E^{i_{1}}\otimes E^{i_{2}}\ldots=M^{\otimes 2(i_{1}+i_{2}+\ldots)-N}" display="block" intent=":literal"><semantics><mrow><msup><mi>E</mi><mi>I</mi></msup><mo>=</mo><mrow><mrow><msup><mi>E</mi><msub><mi>i</mi><mn>1</mn></msub></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>E</mi><msub><mi>i</mi><mn>2</mn></msub></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi></mrow><mo>=</mo><msup><mi>M</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo>+</mo><msub><mi>i</mi><mn>2</mn></msub><mo>+</mo><mi mathvariant="normal">…</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>N</mi></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">E^{I}=E^{i_{1}}\otimes E^{i_{2}}\ldots=M^{\otimes 2(i_{1}+i_{2}+\ldots)-N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p10.2" class="ltx_p">where <math id="S2.p10.m4" class="ltx_Math" alttext="I=(i_{1},i_{2},\ldots)\in\{0,1\}^{N}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><msub><mi>i</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mi>N</mi></msup></mrow><annotation encoding="application/x-tex">I=(i_{1},i_{2},\ldots)\in\{0,1\}^{N}</annotation></semantics></math>. This is graded by <math id="S2.p10.m5" class="ltx_Math" alttext="i_{1}+i_{2}+\ldots" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>1</mn></msub><mo>+</mo><msub><mi>i</mi><mn>2</mn></msub><mo>+</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">i_{1}+i_{2}+\ldots</annotation></semantics></math>.
If <math id="S2.p10.m6" class="ltx_Math" alttext="J=(i_{i},\ldots,i_{k}-1,\ldots i_{N})\in\{0,1\}^{N}" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mi>i</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>i</mi><mi>k</mi></msub><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>i</mi><mi>N</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mi>N</mi></msup></mrow><annotation encoding="application/x-tex">J=(i_{i},\ldots,i_{k}-1,\ldots i_{N})\in\{0,1\}^{N}</annotation></semantics></math>, then
let</p>
<table id="S2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex14.m1" class="ltx_Math" alttext="\phi_{IJ}:E^{I}\to E^{J}\otimes\underline{\Omega}^{1}_{Y_{\lambda}}" display="block" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>E</mi><mi>I</mi></msup><mo stretchy="false">→</mo><mrow><msup><mi>E</mi><mi>J</mi></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><msub><mi>Y</mi><mi>λ</mi></msub><mn>1</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{IJ}:E^{I}\to E^{J}\otimes\underline{\Omega}^{1}_{Y_{\lambda}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p10.3" class="ltx_p">be given by the tensor product of</p>
<table id="S2.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex15.m1" class="ltx_Math" alttext="\phi:E^{i_{k}}\to E^{i_{k}-1}\otimes\underline{\Omega}^{1}_{Y_{\lambda}}" display="block" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>E</mi><msub><mi>i</mi><mi>k</mi></msub></msup><mo stretchy="false">→</mo><mrow><msup><mi>E</mi><mrow><msub><mi>i</mi><mi>k</mi></msub><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><msub><mi>Y</mi><mi>λ</mi></msub><mn>1</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi:E^{i_{k}}\to E^{i_{k}-1}\otimes\underline{\Omega}^{1}_{Y_{\lambda}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p10.4" class="ltx_p">and the identity on the other factors.
Given two vectors <math id="S2.p10.m7" class="ltx_Math" alttext="v=(a_{1},a_{2},\ldots)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">v=(a_{1},a_{2},\ldots),</annotation></semantics></math> and <math id="S2.p10.m8" class="ltx_Math" alttext="w=(b_{1},b_{2},\ldots)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mn>1</mn></msub><mo>,</mo><msub><mi>b</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w=(b_{1},b_{2},\ldots)</annotation></semantics></math> in
<math id="S2.p10.m9" class="ltx_Math" alttext="\{0,1\}^{N}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mi>N</mi></msup><annotation encoding="application/x-tex">\{0,1\}^{N}</annotation></semantics></math>, their Hamming distance <math id="S2.p10.m10" class="ltx_Math" alttext="d(v,w)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(v,w)</annotation></semantics></math> is the cardinality of the
set <math id="S2.p10.m11" class="ltx_Math" alttext="\{i\mid a_{i}\not=b_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>i</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>≠</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{i\mid a_{i}\not=b_{i}\}</annotation></semantics></math>.
We define <math id="S2.p10.m12" class="ltx_Math" alttext="\phi_{IJ}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\phi_{IJ}=0</annotation></semantics></math> if <math id="S2.p10.m13" class="ltx_Math" alttext="d(I,J)&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d(I,J)&gt;1</annotation></semantics></math>.
The Higgs bundle</p>
<table id="S2.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.9)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E9.m1" class="ltx_Math" alttext="(E,\theta)^{\otimes N}=\left(\bigoplus_{I\in\{0,1\}^{N}}E^{I},\bigoplus_{I,J}\phi_{IJ}\right)" display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>N</mi></mrow></msup><mo>=</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">⨁</mo><mrow><mi>I</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mi>N</mi></msup></mrow></munder><msup><mi>E</mi><mi>I</mi></msup></mrow><mo rspace="0em">,</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>I</mi><mo>,</mo><mi>J</mi></mrow></munder><msub><mi>ϕ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">(E,\theta)^{\otimes N}=\left(\bigoplus_{I\in\{0,1\}^{N}}E^{I},\bigoplus_{I,J}\phi_{IJ}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.p11" class="ltx_para">
<p id="S2.p11.1" class="ltx_p">These formulas extend to symmetric powers.
We note that the symmetric group on <math id="S2.p11.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> letters <math id="S2.p11.m2" class="ltx_Math" alttext="S_{N}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>N</mi></msub><annotation encoding="application/x-tex">S_{N}</annotation></semantics></math> acts on the
right of <math id="S2.p11.m3" class="ltx_Math" alttext="\{0,1\}^{N}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mi>N</mi></msup><annotation encoding="application/x-tex">\{0,1\}^{N}</annotation></semantics></math> in the obvious way, and on the right on the tensor power by permuting
factors. We have that</p>
<table id="S2.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.10)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E10.m1" class="ltx_Math" alttext="\begin{split}E^{I}\cdot\sigma&amp;=E^{I\cdot\sigma}\\
\phi_{I\cdot\sigma,J\cdot\sigma}&amp;=\phi_{IJ}\cdot\sigma\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msup><mi>E</mi><mi>I</mi></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>σ</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><msup><mi>E</mi><mrow><mi>I</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>σ</mi></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mi>ϕ</mi><mrow><mrow><mi>I</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>σ</mi></mrow><mo>,</mo><mrow><mi>J</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>σ</mi></mrow></mrow></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>ϕ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>σ</mi></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}E^{I}\cdot\sigma&amp;=E^{I\cdot\sigma}\\
\phi_{I\cdot\sigma,J\cdot\sigma}&amp;=\phi_{IJ}\cdot\sigma\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p11.2" class="ltx_p">We define the symmetric power as the invariant part</p>
<table id="S2.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.11)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E11.m1" class="ltx_Math" alttext="S^{N}(E,\theta)=[(E,\theta)^{\otimes N}]^{S_{N}}\cong\left(\bigoplus_{I\text{ incr.}}E^{I},\bigoplus_{I,J\text{ incr.}}\phi_{IJ}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>S</mi><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>N</mi></mrow></msup><mo stretchy="false">]</mo></mrow><msub><mi>S</mi><mi>N</mi></msub></msup><mo>≅</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">⨁</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mtext> incr.</mtext></mrow></munder><msup><mi>E</mi><mi>I</mi></msup></mrow><mo rspace="0em">,</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>I</mi><mo>,</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mtext> incr.</mtext></mrow></mrow></munder><msub><mi>ϕ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">S^{N}(E,\theta)=[(E,\theta)^{\otimes N}]^{S_{N}}\cong\left(\bigoplus_{I\text{ incr.}}E^{I},\bigoplus_{I,J\text{ incr.}}\phi_{IJ}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p11.3" class="ltx_p">where <math id="S2.p11.m4" class="ltx_Math" alttext="I,J" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>,</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">I,J</annotation></semantics></math> are weakly increasing sequences in <math id="S2.p11.m5" class="ltx_Math" alttext="\{0,1\}^{N}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mi>N</mi></msup><annotation encoding="application/x-tex">\{0,1\}^{N}</annotation></semantics></math>.
This is the Higgs bundle corresponding to <math id="S2.p11.m6" class="ltx_Math" alttext="S^{N}L" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">S^{N}L</annotation></semantics></math>.</p>
</div>
<div id="S2.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmlemma2.1" class="ltx_text ltx_font_bold">Lemma 2.2</span></span><span id="S2.Thmlemma2.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmlemma2.p1" class="ltx_para">
<p id="S2.Thmlemma2.p1.1" class="ltx_p"><span id="S2.Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S2.Thmlemma2.p1.m1" class="ltx_Math" alttext="\kappa_{1,\lambda}(L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mrow><mn>1</mn><mo>,</mo><mi>λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{1,\lambda}(L)</annotation></semantics></math> is injective, then <math id="S2.Thmlemma2.p1.m2" class="ltx_Math" alttext="\kappa_{p,\lambda}(S^{2p-1}L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mrow><mi>p</mi><mo>,</mo><mi>λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{p,\lambda}(S^{2p-1}L)</annotation></semantics></math> is injective
for all <math id="S2.Thmlemma2.p1.m3" class="ltx_Math" alttext="p&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p12" class="ltx_para">
<p id="S2.p12.1" class="ltx_p"><span id="S2.p12.1.1" class="ltx_text">Using (<a href="#S2.E8" title="In 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.8</span></a>) and (<a href="#S2.E11" title="In 2. Fibre products of elliptic surfaces ‣ Hodge cycles and the Leray filtration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.11</span></a>), one finds that</span></p>
<table id="S2.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex16.m1" class="ltx_Math" alttext="Gr_{F}^{p}(K^{0}(S^{2p-1}L)/K^{2}(S^{2p-1}L))\cong M\xrightarrow{\phi}M^{-1}\otimes\underline{\Omega}_{Y}^{1}\xrightarrow{\phi}M^{-3}\otimes\underline{\Omega}_{Y}^{1}\wedge\underline{\Omega}_{\Lambda}^{1}\ldots" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msup><mi>K</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>M</mi><mover accent="true"><mo>→</mo><mo class="ltx_mathvariant_italic" mathsize="0.700em" mathvariant="italic">ϕ</mo></mover><mrow><msup><mi>M</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mn>1</mn></msubsup></mrow><mover accent="true"><mo>→</mo><mo class="ltx_mathvariant_italic" mathsize="0.700em" mathvariant="italic">ϕ</mo></mover><mrow><mrow><msup><mi>M</mi><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mn>1</mn></msubsup></mrow><mo>∧</mo><mrow><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi mathvariant="normal">Λ</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">Gr_{F}^{p}(K^{0}(S^{2p-1}L)/K^{2}(S^{2p-1}L))\cong M\xrightarrow{\phi}M^{-1}\otimes\underline{\Omega}_{Y}^{1}\xrightarrow{\phi}M^{-3}\otimes\underline{\Omega}_{Y}^{1}\wedge\underline{\Omega}_{\Lambda}^{1}\ldots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p12.2" class="ltx_p"><span id="S2.p12.2.1" class="ltx_text">and</span></p>
<table id="S2.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex17.m1" class="ltx_Math" alttext="Gr_{F}^{1}(K^{0}(L)/K^{2}(L))\cong M\xrightarrow{\phi}M^{-1}\otimes\underline{\Omega}_{Y}^{1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>F</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msup><mi>K</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msup><mi>K</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>M</mi><mover accent="true"><mo>→</mo><mo class="ltx_mathvariant_italic" mathsize="0.700em" mathvariant="italic">ϕ</mo></mover><mrow><msup><mi>M</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><munder accentunder="true"><mi mathvariant="normal">Ω</mi><mo stretchy="true">¯</mo></munder><mi>Y</mi><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">Gr_{F}^{1}(K^{0}(L)/K^{2}(L))\cong M\xrightarrow{\phi}M^{-1}\otimes\underline{\Omega}_{Y}^{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p12.3" class="ltx_p"><span id="S2.p12.3.1" class="ltx_text">There is a morphism from the first complex to the second
given by projection, and this preserves the subcomplexes induced by
<math id="S2.p12.m1" class="ltx_Math" alttext="K^{1}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mn>1</mn></msup><annotation encoding="application/x-tex">K^{1}</annotation></semantics></math>. Therefore, we obtain a commutative diagram with short exact rows</span></p>
<table id="S2.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
