          </mrow>
        </msub>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle V_{\lambda }\otimes V_{\mu }}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/9136f21300360bfc264df8136760e00a91a0c116" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -1.005ex; width:7.965ex; height:2.843ex;" alt="{\displaystyle V_{\lambda }\otimes V_{\mu }}"/></span> is <span about="#mwt89" typeof="mw:Transclusion" id="mwAQM" data-mw='{"parts":[{"template":{"target":{"wt":"harv","href":"./Template:Harv"},"params":{"1":{"wt":"James"},"2":{"wt":"Kerber"},"3":{"wt":"1981"}},"i":0}}]}'>(</span><a rel="mw:WikiLink" href="#CITEREFJamesKerber1981" about="#mwt89" class="mw-selflink-fragment">James <span typeof="mw:Entity">&amp;</span> Kerber 1981</a><span about="#mwt89">)</span></p>
<dl id="mwAQQ"><dd id="mwAQU"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt91" id="mwAQY" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\nC_{\\lambda,\\mu,\\nu}>0 \\implies  |d_\\lambda-d_\\mu| \\leq d_\\nu \\leq d_\\lambda+d_\\mu\n"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle C_{\lambda ,\mu ,\nu }>0\implies |d_{\lambda }-d_{\mu }|\leq d_{\nu }\leq d_{\lambda }+d_{\mu }}">
