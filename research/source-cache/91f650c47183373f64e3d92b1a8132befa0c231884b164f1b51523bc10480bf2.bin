    <annotation encoding="application/x-tex">{\displaystyle \omega ^{e_{j}}}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/4d09cb38596ebe555bfce5a25cdff9c7c049ba55" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:3.158ex; height:2.343ex;" alt="{\displaystyle \omega ^{e_{j}}}"/></span> being interpreted as the image of <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt146" id="mwAX4" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"w"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle w}">
  <semantics>
