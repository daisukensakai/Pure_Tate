<dl id="mwARE"><dd id="mwARI"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt99" id="mwARM" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\n\\bar{C}_{\\lambda,\\mu,\\nu} = \\lim_{n\\to\\infty} C_{\\lambda[n],\\mu[n],\\nu[n]}\n"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle {\bar {C}}_{\lambda ,\mu ,\nu }=\lim _{n\to \infty }C_{\lambda [n],\mu [n],\nu [n]}}">
