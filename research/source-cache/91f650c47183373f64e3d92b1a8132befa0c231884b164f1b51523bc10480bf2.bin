</section><section data-mw-section-id="6" id="mwAQk" aria-labelledby="Reduced_Kronecker_coefficients"><div class="mw-heading mw-heading3"><h3 id="Reduced_Kronecker_coefficients">Reduced Kronecker coefficients</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Representation_theory_of_the_symmetric_group&amp;action=edit&amp;section=6" title="Edit section: Reduced Kronecker coefficients"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwAQo">For <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt93" id="mwAQs" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\lambda"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \lambda }">
