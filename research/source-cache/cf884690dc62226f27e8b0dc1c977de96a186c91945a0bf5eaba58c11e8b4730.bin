fill:none" d="M 93.92 -39.37 L 156.31 -39.37"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 156.31 -39.37)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -23.4 -39.37 L 42.89 -39.37"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 42.89 -39.37)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -243.57 -39.37 L -193.4 -39.37"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 -193.4 -39.37)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -238.83 39.37 L -192.37 39.37"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 -192.37 39.37)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g></g></svg></span>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 3.1. </span>Breaking of the long exact sequences.</figcaption>
</figure>
<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p"><span id="S3.p7.1.1" class="ltx_text">We have two remarks in order:</span></p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p">Since <math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has a cellular decomposition, the vertical map <math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="cl_{X}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>l</mi><mi>X</mi></msub></mrow><annotation encoding="application/x-tex">cl_{X}</annotation></semantics></math> is an isomorphism.</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p">Secondly, as a result of a deep result Totaro, we know that the Chow groups of <math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> are almost always zero,
except at the degree <math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="n^{2}-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n^{2}-1</annotation></semantics></math>, where it is <math id="S3.I1.i2.p1.m3" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>. Indeed, by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>, Theorem 16.6]</cite>, we know that the
Chow ring <math id="S3.I1.i2.p1.m4" class="ltx_Math" alttext="A^{*}(\textrm{GL}_{n}/{\mathbb{C}}^{*})" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mtext>GL</mtext><mi>n</mi></msub><mo>/</mo><msup><mi>ℂ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\textrm{GL}_{n}/{\mathbb{C}}^{*})</annotation></semantics></math>, which is Poincaré dual to <math id="S3.I1.i2.p1.m5" class="ltx_Math" alttext="A_{*}(U)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{*}(U)</annotation></semantics></math>, is isomorphic to <math id="S3.I1.i2.p1.m6" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>.
In particular, <math id="S3.I1.i2.p1.m7" class="ltx_Math" alttext="A_{q}(U)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A_{q}(U)=0</annotation></semantics></math> for <math id="S3.I1.i2.p1.m8" class="ltx_Math" alttext="q\in\{0,\dots,n^{2}-3\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>−</mo><mn>3</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">q\in\{0,\dots,n^{2}-3\}</annotation></semantics></math>, and <math id="S3.I1.i2.p1.m9" class="ltx_Math" alttext="A_{0}(U)\cong{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">A_{0}(U)\cong{\mathbb{Z}}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S3.p8" class="ltx_para">
<p id="S3.p8.1" class="ltx_p"><span id="S3.p8.1.1" class="ltx_text">As a consequence of these two remarks, we see that, for <math id="S3.p8.m1" class="ltx_Math" alttext="q\in\{1,\dots,n^{2}-3\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>−</mo><mn>3</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">q\in\{1,\dots,n^{2}-3\}</annotation></semantics></math>,
the map <math id="S3.p8.m2" class="ltx_Math" alttext="i^{*}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">i^{*}</annotation></semantics></math> in the top row of diagram in (<a href="#S3.F1" title="Figure 3.1 ‣ Proof of Theorem . ‣ 3. Proof ‣ The Betti Numbers of a Determinantal Variety" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>) is zero,
hence, the top <math id="S3.p8.m3" class="ltx_Math" alttext="j^{*}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">j^{*}</annotation></semantics></math> is surjective. It follows that the bottom <math id="S3.p8.m4" class="ltx_Math" alttext="j^{*}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">j^{*}</annotation></semantics></math> is surjective as well.
But then, by the exactness of the bottom row,
the kernel of the bottom <math id="S3.p8.m5" class="ltx_Math" alttext="i^{*}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">i^{*}</annotation></semantics></math> is equal to <math id="S3.p8.m6" class="ltx_Math" alttext="\bar{H}_{2q}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>H</mi><mo>¯</mo></mover><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{H}_{2q}(X)</annotation></semantics></math>, hence it is the zero map.
In other words, we have</span></p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\bar{H}_{2q}(Y)/\bar{H}_{2q+1}(U)\cong{\mathbb{Z}}\ \text{ and }\ \bar{H}_{2q-1}(Y)\cong\bar{H}_{2q}(U)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>H</mi><mo>¯</mo></mover><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mover accent="true"><mi>H</mi><mo>¯</mo></mover><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>ℤ</mi><mo lspace="0.500em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0.500em" rspace="0em">​</mo><msub><mover accent="true"><mi>H</mi><mo>¯</mo></mover><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msub><mover accent="true"><mi>H</mi><mo>¯</mo></mover><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bar{H}_{2q}(Y)/\bar{H}_{2q+1}(U)\cong{\mathbb{Z}}\ \text{ and }\ \bar{H}_{2q-1}(Y)\cong\bar{H}_{2q}(U).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p8.2" class="ltx_p"><span id="S3.p8.2.1" class="ltx_text">Thus, combining these isomorphisms with Lemma <a href="#S3.E5" title="Lemma 3.5. ‣ 3. Proof ‣ The Betti Numbers of a Determinantal Variety" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>, we finish the proof of our theorem.</span></p>
</div>
<div id="S3.p9" class="ltx_para">
<p id="S3.p9.1" class="ltx_p"><span id="S3.p9.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S3.p10" class="ltx_para">
<p id="S3.p10.1" class="ltx_p">It is now easy to verify that the Poincaré polynomial of <math id="S3.p10.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is as given in Corollary <a href="#S1.E3" title="Corollary 1.3. ‣ 1. Introduction ‣ The Betti Numbers of a Determinantal Variety" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.3</span></a>.</p>
</div>
</section>
