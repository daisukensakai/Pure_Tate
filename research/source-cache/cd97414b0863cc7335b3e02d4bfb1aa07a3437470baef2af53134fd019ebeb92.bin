          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <mn>1</mn>
          </mrow>
        </msup>
        <mo stretchy="false">(</mo>
        <mrow class="MJX-TeXAtom-ORD">
          <mi mathvariant="double-struck">Q</mi>
        </mrow>
        <mo stretchy="false">)</mo>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle \mathbf {A} ^{1}(\mathbb {Q} )}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/5f33d65ba92b2c91894f5ff4879269513f0c3042" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:6.691ex; height:3.176ex;" alt="{\displaystyle \mathbf {A} ^{1}(\mathbb {Q} )}"/></span>), then a <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt177" id="mwAQo" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"G"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle G}">
  <semantics>
