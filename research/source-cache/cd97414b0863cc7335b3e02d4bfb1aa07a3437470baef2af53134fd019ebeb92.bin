</section></section><section data-mw-section-id="6" id="mw3A" aria-labelledby="Applications"><div class="mw-heading mw-heading2"><h2 id="Applications">Applications</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Hurwitz_space&amp;action=edit&amp;section=6" title="Edit section: Applications"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

<section data-mw-section-id="7" id="mw3Q" aria-labelledby="The_rigidity_method"><div class="mw-heading mw-heading3"><h3 id="The_rigidity_method">The rigidity method</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Hurwitz_space&amp;action=edit&amp;section=7" title="Edit section: The rigidity method"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mw3g">If conjugacy classes <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt142" id="mw3w" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"(c_1, \\ldots, c_n)"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle (c_{1},\ldots ,c_{n})}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mo stretchy="false">(</mo>
        <msub>
          <mi>c</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mn>1</mn>
          </mrow>
        </msub>
        <mo>,</mo>
        <mo>…<!-- … --></mo>
        <mo>,</mo>
        <msub>
          <mi>c</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>n</mi>
          </mrow>
        </msub>
        <mo stretchy="false">)</mo>
      </mstyle>
    </mrow>
