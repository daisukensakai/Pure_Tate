<td id="A1.T1.7.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T1.m6" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math></td>
<td id="A1.T1.7.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T1.m7" class="ltx_Math" alttext="{n_{F}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">n</mi><mi mathsize="0.800em">F</mi></msub><annotation encoding="application/x-tex">{n_{F}}</annotation></semantics></math></td>
