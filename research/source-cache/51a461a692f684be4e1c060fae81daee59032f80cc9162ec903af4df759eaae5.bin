<td id="A1.T1.7.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T1.m11" class="ltx_Math" alttext="\mathfrak{S}_{4}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">𝔖</mi><mn mathsize="0.800em">4</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{4}</annotation></semantics></math></td>
<td id="A1.T1.7.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T1.m12" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math></td>
<td id="A1.T1.7.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T1.m13" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td>
<td id="A1.T1.7.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T1.m14" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></td></tr>
<tr id="A1.T1.7.3" class="ltx_tr">
<td id="A1.T1.7.3.1" class="ltx_td ltx_border_l ltx_border_r"></td>
<td id="A1.T1.7.3.2" class="ltx_td ltx_align_center ltx_border_r"><math id="A1.T1.m15" class="ltx_Math" alttext="A_{4}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mn mathsize="0.800em">4</mn></msub><annotation encoding="application/x-tex">A_{4}</annotation></semantics></math></td>
<td id="A1.T1.7.3.3" class="ltx_td ltx_align_center ltx_border_r"><math id="A1.T1.m16" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math></td>
<td id="A1.T1.7.3.4" class="ltx_td ltx_align_center ltx_border_r"><math id="A1.T1.m17" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td>
<td id="A1.T1.7.3.5" class="ltx_td ltx_align_center ltx_border_r"><math id="A1.T1.m18" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math></td></tr>
<tr id="A1.T1.7.4" class="ltx_tr">
