<td id="A1.T1.7.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T1.m9" class="ltx_Math" alttext="\lambda(F)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">λ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">F</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda(F)</annotation></semantics></math></td></tr>
