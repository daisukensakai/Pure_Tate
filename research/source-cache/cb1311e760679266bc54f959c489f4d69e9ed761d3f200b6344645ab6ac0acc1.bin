          g" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7.2</span></a></mtext><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><annotation encoding="application/x-tex">\scriptstyle{(\ref{eq:16})}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(141.85,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 71.03959702845017 -0.27673578005007266 L 141.84591003814904 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 141.84591003814904 -0.27673578005007266 L 141.84591003814904 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(141.85,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:12.36em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.35em;font-size:10pt;" height="15.18" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="171.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex1a.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{H_{d-p-1}(K_{p+1},\partial K_{p+1};\mathbb{Q})_{S_{p+2}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0em">,</mo><mrow><mo>∂</mo><msub><mi>K</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow><msub><mi>S</mi><mrow><mi>p</mi><mo>+</mo><mn>2</mn></mrow></msub></msub></mrow><annotation encoding="application/x-tex">\textstyle{H_{d-p-1}(K_{p+1},\partial K_{p+1};\mathbb{Q})_{S_{p+2}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 231.24075140450955 -12.414852283267175 L 231.7942229646097 -12.414852283267175" fill="none" stroke="#000000"></path><g transform="translate(231.52,0) translate(0,-22.48) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:3.07em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.18em;font-size:10pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="42.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex1a.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{1/(p+2)!}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.700em">1</mn><mo maxsize="0.700em" minsize="0.700em" stretchy="true" symmetric="true">/</mo><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">p</mi><mo mathsize="0.700em">+</mo><mn mathsize="0.700em">2</mn></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">!</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{1/(p+2)!}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(231.52,0) translate(0,-32.52)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 231.24075140450955 -32.523854467999776 L 231.7942229646097 -12.414852283267175" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 231.24075140450955 -32.523854467999776 L 231.7942229646097 -32.523854467999776" fill="none" stroke="#000000"></path><g transform="translate(-92.38,0) translate(0,-44.96) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:12.75em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.71" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="176.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex1a.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{H_{d-p}(\partial^{p}\mathcal{M}_{g}^{\mathrm{thick}},\partial^{p+1}\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>p</mi></msup><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup></mrow><mo rspace="0em">,</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msup><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup></mrow><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H_{d-p}(\partial^{p}\mathcal{M}_{g}^{\mathrm{thick}},\partial^{p+1}\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 92.37996469943441 -45.24008208692231 L 92.37996469943441 -44.68661052682216" fill="none" stroke="#000000"></path><g transform="translate(125.59,0) translate(0,-44.96)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 92.37996469943441 -45.24008208692231 L 125.58874391793577 -44.68661052682216" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 125.58874391793577 -45.24008208692231 L 125.58874391793577 -44.68661052682216" fill="none" stroke="#000000"></path><g transform="translate(125.59,0) translate(0,-44.96) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:14.71em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.71" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="203.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex1a.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{H_{d-p-1}(\partial^{p+1}\mathcal{M}_{g}^{\mathrm{thick}},\partial^{p+2}\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q}),}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msup><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup></mrow><mo rspace="0em">,</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo>+</mo><mn>2</mn></mrow></msup><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup></mrow><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\textstyle{H_{d-p-1}(\partial^{p+1}\mathcal{M}_{g}^{\mathrm{thick}},\partial^{p+2}\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q}),}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p5.3" class="ltx_p">where the bottom row is the connecting homomorphism for the triple. The class <math id="S7.SS2.p5.m6" class="ltx_Math" alttext="\mathrm{PD}([\alpha])" display="inline" intent=":literal"><semantics><mrow><mi>PD</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mi>α</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{PD}([\alpha])</annotation></semantics></math> in the upper left corner therefore maps to a class in <math id="S7.SS2.p5.m7" class="ltx_Math" alttext="H_{d-p}(\partial^{p}\mathcal{M}_{g}^{\mathrm{thick}},\partial^{p+1}\mathcal{M}_{g}^{\mathrm{thick}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>p</mi></msup><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup></mrow><mo rspace="0em">,</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msup><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{d-p}(\partial^{p}\mathcal{M}_{g}^{\mathrm{thick}},\partial^{p+1}\mathcal{M}_{g}^{\mathrm{thick}})</annotation></semantics></math>, which admits a lift to homology relative to <math id="S7.SS2.p5.m8" class="ltx_Math" alttext="\partial^{p+2}\mathcal{M}_{g}^{\mathrm{thick}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo>+</mo><mn>2</mn></mrow></msup><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup></mrow><annotation encoding="application/x-tex">\partial^{p+2}\mathcal{M}_{g}^{\mathrm{thick}}</annotation></semantics></math>. Since that space has no homology above degree <math id="S7.SS2.p5.m9" class="ltx_Math" alttext="(d-p-2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>p</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d-p-2)</annotation></semantics></math>, another long exact sequence shows that this class lifts uniquely to <math id="S7.SS2.p5.m10" class="ltx_Math" alttext="H_{d-p}(\partial^{p}\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>p</mi></msup><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup></mrow><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{d-p}(\partial^{p}\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q})</annotation></semantics></math>. By a similar argument, one checks that the image of this class in <math id="S7.SS2.p5.m11" class="ltx_Math" alttext="H_{d-p}(\partial^{p-1}\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup></mrow><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{d-p}(\partial^{p-1}\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q})</annotation></semantics></math> is unchanged by adding a coboundary to <math id="S7.SS2.p5.m12" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, and hence one gets a well defined class in <math id="S7.SS2.p5.m13" class="ltx_Math" alttext="H_{d-p}(\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mrow><mi>d</mi><mo>−</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi><mi>thick</mi></msubsup><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{d-p}(\mathcal{M}_{g}^{\mathrm{thick}};\mathbb{Q})</annotation></semantics></math> depending only on the cohomology class <math id="S7.SS2.p5.m14" class="ltx_Math" alttext="[\alpha]\in H^{p}(\Delta_{g};\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>α</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[\alpha]\in H^{p}(\Delta_{g};\mathbb{Q})</annotation></semantics></math>.</p>
</div>
<div id="S7.SS2.p6" class="ltx_para">
<p id="S7.SS2.p6.1" class="ltx_p">In the special case where <math id="S7.SS2.p6.m1" class="ltx_Math" alttext="p=3g-4" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">p=3g-4</annotation></semantics></math>, generators of <math id="S7.SS2.p6.m2" class="ltx_Math" alttext="C^{p}(\Delta_{g};\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{p}(\Delta_{g};\mathbb{Q})</annotation></semantics></math> are trivalent graphs and automatically cocycles since <math id="S7.SS2.p6.m3" class="ltx_Math" alttext="C^{p+1}(\Delta_{g};\mathbb{Q})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>C</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>g</mi></msub><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C^{p+1}(\Delta_{g};\mathbb{Q})=0</annotation></semantics></math>, and the resulting classes in</p>
<table id="S7.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex2.m1" class="ltx_Math" alttext="H_{3g-3}(\mathcal{M}_{g};\mathbb{Q})=H_{3g-3}(\Mod_{g};\mathbb{Q})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi></msub><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>H</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Mod</mi><mi>g</mi></msub><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{3g-3}(\mathcal{M}_{g};\mathbb{Q})=H_{3g-3}(\Mod_{g};\mathbb{Q})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p6.2" class="ltx_p">are exactly the abelian cycles associated to maximal collections of commuting Dehn twists. In this way, homology classes on <math id="S7.SS2.p6.m4" class="ltx_Math" alttext="\mathcal{M}_{g}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{g}</annotation></semantics></math> associated to graph cohomology classes in <math id="S7.SS2.p6.m5" class="ltx_Math" alttext="H^{*}(G^{(g)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(G^{(g)})</annotation></semantics></math> may be seen as generalizations of abelian cycle classes for the mapping class group.</p>
</div>
</section>
</section>
