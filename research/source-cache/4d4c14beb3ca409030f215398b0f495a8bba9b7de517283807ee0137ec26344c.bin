<section data-mw-section-id="24" id="mwAgg" aria-labelledby="Fundamental_papers"><div class="mw-heading mw-heading4"><h4 id="Fundamental_papers">Fundamental papers</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Moduli_space&amp;action=edit&amp;section=24" title="Edit section: Fundamental papers"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
