ill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -32.76598507955194 L 0.27673578005007266 -7.610350076103501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -32.76598507955194 L 0.27673578005007266 -32.76598507955194" fill="none" stroke="#000000"></path><g transform="translate(141.04,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.76em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex2.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{G(V_{6},2)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{G(V_{6},2)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 170.94758992969074 -11.069600110696001 L 171.50106148979089 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(171.23,0) translate(0,-22.36) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:2.69em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.72" overflow="visible" transform="matrix(1 0 0 -1 0 6.78)" width="37.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S6.Ex2.m1.pic1.1" class="ltx_text ltx_markedasmath" style="font-size:70%;">Plücker</span></span></span></foreignObject></g><g transform="translate(171.23,0) translate(0,-32.77)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 170.94758992969074 -32.76598507955194 L 171.50106148979089 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 170.94758992969074 -32.76598507955194 L 171.50106148979089 -32.76598507955194" fill="none" stroke="#000000"></path><g transform="translate(-66.32,0) translate(0,-44.72) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.99em;--ltx-fo-height:0.81em;--ltx-fo-depth:1em;font-size:10pt;" height="25.1" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="124.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex2.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{{\mathbb{P}}^{8}={\mathbb{P}}^{*}(H^{0}(S,\bigwedge^{2}{\mathcal{E}}))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>8</mn></msup><mo>=</mo><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo rspace="0em">,</mo><mrow><msup><mo>⋀</mo><mn>2</mn></msup><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{P}}^{8}={\mathbb{P}}^{*}(H^{0}(S,\bigwedge^{2}{\mathcal{E}}))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 66.32159718573794 -44.9979303617835 L 66.32159718573794 -44.44445880168336" fill="none" stroke="#000000"></path><g transform="translate(50.24,0) translate(0,-35.66) translate(4.15,0) translate(0,-2.49)"><foreignObject style="--ltx-fo-width:4.51em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.18em;font-size:10pt;" height="9.82" overflow="visible" transform="matrix(1 0 0 -1 0 7.39)" width="62.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex2.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\ \ \ \ \ \ {\mathbb{P}}^{*}(\lambda)}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.700em">ℙ</mi><mo mathsize="0.710em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">λ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\ \ \ \ \ \ {\mathbb{P}}^{*}(\lambda)}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(156.51,0) translate(0,-44.72)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 66.32159718573794 -44.9979303617835 L 156.50325747170982 -44.44445880168336" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 156.50325747170982 -44.9979303617835 L 156.50325747170982 -44.44445880168336" fill="none" stroke="#000000"></path><g transform="translate(156.51,0) translate(0,-44.72) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.53em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="21.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex2.m1.pic1.m10" class="ltx_Math" alttext="\textstyle{{\mathbb{P}}^{14}}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>14</mn></msup><annotation encoding="application/x-tex">\textstyle{{\mathbb{P}}^{14}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p2.3" class="ltx_p">where <math id="S6.p2.m20" class="ltx_Math" alttext="{\mathbb{P}}^{*}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{*}(\lambda)</annotation></semantics></math> is the linear embedding induced by <math id="S6.p2.m21" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>. Since <math id="S6.p2.m22" class="ltx_Math" alttext="\bigwedge^{2}{\mathcal{E}}=c_{1}({\mathcal{E}})=L" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>⋀</mo><mn>2</mn></msup><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>=</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\bigwedge^{2}{\mathcal{E}}=c_{1}({\mathcal{E}})=L</annotation></semantics></math>, the map <math id="S6.p2.m23" class="ltx_Math" alttext="\phi_{\bigwedge^{2}{\mathcal{E}}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mstyle displaystyle="false"><msup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">⋀</mo><mn>2</mn></msup></mstyle><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{\bigwedge^{2}{\mathcal{E}}}</annotation></semantics></math> is given by the linear system <math id="S6.p2.m24" class="ltx_Math" alttext="|L|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|L|</annotation></semantics></math>. The above diagram is cartesian, that is, <math id="S6.p2.m25" class="ltx_Math" alttext="S={\mathbb{P}}^{8}\cap G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><msup><mi>ℙ</mi><mn>8</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">S={\mathbb{P}}^{8}\cap G(V_{6},2)</annotation></semantics></math>.</p>
</div>
<div id="S6.p3" class="ltx_para">
<p id="S6.p3.1" class="ltx_p">Hyperplane sections of <math id="S6.p3.m1" class="ltx_Math" alttext="G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{6},2)</annotation></semantics></math> are parametrized by <math id="S6.p3.m2" class="ltx_Math" alttext="{\mathbb{P}}_{*}(\bigwedge^{2}V_{6})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}_{*}(\bigwedge^{2}V_{6})</annotation></semantics></math>. The dual of <math id="S6.p3.m3" class="ltx_Math" alttext="{\mathbb{P}}^{8}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>8</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{8}</annotation></semantics></math> is a five-dimensional projective space <math id="S6.p3.m4" class="ltx_Math" alttext="{\mathbb{P}}^{5}={\mathbb{P}}_{*}(\ker\lambda)\subset{\mathbb{P}}_{*}(\bigwedge^{2}V_{6})" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>5</mn></msup><mo>=</mo><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ker</mi><mo lspace="0.167em">⁡</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{5}={\mathbb{P}}_{*}(\ker\lambda)\subset{\mathbb{P}}_{*}(\bigwedge^{2}V_{6})</annotation></semantics></math>.</p>
</div>
<div id="S6.p4" class="ltx_para">
<p id="S6.p4.1" class="ltx_p">Let <math id="S6.p4.m1" class="ltx_Math" alttext="C\in|L|" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">C\in|L|</annotation></semantics></math> be a smooth curve. The Brill–Noether generality of <math id="S6.p4.m2" class="ltx_Math" alttext="(S,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L)</annotation></semantics></math> is equivalent to <math id="S6.p4.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> not containing a <math id="S6.p4.m4" class="ltx_Math" alttext="g^{2}_{7}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mn>7</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">g^{2}_{7}</annotation></semantics></math> (arguing as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">Laz86</a>, <a href="#bib.bibx12" title="" class="ltx_ref">GL87</a>]</cite> or see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">GLT15</a>, Lemma 1.7]</cite>). Let <math id="S6.p4.m5" class="ltx_Math" alttext="{\mathcal{E}}_{C}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>C</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{C}</annotation></semantics></math> be the restriction of <math id="S6.p4.m6" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math> to <math id="S6.p4.m7" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, which is stable by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Muk93</a>, §3]</cite> and <math id="S6.p4.m8" class="ltx_Math" alttext="H^{0}(S,{\mathcal{E}})\cong H^{0}(C,{\mathcal{E}}_{C})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}(S,{\mathcal{E}})\cong H^{0}(C,{\mathcal{E}}_{C})</annotation></semantics></math>. As above we get a surjective morphism <math id="S6.p4.m9" class="ltx_Math" alttext="\lambda_{C}:\bigwedge^{2}H^{0}(C,{\mathcal{E}}_{C})\to H^{0}(C,\omega_{C})" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>C</mi></msub><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><msup><mo>⋀</mo><mn>2</mn></msup><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi>ω</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{C}:\bigwedge^{2}H^{0}(C,{\mathcal{E}}_{C})\to H^{0}(C,\omega_{C})</annotation></semantics></math>
and a commutative cartesian diagram</p>
<table id="S6.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S6.Ex3.m1.pic1" class="ltx_picture ltx_markedasmath" height="66.86" overflow="visible" style="vertical-align:-55.79079469242943px" version="1.1" viewBox="62.50 55.79 275.43 66.86" width="275.43"><g transform="matrix(1 0 0 -1 62.50231827181273 66.86039480312543) translate(0,3.46) translate(62.5,0)"><g transform="translate(-9.59,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.79em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex3.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{C\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">\textstyle{C\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.590762275473052 -0.27673578005007266 L 9.590762275473052 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(137.22,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.590762275473052 -0.27673578005007266 L 137.22211901901073 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 137.22211901901073 -0.27673578005007266 L 137.22211901901073 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -7.610350076103501 L 0.27673578005007266 -7.610350076103501" fill="none" stroke="#000000"></path><g transform="translate(0,-32.77)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -32.76598507955194 L 0.27673578005007266 -7.610350076103501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -32.76598507955194 L 0.27673578005007266 -32.76598507955194" fill="none" stroke="#000000"></path><g transform="translate(137.22,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.76em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex3.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{G(V_{6},2)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{G(V_{6},2)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 167.12831101576552 -11.069600110696001 L 167.68178257586567 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(167.41,0) translate(0,-22.36) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:2.69em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.72" overflow="visible" transform="matrix(1 0 0 -1 0 6.78)" width="37.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S6.Ex3.m1.pic1.1" class="ltx_text ltx_markedasmath" style="font-size:70%;">Plücker</span></span></span></foreignObject></g><g transform="translate(167.41,0) translate(0,-32.77)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 167.12831101576552 -32.76598507955194 L 167.68178257586567 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 167.12831101576552 -32.76598507955194 L 167.68178257586567 -32.76598507955194" fill="none" stroke="#000000"></path><g transform="translate(-62.5,0) translate(0,-44.72) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.43em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="116.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex3.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{{\mathbb{P}}^{7}={\mathbb{P}}(H^{0}(C,\omega_{C})^{*})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>7</mn></msup><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi>ω</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{P}}^{7}={\mathbb{P}}(H^{0}(C,\omega_{C})^{*})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 62.502339385399374 -44.9979303617835 L 62.502339385399374 -44.44445880168336" fill="none" stroke="#000000"></path><g transform="translate(47.14,0) translate(0,-35.66) translate(4.15,0) translate(0,-2.49)"><foreignObject style="--ltx-fo-width:4.69em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.18em;font-size:10pt;" height="9.82" overflow="visible" transform="matrix(1 0 0 -1 0 7.39)" width="64.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex3.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\ \ \ \ \ {\mathbb{P}}^{*}(\lambda_{C})}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.700em">ℙ</mi><mo mathsize="0.710em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">λ</mi><mi mathsize="0.710em">C</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\ \ \ \ \ {\mathbb{P}}^{*}(\lambda_{C})}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(152.69,0) translate(0,-44.72)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 62.502339385399374 -44.9979303617835 L 152.6839785577846 -44.44445880168336" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 152.6839785577846 -44.9979303617835 L 152.6839785577846 -44.44445880168336" fill="none" stroke="#000000"></path><g transform="translate(152.69,0) translate(0,-44.72) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.53em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="21.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex3.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{{\mathbb{P}}^{14}}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>14</mn></msup><annotation encoding="application/x-tex">\textstyle{{\mathbb{P}}^{14}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p4.2" class="ltx_p">since <math id="S6.p4.m10" class="ltx_Math" alttext="{\mathbb{P}}_{*}(\lambda_{C})\cap G(2,V_{6})\cong W^{1}_{5}(C)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≅</mo><mrow><msubsup><mi>W</mi><mn>5</mn><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}_{*}(\lambda_{C})\cap G(2,V_{6})\cong W^{1}_{5}(C)</annotation></semantics></math> is finite (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Muk93</a>, Thm. C]</cite>). Note that <math id="S6.p4.m11" class="ltx_Math" alttext="{\mathbb{P}}_{*}(\lambda_{C})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}_{*}(\lambda_{C})</annotation></semantics></math> is a six-dimensional space containing <math id="S6.p4.m12" class="ltx_Math" alttext="{\mathbb{P}}_{*}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}_{*}(\lambda)</annotation></semantics></math>.</p>
</div>
<div id="S6.p5" class="ltx_para">
<p id="S6.p5.1" class="ltx_p">For our purpose we state Mukai’s result in the following form.</p>
</div>
<div id="S6.Thmdefinition1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmdefinition1.2" class="ltx_text ltx_font_bold">Lemma 6.1</span></span><span id="S6.Thmdefinition1.3" class="ltx_text ltx_font_bold"> </span>(Mukai)<span id="S6.Thmdefinition1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmdefinition1.p1" class="ltx_para">
<p id="S6.Thmdefinition1.p1.1" class="ltx_p"><span id="S6.Thmdefinition1.p1.1.1" class="ltx_text ltx_font_italic">A linear intersection of <math id="S6.Thmdefinition1.p1.m1" class="ltx_Math" alttext="G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{6},2)</annotation></semantics></math> and <math id="S6.Thmdefinition1.p1.m2" class="ltx_Math" alttext="{\mathbb{P}}^{8}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>8</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{8}</annotation></semantics></math> is a surface (whence a Brill–Noether general <math id="S6.Thmdefinition1.p1.m3" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface if smooth) if and only if the dual projective space <math id="S6.Thmdefinition1.p1.m4" class="ltx_Math" alttext="{\mathbb{P}}^{5}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>5</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{5}</annotation></semantics></math> intersects the Grassmannian <math id="S6.Thmdefinition1.p1.m5" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math> in the following way: for every <math id="S6.Thmdefinition1.p1.m6" class="ltx_Math" alttext="{\mathbb{P}}^{6}\supset{\mathbb{P}}^{5}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>6</mn></msup><mo>⊃</mo><msup><mi>ℙ</mi><mn>5</mn></msup></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{6}\supset{\mathbb{P}}^{5}</annotation></semantics></math> the intersection with <math id="S6.Thmdefinition1.p1.m7" class="ltx_Math" alttext="G(2,V_{6})\subset{\mathbb{P}}_{*}(\bigwedge^{2}V_{6})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})\subset{\mathbb{P}}_{*}(\bigwedge^{2}V_{6})</annotation></semantics></math> is finite.</span></p>
</div>
</div>
<div id="S6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.p6" class="ltx_para">
<p id="S6.p6.1" class="ltx_p"><span id="S6.p6.1.1" class="ltx_text">The ”only if“ part follows from the above. Conversely, the second condition is equivalent to any hyperplane section of the given linear section being a curve.
∎</span></p>
</div>
</div>
<section id="S6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.1. </span>Linear sections of <math id="S6.SS1.m1" class="ltx_Math" alttext="G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{6},2)</annotation></semantics></math> and elliptic pencils</h3>

<div id="S6.SS1.p1" class="ltx_para">
<p id="S6.SS1.p1.1" class="ltx_p">We are interested in <math id="S6.SS1.p1.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces <math id="S6.SS1.p1.m2" class="ltx_Math" alttext="S\subset{\mathbb{P}}^{8}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><msup><mi>ℙ</mi><mn>8</mn></msup></mrow><annotation encoding="application/x-tex">S\subset{\mathbb{P}}^{8}</annotation></semantics></math> with an elliptic pencil of minimal degree <math id="S6.SS1.p1.m3" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>. We describe a way of constructing such <math id="S6.SS1.p1.m4" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces.</p>
</div>
<div id="S6.SS1.p2" class="ltx_para">
<p id="S6.SS1.p2.1" class="ltx_p">We use the notation above. Let <math id="S6.SS1.p2.m1" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math> be a <math id="S6.SS1.p2.m2" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>-dimensional complex vector space, and let <math id="S6.SS1.p2.m3" class="ltx_Math" alttext="V_{5}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>5</mn></msub><annotation encoding="application/x-tex">V_{5}</annotation></semantics></math> be a <math id="S6.SS1.p2.m4" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>-dimensional subspace of <math id="S6.SS1.p2.m5" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>. We consider <math id="S6.SS1.p2.m6" class="ltx_Math" alttext="G(V_{5},2)\subset G(V_{6},2)\subset{\mathbb{P}}^{*}(\bigwedge^{2}V_{6})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>5</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G(V_{5},2)\subset G(V_{6},2)\subset{\mathbb{P}}^{*}(\bigwedge^{2}V_{6})</annotation></semantics></math>. By a dimension count, a general <math id="S6.SS1.p2.m7" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math>-dimensional linear subspace of <math id="S6.SS1.p2.m8" class="ltx_Math" alttext="{\mathbb{P}}^{14}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>14</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{14}</annotation></semantics></math> intersects <math id="S6.SS1.p2.m9" class="ltx_Math" alttext="G(V_{5},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>5</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{5},2)</annotation></semantics></math> in <math id="S6.SS1.p2.m10" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> points. Assume instead that our <math id="S6.SS1.p2.m11" class="ltx_Math" alttext="{\mathbb{P}}^{8}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>8</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{8}</annotation></semantics></math> intersects <math id="S6.SS1.p2.m12" class="ltx_Math" alttext="G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{6},2)</annotation></semantics></math> transversally and <math id="S6.SS1.p2.m13" class="ltx_Math" alttext="{\mathbb{P}}^{8}\cap G(V_{5},2)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>8</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>5</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{8}\cap G(V_{5},2)</annotation></semantics></math> is a smooth curve, which is then an irreducible elliptic normal curve of degree <math id="S6.SS1.p2.m14" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>. Then we get a <math id="S6.SS1.p2.m15" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface <math id="S6.SS1.p2.m16" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> with an elliptic pencil.</p>
</div>
<section id="S6.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.1.1. </span>Dual Grassmannian and Schubert varieties</h4>

<div id="S6.SS1.SSS1.p1" class="ltx_para">
<p id="S6.SS1.SSS1.p1.1" class="ltx_p">Even more is true. As Mukai already notices in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Muk93</a>, end of p.3]</cite>, a hyperplane corresponds to a point in the dual Grassmannian <math id="S6.SS1.SSS1.p1.m1" class="ltx_Math" alttext="G(2,V_{6})\subset{\mathbb{P}}_{*}(\bigwedge^{2}V_{6})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})\subset{\mathbb{P}}_{*}(\bigwedge^{2}V_{6})</annotation></semantics></math> if and only if it cuts out a Schubert subvariety. We will explain this fact in detail.</p>
</div>
<div id="S6.SS1.SSS1.p2" class="ltx_para">
<p id="S6.SS1.SSS1.p2.1" class="ltx_p">Let <math id="S6.SS1.SSS1.p2.m1" class="ltx_Math" alttext="U\in G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>∈</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U\in G(2,V_{6})</annotation></semantics></math> be a point in the Grassmannian, that is, <math id="S6.SS1.SSS1.p2.m2" class="ltx_Math" alttext="U\subset V_{6}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><msub><mi>V</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">U\subset V_{6}</annotation></semantics></math> be a <math id="S6.SS1.SSS1.p2.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-dimensional subspace of <math id="S6.SS1.SSS1.p2.m4" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>. Hence, <math id="S6.SS1.SSS1.p2.m5" class="ltx_Math" alttext="U^{\perp}=V_{6}/U" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mo>⟂</mo></msup><mo>=</mo><mrow><msub><mi>V</mi><mn>6</mn></msub><mo>/</mo><mi>U</mi></mrow></mrow><annotation encoding="application/x-tex">U^{\perp}=V_{6}/U</annotation></semantics></math> is a <math id="S6.SS1.SSS1.p2.m6" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-dimensional quotient of <math id="S6.SS1.SSS1.p2.m7" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>. By the perfect pairing <math id="S6.SS1.SSS1.p2.m8" class="ltx_Math" alttext="\bigwedge^{2}V_{6}\otimes\bigwedge^{4}V_{6}\to{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mo>⋀</mo><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><mo lspace="0.222em" rspace="0.055em">⊗</mo><mrow><msup><mo>⋀</mo><mn>4</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow></mrow><mo stretchy="false">→</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">\bigwedge^{2}V_{6}\otimes\bigwedge^{4}V_{6}\to{\mathbb{C}}</annotation></semantics></math> we may interpret <math id="S6.SS1.SSS1.p2.m9" class="ltx_Math" alttext="U^{\perp}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>⟂</mo></msup><annotation encoding="application/x-tex">U^{\perp}</annotation></semantics></math> as a linear function on <math id="S6.SS1.SSS1.p2.m10" class="ltx_Math" alttext="\bigwedge^{2}V_{6}" display="inline" intent=":literal"><semantics><mrow><msup><mo>⋀</mo><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">\bigwedge^{2}V_{6}</annotation></semantics></math>, denoted by <math id="S6.SS1.SSS1.p2.m11" class="ltx_Math" alttext="H_{U}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>U</mi></msub><annotation encoding="application/x-tex">H_{U}</annotation></semantics></math>. We compute the hyperplane section <math id="S6.SS1.SSS1.p2.m12" class="ltx_Math" alttext="H_{U}\cap G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>U</mi></msub><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{U}\cap G(V_{6},2)</annotation></semantics></math>. By definition <math id="S6.SS1.SSS1.p2.m13" class="ltx_Math" alttext="H_{U}:\ker(\bigwedge^{2}V_{6}\stackrel{{\scriptstyle\wedge^{4}U^{\perp}}}{{\longrightarrow}}\bigwedge^{6}V_{6}={\mathbb{C}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>U</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ker</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><mover><mo rspace="0.111em" stretchy="false">⟶</mo><mrow><mo>∧</mo><msup><mrow></mrow><mn>4</mn></msup><mi>U</mi><msup><mrow></mrow><mo>⟂</mo></msup></mrow></mover><mrow><msup><mo>⋀</mo><mn>6</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><mo>=</mo><mi>ℂ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{U}:\ker(\bigwedge^{2}V_{6}\stackrel{{\scriptstyle\wedge^{4}U^{\perp}}}{{\longrightarrow}}\bigwedge^{6}V_{6}={\mathbb{C}})</annotation></semantics></math>. Thus,</p>
</div>
<div id="S6.SS1.SSS1.p3" class="ltx_para">
<table id="S6.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex4.m1" class="ltx_Math" alttext="\displaystyle H_{U}\cap G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>U</mi></msub><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{U}\cap G(V_{6},2)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex4.m2" class="ltx_Math" alttext="\displaystyle=\{U^{\prime}\in G(V_{6},2)\ |\ \bigwedge^{2}U^{\prime}\wedge\bigwedge^{4}U^{\perp}=0\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>U</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.500em">|</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover></mstyle><msup><mi>U</mi><mo>′</mo></msup></mrow><mo>∧</mo><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">⋀</mo><mn>4</mn></mover></mstyle><msup><mi>U</mi><mo>⟂</mo></msup></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\{U^{\prime}\in G(V_{6},2)\ |\ \bigwedge^{2}U^{\prime}\wedge\bigwedge^{4}U^{\perp}=0\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex5.m1" class="ltx_Math" alttext="\displaystyle=\{U^{\prime}\in G(V_{6},2)|\dim(U^{\prime}\cap U^{\perp})\geq 1\}=:\Sigma_{1}(U^{\perp})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>U</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.0835em">|</mo><mrow><mrow><mo lspace="0.0835em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>U</mi><mo>′</mo></msup><mo>∩</mo><msup><mi>U</mi><mo>⟂</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>U</mi><mo>⟂</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\{U^{\prime}\in G(V_{6},2)|\dim(U^{\prime}\cap U^{\perp})\geq 1\}=:\Sigma_{1}(U^{\perp})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS1.p3.1" class="ltx_p">is a Schubert variety. Note that <math id="S6.SS1.SSS1.p3.m1" class="ltx_Math" alttext="\dim(U^{\prime}\cup U^{\perp})\leq 5" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>U</mi><mo>′</mo></msup><mo>∪</mo><msup><mi>U</mi><mo>⟂</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">\dim(U^{\prime}\cup U^{\perp})\leq 5</annotation></semantics></math> for <math id="S6.SS1.SSS1.p3.m2" class="ltx_Math" alttext="U^{\prime}\in H_{U}\cap G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mo>′</mo></msup><mo>∈</mo><mrow><msub><mi>H</mi><mi>U</mi></msub><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">U^{\prime}\in H_{U}\cap G(V_{6},2)</annotation></semantics></math>, and it is easy to check that</p>
<table id="S6.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex6.m1" class="ltx_Math" alttext="\Sigma_{1}(U^{\perp})=\bigcup_{v\in W}G(U^{\perp}\cup v,2)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>U</mi><mo>⟂</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mi>v</mi><mo>∈</mo><mi>W</mi></mrow></munder><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>U</mi><mo>⟂</mo></msup><mo>∪</mo><mi>v</mi></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Sigma_{1}(U^{\perp})=\bigcup_{v\in W}G(U^{\perp}\cup v,2),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS1.p3.2" class="ltx_p">where <math id="S6.SS1.SSS1.p3.m3" class="ltx_Math" alttext="W\oplus U^{\perp}=V_{6}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>W</mi><mo>⊕</mo><msup><mi>U</mi><mo>⟂</mo></msup></mrow><mo>=</mo><msub><mi>V</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">W\oplus U^{\perp}=V_{6}</annotation></semantics></math>. Note that everything is compatible with projectivization. Finally, we see that <math id="S6.SS1.SSS1.p3.m4" class="ltx_Math" alttext="{\mathbb{P}}^{*}(H_{U})\cap G(V_{6},2)\subset{\mathbb{P}}^{14}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>U</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⊂</mo><msup><mi>ℙ</mi><mn>14</mn></msup></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{*}(H_{U})\cap G(V_{6},2)\subset{\mathbb{P}}^{14}</annotation></semantics></math> is the union of a pencil of Grassmannian of type <math id="S6.SS1.SSS1.p3.m5" class="ltx_Math" alttext="G(5,2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(5,2)</annotation></semantics></math>. The converse direction can be shown similarly.</p>
</div>
<div id="S6.SS1.SSS1.p4" class="ltx_para">
<p id="S6.SS1.SSS1.p4.1" class="ltx_p">We conclude that every intersection point of <math id="S6.SS1.SSS1.p4.m1" class="ltx_Math" alttext="{\mathbb{P}}_{*}(\ker\lambda)\cap G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ker</mi><mo lspace="0.167em">⁡</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}_{*}(\ker\lambda)\cap G(2,V_{6})</annotation></semantics></math> gives a pencil of elliptic curves on <math id="S6.SS1.SSS1.p4.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. In order to get <math id="S6.SS1.SSS1.p4.m3" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces with many elliptic pencils of degree <math id="S6.SS1.SSS1.p4.m4" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>, we have to construct a transversal linear section <math id="S6.SS1.SSS1.p4.m5" class="ltx_Math" alttext="{\mathbb{P}}^{8}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>8</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{8}</annotation></semantics></math> such that its dual <math id="S6.SS1.SSS1.p4.m6" class="ltx_Math" alttext="{\mathbb{P}}_{*}(\ker\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ker</mi><mo lspace="0.167em">⁡</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}_{*}(\ker\lambda)</annotation></semantics></math> intersects the Grassmannian <math id="S6.SS1.SSS1.p4.m7" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math> in as many points as possible.</p>
</div>
</section>
<section id="S6.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.1.2. </span>Extension of elliptic curves to the Grassmannian <math id="S6.SS1.SSS2.m1" class="ltx_Math" alttext="G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{6},2)</annotation></semantics></math></h4>

<div id="S6.SS1.SSS2.p1" class="ltx_para">
<p id="S6.SS1.SSS2.p1.1" class="ltx_p">Let <math id="S6.SS1.SSS2.p1.m1" class="ltx_Math" alttext="(S,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L)</annotation></semantics></math> be a Brill–Noether general polarized <math id="S6.SS1.SSS2.p1.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface of genus <math id="S6.SS1.SSS2.p1.m3" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> with an elliptic pencil <math id="S6.SS1.SSS2.p1.m4" class="ltx_Math" alttext="|E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|E|</annotation></semantics></math> satisfying <math id="S6.SS1.SSS2.p1.m5" class="ltx_Math" alttext="L.E=5" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>E</mi><mo>=</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">L.E=5</annotation></semantics></math>. As <math id="S6.SS1.SSS2.p1.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> can be embedded (as a linear section) into the Grassmannian <math id="S6.SS1.SSS2.p1.m7" class="ltx_Math" alttext="G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{6},2)</annotation></semantics></math>, we will show that every elliptic curve <math id="S6.SS1.SSS2.p1.m8" class="ltx_Math" alttext="E^{\prime}\in|E|" display="inline" intent=":literal"><semantics><mrow><msup><mi>E</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">E^{\prime}\in|E|</annotation></semantics></math> is a linear section of a sub-Grassmannian of type <math id="S6.SS1.SSS2.p1.m9" class="ltx_Math" alttext="G(5,2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(5,2)</annotation></semantics></math> of <math id="S6.SS1.SSS2.p1.m10" class="ltx_Math" alttext="G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{6},2)</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.SSS2.p2" class="ltx_para">
<p id="S6.SS1.SSS2.p2.1" class="ltx_p">We need some lemmas.
We note that <math id="S6.SS1.SSS2.p2.m1" class="ltx_Math" alttext="(L-E)^{2}=4" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">(L-E)^{2}=4</annotation></semantics></math> and <math id="S6.SS1.SSS2.p2.m2" class="ltx_Math" alttext="(L-E).L=9" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>L</mi><mo>=</mo><mn>9</mn></mrow></mrow><annotation encoding="application/x-tex">(L-E).L=9</annotation></semantics></math>, whence <math id="S6.SS1.SSS2.p2.m3" class="ltx_Math" alttext="h^{0}(L-E)\geq 4" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">h^{0}(L-E)\geq 4</annotation></semantics></math> by Serre duality and Riemann–Roch.</p>
</div>
<div id="S6.Thmdefinition2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmdefinition2.2" class="ltx_text ltx_font_bold">Lemma 6.2</span></span><span id="S6.Thmdefinition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmdefinition2.p1" class="ltx_para">
<p id="S6.Thmdefinition2.p1.1" class="ltx_p"><span id="S6.Thmdefinition2.p1.1.1" class="ltx_text ltx_font_italic">The complete linear system <math id="S6.Thmdefinition2.p1.m1" class="ltx_Math" alttext="|L-E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|L-E|</annotation></semantics></math> is base point free and maps <math id="S6.Thmdefinition2.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> birationally onto a quartic surface in <math id="S6.Thmdefinition2.p1.m3" class="ltx_Math" alttext="{\mathbb{P}}^{3}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>3</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{3}</annotation></semantics></math> having at most isolated <math id="S6.Thmdefinition2.p1.m4" class="ltx_Math" alttext="A_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">A_{1}</annotation></semantics></math>-singularities coming from contractions of smooth rational curves <math id="S6.Thmdefinition2.p1.m5" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> satisfying <math id="S6.Thmdefinition2.p1.m6" class="ltx_Math" alttext="\Gamma.L=\Gamma.E=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>L</mi><mo>=</mo><mi mathvariant="normal">Γ</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>E</mi><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\Gamma.L=\Gamma.E=1</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS1.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS1.SSS2.p3" class="ltx_para">
<p id="S6.SS1.SSS2.p3.1" class="ltx_p"><span id="S6.SS1.SSS2.p3.1.1" class="ltx_text">Assume there exists an effective divisor <math id="S6.SS1.SSS2.p3.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> such that <math id="S6.SS1.SSS2.p3.m2" class="ltx_Math" alttext="\Delta^{2}=-2" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo rspace="0em">=</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\Delta^{2}=-2</annotation></semantics></math> and <math id="S6.SS1.SSS2.p3.m3" class="ltx_Math" alttext="\Delta.(L-E)\leq 0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow><mo>≤</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\Delta.(L-E)\leq 0</annotation></semantics></math>. In particular, <math id="S6.SS1.SSS2.p3.m4" class="ltx_Math" alttext="\Delta.E\geq\Delta.L&gt;0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>E</mi><mo>≥</mo><mi mathvariant="normal">Δ</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>L</mi><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\Delta.E\geq\Delta.L&gt;0</annotation></semantics></math>. Then <math id="S6.SS1.SSS2.p3.m5" class="ltx_Math" alttext="(L-E-\Delta)^{2}\geq 2" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">(L-E-\Delta)^{2}\geq 2</annotation></semantics></math>, whence <math id="S6.SS1.SSS2.p3.m6" class="ltx_Math" alttext="h^{0}(L-E-\Delta)\geq 3" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">h^{0}(L-E-\Delta)\geq 3</annotation></semantics></math>. As <math id="S6.SS1.SSS2.p3.m7" class="ltx_Math" alttext="(S,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L)</annotation></semantics></math> is assumed to be Brill–Noether general, we must have <math id="S6.SS1.SSS2.p3.m8" class="ltx_Math" alttext="h^{0}(E+\Delta)=h^{0}(E)=2" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>E</mi><mo>+</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">h^{0}(E+\Delta)=h^{0}(E)=2</annotation></semantics></math>, whence <math id="S6.SS1.SSS2.p3.m9" class="ltx_Math" alttext="\Delta.E=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>E</mi><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\Delta.E=1</annotation></semantics></math>, and consequently <math id="S6.SS1.SSS2.p3.m10" class="ltx_Math" alttext="\Delta.L=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>L</mi><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\Delta.L=1</annotation></semantics></math> and <math id="S6.SS1.SSS2.p3.m11" class="ltx_Math" alttext="\Delta.(L-E)=0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\Delta.(L-E)=0</annotation></semantics></math>. It follows that <math id="S6.SS1.SSS2.p3.m12" class="ltx_Math" alttext="L-E" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">L-E</annotation></semantics></math> is nef. It also follows, once we have proved that <math id="S6.SS1.SSS2.p3.m13" class="ltx_Math" alttext="|L-E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|L-E|</annotation></semantics></math> defines a birational morphism, that any connected curve contracted by this morphism is an irreducible rational curve of degree one with respect to <math id="S6.SS1.SSS2.p3.m14" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> and <math id="S6.SS1.SSS2.p3.m15" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, proving that the image surface has at most isolated rational <math id="S6.SS1.SSS2.p3.m16" class="ltx_Math" alttext="A_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">A_{1}</annotation></semantics></math>-singularities.</span></p>
</div>
<div id="S6.SS1.SSS2.p4" class="ltx_para">
<p id="S6.SS1.SSS2.p4.1" class="ltx_p"><span id="S6.SS1.SSS2.p4.1.1" class="ltx_text">To prove that <math id="S6.SS1.SSS2.p4.m1" class="ltx_Math" alttext="|L-E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|L-E|</annotation></semantics></math> defines a birational morphism, it suffices by the well-known results of Saint-Donat <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">SD74</a>]</cite> to prove that there is no irreducible curve <math id="S6.SS1.SSS2.p4.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> on <math id="S6.SS1.SSS2.p4.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> satisfying <math id="S6.SS1.SSS2.p4.m4" class="ltx_Math" alttext="D^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D^{2}=0</annotation></semantics></math> and <math id="S6.SS1.SSS2.p4.m5" class="ltx_Math" alttext="D.(L-E)=1" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">D.(L-E)=1</annotation></semantics></math> or <math id="S6.SS1.SSS2.p4.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>. If such a <math id="S6.SS1.SSS2.p4.m7" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> exists, then it is easily seen to satisfy <math id="S6.SS1.SSS2.p4.m8" class="ltx_Math" alttext="D.L\geq 5" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>L</mi><mo>≥</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">D.L\geq 5</annotation></semantics></math> by Brill–Noether generality. Hence, <math id="S6.SS1.SSS2.p4.m9" class="ltx_Math" alttext="D.E\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>E</mi><mo>≥</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">D.E\geq 3</annotation></semantics></math>, so that <math id="S6.SS1.SSS2.p4.m10" class="ltx_Math" alttext="(D+E)^{2}\geq 6" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>+</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">(D+E)^{2}\geq 6</annotation></semantics></math>. It follows that <math id="S6.SS1.SSS2.p4.m11" class="ltx_Math" alttext="h^{0}(D+E)\geq 5" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>+</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">h^{0}(D+E)\geq 5</annotation></semantics></math>. Since <math id="S6.SS1.SSS2.p4.m12" class="ltx_Math" alttext="(L-E-D)^{2}\geq 0" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi><mo>−</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(L-E-D)^{2}\geq 0</annotation></semantics></math> and <math id="S6.SS1.SSS2.p4.m13" class="ltx_Math" alttext="(L-E-D).D\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi><mo>−</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>D</mi><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">(L-E-D).D\geq 1</annotation></semantics></math>, we have <math id="S6.SS1.SSS2.p4.m14" class="ltx_Math" alttext="h^{0}(L-E-D)\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi><mo>−</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">h^{0}(L-E-D)\geq 2</annotation></semantics></math> by Riemann–Roch and Serre duality, contradicting Brill–Noether generality.
∎</span></p>
</div>
</div>
<div id="S6.SS1.SSS2.p5" class="ltx_para">
<p id="S6.SS1.SSS2.p5.1" class="ltx_p">Let <math id="S6.SS1.SSS2.p5.m1" class="ltx_Math" alttext="C\in|L|" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">C\in|L|</annotation></semantics></math> be a smooth curve and let <math id="S6.SS1.SSS2.p5.m2" class="ltx_Math" alttext="{\mathcal{E}}={\mathcal{E}}_{C,A}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathcal{E}}={\mathcal{E}}_{C,A}</annotation></semantics></math> be the Lazarsfeld–Mukai bundle associated to <math id="S6.SS1.SSS2.p5.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> and a pencil <math id="S6.SS1.SSS2.p5.m4" class="ltx_Math" alttext="|A|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|A|</annotation></semantics></math> of degree <math id="S6.SS1.SSS2.p5.m5" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> on <math id="S6.SS1.SSS2.p5.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>. Note that the bundle <math id="S6.SS1.SSS2.p5.m7" class="ltx_Math" alttext="{\mathcal{E}}_{C,A}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{C,A}</annotation></semantics></math> is the unique <math id="S6.SS1.SSS2.p5.m8" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-stable bundle on <math id="S6.SS1.SSS2.p5.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> with determinant <math id="S6.SS1.SSS2.p5.m10" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> and Euler characteristic <math id="S6.SS1.SSS2.p5.m11" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>.
We write <math id="S6.SS1.SSS2.p5.m12" class="ltx_Math" alttext="A_{E}=E\otimes{\mathcal{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>E</mi></msub><mo>=</mo><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>C</mi></msub></mrow></mrow><annotation encoding="application/x-tex">A_{E}=E\otimes{\mathcal{O}}_{C}</annotation></semantics></math> and note that <math id="S6.SS1.SSS2.p5.m13" class="ltx_Math" alttext="A\ncong A_{E}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>≇</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><annotation encoding="application/x-tex">A\ncong A_{E}</annotation></semantics></math> by Lemma <a href="#S5.Thmdefinition1" title="Lemma 5.1. ‣ 5. Lazarsfeld–Mukai bundles and their stability ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>.</p>
</div>
<div id="S6.Thmdefinition3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmdefinition3.2" class="ltx_text ltx_font_bold">Lemma 6.3</span></span><span id="S6.Thmdefinition3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmdefinition3.p1" class="ltx_para">
<p id="S6.Thmdefinition3.p1.1" class="ltx_p"><span id="S6.Thmdefinition3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmdefinition3.p1.m1" class="ltx_Math" alttext="(S,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L)</annotation></semantics></math>, <math id="S6.Thmdefinition3.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and <math id="S6.Thmdefinition3.p1.m3" class="ltx_Math" alttext="{\mathcal{E}}={\mathcal{E}}_{C,A}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathcal{E}}={\mathcal{E}}_{C,A}</annotation></semantics></math> be as above. Then <math id="S6.Thmdefinition3.p1.m4" class="ltx_Math" alttext="h^{0}({\mathcal{E}}(-E))=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{E}}(-E))=1</annotation></semantics></math> and <math id="S6.Thmdefinition3.p1.m5" class="ltx_Math" alttext="h^{1}({\mathcal{E}}(-E))=h^{2}({\mathcal{E}}(-E))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>h</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{1}({\mathcal{E}}(-E))=h^{2}({\mathcal{E}}(-E))=0</annotation></semantics></math>. In particular,
<math id="S6.Thmdefinition3.p1.m6" class="ltx_Math" alttext="H^{0}({\mathcal{E}}|_{E})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mi>E</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{E}}|_{E})</annotation></semantics></math> is a five-dimensional quotient of <math id="S6.Thmdefinition3.p1.m7" class="ltx_Math" alttext="H^{0}(S,{\mathcal{E}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}(S,{\mathcal{E}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS1.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS1.SSS2.p6" class="ltx_para">
<p id="S6.SS1.SSS2.p6.1" class="ltx_p"><span id="S6.SS1.SSS2.p6.1.1" class="ltx_text">Since we know that <math id="S6.SS1.SSS2.p6.m1" class="ltx_Math" alttext="h^{0}({\mathcal{E}})=6" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{E}})=6</annotation></semantics></math>, the last assertion immediately follows from the claimed cohomology of <math id="S6.SS1.SSS2.p6.m2" class="ltx_Math" alttext="{\mathcal{E}}(-E)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}(-E)</annotation></semantics></math> by the obvious restriction sequence.</span></p>
</div>
<div id="S6.SS1.SSS2.p7" class="ltx_para">
<p id="S6.SS1.SSS2.p7.1" class="ltx_p"><span id="S6.SS1.SSS2.p7.1.1" class="ltx_text">We will compute the cohomology of <math id="S6.SS1.SSS2.p7.m1" class="ltx_Math" alttext="{\mathcal{E}}(-E)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}(-E)</annotation></semantics></math> using Serre duality and the sequence</span></p>
<table id="S6.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E1.m1" class="ltx_Math" alttext="0\longrightarrow{\mathcal{E}}^{\vee}(E)\longrightarrow H^{0}(C,A)\otimes{\mathcal{O}}_{S}(E)\longrightarrow A\otimes A_{E}\longrightarrow 0," display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo stretchy="false">⟶</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mrow><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>A</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">⟶</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">0\longrightarrow{\mathcal{E}}^{\vee}(E)\longrightarrow H^{0}(C,A)\otimes{\mathcal{O}}_{S}(E)\longrightarrow A\otimes A_{E}\longrightarrow 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS2.p7.2" class="ltx_p"><span id="S6.SS1.SSS2.p7.2.1" class="ltx_text">which is (<a href="#S5.E1" title="In 5. Lazarsfeld–Mukai bundles and their stability ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>) tensored by <math id="S6.SS1.SSS2.p7.m2" class="ltx_Math" alttext="{\mathcal{O}}_{S}(E)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{S}(E)</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS1.SSS2.p8" class="ltx_para">
<p id="S6.SS1.SSS2.p8.1" class="ltx_p"><span id="S6.SS1.SSS2.p8.1.1" class="ltx_text">Since <math id="S6.SS1.SSS2.p8.m1" class="ltx_Math" alttext="{\mathcal{E}}^{\vee}(E)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}^{\vee}(E)</annotation></semantics></math> is semi-stable of degree <math id="S6.SS1.SSS2.p8.m2" class="ltx_Math" alttext="-4" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">-4</annotation></semantics></math>, one has <math id="S6.SS1.SSS2.p8.m3" class="ltx_Math" alttext="h^{0}(S,{\mathcal{E}}^{\vee}(E))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{0}(S,{\mathcal{E}}^{\vee}(E))=0</annotation></semantics></math>.
Moreover, <math id="S6.SS1.SSS2.p8.m4" class="ltx_Math" alttext="h^{0}({\mathcal{O}}_{S}(E))=2" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{O}}_{S}(E))=2</annotation></semantics></math> and <math id="S6.SS1.SSS2.p8.m5" class="ltx_Math" alttext="h^{1}({\mathcal{O}}_{S}(E))=h^{2}({\mathcal{O}}_{S}(E))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>h</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{1}({\mathcal{O}}_{S}(E))=h^{2}({\mathcal{O}}_{S}(E))=0</annotation></semantics></math>, as <math id="S6.SS1.SSS2.p8.m6" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> is an irreducible elliptic curve. Hence, the desired cohomology of <math id="S6.SS1.SSS2.p8.m7" class="ltx_Math" alttext="{\mathcal{E}}(-E)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}(-E)</annotation></semantics></math> will follow once we prove that</span></p>
<table id="S6.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E2.m1" class="ltx_Math" alttext="h^{0}(C,A\otimes A_{E})=4\;\;\mbox{and}\;\;h^{1}(A\otimes A_{E})=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>4</mn><mo lspace="0.560em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.560em" rspace="0em">​</mo><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h^{0}(C,A\otimes A_{E})=4\;\;\mbox{and}\;\;h^{1}(A\otimes A_{E})=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS2.p8.2" class="ltx_p"><span id="S6.SS1.SSS2.p8.2.1" class="ltx_text">To prove the latter, note that <math id="S6.SS1.SSS2.p8.m8" class="ltx_Math" alttext="h^{0}(C,A\otimes A_{E})=\chi(H,A\otimes A_{E})+h^{1}(A\otimes A_{E})=3+h^{1}(A\otimes A_{E})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>3</mn><mo>+</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{0}(C,A\otimes A_{E})=\chi(H,A\otimes A_{E})+h^{1}(A\otimes A_{E})=3+h^{1}(A\otimes A_{E})</annotation></semantics></math> by Riemann–Roch. Since <math id="S6.SS1.SSS2.p8.m9" class="ltx_Math" alttext="A\not\cong A_{E}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>≇</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><annotation encoding="application/x-tex">A\not\cong A_{E}</annotation></semantics></math>, we have <math id="S6.SS1.SSS2.p8.m10" class="ltx_Math" alttext="h^{0}(H,A\otimes A_{E})\geq 4" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">h^{0}(H,A\otimes A_{E})\geq 4</annotation></semantics></math>; moreover, equality must hold, as otherwise <math id="S6.SS1.SSS2.p8.m11" class="ltx_Math" alttext="h^{0}(\omega_{C}\otimes(A\otimes A_{E})^{-1})=h^{1}(A\otimes A_{E})\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ω</mi><mi>C</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">h^{0}(\omega_{C}\otimes(A\otimes A_{E})^{-1})=h^{1}(A\otimes A_{E})\geq 2</annotation></semantics></math> and <math id="S6.SS1.SSS2.p8.m12" class="ltx_Math" alttext="\deg(\omega_{C}\otimes(A\otimes A_{E})^{-1})=4" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ω</mi><mi>C</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>A</mi><mi>E</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">\deg(\omega_{C}\otimes(A\otimes A_{E})^{-1})=4</annotation></semantics></math>, whence <math id="S6.SS1.SSS2.p8.m13" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> would contain a <math id="S6.SS1.SSS2.p8.m14" class="ltx_Math" alttext="g^{1}_{4}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mn>4</mn><mn>1</mn></msubsup><annotation encoding="application/x-tex">g^{1}_{4}</annotation></semantics></math>, a contradiction to Brill–Noether generality. This proves (<a href="#S6.E2" title="In Proof. ‣ 6.1.2. Extension of elliptic curves to the Grassmannian 
            
              
                G
                
                  
                    
                    
                    
                  
                  
                    (
                    
                      
                      V
                      6
                    
                    ,
                    2
                    ) ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a>).
∎</span></p>
</div>
</div>
<div id="S6.SS1.SSS2.p9" class="ltx_para">
<p id="S6.SS1.SSS2.p9.1" class="ltx_p">Let <math id="S6.SS1.SSS2.p9.m1" class="ltx_Math" alttext="E^{\prime}\in|E|" display="inline" intent=":literal"><semantics><mrow><msup><mi>E</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">E^{\prime}\in|E|</annotation></semantics></math> be an elliptic curve on <math id="S6.SS1.SSS2.p9.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. Since <math id="S6.SS1.SSS2.p9.m3" class="ltx_Math" alttext="H^{0}({\mathcal{E}}|_{E})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mi>E</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{E}}|_{E})</annotation></semantics></math> is a 5-dimensional quotient space of <math id="S6.SS1.SSS2.p9.m4" class="ltx_Math" alttext="V_{6}=H^{0}(S,{\mathcal{E}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>6</mn></msub><mo>=</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{6}=H^{0}(S,{\mathcal{E}})</annotation></semantics></math>, each fiber <math id="S6.SS1.SSS2.p9.m5" class="ltx_Math" alttext="{\mathcal{E}}_{s}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{s}</annotation></semantics></math> for <math id="S6.SS1.SSS2.p9.m6" class="ltx_Math" alttext="s\in E^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msup><mi>E</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s\in E^{\prime}</annotation></semantics></math> is a 2-dimensional quotient of <math id="S6.SS1.SSS2.p9.m7" class="ltx_Math" alttext="H^{0}({\mathcal{E}}|_{E})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mi>E</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{E}}|_{E})</annotation></semantics></math> and hence of <math id="S6.SS1.SSS2.p9.m8" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>. The image <math id="S6.SS1.SSS2.p9.m9" class="ltx_Math" alttext="\phi_{{\mathcal{E}}}(E)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi_{{\mathcal{E}}}(E)</annotation></semantics></math> of the elliptic curve is contained in <math id="S6.SS1.SSS2.p9.m10" class="ltx_Math" alttext="G(H^{0}({\mathcal{E}}|_{E}),2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mi>E</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(H^{0}({\mathcal{E}}|_{E}),2)</annotation></semantics></math>.
Since <math id="S6.SS1.SSS2.p9.m11" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is surjective and <math id="S6.SS1.SSS2.p9.m12" class="ltx_Math" alttext="E^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>E</mi><mo>′</mo></msup><annotation encoding="application/x-tex">E^{\prime}</annotation></semantics></math> is projectively normal, we have the following commutative diagram</p>
<table id="S6.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
