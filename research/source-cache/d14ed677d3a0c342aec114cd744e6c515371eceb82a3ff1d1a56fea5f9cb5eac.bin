051197 L 67.09785931203083 -144.15275940051197" fill="none" stroke="#000000"></path><g transform="translate(66.82,0) translate(0,-166.66)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 66.5443877519307 -166.65999055057208 L 67.09785931203083 -144.15275940051197" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 66.5443877519307 -166.65999055057208 L 67.09785931203083 -166.65999055057208" fill="none" stroke="#000000"></path><g transform="translate(126.03,0) translate(0,-132.59) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.42em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="88.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m19" class="ltx_Math" alttext="\textstyle{H^{0}(C,A)\otimes{\mathcal{O}}_{S}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>A</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></mrow><annotation encoding="application/x-tex">\textstyle{H^{0}(C,A)\otimes{\mathcal{O}}_{S}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 223.18300442756978 -132.8602420421034 L 223.18300442756978 -132.30677048200326" fill="none" stroke="#000000"></path><g transform="translate(273.06,0) translate(0,-132.59)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 223.18300442756978 -132.8602420421034 L 273.0537816764607 -132.30677048200326" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 273.0537816764607 -132.8602420421034 L 273.0537816764607 -132.30677048200326" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 174.3307043708705 -143.65310637274933 L 174.88417593097066 -143.65310637274933" fill="none" stroke="#000000"></path><g transform="translate(174.61,0) translate(0,-167.27)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 174.3307043708705 -167.27078549839146 L 174.88417593097066 -143.65310637274933" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 174.3307043708705 -167.27078549839146 L 174.88417593097066 -167.27078549839146" fill="none" stroke="#000000"></path><g transform="translate(273.06,0) translate(0,-132.59) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m20" class="ltx_Math" alttext="\textstyle{A\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">\textstyle{A\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 291.7337529768468 -132.8602420421034 L 291.7337529768468 -132.30677048200326" fill="none" stroke="#000000"></path><g transform="translate(341.61,0) translate(0,-132.59)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 291.7337529768468 -132.8602420421034 L 341.6045302257377 -132.30677048200326" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 341.6045302257377 -132.8602420421034 L 341.6045302257377 -132.30677048200326" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 282.1170209898103 -140.19385633815682 L 282.6704925499105 -140.19385633815682" fill="none" stroke="#000000"></path><g transform="translate(282.4,0) translate(0,-167.27)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 282.1170209898103 -167.27078549839146 L 282.6704925499105 -140.19385633815682" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 282.1170209898103 -167.27078549839146 L 282.6704925499105 -167.27078549839146" fill="none" stroke="#000000"></path><g transform="translate(341.61,0) translate(0,-132.59) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m21" class="ltx_Math" alttext="\textstyle{0}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\textstyle{0}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(40.82,0) translate(0,-176.88) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.16em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.08em;font-size:10pt;" height="10.68" overflow="visible" transform="matrix(1 0 0 -1 0 9.53)" width="43.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m23" class="ltx_Math" alttext="\textstyle{E\otimes L^{*}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>L</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">\textstyle{E\otimes L^{*}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 66.5443877519307 -185.6432374094109 L 67.09785931203083 -185.6432374094109" fill="none" stroke="#000000"></path><g transform="translate(66.82,0) translate(0,-210.4)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 66.5443877519307 -210.3939982755098 L 67.09785931203083 -185.6432374094109" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 66.5443877519307 -210.3939982755098 L 67.09785931203083 -210.3939982755098" fill="none" stroke="#000000"></path><g transform="translate(167,0) translate(0,-176.88) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m24" class="ltx_Math" alttext="\textstyle{0}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\textstyle{0}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(274.79,0) translate(0,-176.88) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m25" class="ltx_Math" alttext="\textstyle{0}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\textstyle{0}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(59.21,0) translate(0,-220.01) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m28" class="ltx_Math" alttext="\textstyle{0}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\textstyle{0}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p3.2" class="ltx_p"><span id="S5.p3.2.1" class="ltx_text">Dualizing the left column, we see that <math id="S5.p3.m1" class="ltx_Math" alttext="L\otimes E^{*}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>E</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">L\otimes E^{*}</annotation></semantics></math> is a subbundle of <math id="S5.p3.m2" class="ltx_Math" alttext="{\mathcal{E}}_{C,A}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{C,A}</annotation></semantics></math>.
Computing slopes, we get <math id="S5.p3.m3" class="ltx_Math" alttext="\mu(L\otimes E^{*})=2g-2-d\geq g-1=\mu({\mathcal{E}}_{C,A})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>E</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn><mo>−</mo><mi>d</mi></mrow><mo>≥</mo><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu(L\otimes E^{*})=2g-2-d\geq g-1=\mu({\mathcal{E}}_{C,A})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S5.Thmdefinition2" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmdefinition2.2" class="ltx_text ltx_font_bold">Corollary 5.2</span></span><span id="S5.Thmdefinition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmdefinition2.p1" class="ltx_para">
<p id="S5.Thmdefinition2.p1.1" class="ltx_p"><span id="S5.Thmdefinition2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmdefinition2.p1.m1" class="ltx_Math" alttext="(S,L)\in{\mathcal{F}}^{{\mathfrak{U}}(3)}_{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>4</mn><mrow><mi>𝔘</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><annotation encoding="application/x-tex">(S,L)\in{\mathcal{F}}^{{\mathfrak{U}}(3)}_{4}</annotation></semantics></math> be a Brill–Noether general polarized <math id="S5.Thmdefinition2.p1.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface as in Section <a href="#S3.SS1" title="3.1. K3 surfaces of genus 4 with an elliptic pencil of degree 3 ‣ 3. 
        
          
            ⁢
            K
            3
          
        
       surfaces of genus 
        
          4 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>. Then <math id="S5.Thmdefinition2.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> contains only <math id="S5.Thmdefinition2.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-strictly semistable Lazarsfeld–Mukai bundles <math id="S5.Thmdefinition2.p1.m5" class="ltx_Math" alttext="{\mathcal{E}}_{C,A}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{C,A}</annotation></semantics></math> of rank <math id="S5.Thmdefinition2.p1.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> and <math id="S5.Thmdefinition2.p1.m7" class="ltx_Math" alttext="\det({\mathcal{E}}_{C,A})=L" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\det({\mathcal{E}}_{C,A})=L</annotation></semantics></math>, <math id="S5.Thmdefinition2.p1.m8" class="ltx_Math" alttext="c_{2}({\mathcal{E}}_{C,A})=3" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">c_{2}({\mathcal{E}}_{C,A})=3</annotation></semantics></math> for <math id="S5.Thmdefinition2.p1.m9" class="ltx_Math" alttext="C\in|L|" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">C\in|L|</annotation></semantics></math> smooth.</span></p>
</div>
</div>
<div id="S5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.p4" class="ltx_para">
<p id="S5.p4.1" class="ltx_p"><span id="S5.p4.1.1" class="ltx_text">Note that <math id="S5.p4.m1" class="ltx_Math" alttext="W^{1}_{3}(C)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mn>3</mn><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W^{1}_{3}(C)</annotation></semantics></math> consists of exactly two residual pencils of divisors which extend to two elliptic pencils on <math id="S5.p4.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. We can apply Lemma <a href="#S5.Thmdefinition1" title="Lemma 5.1. ‣ 5. Lazarsfeld–Mukai bundles and their stability ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, and the corollary follows.
∎</span></p>
</div>
</div>
<div id="S5.Thmdefinition3" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmdefinition3.2" class="ltx_text ltx_font_bold">Corollary 5.3</span></span><span id="S5.Thmdefinition3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmdefinition3.p1" class="ltx_para">
<p id="S5.Thmdefinition3.p1.1" class="ltx_p"><span id="S5.Thmdefinition3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmdefinition3.p1.m1" class="ltx_Math" alttext="(S,L)\in{\mathcal{F}}^{{\mathfrak{M}}}_{6}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>6</mn><mi>𝔐</mi></msubsup></mrow><annotation encoding="application/x-tex">(S,L)\in{\mathcal{F}}^{{\mathfrak{M}}}_{6}</annotation></semantics></math> be a Brill–Noether general polarized <math id="S5.Thmdefinition3.p1.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface as in Section <a href="#S4" title="4. K3 surfaces of genus 6 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. Then <math id="S5.Thmdefinition3.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> contains only <math id="S5.Thmdefinition3.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-unstable Lazarsfeld–Mukai bundles <math id="S5.Thmdefinition3.p1.m5" class="ltx_Math" alttext="{\mathcal{E}}_{C,A}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{C,A}</annotation></semantics></math> of rank <math id="S5.Thmdefinition3.p1.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> and <math id="S5.Thmdefinition3.p1.m7" class="ltx_Math" alttext="\det({\mathcal{E}}_{C,A})=L" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\det({\mathcal{E}}_{C,A})=L</annotation></semantics></math>, <math id="S5.Thmdefinition3.p1.m8" class="ltx_Math" alttext="c_{2}({\mathcal{E}}_{C,A})=4" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>C</mi><mo>,</mo><mi>A</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">c_{2}({\mathcal{E}}_{C,A})=4</annotation></semantics></math> for <math id="S5.Thmdefinition3.p1.m9" class="ltx_Math" alttext="C\in|L|" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">C\in|L|</annotation></semantics></math> smooth.</span></p>
</div>
</div>
<div id="S5.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.p5" class="ltx_para">
<p id="S5.p5.1" class="ltx_p"><span id="S5.p5.1.1" class="ltx_text">Since <math id="S5.p5.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is Brill–Noether general, every pencil in <math id="S5.p5.m2" class="ltx_Math" alttext="W^{1}_{4}(C)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mn>4</mn><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W^{1}_{4}(C)</annotation></semantics></math> is induced by an elliptic pencil on the <math id="S5.p5.m3" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface <math id="S5.p5.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. The result follows from Lemma <a href="#S5.Thmdefinition1" title="Lemma 5.1. ‣ 5. Lazarsfeld–Mukai bundles and their stability ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>.
∎</span></p>
</div>
</div>
<div id="S5.Thmdefinition4" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmdefinition4.2" class="ltx_text ltx_font_bold">Remark 5.4</span></span><span id="S5.Thmdefinition4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmdefinition4.p1" class="ltx_para">
<p id="S5.Thmdefinition4.p1.1" class="ltx_p">Part (i) of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">LC13</a>, Thm. 4.3]</cite> implies that on any Brill–Noether general <math id="S5.Thmdefinition4.p1.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface <math id="S5.Thmdefinition4.p1.m2" class="ltx_Math" alttext="(S,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L)</annotation></semantics></math> of genus <math id="S5.Thmdefinition4.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> there are <math id="S5.Thmdefinition4.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-stable Lazarsfeld–Mukai bundles of determinant <math id="S5.Thmdefinition4.p1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> and <math id="S5.Thmdefinition4.p1.m6" class="ltx_Math" alttext="c_{2}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>2</mn></msub><annotation encoding="application/x-tex">c_{2}</annotation></semantics></math> equal to <math id="S5.Thmdefinition4.p1.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> as soon as <math id="S5.Thmdefinition4.p1.m8" class="ltx_Math" alttext="\rho(g,1,d)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho(g,1,d)&gt;0</annotation></semantics></math>. (Indeed, sections of Brill–Noether general <math id="S5.Thmdefinition4.p1.m9" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces have maximal gonality as a consequence of the definition and have Clifford dimension <math id="S5.Thmdefinition4.p1.m10" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> by ampleness of <math id="S5.Thmdefinition4.p1.m11" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">Knu09</a>, Thm. 1.2]</cite> or <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx10" title="" class="ltx_ref">CP95</a>, Prop. 3.3]</cite>). The above corollaries show that this does not always hold for <math id="S5.Thmdefinition4.p1.m12" class="ltx_Math" alttext="\rho(g,1,d)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho(g,1,d)=0</annotation></semantics></math> (at least when <math id="S5.Thmdefinition4.p1.m13" class="ltx_Math" alttext="g=4" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">g=4</annotation></semantics></math> or <math id="S5.Thmdefinition4.p1.m14" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>).</p>
</div>
</div>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6. </span>K3 surfaces of genus 8</h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">In this section we construct <math id="S6.p1.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces of genus <math id="S6.p1.m2" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> with the maximal number of elliptic pencils of degree <math id="S6.p1.m3" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>.
We recall Mukai’s construction from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Muk93</a>, <a href="#bib.bibx30" title="" class="ltx_ref">Muk02</a>]</cite> and fix our notation.</p>
</div>
<div id="S6.p2" class="ltx_para">
<p id="S6.p2.1" class="ltx_p">Let <math id="S6.p2.m1" class="ltx_Math" alttext="(S,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L)</annotation></semantics></math> be a Brill–Noether general polarized <math id="S6.p2.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface of genus <math id="S6.p2.m3" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math>. Then there exists a unique globally generated stable vector bundle <math id="S6.p2.m4" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math> of rank <math id="S6.p2.m5" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> with determinant <math id="S6.p2.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> and Euler characteristic <math id="S6.p2.m7" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math> (this can be constructed as the Lazarsfeld–Mukai bundle associated to a <math id="S6.p2.m8" class="ltx_Math" alttext="g^{1}_{5}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mn>5</mn><mn>1</mn></msubsup><annotation encoding="application/x-tex">g^{1}_{5}</annotation></semantics></math> on any smooth <math id="S6.p2.m9" class="ltx_Math" alttext="C\in|L|" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">C\in|L|</annotation></semantics></math> not induced by an elliptic pencil on <math id="S6.p2.m10" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx5" title="" class="ltx_ref">Apr13</a>, Prop. 1.3]</cite>). It is known that <math id="S6.p2.m11" class="ltx_Math" alttext="V_{6}=H^{0}(S,{\mathcal{E}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>6</mn></msub><mo>=</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{6}=H^{0}(S,{\mathcal{E}})</annotation></semantics></math> is six-dimensional. Every fiber <math id="S6.p2.m12" class="ltx_Math" alttext="{\mathcal{E}}_{s}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{s}</annotation></semantics></math> of <math id="S6.p2.m13" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math> for <math id="S6.p2.m14" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math> is a <math id="S6.p2.m15" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-dimensional quotient space of <math id="S6.p2.m16" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>, which induces a morphism
<math id="S6.p2.m17" class="ltx_Math" alttext="\phi_{{\mathcal{E}}}:S\to G(V_{6},2),s\mapsto{\mathcal{E}}_{s}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϕ</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">→</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo><mrow><mi>s</mi><mo stretchy="false">↦</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>s</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\phi_{{\mathcal{E}}}:S\to G(V_{6},2),s\mapsto{\mathcal{E}}_{s}.</annotation></semantics></math>
The Grassmannian <math id="S6.p2.m18" class="ltx_Math" alttext="G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{6},2)</annotation></semantics></math> is naturally embedded into <math id="S6.p2.m19" class="ltx_Math" alttext="{\mathbb{P}}^{*}(\bigwedge^{2}V_{6})={\mathbb{P}}^{14}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>ℙ</mi><mn>14</mn></msup></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{*}(\bigwedge^{2}V_{6})={\mathbb{P}}^{14}</annotation></semantics></math> via the Plücker embedding. The second exterior product induces a surjective map on global sections</p>
<table id="S6.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex1.m1" class="ltx_Math" alttext="\lambda:\bigwedge^{2}H^{0}(S,{\mathcal{E}})\to H^{0}(S,\bigwedge^{2}{\mathcal{E}})," display="block" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo rspace="0em">,</mo><mrow><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda:\bigwedge^{2}H^{0}(S,{\mathcal{E}})\to H^{0}(S,\bigwedge^{2}{\mathcal{E}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p2.2" class="ltx_p">and we get the following commutative diagram</p>
<table id="S6.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S6.Ex2.m1.pic1" class="ltx_picture ltx_markedasmath" height="83.08" overflow="visible" style="vertical-align:-66.16871370490003px" version="1.1" viewBox="66.32 66.17 283.06 83.08" width="283.06"><g transform="matrix(1 0 0 -1 66.32159718573794 83.08056991955081) translate(0,3.46) translate(66.32,0)"><g transform="translate(-8.79,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.67em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex2.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{S\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\textstyle{S\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 8.792246428864846 -0.27673578005007266 L 8.792246428864846 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(74.68,0) translate(0,8.46) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.98em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="13.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex2.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\phi_{{\mathcal{E}}}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">ϕ</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">ℰ</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\phi_{{\