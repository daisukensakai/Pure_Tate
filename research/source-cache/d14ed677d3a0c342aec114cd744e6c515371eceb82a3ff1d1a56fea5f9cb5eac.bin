" alttext="\textstyle{\varphi^{*}\Omega_{S_{0}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><msub><mi>S</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">\textstyle{\varphi^{*}\Omega_{S_{0}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 190.29468722704354 -0.27673578005007266 L 190.29468722704354 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(223.51,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 190.29468722704354 -0.27673578005007266 L 223.50348755913154 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 223.50348755913154 -0.27673578005007266 L 223.50348755913154 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(223.51,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.3em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="18.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.E3.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\Omega_{S}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\textstyle{\Omega_{S}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 249.8149647494314 -0.27673578005007266 L 249.8149647494314 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(283.03,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 249.8149647494314 -0.27673578005007266 L 283.0237439679328 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 283.0237439679328 -0.27673578005007266 L 283.0237439679328 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(283.03,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.4em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.47" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="60.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.E3.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{{\mathcal{O}}_{\Gamma_{1}+\cdots+\Gamma_{k}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi mathvariant="normal">Γ</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub></mrow></msub><annotation encoding="application/x-tex">\textstyle{{\mathcal{O}}_{\Gamma_{1}+\cdots+\Gamma_{k}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 352.1657785109766 -0.27673578005007266 L 352.1657785109766 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(385.38,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 352.1657785109766 -0.27673578005007266 L 385.374557729478 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 385.374557729478 -0.27673578005007266 L 385.374557729478 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(385.38,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.E3.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{0.}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{0.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS3.p3.2" class="ltx_p"><span id="S6.SS3.p3.2.1" class="ltx_text">Twisting by <math id="S6.SS3.p3.m7" class="ltx_Math" alttext="{\mathcal{O}}_{S}(L)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{S}(L)</annotation></semantics></math>, taking cohomology and using the fact that <math id="S6.SS3.p3.m8" class="ltx_Math" alttext="\Gamma_{i}\cdot L=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Γ</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>L</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\Gamma_{i}\cdot L=1</annotation></semantics></math> by Lemma <a href="#S6.Thmdefinition2" title="Lemma 6.2. ‣ 6.1.2. Extension of elliptic curves to the Grassmannian 
            
              
                G
                
                  
                    
                    
                    
                  
                  
                    (
                    
                      
                      V
                      6
                    
                    ,
                    2
                    ) ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a>, we obtain</span></p>
<table id="S6.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E4.m1" class="ltx_Math" alttext="h^{1}(\Omega_{S}(L))\leq h^{1}(\varphi^{*}\Omega_{S_{0}}(L))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Ω</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><msub><mi>S</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h^{1}(\Omega_{S}(L))\leq h^{1}(\varphi^{*}\Omega_{S_{0}}(L)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.SS3.p4" class="ltx_para">
<p id="S6.SS3.p4.1" class="ltx_p"><span id="S6.SS3.p4.1.1" class="ltx_text">Pulling back the conormal bundle sequence</span></p>
<table id="S6.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
