erflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="125.37"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex8.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{{\mathbb{P}}^{4}={\mathbb{P}}^{*}(H^{0}(E,L|_{E}))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>4</mn></msup><mo>=</mo><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><msub><mrow><mi>L</mi><mo stretchy="false">|</mo></mrow><mi>E</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{P}}^{4}={\mathbb{P}}^{*}(H^{0}(E,L|_{E}))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 66.83467845460167 -45.44072450073293 L 66.83467845460167 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(72.18,0) translate(0,-51.4) translate(4.15,0) translate(0,-2.09)"><foreignObject style="--ltx-fo-width:0.52em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="7.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex8.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\alpha}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">α</mi><annotation encoding="application/x-tex">\scriptstyle{\alpha}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(100.04,0) translate(0,-45.16)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 66.83467845460167 -45.44072450073293 L 100.04345767310303 -44.887252940632784" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 100.04345767310303 -45.44072450073293 L 100.04345767310303 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(100.04,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.05em;--ltx-fo-height:0.81em;--ltx-fo-depth:1em;font-size:10pt;" height="25.1" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="111.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex8.m1.pic1.m9" class="ltx_Math" alttext="\textstyle{{\mathbb{P}}^{*}(\bigwedge^{2}H^{0}(E,{\mathcal{E}}|_{E}))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mi>E</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{P}}^{*}(\bigwedge^{2}H^{0}(E,{\mathcal{E}}|_{E}))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(219.69,0) translate(0,-45.16)"><path style="--ltx-stroke-color:#000000;" d="M 0 6.92 A 3.46 3.46 180 0 1 0 0" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 219.6837230327137 -45.44072450073293 L 219.6837230327137 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(252.9,0) translate(0,-45.16)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 219.6837230327137 -45.44072450073293 L 252.8925233648017 -44.887252940632784" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 252.8925233648017 -45.44072450073293 L 252.8925233648017 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(252.9,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.91em;--ltx-fo-height:0.81em;--ltx-fo-depth:1em;font-size:10pt;" height="25.1" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="95.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex8.m1.pic1.m10" class="ltx_Math" alttext="\textstyle{{\mathbb{P}}^{*}(\bigwedge^{2}H^{0}(S,{\mathcal{E}}))}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{P}}^{*}(\bigwedge^{2}H^{0}(S,{\mathcal{E}}))}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS2.p9.3" class="ltx_p">where <math id="S6.SS1.SSS2.p9.m13" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is an embedding.
The diagram is also cartesian.
Indeed, let <math id="S6.SS1.SSS2.p9.m14" class="ltx_Math" alttext="{\mathbb{P}}^{4}=\overline{E^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>4</mn></msup><mo>=</mo><mover accent="true"><msup><mi>E</mi><mo>′</mo></msup><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{4}=\overline{E^{\prime}}</annotation></semantics></math> be the linear span, then</p>
<table id="S6.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex9.m1" class="ltx_Math" alttext="E^{\prime}\subset{\mathbb{P}}^{4}\cap G(H^{0}({\mathcal{E}}|_{E}),2)\subset{\mathbb{P}}^{4}\cap G(V_{6},2)={\mathbb{P}}^{4}\cap{\mathbb{P}}^{8}\cap G(V_{6},2)=S\cap{\mathbb{P}}^{4}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>E</mi><mo>′</mo></msup><mo>⊂</mo><mrow><msup><mi>ℙ</mi><mn>4</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mi>E</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⊂</mo><mrow><msup><mi>ℙ</mi><mn>4</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>ℙ</mi><mn>4</mn></msup><mo>∩</mo><msup><mi>ℙ</mi><mn>8</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>S</mi><mo>∩</mo><msup><mi>ℙ</mi><mn>4</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E^{\prime}\subset{\mathbb{P}}^{4}\cap G(H^{0}({\mathcal{E}}|_{E}),2)\subset{\mathbb{P}}^{4}\cap G(V_{6},2)={\mathbb{P}}^{4}\cap{\mathbb{P}}^{8}\cap G(V_{6},2)=S\cap{\mathbb{P}}^{4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS2.p9.4" class="ltx_p">But <math id="S6.SS1.SSS2.p9.m15" class="ltx_Math" alttext="E^{\prime}=S\cap{\mathbb{P}}^{4}" display="inline" intent=":literal"><semantics><mrow><msup><mi>E</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>S</mi><mo>∩</mo><msup><mi>ℙ</mi><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">E^{\prime}=S\cap{\mathbb{P}}^{4}</annotation></semantics></math> since <math id="S6.SS1.SSS2.p9.m16" class="ltx_Math" alttext="|E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|E|</annotation></semantics></math> and <math id="S6.SS1.SSS2.p9.m17" class="ltx_Math" alttext="|L-E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|L-E|</annotation></semantics></math> are base point free (c.f. Lemma <a href="#S6.Thmdefinition2" title="Lemma 6.2. ‣ 6.1.2. Extension of elliptic curves to the Grassmannian 
            
              
                G
                
                  
                    
                    
                    
                  
                  
                    (
                    
                      
                      V
                      6
                    
                    ,
                    2
                    ) ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a>).
Hence, it follows that <math id="S6.SS1.SSS2.p9.m18" class="ltx_Math" alttext="E^{\prime}={\mathbb{P}}^{4}\cap G(H^{0}({\mathcal{E}}|_{E}),2)" display="inline" intent=":literal"><semantics><mrow><msup><mi>E</mi><mo>′</mo></msup><mo>=</mo><mrow><msup><mi>ℙ</mi><mn>4</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mi>E</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">E^{\prime}={\mathbb{P}}^{4}\cap G(H^{0}({\mathcal{E}}|_{E}),2)</annotation></semantics></math>. By Section <a href="#S6.SS1.SSS1" title="6.1.1. Dual Grassmannian and Schubert varieties ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1.1</span></a>, the elliptic pencil <math id="S6.SS1.SSS2.p9.m19" class="ltx_Math" alttext="|E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|E|</annotation></semantics></math> on <math id="S6.SS1.SSS2.p9.m20" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is cut out by the Schubert cycle <math id="S6.SS1.SSS2.p9.m21" class="ltx_Math" alttext="\Sigma_{1}(V_{4})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{1}(V_{4})</annotation></semantics></math> on <math id="S6.SS1.SSS2.p9.m22" class="ltx_Math" alttext="G(V_{6},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>6</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{6},2)</annotation></semantics></math> for some four-dimensional quotient <math id="S6.SS1.SSS2.p9.m23" class="ltx_Math" alttext="V_{4}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>4</mn></msub><annotation encoding="application/x-tex">V_{4}</annotation></semantics></math>. Recall further that there is a one-to-one correspondence between such Schubert cycles and points on the dual Grassmannian <math id="S6.SS1.SSS2.p9.m24" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.SSS2.p10" class="ltx_para">
<p id="S6.SS1.SSS2.p10.1" class="ltx_p">The following corollary follows immediately from our discussion.</p>
</div>
<div id="S6.Thmdefinition4" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmdefinition4.2" class="ltx_text ltx_font_bold">Corollary 6.4</span></span><span id="S6.Thmdefinition4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmdefinition4.p1" class="ltx_para">
<p id="S6.Thmdefinition4.p1.1" class="ltx_p"><span id="S6.Thmdefinition4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmdefinition4.p1.m1" class="ltx_Math" alttext="(S,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L)</annotation></semantics></math> be a Brill–Noether general polarized <math id="S6.Thmdefinition4.p1.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface of genus <math id="S6.Thmdefinition4.p1.m3" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math>. Let <math id="S6.Thmdefinition4.p1.m4" class="ltx_Math" alttext="{\mathbb{P}}^{5}_{(S)}\subset{\mathbb{P}}_{*}(\bigwedge^{2}H^{0}(S,{\mathcal{E}}))" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><mn>5</mn></msubsup><mo>⊂</mo><mrow><msub><mi>ℙ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{5}_{(S)}\subset{\mathbb{P}}_{*}(\bigwedge^{2}H^{0}(S,{\mathcal{E}}))</annotation></semantics></math> be the dual space of <math id="S6.Thmdefinition4.p1.m5" class="ltx_Math" alttext="{\mathbb{P}}^{8}={\mathbb{P}}^{*}H^{0}(S,L)\subset{\mathbb{P}}^{*}(\bigwedge^{2}H^{0}(S,{\mathcal{E}}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>8</mn></msup><mo>=</mo><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>ℙ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{8}={\mathbb{P}}^{*}H^{0}(S,L)\subset{\mathbb{P}}^{*}(\bigwedge^{2}H^{0}(S,{\mathcal{E}}))</annotation></semantics></math>. There is a one-to-one correspondence between elliptic pencils <math id="S6.Thmdefinition4.p1.m6" class="ltx_Math" alttext="|E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|E|</annotation></semantics></math> on <math id="S6.Thmdefinition4.p1.m7" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> satisfying <math id="S6.Thmdefinition4.p1.m8" class="ltx_Math" alttext="L.E=5" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>E</mi><mo>=</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">L.E=5</annotation></semantics></math> and points of <math id="S6.Thmdefinition4.p1.m9" class="ltx_Math" alttext="G(2,V_{6})\cap{\mathbb{P}}^{5}_{(S)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><msubsup><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><mn>5</mn></msubsup></mrow><annotation encoding="application/x-tex">G(2,V_{6})\cap{\mathbb{P}}^{5}_{(S)}</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
<section id="S6.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.1.3. </span>Maximal number of distinct elliptic pencils</h4>

<div id="S6.SS1.SSS3.p1" class="ltx_para">
<p id="S6.SS1.SSS3.p1.1" class="ltx_p">Let <math id="S6.SS1.SSS3.p1.m1" class="ltx_Math" alttext="(S,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L)</annotation></semantics></math> be a Brill–Noether general <math id="S6.SS1.SSS3.p1.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface of genus <math id="S6.SS1.SSS3.p1.m3" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> and let <math id="S6.SS1.SSS3.p1.m4" class="ltx_Math" alttext="E_{1},E_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><msub><mi>E</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">E_{1},E_{2}</annotation></semantics></math> be two classes with <math id="S6.SS1.SSS3.p1.m5" class="ltx_Math" alttext="E_{1}^{2}=E_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>E</mi><mn>1</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>E</mi><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E_{1}^{2}=E_{2}^{2}=0</annotation></semantics></math> and <math id="S6.SS1.SSS3.p1.m6" class="ltx_Math" alttext="E_{1}.L=E_{2}.L=5" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>L</mi><mo>=</mo><msub><mi>E</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>L</mi><mo>=</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">E_{1}.L=E_{2}.L=5</annotation></semantics></math>. Then <math id="S6.SS1.SSS3.p1.m7" class="ltx_Math" alttext="E_{1}.E_{2}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo lspace="0em" rspace="0.167em">.</mo><mrow><msub><mi>E</mi><mn>2</mn></msub><mo>=</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">E_{1}.E_{2}=2</annotation></semantics></math>.
Indeed, the Hodge Index Theorem on <math id="S6.SS1.SSS3.p1.m8" class="ltx_Math" alttext="E_{1}+E_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>+</mo><msub><mi>E</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">E_{1}+E_{2}</annotation></semantics></math> and <math id="S6.SS1.SSS3.p1.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> yields <math id="S6.SS1.SSS3.p1.m10" class="ltx_Math" alttext="E_{1}.E_{2}\leq 3" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo lspace="0em" rspace="0.167em">.</mo><mrow><msub><mi>E</mi><mn>2</mn></msub><mo>≤</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">E_{1}.E_{2}\leq 3</annotation></semantics></math>. Equality implies <math id="S6.SS1.SSS3.p1.m11" class="ltx_Math" alttext="(E_{1}+E_{2})^{2}=6" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>+</mo><msub><mi>E</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">(E_{1}+E_{2})^{2}=6</annotation></semantics></math> and <math id="S6.SS1.SSS3.p1.m12" class="ltx_Math" alttext="(L-E_{1}-E_{2})^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><msub><mi>E</mi><mn>1</mn></msub><mo>−</mo><msub><mi>E</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(L-E_{1}-E_{2})^{2}=0</annotation></semantics></math>, whence <math id="S6.SS1.SSS3.p1.m13" class="ltx_Math" alttext="h^{0}(S,E_{1}+E_{2})\geq 5" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>+</mo><msub><mi>E</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">h^{0}(S,E_{1}+E_{2})\geq 5</annotation></semantics></math> and <math id="S6.SS1.SSS3.p1.m14" class="ltx_Math" alttext="h^{0}(S,L-E_{1}-E_{2})\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mrow><mi>L</mi><mo>−</mo><msub><mi>E</mi><mn>1</mn></msub><mo>−</mo><msub><mi>E</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">h^{0}(S,L-E_{1}-E_{2})\geq 2</annotation></semantics></math>, a contradiction to Brill–Noether generality.</p>
</div>
<div id="S6.SS1.SSS3.p2" class="ltx_para">
<p id="S6.SS1.SSS3.p2.1" class="ltx_p">On can also see this fact geometrically using the notation of the previous section.
Let <math id="S6.SS1.SSS3.p2.m1" class="ltx_Math" alttext="V_{5},V_{5}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>5</mn></msub><mo>,</mo><msubsup><mi>V</mi><mn>5</mn><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">V_{5},V_{5}^{\prime}</annotation></semantics></math> be two distinct <math id="S6.SS1.SSS3.p2.m2" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>-dimensional subspaces of <math id="S6.SS1.SSS3.p2.m3" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>. The intersection of the Grassmannians <math id="S6.SS1.SSS3.p2.m4" class="ltx_Math" alttext="G(V_{5},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>5</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{5},2)</annotation></semantics></math> and <math id="S6.SS1.SSS3.p2.m5" class="ltx_Math" alttext="G(V_{5}^{\prime},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mn>5</mn><mo>′</mo></msubsup><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{5}^{\prime},2)</annotation></semantics></math> is the Grassmannian <math id="S6.SS1.SSS3.p2.m6" class="ltx_Math" alttext="G(V_{5}\cap V_{5}^{\prime},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>5</mn></msub><mo>∩</mo><msubsup><mi>V</mi><mn>5</mn><mo>′</mo></msubsup></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{5}\cap V_{5}^{\prime},2)</annotation></semantics></math>. The Grassmannian <math id="S6.SS1.SSS3.p2.m7" class="ltx_Math" alttext="G(V_{5}\cap V_{5}^{\prime},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>5</mn></msub><mo>∩</mo><msubsup><mi>V</mi><mn>5</mn><mo>′</mo></msubsup></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{5}\cap V_{5}^{\prime},2)</annotation></semantics></math> is a <math id="S6.SS1.SSS3.p2.m8" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-dimensional quadric. Hence, if <math id="S6.SS1.SSS3.p2.m9" class="ltx_Math" alttext="{\mathbb{P}}^{8}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>8</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{8}</annotation></semantics></math> is a general linear subspace such that its intersection with <math id="S6.SS1.SSS3.p2.m10" class="ltx_Math" alttext="G(V_{5},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>5</mn></msub><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{5},2)</annotation></semantics></math> and <math id="S6.SS1.SSS3.p2.m11" class="ltx_Math" alttext="G(V_{5}^{\prime},2)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mn>5</mn><mo>′</mo></msubsup><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(V_{5}^{\prime},2)</annotation></semantics></math> are elliptic curves, then these elliptic curves intersect in two points, namely <math id="S6.SS1.SSS3.p2.m12" class="ltx_Math" alttext="{\mathbb{P}}^{8}\cap G(V_{5}\cap V_{5}^{\prime},2)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>8</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>5</mn></msub><mo>∩</mo><msubsup><mi>V</mi><mn>5</mn><mo>′</mo></msubsup></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}^{8}\cap G(V_{5}\cap V_{5}^{\prime},2)</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.SSS3.p3" class="ltx_para">
<p id="S6.SS1.SSS3.p3.1" class="ltx_p">If all our above assumptions are satisfied, we get a <math id="S6.SS1.SSS3.p3.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface with Picard lattice containing the following lattice</p>
</div>
<div id="S6.SS1.SSS3.p4" class="ltx_para">
<table id="S6.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex10.m1" class="ltx_Math" alttext="\begin{pmatrix}14&amp;5&amp;5&amp;\dots&amp;5\\
5&amp;0&amp;2&amp;\dots&amp;2\\
5&amp;2&amp;0&amp;\ddots&amp;\vdots\\
\vdots&amp;\vdots&amp;\ddots&amp;\ddots&amp;2\\
5&amp;2&amp;\dots&amp;2&amp;0\end{pmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>14</mn></mtd><mtd><mn>5</mn></mtd><mtd><mn>5</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>5</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>2</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mn>2</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}14&amp;5&amp;5&amp;\dots&amp;5\\
5&amp;0&amp;2&amp;\dots&amp;2\\
5&amp;2&amp;0&amp;\ddots&amp;\vdots\\
\vdots&amp;\vdots&amp;\ddots&amp;\ddots&amp;2\\
5&amp;2&amp;\dots&amp;2&amp;0\end{pmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.SS1.SSS3.p5" class="ltx_para">
<p id="S6.SS1.SSS3.p5.1" class="ltx_p">An easy computation shows that the maximal possible rank is <math id="S6.SS1.SSS3.p5.m1" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math> (otherwise the matrix has at least two positive eigenvalues).
Let <math id="S6.SS1.SSS3.p5.m2" class="ltx_Math" alttext="{\mathfrak{N}}_{9}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mn>9</mn></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{9}</annotation></semantics></math> be such a lattice of maximal possible rank which is given by the following intersection matrix</p>
</div>
<div id="S6.SS1.SSS3.p6" class="ltx_para">
<table id="S6.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex11.m1" class="ltx_Math" alttext="{\mathfrak{N}}_{9}=\underbrace{\begin{pmatrix}14&amp;5&amp;5&amp;\dots&amp;5\\
5&amp;0&amp;2&amp;\dots&amp;2\\
5&amp;2&amp;0&amp;\ddots&amp;\vdots\\
\vdots&amp;\vdots&amp;\ddots&amp;\ddots&amp;2\\
5&amp;2&amp;\dots&amp;2&amp;0\end{pmatrix}}_{10\text{ columns}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔑</mi><mn>9</mn></msub><mo>=</mo><munder><munder accentunder="true"><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>14</mn></mtd><mtd><mn>5</mn></mtd><mtd><mn>5</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>5</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>2</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mn>2</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo stretchy="true">⏟</mo></munder><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mtext> columns</mtext></mrow></munder></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathfrak{N}}_{9}=\underbrace{\begin{pmatrix}14&amp;5&amp;5&amp;\dots&amp;5\\
5&amp;0&amp;2&amp;\dots&amp;2\\
5&amp;2&amp;0&amp;\ddots&amp;\vdots\\
\vdots&amp;\vdots&amp;\ddots&amp;\ddots&amp;2\\
5&amp;2&amp;\dots&amp;2&amp;0\end{pmatrix}}_{10\text{ columns}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.SS1.SSS3.p7" class="ltx_para">
<p id="S6.SS1.SSS3.p7.1" class="ltx_p">We denote <math id="S6.SS1.SSS3.p7.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> a <math id="S6.SS1.SSS3.p7.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface with the above Picard lattice <math id="S6.SS1.SSS3.p7.m3" class="ltx_Math" alttext="{\mathfrak{N}}_{9}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mn>9</mn></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{9}</annotation></semantics></math> of rank <math id="S6.SS1.SSS3.p7.m4" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>
(which again exists by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx25" title="" class="ltx_ref">Mor84</a>, Thm. 2.9(i)]</cite> or <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">Nik80</a>]</cite>)
and let <math id="S6.SS1.SSS3.p7.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> be the basis element of square <math id="S6.SS1.SSS3.p7.m6" class="ltx_Math" alttext="14" display="inline" intent=":literal"><semantics><mn>14</mn><annotation encoding="application/x-tex">14</annotation></semantics></math>, which can be taken to be big and nef by standard arguments (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BHPV04</a>, VIII, Prop. 3.10]</cite>).
Let <math id="S6.SS1.SSS3.p7.m7" class="ltx_Math" alttext="E_{i}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>i</mi></msub><annotation encoding="application/x-tex">E_{i}</annotation></semantics></math>, <math id="S6.SS1.SSS3.p7.m8" class="ltx_Math" alttext="i=1,\dots,9" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">i=1,\dots,9</annotation></semantics></math>, be the generators of square zero.</p>
</div>
<div id="S6.Thmdefinition5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmdefinition5.2" class="ltx_text ltx_font_bold">Lemma 6.5</span></span><span id="S6.Thmdefinition5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmdefinition5.p1" class="ltx_para">
<ol id="S6.I1" class="ltx_enumerate">
<li id="S6.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S6.I1.ix1.p1" class="ltx_para">
<p id="S6.I1.ix1.p1.1" class="ltx_p"><span id="S6.I1.ix1.p1.1.1" class="ltx_text ltx_font_italic">The class </span><math id="S6.I1.ix1.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S6.I1.ix1.p1.1.2" class="ltx_text ltx_font_italic"> is ample.</span></p>
</div></li>
<li id="S6.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S6.I1.ix2.p1" class="ltx_para">
<p id="S6.I1.ix2.p1.1" class="ltx_p"><span id="S6.I1.ix2.p1.1.1" class="ltx_text ltx_font_italic">The </span><math id="S6.I1.ix2.p1.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math><span id="S6.I1.ix2.p1.1.2" class="ltx_text ltx_font_italic"> surface </span><math id="S6.I1.ix2.p1.m2" class="ltx_Math" alttext="(S,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L)</annotation></semantics></math><span id="S6.I1.ix2.p1.1.3" class="ltx_text ltx_font_italic"> is Brill–Noether general.</span></p>
</div></li>
<li id="S6.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S6.I1.ix3.p1" class="ltx_para">
<p id="S6.I1.ix3.p1.1" class="ltx_p"><span id="S6.I1.ix3.p1.1.1" class="ltx_text ltx_font_italic">The classes </span><math id="S6.I1.ix3.p1.m1" class="ltx_Math" alttext="E_{1},\dots,E_{9}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>E</mi><mn>9</mn></msub></mrow><annotation encoding="application/x-tex">E_{1},\dots,E_{9}</annotation></semantics></math><span id="S6.I1.ix3.p1.1.2" class="ltx_text ltx_font_italic"> define elliptic pencils.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S6.SS1.SSS3.p8" class="ltx_para">
<p id="S6.SS1.SSS3.p8.1" class="ltx_p">This can probably be proved arguing as in the proof of Lemma <a href="#S4.Thmdefinition2" title="Lemma 4.2. ‣ 4. K3 surfaces of genus 6 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, but the computations are much more tedious. Instead we will give a constructive proof in the next subsection.</p>
</div>
</section>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.2. </span>A unirational construction of <math id="S6.SS2.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces with nine distinct elliptic pencils</h3>

<div id="S6.SS2.p1" class="ltx_para">
<p id="S6.SS2.p1.1" class="ltx_p">Recall that any projective equivalence of two <math id="S6.SS2.p1.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces that are linear sections of the Grassmannian <math id="S6.SS2.p1.m2" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math> is induced by an automorphism of <math id="S6.SS2.p1.m3" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math> (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx26" title="" class="ltx_ref">Muk88</a>, Theorem 0.2]</cite>).</p>
</div>
<div id="S6.SS2.p2" class="ltx_para">
<p id="S6.SS2.p2.1" class="ltx_p">By Corollary <a href="#S6.Thmdefinition4" title="Corollary 6.4. ‣ 6.1.2. Extension of elliptic curves to the Grassmannian 
            
              
                G
                
                  
                    
                    
                    
                  
                  
                    (
                    
                      
                      V
                      6
                    
                    ,
                    2
                    ) ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a>, any Brill–Noether general polarized <math id="S6.SS2.p2.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface <math id="S6.SS2.p2.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> of genus <math id="S6.SS2.p2.m3" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> with exactly nine elliptic pencils of degree five induces and is induced by a unique five-dimensional space <math id="S6.SS2.p2.m4" class="ltx_Math" alttext="{\mathbb{P}}^{5}_{(S)}" display="inline" intent=":literal"><semantics><msubsup><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><mn>5</mn></msubsup><annotation encoding="application/x-tex">{\mathbb{P}}^{5}_{(S)}</annotation></semantics></math> intersecting <math id="S6.SS2.p2.m5" class="ltx_Math" alttext="G(2,V_{6})\subset{\mathbb{P}}^{14}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msup><mi>ℙ</mi><mn>14</mn></msup></mrow><annotation encoding="application/x-tex">G(2,V_{6})\subset{\mathbb{P}}^{14}</annotation></semantics></math> in exactly nine points. We reformulate this fact in the following proposition. To state it we denote <math id="S6.SS2.p2.m6" class="ltx_Math" alttext="{\mathcal{H}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{H}}_{9,5}(G(2,V_{6}))</annotation></semantics></math> the space of <math id="S6.SS2.p2.m7" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math>-secant <math id="S6.SS2.p2.m8" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>-planes of the Grassmannian <math id="S6.SS2.p2.m9" class="ltx_Math" alttext="G(2,V_{6})\subset{\mathbb{P}}^{14}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msup><mi>ℙ</mi><mn>14</mn></msup></mrow><annotation encoding="application/x-tex">G(2,V_{6})\subset{\mathbb{P}}^{14}</annotation></semantics></math> intersecting the latter in exactly nine points and <math id="S6.SS2.p2.m10" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))</annotation></semantics></math> this space modulo the automorphisms of <math id="S6.SS2.p2.m11" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmdefinition6" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmdefinition6.2" class="ltx_text ltx_font_bold">Proposition 6.6</span></span><span id="S6.Thmdefinition6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmdefinition6.p1" class="ltx_para">
<p id="S6.Thmdefinition6.p1.1" class="ltx_p"><span id="S6.Thmdefinition6.p1.1.1" class="ltx_text ltx_font_italic">The moduli space of Brill–Noether general polarized <math id="S6.Thmdefinition6.p1.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces of genus <math id="S6.Thmdefinition6.p1.m2" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> with exactly nine elliptic pencils of degree <math id="S6.Thmdefinition6.p1.m3" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>
is birational to <math id="S6.Thmdefinition6.p1.m4" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))</annotation></semantics></math>, and both spaces are non-empty.</span></p>
</div>
</div>
<div id="S6.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.p3" class="ltx_para">
<p id="S6.SS2.p3.1" class="ltx_p"><span id="S6.SS2.p3.1.1" class="ltx_text">By Corollary <a href="#S6.Thmdefinition4" title="Corollary 6.4. ‣ 6.1.2. Extension of elliptic curves to the Grassmannian 
            
              
                G
                
                  
                    
                    
                    
                  
                  
                    (
                    
                      
                      V
                      6
                    
                    ,
                    2
                    ) ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a>, we only need to prove the non-emptiness of <math id="S6.SS2.p3.m1" class="ltx_Math" alttext="{\mathcal{H}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{H}}_{9,5}(G(2,V_{6}))</annotation></semantics></math>.
A general intersection of <math id="S6.SS2.p3.m2" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math> and a <math id="S6.SS2.p3.m3" class="ltx_Math" alttext="{\mathbb{P}}^{7}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>7</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{7}</annotation></semantics></math> is a smooth curve <math id="S6.SS2.p3.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> of genus <math id="S6.SS2.p3.m5" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> and the general curve of genus <math id="S6.SS2.p3.m6" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> is obtained in this way (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Muk93</a>]</cite>). Furthermore, a <math id="S6.SS2.p3.m7" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math>-secant <math id="S6.SS2.p3.m8" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>-plane of <math id="S6.SS2.p3.m9" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math> contained in this <math id="S6.SS2.p3.m10" class="ltx_Math" alttext="{\mathbb{P}}^{7}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>7</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{7}</annotation></semantics></math> is also a <math id="S6.SS2.p3.m11" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math>-secant of <math id="S6.SS2.p3.m12" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, which is a divisor in a <math id="S6.SS2.p3.m13" class="ltx_Math" alttext="g^{3}_{9}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mn>9</mn><mn>3</mn></msubsup><annotation encoding="application/x-tex">g^{3}_{9}</annotation></semantics></math> by the geometric Riemann–Roch. Note that the <math id="S6.SS2.p3.m14" class="ltx_Math" alttext="g^{3}_{9}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mn>9</mn><mn>3</mn></msubsup><annotation encoding="application/x-tex">g^{3}_{9}</annotation></semantics></math> is automatically base point free as otherwise the curve would not be Brill–Noether general and thus could not be a linear section of the <math id="S6.SS2.p3.m15" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math> by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Muk93</a>]</cite>. Hence
a general divisor in the <math id="S6.SS2.p3.m16" class="ltx_Math" alttext="g^{3}_{9}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mn>9</mn><mn>3</mn></msubsup><annotation encoding="application/x-tex">g^{3}_{9}</annotation></semantics></math> induces an element of <math id="S6.SS2.p3.m17" class="ltx_Math" alttext="{\mathcal{H}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{H}}_{9,5}(G(2,V_{6}))</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p4" class="ltx_para">
<p id="S6.SS2.p4.1" class="ltx_p"><span id="S6.SS2.p4.1.1" class="ltx_text">We have reduced the problem to constructing a curve of genus <math id="S6.SS2.p4.m1" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> as a linear section of <math id="S6.SS2.p4.m2" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math> carrying a <math id="S6.SS2.p4.m3" class="ltx_Math" alttext="g^{3}_{9}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mn>9</mn><mn>3</mn></msubsup><annotation encoding="application/x-tex">g^{3}_{9}</annotation></semantics></math>, or equivalently, taking residuals, a <math id="S6.SS2.p4.m4" class="ltx_Math" alttext="g^{1}_{5}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mn>5</mn><mn>1</mn></msubsup><annotation encoding="application/x-tex">g^{1}_{5}</annotation></semantics></math>. Such a curve can be realized as follows: We get a divisor <math id="S6.SS2.p4.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> of degree <math id="S6.SS2.p4.m6" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> in a <math id="S6.SS2.p4.m7" class="ltx_Math" alttext="g^{1}_{5}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mn>5</mn><mn>1</mn></msubsup><annotation encoding="application/x-tex">g^{1}_{5}</annotation></semantics></math> on a curve <math id="S6.SS2.p4.m8" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> of genus <math id="S6.SS2.p4.m9" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> if we fix a <math id="S6.SS2.p4.m10" class="ltx_Math" alttext="G(2,V_{5})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{5})</annotation></semantics></math> (where <math id="S6.SS2.p4.m11" class="ltx_Math" alttext="V_{5}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>5</mn></msub><annotation encoding="application/x-tex">V_{5}</annotation></semantics></math> is a <math id="S6.SS2.p4.m12" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>-dimensional subspace of <math id="S6.SS2.p4.m13" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>) and choose a <math id="S6.SS2.p4.m14" class="ltx_Math" alttext="{\mathbb{P}}^{7}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>7</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{7}</annotation></semantics></math> such that <math id="S6.SS2.p4.m15" class="ltx_Math" alttext="C={\mathbb{P}}^{7}\cap G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><msup><mi>ℙ</mi><mn>7</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C={\mathbb{P}}^{7}\cap G(2,V_{6})</annotation></semantics></math> and <math id="S6.SS2.p4.m16" class="ltx_Math" alttext="D={\mathbb{P}}^{7}\cap G(2,V_{5})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><msup><mi>ℙ</mi><mn>7</mn></msup><mo>∩</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">D={\mathbb{P}}^{7}\cap G(2,V_{5})</annotation></semantics></math> induces the <math id="S6.SS2.p4.m17" class="ltx_Math" alttext="g^{1}_{5}=|D|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mn>5</mn><mn>1</mn></msubsup><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">g^{1}_{5}=|D|</annotation></semantics></math>. In an ancillary file, cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx15" title="" class="ltx_ref">HK20</a>]</cite>, we have implemented this construction in <em id="S6.SS2.p4.1.1.1" class="ltx_emph ltx_font_italic">Macaulay2</em> (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx14" title="" class="ltx_ref">GS</a>]</cite>) as well as the construction of the corresponding <math id="S6.SS2.p4.m18" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface.
∎</span></p>
</div>
</div>
<div id="S6.SS2.p5" class="ltx_para">
<p id="S6.SS2.p5.1" class="ltx_p">The Picard lattice of the <math id="S6.SS2.p5.m1" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces in the moduli space in Proposition <a href="#S6.Thmdefinition6" title="Proposition 6.6. ‣ 6.2. A unirational construction of 
          
            
              ⁢
              K
              3
            
          
         surfaces with nine distinct elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a> contains the lattice <math id="S6.SS2.p5.m2" class="ltx_Math" alttext="{\mathfrak{N}}_{9}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mn>9</mn></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{9}</annotation></semantics></math> and the generator of square <math id="S6.SS2.p5.m3" class="ltx_Math" alttext="14" display="inline" intent=":literal"><semantics><mn>14</mn><annotation encoding="application/x-tex">14</annotation></semantics></math> is (very) ample and the generators of square <math id="S6.SS2.p5.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> are nef. Let <math id="S6.SS2.p5.m5" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{9}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mn>9</mn></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{9}}</annotation></semantics></math> be the moduli space of <math id="S6.SS2.p5.m6" class="ltx_Math" alttext="{\mathfrak{N}}_{9}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mn>9</mn></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{9}</annotation></semantics></math>-lattice polarized <math id="S6.SS2.p5.m7" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces. By standard deformation arguments (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">Kod64</a>, Thm. 14]</cite>) the very general element in <math id="S6.SS2.p5.m8" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{9}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mn>9</mn></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{9}}</annotation></semantics></math> has Picard lattice equal to <math id="S6.SS2.p5.m9" class="ltx_Math" alttext="{\mathfrak{N}}_{9}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mn>9</mn></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{9}</annotation></semantics></math>, is Brill–Noether general with ample generator of square <math id="S6.SS2.p5.m10" class="ltx_Math" alttext="14" display="inline" intent=":literal"><semantics><mn>14</mn><annotation encoding="application/x-tex">14</annotation></semantics></math> and the generators of square <math id="S6.SS2.p5.m11" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> define elliptic pencils.</p>
</div>
<div id="S6.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#S6.Thmdefinition5" title="Lemma 6.5. ‣ 6.1.3. Maximal number of distinct elliptic pencils ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.5</span></a>.</h6>
<div id="S6.SS2.p6" class="ltx_para">
<p id="S6.SS2.p6.1" class="ltx_p"><span id="S6.SS2.p6.1.1" class="ltx_text">The last discussion proves the lemma for the very general element in <math id="S6.SS2.p6.m1" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{9}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mn>9</mn></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{9}}</annotation></semantics></math> having Picard lattice equal to <math id="S6.SS2.p6.m2" class="ltx_Math" alttext="{\mathfrak{N}}_{9}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mn>9</mn></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{9}</annotation></semantics></math>. Since the properties (a)-(c) of the lemma only depend on the lattice, this finishes the proof.
∎</span></p>
</div>
</div>
<div id="S6.SS2.p7" class="ltx_para">
<p id="S6.SS2.p7.1" class="ltx_p">We also have the following</p>
</div>
<div id="S6.Thmdefinition7" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmdefinition7.2" class="ltx_text ltx_font_bold">Theorem 6.7</span></span><span id="S6.Thmdefinition7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmdefinition7.p1" class="ltx_para">
<p id="S6.Thmdefinition7.p1.1" class="ltx_p"><span id="S6.Thmdefinition7.p1.1.1" class="ltx_text ltx_font_italic">The moduli space <math id="S6.Thmdefinition7.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{9}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mn>9</mn></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{9}}</annotation></semantics></math> of <math id="S6.Thmdefinition7.p1.m2" class="ltx_Math" alttext="{\mathfrak{N}}_{9}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mn>9</mn></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{9}</annotation></semantics></math>-lattice polarized <math id="S6.Thmdefinition7.p1.m3" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces is unirational.</span></p>
</div>
</div>
<div id="S6.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.p8" class="ltx_para">
<p id="S6.SS2.p8.1" class="ltx_p"><span id="S6.SS2.p8.1.1" class="ltx_text">The above discussion shows that <math id="S6.SS2.p8.m1" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{9}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mn>9</mn></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{9}}</annotation></semantics></math> is birational to <math id="S6.SS2.p8.m2" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))</annotation></semantics></math>. In particular, <math id="S6.SS2.p8.m3" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))</annotation></semantics></math> is irreducible.</span></p>
</div>
<div id="S6.SS2.p9" class="ltx_para">
<p id="S6.SS2.p9.1" class="ltx_p"><span id="S6.SS2.p9.1.1" class="ltx_text">Consider the following incidence variety</span></p>
<table id="S6.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex12.m1" class="ltx_math_unparsed" alttext="\{(V_{5}^{9},{\mathbb{P}}^{7})\in{\mathcal{H}}_{9,5}(G(2,V_{6}))\times G(8,\Lambda^{2}V_{6})\ |\ V_{5}^{9}\subset{\mathbb{P}}^{7},\ C={\mathbb{P}}^{7}\cap G(2,V_{6})\text{ a smooth curve}\}" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mn>5</mn><mn>9</mn></msubsup><mo>,</mo><msup><mi>ℙ</mi><mn>7</mn></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>8</mn><mo>,</mo><msup><mi mathvariant="normal">Λ</mi><mn>2</mn></msup><msub><mi>V</mi><mn>6</mn></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msubsup><mi>V</mi><mn>5</mn><mn>9</mn></msubsup><mo>⊂</mo><msup><mi>ℙ</mi><mn>7</mn></msup><mo rspace="0.667em">,</mo><mi>C</mi><mo>=</mo><msup><mi>ℙ</mi><mn>7</mn></msup><mo>∩</mo><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow><mtext> a smooth curve</mtext><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(V_{5}^{9},{\mathbb{P}}^{7})\in{\mathcal{H}}_{9,5}(G(2,V_{6}))\times G(8,\Lambda^{2}V_{6})\ |\ V_{5}^{9}\subset{\mathbb{P}}^{7},\ C={\mathbb{P}}^{7}\cap G(2,V_{6})\text{ a smooth curve}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p9.2" class="ltx_p"><span id="S6.SS2.p9.2.1" class="ltx_text">and denote <math id="S6.SS2.p9.m1" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> its quotient with the automorphisms of <math id="S6.SS2.p9.m2" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math> acting diagonally. Then <math id="S6.SS2.p9.m3" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> admits a natural first projection map <math id="S6.SS2.p9.m4" class="ltx_Math" alttext="\pi_{1}:I\to\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>I</mi><mo stretchy="false">→</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{1}:I\to\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))</annotation></semantics></math> and a second projection to the moduli space of curves of genus <math id="S6.SS2.p9.m5" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math>. As for <math id="S6.SS2.p9.m6" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces, any projective equivalence of two curves of genus <math id="S6.SS2.p9.m7" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> that are linear sections of the Grassmannian <math id="S6.SS2.p9.m8" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math> is induced by an automorphism of <math id="S6.SS2.p9.m9" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p10" class="ltx_para">
<p id="S6.SS2.p10.1" class="ltx_p"><span id="S6.SS2.p10.1.1" class="ltx_text">The proof of Proposition <a href="#S6.Thmdefinition6" title="Proposition 6.6. ‣ 6.2. A unirational construction of 
          
            
              ⁢
              K
              3
            
          
         surfaces with nine distinct elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a> shows that <math id="S6.SS2.p10.m1" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> is non-empty and is therefore birational to a <math id="S6.SS2.p10.m2" class="ltx_Math" alttext="{\mathbb{P}}^{3}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>3</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{3}</annotation></semantics></math>-bundle over the universal Brill–Noether variety <math id="S6.SS2.p10.m3" class="ltx_Math" alttext="{\mathcal{W}}_{8,9}^{3}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mrow><mn>8</mn><mo>,</mo><mn>9</mn></mrow><mn>3</mn></msubsup><annotation encoding="application/x-tex">{\mathcal{W}}_{8,9}^{3}</annotation></semantics></math> by the universal Abel–Jacobi map. Hence <math id="S6.SS2.p10.m4" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> is unirational and irreducible, since <math id="S6.SS2.p10.m5" class="ltx_Math" alttext="{\mathcal{W}}_{8,9}^{3}\cong{\mathcal{W}}_{8,5}^{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mrow><mn>8</mn><mo>,</mo><mn>9</mn></mrow><mn>3</mn></msubsup><mo>≅</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mrow><mn>8</mn><mo>,</mo><mn>5</mn></mrow><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{W}}_{8,9}^{3}\cong{\mathcal{W}}_{8,5}^{1}</annotation></semantics></math> is unirational (and irreducible) by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AC81</a>]</cite>.
Since <math id="S6.SS2.p10.m6" class="ltx_Math" alttext="\pi_{1}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\pi_{1}</annotation></semantics></math> is dominant (because <math id="S6.SS2.p10.m7" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))</annotation></semantics></math> is irreducible), <math id="S6.SS2.p10.m8" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>9</mn><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{9,5}(G(2,V_{6}))</annotation></semantics></math> is unirational. The theorem follows.
∎</span></p>
</div>
</div>
<div id="S6.SS2.p11" class="ltx_para">
<p id="S6.SS2.p11.1" class="ltx_p">One may also consider, for <math id="S6.SS2.p11.m1" class="ltx_Math" alttext="i\in\{0,\ldots,8\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>8</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,\ldots,8\}</annotation></semantics></math>, the moduli spaces <math id="S6.SS2.p11.m2" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{i}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{i}}</annotation></semantics></math> of <math id="S6.SS2.p11.m3" class="ltx_Math" alttext="{\mathfrak{N}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{i}</annotation></semantics></math>-lattice polarized <math id="S6.SS2.p11.m4" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces, where <math id="S6.SS2.p11.m5" class="ltx_Math" alttext="{\mathfrak{N}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{i}</annotation></semantics></math> is the rank <math id="S6.SS2.p11.m6" class="ltx_Math" alttext="i+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i+1</annotation></semantics></math> lattice</p>
<table id="S6.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex13.m1" class="ltx_Math" alttext="{\mathfrak{N}}_{i}=\underbrace{\begin{pmatrix}14&amp;5&amp;5&amp;\dots&amp;5\\
5&amp;0&amp;2&amp;\dots&amp;2\\
5&amp;2&amp;0&amp;\ddots&amp;\vdots\\
\vdots&amp;\vdots&amp;\ddots&amp;\ddots&amp;2\\
5&amp;2&amp;\dots&amp;2&amp;0\end{pmatrix}}_{i+1\text{ columns}}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝔑</mi><mi>i</mi></msub><mo>=</mo><munder><munder accentunder="true"><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>14</mn></mtd><mtd><mn>5</mn></mtd><mtd><mn>5</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>5</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>2</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mn>2</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>i</mi><mo>+</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mtext> columns</mtext></mrow></mrow></munder></mrow><annotation encoding="application/x-tex">{\mathfrak{N}}_{i}=\underbrace{\begin{pmatrix}14&amp;5&amp;5&amp;\dots&amp;5\\
5&amp;0&amp;2&amp;\dots&amp;2\\
5&amp;2&amp;0&amp;\ddots&amp;\vdots\\
\vdots&amp;\vdots&amp;\ddots&amp;\ddots&amp;2\\
5&amp;2&amp;\dots&amp;2&amp;0\end{pmatrix}}_{i+1\text{ columns}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p11.2" class="ltx_p">Then <math id="S6.SS2.p11.m7" class="ltx_Math" alttext="\dim{\mathcal{F}}^{{\mathfrak{N}}_{i}}=19-i" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mi>i</mi></msub></msup></mrow><mo>=</mo><mrow><mn>19</mn><mo>−</mo><mi>i</mi></mrow></mrow><annotation encoding="application/x-tex">\dim{\mathcal{F}}^{{\mathfrak{N}}_{i}}=19-i</annotation></semantics></math> and <math id="S6.SS2.p11.m8" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{i+1}}\subset{\mathcal{F}}^{{\mathfrak{N}}_{i}}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msup><mo>⊂</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mi>i</mi></msub></msup></mrow><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{i+1}}\subset{\mathcal{F}}^{{\mathfrak{N}}_{i}}</annotation></semantics></math> for each <math id="S6.SS2.p11.m9" class="ltx_Math" alttext="i\in\{0,\ldots,8\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>8</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,\ldots,8\}</annotation></semantics></math>. Note that <math id="S6.SS2.p11.m10" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{0}}={\mathcal{F}}_{8}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mn>0</mn></msub></msup><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>8</mn></msub></mrow><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{0}}={\mathcal{F}}_{8}</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmdefinition8" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmdefinition8.2" class="ltx_text ltx_font_bold">Theorem 6.8</span></span><span id="S6.Thmdefinition8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmdefinition8.p1" class="ltx_para">
<p id="S6.Thmdefinition8.p1.1" class="ltx_p"><span id="S6.Thmdefinition8.p1.1.1" class="ltx_text ltx_font_italic">The moduli spaces <math id="S6.Thmdefinition8.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{i}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{i}}</annotation></semantics></math> of <math id="S6.Thmdefinition8.p1.m2" class="ltx_Math" alttext="{\mathfrak{N}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔑</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathfrak{N}}_{i}</annotation></semantics></math>-lattice polarized <math id="S6.Thmdefinition8.p1.m3" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surfaces are unirational for <math id="S6.Thmdefinition8.p1.m4" class="ltx_Math" alttext="i\leq 6" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">i\leq 6</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.p12" class="ltx_para">
<p id="S6.SS2.p12.1" class="ltx_p"><span id="S6.SS2.p12.1.1" class="ltx_text">The case <math id="S6.SS2.p12.m1" class="ltx_Math" alttext="i=0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i=0</annotation></semantics></math> is proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx26" title="" class="ltx_ref">Muk88</a>]</cite>.
By Corollary <a href="#S6.Thmdefinition4" title="Corollary 6.4. ‣ 6.1.2. Extension of elliptic curves to the Grassmannian 
            
              
                G
                
                  
                    
                    
                    
                  
                  
                    (
                    
                      
                      V
                      6
                    
                    ,
                    2
                    ) ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a> and Lemma <a href="#S6.Thmdefinition5" title="Lemma 6.5. ‣ 6.1.3. Maximal number of distinct elliptic pencils ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.5</span></a>, the general <math id="S6.SS2.p12.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface in <math id="S6.SS2.p12.m3" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{i}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{i}}</annotation></semantics></math> corresponds uniquely to a five-dimensional projective space intersecting the Grassmannian <math id="S6.SS2.p12.m4" class="ltx_Math" alttext="G(2,V_{6})\subset{\mathbb{P}}^{14}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msup><mi>ℙ</mi><mn>14</mn></msup></mrow><annotation encoding="application/x-tex">G(2,V_{6})\subset{\mathbb{P}}^{14}</annotation></semantics></math> in exactly <math id="S6.SS2.p12.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> points modulo automorphisms of <math id="S6.SS2.p12.m6" class="ltx_Math" alttext="V_{6}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>6</mn></msub><annotation encoding="application/x-tex">V_{6}</annotation></semantics></math>. Such <math id="S6.SS2.p12.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-secant <math id="S6.SS2.p12.m8" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>-planes are unirationally parametrized by the product of the <math id="S6.SS2.p12.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th symmetric product of <math id="S6.SS2.p12.m10" class="ltx_Math" alttext="G(2,V_{6})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>V</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(2,V_{6})</annotation></semantics></math> and <math id="S6.SS2.p12.m11" class="ltx_Math" alttext="(6-i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(6-i)</annotation></semantics></math>-th symmetric product of <math id="S6.SS2.p12.m12" class="ltx_Math" alttext="{\mathbb{P}}^{14}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>14</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{14}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S6.SS2.p13" class="ltx_para">
<p id="S6.SS2.p13.1" class="ltx_p">We remark that the unirationality of <math id="S6.SS2.p13.m1" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{1}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mn>1</mn></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{1}}</annotation></semantics></math> can also be shown using quartic surfaces in <math id="S6.SS2.p13.m2" class="ltx_Math" alttext="{\mathbb{P}}^{3}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>3</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{3}</annotation></semantics></math> containing an elliptic quintic curve.
The question of (uni)rationality of <math id="S6.SS2.p13.m3" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{7}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mn>7</mn></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{7}}</annotation></semantics></math> and <math id="S6.SS2.p13.m4" class="ltx_Math" alttext="{\mathcal{F}}^{{\mathfrak{N}}_{8}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>𝔑</mi><mn>8</mn></msub></msup><annotation encoding="application/x-tex">{\mathcal{F}}^{{\mathfrak{N}}_{8}}</annotation></semantics></math> is open.</p>
</div>
</section>
<section id="S6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.3. </span>The moduli map</h3>

<div id="S6.SS3.p1" class="ltx_para">
<p id="S6.SS3.p1.1" class="ltx_p">Let <math id="S6.SS3.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{8}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>8</mn></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{8}</annotation></semantics></math> denote the <math id="S6.SS3.p1.m2" class="ltx_Math" alttext="19" display="inline" intent=":literal"><semantics><mn>19</mn><annotation encoding="application/x-tex">19</annotation></semantics></math>-dimensional moduli space of polarized <math id="S6.SS3.p1.m3" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface of genus <math id="S6.SS3.p1.m4" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> and
<math id="S6.SS3.p1.m5" class="ltx_Math" alttext="{\mathcal{P}}_{8}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>8</mn></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{8}</annotation></semantics></math> the moduli space of triples <math id="S6.SS3.p1.m6" class="ltx_Math" alttext="(S,L,C)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L,C)</annotation></semantics></math> where <math id="S6.SS3.p1.m7" class="ltx_Math" alttext="(S,L)\in{\mathcal{F}}_{8}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>8</mn></msub></mrow><annotation encoding="application/x-tex">(S,L)\in{\mathcal{F}}_{8}</annotation></semantics></math> and <math id="S6.SS3.p1.m8" class="ltx_Math" alttext="C\in|L|" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">C\in|L|</annotation></semantics></math> is a smooth irreducible curve. Let <math id="S6.SS3.p1.m9" class="ltx_Math" alttext="m_{8}:{\mathcal{P}}_{8}\longrightarrow{\mathcal{M}}_{8}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>8</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>8</mn></msub><mo stretchy="false">⟶</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>8</mn></msub></mrow></mrow><annotation encoding="application/x-tex">m_{8}:{\mathcal{P}}_{8}\longrightarrow{\mathcal{M}}_{8}</annotation></semantics></math>
be the moduli map.</p>
</div>
<div id="S6.Thmdefinition9" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmdefinition9.2" class="ltx_text ltx_font_bold">Proposition 6.9</span></span><span id="S6.Thmdefinition9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmdefinition9.p1" class="ltx_para">
<p id="S6.Thmdefinition9.p1.1" class="ltx_p"><span id="S6.Thmdefinition9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmdefinition9.p1.m1" class="ltx_Math" alttext="(S,L)\in{\mathcal{F}}_{8}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>8</mn></msub></mrow><annotation encoding="application/x-tex">(S,L)\in{\mathcal{F}}_{8}</annotation></semantics></math> be a Brill–Noether general <math id="S6.Thmdefinition9.p1.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface such that <math id="S6.Thmdefinition9.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> contains an elliptic pencil <math id="S6.Thmdefinition9.p1.m4" class="ltx_Math" alttext="|E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|E|</annotation></semantics></math> satisfying <math id="S6.Thmdefinition9.p1.m5" class="ltx_Math" alttext="E.L=5" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>L</mi><mo>=</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">E.L=5</annotation></semantics></math>. Then the fiber of <math id="S6.Thmdefinition9.p1.m6" class="ltx_Math" alttext="m_{8}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>8</mn></msub><annotation encoding="application/x-tex">m_{8}</annotation></semantics></math> is smooth and <math id="S6.Thmdefinition9.p1.m7" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>-dimensional at any point represented by a smooth curve <math id="S6.Thmdefinition9.p1.m8" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> in <math id="S6.Thmdefinition9.p1.m9" class="ltx_Math" alttext="|L|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|L|</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS3.p2" class="ltx_para">
<p id="S6.SS3.p2.1" class="ltx_p"><span id="S6.SS3.p2.1.1" class="ltx_text">By comparing dimensions, the fibers of <math id="S6.SS3.p2.m1" class="ltx_Math" alttext="m_{8}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>8</mn></msub><annotation encoding="application/x-tex">m_{8}</annotation></semantics></math> are at least <math id="S6.SS3.p2.m2" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>-dimensional. (It is known that <math id="S6.SS3.p2.m3" class="ltx_Math" alttext="m_{8}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>8</mn></msub><annotation encoding="application/x-tex">m_{8}</annotation></semantics></math> is dominant, whence its general fibers are precisely <math id="S6.SS3.p2.m4" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>-dimensional, but we will not use this.) By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx34" title="" class="ltx_ref">Ser06</a>, §3.4.4]</cite> or <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx7" title="" class="ltx_ref">Bea04</a>]</cite>, the kernel of the differential of <math id="S6.SS3.p2.m5" class="ltx_Math" alttext="m_{8}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>8</mn></msub><annotation encoding="application/x-tex">m_{8}</annotation></semantics></math> at a point <math id="S6.SS3.p2.m6" class="ltx_Math" alttext="(S,L,C)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,L,C)</annotation></semantics></math> is isomorphic to <math id="S6.SS3.p2.m7" class="ltx_Math" alttext="H^{1}({\mathcal{T}}_{S}(-L))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}({\mathcal{T}}_{S}(-L))</annotation></semantics></math>. To prove the proposition, it therefore suffices by Serre duality to prove that <math id="S6.SS3.p2.m8" class="ltx_Math" alttext="h^{1}(\Omega_{S}(L))\leq 6" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Ω</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">h^{1}(\Omega_{S}(L))\leq 6</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS3.p3" class="ltx_para">
<p id="S6.SS3.p3.1" class="ltx_p"><span id="S6.SS3.p3.1.1" class="ltx_text">Let <math id="S6.SS3.p3.m1" class="ltx_Math" alttext="\varphi:S\to{\mathbb{P}}^{3}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\varphi:S\to{\mathbb{P}}^{3}</annotation></semantics></math> be the morphism defined by <math id="S6.SS3.p3.m2" class="ltx_Math" alttext="|L-E|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>L</mi><mo>−</mo><mi>E</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|L-E|</annotation></semantics></math> and <math id="S6.SS3.p3.m3" class="ltx_Math" alttext="S_{0}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mn>0</mn></msub><annotation encoding="application/x-tex">S_{0}</annotation></semantics></math> be its image, which is a quartic surface. By Lemma <a href="#S6.Thmdefinition2" title="Lemma 6.2. ‣ 6.1.2. Extension of elliptic curves to the Grassmannian 
            
              
                G
                
                  
                    
                    
                    
                  
                  
                    (
                    
                      
                      V
                      6
                    
                    ,
                    2
                    ) ‣ 6.1. Linear sections of 
          
            
              G
              
                
                  
                  
                  
                
                
                  (
                  
                    
                    V
                    6
                  
                  ,
                  2
                  )
                
              
            
          
         and elliptic pencils ‣ 6. K3 surfaces of genus 8 ‣ Brill–Noether general K3 surfaces with the maximal number of elliptic pencils of minimal degree" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a> its possible singularities are images of contracted disjoint rational curves <math id="S6.SS3.p3.m4" class="ltx_Math" alttext="\Gamma_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Gamma_{i}</annotation></semantics></math> on <math id="S6.SS3.p3.m5" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, <math id="S6.SS3.p3.m6" class="ltx_Math" alttext="i=1,\ldots,k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,k</annotation></semantics></math>.
By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Mor85</a>, Thm. 2.1]</cite> we have a short exact sequence</span></p>
<table id="S6.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S6.E3.m1.pic1" class="ltx_picture ltx_markedasmath" height="21.84" overflow="visible" style="vertical-align:-11.623071670796147px" version="1.1" viewBox="7.61 11.62 412.05 21.84" width="412.05"><g transform="matrix(1 0 0 -1 7.610350076103501 21.842892146529508) translate(0,3.46) translate(7.61,0)"><g transform="translate(-7.61,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.E3.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{0\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\textstyle{0\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 7.610371189690138 -0.27673578005007266 L 7.610371189690138 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(40.82,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 7.610371189690138 -0.27673578005007266 L 40.819150408191504 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 40.819150408191504 -0.27673578005007266 L 40.819150408191504 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(40.82,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.4em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;fon