slate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex14.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{0}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\textstyle{0}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS3.p4.2" class="ltx_p"><span id="S6.SS3.p4.2.1" class="ltx_text">and twisting by <math id="S6.SS3.p4.m1" class="ltx_Math" alttext="{\mathcal{O}}_{S}(L)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{S}(L)</annotation></semantics></math>, we obtain</span></p>
<table id="S6.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S6.Ex15.m1.pic1" class="ltx_picture ltx_markedasmath" height="22.55" overflow="visible" style="vertical-align:-11.478591397439722px" version="1.1" viewBox="4.15 11.48 408.89 22.55" width="408.89"><g transform="matrix(1 0 0 -1 4.151100041511 22.548191508135723) translate(0,3.46) translate(4.15,0)"><g transform="translate(37.36,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.39em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="88.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex15.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{{\mathcal{O}}_{S}(-3L+4E)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{{\mathcal{O}}_{S}(-3L+4E)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 134.06701019992303 -0.27673578005007266 L 134.06701019992303 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(167.28,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 134.06701019992303 -0.27673578005007266 L 167.27581053201104 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 167.27581053201104 -0.27673578005007266 L 167.27581053201104 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(167.28,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.52em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.28em;font-size:10pt;" height="14.25" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="76.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex15.m1.pic1.m3" class="ltx_math_unparsed" alttext="\textstyle{\varphi^{*}\Omega_{{\mathbb{P}}^{3}}|{{}_{S_{0}}}(L)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>φ</mi><mo>∗</mo></msup><msub><mi mathvariant="normal">Ω</mi><msup><mi>ℙ</mi><mn>3</mn></msup></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><msub><mi>S</mi><mn>0</mn></msub><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\textstyle{\varphi^{*}\Omega_{{\mathbb{P}}^{3}}|{{}_{S_{0}}}(L)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 251.95277873717916 -0.27673578005007266 L 251.95277873717916 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(285.16,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 251.95277873717916 -0.27673578005007266 L 285.16157906926713 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 285.16157906926713 -0.27673578005007266 L 285.16157906926713 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(285.16,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.26em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex15.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\varphi^{*}\Omega_{S_{0}}(L)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><msub><mi>S</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\varphi^{*}\Omega_{S_{0}}(L)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 352.4653169645946 -0.27673578005007266 L 352.4653169645946 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(385.68,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 352.4653169645946 -0.27673578005007266 L 385.6741172966826 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 385.6741172966826 -0.27673578005007266 L 385.6741172966826 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(385.68,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex15.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{0.}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{0.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS3.p4.3" class="ltx_p"><span id="S6.SS3.p4.3.1" class="ltx_text">The left hand map is injective, as <math id="S6.SS3.p4.m2" class="ltx_Math" alttext="{\mathcal{O}}_{S}(-3L+4E)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{S}(-3L+4E)</annotation></semantics></math> is locally free. Thus,</span></p>
<table id="S6.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E5.m1" class="ltx_math_unparsed" alttext="h^{1}(\varphi^{*}\Omega_{S_{0}}(L))\leq h^{1}(\varphi^{*}\Omega_{{\mathbb{P}}^{3}}|{{}_{S_{0}}}(L))+h^{0}(3L-4E)," display="block" intent=":literal"><semantics><mrow><msup><mi>h</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>φ</mi><mo>∗</mo></msup><msub><mi mathvariant="normal">Ω</mi><msub><mi>S</mi><mn>0</mn></msub></msub><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≤</mo><msup><mi>h</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>φ</mi><mo>∗</mo></msup><msub><mi mathvariant="normal">Ω</mi><msup><mi>ℙ</mi><mn>3</mn></msup></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><msub><mi>S</mi><mn>0</mn></msub><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>h</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><mn>3</mn><mi>L</mi><mo>−</mo><mn>4</mn><mi>E</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">h^{1}(\varphi^{*}\Omega_{S_{0}}(L))\leq h^{1}(\varphi^{*}\Omega_{{\mathbb{P}}^{3}}|{{}_{S_{0}}}(L))+h^{0}(3L-4E),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS3.p4.4" class="ltx_p"><span id="S6.SS3.p4.4.1" class="ltx_text">using Serre duality.
Pulling back the dual of the Euler sequence,</span></p>
<table id="S6.Ex16" class="ltx_equation ltx_eqn_table">

