</table>
<p id="S2.p5.4" class="ltx_p"><span id="S2.p5.4.1" class="ltx_text">By (<a href="#S1.E3" title="In 1. Derived categories of sheaves on algebraic stacks ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.3</span></a>), we thus see that we have a quasi-isomorphism,
natural in <math id="S2.p5.m10" class="ltx_Math" alttext="\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(T)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(T)</annotation></semantics></math>:</span></p>
<table id="S2.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex28.m1" class="ltx_Math" alttext="\mathsf{R}\!\Hom_{\mathcal{O}_{T}}(\mathsf{L}{g}_{\mathrm{Q}}^{*}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}\!\Hom_{\mathcal{O}_{T}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mi>Hom</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>T</mi></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup></mrow><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≃</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mi>Hom</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>T</mi></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>g</mi><mi>X</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{R}\!\Hom_{\mathcal{O}_{T}}(\mathsf{L}{g}_{\mathrm{Q}}^{*}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}\!\Hom_{\mathcal{O}_{T}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p5.5" class="ltx_p"><span id="S2.p5.5.1" class="ltx_text">By Lemma <a href="#S1.Thmthm2" title="Lemma 1.2. ‣ 1. Derived categories of sheaves on algebraic stacks ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a> and the above we obtain a sequence of
quasi-isomorphisms:</span></p>
<table id="S2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex29.m1" class="ltx_Math" alttext="\displaystyle\mathsf{L}{g}_{\mathrm{Q}}^{*}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]}" display="inline" intent=":literal"><semantics><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{L}{g}_{\mathrm{Q}}^{*}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex29.m2" class="ltx_Math" alttext="\displaystyle\simeq\underset{n}{\mathrm{holim}}\,\tau^{{\geq-n}}\mathsf{L}{g}_{\mathrm{Q}}^{*}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]}\simeq\underset{n}{\mathrm{holim}}\,\tau^{{\geq-n}}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≃</mo><mrow><munder accentunder="true"><mi>holim</mi><mo mathsize="0.700em">𝑛</mo></munder><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mrow><mphantom></mphantom><mo rspace="0em">≥</mo><mrow><mo lspace="0em">−</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup></mrow><mo>≃</mo><mrow><munder accentunder="true"><mi>holim</mi><mo mathsize="0.700em">𝑛</mo></munder><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mrow><mphantom></mphantom><mo rspace="0em">≥</mo><mrow><mo lspace="0em">−</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>g</mi><mi>X</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\simeq\underset{n}{\mathrm{holim}}\,\tau^{{\geq-n}}\mathsf{L}{g}_{\mathrm{Q}}^{*}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]}\simeq\underset{n}{\mathrm{holim}}\,\tau^{{\geq-n}}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex30.m1" class="ltx_Math" alttext="\displaystyle\simeq\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]}.\qed" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≃</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>g</mi><mi>X</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\displaystyle\simeq\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]}.\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3. </span>Finitely generated and coherent functors</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">Fix a ring <math id="S3.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>. Let <math id="S3.p1.m2" class="ltx_Math" alttext="\mathbf{Fun}_{{A}}^{\times}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐅𝐮𝐧</mi><mi>A</mi><mo>×</mo></msubsup><annotation encoding="application/x-tex">\mathbf{Fun}_{{A}}^{\times}</annotation></semantics></math> denote the category of functors
<math id="S3.p1.m3" class="ltx_Math" alttext="\mathbf{Mod}({A})\to\mathbf{Sets}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐒𝐞𝐭𝐬</mi></mrow><annotation encoding="application/x-tex">\mathbf{Mod}({A})\to\mathbf{Sets}</annotation></semantics></math> which commute with finite products. This is a full
subcategory of the category of all functors <math id="S3.p1.m4" class="ltx_Math" alttext="\mathbf{Mod}({A})\to\mathbf{Sets}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐒𝐞𝐭𝐬</mi></mrow><annotation encoding="application/x-tex">\mathbf{Mod}({A})\to\mathbf{Sets}</annotation></semantics></math>. Denote by
<math id="S3.p1.m5" class="ltx_Math" alttext="\mathbf{Lin}_{{A}}" display="inline" intent=":literal"><semantics><msub><mi>𝐋𝐢𝐧</mi><mi>A</mi></msub><annotation encoding="application/x-tex">\mathbf{Lin}_{{A}}</annotation></semantics></math> the category of <math id="S3.p1.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-linear functors <math id="S3.p1.m7" class="ltx_Math" alttext="\mathbf{Mod}({A})\to\mathbf{Mod}({A})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Mod}({A})\to\mathbf{Mod}({A})</annotation></semantics></math>. The following is straightforward.</p>
</div>
<div id="S3.Thmthm1" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm1.2" class="ltx_text ltx_font_bold">Lemma 3.1</span></span><span id="S3.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm1.p1" class="ltx_para">
<p id="S3.Thmthm1.p1.1" class="ltx_p"><span id="S3.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">Fix a ring <math id="S3.Thmthm1.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, then the forgetful functor:</span></p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="\mathbf{Lin}_{{A}}\to\mathbf{Fun}_{{A}}^{\times}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐋𝐢𝐧</mi><mi>A</mi></msub><mo stretchy="false">→</mo><msubsup><mi>𝐅𝐮𝐧</mi><mi>A</mi><mo>×</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{Lin}_{{A}}\to\mathbf{Fun}_{{A}}^{\times}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm1.p1.2" class="ltx_p"><span id="S3.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">is an equivalence of categories.</span></p>
</div>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">In particular, for a ring <math id="S3.p2.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, set <math id="S3.p2.m2" class="ltx_Math" alttext="T=\spec A" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">T=\spec A</annotation></semantics></math> and note that Lemma
<a href="#S3.Thmthm1" title="Lemma 3.1. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> shows that the category of additive functors
<math id="S3.p2.m3" class="ltx_Math" alttext="\mathbf{QCoh}({T})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐐𝐂𝐨𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow><annotation encoding="application/x-tex">\mathbf{QCoh}({T})\to\mathbf{Ab}</annotation></semantics></math> is equivalent to the
category of <math id="S3.p2.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-linear functors <math id="S3.p2.m5" class="ltx_Math" alttext="\mathbf{Mod}({A})\to\mathbf{Mod}({A})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Mod}({A})\to\mathbf{Mod}({A})</annotation></semantics></math>. We will use
this equivalence without further mention to translate definitions
between the two categories.</p>
</div>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p">A functor <math id="S3.p3.m1" class="ltx_Math" alttext="Q:\mathbf{Mod}({A})\to\mathbf{Sets}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐒𝐞𝐭𝐬</mi></mrow></mrow><annotation encoding="application/x-tex">Q:\mathbf{Mod}({A})\to\mathbf{Sets}</annotation></semantics></math> is <em id="S3.p3.1.1" class="ltx_emph ltx_font_italic">finitely generated</em> if
there exists an <math id="S3.p3.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module <math id="S3.p3.m3" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> and an object <math id="S3.p3.m4" class="ltx_Math" alttext="\eta\in Q(I)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta\in Q(I)</annotation></semantics></math> such
that for all <math id="S3.p3.m5" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-modules <math id="S3.p3.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, the induced morphism of sets
<math id="S3.p3.m7" class="ltx_Math" alttext="\Hom_{A}(I,M)\to Q(M):f\mapsto f_{*}\eta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Hom</mi><mi>A</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>f</mi><mo stretchy="false">↦</mo><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\Hom_{A}(I,M)\to Q(M):f\mapsto f_{*}\eta</annotation></semantics></math> is surjective. We
call the pair <math id="S3.p3.m8" class="ltx_Math" alttext="(I,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(I,\eta)</annotation></semantics></math> a <em id="S3.p3.1.2" class="ltx_emph ltx_font_italic">generator</em> for the functor <math id="S3.p3.m9" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>. The
notion of finite
generation of a functor is due to M. Auslander <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">Aus66</a>]</cite>.</p>
</div>
<div id="S3.Thmthm2" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm2.2" class="ltx_text ltx_font_bold">Example 3.2</span></span><span id="S3.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm2.p1" class="ltx_para">
<p id="S3.Thmthm2.p1.1" class="ltx_p">Fix a ring <math id="S3.Thmthm2.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>. For any <math id="S3.Thmthm2.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module <math id="S3.Thmthm2.p1.m3" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>, the functor <math id="S3.Thmthm2.p1.m4" class="ltx_Math" alttext="M\mapsto\Hom_{A}(I,M)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msub><mi>Hom</mi><mi>A</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto\Hom_{A}(I,M)</annotation></semantics></math> is finitely generated. The functor <math id="S3.Thmthm2.p1.m5" class="ltx_Math" alttext="M\mapsto I\otimes_{A}M" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><mi>I</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>A</mi></msub><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">M\mapsto I\otimes_{A}M</annotation></semantics></math> is finitely generated if and only if the <math id="S3.Thmthm2.p1.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module <math id="S3.Thmthm2.p1.m7" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> is
finitely generated as an <math id="S3.Thmthm2.p1.m8" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module. A generator is obtained by
choosing a surjection <math id="S3.Thmthm2.p1.m9" class="ltx_Math" alttext="A^{n}\to I" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mi>n</mi></msup><mo stretchy="false">→</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">A^{n}\to I</annotation></semantics></math>, and noting that for any
<math id="S3.Thmthm2.p1.m10" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module <math id="S3.Thmthm2.p1.m11" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, there is a surjection <math id="S3.Thmthm2.p1.m12" class="ltx_Math" alttext="A^{n}\otimes_{A}M\to I\otimes_{A}M" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mi>n</mi></msup><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>A</mi></msub><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><mi>I</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>A</mi></msub><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">A^{n}\otimes_{A}M\to I\otimes_{A}M</annotation></semantics></math>, and an isomorphism <math id="S3.Thmthm2.p1.m13" class="ltx_Math" alttext="A^{n}\otimes_{A}M\to\Hom_{A}(A^{n},M)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mi>n</mi></msup><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>A</mi></msub><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><msub><mi>Hom</mi><mi>A</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mi>n</mi></msup><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{n}\otimes_{A}M\to\Hom_{A}(A^{n},M)</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.Thmthm3" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm3.2" class="ltx_text ltx_font_bold">Example 3.3</span></span><span id="S3.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm3.p1" class="ltx_para">
<p id="S3.Thmthm3.p1.1" class="ltx_p">Fix a ring <math id="S3.Thmthm3.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and a collection of finitely generated functors
<math id="S3.Thmthm3.p1.m2" class="ltx_Math" alttext="\{F_{\lambda}:\mathbf{Mod}({A})\to\mathbf{Ab}\}_{\lambda\in\Lambda}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>F</mi><mi>λ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow></msub><annotation encoding="application/x-tex">\{F_{\lambda}:\mathbf{Mod}({A})\to\mathbf{Ab}\}_{\lambda\in\Lambda}</annotation></semantics></math> indexed by a
set <math id="S3.Thmthm3.p1.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>. Then, the functor <math id="S3.Thmthm3.p1.m4" class="ltx_Math" alttext="M\mapsto\Pi_{\lambda\in\Lambda}F_{\lambda}(M)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msub><mi mathvariant="normal">Π</mi><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto\Pi_{\lambda\in\Lambda}F_{\lambda}(M)</annotation></semantics></math> is finitely generated. Indeed, for each
<math id="S3.Thmthm3.p1.m5" class="ltx_Math" alttext="\lambda\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\Lambda</annotation></semantics></math>, let <math id="S3.Thmthm3.p1.m6" class="ltx_Math" alttext="(I_{\lambda},\eta_{\lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>λ</mi></msub><mo>,</mo><msub><mi>η</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(I_{\lambda},\eta_{\lambda})</annotation></semantics></math> be a generator
for <math id="S3.Thmthm3.p1.m7" class="ltx_Math" alttext="F_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">F_{\lambda}</annotation></semantics></math>. Then, <math id="S3.Thmthm3.p1.m8" class="ltx_Math" alttext="(\Pi_{\lambda\in\Lambda}I_{\lambda},(\eta_{\lambda})_{\lambda\in\Lambda})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Π</mi><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>λ</mi></msub></mrow><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>λ</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Pi_{\lambda\in\Lambda}I_{\lambda},(\eta_{\lambda})_{\lambda\in\Lambda})</annotation></semantics></math> is a generator for the functor
<math id="S3.Thmthm3.p1.m9" class="ltx_Math" alttext="M\mapsto\Pi_{\lambda\in\Lambda}F_{\lambda}(M)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msub><mi mathvariant="normal">Π</mi><mrow><mi>λ</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto\Pi_{\lambda\in\Lambda}F_{\lambda}(M)</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p">For an <math id="S3.p4.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-algebra <math id="S3.p4.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, and a functor <math id="S3.p4.m3" class="ltx_Math" alttext="Q:\mathbf{Mod}({A})\to\mathbf{Sets}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐒𝐞𝐭𝐬</mi></mrow></mrow><annotation encoding="application/x-tex">Q:\mathbf{Mod}({A})\to\mathbf{Sets}</annotation></semantics></math>, there is an induced functor <math id="S3.p4.m4" class="ltx_Math" alttext="Q_{B}:\mathbf{Mod}({B})\to\mathbf{Sets}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>B</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐒𝐞𝐭𝐬</mi></mrow></mrow><annotation encoding="application/x-tex">Q_{B}:\mathbf{Mod}({B})\to\mathbf{Sets}</annotation></semantics></math>
given by regarding a <math id="S3.p4.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>-module as an <math id="S3.p4.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module. Note that since the
forgetful functor <math id="S3.p4.m7" class="ltx_Math" alttext="\mathbf{Mod}({B})\to\mathbf{Mod}({A})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Mod}({B})\to\mathbf{Mod}({A})</annotation></semantics></math> commutes with all limits and
colimits, it follows that if the functor <math id="S3.p4.m8" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> preserves certain limits
or colimits, so does
the functor <math id="S3.p4.m9" class="ltx_Math" alttext="Q_{B}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>B</mi></msub><annotation encoding="application/x-tex">Q_{B}</annotation></semantics></math>. In particular, from Lemma <a href="#S3.Thmthm1" title="Lemma 3.1. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> we see
that if the functor <math id="S3.p4.m10" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> commutes with finite products, then the
functor <math id="S3.p4.m11" class="ltx_Math" alttext="Q_{B}:\mathbf{Mod}({B})\to\mathbf{Sets}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>B</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐒𝐞𝐭𝐬</mi></mrow></mrow><annotation encoding="application/x-tex">Q_{B}:\mathbf{Mod}({B})\to\mathbf{Sets}</annotation></semantics></math> is canonically <math id="S3.p4.m12" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>-linear and thus
defines a functor <math id="S3.p4.m13" class="ltx_Math" alttext="Q_{B}:\mathbf{Mod}({B})\to\mathbf{Mod}({B})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>B</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Q_{B}:\mathbf{Mod}({B})\to\mathbf{Mod}({B})</annotation></semantics></math>. We will use this
fact frequently and without further comment.</p>
</div>
<div id="S3.Thmthm4" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm4.2" class="ltx_text ltx_font_bold">Example 3.4</span></span><span id="S3.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm4.p1" class="ltx_para">
<p id="S3.Thmthm4.p1.1" class="ltx_p">For an <math id="S3.Thmthm4.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-algebra <math id="S3.Thmthm4.p1.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, if <math id="S3.Thmthm4.p1.m3" class="ltx_Math" alttext="(I,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(I,\eta)</annotation></semantics></math> generates <math id="S3.Thmthm4.p1.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, let <math id="S3.Thmthm4.p1.m5" class="ltx_Math" alttext="p:I\to I\otimes_{A}B" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>I</mi><mo stretchy="false">→</mo><mrow><mi>I</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>A</mi></msub><mi>B</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">p:I\to I\otimes_{A}B</annotation></semantics></math> be the natural <math id="S3.Thmthm4.p1.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module homomorphism, then
<math id="S3.Thmthm4.p1.m7" class="ltx_Math" alttext="(I\otimes_{A}B,p_{*}\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>I</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>A</mi></msub><mi>B</mi></mrow><mo>,</mo><mrow><msub><mi>p</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(I\otimes_{A}B,p_{*}\eta)</annotation></semantics></math> generates <math id="S3.Thmthm4.p1.m8" class="ltx_Math" alttext="Q_{B}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>B</mi></msub><annotation encoding="application/x-tex">Q_{B}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.p5" class="ltx_para">
<p id="S3.p5.1" class="ltx_p">An additive functor <math id="S3.p5.m1" class="ltx_Math" alttext="F:\mathbf{Mod}({A})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow></mrow><annotation encoding="application/x-tex">F:\mathbf{Mod}({A})\to\mathbf{Ab}</annotation></semantics></math> is
<em id="S3.p5.1.1" class="ltx_emph ltx_font_italic">coherent</em>, if
there exists an <math id="S3.p5.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module homomorphism <math id="S3.p5.m3" class="ltx_Math" alttext="f:I\to J" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>I</mi><mo stretchy="false">→</mo><mi>J</mi></mrow></mrow><annotation encoding="application/x-tex">f:I\to J</annotation></semantics></math> and an element
<math id="S3.p5.m4" class="ltx_Math" alttext="\eta\in F(I)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta\in F(I)</annotation></semantics></math>, inducing an exact sequence for any <math id="S3.p5.m5" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module <math id="S3.p5.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>:</p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex2.m1.pic1" class="ltx_picture ltx_markedasmath" height="22.14" overflow="visible" style="vertical-align:-11.069600110696001px" version="1.1" viewBox="44.05 11.07 339.43 22.14" width="339.43"><g transform="matrix(1 0 0 -1 44.054195266286584 22.139200221392002) translate(0,3.46) translate(44.05,0)"><g transform="translate(-44.05,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.77em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="79.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex2.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{\Hom_{A}(J,M)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Hom</mi><mi>A</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>J</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\Hom_{A}(J,M)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 44.05421637987322 -0.27673578005007266 L 44.05421637987322 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(77.26,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 44.05421637987322 -0.27673578005007266 L 77.26299559837459 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 77.26299559837459 -0.27673578005007266 L 77.26299559837459 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(77.26,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.75em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="79.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex2.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{\Hom_{A}(I,M)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Hom</mi><mi>A</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\Hom_{A}(I,M)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 165.07351565067412 -0.27673578005007266 L 165.07351565067412 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(198.28,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 165.07351565067412 -0.27673578005007266 L 198.28231598276213 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 198.28231598276213 -0.27673578005007266 L 198.28231598276213 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(198.28,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.64em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="36.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex2.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{F(M)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{F(M)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 243.09885952174787 -0.27673578005007266 L 243.09885952174787 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(276.31,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 243.09885952174787 -0.27673578005007266 L 276.3076598538359 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 276.3076598538359 -0.27673578005007266 L 276.3076598538359 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(276.31,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex2.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{0.}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{0.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p5.2" class="ltx_p">We refer to the data <math id="S3.p5.m7" class="ltx_math_unparsed" alttext="(f:I\to J,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>I</mi><mo stretchy="false">→</mo><mi>J</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f:I\to J,\eta)</annotation></semantics></math> as a <em id="S3.p5.2.1" class="ltx_emph ltx_font_italic">presentation</em>
for <math id="S3.p5.m8" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. For accounts of coherent functors, we refer the
interested reader to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">Aus66</a>, <a href="#bib.bibx13" title="" class="ltx_ref">Har98</a>]</cite>. We now have a number
of examples.</p>
</div>
<div id="S3.Thmthm5" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm5.2" class="ltx_text ltx_font_bold">Example 3.5</span></span><span id="S3.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm5.p1" class="ltx_para">
<p id="S3.Thmthm5.p1.1" class="ltx_p">Given an exact sequence of additive functors <math id="S3.Thmthm5.p1.m1" class="ltx_Math" alttext="H_{i}:\mathbf{Mod}({A})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow></mrow><annotation encoding="application/x-tex">H_{i}:\mathbf{Mod}({A})\to\mathbf{Ab}</annotation></semantics></math>:</p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex3.m1.pic1" class="ltx_picture ltx_markedasmath" height="20.45" overflow="visible" style="vertical-align:-10.300875534832485px" version="1.1" viewBox="13.57 10.30 272.36 20.45" width="272.36"><g transform="matrix(1 0 0 -1 13.56792859026913 20.447980818188306) translate(0,3.46) translate(13.57,0)"><g transform="translate(-13.57,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.36em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="18.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{H_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\textstyle{H_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 13.567949703855767 -0.27673578005007266 L 13.567949703855767 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(46.78,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 13.567949703855767 -0.27673578005007266 L 46.77672892235713 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 46.77672892235713 -0.27673578005007266 L 46.77672892235713 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(46.78,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.36em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="18.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{H_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{H_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 73.91260721648203 -0.27673578005007266 L 73.91260721648203 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(107.12,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 73.91260721648203 -0.27673578005007266 L 107.12138643498339 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 107.12138643498339 -0.27673578005007266 L 107.12138643498339 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(107.12,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.36em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="18.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{H_{3}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\textstyle{H_{3}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 134.2572647291083 -0.27673578005007266 L 134.2572647291083 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(167.47,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 134.2572647291083 -0.27673578005007266 L 167.46604394760965 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 167.46604394760965 -0.27673578005007266 L 167.46604394760965 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(167.47,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.36em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="18.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{H_{4}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\textstyle{H_{4}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 194.60192224173454 -0.27673578005007266 L 194.60192224173454 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(227.81,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 194.60192224173454 -0.27673578005007266 L 227.81070146023592 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 227.81070146023592 -0.27673578005007266 L 227.81070146023592 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(227.81,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.64em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="22.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{H_{5},}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>5</mn></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\textstyle{H_{5},}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm5.p1.2" class="ltx_p">where for <math id="S3.Thmthm5.p1.m2" class="ltx_Math" alttext="i\neq 3" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">i\neq 3</annotation></semantics></math>, we have that <math id="S3.Thmthm5.p1.m3" class="ltx_Math" alttext="H_{i}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>i</mi></msub><annotation encoding="application/x-tex">H_{i}</annotation></semantics></math> is coherent. Then, <math id="S3.Thmthm5.p1.m4" class="ltx_Math" alttext="H_{3}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>3</mn></msub><annotation encoding="application/x-tex">H_{3}</annotation></semantics></math> is
coherent. In particular, the category of coherent functors is stable
under kernels, cokernels, subquotients, and extensions. This follows from
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">Aus66</a>, Prop. 2.1]</cite>.</p>
</div>
</div>
<div id="S3.Thmthm6" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm6.2" class="ltx_text ltx_font_bold">Example 3.6</span></span><span id="S3.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm6.p1" class="ltx_para">
<p id="S3.Thmthm6.p1.1" class="ltx_p">Fix a ring <math id="S3.Thmthm6.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and an <math id="S3.Thmthm6.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-algebra <math id="S3.Thmthm6.p1.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>. If <math id="S3.Thmthm6.p1.m4" class="ltx_Math" alttext="F:\mathbf{Mod}({A})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow></mrow><annotation encoding="application/x-tex">F:\mathbf{Mod}({A})\to\mathbf{Ab}</annotation></semantics></math> is a
coherent functor, then analogously to Example <a href="#S3.Thmthm4" title="Example 3.4. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>, the
restriction <math id="S3.Thmthm6.p1.m5" class="ltx_Math" alttext="F_{B}:\mathbf{Mod}({B})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>B</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow></mrow><annotation encoding="application/x-tex">F_{B}:\mathbf{Mod}({B})\to\mathbf{Ab}</annotation></semantics></math> is also coherent.</p>
</div>
</div>
<div id="S3.p6" class="ltx_para">
<p id="S3.p6.1" class="ltx_p">Fix a ring <math id="S3.p6.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>. A functor <math id="S3.p6.m2" class="ltx_Math" alttext="F:\mathbf{Mod}({A})\to\mathbf{Mod}({A})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F:\mathbf{Mod}({A})\to\mathbf{Mod}({A})</annotation></semantics></math> is
<em id="S3.p6.1.1" class="ltx_emph ltx_font_italic">half-exact</em> if for any short exact sequence of <math id="S3.p6.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-modules <math id="S3.p6.m4" class="ltx_Math" alttext="0\to M^{\prime}\to M\to M^{\prime\prime}\to 0" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">→</mo><msup><mi>M</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mi>M</mi><mo stretchy="false">→</mo><msup><mi>M</mi><mo>′′</mo></msup><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\to M^{\prime}\to M\to M^{\prime\prime}\to 0</annotation></semantics></math>, the sequence <math id="S3.p6.m5" class="ltx_Math" alttext="F(M^{\prime})\to F(M)\to F(M^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(M^{\prime})\to F(M)\to F(M^{\prime\prime})</annotation></semantics></math>
is exact.</p>
</div>
<div id="S3.Thmthm7" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm7.2" class="ltx_text ltx_font_bold">Example 3.7</span></span><span id="S3.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm7.p1" class="ltx_para">
<p id="S3.Thmthm7.p1.1" class="ltx_p">Fix a ring <math id="S3.Thmthm7.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and let <math id="S3.Thmthm7.p1.m2" class="ltx_Math" alttext="Q^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">Q^{\bullet}</annotation></semantics></math> be a complex of <math id="S3.Thmthm7.p1.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-modules. Then
the functor <math id="S3.Thmthm7.p1.m4" class="ltx_Math" alttext="M\mapsto H^{i}(\Hom_{A}(Q^{\bullet},M))" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Hom</mi><mi>A</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>Q</mi><mo>∙</mo></msup><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto H^{i}(\Hom_{A}(Q^{\bullet},M))</annotation></semantics></math> is coherent for all
<math id="S3.Thmthm7.p1.m5" class="ltx_Math" alttext="i\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">i\in\mathbb{Z}</annotation></semantics></math>. If the complex <math id="S3.Thmthm7.p1.m6" class="ltx_Math" alttext="Q^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">Q^{\bullet}</annotation></semantics></math> is term-by-term projective,
the functor <math id="S3.Thmthm7.p1.m7" class="ltx_Math" alttext="M\mapsto H^{i}(\Hom_{A}(Q^{\bullet},M))" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Hom</mi><mi>A</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>Q</mi><mo>∙</mo></msup><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto H^{i}(\Hom_{A}(Q^{\bullet},M))</annotation></semantics></math> is also
half-exact.</p>
</div>
</div>
<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p">An <math id="S3.p7.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-linear functor of the form <math id="S3.p7.m2" class="ltx_Math" alttext="M\mapsto\Ext^{i}_{A}(Q^{\bullet},M)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msubsup><mi>Ext</mi><mi>A</mi><mi>i</mi></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>Q</mi><mo>∙</mo></msup><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto\Ext^{i}_{A}(Q^{\bullet},M)</annotation></semantics></math> is
said to be <em id="S3.p7.1.1" class="ltx_emph ltx_font_italic">corepresentable by a complex</em>. By Example
<a href="#S3.Thmthm7" title="Example 3.7. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a>, such functors are coherent and half-exact, and were
intially studied by M. Auslander <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">Aus66</a>]</cite>, with stronger
results—in the noetherian setting—obtained R. Hartshorne
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">Har98</a>]</cite>. In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx14" title="" class="ltx_ref">HR12a</a>]</cite>, it is shown that étale
locally any half-exact, coherent functor is corepresentable by a
complex.</p>
</div>
<div id="S3.Thmthm8" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm8.2" class="ltx_text ltx_font_bold">Example 3.8</span></span><span id="S3.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm8.p1" class="ltx_para">
<p id="S3.Thmthm8.p1.1" class="ltx_p">Fix a ring <math id="S3.Thmthm8.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and a coherent functor <math id="S3.Thmthm8.p1.m2" class="ltx_Math" alttext="F:\mathbf{Mod}({A})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow></mrow><annotation encoding="application/x-tex">F:\mathbf{Mod}({A})\to\mathbf{Ab}</annotation></semantics></math>. Then,
<math id="S3.Thmthm8.p1.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> preserves small products. It was shown by H. Krause
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx17" title="" class="ltx_ref">Kra03</a>, Prop. 3.2]</cite> that the preservation of small products
characterizes coherent functors.</p>
</div>
</div>
<div id="S3.Thmthm9" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm9.2" class="ltx_text ltx_font_bold">Example 3.9</span></span><span id="S3.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm9.p1" class="ltx_para">
<p id="S3.Thmthm9.p1.1" class="ltx_p">Fix a ring <math id="S3.Thmthm9.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>. Example <a href="#S3.Thmthm3" title="Example 3.3. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> extends to show that the
category of coherent functors <math id="S3.Thmthm9.p1.m2" class="ltx_Math" alttext="\mathbf{Mod}({A})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow><annotation encoding="application/x-tex">\mathbf{Mod}({A})\to\mathbf{Ab}</annotation></semantics></math> is closed under
small products. By Example <a href="#S3.Thmthm5" title="Example 3.5. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>, the category of
coherent functors <math id="S3.Thmthm9.p1.m3" class="ltx_Math" alttext="\mathbf{Mod}({A})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow><annotation encoding="application/x-tex">\mathbf{Mod}({A})\to\mathbf{Ab}</annotation></semantics></math> is also closed under
equalizers. Thus, the category of coherent functors <math id="S3.Thmthm9.p1.m4" class="ltx_Math" alttext="\mathbf{Mod}({A})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow><annotation encoding="application/x-tex">\mathbf{Mod}({A})\to\mathbf{Ab}</annotation></semantics></math> is closed under small limits.</p>
</div>
</div>
<div id="S3.Thmthm10" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm10.2" class="ltx_text ltx_font_bold">Example 3.10</span></span><span id="S3.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm10.p1" class="ltx_para">
<p id="S3.Thmthm10.p1.1" class="ltx_p">Fix a ring <math id="S3.Thmthm10.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and a coherent functor <math id="S3.Thmthm10.p1.m2" class="ltx_Math" alttext="F:\mathbf{Mod}({A})\to\mathbf{Ab}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow></mrow><annotation encoding="application/x-tex">F:\mathbf{Mod}({A})\to\mathbf{Ab}</annotation></semantics></math> which is left exact. By Example <a href="#S3.Thmthm8" title="Example 3.8. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a>, <math id="S3.Thmthm10.p1.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> also
preserves small products, thus <math id="S3.Thmthm10.p1.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> preserves small
limits. The Eilenberg-Watts Theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx34" title="" class="ltx_ref">Wat60</a>, Thm. 6]</cite> now implies that <math id="S3.Thmthm10.p1.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is corepresentable. That is, there
exists an <math id="S3.Thmthm10.p1.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module <math id="S3.Thmthm10.p1.m7" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> such that <math id="S3.Thmthm10.p1.m8" class="ltx_Math" alttext="F(-)\cong\Hom_{A}(Q,-)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msub><mi>Hom</mi><mi>A</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">−</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(-)\cong\Hom_{A}(Q,-)</annotation></semantics></math>. If, in
addition, the functor <math id="S3.Thmthm10.p1.m9" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> preserves direct limits, then <math id="S3.Thmthm10.p1.m10" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is
finitely presented. By Example <a href="#S3.Thmthm7" title="Example 3.7. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a>, this observation
generalizes <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx6" title="" class="ltx_ref">EGA</a>, III.7.4.6]</cite>.</p>
</div>
</div>
<div id="S3.Thmthm11" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm11.2" class="ltx_text ltx_font_bold">Example 3.11</span></span><span id="S3.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm11.p1" class="ltx_para">
<p id="S3.Thmthm11.p1.1" class="ltx_p">Fix a ring <math id="S3.Thmthm11.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and an <math id="S3.Thmthm11.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module <math id="S3.Thmthm11.p1.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>. Then the functor <math id="S3.Thmthm11.p1.m4" class="ltx_Math" alttext="M\mapsto M\otimes_{A}N" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><mi>M</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>A</mi></msub><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">M\mapsto M\otimes_{A}N</annotation></semantics></math> is coherent if and only if the <math id="S3.Thmthm11.p1.m5" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module <math id="S3.Thmthm11.p1.m6" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is
finitely presented.</p>
</div>
</div>
<div id="S3.Thmthm12" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm12.2" class="ltx_text ltx_font_bold">Example 3.12</span></span><span id="S3.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm12.p1" class="ltx_para">
<p id="S3.Thmthm12.p1.1" class="ltx_p">Fix a noetherian ring <math id="S3.Thmthm12.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. Let <math id="S3.Thmthm12.p1.m2" class="ltx_Math" alttext="Q^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">Q^{\bullet}</annotation></semantics></math> be a complex of finitely
generated <math id="S3.Thmthm12.p1.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-modules, then the functor <math id="S3.Thmthm12.p1.m4" class="ltx_Math" alttext="M\mapsto H^{i}(Q^{\bullet}\otimes_{R}M)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>Q</mi><mo>∙</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>R</mi></msub><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto H^{i}(Q^{\bullet}\otimes_{R}M)</annotation></semantics></math> is coherent and commutes with filtered
colimits. If the complex
<math id="S3.Thmthm12.p1.m5" class="ltx_Math" alttext="Q^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">Q^{\bullet}</annotation></semantics></math> is, in addition, flat term-by-term, then the
functor <math id="S3.Thmthm12.p1.m6" class="ltx_Math" alttext="M\mapsto H^{i}(Q^{\bullet}\otimes_{R}M)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msup><mi>H</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>Q</mi><mo>∙</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>R</mi></msub><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto H^{i}(Q^{\bullet}\otimes_{R}M)</annotation></semantics></math> is also half-exact.</p>
</div>
</div>
<div id="S3.Thmthm13" class="ltx_theorem ltx_theorem_ex">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm13.2" class="ltx_text ltx_font_bold">Example 3.13</span></span><span id="S3.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm13.p1" class="ltx_para">
<p id="S3.Thmthm13.p1.1" class="ltx_p">Fix a noetherian ring <math id="S3.Thmthm13.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. Let <math id="S3.Thmthm13.p1.m2" class="ltx_Math" alttext="Q^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">Q^{\bullet}</annotation></semantics></math> be a bounded above
complex of <math id="S3.Thmthm13.p1.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-modules with coherent cohomology. Then, the functors
<math id="S3.Thmthm13.p1.m4" class="ltx_Math" alttext="M\mapsto\Tor_{i}^{R}(Q^{\bullet},M)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msubsup><mi>Tor</mi><mi>i</mi><mi>R</mi></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>Q</mi><mo>∙</mo></msup><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto\Tor_{i}^{R}(Q^{\bullet},M)</annotation></semantics></math> and <math id="S3.Thmthm13.p1.m5" class="ltx_Math" alttext="M\mapsto\Ext^{i}_{R}(Q^{\bullet},M)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">↦</mo><mrow><msubsup><mi>Ext</mi><mi>R</mi><mi>i</mi></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>Q</mi><mo>∙</mo></msup><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\mapsto\Ext^{i}_{R}(Q^{\bullet},M)</annotation></semantics></math> are coherent, half-exact and preserve
filtered colimits.</p>
</div>
</div>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Coherence of <math id="S4.m1" class="ltx_Math" alttext="\Hom" display="inline" intent=":literal"><semantics><mi>Hom</mi><annotation encoding="application/x-tex">\Hom</annotation></semantics></math>-functors: flat case</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">Proof of Theorem
<a href="#Thmmainthm3" title="Theorem C. ‣ Introduction ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a> The proof of Theorem <a href="#Thmmainthm3" title="Theorem C. ‣ Introduction ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a> will be via an
induction argument that permits us to reduce to the case of Theorem
<a href="#Thmmainthm2" title="Theorem B. ‣ Introduction ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>. The following notation will be
useful.</p>
</div>
<div id="S4.Thmthm1" class="ltx_theorem ltx_theorem_notn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm1.2" class="ltx_text ltx_font_bold">Notation 4.1</span></span><span id="S4.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm1.p1" class="ltx_para">
<p id="S4.Thmthm1.p1.1" class="ltx_p">For a morphism of algebraic stacks <math id="S4.Thmthm1.p1.m1" class="ltx_Math" alttext="f:X\to S" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">f:X\to S</annotation></semantics></math>, and <math id="S4.Thmthm1.p1.m2" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }</annotation></semantics></math>,
<math id="S4.Thmthm1.p1.m3" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math>, set:</p>
<table id="S4.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex1.m1" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}:=\Hom_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}(-)):\mathbf{QCoh}({S})\to\mathbf{Ab}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ℍ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow></msub><mo>:=</mo><mrow><msub><mi>Hom</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mi>𝐐𝐂𝐨𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐀𝐛</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}:=\Hom_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}(-)):\mathbf{QCoh}({S})\to\mathbf{Ab}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm1.p1.2" class="ltx_p">For <math id="S4.Thmthm1.p1.m4" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math> we set
<math id="S4.Thmthm1.p1.m5" class="ltx_Math" alttext="\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\subset\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup><mo>⊂</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\subset\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math> to
be the full subcategory having objects those <math id="S4.Thmthm1.p1.m6" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }</annotation></semantics></math> with
the property that <math id="S4.Thmthm1.p1.m7" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}" display="inline" intent=":literal"><semantics><msub><mi>ℍ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}</annotation></semantics></math> is coherent
for all <math id="S4.Thmthm1.p1.m8" class="ltx_Math" alttext="n\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">n\in\mathbb{Z}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">We begin with two general reductions.</p>
</div>
<div id="S4.Thmthm2" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm2.2" class="ltx_text ltx_font_bold">Lemma 4.2</span></span><span id="S4.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm2.p1" class="ltx_para">
<p id="S4.Thmthm2.p1.1" class="ltx_p"><span id="S4.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">Fix an affine scheme <math id="S4.Thmthm2.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and a morphism of algebraic stacks <math id="S4.Thmthm2.p1.m2" class="ltx_Math" alttext="f:X\to S" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">f:X\to S</annotation></semantics></math> and <math id="S4.Thmthm2.p1.m3" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math>, then the subcategory
<math id="S4.Thmthm2.p1.m4" class="ltx_Math" alttext="\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\subset\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup><mo>⊂</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\subset\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math> is triangulated and closed
under small direct sums. In particular, if</span></p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="\mathsf{D}^{-}_{\mathrm{QCoh}}(X)\subset\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathsf{D}^{-}_{\mathrm{QCoh}}(X)\subset\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">, or</span></p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }</annotation></semantics></math><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_italic"> has finite tor-dimension over </span><math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S4.I1.i2.p1.m3" class="ltx_Math" alttext="\mathcal{{M}}\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{{M}}\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math><span id="S4.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> for
all </span><math id="S4.I1.i2.p1.m4" class="ltx_Math" alttext="\mathcal{{M}}\in\mathbf{QCoh}({X})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mrow><mi>𝐐𝐂𝐨𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{M}}\in\mathbf{QCoh}({X})</annotation></semantics></math><span id="S4.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">,</span></p>
</div></li>
</ol>
<p id="S4.Thmthm2.p1.2" class="ltx_p"><span id="S4.Thmthm2.p1.2.1" class="ltx_text ltx_font_italic">then <math id="S4.Thmthm2.p1.m5" class="ltx_Math" alttext="\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}=\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup><mo>=</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}=\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p"><span id="S4.p3.1.1" class="ltx_text">Certainly, <math id="S4.p3.m1" class="ltx_Math" alttext="\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math> is closed under
shifts. Next, given a triangle <math id="S4.p3.m2" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{1}\to\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{2}\to\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{3}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn><mtext>    </mtext></msubsup><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn><mtext>    </mtext></msubsup><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>3</mn><mtext>    </mtext></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{1}\to\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{2}\to\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{3}</annotation></semantics></math> in <math id="S4.p3.m3" class="ltx_Math" alttext="\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math> with
<math id="S4.p3.m4" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{1}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn><mtext>    </mtext></msubsup><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{1}</annotation></semantics></math>, <math id="S4.p3.m5" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{2}\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn><mtext>    </mtext></msubsup><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{2}\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math>, we
obtain an exact sequence of functors:</span></p>
<table id="S4.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex2.m1" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{2}[1]},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\to\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{1}[1]},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\to\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{3}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\to\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{2}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\to\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{1}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ℍ</mi><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn><mtext>    </mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow></msub><mo stretchy="false">→</mo><msub><mi>ℍ</mi><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn><mtext>    </mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow></msub><mo stretchy="false">→</mo><msub><mi>ℍ</mi><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>3</mn><mtext>    </mtext></msubsup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow></msub><mo stretchy="false">→</mo><msub><mi>ℍ</mi><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn><mtext>    </mtext></msubsup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow></msub><mo stretchy="false">→</mo><msub><mi>ℍ</mi><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn><mtext>    </mtext></msubsup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{2}[1]},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\to\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{1}[1]},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\to\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{3}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\to\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{2}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\to\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{1}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p3.2" class="ltx_p"><span id="S4.p3.2.1" class="ltx_text">By Example <a href="#S3.Thmthm5" title="Example 3.5. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>,
<math id="S4.p3.m6" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{3}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℍ</mi><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>3</mn><mtext>    </mtext></msubsup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow></msub><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{3}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math> and so <math id="S4.p3.m7" class="ltx_Math" alttext="\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math> is
a triangulated subcategory of <math id="S4.p3.m8" class="ltx_Math" alttext="\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math>. Let
<math id="S4.p3.m9" class="ltx_Math" alttext="\{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{i}\}_{i\in I}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi><mtext>    </mtext></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow></msub><annotation encoding="application/x-tex">\{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{i}\}_{i\in I}</annotation></semantics></math> be a set of elements from <math id="S4.p3.m10" class="ltx_Math" alttext="\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math>. Set <math id="S4.p3.m11" class="ltx_math_unparsed" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }=\oplus_{i\in I}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{i}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><msup><mrow></mrow><mtext>    </mtext></msup><mo rspace="0em">=</mo><mo lspace="0em">⊕</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow></msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><msup><mrow></mrow><mtext>    </mtext></msup><msub><mrow></mrow><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }=\oplus_{i\in I}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{i}</annotation></semantics></math>, then for all <math id="S4.p3.m12" class="ltx_Math" alttext="n\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">n\in\mathbb{Z}</annotation></semantics></math> there is an isomorphism
of functors <math id="S4.p3.m13" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}\cong\Pi_{i\in I}\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{i}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℍ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mo>≅</mo><mrow><msub><mi mathvariant="normal">Π</mi><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℍ</mi><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi><mtext>    </mtext></msubsup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}\cong\Pi_{i\in I}\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{i}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}</annotation></semantics></math>. By Example
<a href="#S3.Thmthm9" title="Example 3.9. ‣ 3. Finitely generated and coherent functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.9</span></a> we conclude that <math id="S4.p3.m14" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.p4" class="ltx_para">
<p id="S4.p4.1" class="ltx_p"><span id="S4.p4.1.1" class="ltx_text">For (<a href="#S4.I1.i1" title="item 1 ‣ Lemma 4.2. ‣ 4. Coherence of 
        
          Hom
        
      -functors: flat case ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), by
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">LO08</a>, Lem. 4.3.2]</cite>, given <math id="S4.p4.m1" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math>, there is a triangle:</span></p>
<table id="S4.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex3.m1" class="ltx_Math" alttext="\bigoplus_{n\geq 0}\tau^{{\leq n}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\to\bigoplus_{n\geq 0}\tau^{{\leq n}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\to\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>n</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>n</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">→</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigoplus_{n\geq 0}\tau^{{\leq n}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\to\bigoplus_{n\geq 0}\tau^{{\leq n}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\to\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p4.2" class="ltx_p"><span id="S4.p4.2.1" class="ltx_text">By hypothesis, <math id="S4.p4.m2" class="ltx_Math" alttext="\tau^{{\leq n}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>n</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup></mrow><annotation encoding="application/x-tex">\tau^{{\leq n}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math> for all <math id="S4.p4.m3" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>, and so
<math id="S4.p4.m4" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.p5" class="ltx_para">
<p id="S4.p5.1" class="ltx_p"><span id="S4.p5.1.1" class="ltx_text">For (<a href="#S4.I1.i2" title="item 2 ‣ Lemma 4.2. ‣ 4. Coherence of 
        
          Hom
        
      -functors: flat case ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) by
(<a href="#S4.I1.i1" title="item 1 ‣ Lemma 4.2. ‣ 4. Coherence of 
        
          Hom
        
      -functors: flat case ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), it is sufficient to prove that
<math id="S4.p5.m1" class="ltx_Math" alttext="\mathsf{D}_{\mathrm{QCoh}}^{-}(X)\subset\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathsf{D}_{\mathrm{QCoh}}^{-}(X)\subset\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math>. Since <math id="S4.p5.m2" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }</annotation></semantics></math> has
finite tor-dimension over <math id="S4.p5.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, there exists an integer <math id="S4.p5.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> such that
the natural map <math id="S4.p5.m5" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes^{\mathsf{L}}_{\mathcal{O}_{X}}\mathsf{L}{f}_{\mathrm{Q}}^{*}I\in\mathsf{D}_{\mathrm{QCoh}}^{\geq l}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mrow><mphantom></mphantom><mo>≥</mo><mi>l</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes^{\mathsf{L}}_{\mathcal{O}_{X}}\mathsf{L}{f}_{\mathrm{Q}}^{*}I\in\mathsf{D}_{\mathrm{QCoh}}^{\geq l}(X)</annotation></semantics></math> for all <math id="S4.p5.m6" class="ltx_Math" alttext="I\in\mathbf{QCoh}({S})" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>∈</mo><mrow><mi>𝐐𝐂𝐨𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I\in\mathbf{QCoh}({S})</annotation></semantics></math>. Thus, if <math id="S4.p5.m7" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{-}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{-}(X)</annotation></semantics></math>, then for any integer <math id="S4.p5.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> we have a natural
isomorphism of functors: <math id="S4.p5.m9" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}\cong\mathbb{H}_{{\tau^{{\geq l-n}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℍ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mo>≅</mo><msub><mi>ℍ</mi><mrow><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>l</mi><mo>−</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}\cong\mathbb{H}_{{\tau^{{\geq l-n}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}</annotation></semantics></math>. Hence, it is sufficient
to prove that <math id="S4.p5.m10" class="ltx_Math" alttext="\mathsf{D}_{\mathrm{QCoh}}^{b}(X)\subset\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mi>b</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></msubsup></mrow><annotation encoding="application/x-tex">\mathsf{D}_{\mathrm{QCoh}}^{b}(X)\subset\mathcal{T}_{{X/S}}^{{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math>. Working
with truncations and cones gives the result.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm3" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm3.2" class="ltx_text ltx_font_bold">Lemma 4.3</span></span><span id="S4.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm3.p1" class="ltx_para">
<p id="S4.Thmthm3.p1.1" class="ltx_p"><span id="S4.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">Fix an affine scheme <math id="S4.Thmthm3.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, a representable morphism of
algebraic <math id="S4.Thmthm3.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>-stacks <math id="S4.Thmthm3.p1.m3" class="ltx_Math" alttext="p:X^{\prime}\to X" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>X</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">p:X^{\prime}\to X</annotation></semantics></math> which is quasicompact, and
<math id="S4.Thmthm3.p1.m4" class="ltx_Math" alttext="\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X^{\prime})" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X^{\prime})</annotation></semantics></math>. Then, <math id="S4.Thmthm3.p1.m5" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathsf{R}p_{*}\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}=\mathbb{H}_{{\mathsf{L}{p}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℍ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts></mrow></mrow></msub><mo>=</mo><msub><mi>ℍ</mi><mrow><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi mathvariant="normal">Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathsf{R}p_{*}\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}=\mathbb{H}_{{\mathsf{L}{p}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math>. In
particular, if <math id="S4.Thmthm3.p1.m6" class="ltx_Math" alttext="\mathcal{T}_{{X^{\prime}/S}}^{{\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}=\mathsf{D}_{\mathrm{QCoh}}(X^{\prime})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><msup><mi>X</mi><mo>′</mo></msup><mo>/</mo><mi>S</mi></mrow><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts></msubsup><mo>=</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{{X^{\prime}/S}}^{{\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}=\mathsf{D}_{\mathrm{QCoh}}(X^{\prime})</annotation></semantics></math>, then <math id="S4.Thmthm3.p1.m7" class="ltx_Math" alttext="\mathcal{T}_{{X/S}}^{{\mathsf{R}p_{*}\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}=\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts></mrow></msubsup><mo>=</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{{X/S}}^{{\mathsf{R}p_{*}\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}=\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p6" class="ltx_para">
<p id="S4.p6.1" class="ltx_p"><span id="S4.p6.1.1" class="ltx_text">Fix <math id="S4.p6.m1" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math>, then:</span></p>
<table id="S4.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex4.m1" class="ltx_Math" alttext="\displaystyle\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathsf{R}p_{*}\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}" display="inline" intent=":literal"><semantics><msub><mi>ℍ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts></mrow></mrow></msub><annotation encoding="application/x-tex">\displaystyle\mathbb{H}_{{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathsf{R}p_{*}\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex4.m2" class="ltx_Math" alttext="\displaystyle=\Hom_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(\mathsf{R}p_{*}\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}(-))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>Hom</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><msubsup><mo rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Hom_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(\mathsf{R}p_{*}\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}(-))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex5.m1" class="ltx_Math" alttext="\displaystyle\cong\Hom_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathsf{R}p_{*}(\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X^{\prime}}}^{\mathsf{L}}\mathsf{L}{p}_{\mathrm{Q}}^{*}\mathsf{L}{f}_{\mathrm{Q}}^{*}(-)))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≅</mo><mrow><msub><mi>Hom</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>X</mi><mo>′</mo></msup></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cong\Hom_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathsf{R}p_{*}(\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X^{\prime}}}^{\mathsf{L}}\mathsf{L}{p}_{\mathrm{Q}}^{*}\mathsf{L}{f}_{\mathrm{Q}}^{*}(-)))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex6.m1" class="ltx_Math" alttext="\displaystyle\cong\Hom_{\mathcal{O}_{X}}((\mathsf{L}{p}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }),\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X^{\prime}}}^{\mathsf{L}}\mathsf{L}{g}_{\mathrm{Q}}^{*}(-)))=:\mathbb{H}_{{\mathsf{L}{p}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mphantom></mphantom><mo>≅</mo><mrow><msub><mi>Hom</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>X</mi><mo>′</mo></msup></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>ℍ</mi><mrow><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mmultiscripts><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow></mrow><mo>′</mo><mrow></mrow><mtext>    </mtext></mmultiscripts></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cong\Hom_{\mathcal{O}_{X}}((\mathsf{L}{p}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }),\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X^{\prime}}}^{\mathsf{L}}\mathsf{L}{g}_{\mathrm{Q}}^{*}(-)))=:\mathbb{H}_{{\mathsf{L}{p}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},{\mathcal{{{G^{\prime}}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p6.2" class="ltx_p"><span id="S4.p6.2.1" class="ltx_text">with the penultimate isomorphism given by the projection formula
(<a href="#S1.E6" title="In 1. Derived categories of sheaves on algebraic stacks ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.6</span></a>).
∎</span></p>
</div>
</div>
<div id="S4.p7" class="ltx_para">
<p id="S4.p7.1" class="ltx_p">We now have our first induction result.</p>
</div>
<div id="S4.Thmthm4" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm4.2" class="ltx_text ltx_font_bold">Lemma 4.4</span></span><span id="S4.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm4.p1" class="ltx_para">
<p id="S4.Thmthm4.p1.1" class="ltx_p"><span id="S4.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">Fix an affine scheme <math id="S4.Thmthm4.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, a morphism of algebraic stacks <math id="S4.Thmthm4.p1.m2" class="ltx_Math" alttext="f:X\to S" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">f:X\to S</annotation></semantics></math> which is of finite presentation, <math id="S4.Thmthm4.p1.m3" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math>,
and an integer <math id="S4.Thmthm4.p1.m4" class="ltx_Math" alttext="n\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">n\in\mathbb{Z}</annotation></semantics></math>. Suppose
that the functor <math id="S4.Thmthm4.p1.m5" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{M}}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[r]}}" display="inline" intent=":literal"><semantics><msub><mi>ℍ</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>r</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{M}}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[r]}}</annotation></semantics></math> is coherent in the
following situations:</span></p>
<ol id="S4.I2" class="ltx_enumerate">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p"><span id="S4.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">for all </span><math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="r&lt;n" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">r&lt;n</annotation></semantics></math><span id="S4.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S4.I2.i1.p1.m2" class="ltx_Math" alttext="\mathcal{{M}}\in\mathbf{QCoh}({X})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mrow><mi>𝐐𝐂𝐨𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{M}}\in\mathbf{QCoh}({X})</annotation></semantics></math><span id="S4.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p"><math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="r=n" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">r=n</annotation></semantics></math><span id="S4.I2.i2.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="\mathcal{{M}}\in\mathbf{QCoh}({X})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mrow><mi>𝐐𝐂𝐨𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{M}}\in\mathbf{QCoh}({X})</annotation></semantics></math><span id="S4.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> of finite presentation.</span></p>
</div></li>
</ol>
<p id="S4.Thmthm4.p1.2" class="ltx_p"><span id="S4.Thmthm4.p1.2.1" class="ltx_text ltx_font_italic">Then, the functor <math id="S4.Thmthm4.p1.m6" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{M}}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}" display="inline" intent=":literal"><semantics><msub><mi>ℍ</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{M}}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}</annotation></semantics></math> is coherent for all
<math id="S4.Thmthm4.p1.m7" class="ltx_Math" alttext="\mathcal{{M}}\in\mathbf{QCoh}({X})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mrow><mi>𝐐𝐂𝐨𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{M}}\in\mathbf{QCoh}({X})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p8" class="ltx_para">
<p id="S4.p8.1" class="ltx_p"><span id="S4.p8.1.1" class="ltx_text">Fix <math id="S4.p8.m1" class="ltx_Math" alttext="\mathcal{{M}}\in\mathbf{QCoh}({X})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mrow><mi>𝐐𝐂𝐨𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{M}}\in\mathbf{QCoh}({X})</annotation></semantics></math>, then we must prove that
<math id="S4.p8.m2" class="ltx_Math" alttext="\mathbb{H}_{{\mathcal{{M}}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}" display="inline" intent=":literal"><semantics><msub><mi>ℍ</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\mathbb{H}_{{\mathcal{{M}}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[n]}}</annotation></semantics></math> is coherent. The morphism <math id="S4.p8.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is of
finite presentation, so by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">Ryd09</a>, Thm. A]</cite>, the quasicoherent
<math id="S4.p8.m4" class="ltx_Math" alttext="\mathcal{O}_{X}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\mathcal{O}_{X}</annotation></semantics></math>-module <math id="S4.p8.m5" class="ltx_Math" alttext="\mathcal{{M}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{{M}}</annotation></semantics></math> is a filtered colimit of <math id="S4.p8.m6" class="ltx_Math" alttext="\mathcal{O}_{X}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\mathcal{O}_{X}</annotation></semantics></math>-modules
<math id="S4.p8.m7" class="ltx_Math" alttext="\mathcal{{M}}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathcal{{M}}_{\lambda}</annotation></semantics></math> of finite presentation. Let <math id="S4.p8.m8" class="ltx_math_unparsed" alttext="\mathcal{{Q}}_{1}=\oplus_{\lambda}\mathcal{{M}}_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mn>1</mn></msub><mo rspace="0em">=</mo><mo lspace="0em">⊕</mo><msub><mrow></mrow><mi>λ</mi></msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><msub><mrow></mrow><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{{Q}}_{1}=\oplus_{\lambda}\mathcal{{M}}_{\lambda}</annotation></semantics></math>, <math id="S4.p8.m9" class="ltx_math_unparsed" alttext="\mathcal{{Q}}_{2}=\oplus_{\lambda\leq\lambda^{\prime}}\mathcal{{M}}_{\lambda}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒬</mi><msub><mrow></mrow><mn>2</mn></msub><mo rspace="0em">=</mo><mo lspace="0em">⊕</mo><msub><mrow></mrow><mrow><mi>λ</mi><mo>≤</mo><msup><mi>λ</mi><mo>′</mo></msup></mrow></msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><msub><mrow></mrow><mi>λ</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{{Q}}_{2}=\oplus_{\lambda\leq\lambda^{\prime}}\mathcal{{M}}_{\lambda}</annotation></semantics></math> and take <math id="S4.p8.m10" class="ltx_Math" alttext="\theta:\mathcal{{Q}}_{2}\to\mathcal{{Q}}_{1}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mn>2</mn></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\theta:\mathcal{{Q}}_{2}\to\mathcal{{Q}}_{1}</annotation></semantics></math> to be the natural map with <math id="S4.p8.m11" class="ltx_Math" alttext="\coker\theta\cong\mathcal{{M}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>coker</mi><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow><mo>≅</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow><annotation encoding="application/x-tex">\coker\theta\cong\mathcal{{M}}</annotation></semantics></math>. Take <math id="S4.p8.m12" class="ltx_Math" alttext="\mathcal{{{Q}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mtext>    </mtext></msup><annotation encoding="application/x-tex">\mathcal{{{Q}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }</annotation></semantics></math> to be the cone of <math id="S4.p8.m13" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> in
<math id="S4.p8.m14" class="ltx_Math" alttext="\mathsf{D}_{\mathrm{QCoh}}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{D}_{\mathrm{QCoh}}(X)</annotation></semantics></math>, for all integers <math id="S4.p8.m15" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> we obtain an exact sequence in
<math id="S4.p8.m16" class="ltx_Math" alttext="\mathbf{Fun}_{{S}}^{\times}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐅𝐮𝐧</mi><mi>S</mi><mo>×</mo></msubsup><annotation encoding="application/x-tex">\mathbf{Fun}_{{S}}^{\times}</annotation></semantics></math>:</span></p>
<table id="S4.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S4.Ex7.m1.pic1" class="ltx_picture ltx_markedasmath" height="24.78" overflow="visible" style="vertical-align:-14.630364269838799px" version="1.1" viewBox="45.26 14.63 581.12 24.78" width="581.12"><g transform="matrix(1 0 0 -1 45.25720520568485 24.777469553194617) translate(0,3.46) translate(45.26,0)"><g transform="translate(-45.26,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.94em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.51em;font-size:10pt;" height="16.48" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="82.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex7.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{\mathbb{H}_{{\mathcal{{Q}}_{1}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[r-1]}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>ℍ</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mn>1</mn></msub><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\textstyle{\mathbb{H}_{{\mathcal{{Q}}_{1}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[r-1]}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 45.25720520568485 -0.27673578005007266 L 45.25720520568485 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(78.47,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 45.25720520568485 -0.27673578005007266 L 78.46600553777284 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 78.46600553777284 -0.27673578005007266 L 78.46600553777284 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(78.47,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.94em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.51em;font-size:10pt;" height="16.48" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="82.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex7.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{\mathbb{H}_{{\mathcal{{Q}}_{2}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[r-1]}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>ℍ</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mn>2</mn></msub><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\textstyle{\mathbb{H}_{{\mathcal{{Q}}_{2}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[r-1]}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 168.98041594914253 -0.27673578005007266 L 168.98041594914253 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(202.19,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-st