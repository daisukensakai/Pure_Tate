hcaligraphic">𝒦</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\simeq\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }))</annotation></semantics></math></td>
