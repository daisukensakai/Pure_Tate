 -0.27673578005007266 -19.925229526644873 L 0.27673578005007266 -19.925229526644873" fill="none" stroke="#000000"></path><g transform="translate(34.71,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 44.85847512204666 -7.610350076103501 L 45.41194668214681 -7.610350076103501" fill="none" stroke="#000000"></path><g transform="translate(45.14,0) translate(0,-15.04) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{f}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">f</mi><annotation encoding="application/x-tex">\scriptstyle{f}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(45.14,0) translate(0,-19.93)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 44.85847512204666 -19.925229526644873 L 45.41194668214681 -7.610350076103501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 44.85847512204666 -19.925229526644873 L 45.41194668214681 -19.925229526644873" fill="none" stroke="#000000"></path><g transform="translate(-9.16,0) translate(0,-30.07) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.72em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{T\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">\textstyle{T\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.155020074460356 -30.349070590050765 L 9.155020074460356 -29.79559902995062" fill="none" stroke="#000000"></path><g transform="translate(15.54,0) translate(0,-22.89) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.42em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{g}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">g</mi><annotation encoding="application/x-tex">\scriptstyle{g}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(34.81,0) translate(0,-30.07)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.155020074460356 -30.349070590050765 L 34.80551532150486 -29.79559902995062" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 34.80551532150486 -30.349070590050765 L 34.80551532150486 -29.79559902995062" fill="none" stroke="#000000"></path><g transform="translate(34.81,0) translate(0,-30.07) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.89em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{S.}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{S.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p14.2" class="ltx_p"><span id="S6.SS2.p14.2.1" class="ltx_text">The results are all smooth local on <math id="S6.SS2.p14.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and <math id="S6.SS2.p14.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, thus we may assume
that <math id="S6.SS2.p14.m4" class="ltx_Math" alttext="S=\spec A" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">S=\spec A</annotation></semantics></math> and <math id="S6.SS2.p14.m5" class="ltx_Math" alttext="T=\spec B" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">T=\spec B</annotation></semantics></math> and <math id="S6.SS2.p14.m6" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is induced by a ring
homomorphism <math id="S6.SS2.p14.m7" class="ltx_Math" alttext="A\to B" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo stretchy="false">→</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">A\to B</annotation></semantics></math>. We may also work with the global
<math id="S6.SS2.p14.m8" class="ltx_Math" alttext="\Ext" display="inline" intent=":literal"><semantics><mi>Ext</mi><annotation encoding="application/x-tex">\Ext</annotation></semantics></math>-groups instead of the relative <math id="S6.SS2.p14.m9" class="ltx_Math" alttext="\mathcal{E}xt" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\mathcal{E}xt</annotation></semantics></math>-sheaves.</span></p>
</div>
<div id="S6.SS2.p15" class="ltx_para">
<p id="S6.SS2.p15.1" class="ltx_p"><span id="S6.SS2.p15.1.1" class="ltx_text">For an <math id="S6.SS2.p15.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-module <math id="S6.SS2.p15.m2" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> set <math id="S6.SS2.p15.m3" class="ltx_Math" alttext="E^{q}(I)=\Ext^{q}_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}\otimes_{\mathcal{O}_{X}}f^{*}I)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>E</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Ext</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>q</mi></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E^{q}(I)=\Ext^{q}_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}\otimes_{\mathcal{O}_{X}}f^{*}I)</annotation></semantics></math>, which gives
an <math id="S6.SS2.p15.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-linear functor <math id="S6.SS2.p15.m5" class="ltx_Math" alttext="\mathbf{Mod}({A})\to\mathbf{Mod}({A})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>𝐌𝐨𝐝</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Mod}({A})\to\mathbf{Mod}({A})</annotation></semantics></math>. By Theorem
<a href="#Thmmainthm3" title="Theorem C. ‣ Introduction ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>, the functor <math id="S6.SS2.p15.m6" class="ltx_Math" alttext="E^{q}" display="inline" intent=":literal"><semantics><msup><mi>E</mi><mi>q</mi></msup><annotation encoding="application/x-tex">E^{q}</annotation></semantics></math> is coherent and by
Lemma <a href="#S1.Thmthm1" title="Lemma 1.1. ‣ 1. Derived categories of sheaves on algebraic stacks ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a> the functor preserves filtered colimits
(in particular, it preserves direct limits). By Lemma
<a href="#S2.Thmthm2" title="Lemma 2.2. ‣ 2. Corepresentability of 
        
          
            ⁢
            R
            H
            o
            m
          
        
      -functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>, if <math id="S6.SS2.p15.m7" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> is a <math id="S6.SS2.p15.m8" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>-module, there is a natural
isomorphism:</span></p>
<table id="S6.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex14.m1" class="ltx_Math" alttext="E^{q}(J)=\Ext^{q}_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}\otimes_{\mathcal{O}_{X}}f^{*}g_{*}J)\cong\Ext^{q}_{\mathcal{O}_{X_{T}}}(\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },g_{X}^{*}\mathcal{{N}}\otimes_{\mathcal{O}_{X_{T}}}f_{T}^{*}J)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>E</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>J</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Ext</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>q</mi></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msubsup><mi>Ext</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>X</mi><mi>T</mi></msub></msub><mi>q</mi></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mrow><mrow><msubsup><mi>g</mi><mi>X</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>X</mi><mi>T</mi></msub></msub></msub><mrow><msubsup><mi>f</mi><mi>T</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E^{q}(J)=\Ext^{q}_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}\otimes_{\mathcal{O}_{X}}f^{*}g_{*}J)\cong\Ext^{q}_{\mathcal{O}_{X_{T}}}(\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },g_{X}^{*}\mathcal{{N}}\otimes_{\mathcal{O}_{X_{T}}}f_{T}^{*}J).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p15.2" class="ltx_p"><span id="S6.SS2.p15.2.1" class="ltx_text">In particular, taking <math id="S6.SS2.p15.m9" class="ltx_Math" alttext="J=B" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">J=B</annotation></semantics></math> we obtain a natural map:</span></p>
<table id="S6.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex15.m1" class="ltx_Math" alttext="E^{q}(A)\otimes_{A}B:=\Ext^{q}_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}})\otimes_{A}B\to\Ext^{q}_{\mathcal{O}_{X_{T}}}(\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },g_{X}^{*}\mathcal{{N}})=E^{q}(B)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>E</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><mi>A</mi></msub><mi>B</mi></mrow><mo>:=</mo><mrow><mrow><msubsup><mi>Ext</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>q</mi></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><mi>A</mi></msub><mi>B</mi></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>Ext</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>X</mi><mi>T</mi></msub></msub><mi>q</mi></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mrow><msubsup><mi>g</mi><mi>X</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>E</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E^{q}(A)\otimes_{A}B:=\Ext^{q}_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}})\otimes_{A}B\to\Ext^{q}_{\mathcal{O}_{X_{T}}}(\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },g_{X}^{*}\mathcal{{N}})=E^{q}(B).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p15.3" class="ltx_p"><span id="S6.SS2.p15.3.1" class="ltx_text">The result now follows from Corollary <a href="#S6.Thmthm8" title="Corollary 6.8 (Property of exchange). ‣ 6.2. Cohomology and base change ‣ 6. Applications ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.8</span></a>.
∎</span></p>
</div>
</div>
</section>
