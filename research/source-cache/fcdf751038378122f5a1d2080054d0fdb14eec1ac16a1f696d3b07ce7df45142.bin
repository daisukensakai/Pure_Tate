<p id="S2.p5.2" class="ltx_p"><span id="S2.p5.2.1" class="ltx_text">By Lemma <a href="#S2.Thmthm2" title="Lemma 2.2. ‣ 2. Corepresentability of 
        
          
            ⁢
            R
            H
            o
            m
          
        
      -functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a> and what we have proven so far, there
is a quasi-isomorphism, natural in <math id="S2.p5.m8" class="ltx_Math" alttext="\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(T)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(T)</annotation></semantics></math>:</span></p>
<table id="S2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex26.m1" class="ltx_Math" alttext="\displaystyle\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]},\mathsf{R}g_{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}g_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{T}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup><mo>,</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>T</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>g</mi><mi>X</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]},\mathsf{R}g_{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}g_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{T}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p5.3" class="ltx_p"><span id="S2.p5.3.1" class="ltx_text">By trivial duality (<a href="#S1.E5" title="In 1. Derived categories of sheaves on algebraic stacks ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.5</span></a>) we thus obtain
a quasi-isomorphism, natural in <math id="S2.p5.m9" class="ltx_Math" alttext="\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(T)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(T)</annotation></semantics></math>:</span></p>
<table id="S2.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex27.m1" class="ltx_Math" alttext="\mathsf{R}g_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{T}}(\mathsf{L}{g}_{\mathrm{Q}}^{*}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}g_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{T}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>T</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup></mrow><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>T</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>g</mi><mi>X</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mtext>    </mtext></msubsup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{R}g_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{T}}(\mathsf{L}{g}_{\mathrm{Q}}^{*}\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}g_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{T}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }).</annotation></semantics></math></td>
