1461879" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 44.85847512204666 -19.925229526644873 L 45.41194668214681 -19.925229526644873" fill="none" stroke="#000000"></path><g transform="translate(-9.16,0) translate(0,-30) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:0.72em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex3.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{T\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">\textstyle{T\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.155020074460356 -30.272217134692387 L 9.155020074460356 -29.71874557459224" fill="none" stroke="#000000"></path><g transform="translate(15.54,0) translate(0,-22.82) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.42em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex3.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{g}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">g</mi><annotation encoding="application/x-tex">\scriptstyle{g}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(34.81,0) translate(0,-30)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.155020074460356 -30.272217134692387 L 34.80551532150486 -29.71874557459224" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 34.80551532150486 -30.272217134692387 L 34.80551532150486 -29.71874557459224" fill="none" stroke="#000000"></path><g transform="translate(34.81,0) translate(0,-30) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:0.89em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex3.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{S.}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{S.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
