<mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\to\underset{n}{\mathrm{holim}}\,\mathsf{R}f_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\tau^{{\geq-n+r}}(\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}[\tau^{{\geq-n}}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }]))</annotation></semantics></math></td>
