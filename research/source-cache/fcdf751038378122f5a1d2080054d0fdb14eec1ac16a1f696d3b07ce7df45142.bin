<p id="S2.Thmthm2.p1.2" class="ltx_p"><span id="S2.Thmthm2.p1.2.1" class="ltx_text ltx_font_italic">Let <math id="S2.Thmthm2.p1.m2" class="ltx_Math" alttext="\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{-}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{-}(X)</annotation></semantics></math>, <math id="S2.Thmthm2.p1.m3" class="ltx_Math" alttext="\mathcal{{N}}\in\mathbf{Coh}({X})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>∈</mo><mrow><mi>𝐂𝐨𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{N}}\in\mathbf{Coh}({X})</annotation></semantics></math>, and <math id="S2.Thmthm2.p1.m4" class="ltx_Math" alttext="\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(T)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(T)</annotation></semantics></math>. If <math id="S2.Thmthm2.p1.m5" class="ltx_Math" alttext="\mathcal{{N}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒩</mi><annotation encoding="application/x-tex">\mathcal{{N}}</annotation></semantics></math> is flat over <math id="S2.Thmthm2.p1.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, then there is a natural
quasi-isomorphism in <math id="S2.Thmthm2.p1.m7" class="ltx_Math" alttext="\mathsf{D}_{\mathrm{QCoh}}^{+}(S)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{D}_{\mathrm{QCoh}}^{+}(S)</annotation></semantics></math>:</span></p>
<table id="S2.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex4.m1" class="ltx_Math" alttext="\displaystyle\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}" display="inline" intent=":literal"><semantics><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex4.m2" class="ltx_Math" alttext="\displaystyle(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathsf{R}g_{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">]</mo></mrow></mrow><msubsup><mo rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{N}}[0]\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathsf{R}g_{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex5.m1" class="ltx_Math" alttext="\displaystyle\to\mathsf{R}g_{*}\mathsf{R}{(f_{T})}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X_{T}}}(\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]\otimes^{\mathsf{L}}_{\mathcal{O}_{X_{T}}}\mathsf{L}{(f_{T})}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">→</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>X</mi><mi>T</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>g</mi><mi>X</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">]</mo></mrow></mrow><msubsup><mo rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>X</mi><mi>T</mi></msub></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\to\mathsf{R}g_{*}\mathsf{R}{(f_{T})}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X_{T}}}(\mathsf{L}{(g_{X})}_{\mathrm{Q}}^{*}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },(g_{X}^{*}\mathcal{{N}})[0]\otimes^{\mathsf{L}}_{\mathcal{O}_{X_{T}}}\mathsf{L}{(f_{T})}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.p3" class="ltx_para">
<p id="S2.p3.1" class="ltx_p">We can now prove Theorem <a href="#Thmmainthm2" title="Theorem B. ‣ Introduction ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.</p>
</div>
<div id="S2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmmainthm2" title="Theorem B. ‣ Introduction ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.</h6>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.1" class="ltx_p"><span id="S2.p4.1.1" class="ltx_text">For background material on dualizing complexes we refer the reader
to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx12" title="" class="ltx_ref">Har66</a>, V.2]</cite>. For the
convenience of the reader, however, we will recall the relevant
results. A complex <math id="S2.p4.m1" class="ltx_Math" alttext="\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{b}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mi>b</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{b}(S)</annotation></semantics></math> is dualizing if it is
locally of finite injective dimension and for any <math id="S2.p4.m2" class="ltx_Math" alttext="\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>Coh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}(S)</annotation></semantics></math>, the natural map:</span></p>
<table id="S2.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex6.m1" class="ltx_Math" alttext="\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\to\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }),\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })" display="block" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mtext>    </mtext></msup><mo stretchy="false">→</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mtext>    </mtext></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\to\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }),\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p4.2" class="ltx_p"><span id="S2.p4.2.1" class="ltx_text">is a quasi-isomorphism. For notational convenience we set
<math id="S2.p4.m3" class="ltx_Math" alttext="-\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(-,\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(-,\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })</annotation></semantics></math>. Two useful facts about
dualizing complexes are the following:</span></p>
<ol id="S2.I2" class="ltx_enumerate">
<li id="S2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S2.I2.i1.p1" class="ltx_para">
<p id="S2.I2.i1.p1.1" class="ltx_p">the functor interchanges
<math id="S2.I2.i1.p1.m2" class="ltx_Math" alttext="\mathsf{D}_{\mathrm{Coh}}^{-}(S)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{D}_{\mathrm{Coh}}^{-}(S)</annotation></semantics></math> and <math id="S2.I2.i1.p1.m3" class="ltx_Math" alttext="\mathsf{D}_{\mathrm{Coh}}^{+}(S)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{D}_{\mathrm{Coh}}^{+}(S)</annotation></semantics></math>;</p>
</div></li>
<li id="S2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S2.I2.i2.p1" class="ltx_para">
<p id="S2.I2.i2.p1.1" class="ltx_p">for <math id="S2.I2.i2.p1.m1" class="ltx_Math" alttext="\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mtext>    </mtext></msup><annotation encoding="application/x-tex">\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }</annotation></semantics></math>, <math id="S2.I2.i2.p1.m2" class="ltx_Math" alttext="\mathcal{{{G}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>Coh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{G}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}(S)</annotation></semantics></math>, there is a natural quasi-isomorphism:</p>
<table id="S2.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex7.m1" class="ltx_Math" alttext="\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{G}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{G}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mtext>    </mtext></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow></mrow><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow></mrow><mtext>    </mtext></msup></mrow><mo fence="true" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{G}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{G}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\mathcal{{{F}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="S2.p4.3" class="ltx_p"><span id="S2.p4.3.1" class="ltx_text">Now fix <math id="S2.p4.m4" class="ltx_Math" alttext="\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{+}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{+}(S)</annotation></semantics></math>, then we have the following
sequence of natural quasi-isomorphisms:</span></p>
<table id="S2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex8.m1" class="ltx_Math" alttext="\displaystyle\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })" display="inline" intent=":literal"><semantics><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td></tr></tbody>
<tbody id="S2.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex9.m1" class="ltx_Math" alttext="\displaystyle\simeq\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≃</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow></mrow><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\simeq\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="S2.Ex9.4.1" class="ltx_text ltx_markedasmath">(by (<a href="#S2.I2.i1" title="item 1 ‣ Proof of Theorem . ‣ 2. Corepresentability of 
        
          
            ⁢
            R
            H
            o
            m
          
        
      -functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>))</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex10.m1" class="ltx_Math" alttext="\displaystyle\simeq\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≃</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0.222em" rspace="0em">​</mo><msup><mrow></mrow><mtext>    </mtext></msup><mo lspace="0em" rspace="0.222em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\simeq\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="S2.Ex10.4.1" class="ltx_text ltx_markedasmath">(by Lemma
<a href="#S2.Thmthm1" title="Lemma 2.1. ‣ 2. Corepresentability of 
        
          
            ⁢
            R
            H
            o
            m
          
        
      -functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>(<a href="#S2.I1.i2" title="item 2 ‣ Lemma 2.1. ‣ 2. Corepresentability of 
        
          
            ⁢
            R
            H
            o
            m
          
        
      -functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>))</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
