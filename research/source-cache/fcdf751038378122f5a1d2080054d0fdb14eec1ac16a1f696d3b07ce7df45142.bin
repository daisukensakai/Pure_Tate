<tbody id="S2.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex14.m1" class="ltx_Math" alttext="\displaystyle\simeq\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≃</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>,</mo><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\simeq\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex14.m2" class="ltx_Math" alttext="\displaystyle\mbox{(by \eqref{item:dualizing2})}." display="inline" intent=":literal"><semantics><mrow><mrow><mtext>(by (</mtext><mtext><a href="#S2.I2.i2" title="item 2 ‣ Proof of Theorem . ‣ 2. Corepresentability of 
        
          
            ⁢
            R
            H
            o
            m
          
        
      -functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext><mtext>))</mtext></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mbox{(by \eqref{item:dualizing2})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p4.4" class="ltx_p"><span id="S2.p4.4.1" class="ltx_text">The final quasi-isomorphism is a consequence of the following
sequence of observations. First, <math id="S2.p4.m5" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{b}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mi>b</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{b}(X)</annotation></semantics></math> has
finite tor-dimension over <math id="S2.p4.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and <math id="S2.p4.m7" class="ltx_Math" alttext="\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{b}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mi>b</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{b}(S)</annotation></semantics></math>, so <math id="S2.p4.m8" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes^{\mathsf{L}}_{\mathcal{O}_{X}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{b}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mi>b</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes^{\mathsf{L}}_{\mathcal{O}_{X}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{b}(X)</annotation></semantics></math>. Also, <math id="S2.p4.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is proper so <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx29" title="" class="ltx_ref">Ols07</a>, 6.4.4 &amp; 10.13]</cite>
implies that <math id="S2.p4.m10" class="ltx_Math" alttext="\mathsf{R}f_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\in\mathsf{D}_{\mathrm{Coh}}^{+}(S)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{R}f_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\in\mathsf{D}_{\mathrm{Coh}}^{+}(S)</annotation></semantics></math>. Thus (<a href="#S2.I2.i2" title="item 2 ‣ Proof of Theorem . ‣ 2. Corepresentability of 
        
          
            ⁢
            R
            H
            o
            m
          
        
      -functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) applies. Hence, we have
produced a natural quasi-isomorphism for all <math id="S2.p4.m11" class="ltx_Math" alttext="\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{+}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}^{+}(S)</annotation></semantics></math>:</span></p>
<table id="S2.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E1.m1" class="ltx_Math" alttext="\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow><mtext>    </mtext></msubsup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\simeq\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p4.5" class="ltx_p"><span id="S2.p4.5.1" class="ltx_text">where</span></p>
<table id="S2.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex15.m1" class="ltx_Math" alttext="\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}\simeq\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }),\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\in\mathsf{D}_{\mathrm{Coh}}^{-}(S)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow><mtext>    </mtext></msubsup><mo>≃</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>Coh</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }}\simeq\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathsf{R}{f}_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }),\mathcal{{{K}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\in\mathsf{D}_{\mathrm{Coh}}^{-}(S).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p4.6" class="ltx_p"><span id="S2.p4.6.1" class="ltx_text">We now need to extend the quasi-isomorphism (<a href="#S2.E1" title="In Proof of Theorem . ‣ 2. Corepresentability of 
        
          
            ⁢
            R
            H
            o
            m
          
        
      -functors ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>)
to <math id="S2.p4.m12" class="ltx_Math" alttext="\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msubsup><mi>𝖣</mi><mi>QCoh</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}^{+}(S)</annotation></semantics></math>. First, we note that because
<math id="S2.p4.m13" class="ltx_Math" alttext="\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><annotation encoding="application/x-tex">\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }</annotation></semantics></math> is bounded, there
exists an <math id="S2.p4.m14" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> such that for all <math id="S2.p4.m15" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and all <math id="S2.p4.m16" class="ltx_Math" alttext="\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>QCoh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{QCoh}}(S)</annotation></semantics></math> the natural map:</span></p>
<table id="S2.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex16.m1" class="ltx_Math" alttext="\tau^{{\geq n+r}}(\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\to\tau^{{\geq n+r}}(\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}[\tau^{{\geq n}}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }])" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>n</mi><mo>+</mo><mi>r</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>n</mi><mo>+</mo><mi>r</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo>≥</mo><mi>n</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau^{{\geq n+r}}(\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })\to\tau^{{\geq n+r}}(\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}[\tau^{{\geq n}}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p4.7" class="ltx_p"><span id="S2.p4.7.1" class="ltx_text">is a quasi-isomorphism. Hence, by Lemma <a href="#S1.Thmthm2" title="Lemma 1.2. ‣ 1. Derived categories of sheaves on algebraic stacks ‣ Cohomology and base change for algebraic stacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a> there exist maps for all
<math id="S2.p4.m17" class="ltx_Math" alttext="\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo>∈</mo><mrow><msub><mi>𝖣</mi><mi>Coh</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\in\mathsf{D}_{\mathrm{Coh}}(S)</annotation></semantics></math>:</span></p>
<table id="S2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex17.m1" class="ltx_Math" alttext="\displaystyle\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })" display="inline" intent=":literal"><semantics><mrow><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow><mtext>    </mtext></msubsup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex17.m2" class="ltx_Math" alttext="\displaystyle\simeq\underset{n}{\mathrm{holim}}\,\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},\tau^{{\geq-n}}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≃</mo><mrow><munder accentunder="true"><mi>holim</mi><mo mathsize="0.700em">𝑛</mo></munder><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup></mrow><mtext>    </mtext></msubsup><mo>,</mo><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo rspace="0em">≥</mo><mrow><mo lspace="0em">−</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\simeq\underset{n}{\mathrm{holim}}\,\mathsf{R}\mathcal{H}om_{\mathcal{O}_{S}}(\mathcal{{{E}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }_{\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }},\tau^{{\geq-n}}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ })</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex18.m1" class="ltx_Math" alttext="\displaystyle\simeq\underset{n}{\mathrm{holim}}\,\mathsf{R}f_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}[\tau^{{\geq-n}}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }])" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≃</mo><mrow><munder accentunder="true"><mi>holim</mi><mo mathsize="0.700em">𝑛</mo></munder><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mi>𝖫</mi></msubsup><mrow><mi>𝖫</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mi>Q</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo rspace="0em">≥</mo><mrow><mo lspace="0em">−</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>    </mtext></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\simeq\underset{n}{\mathrm{holim}}\,\mathsf{R}f_{*}\mathsf{R}\mathcal{H}om_{\mathcal{O}_{X}}(\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ },\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\otimes_{\mathcal{O}_{X}}^{\mathsf{L}}\mathsf{L}{f}_{\mathrm{Q}}^{*}[\tau^{{\geq-n}}\mathcal{{{I}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }])</annotation></semantics></math></td>
