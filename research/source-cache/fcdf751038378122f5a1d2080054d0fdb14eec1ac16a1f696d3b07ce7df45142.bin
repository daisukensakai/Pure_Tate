2 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 61.8053587769281 -0.27673578005007266 L 95.01413799542946 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 95.01413799542946 -0.27673578005007266 L 95.01413799542946 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(95.02,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.27em;--ltx-fo-height:0.89em;--ltx-fo-depth:0em;font-size:10pt;" height="12.29" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="72.95"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex13.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{\tau^{{\geq-l-1}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo rspace="0em">≥</mo><mrow><mrow><mo lspace="0em">−</mo><mi>l</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><annotation encoding="application/x-tex">\textstyle{\tau^{{\geq-l-1}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 176.26346320520054 -0.27673578005007266 L 176.26346320520054 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(209.47,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 176.26346320520054 -0.27673578005007266 L 209.4722424237019 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 209.4722424237019 -0.27673578005007266 L 209.4722424237019 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(209.47,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.88em;--ltx-fo-height:0.89em;--ltx-fo-depth:0em;font-size:10pt;" height="12.29" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="67.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex13.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{\tau^{{\geq-l}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }.}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>τ</mi><mrow><mphantom></mphantom><mo rspace="0em">≥</mo><mrow><mo lspace="0em">−</mo><mi>l</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mtext>    </mtext></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{\tau^{{\geq-l}}\mathcal{{{M}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
