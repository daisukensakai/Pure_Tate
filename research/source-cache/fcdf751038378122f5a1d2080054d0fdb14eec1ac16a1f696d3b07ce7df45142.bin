0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 417.5415714697272 -0.27673578005007266 L 450.7503506882286 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 450.7503506882286 -0.27673578005007266 L 450.7503506882286 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(450.76,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.55em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.51em;font-size:10pt;" height="16.48" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="76.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex7.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{\mathbb{H}_{{\mathcal{{Q}}_{2}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[r]}}.}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℍ</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mn>2</mn></msub><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mtext>    </mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>r</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{\mathbb{H}_{{\mathcal{{Q}}_{2}},{\mathcal{{{N}}}^{\,\begin{picture}(0.0,-2.0)\circle*{1.5}\end{picture}\ }[r]}}.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
