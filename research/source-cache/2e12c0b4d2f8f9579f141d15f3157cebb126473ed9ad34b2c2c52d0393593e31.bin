<p id="S3.SS3.p6.2" class="ltx_p"><span id="S3.SS3.p6.2.1" class="ltx_text">Finally, note that</span></p><span class="ltx_inline-block"><svg id="S3.SS3.p6.pic3" class="ltx_picture ltx_centering" height="69.76" overflow="visible" style="vertical-align:-34.88px" version="1.1" viewBox="0 0 248.19 69.76" width="248.19"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,69.76) matrix(1 0 0 -1 0 0) translate(161.98,0) translate(0,34.88)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -56.96 -27.74)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 69.77)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.33)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 2 0) translate(13.4,0) matrix(1.0 0.0 0.0 1.0 -7.45 0)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.75em;--ltx-fo-depth:0em;font-size:10pt;" height="10.4" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="14.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS3.p6.pic3.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces E^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>E</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces E^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 36.68 0) translate(52.29,0) matrix(1.0 0.0 0.0 1.0 -13.13 0)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="26.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS3.p6.pic3.m2" class="ltx_math_unparsed" alttext="{\lx@inpgf@ignorespaces\wedge^{2}F}" display="inline" intent=":literal"><semantics><mrow><mo>∧</mo><msup><mrow></mrow><mn>2</mn></msup><mi>F</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\wedge^{2}F}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 62.63)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(15.41,0) matrix(1.0 0.0 0.0 1.0 -9.45 0)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="18.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS3.p6.pic3.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces E_{\alpha}^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><mi>α</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces E_{\alpha}^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 30.81 0) translate(58.16,0) matrix(1.0 0.0 0.0 1.0 -18.99 0)"><foreignObject style="--ltx-fo-width:2.74em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.15em;font-size:10pt;" height="13.34" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="37.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS3.p6.pic3.m4" class="ltx_math_unparsed" alttext="{\lx@inpgf@ignorespaces\wedge^{2}F_{\alpha}.}" display="inline" intent=":literal"><semantics><mrow><mo>∧</mo><msup><mrow></mrow><mn>2</mn></msup><mi>F</mi><msub><mrow></mrow><mi>α</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\wedge^{2}F_{\alpha}.}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -41.55 13.21 L -41.55 -11.45"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -41.55 -11.72)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -159 -2.5)"><foreignObject style="--ltx-fo-width:8.25em;--ltx-fo-height:0.62em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.06" overflow="visible" transform="matrix(1 0 0 -1 0 8.63)" width="114.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS3.p6.pic3.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\det(x^{2}t\cdot\xi)\otimes((x^{2}t\cdot\xi)^{-1})^{\vee}}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.700em" rspace="0em">det</mo><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mrow><msup><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi></mrow><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">ξ</mi></mrow><mo maxsize="0.700em" minsize="0.700em" rspace="0.055em">)</mo></mrow><mo mathsize="0.700em" rspace="0.222em">⊗</mo><msup><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msup><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mrow><msup><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi></mrow><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">ξ</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mrow><mo mathsize="0.710em">−</mo><mn mathsize="0.710em">1</mn></mrow></msup><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.710em">∨</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\det(x^{2}t\cdot\xi)\otimes((x^{2}t\cdot\xi)^{-1})^{\vee}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -27.87 22.01 L 12.1 22.01"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 12.37 22.01)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -10.46 27.15)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS3.p6.pic3.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\eta}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">η</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\eta}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 32.01 13.21 L 32.01 -10.59"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 32.01 -10.86)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 35.27 -2.07)"><foreignObject style="--ltx-fo-width:3.47em;--ltx-fo-height:0.62em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.06" overflow="visible" transform="matrix(1 0 0 -1 0 8.63)" width="47.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS3.p6.pic3.m7" class="ltx_math_unparsed" alttext="\scriptstyle{\lx@inpgf@ignorespaces\wedge^{2}(x^{3}t\cdot\psi)}" display="inline" intent=":literal"><semantics><mrow><msup><mo mathsize="0.700em">∧</mo><mn mathsize="0.710em">2</mn></msup><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msup><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">3</mn></msup><mi mathsize="0.700em">t</mi><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">ψ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\wedge^{2}(x^{3}t\cdot\psi)}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -25.87 -24.28 L 6.23 -24.28"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 6.51 -24.28)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -15.9 -19.14)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS3.p6.pic3.m8" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">η</mi><mi mathsize="0.710em">α</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
<p id="S3.SS3.p6.3" class="ltx_p"><span id="S3.SS3.p6.3.1" class="ltx_text">also commutes, as it just rescales both vertical maps of the second diagram in (<a href="#S3.E17" title="In Proof. ‣ 3.3. The category of regular pentagonal covers ‣ 3. The Casnati–Ekedahl structure theorem ‣ Tautological classes on Low-degree Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.17</span></a>) by <math id="S3.SS3.p6.m8" class="ltx_Math" alttext="x^{6}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mn>6</mn></msup><annotation encoding="application/x-tex">x^{6}</annotation></semantics></math>. Hence, pair of isomorphisms <math id="S3.SS3.p6.m9" class="ltx_Math" alttext="x^{2}t\cdot\xi:E\to E_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ξ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo stretchy="false">→</mo><msub><mi>E</mi><mi>α</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x^{2}t\cdot\xi:E\to E_{\alpha}</annotation></semantics></math> and <math id="S3.SS3.p6.m10" class="ltx_Math" alttext="x^{3}t\cdot\psi:F\to F_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ψ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>F</mi><mo stretchy="false">→</mo><msub><mi>F</mi><mi>α</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x^{3}t\cdot\psi:F\to F_{\alpha}</annotation></semantics></math> define an arrow <math id="S3.SS3.p6.m11" class="ltx_Math" alttext="(E,F,\phi,\eta)\to(E_{\alpha},F_{\alpha},\phi_{\alpha},\eta_{\alpha})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>ϕ</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>α</mi></msub><mo>,</mo><msub><mi>F</mi><mi>α</mi></msub><mo>,</mo><msub><mi>ϕ</mi><mi>α</mi></msub><mo>,</mo><msub><mi>η</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(E,F,\phi,\eta)\to(E_{\alpha},F_{\alpha},\phi_{\alpha},\eta_{\alpha})</annotation></semantics></math> in <math id="S3.SS3.p6.m12" class="ltx_Math" alttext="\mathrm{Pent}^{\prime}(S)" display="inline" intent=":literal"><semantics><mrow><msup><mi>Pent</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Pent}^{\prime}(S)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.4. </span>Casnati–Ekedahl classes</h3>

<div id="S3.SS4.p1" class="ltx_para">
<p id="S3.SS4.p1.1" class="ltx_p">We now define some preferred generators for <math id="S3.SS4.p1.m1" class="ltx_Math" alttext="R^{*}(\mathcal{H}_{k,g})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{*}(\mathcal{H}_{k,g})</annotation></semantics></math> using the Chern classes of vector bundles appearing in the Casnati–Ekedahl resolution.
Let <math id="S3.SS4.p1.m2" class="ltx_Math" alttext="\pi:\mathcal{P}\to\mathcal{H}_{k,g}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\pi:\mathcal{P}\to\mathcal{H}_{k,g}</annotation></semantics></math> denote the universal <math id="S3.SS4.p1.m3" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>-bundle and <math id="S3.SS4.p1.m4" class="ltx_Math" alttext="\alpha:\mathcal{C}\to\mathcal{P}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha:\mathcal{C}\to\mathcal{P}</annotation></semantics></math> the universal degree <math id="S3.SS4.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> cover. We define <math id="S3.SS4.p1.m6" class="ltx_Math" alttext="z:=-\frac{1}{2}c_{1}(\omega_{\pi})=c_{1}(\mathcal{O}_{\mathcal{P}}(1))" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo rspace="0em">:=</mo><mrow><mo lspace="0em">−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z:=-\frac{1}{2}c_{1}(\omega_{\pi})=c_{1}(\mathcal{O}_{\mathcal{P}}(1))</annotation></semantics></math> and</p>
<table id="S3.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.18)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E18.m1" class="ltx_Math" alttext="c_{2}:=c_{2}(\pi_{*}\mathcal{O}_{\mathcal{P}}(1))\qquad\Rightarrow\qquad z^{2}+\pi^{*}c_{2}=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>:=</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mo stretchy="false">⇒</mo><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><msup><mi>z</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">c_{2}:=c_{2}(\pi_{*}\mathcal{O}_{\mathcal{P}}(1))\qquad\Rightarrow\qquad z^{2}+\pi^{*}c_{2}=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p1.2" class="ltx_p">where the equality on the right follows from (<a href="#S2.E1" title="In 2.1. Projective bundles ‣ 2. Notation and conventions ‣ Tautological classes on Low-degree Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>).
Define <math id="S3.SS4.p1.m7" class="ltx_Math" alttext="\mathcal{E}^{\vee}:=E_{\alpha}^{\vee}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo>:=</mo><msubsup><mi>E</mi><mi>α</mi><mo>∨</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{E}^{\vee}:=E_{\alpha}^{\vee}</annotation></semantics></math> to be the cokernel of <math id="S3.SS4.p1.m8" class="ltx_Math" alttext="\mathcal{O}_{\mathcal{P}}\to\alpha_{*}\mathcal{O}_{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}_{\mathcal{P}}\to\alpha_{*}\mathcal{O}_{\mathcal{C}}</annotation></semantics></math>, which is a rank <math id="S3.SS4.p1.m9" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math> vector bundle on <math id="S3.SS4.p1.m10" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>. For <math id="S3.SS4.p1.m11" class="ltx_Math" alttext="i=1,\ldots,k-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=1,\ldots,k-1</annotation></semantics></math>, we define classes <math id="S3.SS4.p1.m12" class="ltx_Math" alttext="a_{i}\in A^{i}(\mathcal{H}_{k,g})" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>∈</mo><mrow><msup><mi>A</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{i}\in A^{i}(\mathcal{H}_{k,g})</annotation></semantics></math> and <math id="S3.SS4.p1.m13" class="ltx_Math" alttext="a_{i}^{\prime}\in A^{i-1}(\mathcal{H}_{k,g})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mi>i</mi><mo>′</mo></msubsup><mo>∈</mo><mrow><msup><mi>A</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{i}^{\prime}\in A^{i-1}(\mathcal{H}_{k,g})</annotation></semantics></math> by the formula</p>
<table id="S3.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.19)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E19.m1" class="ltx_math_unparsed" alttext="a_{i}:=\pi_{*}(z\cdot c_{i}(\mathcal{E})),\quad a_{i}^{\prime}:=\pi_{*}(c_{i}(\mathcal{E}))\qquad\Rightarrow\qquad c_{i}(\mathcal{E})=\pi^{*}a_{i}+\pi^{*}a_{i}^{\prime}z." display="block" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>:=</mo><msub><mi>π</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>c</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><msubsup><mi>a</mi><mi>i</mi><mo>′</mo></msubsup><mo>:=</mo><msub><mi>π</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">⇒</mo><msub><mi>c</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>π</mi><mo>∗</mo></msup><msub><mi>a</mi><mi>i</mi></msub><mo>+</mo><msup><mi>π</mi><mo>∗</mo></msup><msubsup><mi>a</mi><mi>i</mi><mo>′</mo></msubsup><mi>z</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{i}:=\pi_{*}(z\cdot c_{i}(\mathcal{E})),\quad a_{i}^{\prime}:=\pi_{*}(c_{i}(\mathcal{E}))\qquad\Rightarrow\qquad c_{i}(\mathcal{E})=\pi^{*}a_{i}+\pi^{*}a_{i}^{\prime}z.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p1.3" class="ltx_p">By Example <a href="#S3.Thmthm1" title="Example 3.1 (Covers of 
          
            
              
              P
              1
            
          
        ). ‣ 3. The Casnati–Ekedahl structure theorem ‣ Tautological classes on Low-degree Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, <math id="S3.SS4.p1.m14" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> has relative degree <math id="S3.SS4.p1.m15" class="ltx_Math" alttext="g+k-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g+k-1</annotation></semantics></math> on the fibers of <math id="S3.SS4.p1.m16" class="ltx_Math" alttext="\mathcal{P}\to\mathcal{H}_{k,g}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{P}\to\mathcal{H}_{k,g}</annotation></semantics></math>, so <math id="S3.SS4.p1.m17" class="ltx_Math" alttext="a_{1}^{\prime}=g+k-1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>1</mn><mo>′</mo></msubsup><mo>=</mo><mrow><mrow><mi>g</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">a_{1}^{\prime}=g+k-1</annotation></semantics></math>.
By the Casnati–Ekedahl structure theorem, the universal curve <math id="S3.SS4.p1.m18" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> embeds in <math id="S3.SS4.p1.m19" class="ltx_Math" alttext="\mathbb{P}\mathcal{E}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow><annotation encoding="application/x-tex">\mathbb{P}\mathcal{E}^{\vee}</annotation></semantics></math>. We have the associated Casnati–Ekedahl resolution</p>
<table id="S3.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex18.m1" class="ltx_Math" alttext="0\rightarrow\gamma^{*}\mathcal{F}_{k-2}(-k)\rightarrow\gamma^{*}\mathcal{F}_{k-3}(-k+2)\rightarrow\cdots\rightarrow\gamma^{*}\mathcal{F}_{1}(-2)\rightarrow\mathcal{O}_{\mathbb{P}\mathcal{E}^{\vee}}\rightarrow\mathcal{O}_{\mathcal{C}}\rightarrow 0." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo stretchy="false">→</mo><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em" stretchy="false">→</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em" stretchy="false">→</mo><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\rightarrow\gamma^{*}\mathcal{F}_{k-2}(-k)\rightarrow\gamma^{*}\mathcal{F}_{k-3}(-k+2)\rightarrow\cdots\rightarrow\gamma^{*}\mathcal{F}_{1}(-2)\rightarrow\mathcal{O}_{\mathbb{P}\mathcal{E}^{\vee}}\rightarrow\mathcal{O}_{\mathcal{C}}\rightarrow 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p1.4" class="ltx_p">For each bundle <math id="S3.SS4.p1.m20" class="ltx_Math" alttext="\mathcal{F}_{j}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{j}</annotation></semantics></math>, we define</p>
<table id="S3.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex19.m1" class="ltx_math_unparsed" alttext="f_{j,i}:=\pi_{*}(z\cdot c_{i}(\mathcal{F}_{j})),\quad f_{j,i}^{\prime}:=\pi_{*}(c_{i}(\mathcal{F}_{j}))\qquad\Rightarrow\qquad c_{i}(\mathcal{F}_{j})=\pi^{*}f_{j,i}+\pi^{*}f_{j,i}^{\prime}z." display="block" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>:=</mo><msub><mi>π</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>c</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><msubsup><mi>f</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo>:=</mo><msub><mi>π</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">⇒</mo><msub><mi>c</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>π</mi><mo>∗</mo></msup><msub><mi>f</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msup><mi>π</mi><mo>∗</mo></msup><msubsup><mi>f</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mi>z</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{j,i}:=\pi_{*}(z\cdot c_{i}(\mathcal{F}_{j})),\quad f_{j,i}^{\prime}:=\pi_{*}(c_{i}(\mathcal{F}_{j}))\qquad\Rightarrow\qquad c_{i}(\mathcal{F}_{j})=\pi^{*}f_{j,i}+\pi^{*}f_{j,i}^{\prime}z.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.Thmthm9" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm9.2" class="ltx_text ltx_font_bold">Definition 3.9</span></span><span id="S3.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm9.p1" class="ltx_para">
<p id="S3.Thmthm9.p1.1" class="ltx_p">We define <math id="S3.Thmthm9.p1.m1" class="ltx_Math" alttext="c_{2},a_{i},a_{i}^{\prime},f_{j,i},f_{j,i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>,</mo><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mo>′</mo></msubsup><mo>,</mo><msub><mi>f</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>f</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">c_{2},a_{i},a_{i}^{\prime},f_{j,i},f_{j,i}^{\prime}</annotation></semantics></math> to be the <em id="S3.Thmthm9.p1.1.1" class="ltx_emph ltx_font_italic">Casnati–Ekedahl classes</em>, abbreviated CE classes.</p>
</div>
</div>
<div id="S3.Thmthm10" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm10.2" class="ltx_text ltx_font_bold">Theorem 3.10</span></span><span id="S3.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm10.p1" class="ltx_para">
<p id="S3.Thmthm10.p1.1" class="ltx_p"><span id="S3.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">The CE classes are tautological and they generate the tautological ring <math id="S3.Thmthm10.p1.m1" class="ltx_Math" alttext="R^{*}(\mathcal{H}_{k,g})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{*}(\mathcal{H}_{k,g})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.Thmthm11" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm11.2" class="ltx_text ltx_font_bold">Remark 3.11</span></span><span id="S3.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm11.p1" class="ltx_para">
<p id="S3.Thmthm11.p1.1" class="ltx_p">The ranks of the <math id="S3.Thmthm11.p1.m1" class="ltx_Math" alttext="\mathcal{F}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{i}</annotation></semantics></math> depend only on <math id="S3.Thmthm11.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="S3.Thmthm11.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, so this bounds the number of generators of <math id="S3.Thmthm11.p1.m4" class="ltx_Math" alttext="R^{*}(\mathcal{H}_{k,g})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{*}(\mathcal{H}_{k,g})</annotation></semantics></math> and their degrees in terms of <math id="S3.Thmthm11.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> (independent of <math id="S3.Thmthm11.p1.m6" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>).</p>
</div>
</div>
<div id="S3.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS4.p2" class="ltx_para">
<p id="S3.SS4.p2.1" class="ltx_p"><span id="S3.SS4.p2.1.1" class="ltx_text">First, we show that the Casnati–Ekedahl classes are tautological.
Let us call a class on <math id="S3.SS4.p2.m1" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> <em id="S3.SS4.p2.1.1.1" class="ltx_emph ltx_font_italic">pre-tautological</em> if it is a polynomial in <math id="S3.SS4.p2.m2" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> and classes of the form <math id="S3.SS4.p2.m3" class="ltx_Math" alttext="\alpha_{*}(c_{1}(\omega_{f})^{j})" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow><mi>j</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{*}(c_{1}(\omega_{f})^{j})</annotation></semantics></math>. By the push-pull formula, the <math id="S3.SS4.p2.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> pushforward of a pre-tautological class is tautological. Therefore, our goal is to show that the Chern classes of <math id="S3.SS4.p2.m5" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> and <math id="S3.SS4.p2.m6" class="ltx_Math" alttext="\mathcal{F}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{i}</annotation></semantics></math> are pre-tautological.</span></p>
</div>
<div id="S3.SS4.p3" class="ltx_para">
<p id="S3.SS4.p3.1" class="ltx_p"><span id="S3.SS4.p3.1.1" class="ltx_text">By Grothendieck–Riemann–Roch and the splitting principle, we have that the Chern classes of <math id="S3.SS4.p3.m1" class="ltx_Math" alttext="\alpha_{*}(\omega_{\alpha}^{\otimes i})=\alpha_{*}(\omega_{f}^{\otimes i})\otimes(\omega_{\pi}^{\vee})^{\otimes i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ω</mi><mi>α</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>i</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ω</mi><mi>f</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>i</mi></mrow></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>ω</mi><mi>π</mi><mo>∨</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>i</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha_{*}(\omega_{\alpha}^{\otimes i})=\alpha_{*}(\omega_{f}^{\otimes i})\otimes(\omega_{\pi}^{\vee})^{\otimes i}</annotation></semantics></math> are pre-tautological. In particular, the Chern classes of <math id="S3.SS4.p3.m2" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> are pre-tautological by its defining exact sequence. By the construction of the Casnati–Ekedahl sequence, <math id="S3.SS4.p3.m3" class="ltx_Math" alttext="\mathcal{F}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{F}_{1}</annotation></semantics></math> is the kernel of a surjective map <math id="S3.SS4.p3.m4" class="ltx_Math" alttext="\Sym^{2}\mathcal{E}\twoheadrightarrow\alpha_{*}(\omega_{\alpha}^{\otimes 2})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>Sym</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">↠</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ω</mi><mi>α</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Sym^{2}\mathcal{E}\twoheadrightarrow\alpha_{*}(\omega_{\alpha}^{\otimes 2})</annotation></semantics></math>, so the Chern classes of <math id="S3.SS4.p3.m5" class="ltx_Math" alttext="\mathcal{F}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{F}_{1}</annotation></semantics></math> are pre-tautological. Similarly, following the construction of <math id="S3.SS4.p3.m6" class="ltx_Math" alttext="\mathcal{F}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{i}</annotation></semantics></math> on <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>, p. 445-446]</cite> and using the splitting principle, we inductively see that the Chern classes of all <math id="S3.SS4.p3.m7" class="ltx_Math" alttext="\mathcal{F}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{i}</annotation></semantics></math> are pre-tautological.</span></p>
</div>
<div id="S3.SS4.p4" class="ltx_para">
<p id="S3.SS4.p4.1" class="ltx_p"><span id="S3.SS4.p4.1.1" class="ltx_text">Next, we must show that all tautological classes are polynomials in Casnati–Ekedahl classes.
We have a diagram</span></p>
<table id="S3.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.20)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.E20.m1.pic1" class="ltx_picture ltx_markedasmath" height="113.47" overflow="visible" style="vertical-align:-56.73px" version="1.1" viewBox="0 0 121.69 113.47" width="121.69"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,113.47) matrix(1 0 0 -1 0 0) translate(60.85,0) translate(0,56.74)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -60.84 -47.71)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 113.47)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.47)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(17.87,0) matrix(1.0 0.0 0.0 1.0 -11.92 0)"><foreignObject style="--ltx-fo-width:0.72em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E20.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{C}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{C}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 35.75 0) translate(59.58,0) matrix(1.0 0.0 0.0 1.0 -20.41 0)"><foreignObject style="--ltx-fo-width:1.95em;--ltx-fo-height:0.75em;--ltx-fo-depth:0em;font-size:10pt;" height="10.4" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="26.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E20.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathbb{P}\mathcal{E}^{\vee}}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathbb{P}\mathcal{E}^{\vee}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 59.96)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 44.53 0) translate(50.79,0) matrix(1.0 0.0 0.0 1.0 -11.63 0)"><foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E20.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{P}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 104.45)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 36.2 0) translate(59.12,0) matrix(1.0 0.0 0.0 1.0 -19.95 0)"><foreignObject style="--ltx-fo-width:1.88em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="26.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E20.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{H}_{k,g}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{H}_{k,g}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -27.66 35.93 L 16.14 10.77"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.86708 -0.49815 0.49815 0.86708 16.38 10.63)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -15.97 15.78)"><foreignObject style="--ltx-fo-width:0.52em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="7.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E20.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\alpha}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">α</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\alpha}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -41.26 35.93 C -38.39 2.07 -22.46 -20.82 7.79 -35.03"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.9051 -0.4252 0.4252 0.9051 8.04 -35.15)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -36.68 -16.93)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E20.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces f}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">f</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces f}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -24.82 44.73 L 7.28 44.73"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 7.56 44.73)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -10.54 47.98)"><foreignObject style="--ltx-fo-width:0.3em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="4.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E20.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\iota}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">ι</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\iota}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 34.48 35.93 L 34.48 12.13"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 34.48 11.85)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 37.73 22.61)"><foreignObject style="--ltx-fo-width:0.42em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E20.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\gamma}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">γ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\gamma}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 34.48 -8.56 L 34.48 -32.36"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 34.48 -32.64)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 37.73 -22.82)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="6.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E20.m1.pic1.m9" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\pi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">π</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\pi}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p4.2" class="ltx_p"><span id="S3.SS4.p4.2.1" class="ltx_text">First, note that</span></p>
<table id="S3.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex20.m1" class="ltx_Math" alttext="f_{*}(c_{1}(\omega_{f})^{i}\cdot\alpha^{*}(\omega_{\pi})^{j})=\pi_{*}(\alpha_{*}(c_{1}(\omega_{\alpha})+\alpha^{*}c_{1}(\omega_{\pi}))^{i}\cdot c_{1}(\omega_{\pi})^{j})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>f</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow><mo rspace="0.222em">⋅</mo><msup><mi>α</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow><mi>j</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>α</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow><mo rspace="0.222em">⋅</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow><mi>j</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{*}(c_{1}(\omega_{f})^{i}\cdot\alpha^{*}(\omega_{\pi})^{j})=\pi_{*}(\alpha_{*}(c_{1}(\omega_{\alpha})+\alpha^{*}c_{1}(\omega_{\pi}))^{i}\cdot c_{1}(\omega_{\pi})^{j}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p4.3" class="ltx_p"><span id="S3.SS4.p4.3.1" class="ltx_text">so using push-pull, it will suffice to show that
<math id="S3.SS4.p4.m1" class="ltx_Math" alttext="\pi_{*}(\alpha_{*}(c_{1}(\omega_{\alpha})^{i})\cdot z^{j})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>z</mi><mi>j</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{*}(\alpha_{*}(c_{1}(\omega_{\alpha})^{i})\cdot z^{j})</annotation></semantics></math> is a polynomial in CE classes for all pairs <math id="S3.SS4.p4.m2" class="ltx_Math" alttext="i,j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i,j</annotation></semantics></math>.
Now, let <math id="S3.SS4.p4.m3" class="ltx_Math" alttext="\zeta:=c_{1}(\mathcal{O}_{\mathbb{P}\mathcal{E}^{\vee}}(1))" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>:=</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta:=c_{1}(\mathcal{O}_{\mathbb{P}\mathcal{E}^{\vee}}(1))</annotation></semantics></math> and note that <math id="S3.SS4.p4.m4" class="ltx_Math" alttext="\iota^{*}\zeta=c_{1}(\omega_{\alpha})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ι</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>=</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota^{*}\zeta=c_{1}(\omega_{\alpha})</annotation></semantics></math>. We have</span></p>
<table id="S3.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex21.m1" class="ltx_Math" alttext="\displaystyle\alpha_{*}(c_{1}(\omega_{\alpha})^{i})=\gamma_{*}\iota_{*}(\iota^{*}\zeta^{i})=\gamma_{*}([\mathcal{C}]\cdot\zeta^{i})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>γ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ι</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ζ</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>γ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">[</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mi>ζ</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{*}(c_{1}(\omega_{\alpha})^{i})=\gamma_{*}\iota_{*}(\iota^{*}\zeta^{i})=\gamma_{*}([\mathcal{C}]\cdot\zeta^{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p4.4" class="ltx_p"><span id="S3.SS4.p4.4.1" class="ltx_text">Grothendieck–Riemann–Roch for <math id="S3.SS4.p4.m5" class="ltx_Math" alttext="\iota:\mathcal{C}\hookrightarrow\mathbb{P}\mathcal{E}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">↪</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota:\mathcal{C}\hookrightarrow\mathbb{P}\mathcal{E}^{\vee}</annotation></semantics></math> tells us that <math id="S3.SS4.p4.m6" class="ltx_Math" alttext="[\mathcal{C}]=\ch_{k-2}(\iota_{*}\mathcal{O}_{\mathcal{C}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><msub><mi>ch</mi><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ι</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[\mathcal{C}]=\ch_{k-2}(\iota_{*}\mathcal{O}_{\mathcal{C}})</annotation></semantics></math>.
By additivity of Chern characters in exact sequences,
the later is a polynomial in <math id="S3.SS4.p4.m7" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> and the Chern classes of <math id="S3.SS4.p4.m8" class="ltx_Math" alttext="\mathcal{F}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{i}</annotation></semantics></math>.
Using the projective bundle theorem (<a href="#S2.E1" title="In 2.1. Projective bundles ‣ 2. Notation and conventions ‣ Tautological classes on Low-degree Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>), <math id="S3.SS4.p4.m9" class="ltx_Math" alttext="\gamma_{*}([\mathcal{C}]\cdot\zeta^{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">[</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mi>ζ</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{*}([\mathcal{C}]\cdot\zeta^{i})</annotation></semantics></math> is therefore a polynomial in
the Chern classes of <math id="S3.SS4.p4.m10" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> and the <math id="S3.SS4.p4.m11" class="ltx_Math" alttext="\mathcal{F}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{i}</annotation></semantics></math>.
The <math id="S3.SS4.p4.m12" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> push forward of such a polynomial times any power of <math id="S3.SS4.p4.m13" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> is a polynomial in the CE classes (essentially from the definition of the CE classes).
∎</span></p>
</div>
</div>
<div id="S3.SS4.p5" class="ltx_para">
<p id="S3.SS4.p5.1" class="ltx_p">Using the idea in the proof above, we explain how to rewrite the <math id="S3.SS4.p5.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-classes in terms of CE classes.</p>
</div>
<div id="S3.Thmthm12" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm12.2" class="ltx_text ltx_font_bold">Example 3.12</span></span><span id="S3.Thmthm12.3" class="ltx_text ltx_font_bold"> </span>(<math id="S3.Thmthm12.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-classes)<span id="S3.Thmthm12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm12.p1" class="ltx_para">
<p id="S3.Thmthm12.p1.1" class="ltx_p">Let us retain notation as in (<a href="#S3.E20" title="In Proof. ‣ 3.4. Casnati–Ekedahl classes ‣ 3. The Casnati–Ekedahl structure theorem ‣ Tautological classes on Low-degree Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.20</span></a>).
Writing <math id="S3.Thmthm12.p1.m1" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> for the hyperplane class of <math id="S3.Thmthm12.p1.m2" class="ltx_Math" alttext="\mathbb{P}\mathcal{E}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow><annotation encoding="application/x-tex">\mathbb{P}\mathcal{E}^{\vee}</annotation></semantics></math> and <math id="S3.Thmthm12.p1.m3" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> for the hyperplane class on <math id="S3.Thmthm12.p1.m4" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>, we have</p>
<table id="S3.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex22.m1" class="ltx_Math" alttext="c_{1}(\omega_{f})=c_{1}(\omega_{\alpha})+c_{1}(\omega_{\pi})=\iota^{*}(\zeta-2z)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>ι</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c_{1}(\omega_{f})=c_{1}(\omega_{\alpha})+c_{1}(\omega_{\pi})=\iota^{*}(\zeta-2z).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm12.p1.2" class="ltx_p">By the push-pull formula, we have</p>
<table id="S3.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.21)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E21.m1" class="ltx_Math" alttext="\kappa_{i}=f_{*}(c_{1}(\omega_{f})^{i+1})=\pi_{*}\gamma_{*}\iota_{*}(\iota^{*}(\zeta-2z)^{i+1})=\pi_{*}\gamma_{*}([\mathcal{C}]\cdot(\zeta-2z)^{i+1})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>κ</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ι</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">[</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\kappa_{i}=f_{*}(c_{1}(\omega_{f})^{i+1})=\pi_{*}\gamma_{*}\iota_{*}(\iota^{*}(\zeta-2z)^{i+1})=\pi_{*}\gamma_{*}([\mathcal{C}]\cdot(\zeta-2z)^{i+1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm12.p1.3" class="ltx_p">Meanwhile, the fundamental class of <math id="S3.Thmthm12.p1.m5" class="ltx_Math" alttext="\mathcal{C}\subset\mathbb{P}\mathcal{E}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⊂</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}\subset\mathbb{P}\mathcal{E}^{\vee}</annotation></semantics></math> is</p>
<table id="S3.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.22)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E22.m1" class="ltx_Math" alttext="\displaystyle[\mathcal{C}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle[\mathcal{C}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E22.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{k-3}(-1)^{i-1}\ch_{k-2}(\mathcal{F}_{i}(-i-1))+(-1)^{k-2}\ch_{k-2}(\mathcal{F}_{k-2}(-k))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>3</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>ch</mi><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>ch</mi><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{k-3}(-1)^{i-1}\ch_{k-2}(\mathcal{F}_{i}(-i-1))+(-1)^{k-2}\ch_{k-2}(\mathcal{F}_{k-2}(-k))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex23.m1" class="ltx_Math" alttext="\displaystyle=\begin{cases}-\ch_{1}(\det\mathcal{E}(-3))=c_{1}(\det\mathcal{E}^{\vee}(3))&amp;\text{if $k=3$}\\
-\ch_{2}(\mathcal{F}(-2))+\ch_{2}(\det\mathcal{E}(-4))=c_{2}(\mathcal{F}^{\vee}(2))&amp;\text{if $k=4$}\\
-\ch_{3}(\mathcal{F}(-2))+\ch_{3}((\mathcal{F}^{\vee}\otimes\det\mathcal{E})(-3))-\ch_{3}(\det\mathcal{E}(-5))&amp;\text{if $k=5$.}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mrow><msub><mi>ch</mi><mn>1</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">det</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">det</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mi>k</mi><mo>=</mo><mn>3</mn></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi>ch</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>ch</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">det</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mi>k</mi><mo>=</mo><mn>4</mn></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi>ch</mi><mn>3</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>ch</mi><mn>3</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" rspace="0.167em">det</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>ch</mi><mn>3</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">det</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>5</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mi>k</mi><mo>=</mo><mn>5</mn></mrow><mtext>.</mtext></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}-\ch_{1}(\det\mathcal{E}(-3))=c_{1}(\det\mathcal{E}^{\vee}(3))&amp;\text{if $k=3$}\\
-\ch_{2}(\mathcal{F}(-2))+\ch_{2}(\det\mathcal{E}(-4))=c_{2}(\mathcal{F}^{\vee}(2))&amp;\text{if $k=4$}\\
-\ch_{3}(\mathcal{F}(-2))+\ch_{3}((\mathcal{F}^{\vee}\otimes\det\mathcal{E})(-3))-\ch_{3}(\det\mathcal{E}(-5))&amp;\text{if $k=5$.}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm12.p1.4" class="ltx_p">Using (<a href="#S3.E21" title="In Example 3.12 (
            
              κ
            
          -classes). ‣ 3.4. Casnati–Ekedahl classes ‣ 3. The Casnati–Ekedahl structure theorem ‣ Tautological classes on Low-degree Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.21</span></a>) and (<a href="#S3.E22" title="In Example 3.12 (
            
              κ
            
          -classes). ‣ 3.4. Casnati–Ekedahl classes ‣ 3. The Casnati–Ekedahl structure theorem ‣ Tautological classes on Low-degree Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.22</span></a>), it is straightforward to compute <math id="S3.Thmthm12.p1.m6" class="ltx_Math" alttext="\kappa_{i}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\kappa_{i}</annotation></semantics></math> in terms of the CE classes using a computer.</p>
</div>
</div>
<div id="S3.SS4.p6" class="ltx_para">
<p id="S3.SS4.p6.1" class="ltx_p">In degree <math id="S3.SS4.p6.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, the CE classes are <math id="S3.SS4.p6.m2" class="ltx_Math" alttext="c_{2},a_{1},a_{2},a_{2}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo>,</mo><msubsup><mi>a</mi><mn>2</mn><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">c_{2},a_{1},a_{2},a_{2}^{\prime}</annotation></semantics></math>. In degrees <math id="S3.SS4.p6.m3" class="ltx_Math" alttext="k=4,5" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>4</mn></mrow><mo>,</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k=4,5</annotation></semantics></math>, self-duality of the Casnati–Ekedahl resolution implies that all CE classes are expressible in terms of <math id="S3.SS4.p6.m4" class="ltx_Math" alttext="c_{2}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>2</mn></msub><annotation encoding="application/x-tex">c_{2}</annotation></semantics></math> the <math id="S3.SS4.p6.m5" class="ltx_Math" alttext="a_{i},a_{i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">a_{i},a_{i}^{\prime}</annotation></semantics></math> and the <math id="S3.SS4.p6.m6" class="ltx_Math" alttext="b_{i}:=f_{1,i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>:=</mo><msub><mi>f</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">b_{i}:=f_{1,i}</annotation></semantics></math> and <math id="S3.SS4.p6.m7" class="ltx_Math" alttext="b_{i}^{\prime}:=f_{1,i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mi>i</mi><mo>′</mo></msubsup><mo>:=</mo><msubsup><mi>f</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">b_{i}^{\prime}:=f_{1,i}^{\prime}</annotation></semantics></math>.
These classes are all pulled back from a moduli space <math id="S3.SS4.p6.m8" class="ltx_Math" alttext="\mathcal{B}_{k,g}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{B}_{k,g}</annotation></semantics></math> of (pairs of) vector bundles on <math id="S3.SS4.p6.m9" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>, which we shall construct in the next section.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Pairs of vector bundles on <math id="S4.m1" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>-bundles</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">By the results of Casnati–Ekedahl and Casnati in the previous section, there is a correspondence between covers of <math id="S4.p1.m1" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math> and certain linear algebraic data. In this section, following ideas of Bolognesi–Vistoli <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">2</a>]</cite>, we construct moduli stacks parametrizing the associated linear algebraic data and describe the Chow rings of these stacks.
In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">2</a>]</cite>, Bolognesi–Vistoli gave a quotient stack presentation for the moduli stack parametrizing globally generated vector bundles on <math id="S4.p1.m2" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>-fibrations. As explained in Section <a href="#S2.SS3" title="2.3. The Hurwitz space ‣ 2. Notation and conventions ‣ Tautological classes on Low-degree Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a>,
we will instead make use of <math id="S4.p1.m3" class="ltx_Math" alttext="\SL_{2}" display="inline" intent=":literal"><semantics><msub><mi>SL</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\SL_{2}</annotation></semantics></math> quotients, since they have the same rational Chow ring as the <math id="S4.p1.m4" class="ltx_Math" alttext="\PGL_{2}" display="inline" intent=":literal"><semantics><msub><mi>PGL</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\PGL_{2}</annotation></semantics></math> quotient.</p>
</div>
<div id="S4.Thmthm1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm1.2" class="ltx_text ltx_font_bold">Definition 4.1</span></span><span id="S4.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm1.p1" class="ltx_para">
<p id="S4.Thmthm1.p1.1" class="ltx_p">Let <math id="S4.Thmthm1.p1.m1" class="ltx_Math" alttext="r,d" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">r,d</annotation></semantics></math> be nonnegative integers.</p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p">The objects of <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="\mathcal{V}_{r,d}^{\dagger}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mi>r</mi><mo>,</mo><mi>d</mi></mrow><mo>†</mo></msubsup><annotation encoding="application/x-tex">\mathcal{V}_{r,d}^{\dagger}</annotation></semantics></math> are pairs <math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="(S,E)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,E)</annotation></semantics></math> where <math id="S4.I1.i1.p1.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> is a locally free sheaf of rank <math id="S4.I1.i1.p1.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> on <math id="S4.I1.i1.p1.m5" class="ltx_Math" alttext="\mathbb{P}^{1}\times S" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\mathbb{P}^{1}\times S</annotation></semantics></math> whose restriction to each of the fibers of <math id="S4.I1.i1.p1.m6" class="ltx_Math" alttext="\mathbb{P}^{1}\times S\rightarrow S" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></mrow><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\mathbb{P}^{1}\times S\rightarrow S</annotation></semantics></math> is globally generated of degree <math id="S4.I1.i1.p1.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. A morphism between objects <math id="S4.I1.i1.p1.m8" class="ltx_Math" alttext="(S,E)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,E)</annotation></semantics></math> and <math id="S4.I1.i1.p1.m9" class="ltx_Math" alttext="(S^{\prime},E^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mo>′</mo></msup><mo>,</mo><msup><mi>E</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S^{\prime},E^{\prime})</annotation></semantics></math> is a Cartesian diagram</p>
<table id="S4.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S4.Ex1.m1.pic1" class="ltx_picture ltx_markedasmath" height="67.98" overflow="visible" style="vertical-align:-33.99px" version="1.1" viewBox="0 0 166.08 67.98" width="166.08"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,67.98) matrix(1 0 0 -1 0 0) translate(83.04,0) translate(0,33.99)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -83.04 -28.93)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 67.98)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.33)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(34.19,0) matrix(1.0 0.0 0.0 1.0 -28.23 0)"><foreignObject style="--ltx-fo-width:3.08em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.08em;font-size:10pt;" height="12.42" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="42.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex1.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathbb{P}^{1}\times S^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathbb{P}^{1}\times S^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 68.38 0) translate(65.46,0) matrix(1.0 0.0 0.0 1.0 -26.29 0)"><foreignObject style="--ltx-fo-width:2.8em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.08em;font-size:10pt;" height="12.42" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="38.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex1.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathbb{P}^{1}\times S}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathbb{P}^{1}\times S}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 62.92)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 14.73 0) translate(19.46,0) matrix(1.0 0.0 0.0 1.0 -13.5 0)"><foreignObject style="--ltx-fo-width:0.95em;--ltx-fo-height:0.75em;--ltx-fo-depth:0em;font-size:10pt;" height="10.4" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="13.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex1.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces S^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces S^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 83.11 0) translate(50.73,0) matrix(1.0 0.0 0.0 1.0 -11.56 0)"><foreignObject style="--ltx-fo-width:0.67em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex1.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces S}" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces S}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -48.85 11.17 L -48.85 -12.63"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -48.85 -12.91)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -14.39 21.12 L 17.72 21.12"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 17.99 21.12)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.31 24.38)"><foreignObject style="--ltx-fo-width:0.61em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:10pt;" height="6.62" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="8.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex1.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces F}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">F</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces F}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 50.79 11.17 L 50.79 -13.58"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 50.79 -13.85)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -29.12 -25.47 L 32.45 -25.47"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 32.72 -25.47)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
