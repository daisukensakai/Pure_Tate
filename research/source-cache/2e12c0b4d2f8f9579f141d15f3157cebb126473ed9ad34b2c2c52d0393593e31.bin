rray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 81.38 -12.28)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -147.36 -25.71 L -115.26 -25.71"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -114.98 -25.71)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -83.53 -25.71 L -51.43 -25.71"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -51.15 -25.71)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -73.56 -20.57)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS2.p6.pic1.m14" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">η</mi><mi mathsize="0.710em">α</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 15.41 -25.71 L 55.26 -25.71"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 55.53 -25.71)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 106.96 -25.71 L 146.81 -25.71"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 147.08 -25.71)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span>
<p id="S3.SS2.p6.7" class="ltx_p"><span id="S3.SS2.p6.7.1" class="ltx_text">where the left vertical map is induced by the universal property of kernel.
Note that for any <math id="S3.SS2.p6.m18" class="ltx_Math" alttext="t\in\mathcal{O}_{S}^{\times}(S)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi><mo>×</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\in\mathcal{O}_{S}^{\times}(S)</annotation></semantics></math>, the diagram</span></p>
<table id="S3.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.12)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
