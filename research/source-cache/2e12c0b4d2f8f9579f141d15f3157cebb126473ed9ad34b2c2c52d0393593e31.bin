ject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="18.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic2.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces E_{\alpha}^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><mi>α</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces E_{\alpha}^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 44.65 0) translate(65.08,0) matrix(1.0 0.0 0.0 1.0 -25.91 0)"><foreignObject style="--ltx-fo-width:2.74em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.15em;font-size:10pt;" height="13.34" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="37.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic2.m4" class="ltx_math_unparsed" alttext="{\lx@inpgf@ignorespaces\wedge^{2}F_{\alpha}.}" display="inline" intent=":literal"><semantics><mrow><mo>∧</mo><msup><mrow></mrow><mn>2</mn></msup><mi>F</mi><msub><mrow></mrow><mi>α</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\wedge^{2}F_{\alpha}.}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -48.47 13.21 L -48.47 -11.45"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -48.47 -11.72)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -142.57 -2.5)"><foreignObject style="--ltx-fo-width:6.57em;--ltx-fo-height:0.62em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.06" overflow="visible" transform="matrix(1 0 0 -1 0 8.63)" width="90.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic2.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\det(t\cdot\xi)\otimes((t\cdot\xi)^{-1})^{\vee}}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.700em" rspace="0em">det</mo><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">t</mi><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">ξ</mi></mrow><mo maxsize="0.700em" minsize="0.700em" rspace="0.055em">)</mo></mrow><mo mathsize="0.700em" rspace="0.222em">⊗</mo><msup><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msup><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">t</mi><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">ξ</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mrow><mo mathsize="0.710em">−</mo><mn mathsize="0.710em">1</mn></mrow></msup><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.710em">∨</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\det(t\cdot\xi)\otimes((t\cdot\xi)^{-1})^{\vee}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -27.87 22.01 L 12.1 22.01"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 12.37 22.01)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -10.46 27.15)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic2.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\eta}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">η</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\eta}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 38.93 13.21 L 38.93 -10.59"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 38.93 -10.86)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.18 -2.07)"><foreignObject style="--ltx-fo-width:2.62em;--ltx-fo-height:0.62em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.06" overflow="visible" transform="matrix(1 0 0 -1 0 8.63)" width="36.29"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic2.m7" class="ltx_math_unparsed" alttext="\scriptstyle{\lx@inpgf@ignorespaces\wedge^{2}(t\cdot\psi)}" display="inline" intent=":literal"><semantics><mrow><msup><mo mathsize="0.700em">∧</mo><mn mathsize="0.710em">2</mn></msup><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">t</mi><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">ψ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\wedge^{2}(t\cdot\psi)}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -25.87 -24.28 L 6.23 -24.28"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 6.51 -24.28)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -15.9 -19.14)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic2.m8" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">η</mi><mi mathsize="0.710em">α</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
