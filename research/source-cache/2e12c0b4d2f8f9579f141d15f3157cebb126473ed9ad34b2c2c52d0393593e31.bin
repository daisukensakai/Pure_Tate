<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.17)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.E17.m1.pic1" class="ltx_picture ltx_markedasmath" height="69.76" overflow="visible" style="vertical-align:-34.88px" version="1.1" viewBox="0 0 189.63 69.76" width="189.63"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,69.76) matrix(1 0 0 -1 0 0) translate(120.76,0) translate(0,34.88)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -68.87 -27.74)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 69.77)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.33)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 2 0) translate(20.32,0) matrix(1.0 0.0 0.0 1.0 -14.37 0)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.75em;--ltx-fo-depth:0em;font-size:10pt;" height="10.4" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="14.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces E^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>E</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces E^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 48.59 0) translate(59.21,0) matrix(1.0 0.0 0.0 1.0 -20.04 0)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="26.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic1.m2" class="ltx_math_unparsed" alttext="{\lx@inpgf@ignorespaces\wedge^{2}F}" display="inline" intent=":literal"><semantics><mrow><mo>∧</mo><msup><mrow></mrow><mn>2</mn></msup><mi>F</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\wedge^{2}F}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 62.63)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(22.32,0) matrix(1.0 0.0 0.0 1.0 -16.37 0)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="18.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces E_{\alpha}^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><mi>α</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces E_{\alpha}^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 44.65 0) translate(63.15,0) matrix(1.0 0.0 0.0 1.0 -23.99 0)"><foreignObject style="--ltx-fo-width:2.47em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.15em;font-size:10pt;" height="13.34" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="34.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic1.m4" class="ltx_math_unparsed" alttext="{\lx@inpgf@ignorespaces\wedge^{2}F_{\alpha}}" display="inline" intent=":literal"><semantics><mrow><mo>∧</mo><msup><mrow></mrow><mn>2</mn></msup><mi>F</mi><msub><mrow></mrow><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\wedge^{2}F_{\alpha}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -46.55 13.21 L -46.55 -11.45"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -46.55 -11.72)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -117.78 -2.5)"><foreignObject style="--ltx-fo-width:4.91em;--ltx-fo-height:0.62em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.06" overflow="visible" transform="matrix(1 0 0 -1 0 8.63)" width="67.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces t\cdot\det\xi\otimes(\xi^{-1})^{\vee}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.700em">t</mi><mo lspace="0.222em" mathsize="0.700em">⋅</mo><mrow><mo lspace="0.055em" mathsize="0.700em" rspace="0.167em">det</mo><mi mathsize="0.700em">ξ</mi></mrow></mrow><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⊗</mo><msup><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msup><mi mathsize="0.700em">ξ</mi><mrow><mo mathsize="0.710em">−</mo><mn mathsize="0.710em">1</mn></mrow></msup><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.710em">∨</mo></msup></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces t\cdot\det\xi\otimes(\xi^{-1})^{\vee}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -25.95 22.01 L 12.1 22.01"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 12.37 22.01)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -9.5 27.15)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\eta}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">η</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\eta}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 38.93 13.21 L 38.93 -10.59"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 38.93 -10.86)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.18 -2.34)"><foreignObject style="--ltx-fo-width:1.46em;--ltx-fo-height:0.62em;--ltx-fo-depth:0.14em;font-size:10pt;" height="10.52" overflow="visible" transform="matrix(1 0 0 -1 0 8.63)" width="20.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic1.m7" class="ltx_math_unparsed" alttext="\scriptstyle{\lx@inpgf@ignorespaces\wedge^{2}\psi}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.700em">∧</mo><msup><mrow></mrow><mn mathsize="0.710em">2</mn></msup><mi mathsize="0.700em">ψ</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\wedge^{2}\psi}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -23.95 -24.28 L 8.15 -24.28"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 8.43 -24.28)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -13.98 -19.14)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E17.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">η</mi><mi mathsize="0.710em">α</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span><span id="S3.E17.2" class="ltx_text ltx_font_italic">        </span><span class="ltx_inline-block"><svg id="S3.E17.m1.pic2" class="ltx_picture ltx_markedasmath" height="69.76" overflow="visible" style="vertical-align:-34.88px" version="1.1" viewBox="0 0 227.01 69.76" width="227.01"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,69.76) matrix(1 0 0 -1 0 0) translate(145.55,0) translate(0,34.88)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -70.8 -27.74)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 69.77)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 