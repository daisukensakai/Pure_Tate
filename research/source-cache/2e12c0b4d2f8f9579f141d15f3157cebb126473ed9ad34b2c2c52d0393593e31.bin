ces\Sym^{2}E_{\alpha}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -56.39 14.87 L -56.39 -13.43"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -56.39 -13.71)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -79.83 -2.93)"><foreignObject style="--ltx-fo-width:1.46em;--ltx-fo-height:0.62em;--ltx-fo-depth:0.14em;font-size:10pt;" height="10.52" overflow="visible" transform="matrix(1 0 0 -1 0 8.63)" width="20.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E12.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces t^{2}\cdot\psi}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.700em">t</mi><mn mathsize="0.710em">2</mn></msup><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">ψ</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces t^{2}\cdot\psi}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -37.83 23.67 L 2.16 23.67"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 2.44 23.67)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -20.41 28.81)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E12.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\eta}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">η</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\eta}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 38.83 12.18 L 38.83 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 38.83 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.09 -3.39)"><foreignObject style="--ltx-fo-width:3.99em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.17" overflow="visible" transform="matrix(1 0 0 -1 0 9.48)" width="55.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E12.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\Sym^{2}(t\cdot\xi)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Sym</mi><mn mathsize="0.710em">2</mn></msup><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">t</mi><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">⋅</mo><mi mathsize="0.700em">ξ</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\Sym^{2}(t\cdot\xi)}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -33.88 -25.32 L -1.78 -25.32"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -1.5 -25.32)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -23.91 -20.18)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E12.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">η</mi><mi mathsize="0.710em">α</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\eta_{\alpha}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
