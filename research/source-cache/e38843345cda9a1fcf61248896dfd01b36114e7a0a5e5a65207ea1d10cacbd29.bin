<ul id="bib.L1" class="ltx_biblist">
<li id="bib.bib4a" class="ltx_bibitem ltx_bib_article"><span class="ltx_tag ltx_bib_key ltx_role_refnum ltx_tag_bibitem">[1]</span>
<span class="ltx_bibblock"><span class="ltx_text ltx_bib_author">S. Abdulali</span>
</span>
<span class="ltx_bibblock"><span class="ltx_text ltx_bib_title">Filtrations on the cohomology of abelian varieties</span>.
</span>
