</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M 244.69 0 C 244.69 0.76 244.07 1.38 243.31 1.38 C 242.55 1.38 241.93 0.76 241.93 0 C 241.93 -0.76 242.55 -1.38 243.31 -1.38 C 244.07 -1.38 244.69 -0.76 244.69 0 Z M 243.31 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(0.2 0.0 0.0 0.2 241.93 0)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
