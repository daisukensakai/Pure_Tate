</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M 143.11 0 C 143.11 0.76 142.49 1.38 141.73 1.38 C 140.97 1.38 140.36 0.76 140.36 0 C 140.36 -0.76 140.97 -1.38 141.73 -1.38 C 142.49 -1.38 143.11 -0.76 143.11 0 Z M 141.73 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(0.2 0.0 0.0 0.2 140.35 0)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
