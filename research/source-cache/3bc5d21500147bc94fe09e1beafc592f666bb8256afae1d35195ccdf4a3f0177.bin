</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M 1.38 35.43 C 1.38 36.19 0.76 36.81 0 36.81 C -0.76 36.81 -1.38 36.19 -1.38 35.43 C -1.38 34.67 -0.76 34.06 0 34.06 C 0.76 34.06 1.38 34.67 1.38 35.43 Z M 0 35.43"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(0.2 0.0 0.0 0.2 -1.38 35.43)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.Ex48.m1.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:1em;">
<span id="S3.Ex48.m1.pic1.2.1" class="ltx_p"></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M 25 0 C 25 0.76 24.38 1.38 23.62 1.38 C 22.86 1.38 22.24 0.76 22.24 0 C 22.24 -0.76 22.86 -1.38 23.62 -1.38 C 24.38 -1.38 25 -0.76 25 0 Z M 23.62 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(0.2 0.0 0.0 0.2 22.24 0)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.Ex48.m1.pic1.3" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:1em;">
<span id="S3.Ex48.m1.pic1.3.1" class="ltx_p"></span>
