langle n+m+k\rangle}.}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -54.88 -3.66 L -24.77 -3.66"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 1.0 -54.88 -3.66)"><path style="fill:none" d="M 0 2.71 C 0.95 2.71 1.72 2.1 1.72 1.36 C 1.72 0.61 0.95 0 0 0"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -24.49 -3.66)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 71.87 -3.66 L 103.98 -3.66"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 102.26 -3.66)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 104.25 -3.66)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S8.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S8.p7" class="ltx_para">
<p id="S8.p7.1" class="ltx_p"><span id="S8.p7.1.1" class="ltx_text">(of Proposition <a href="#S8.Thmthm4" title="Proposition 8.4. ‣ 8. Twisted commutative algebras and tautological rings ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.4</span></a>.) That the map <math id="S8.p7.m1" class="ltx_Math" alttext="\bigoplus_{n\geq 0}S_{n}^{\bullet}\to\bigoplus_{n\geq 0}\mathrm{CH}^{\bullet}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><msubsup><mi>S</mi><mi>n</mi><mo>∙</mo></msubsup></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msub><mo>⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bigoplus_{n\geq 0}S_{n}^{\bullet}\to\bigoplus_{n\geq 0}\mathrm{CH}^{\bullet}(C_{g}^{n})</annotation></semantics></math> is a homomorphism of twisted commutative algebras is obvious. That the maps <math id="S8.p7.m2" class="ltx_Math" alttext="\pi_{1}^{\times n}\colon\mathrm{CH}^{\bullet}(C_{g}^{n})\to\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\otimes n})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mn>1</mn><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{1}^{\times n}\colon\mathrm{CH}^{\bullet}(C_{g}^{n})\to\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\otimes n})</annotation></semantics></math> are homomorphisms with respect to the cross product is explained in <a href="#S5.SS2.SSS1" title="5.2.1. Cross product ‣ 5.2. Tautological maps ‣ 5. The Künneth decomposition of the tautological ring ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2.1</span></a>. That the maps <math id="S8.p7.m3" class="ltx_Math" alttext="\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\otimes n})\to\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\langle n\rangle})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\otimes n})\to\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\langle n\rangle})</annotation></semantics></math> are homomorphisms with respect to the cross product is also clear, since the multiplication in the twisted commutative algebra <math id="S8.p7.m4" class="ltx_Math" alttext="\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\langle n\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\langle n\rangle})</annotation></semantics></math> was defined by lifting elements to <math id="S8.p7.m5" class="ltx_Math" alttext="\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\otimes n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\otimes n})</annotation></semantics></math>, and using the multiplication in the twisted commutative algebra “upstairs” to multiply.
∎</span></p>
</div>
</div>
<div id="S8.Thmthm5" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S8.Thmthm5.1" class="ltx_text ltx_font_bold">Definition 8.5</span></span><span id="S8.Thmthm5.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S8.Thmthm5.p1" class="ltx_para ltx_noindent">
<p id="S8.Thmthm5.p1.1" class="ltx_p">Let <math id="S8.Thmthm5.p1.m1" class="ltx_Math" alttext="S\to R_{g}\to R_{g}^{\prime}\to R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">→</mo><msub><mi>R</mi><mi>g</mi></msub><mo stretchy="false">→</mo><msubsup><mi>R</mi><mi>g</mi><mo>′</mo></msubsup><mo stretchy="false">→</mo><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup></mrow><annotation encoding="application/x-tex">S\to R_{g}\to R_{g}^{\prime}\to R_{g}^{\prime\prime}</annotation></semantics></math> be the four twisted commutative algebras linked by the chain of surjections</p>
<table id="S8.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex147.m1" class="ltx_Math" alttext="\bigoplus_{n\geq 0}S_{n}^{\bullet}\to\bigoplus_{n\geq 0}R^{\bullet}(C_{g}^{n})\to\bigoplus_{n\geq 0}R^{\bullet}(M_{g},\mathbf{V}^{\otimes n})\to\bigoplus_{n\geq 0}R^{\bullet}(M_{g},\mathbf{V}^{\langle n\rangle})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><msubsup><mi>S</mi><mi>n</mi><mo>∙</mo></msubsup></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigoplus_{n\geq 0}S_{n}^{\bullet}\to\bigoplus_{n\geq 0}R^{\bullet}(C_{g}^{n})\to\bigoplus_{n\geq 0}R^{\bullet}(M_{g},\mathbf{V}^{\otimes n})\to\bigoplus_{n\geq 0}R^{\bullet}(M_{g},\mathbf{V}^{\langle n\rangle}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S8.Thmthm6" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S8.Thmthm6.1" class="ltx_text ltx_font_bold">Proposition 8.6</span></span><span id="S8.Thmthm6.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S8.Thmthm6.p1" class="ltx_para">
<p id="S8.Thmthm6.p1.1" class="ltx_p"><span id="S8.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">The twisted commutative algebra <math id="S8.Thmthm6.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is the free twisted commutative algebra generated by the elements <math id="S8.Thmthm6.p1.m2" class="ltx_Math" alttext="\kappa_{d}\in S^{d}_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>d</mi></msub><mo>∈</mo><msubsup><mi>S</mi><mn>0</mn><mi>d</mi></msubsup></mrow><annotation encoding="application/x-tex">\kappa_{d}\in S^{d}_{0}</annotation></semantics></math> for <math id="S8.Thmthm6.p1.m3" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math>, <math id="S8.Thmthm6.p1.m4" class="ltx_Math" alttext="\psi_{1}^{m}\in S^{m}_{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mn>1</mn><mi>m</mi></msubsup><mo>∈</mo><msubsup><mi>S</mi><mn>1</mn><mi>m</mi></msubsup></mrow><annotation encoding="application/x-tex">\psi_{1}^{m}\in S^{m}_{1}</annotation></semantics></math> for <math id="S8.Thmthm6.p1.m5" class="ltx_Math" alttext="m\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\geq 0</annotation></semantics></math>, and <math id="S8.Thmthm6.p1.m6" class="ltx_Math" alttext="\Delta_{12\ldots n}\psi_{1}^{m}\in S_{n}^{n-1+m}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mn>1</mn><mi>m</mi></msubsup></mrow><mo>∈</mo><msubsup><mi>S</mi><mi>n</mi><mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mi>m</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Delta_{12\ldots n}\psi_{1}^{m}\in S_{n}^{n-1+m}</annotation></semantics></math> for <math id="S8.Thmthm6.p1.m7" class="ltx_Math" alttext="m\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\geq 0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S8.p8" class="ltx_para ltx_noindent">
<p id="S8.p8.1" class="ltx_p"><span id="S8.p8.1.1" class="ltx_text">It is straightforward that every monomial in <math id="S8.p8.m1" class="ltx_Math" alttext="S_{n}^{\bullet}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>n</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">S_{n}^{\bullet}</annotation></semantics></math> can be uniquely reduced modulo the relations of Eq. (<a href="#S5.E5" title="In 5. The Künneth decomposition of the tautological ring ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) to a product</span></p>
<table id="S8.Ex148" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex148.m1" class="ltx_Math" alttext="\prod_{i=1}^{m}\kappa_{d_{i}}\cdot\prod_{j=1}^{k}\Delta_{P_{j}}\psi_{P_{j}}^{e_{j}}" display="block" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>κ</mi><msub><mi>d</mi><mi>i</mi></msub></msub></mrow><mo lspace="0.222em" rspace="0.055em">⋅</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><msub><mi mathvariant="normal">Δ</mi><msub><mi>P</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><msub><mi>P</mi><mi>j</mi></msub><msub><mi>e</mi><mi>j</mi></msub></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{m}\kappa_{d_{i}}\cdot\prod_{j=1}^{k}\Delta_{P_{j}}\psi_{P_{j}}^{e_{j}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p8.2" class="ltx_p"><span id="S8.p8.2.1" class="ltx_text">where <math id="S8.p8.m2" class="ltx_Math" alttext="(d_{1},\ldots,d_{m})\in\mathbf{Z}_{&gt;0}^{m}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>𝐙</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow><mi>m</mi></msubsup></mrow><annotation encoding="application/x-tex">(d_{1},\ldots,d_{m})\in\mathbf{Z}_{&gt;0}^{m}</annotation></semantics></math>, <math id="S8.p8.m3" class="ltx_Math" alttext="(e_{1},\ldots,e_{k})\in\mathbf{Z}_{\geq 0}^{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>𝐙</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mi>k</mi></msubsup></mrow><annotation encoding="application/x-tex">(e_{1},\ldots,e_{k})\in\mathbf{Z}_{\geq 0}^{k}</annotation></semantics></math>, <math id="S8.p8.m4" class="ltx_Math" alttext="P_{1},\ldots,P_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">P_{1},\ldots,P_{k}</annotation></semantics></math> is some partition of the set <math id="S8.p8.m5" class="ltx_Math" alttext="\{1,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\ldots,n\}</annotation></semantics></math> into nonempty blocks, and <math id="S8.p8.m6" class="ltx_Math" alttext="\psi_{P_{j}}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><msub><mi>P</mi><mi>j</mi></msub></msub><annotation encoding="application/x-tex">\psi_{P_{j}}</annotation></semantics></math> denotes <math id="S8.p8.m7" class="ltx_Math" alttext="\psi_{a}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\psi_{a}</annotation></semantics></math> for any <math id="S8.p8.m8" class="ltx_Math" alttext="a\in P_{j}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msub><mi>P</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">a\in P_{j}</annotation></semantics></math> (this is also observed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Jan13</a>, Lemma 5]</cite>). For example, the monomial <math id="S8.p8.m9" class="ltx_Math" alttext="\kappa_{1}^{2}\Delta_{13}\Delta_{14}\psi_{3}^{2}\in S_{4}^{\bullet}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>κ</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>13</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>14</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mn>3</mn><mn>2</mn></msubsup></mrow><mo>∈</mo><msubsup><mi>S</mi><mn>4</mn><mo>∙</mo></msubsup></mrow><annotation encoding="application/x-tex">\kappa_{1}^{2}\Delta_{13}\Delta_{14}\psi_{3}^{2}\in S_{4}^{\bullet}</annotation></semantics></math> would correspond to <math id="S8.p8.m10" class="ltx_Math" alttext="(d_{1},d_{2})=(1,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(d_{1},d_{2})=(1,1)</annotation></semantics></math>, <math id="S8.p8.m11" class="ltx_Math" alttext="P_{1}=\{2\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>2</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P_{1}=\{2\}</annotation></semantics></math>, <math id="S8.p8.m12" class="ltx_Math" alttext="e_{1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e_{1}=0</annotation></semantics></math>, <math id="S8.p8.m13" class="ltx_Math" alttext="P_{2}=\{1,3,4\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>2</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P_{2}=\{1,3,4\}</annotation></semantics></math>, <math id="S8.p8.m14" class="ltx_Math" alttext="e_{2}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">e_{2}=2</annotation></semantics></math>. But such a product is exactly the same as a cross product of the generators for the twisted commutative algebra <math id="S8.p8.m15" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S8.Thmthm7" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S8.Thmthm7.1" class="ltx_text ltx_font_bold">Definition 8.7</span></span><span id="S8.Thmthm7.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S8.Thmthm7.p1" class="ltx_para ltx_noindent">
<p id="S8.Thmthm7.p1.1" class="ltx_p">For <math id="S8.Thmthm7.p1.m1" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math> and <math id="S8.Thmthm7.p1.m2" class="ltx_Math" alttext="r\geq n-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">r\geq n-1</annotation></semantics></math> we put</p>
<table id="S8.Ex149" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex149.m1" class="ltx_Math" alttext="D_{n,r}=\begin{cases}\kappa_{r}&amp;n=0\\
\Delta_{12\ldots n}\psi_{1}^{1-n+r}&amp;n\geq 1.\end{cases}" display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><msub><mi>κ</mi><mi>r</mi></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mn>1</mn><mrow><mrow><mn>1</mn><mo>−</mo><mi>n</mi></mrow><mo>+</mo><mi>r</mi></mrow></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">D_{n,r}=\begin{cases}\kappa_{r}&amp;n=0\\
\Delta_{12\ldots n}\psi_{1}^{1-n+r}&amp;n\geq 1.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.Thmthm7.p1.2" class="ltx_p">Note that <math id="S8.Thmthm7.p1.m3" class="ltx_Math" alttext="D_{1,r}=\psi_{1}^{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo>=</mo><msubsup><mi>ψ</mi><mn>1</mn><mi>r</mi></msubsup></mrow><annotation encoding="application/x-tex">D_{1,r}=\psi_{1}^{r}</annotation></semantics></math>, <math id="S8.Thmthm7.p1.m4" class="ltx_Math" alttext="D_{0,-1}=\kappa_{-1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mn>0</mn><mo rspace="0em">,</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow></mrow></msub><mo>=</mo><msub><mi>κ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D_{0,-1}=\kappa_{-1}=0</annotation></semantics></math>, and <math id="S8.Thmthm7.p1.m5" class="ltx_Math" alttext="D_{0,0}=\kappa_{0}=2g-2" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo>=</mo><msub><mi>κ</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">D_{0,0}=\kappa_{0}=2g-2</annotation></semantics></math>. The previous proposition can be stated in a more compact form in terms of this notation: specifically, that the twisted commutative algebra <math id="S8.Thmthm7.p1.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is freely generated by <math id="S8.Thmthm7.p1.m7" class="ltx_Math" alttext="\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathfrak{S}_{n}</annotation></semantics></math>-invariant classes <math id="S8.Thmthm7.p1.m8" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> placed in arity <math id="S8.Thmthm7.p1.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and degree <math id="S8.Thmthm7.p1.m10" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, where <math id="S8.Thmthm7.p1.m11" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math> and <math id="S8.Thmthm7.p1.m12" class="ltx_Math" alttext="r\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r\geq 1</annotation></semantics></math> or <math id="S8.Thmthm7.p1.m13" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math> and <math id="S8.Thmthm7.p1.m14" class="ltx_Math" alttext="r\geq n-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">r\geq n-1</annotation></semantics></math>.</p>
</div>
</div>
<div id="S8.p9" class="ltx_para ltx_noindent">
<p id="S8.p9.1" class="ltx_p">The fact that the classes <math id="S8.p9.m1" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> generate <math id="S8.p9.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> implies that their images generate the twisted commutative algebras <math id="S8.p9.m3" class="ltx_Math" alttext="R_{g}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>g</mi></msub><annotation encoding="application/x-tex">R_{g}</annotation></semantics></math>, <math id="S8.p9.m4" class="ltx_Math" alttext="R_{g}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>g</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">R_{g}^{\prime}</annotation></semantics></math> and <math id="S8.p9.m5" class="ltx_Math" alttext="R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{g}^{\prime\prime}</annotation></semantics></math>, since the map from <math id="S8.p9.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> to these algebras is surjective.</p>
</div>
<div id="S8.Thmthm8" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S8.Thmthm8.1" class="ltx_text ltx_font_bold">Proposition 8.8</span></span><span id="S8.Thmthm8.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S8.Thmthm8.p1" class="ltx_para ltx_noindent">
<p id="S8.Thmthm8.p1.1" class="ltx_p"><span id="S8.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="S8.Thmthm8.p1.m1" class="ltx_Math" alttext="g\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">g\geq 2</annotation></semantics></math> and consider the surjections <math id="S8.Thmthm8.p1.m2" class="ltx_Math" alttext="R_{g}\to R_{g}^{\prime}\to R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>g</mi></msub><mo stretchy="false">→</mo><msubsup><mi>R</mi><mi>g</mi><mo>′</mo></msubsup><mo stretchy="false">→</mo><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup></mrow><annotation encoding="application/x-tex">R_{g}\to R_{g}^{\prime}\to R_{g}^{\prime\prime}</annotation></semantics></math>. The kernels of these maps are ideals in the respective twisted commutative algebras.</span></p>
<ol id="S8.I2" class="ltx_enumerate">
<li id="S8.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S8.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S8.I2.i1.p1.1" class="ltx_p"><span id="S8.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">The kernel of </span><math id="S8.I2.i1.p1.m1" class="ltx_Math" alttext="R_{g}\to R_{g}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>g</mi></msub><mo stretchy="false">→</mo><msubsup><mi>R</mi><mi>g</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">R_{g}\to R_{g}^{\prime}</annotation></semantics></math><span id="S8.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> is the ideal generated by </span><math id="S8.I2.i1.p1.m2" class="ltx_Math" alttext="1\in\mathrm{CH}^{0}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>∈</mo><mrow><msup><mi>CH</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1\in\mathrm{CH}^{0}(C_{g}^{1})</annotation></semantics></math><span id="S8.I2.i1.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S8.I2.i1.p1.m3" class="ltx_Math" alttext="\psi_{1}\in\mathrm{CH}^{1}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo>∈</mo><mrow><msup><mi>CH</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{1}\in\mathrm{CH}^{1}(C_{g}^{1})</annotation></semantics></math><span id="S8.I2.i1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S8.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S8.I2.i2.p1" class="ltx_para">
<p id="S8.I2.i2.p1.1" class="ltx_p"><span id="S8.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">The kernel of </span><math id="S8.I2.i2.p1.m1" class="ltx_Math" alttext="R_{g}\to R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>g</mi></msub><mo stretchy="false">→</mo><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup></mrow><annotation encoding="application/x-tex">R_{g}\to R_{g}^{\prime\prime}</annotation></semantics></math><span id="S8.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> is the ideal generated by </span><math id="S8.I2.i2.p1.m2" class="ltx_Math" alttext="1\in\mathrm{CH}^{0}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>∈</mo><mrow><msup><mi>CH</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1\in\mathrm{CH}^{0}(C_{g}^{1})</annotation></semantics></math><span id="S8.I2.i2.p1.1.3" class="ltx_text ltx_font_italic">, </span><math id="S8.I2.i2.p1.m3" class="ltx_Math" alttext="\psi_{1}\in\mathrm{CH}^{1}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo>∈</mo><mrow><msup><mi>CH</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{1}\in\mathrm{CH}^{1}(C_{g}^{1})</annotation></semantics></math><span id="S8.I2.i2.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="S8.I2.i2.p1.m4" class="ltx_Math" alttext="\Delta_{12}\in\mathrm{CH}^{1}(C_{g}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo>∈</mo><mrow><msup><mi>CH</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{12}\in\mathrm{CH}^{1}(C_{g}^{2})</annotation></semantics></math><span id="S8.I2.i2.p1.1.5" class="ltx_text ltx_font_italic">. Equivalently, the kernel of </span><math id="S8.I2.i2.p1.m5" class="ltx_Math" alttext="R_{g}^{\prime}\to R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>g</mi><mo>′</mo></msubsup><mo stretchy="false">→</mo><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup></mrow><annotation encoding="application/x-tex">R_{g}^{\prime}\to R_{g}^{\prime\prime}</annotation></semantics></math><span id="S8.I2.i2.p1.1.6" class="ltx_text ltx_font_italic"> is the ideal generated by </span><math id="S8.I2.i2.p1.m6" class="ltx_Math" alttext="\pi_{1}^{\times 2}\Delta_{12}=\Delta_{12}-\frac{1}{2g-2}(\psi_{1}+\psi_{2})+\frac{1}{(2g-2)^{2}}\kappa_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mn>1</mn><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub></mrow><mo>=</mo><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>ψ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{1}^{\times 2}\Delta_{12}=\Delta_{12}-\frac{1}{2g-2}(\psi_{1}+\psi_{2})+\frac{1}{(2g-2)^{2}}\kappa_{1}</annotation></semantics></math><span id="S8.I2.i2.p1.1.7" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S8.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S8.p10" class="ltx_para ltx_noindent">
<p id="S8.p10.1" class="ltx_p"><span id="S8.p10.1.1" class="ltx_text">(1) The kernel of <math id="S8.p10.m1" class="ltx_Math" alttext="\mathrm{CH}^{k}(C_{g}^{n})\to\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\otimes n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>CH</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>CH</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{k}(C_{g}^{n})\to\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\otimes n})</annotation></semantics></math> equals the image of the projectors <math id="S8.p10.m2" class="ltx_Math" alttext="\pi_{i_{1}}\times\ldots\times\pi_{i_{n}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><msub><mi>i</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>π</mi><msub><mi>i</mi><mi>n</mi></msub></msub></mrow><annotation encoding="application/x-tex">\pi_{i_{1}}\times\ldots\times\pi_{i_{n}}</annotation></semantics></math> where <math id="S8.p10.m3" class="ltx_Math" alttext="(i_{1},i_{2},\ldots,i_{n})\neq(1,1,\ldots,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><msub><mi>i</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>i</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo>≠</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(i_{1},i_{2},\ldots,i_{n})\neq(1,1,\ldots,1)</annotation></semantics></math>; equivalently, the image of all projectors</span></p>
<table id="S8.Ex150" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex150.m1" class="ltx_math_unparsed" alttext="\id\times\id\times\ldots\times\pi_{i}\times\ldots\times\id" display="block" intent=":literal"><semantics><mrow><mi>id</mi><mo lspace="0em" rspace="0.222em">×</mo><mi>id</mi><mo lspace="0em" rspace="0.222em">×</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>π</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>id</mi></mrow><annotation encoding="application/x-tex">\id\times\id\times\ldots\times\pi_{i}\times\ldots\times\id</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p10.2" class="ltx_p"><span id="S8.p10.2.1" class="ltx_text">(i.e. all factors except one are given by the identity correspondence, the diagonal), where <math id="S8.p10.m4" class="ltx_Math" alttext="i=0,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=0,2</annotation></semantics></math>. By <math id="S8.p10.m5" class="ltx_Math" alttext="\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathfrak{S}_{n}</annotation></semantics></math>-symmetry, let’s assume that all factors except the first are given by the identity. Let <math id="S8.p10.m6" class="ltx_Math" alttext="\alpha\in\mathrm{CH}^{\bullet}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha\in\mathrm{CH}^{\bullet}(C_{g}^{n})</annotation></semantics></math>. One checks that</span></p>
<table id="S8.Ex151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex151.m1" class="ltx_math_unparsed" alttext="(\pi_{0}\times\id\times\ldots\times\id)\circ\alpha=1\times\alpha^{\prime}-\frac{1}{2(2g-2)^{2}}\kappa_{1}\times 1\times\alpha^{\prime\prime}" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>id</mi><mo lspace="0em" rspace="0.222em">×</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>id</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><mi>α</mi><mo>=</mo><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>α</mi><mo>′</mo></msup><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac><msub><mi>κ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>α</mi><mo>′′</mo></msup></mrow><annotation encoding="application/x-tex">(\pi_{0}\times\id\times\ldots\times\id)\circ\alpha=1\times\alpha^{\prime}-\frac{1}{2(2g-2)^{2}}\kappa_{1}\times 1\times\alpha^{\prime\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p10.3" class="ltx_p"><span id="S8.p10.3.1" class="ltx_text">and</span></p>
<table id="S8.Ex152" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex152.m1" class="ltx_math_unparsed" alttext="(\pi_{2}\times\id\times\ldots\times\id)\circ\alpha=\psi_{1}\times\alpha^{\prime\prime}-\frac{1}{2(2g-2)^{2}}\kappa_{1}\times 1\times\alpha^{\prime\prime}," display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>id</mi><mo lspace="0em" rspace="0.222em">×</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>id</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><mi>α</mi><mo>=</mo><msub><mi>ψ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>α</mi><mo>′′</mo></msup><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac><msub><mi>κ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>α</mi><mo>′′</mo></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">(\pi_{2}\times\id\times\ldots\times\id)\circ\alpha=\psi_{1}\times\alpha^{\prime\prime}-\frac{1}{2(2g-2)^{2}}\kappa_{1}\times 1\times\alpha^{\prime\prime},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p10.4" class="ltx_p"><span id="S8.p10.4.1" class="ltx_text">where <math id="S8.p10.m7" class="ltx_Math" alttext="\alpha^{\prime}=({p}_{23\ldots n})_{\ast}(\psi_{1}\cdot\alpha)" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>′</mo></msup><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mrow><mn>23</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha^{\prime}=({p}_{23\ldots n})_{\ast}(\psi_{1}\cdot\alpha)</annotation></semantics></math> and <math id="S8.p10.m8" class="ltx_Math" alttext="\alpha^{\prime\prime}=({p}_{23\ldots n})_{\ast}(\alpha)" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>′′</mo></msup><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mrow><mn>23</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha^{\prime\prime}=({p}_{23\ldots n})_{\ast}(\alpha)</annotation></semantics></math>. Hence both projectors map all cycles <math id="S8.p10.m9" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> into the ideal generated by <math id="S8.p10.m10" class="ltx_Math" alttext="\psi_{1}\in\mathrm{CH}^{1}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo>∈</mo><mrow><msup><mi>CH</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{1}\in\mathrm{CH}^{1}(C_{g}^{1})</annotation></semantics></math> and <math id="S8.p10.m11" class="ltx_Math" alttext="1\in\mathrm{CH}^{1}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>∈</mo><mrow><msup><mi>CH</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1\in\mathrm{CH}^{1}(C_{g}^{1})</annotation></semantics></math>. Conversely, one checks that <math id="S8.p10.m12" class="ltx_Math" alttext="\pi_{1}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\pi_{1}</annotation></semantics></math> annihilates both <math id="S8.p10.m13" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and <math id="S8.p10.m14" class="ltx_Math" alttext="\psi_{1}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\psi_{1}</annotation></semantics></math>.</span></p>
</div>
<div id="S8.p11" class="ltx_para">
<p id="S8.p11.1" class="ltx_p"><span id="S8.p11.1.1" class="ltx_text">(2) The map <math id="S8.p11.m1" class="ltx_Math" alttext="\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\otimes n})\to\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\langle n\rangle})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>CH</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>CH</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\otimes n})\to\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\langle n\rangle})</annotation></semantics></math> is defined by the projection <math id="S8.p11.m2" class="ltx_Math" alttext="\mathbf{V}^{\otimes n}\to\mathbf{V}^{\langle n\rangle}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{V}^{\otimes n}\to\mathbf{V}^{\langle n\rangle}</annotation></semantics></math>, and the kernel of <math id="S8.p11.m3" class="ltx_Math" alttext="\mathbf{V}^{\otimes n}\to\mathbf{V}^{\langle n\rangle}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{V}^{\otimes n}\to\mathbf{V}^{\langle n\rangle}</annotation></semantics></math> is spanned by the image of all <math id="S8.p11.m4" class="ltx_Math" alttext="\binom{n}{2}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mn>2</mn></mfrac><mo>)</mo></mrow><annotation encoding="application/x-tex">\binom{n}{2}</annotation></semantics></math> maps <math id="S8.p11.m5" class="ltx_Math" alttext="\mathbf{V}^{\otimes(n-2)}\otimes\mathbb{L}\to\mathbf{V}^{\otimes n}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝕃</mi></mrow><mo stretchy="false">→</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{V}^{\otimes(n-2)}\otimes\mathbb{L}\to\mathbf{V}^{\otimes n}</annotation></semantics></math> given by <math id="S8.p11.m6" class="ltx_Math" alttext="(n-2,n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-2,n)</annotation></semantics></math>-Brauer diagrams of the form considered in the second half of Section <a href="#S5.SS3" title="5.3. Decomposition into representations of the symplectic group ‣ 5. The Künneth decomposition of the tautological ring ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a>. But it is clear from the description in Section <a href="#S5.SS3" title="5.3. Decomposition into representations of the symplectic group ‣ 5. The Künneth decomposition of the tautological ring ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a> that an element of <math id="S8.p11.m7" class="ltx_Math" alttext="\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\otimes n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>CH</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\otimes n})</annotation></semantics></math> is in the image of one of the maps <math id="S8.p11.m8" class="ltx_Math" alttext="\mathrm{CH}^{k-1}(M_{g},\mathbf{V}^{\otimes(n-2)})\to\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\otimes n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>CH</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>CH</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{k-1}(M_{g},\mathbf{V}^{\otimes(n-2)})\to\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\otimes n})</annotation></semantics></math> precisely if it can be written in a nontrivial way as a cross product with <math id="S8.p11.m9" class="ltx_Math" alttext="\pi_{1}^{\times 2}\Delta_{12}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mn>1</mn><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub></mrow><annotation encoding="application/x-tex">\pi_{1}^{\times 2}\Delta_{12}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S8.Thmthm9" class="ltx_theorem ltx_theorem_remarkx">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S8.Thmthm9.1" class="ltx_text ltx_font_bold">Remark 8.9</span></span><span id="S8.Thmthm9.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S8.Thmthm9.p1" class="ltx_para">
<p id="S8.Thmthm9.p1.1" class="ltx_p">Let us emphasize that the word “ideal” in the preceding proposition should be understood in the sense of twisted commutative algebras; that is, the smallest twisted commutative submodule containing the given elements. In particular, the ring structures of (say) the individual tautological rings <math id="S8.Thmthm9.p1.m1" class="ltx_Math" alttext="R^{\bullet}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(C_{g}^{n})</annotation></semantics></math> are not what is important.
∎</p>
</div>
</div>
<div id="S8.Thmthm10" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S8.Thmthm10.1" class="ltx_text ltx_font_bold">Corollary 8.10</span></span><span id="S8.Thmthm10.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S8.Thmthm10.p1" class="ltx_para">
<p id="S8.Thmthm10.p1.1" class="ltx_p"><span id="S8.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">The twisted commutative algebra <math id="S8.Thmthm10.p1.m1" class="ltx_Math" alttext="R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{g}^{\prime\prime}</annotation></semantics></math> is generated by the images of the elements <math id="S8.Thmthm10.p1.m2" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> such that <math id="S8.Thmthm10.p1.m3" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math> and <math id="S8.Thmthm10.p1.m4" class="ltx_Math" alttext="r\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r\geq 1</annotation></semantics></math>, or <math id="S8.Thmthm10.p1.m5" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math> and <math id="S8.Thmthm10.p1.m6" class="ltx_Math" alttext="r\geq\max(n-1,2)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r\geq\max(n-1,2)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S8.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S8.p12" class="ltx_para">
<p id="S8.p12.1" class="ltx_p"><span id="S8.p12.1.1" class="ltx_text">We have seen that <math id="S8.p12.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is generated by the classes <math id="S8.p12.m2" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> for <math id="S8.p12.m3" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math> and <math id="S8.p12.m4" class="ltx_Math" alttext="r\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r\geq 1</annotation></semantics></math> or <math id="S8.p12.m5" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math> and <math id="S8.p12.m6" class="ltx_Math" alttext="r\geq n-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">r\geq n-1</annotation></semantics></math>. Since the generators <math id="S8.p12.m7" class="ltx_Math" alttext="D_{1,0}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">D_{1,0}</annotation></semantics></math>, <math id="S8.p12.m8" class="ltx_Math" alttext="D_{1,1}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">D_{1,1}</annotation></semantics></math> and <math id="S8.p12.m9" class="ltx_Math" alttext="D_{2,1}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">D_{2,1}</annotation></semantics></math> go to zero under <math id="S8.p12.m10" class="ltx_Math" alttext="S\to R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">→</mo><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup></mrow><annotation encoding="application/x-tex">S\to R_{g}^{\prime\prime}</annotation></semantics></math> by Proposition <a href="#S8.Thmthm8" title="Proposition 8.8. ‣ 8. Twisted commutative algebras and tautological rings ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.8</span></a>, we deduce that <math id="S8.p12.m11" class="ltx_Math" alttext="R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{g}^{\prime\prime}</annotation></semantics></math> is generated by the images of the remaining generators.
∎</span></p>
</div>
</div>
<div id="S8.Thmthm11" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S8.Thmthm11.1" class="ltx_text ltx_font_bold">Corollary 8.11</span></span><span id="S8.Thmthm11.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S8.Thmthm11.p1" class="ltx_para">
<p id="S8.Thmthm11.p1.1" class="ltx_p"><span id="S8.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">The arity <math id="S8.Thmthm11.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> component <math id="S8.Thmthm11.p1.m2" class="ltx_Math" alttext="R_{g}^{\prime\prime}(n)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{g}^{\prime\prime}(n)</annotation></semantics></math> vanishes in degrees below <math id="S8.Thmthm11.p1.m3" class="ltx_Math" alttext="\frac{2n}{3}" display="inline" intent=":literal"><semantics><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mn>3</mn></mfrac><annotation encoding="application/x-tex">\frac{2n}{3}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S8.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S8.p13" class="ltx_para">
<p id="S8.p13.1" class="ltx_p"><span id="S8.p13.1.1" class="ltx_text">Every generator <math id="S8.p13.m1" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> fulfills this bound, since <math id="S8.p13.m2" class="ltx_Math" alttext="\max(n-1,2)\geq\frac{2n}{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mn>3</mn></mfrac></mrow><annotation encoding="application/x-tex">\max(n-1,2)\geq\frac{2n}{3}</annotation></semantics></math> for all natural numbers <math id="S8.p13.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> (with equality only for <math id="S8.p13.m4" class="ltx_Math" alttext="n=3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n=3</annotation></semantics></math>). Since the bound is linear, and degrees and arities are both additive under cross product, the result follows.
∎</span></p>
</div>
</div>
<div id="S8.Thmthm12" class="ltx_theorem ltx_theorem_remarkx">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S8.Thmthm12.1" class="ltx_text ltx_font_bold">Remark 8.12</span></span><span id="S8.Thmthm12.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S8.Thmthm12.p1" class="ltx_para ltx_noindent">
<p id="S8.Thmthm12.p1.1" class="ltx_p">The cohomology groups of the spaces <math id="S8.Thmthm12.p1.m1" class="ltx_Math" alttext="C_{g}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">C_{g}^{n}</annotation></semantics></math> also form twisted commutative algebras, and so do the cohomology groups of the local systems <math id="S8.Thmthm12.p1.m2" class="ltx_Math" alttext="\mathbb{V}^{\langle n\rangle}" display="inline" intent=":literal"><semantics><msup><mi>𝕍</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><annotation encoding="application/x-tex">\mathbb{V}^{\langle n\rangle}</annotation></semantics></math> on <math id="S8.Thmthm12.p1.m3" class="ltx_Math" alttext="M_{g}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>g</mi></msub><annotation encoding="application/x-tex">M_{g}</annotation></semantics></math>. In particular we have a chain of surjections of twisted commutative algebras in graded vector spaces:</p>
<table id="S8.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex153.m1" class="ltx_Math" alttext="\bigoplus_{n\geq 0}H^{\bullet}(C_{g}^{n},\mathbf{Q})\to\bigoplus_{n\geq 0}H^{\bullet-n}(M_{g},\mathbb{V}^{\otimes n})\to\bigoplus_{\lambda}H^{\bullet-n}(M_{g},\mathbb{V}_{\langle\lambda\rangle})\otimes\sigma_{\lambda^{T}}^{\ast}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msup><mi>H</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msup><mi>H</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0em">∙</mo><mrow><mo lspace="0em">−</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝕍</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mi>λ</mi></munder><mrow><msup><mi>H</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0em">∙</mo><mrow><mo lspace="0em">−</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝕍</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><msup><mi>λ</mi><mi>T</mi></msup><mo>∗</mo></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigoplus_{n\geq 0}H^{\bullet}(C_{g}^{n},\mathbf{Q})\to\bigoplus_{n\geq 0}H^{\bullet-n}(M_{g},\mathbb{V}^{\otimes n})\to\bigoplus_{\lambda}H^{\bullet-n}(M_{g},\mathbb{V}_{\langle\lambda\rangle})\otimes\sigma_{\lambda^{T}}^{\ast}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.Thmthm12.p1.2" class="ltx_p">If we consider <math id="S8.Thmthm12.p1.m4" class="ltx_Math" alttext="\bigoplus_{n\geq 0}\mathrm{CH}^{\bullet}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><msub><mo>⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bigoplus_{n\geq 0}\mathrm{CH}^{\bullet}(C_{g}^{n})</annotation></semantics></math>, <math id="S8.Thmthm12.p1.m5" class="ltx_Math" alttext="\bigoplus_{n\geq 0}\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\otimes n})" display="inline" intent=":literal"><semantics><mrow><msub><mo>⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bigoplus_{n\geq 0}\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}^{\otimes n})</annotation></semantics></math> and <math id="S8.Thmthm12.p1.m6" class="ltx_Math" alttext="\bigoplus_{\lambda}\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}_{\langle\lambda\rangle})\otimes\sigma_{\lambda^{T}}^{\ast}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>⨁</mo><mi>λ</mi></msub><mrow><msup><mi>CH</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><msup><mi>λ</mi><mi>T</mi></msup><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\bigoplus_{\lambda}\mathrm{CH}^{\bullet}(M_{g},\mathbf{V}_{\langle\lambda\rangle})\otimes\sigma_{\lambda^{T}}^{\ast}</annotation></semantics></math> also as twisted commutative algebras in graded vector spaces, but with doubled degrees, then they map compatibly to the cohomological versions of these twisted commutative algebras under the cycle class map. We also get twisted commutative algebras of tautological classes</p>
<table id="S8.Ex154" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex154.m1" class="ltx_Math" alttext="\bigoplus_{n\geq 0}{R\hskip-0.5ptH}^{\bullet}(C_{g}^{n},\mathbf{Q})\to\bigoplus_{n\geq 0}{R\hskip-0.5ptH}^{\bullet-n}(M_{g},\mathbb{V}^{\otimes n})\to\bigoplus_{\lambda}{R\hskip-0.5ptH}^{\bullet-n}(M_{g},\mathbb{V}_{\langle\lambda\rangle})\otimes\sigma_{\lambda^{T}}^{\ast}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0em">∙</mo><mrow><mo lspace="0em">−</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝕍</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mi>λ</mi></munder><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0em">∙</mo><mrow><mo lspace="0em">−</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝕍</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><msup><mi>λ</mi><mi>T</mi></msup><mo>∗</mo></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigoplus_{n\geq 0}{R\hskip-0.5ptH}^{\bullet}(C_{g}^{n},\mathbf{Q})\to\bigoplus_{n\geq 0}{R\hskip-0.5ptH}^{\bullet-n}(M_{g},\mathbb{V}^{\otimes n})\to\bigoplus_{\lambda}{R\hskip-0.5ptH}^{\bullet-n}(M_{g},\mathbb{V}_{\langle\lambda\rangle})\otimes\sigma_{\lambda^{T}}^{\ast}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.Thmthm12.p1.3" class="ltx_p">There is a natural “suspension” operation on twisted graded commutative algebras <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx59" title="" class="ltx_ref">Pet17</a>, 4.1]</cite> which has the effect of shifting the grading on the arity <math id="S8.Thmthm12.p1.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> component by <math id="S8.Thmthm12.p1.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and tensoring with the sign representation of <math id="S8.Thmthm12.p1.m9" class="ltx_Math" alttext="\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathfrak{S}_{n}</annotation></semantics></math>. In this way one can get rid of both the annoying degree shift which appears in cohomology and the conjugate of the partition <math id="S8.Thmthm12.p1.m10" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>: one finds that there is a natural structure of twisted commutative algebra on</p>
<table id="S8.Ex155" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex155.m1" class="ltx_Math" alttext="\bigoplus_{\lambda}H^{\bullet}(M_{g},\mathbb{V}_{\lambda})\otimes\sigma_{\lambda}^{\ast}" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mi>λ</mi></munder><mrow><msup><mi>H</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝕍</mi><mi>λ</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\bigoplus_{\lambda}H^{\bullet}(M_{g},\mathbb{V}_{\lambda})\otimes\sigma_{\lambda}^{\ast}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.Thmthm12.p1.4" class="ltx_p">with a subalgebra <math id="S8.Thmthm12.p1.m11" class="ltx_Math" alttext="\bigoplus_{\lambda}{R\hskip-0.5ptH}^{\bullet}(M_{g},\mathbb{V}_{\lambda})\otimes\sigma_{\lambda}^{\ast}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>⨁</mo><mi>λ</mi></msub><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝕍</mi><mi>λ</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\bigoplus_{\lambda}{R\hskip-0.5ptH}^{\bullet}(M_{g},\mathbb{V}_{\lambda})\otimes\sigma_{\lambda}^{\ast}</annotation></semantics></math> of tautological classes.
∎</p>
</div>
</div>
</section>
<section id="S9" class="ltx_section" lang="en">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">9. </span>A consequence of the FZ relations</h2>

<div id="S9.p1" class="ltx_para ltx_noindent">
<p id="S9.p1.1" class="ltx_p">In this section we will recall the <em id="S9.p1.1.1" class="ltx_emph ltx_font_italic">FZ relations</em> between tautological classes in <math id="S9.p1.m1" class="ltx_Math" alttext="R^{\bullet}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(C_{g}^{n})</annotation></semantics></math>, and draw some simple consequences from them. In particular, we will prove an analogue of the following theorem, which was conjectured by Faber <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">Fab99b</a>]</cite> and proved independently by Ionel <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">Ion05</a>]</cite> and Morita <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx47" title="" class="ltx_ref">Mor03</a>]</cite>. (Morita’s proof was only valid in cohomology, but Ionel’s proof worked in Chow, too.)</p>
</div>
<div id="S9.Thmthm1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S9.Thmthm1.1" class="ltx_text ltx_font_bold">Theorem 9.1</span></span><span id="S9.Thmthm1.2" class="ltx_text ltx_font_bold"> </span>(Ionel, Morita)<span id="S9.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S9.Thmthm1.p1" class="ltx_para">
<p id="S9.Thmthm1.p1.1" class="ltx_p"><span id="S9.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">The tautological ring <math id="S9.Thmthm1.p1.m1" class="ltx_Math" alttext="R^{\bullet}(M_{g})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(M_{g})</annotation></semantics></math> is generated by the classes <math id="S9.Thmthm1.p1.m2" class="ltx_Math" alttext="\kappa_{r}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\kappa_{r}</annotation></semantics></math> for which <math id="S9.Thmthm1.p1.m3" class="ltx_Math" alttext="3r&lt;g+1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>&lt;</mo><mrow><mi>g</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">3r&lt;g+1</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S9.p2" class="ltx_para ltx_noindent">
<p id="S9.p2.1" class="ltx_p">This theorem is a direct consequence of the FZ relations. We will see that the FZ relations can be used to prove the following stronger result:</p>
</div>
<div id="S9.Thmthm2" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S9.Thmthm2.1" class="ltx_text ltx_font_bold">Theorem 9.2</span></span><span id="S9.Thmthm2.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S9.Thmthm2.p1" class="ltx_para">
<p id="S9.Thmthm2.p1.1" class="ltx_p"><span id="S9.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">Fix a genus <math id="S9.Thmthm2.p1.m1" class="ltx_Math" alttext="g\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">g\geq 2</annotation></semantics></math>. The twisted commutative algebra <math id="S9.Thmthm2.p1.m2" class="ltx_Math" alttext="R_{g}=\bigoplus_{n\geq 0}R^{\bullet}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>g</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">R_{g}=\bigoplus_{n\geq 0}R^{\bullet}(C_{g}^{n})</annotation></semantics></math> is generated by the classes <math id="S9.Thmthm2.p1.m3" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> for which <math id="S9.Thmthm2.p1.m4" class="ltx_Math" alttext="3r-n&lt;g+1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mi>n</mi></mrow><mo>&lt;</mo><mrow><mi>g</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">3r-n&lt;g+1</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S9.p3" class="ltx_para ltx_noindent">
<p id="S9.p3.1" class="ltx_p">This implies in particular the result of Ionel–Morita, since the arity <math id="S9.p3.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> component of <math id="S9.p3.m2" class="ltx_Math" alttext="R_{g}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>g</mi></msub><annotation encoding="application/x-tex">R_{g}</annotation></semantics></math> is the tautological ring <math id="S9.p3.m3" class="ltx_Math" alttext="R^{\bullet}(M_{g})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(M_{g})</annotation></semantics></math>, and <math id="S9.p3.m4" class="ltx_Math" alttext="D_{0,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mn>0</mn><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{0,r}</annotation></semantics></math> is the kappa class <math id="S9.p3.m5" class="ltx_Math" alttext="\kappa_{r}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\kappa_{r}</annotation></semantics></math>.</p>
</div>
<section id="S9.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">9.1. </span>The FZ relations</h3>

<div id="S9.SS1.p1" class="ltx_para ltx_noindent">
<p id="S9.SS1.p1.1" class="ltx_p">In the early 2000’s, Faber and Zagier (in unpublished work) formulated a conjectural infinite family of relations in the tautological ring <math id="S9.SS1.p1.m1" class="ltx_Math" alttext="R^{\bullet}(M_{g})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(M_{g})</annotation></semantics></math>. These relations were proven using the geometry of stable quotients by Pandharipande and Pixton <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx61" title="" class="ltx_ref">PP13</a>]</cite>. Around the same time, Pixton found a generalization of this conjecture to incorporate also marked points and an extension of these relations to the Deligne–Mumford boundary. These extended FZ relations on <math id="S9.SS1.p1.m2" class="ltx_Math" alttext="\overline{{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{M}}_{g,n}</annotation></semantics></math> were subsequently proven in cohomology by Pandharipande–Pixton–Zvonkine <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx62" title="" class="ltx_ref">PPZ15</a>]</cite> and on the level of Chow rings by Janda <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Jan13</a>, <a href="#bib.bibx34" title="" class="ltx_ref">Jan17</a>]</cite>.</p>
</div>
<div id="S9.SS1.p2" class="ltx_para ltx_noindent">
<p id="S9.SS1.p2.1" class="ltx_p">The FZ relations on <math id="S9.SS1.p2.m1" class="ltx_Math" alttext="C_{g}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">C_{g}^{n}</annotation></semantics></math> take a simpler form than on <math id="S9.SS1.p2.m2" class="ltx_Math" alttext="\overline{{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{M}}_{g,n}</annotation></semantics></math>. Let us state the result in this case, following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Jan13</a>, Section 4]</cite>.</p>
</div>
<div id="S9.SS1.p3" class="ltx_para ltx_noindent">
<p id="S9.SS1.p3.1" class="ltx_p">Let</p>
<table id="S9.Ex156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex156.m1" class="ltx_Math" alttext="A(z)=\sum_{i\geq 0}\frac{(6i)!}{(2i)!(3i)!}z^{i}\qquad B(z)=\sum_{i\geq 0}\frac{(6i)!}{(2i)!(3i)!}\frac{(6i+1)}{(6i-1)}z^{i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mi>i</mi></msup></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mi>i</mi></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A(z)=\sum_{i\geq 0}\frac{(6i)!}{(2i)!(3i)!}z^{i}\qquad B(z)=\sum_{i\geq 0}\frac{(6i)!}{(2i)!(3i)!}\frac{(6i+1)}{(6i-1)}z^{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p3.2" class="ltx_p">We introduce a sequence of further power series <math id="S9.SS1.p3.m1" class="ltx_Math" alttext="C_{n}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>n</mi></msub><annotation encoding="application/x-tex">C_{n}</annotation></semantics></math> by</p>
<table id="S9.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.E8.m1" class="ltx_Math" alttext="C_{1}=\frac{B}{A};\qquad C_{n+1}=(12z^{2}\frac{d}{dz}-4nz)C_{n}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>=</mo><mfrac><mi>B</mi><mi>A</mi></mfrac></mrow><mo rspace="2.167em">;</mo><mrow><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mfrac></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>n</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{1}=\frac{B}{A};\qquad C_{n+1}=(12z^{2}\frac{d}{dz}-4nz)C_{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p3.3" class="ltx_p">We note that <math id="S9.SS1.p3.m2" class="ltx_Math" alttext="C_{n}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>n</mi></msub><annotation encoding="application/x-tex">C_{n}</annotation></semantics></math> is a multiple of <math id="S9.SS1.p3.m3" class="ltx_Math" alttext="z^{n-1}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">z^{n-1}</annotation></semantics></math>. We will also define</p>
<table id="S9.Ex157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex157.m1" class="ltx_Math" alttext="C_{0}=\log(A)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">C_{0}=\log(A),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p3.4" class="ltx_p">which is a multiple of <math id="S9.SS1.p3.m4" class="ltx_Math" alttext="z^{1}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mn>1</mn></msup><annotation encoding="application/x-tex">z^{1}</annotation></semantics></math>. Then we have</p>
<table id="S9.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(9)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.E9.m1" class="ltx_Math" alttext="C_{1}=-1+144z+2^{5}3^{3}z^{2}\frac{d}{dz}C_{0}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo rspace="0em">=</mo><mrow><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo>+</mo><mrow><mn>144</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><mrow><msup><mn>2</mn><mn>5</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>3</mn><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">C_{1}=-1+144z+2^{5}3^{3}z^{2}\frac{d}{dz}C_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p3.5" class="ltx_p">so that the coefficients <math id="S9.SS1.p3.m5" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math> (and hence also the higher <math id="S9.SS1.p3.m6" class="ltx_Math" alttext="C_{n}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>n</mi></msub><annotation encoding="application/x-tex">C_{n}</annotation></semantics></math>) are in fact recursively expressed in terms of those of <math id="S9.SS1.p3.m7" class="ltx_Math" alttext="C_{0}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>0</mn></msub><annotation encoding="application/x-tex">C_{0}</annotation></semantics></math>, except for low order terms.</p>
</div>
<div id="S9.SS1.p4" class="ltx_para ltx_noindent">
<p id="S9.SS1.p4.1" class="ltx_p">For any power series <math id="S9.SS1.p4.m1" class="ltx_Math" alttext="F(z)=\sum_{i\geq 0}a_{i}z^{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></msub><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mi>i</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">F(z)=\sum_{i\geq 0}a_{i}z^{i}</annotation></semantics></math> in <math id="S9.SS1.p4.m2" class="ltx_Math" alttext="\mathbf{Q}[\![z]\!]" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>z</mi><mpadded style="width:0.108em;" width="0.108em"><mo stretchy="false">]</mo></mpadded></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q}[\![z]\!]</annotation></semantics></math>, we define bracket operators</p>
<table id="S9.Ex158" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex158.m1" class="ltx_Math" alttext="\{F\}_{\kappa}=\sum_{i\geq 0}\kappa_{i}a_{i}z^{i}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><mi>F</mi><mo stretchy="false">}</mo></mrow><mi>κ</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msub><mi>κ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mi>i</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\{F\}_{\kappa}=\sum_{i\geq 0}\kappa_{i}a_{i}z^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p4.2" class="ltx_p">and</p>
<table id="S9.Ex159" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex159.m1" class="ltx_Math" alttext="\{F\}_{\Delta_{S}}=\sum_{i\geq 0}(-1)^{|S|-1}\Delta_{S}\psi_{S}^{i-|S|+1}a_{i}z^{i}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><mi>F</mi><mo stretchy="false">}</mo></mrow><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mi>S</mi><mrow><mrow><mi>i</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mi>i</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\{F\}_{\Delta_{S}}=\sum_{i\geq 0}(-1)^{|S|-1}\Delta_{S}\psi_{S}^{i-|S|+1}a_{i}z^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p4.3" class="ltx_p">for any <math id="S9.SS1.p4.m3" class="ltx_Math" alttext="S\subseteq\{1,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S\subseteq\{1,\ldots,n\}</annotation></semantics></math>; here <math id="S9.SS1.p4.m4" class="ltx_Math" alttext="\psi_{S}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\psi_{S}</annotation></semantics></math> denotes <math id="S9.SS1.p4.m5" class="ltx_Math" alttext="\psi_{j}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\psi_{j}</annotation></semantics></math> for any <math id="S9.SS1.p4.m6" class="ltx_Math" alttext="j\in S" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">j\in S</annotation></semantics></math>.</p>
</div>
<div id="S9.SS1.p5" class="ltx_para ltx_noindent">
<p id="S9.SS1.p5.1" class="ltx_p">We use <math id="S9.SS1.p5.m1" class="ltx_Math" alttext="[F]_{z^{r}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mi>F</mi><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub><annotation encoding="application/x-tex">[F]_{z^{r}}</annotation></semantics></math> to denote the coefficient of <math id="S9.SS1.p5.m2" class="ltx_Math" alttext="z^{r}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mi>r</mi></msup><annotation encoding="application/x-tex">z^{r}</annotation></semantics></math> in a power series.</p>
</div>
<div id="S9.Thmthm3" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S9.Thmthm3.1" class="ltx_text ltx_font_bold">Theorem 9.3</span></span><span id="S9.Thmthm3.2" class="ltx_text ltx_font_bold"> </span>(Janda, Pixton–Pandharipande, Pixton–Pandharipande–Zvonkine)<span id="S9.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S9.Thmthm3.p1" class="ltx_para ltx_noindent">
<p id="S9.Thmthm3.p1.1" class="ltx_p"><span id="S9.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="S9.Thmthm3.p1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> such that <math id="S9.Thmthm3.p1.m2" class="ltx_Math" alttext="3r-g-1-n" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mi>g</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">3r-g-1-n</annotation></semantics></math> is a nonnegative even integer, the expression</span></p>
<table id="S9.Ex160" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex160.m1" class="ltx_Math" alttext="\big[\exp(-\{\log(A)\}_{\kappa})\sum_{P\text{ \emph{partition of} }n}\prod_{S\in P}\{C_{|S|}\}_{\Delta_{S}}\big]_{z^{r}}" display="block" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mrow><mo stretchy="false">{</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mi>κ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mtext class="ltx_mathvariant_italic"> </mtext><mtext><em class="ltx_emph" style="font-size:70%;">partition of</em></mtext><mtext class="ltx_mathvariant_italic"> </mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></munder><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>S</mi><mo>∈</mo><mi>P</mi></mrow></munder><msub><mrow><mo stretchy="false">{</mo><msub><mi>C</mi><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></msub><mo stretchy="false">}</mo></mrow><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub></msub></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub><annotation encoding="application/x-tex">\big[\exp(-\{\log(A)\}_{\kappa})\sum_{P\text{ \emph{partition of} }n}\prod_{S\in P}\{C_{|S|}\}_{\Delta_{S}}\big]_{z^{r}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.Thmthm3.p1.2" class="ltx_p"><span id="S9.Thmthm3.p1.2.1" class="ltx_text ltx_font_italic">vanishes in <math id="S9.Thmthm3.p1.m3" class="ltx_Math" alttext="\mathrm{CH}^{r}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>CH</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{r}(C_{g}^{n})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S9.Thmthm4" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S9.Thmthm4.1" class="ltx_text ltx_font_bold">Definition 9.4</span></span><span id="S9.Thmthm4.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S9.Thmthm4.p1" class="ltx_para">
<p id="S9.Thmthm4.p1.1" class="ltx_p">We denote the above expression <math id="S9.Thmthm4.p1.m1" class="ltx_Math" alttext="\big[\exp(-\{\log(A)\}_{\kappa})\sum_{P}\prod_{S\in P}\{C_{|S|}\}_{\Delta_{S}}\big]_{z^{r}}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mrow><mo stretchy="false">{</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mi>κ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">∑</mo><mi>P</mi></msub><mrow><msub><mo rspace="0em">∏</mo><mrow><mi>S</mi><mo>∈</mo><mi>P</mi></mrow></msub><msub><mrow><mo stretchy="false">{</mo><msub><mi>C</mi><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></msub><mo stretchy="false">}</mo></mrow><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub></msub></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub><annotation encoding="application/x-tex">\big[\exp(-\{\log(A)\}_{\kappa})\sum_{P}\prod_{S\in P}\{C_{|S|}\}_{\Delta_{S}}\big]_{z^{r}}</annotation></semantics></math> by <math id="S9.Thmthm4.p1.m2" class="ltx_Math" alttext="\mathsf{FZ}_{g,n,r}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{g,n,r}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S9.Thmthm5" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S9.Thmthm5.1" class="ltx_text ltx_font_bold">Lemma 9.5</span></span><span id="S9.Thmthm5.2" class="ltx_text ltx_font_bold"> </span>(Ionel)<span id="S9.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S9.Thmthm5.p1" class="ltx_para">
<p id="S9.Thmthm5.p1.1" class="ltx_p"><span id="S9.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">All coefficients <math id="S9.Thmthm5.p1.m1" class="ltx_Math" alttext="[C_{n}]_{z^{r}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub><annotation encoding="application/x-tex">[C_{n}]_{z^{r}}</annotation></semantics></math>, for <math id="S9.Thmthm5.p1.m2" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math> and <math id="S9.Thmthm5.p1.m3" class="ltx_Math" alttext="r\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r\geq 1</annotation></semantics></math> or <math id="S9.Thmthm5.p1.m4" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math> and <math id="S9.Thmthm5.p1.m5" class="ltx_Math" alttext="r\geq n-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">r\geq n-1</annotation></semantics></math>, are strictly positive rational numbers, except the constant term of <math id="S9.Thmthm5.p1.m6" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math> which is negative.</span></p>
</div>
</div>
<div id="S9.SS1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S9.SS1.p6" class="ltx_para ltx_noindent">
<p id="S9.SS1.p6.1" class="ltx_p"><span id="S9.SS1.p6.1.1" class="ltx_text">The case <math id="S9.SS1.p6.m1" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math> is <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">Ion05</a>, Lemma 3.6]</cite>, since the coefficients of <math id="S9.SS1.p6.m2" class="ltx_Math" alttext="C_{0}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>0</mn></msub><annotation encoding="application/x-tex">C_{0}</annotation></semantics></math> are (up to rescaling) the numbers she denotes <math id="S9.SS1.p6.m3" class="ltx_Math" alttext="c_{k,k}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>k</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">c_{k,k}</annotation></semantics></math>. The case <math id="S9.SS1.p6.m4" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math> follows from this by the differential equation (<a href="#S9.E9" title="In 9.1. The FZ relations ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>); in fact, it is even stated in Ionel’s lemma, since the coefficients of <math id="S9.SS1.p6.m5" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math> are (up to rescaling) the numbers she calls <math id="S9.SS1.p6.m6" class="ltx_Math" alttext="c_{k,k-1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>k</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">c_{k,k-1}</annotation></semantics></math>. The differential equation (<a href="#S9.E8" title="In 9.1. The FZ relations ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) says that</span></p>
<table id="S9.Ex161" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex161.m1" class="ltx_Math" alttext="[C_{n+1}]_{z^{r+1}}=(12r-4n)[C_{n}]_{z^{r}}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub></mrow></mrow><annotation encoding="application/x-tex">[C_{n+1}]_{z^{r+1}}=(12r-4n)[C_{n}]_{z^{r}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p6.2" class="ltx_p"><span id="S9.SS1.p6.2.1" class="ltx_text">for <math id="S9.SS1.p6.m7" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math>, and one checks that <math id="S9.SS1.p6.m8" class="ltx_Math" alttext="12r-4n" display="inline" intent=":literal"><semantics><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">12r-4n</annotation></semantics></math> is strictly positive in all cases of interest except <math id="S9.SS1.p6.m9" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math>, <math id="S9.SS1.p6.m10" class="ltx_Math" alttext="r=0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r=0</annotation></semantics></math>, where it is negative: consequently, all coefficients of <math id="S9.SS1.p6.m11" class="ltx_Math" alttext="C_{n}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>n</mi></msub><annotation encoding="application/x-tex">C_{n}</annotation></semantics></math> for <math id="S9.SS1.p6.m12" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math>, <math id="S9.SS1.p6.m13" class="ltx_Math" alttext="r\geq n-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">r\geq n-1</annotation></semantics></math> are strictly positive, too.
∎</span></p>
</div>
</div>
<div id="S9.SS1.p7" class="ltx_para ltx_noindent">
<p id="S9.SS1.p7.1" class="ltx_p">We may now prove Theorem <a href="#S9.Thmthm2" title="Theorem 9.2. ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a>.</p>
</div>
<div id="S9.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S9.SS1.p8" class="ltx_para ltx_noindent">
<p id="S9.SS1.p8.1" class="ltx_p"><span id="S9.SS1.p8.1.1" class="ltx_text">(of Theorem <a href="#S9.Thmthm2" title="Theorem 9.2. ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a>) We know that the twisted commutative algebra <math id="S9.SS1.p8.m1" class="ltx_Math" alttext="R_{g}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>g</mi></msub><annotation encoding="application/x-tex">R_{g}</annotation></semantics></math> is generated by the images of the classes <math id="S9.SS1.p8.m2" class="ltx_Math" alttext="D_{n,r}\in S_{g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><mo>∈</mo><msub><mi>S</mi><mi>g</mi></msub></mrow><annotation encoding="application/x-tex">D_{n,r}\in S_{g}</annotation></semantics></math>. Consider some generator <math id="S9.SS1.p8.m3" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> for which <math id="S9.SS1.p8.m4" class="ltx_Math" alttext="3r-g-1-n\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mi>g</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>n</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">3r-g-1-n\geq 0</annotation></semantics></math>. If <math id="S9.SS1.p8.m5" class="ltx_Math" alttext="3r-g-1-n" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mi>g</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">3r-g-1-n</annotation></semantics></math> is even then one of the terms in the relation <math id="S9.SS1.p8.m6" class="ltx_Math" alttext="\mathsf{FZ}_{g,n,r}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{g,n,r}</annotation></semantics></math> equals</span></p>
<table id="S9.Ex162" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex162.m1" class="ltx_Math" alttext="(-1)^{n-1}[C_{n}]_{z^{r}}\cdot D_{n,r}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mi>n</mi></msub><mo rspace="0.055em" stretchy="false">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub></mrow><mo rspace="0.222em">⋅</mo><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(-1)^{n-1}[C_{n}]_{z^{r}}\cdot D_{n,r},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p8.2" class="ltx_p"><span id="S9.SS1.p8.2.1" class="ltx_text">and all other terms are products of generators with smaller <math id="S9.SS1.p8.m7" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. By Lemma <a href="#S9.Thmthm5" title="Lemma 9.5 (Ionel). ‣ 9.1. The FZ relations ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.5</span></a>, <math id="S9.SS1.p8.m8" class="ltx_Math" alttext="[C_{n}]_{z^{r}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub><annotation encoding="application/x-tex">[C_{n}]_{z^{r}}</annotation></semantics></math> is nonzero, and this relation can be used to express the class <math id="S9.SS1.p8.m9" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> in terms of “simpler” generators.</span></p>
</div>
<div id="S9.SS1.p9" class="ltx_para ltx_noindent">
<p id="S9.SS1.p9.1" class="ltx_p"><span id="S9.SS1.p9.1.1" class="ltx_text">If <math id="S9.SS1.p9.m1" class="ltx_Math" alttext="3r-g-1-n" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mi>g</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">3r-g-1-n</annotation></semantics></math> is odd, we may instead consider the FZ relation <math id="S9.SS1.p9.m2" class="ltx_Math" alttext="\psi_{n+1}\cdot\mathsf{FZ}_{g,n+1,r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝖥𝖹</mi><mrow><mi>g</mi><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>r</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\psi_{n+1}\cdot\mathsf{FZ}_{g,n+1,r}</annotation></semantics></math>, and push forward along the map forgetting the last marked point to get a codimension <math id="S9.SS1.p9.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> relation on <math id="S9.SS1.p9.m4" class="ltx_Math" alttext="C_{g}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">C_{g}^{n}</annotation></semantics></math>. When we push down a monomial in the kappa, diagonal and psi-classes from <math id="S9.SS1.p9.m5" class="ltx_Math" alttext="C_{g}^{n+1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>g</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">C_{g}^{n+1}</annotation></semantics></math> to <math id="S9.SS1.p9.m6" class="ltx_Math" alttext="C_{g}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">C_{g}^{n}</annotation></semantics></math>, we get a multiple of <math id="S9.SS1.p9.m7" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> exactly when we push down <math id="S9.SS1.p9.m8" class="ltx_Math" alttext="D_{n+1,r+1}=\Delta_{12\ldots n+1}\psi_{1}^{r-n+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>=</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mn>1</mn><mrow><mrow><mi>r</mi><mo>−</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">D_{n+1,r+1}=\Delta_{12\ldots n+1}\psi_{1}^{r-n+1}</annotation></semantics></math> (which pushes forward to <math id="S9.SS1.p9.m9" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math>) and when we push down <math id="S9.SS1.p9.m10" class="ltx_Math" alttext="D_{n,r}\times D_{1,1}=\Delta_{12\ldots n}\psi_{1}^{r-n+1}\psi_{n+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>D</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo>=</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mn>1</mn><mrow><mrow><mi>r</mi><mo>−</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">D_{n,r}\times D_{1,1}=\Delta_{12\ldots n}\psi_{1}^{r-n+1}\psi_{n+1}</annotation></semantics></math>, which pushes forward to <math id="S9.SS1.p9.m11" class="ltx_Math" alttext="(2g-2)D_{n,r}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(2g-2)D_{n,r}</annotation></semantics></math>. Thus the resulting relation on <math id="S9.SS1.p9.m12" class="ltx_Math" alttext="C_{g}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">C_{g}^{n}</annotation></semantics></math> will have as one of its terms</span></p>
<table id="S9.Ex163" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex163.m1" class="ltx_Math" alttext="(-1)^{n}\big([C_{n+1}]_{z^{r}}-(2g-2)[C_{n}]_{z^{r}}[C_{1}]_{z^{0}}\big)\cdot D_{n,r}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mn>0</mn></msup></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(-1)^{n}\big([C_{n+1}]_{z^{r}}-(2g-2)[C_{n}]_{z^{r}}[C_{1}]_{z^{0}}\big)\cdot D_{n,r},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p9.2" class="ltx_p"><span id="S9.SS1.p9.2.1" class="ltx_text">and all other terms are products of generators with smaller values of <math id="S9.SS1.p9.m13" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. By Lemma <a href="#S9.Thmthm5" title="Lemma 9.5 (Ionel). ‣ 9.1. The FZ relations ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.5</span></a> the coefficients <math id="S9.SS1.p9.m14" class="ltx_Math" alttext="[C_{n+1}]_{z^{r}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub><annotation encoding="application/x-tex">[C_{n+1}]_{z^{r}}</annotation></semantics></math> and <math id="S9.SS1.p9.m15" class="ltx_Math" alttext="[C_{n}]_{z^{r}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mi>r</mi></msup></msub><annotation encoding="application/x-tex">[C_{n}]_{z^{r}}</annotation></semantics></math> are positive and the coefficient <math id="S9.SS1.p9.m16" class="ltx_Math" alttext="[C_{1}]_{z^{0}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow><msup><mi>z</mi><mn>0</mn></msup></msub><annotation encoding="application/x-tex">[C_{1}]_{z^{0}}</annotation></semantics></math> is negative, so the coefficient behind <math id="S9.SS1.p9.m17" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> is nonzero and we may use this relation to eliminate the generator <math id="S9.SS1.p9.m18" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S10" class="ltx_section" lang="en">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">10. </span>Low genus calculations</h2>

<div id="S10.p1" class="ltx_para ltx_noindent">
<p id="S10.p1.1" class="ltx_p">In this section of the paper we will completely calculate the groups <math id="S10.p1.m1" class="ltx_Math" alttext="R^{k}(M_{g},\mathbf{V}_{\langle\lambda\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{k}(M_{g},\mathbf{V}_{\langle\lambda\rangle})</annotation></semantics></math> for all <math id="S10.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="S10.p1.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> when <math id="S10.p1.m4" class="ltx_Math" alttext="g\leq 4" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≤</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">g\leq 4</annotation></semantics></math>.</p>
</div>
<div id="S10.Thmthm1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S10.Thmthm1.1" class="ltx_text ltx_font_bold">Theorem 10.1</span></span><span id="S10.Thmthm1.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S10.Thmthm1.p1" class="ltx_para ltx_noindent">
<p id="S10.Thmthm1.p1.1" class="ltx_p"><span id="S10.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">Recall the twisted commutative algebra <math id="S10.Thmthm1.p1.m1" class="ltx_Math" alttext="R_{g}^{\prime\prime}=\bigoplus_{\lambda}R^{\bullet}(M_{g},\mathbf{V}_{\langle\lambda\rangle})\otimes\sigma_{\lambda^{T}}^{\ast}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>⨁</mo><mi>λ</mi></msub><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><msup><mi>λ</mi><mi>T</mi></msup><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">R_{g}^{\prime\prime}=\bigoplus_{\lambda}R^{\bullet}(M_{g},\mathbf{V}_{\langle\lambda\rangle})\otimes\sigma_{\lambda^{T}}^{\ast}</annotation></semantics></math>, defined for any <math id="S10.Thmthm1.p1.m2" class="ltx_Math" alttext="g\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">g\geq 2</annotation></semantics></math>.</span></p>
<ol id="S10.I1" class="ltx_enumerate">
<li id="S10.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S10.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S10.I1.i1.p1.1" class="ltx_p"><span id="S10.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">The twisted commutative algebra </span><math id="S10.I1.i1.p1.m1" class="ltx_Math" alttext="R_{2}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>2</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{2}^{\prime\prime}</annotation></semantics></math><span id="S10.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> is trivial. Equivalently, </span><math id="S10.I1.i1.p1.m2" class="ltx_Math" alttext="R^{k}(M_{2},\mathbf{V}_{\langle\lambda\rangle})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R^{k}(M_{2},\mathbf{V}_{\langle\lambda\rangle})=0</annotation></semantics></math><span id="S10.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> unless </span><math id="S10.I1.i1.p1.m3" class="ltx_Math" alttext="k=0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k=0</annotation></semantics></math><span id="S10.I1.i1.p1.1.4" class="ltx_text ltx_font_italic">, </span><math id="S10.I1.i1.p1.m4" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math><span id="S10.I1.i1.p1.1.5" class="ltx_text ltx_font_italic">, for which </span><math id="S10.I1.i1.p1.m5" class="ltx_Math" alttext="R^{0}(M_{2},\mathbf{V}_{\langle 0\rangle})=R^{0}(M_{2})\cong\mathbf{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>R</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><annotation encoding="application/x-tex">R^{0}(M_{2},\mathbf{V}_{\langle 0\rangle})=R^{0}(M_{2})\cong\mathbf{Q}</annotation></semantics></math><span id="S10.I1.i1.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S10.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S10.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S10.I1.i2.p1.1" class="ltx_p"><span id="S10.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">The twisted commutative algebra </span><math id="S10.I1.i2.p1.m1" class="ltx_Math" alttext="R_{3}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>3</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{3}^{\prime\prime}</annotation></semantics></math><span id="S10.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> is generated by </span><math id="S10.I1.i2.p1.m2" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math><span id="S10.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> and the Gross–Schoen cycle. We have</span></p>
<table id="S10.Ex164" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex164.m1" class="ltx_Math" alttext="R^{0}(M_{3},\mathbf{V}_{\langle 0\rangle})\cong R^{1}(M_{3},\mathbf{V}_{\langle 0\rangle})\cong R^{2}(M_{3},\mathbf{V}_{\langle 111\rangle})\cong\mathbf{Q}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>R</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>111</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">R^{0}(M_{3},\mathbf{V}_{\langle 0\rangle})\cong R^{1}(M_{3},\mathbf{V}_{\langle 0\rangle})\cong R^{2}(M_{3},\mathbf{V}_{\langle 111\rangle})\cong\mathbf{Q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S10.I1.i2.p1.2" class="ltx_p"><span id="S10.I1.i2.p1.2.1" class="ltx_text ltx_font_italic">and all other tautological groups of all other motives </span><math id="S10.I1.i2.p1.m3" class="ltx_Math" alttext="\mathbf{V}_{\langle\lambda\rangle}" display="inline" intent=":literal"><semantics><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><annotation encoding="application/x-tex">\mathbf{V}_{\langle\lambda\rangle}</annotation></semantics></math><span id="S10.I1.i2.p1.2.2" class="ltx_text ltx_font_italic"> on </span><math id="S10.I1.i2.p1.m4" class="ltx_Math" alttext="M_{3}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>3</mn></msub><annotation encoding="application/x-tex">M_{3}</annotation></semantics></math><span id="S10.I1.i2.p1.2.3" class="ltx_text ltx_font_italic"> vanish. The group </span><math id="S10.I1.i2.p1.m5" class="ltx_Math" alttext="R^{1}(M_{3},\mathbf{V}_{\langle 0\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{1}(M_{3},\mathbf{V}_{\langle 0\rangle})</annotation></semantics></math><span id="S10.I1.i2.p1.2.4" class="ltx_text ltx_font_italic"> is spanned by </span><math id="S10.I1.i2.p1.m6" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math><span id="S10.I1.i2.p1.2.5" class="ltx_text ltx_font_italic"> and the group </span><math id="S10.I1.i2.p1.m7" class="ltx_Math" alttext="R^{2}(M_{3},\mathbf{V}_{\langle 111\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>111</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{2}(M_{3},\mathbf{V}_{\langle 111\rangle})</annotation></semantics></math><span id="S10.I1.i2.p1.2.6" class="ltx_text ltx_font_italic"> is spanned by the Gross–Schoen cycle.</span></p>
</div></li>
<li id="S10.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S10.I1.i3.p1" class="ltx_para">
<p id="S10.I1.i3.p1.1" class="ltx_p"><span id="S10.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">The twisted commutative algebra </span><math id="S10.I1.i3.p1.m1" class="ltx_Math" alttext="R_{4}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>4</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{4}^{\prime\prime}</annotation></semantics></math><span id="S10.I1.i3.p1.1.2" class="ltx_text ltx_font_italic"> is generated by </span><math id="S10.I1.i3.p1.m2" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math><span id="S10.I1.i3.p1.1.3" class="ltx_text ltx_font_italic">, the Gross–Schoen cycle, and the Faber–Pandharipande cycle.
The complete list of motives </span><math id="S10.I1.i3.p1.m3" class="ltx_Math" alttext="\mathbf{V}_{\langle\lambda\rangle}" display="inline" intent=":literal"><semantics><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><annotation encoding="application/x-tex">\mathbf{V}_{\langle\lambda\rangle}</annotation></semantics></math><span id="S10.I1.i3.p1.1.4" class="ltx_text ltx_font_italic"> on </span><math id="S10.I1.i3.p1.m4" class="ltx_Math" alttext="M_{4}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>4</mn></msub><annotation encoding="application/x-tex">M_{4}</annotation></semantics></math><span id="S10.I1.i3.p1.1.5" class="ltx_text ltx_font_italic"> with nontrivial tautological groups are</span></p>
<table id="S10.EGx15" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S10.Ex165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex165.m1" class="ltx_Math" alttext="\displaystyle R^{0}(M_{4},\mathbf{V}_{\langle 0\rangle})\cong R^{1}(M_{4},\mathbf{V}_{\langle 0\rangle})\cong R^{2}(M_{4},\mathbf{V}_{\langle 0\rangle})\cong\mathbf{Q}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>R</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle R^{0}(M_{4},\mathbf{V}_{\langle 0\rangle})\cong R^{1}(M_{4},\mathbf{V}_{\langle 0\rangle})\cong R^{2}(M_{4},\mathbf{V}_{\langle 0\rangle})\cong\mathbf{Q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S10.Ex166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex166.m1" class="ltx_Math" alttext="\displaystyle R^{2}(M_{4},\mathbf{V}_{\langle 111\rangle})\cong R^{3}(M_{4},\mathbf{V}_{\langle 111\rangle})\cong\mathbf{Q}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>111</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>111</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle R^{2}(M_{4},\mathbf{V}_{\langle 111\rangle})\cong R^{3}(M_{4},\mathbf{V}_{\langle 111\rangle})\cong\mathbf{Q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S10.Ex167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex167.m1" class="ltx_Math" alttext="\displaystyle R^{2}(M_{4},\mathbf{V}_{\langle 11\rangle})\cong\mathbf{Q}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>11</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle R^{2}(M_{4},\mathbf{V}_{\langle 11\rangle})\cong\mathbf{Q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S10.Ex168"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex168.m1" class="ltx_Math" alttext="\displaystyle R^{4}(M_{4},\mathbf{V}_{\langle 2211\rangle})\cong\mathbf{Q}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>R</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>2211</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle R^{4}(M_{4},\mathbf{V}_{\langle 2211\rangle})\cong\mathbf{Q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S10.I1.i3.p1.2" class="ltx_p"><span id="S10.I1.i3.p1.2.1" class="ltx_text ltx_font_italic">The group </span><math id="S10.I1.i3.p1.m5" class="ltx_Math" alttext="R^{k}(M_{4},\mathbf{V}_{\langle 0\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{k}(M_{4},\mathbf{V}_{\langle 0\rangle})</annotation></semantics></math><span id="S10.I1.i3.p1.2.2" class="ltx_text ltx_font_italic"> is spanned by </span><math id="S10.I1.i3.p1.m6" class="ltx_Math" alttext="\kappa_{1}^{k}" display="inline" intent=":literal"><semantics><msubsup><mi>κ</mi><mn>1</mn><mi>k</mi></msubsup><annotation encoding="application/x-tex">\kappa_{1}^{k}</annotation></semantics></math><span id="S10.I1.i3.p1.2.3" class="ltx_text ltx_font_italic">. The group </span><math id="S10.I1.i3.p1.m7" class="ltx_Math" alttext="R^{2}(M_{4},\mathbf{V}_{\langle 111\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>111</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{2}(M_{4},\mathbf{V}_{\langle 111\rangle})</annotation></semantics></math><span id="S10.I1.i3.p1.2.4" class="ltx_text ltx_font_italic"> is spanned by the Gross–Schoen cycle, and </span><math id="S10.I1.i3.p1.m8" class="ltx_Math" alttext="R^{3}(M_{4},\mathbf{V}_{\langle 111\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>111</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{3}(M_{4},\mathbf{V}_{\langle 111\rangle})</annotation></semantics></math><span id="S10.I1.i3.p1.2.5" class="ltx_text ltx_font_italic"> by the product of </span><math id="S10.I1.i3.p1.m9" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math><span id="S10.I1.i3.p1.2.6" class="ltx_text ltx_font_italic"> and the Gross–Schoen cycle. The group </span><math id="S10.I1.i3.p1.m10" class="ltx_Math" alttext="R^{2}(M_{4},\mathbf{V}_{\langle 11\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>11</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{2}(M_{4},\mathbf{V}_{\langle 11\rangle})</annotation></semantics></math><span id="S10.I1.i3.p1.2.7" class="ltx_text ltx_font_italic"> is spanned by the Faber–Pandharipande cycle. Finally, </span><math id="S10.I1.i3.p1.m11" class="ltx_Math" alttext="R^{4}(M_{4},\mathbf{V}_{\langle 2211\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>2211</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{4}(M_{4},\mathbf{V}_{\langle 2211\rangle})</annotation></semantics></math><span id="S10.I1.i3.p1.2.8" class="ltx_text ltx_font_italic"> is spanned by the cross product of two Gross–Schoen cycles; that is, the projection of </span><math id="S10.I1.i3.p1.m12" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}</annotation></semantics></math><span id="S10.I1.i3.p1.2.9" class="ltx_text ltx_font_italic"> into the summand </span><math id="S10.I1.i3.p1.m13" class="ltx_Math" alttext="\mathrm{CH}^{4}(M_{4},\mathbf{V}_{\langle 2,2,1,1\rangle})\otimes\sigma_{4,2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>CH</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mrow><mn>2</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>σ</mi><mrow><mn>4</mn><mo>,</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{4}(M_{4},\mathbf{V}_{\langle 2,2,1,1\rangle})\otimes\sigma_{4,2}</annotation></semantics></math><span id="S10.I1.i3.p1.2.10" class="ltx_text ltx_font_italic"> gives a generator.</span></p>
</div></li>
</ol>
<p id="S10.Thmthm1.p1.2" class="ltx_p"><span id="S10.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">In all cases, Poincaré duality holds, in the sense that</span></p>
<table id="S10.Ex169" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex169.m1" class="ltx_Math" alttext="R^{k}(M_{g},\mathbf{V}_{\langle\lambda\rangle})\otimes R^{g-2+|\lambda|-k}(M_{g},\mathbf{V}_{\langle\lambda\rangle})\to R^{g-2}(M_{g},\mathbf{V}_{\langle 0\rangle})\cong\mathbf{Q}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>R</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>R</mi><mrow><mrow><mrow><mi>g</mi><mo>−</mo><mn>2</mn></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow></mrow><mo>−</mo><mi>k</mi></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>R</mi><mrow><mi>g</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><annotation encoding="application/x-tex">R^{k}(M_{g},\mathbf{V}_{\langle\lambda\rangle})\otimes R^{g-2+|\lambda|-k}(M_{g},\mathbf{V}_{\langle\lambda\rangle})\to R^{g-2}(M_{g},\mathbf{V}_{\langle 0\rangle})\cong\mathbf{Q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S10.Thmthm1.p1.3" class="ltx_p"><span id="S10.Thmthm1.p1.3.1" class="ltx_text ltx_font_italic">is a perfect pairing.</span></p>
</div>
</div>
<div id="S10.p2" class="ltx_para ltx_noindent">
<p id="S10.p2.1" class="ltx_p">The proof of this theorem occupies the rest of this section. In all genera, the strategy of the proof will be the same:</p>
<ul id="S10.I2" class="ltx_itemize">
<li id="S10.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">—</span> 
<div id="S10.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S10.I2.i1.p1.1" class="ltx_p">Using Corollary <a href="#S8.Thmthm10" title="Corollary 8.10. ‣ 8. Twisted commutative algebras and tautological rings ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.10</span></a> and Theorem <a href="#S9.Thmthm2" title="Theorem 9.2. ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a> we get a finite list of generators for the twisted commutative algebra <math id="S10.I2.i1.p1.m1" class="ltx_Math" alttext="R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{g}^{\prime\prime}</annotation></semantics></math>. Thus we have reduced the problem to finding the complete set of relations between these generators.</p>
</div></li>
<li id="S10.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">—</span> 
<div id="S10.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="S10.I2.i2.p1.1" class="ltx_p">We use the FZ relations to obtain relations between the generators. Since we are working in the twisted commutative algebra <math id="S10.I2.i2.p1.m1" class="ltx_Math" alttext="R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{g}^{\prime\prime}</annotation></semantics></math>, it is enough to consider the FZ relations modulo the equivalence relation <math id="S10.I2.i2.p1.m2" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>, which often dramatically simplifies the relations. In this way we find that all but a finite list of twisted tautological classes are zero, and we are done if we can prove nonvanishing of each of these.</p>
</div></li>
<li id="S10.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">—</span> 
<div id="S10.I2.i3.p1" class="ltx_para">
<p id="S10.I2.i3.p1.1" class="ltx_p">Using Nazarov’s Theorem <a href="#S3.Thmthm8" title="Theorem 3.8 (Nazarov). ‣ 3.4. Projectors ‣ 3. Preliminaries from representation theory ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a> and our Theorem <a href="#S5.Thmthm5" title="Theorem 5.5. ‣ 5.4. Decomposing the tautological ring ‣ 5. The Künneth decomposition of the tautological ring ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.5</span></a>, we can represent each of the remaining potentially nonzero twisted tautological classes by an explicit class in <math id="S10.I2.i3.p1.m1" class="ltx_Math" alttext="R^{\bullet}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(C_{g}^{n})</annotation></semantics></math>, so that we reduce the problem to proving that a finite number of tautological classes (without twisted coefficients) in <math id="S10.I2.i3.p1.m2" class="ltx_Math" alttext="C_{g}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">C_{g}^{n}</annotation></semantics></math> are nonzero. This is now done by a standard argument: we multiply with some other class in complementary degree to land in the top degree part of the tautological ring, and then push down to get an element in the top degree of the tautological ring of <math id="S10.I2.i3.p1.m3" class="ltx_Math" alttext="M_{g}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>g</mi></msub><annotation encoding="application/x-tex">M_{g}</annotation></semantics></math>, whose structure we understand completely.</p>
</div></li>
</ul>
</div>
<div id="S10.p3" class="ltx_para ltx_noindent">
<p id="S10.p3.1" class="ltx_p">To formulate the calculations, it will be convenient to introduce the following notation: for <math id="S10.p3.m1" class="ltx_Math" alttext="x,y\in\mathrm{CH}^{k}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mrow><mi>y</mi><mo>∈</mo><mrow><msup><mi>CH</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x,y\in\mathrm{CH}^{k}(C_{g}^{n})</annotation></semantics></math>, we write <math id="S10.p3.m2" class="ltx_Math" alttext="x\equiv y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≡</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x\equiv y</annotation></semantics></math> to denote that <math id="S10.p3.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="S10.p3.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> have the same image in <math id="S10.p3.m5" class="ltx_Math" alttext="\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\langle n\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>CH</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msup><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CH}^{k}(M_{g},\mathbf{V}^{\langle n\rangle})</annotation></semantics></math>. Equivalently by Theorem <a href="#S8.Thmthm8" title="Proposition 8.8. ‣ 8. Twisted commutative algebras and tautological rings ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.8</span></a>, <math id="S10.p3.m6" class="ltx_Math" alttext="x\equiv y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≡</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x\equiv y</annotation></semantics></math> if <math id="S10.p3.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="S10.p3.m8" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> are equivalent modulo the twisted commutative algebra-ideal generated by <math id="S10.p3.m9" class="ltx_Math" alttext="1\in\mathrm{CH}^{0}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>∈</mo><mrow><msup><mi>CH</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1\in\mathrm{CH}^{0}(C_{g}^{1})</annotation></semantics></math>, <math id="S10.p3.m10" class="ltx_Math" alttext="\psi_{1}\in\mathrm{CH}^{1}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo>∈</mo><mrow><msup><mi>CH</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{1}\in\mathrm{CH}^{1}(C_{g}^{1})</annotation></semantics></math> and <math id="S10.p3.m11" class="ltx_Math" alttext="\Delta_{12}\in\mathrm{CH}^{1}(C_{g}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo>∈</mo><mrow><msup><mi>CH</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{12}\in\mathrm{CH}^{1}(C_{g}^{2})</annotation></semantics></math>.</p>
</div>
<div id="S10.Thmthm2" class="ltx_theorem ltx_theorem_remarkx">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S10.Thmthm2.1" class="ltx_text ltx_font_bold">Remark 10.2</span></span><span id="S10.Thmthm2.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S10.Thmthm2.p1" class="ltx_para">
<p id="S10.Thmthm2.p1.1" class="ltx_p">We caution the reader that the relation <math id="S10.Thmthm2.p1.m1" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math> does <em id="S10.Thmthm2.p1.1.1" class="ltx_emph ltx_font_italic">not</em> respect the multiplication in the rings <math id="S10.Thmthm2.p1.m2" class="ltx_Math" alttext="R^{\bullet}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(C_{g}^{n})</annotation></semantics></math>, and is <em id="S10.Thmthm2.p1.1.2" class="ltx_emph ltx_font_italic">not</em> preserved when pushing forward a relation along a diagonal inclusion. That is, if we are given an element <math id="S10.Thmthm2.p1.m3" class="ltx_Math" alttext="\mathsf{R}\in S_{n}^{k}" display="inline" intent=":literal"><semantics><mrow><mi>𝖱</mi><mo>∈</mo><msubsup><mi>S</mi><mi>n</mi><mi>k</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathsf{R}\in S_{n}^{k}</annotation></semantics></math> such that <math id="S10.Thmthm2.p1.m4" class="ltx_Math" alttext="\mathsf{R}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mi>𝖱</mi><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathsf{R}\equiv 0</annotation></semantics></math> in <math id="S10.Thmthm2.p1.m5" class="ltx_Math" alttext="R^{k}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{k}(C_{g}^{n})</annotation></semantics></math>, then it does not follow e.g. that <math id="S10.Thmthm2.p1.m6" class="ltx_Math" alttext="\psi_{1}\cdot\mathsf{R}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝖱</mi></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\psi_{1}\cdot\mathsf{R}\equiv 0</annotation></semantics></math> in <math id="S10.Thmthm2.p1.m7" class="ltx_Math" alttext="R^{k+1}(C_{g}^{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{k+1}(C_{g}^{n})</annotation></semantics></math>, nor that the pushforward of <math id="S10.Thmthm2.p1.m8" class="ltx_Math" alttext="\mathsf{R}" display="inline" intent=":literal"><semantics><mi>𝖱</mi><annotation encoding="application/x-tex">\mathsf{R}</annotation></semantics></math> to <math id="S10.Thmthm2.p1.m9" class="ltx_Math" alttext="R^{k+1}(C_{g}^{n+1})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{k+1}(C_{g}^{n+1})</annotation></semantics></math> along a diagonal inclusion vanishes modulo <math id="S10.Thmthm2.p1.m10" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>. One must therefore be careful to first multiply or push forward and only afterward reduce modulo <math id="S10.Thmthm2.p1.m11" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>. ∎</p>
</div>
</div>
<section id="S10.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">10.1. </span>Genus two</h3>

<div id="S10.SS1.p1" class="ltx_para ltx_noindent">
<p id="S10.SS1.p1.1" class="ltx_p">By Corollary <a href="#S8.Thmthm10" title="Corollary 8.10. ‣ 8. Twisted commutative algebras and tautological rings ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.10</span></a> and Proposition <a href="#S9.Thmthm2" title="Theorem 9.2. ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a>, <em id="S10.SS1.p1.1.1" class="ltx_emph ltx_font_italic">all</em> of the generators <math id="S10.SS1.p1.m1" class="ltx_Math" alttext="D_{n,r}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">D_{n,r}</annotation></semantics></math> go to zero in <math id="S10.SS1.p1.m2" class="ltx_Math" alttext="R_{2}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>2</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{2}^{\prime\prime}</annotation></semantics></math>. So <math id="S10.SS1.p1.m3" class="ltx_Math" alttext="R_{2}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>2</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{2}^{\prime\prime}</annotation></semantics></math> is the free twisted commutative algebra on <em id="S10.SS1.p1.1.2" class="ltx_emph ltx_font_italic">no</em> generators, i.e. it contains only the unit element in arity <math id="S10.SS1.p1.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. This proves the genus <math id="S10.SS1.p1.m5" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> case of Theorem <a href="#S10.Thmthm1" title="Theorem 10.1. ‣ 10. Low genus calculations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10.1</span></a>.</p>
</div>
<div id="S10.SS1.p2" class="ltx_para ltx_noindent">
<p id="S10.SS1.p2.1" class="ltx_p">This result was previously obtained (in a different form) in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx69" title="" class="ltx_ref">Tav14</a>]</cite>.</p>
</div>
<div id="S10.SS1.p3" class="ltx_para ltx_noindent">
<p id="S10.SS1.p3.1" class="ltx_p">The analogous statement is also true in genus one: <math id="S10.SS1.p3.m1" class="ltx_Math" alttext="R^{k}(M_{1,1},\mathbf{V}_{\langle a\rangle})\cong\mathbf{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>a</mi><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><annotation encoding="application/x-tex">R^{k}(M_{1,1},\mathbf{V}_{\langle a\rangle})\cong\mathbf{Q}</annotation></semantics></math> for <math id="S10.SS1.p3.m2" class="ltx_Math" alttext="k=a=0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mi>a</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k=a=0</annotation></semantics></math>, and vanishes otherwise; this reformulates a result from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx68" title="" class="ltx_ref">Tav11</a>]</cite>. This statement is not hard to prove in our framework, but we have chosen to simplify the exposition by only talking about tautological groups <math id="S10.SS1.p3.m3" class="ltx_Math" alttext="R^{\bullet}(M_{g},\mathbf{V}_{\langle\lambda\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>g</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(M_{g},\mathbf{V}_{\langle\lambda\rangle})</annotation></semantics></math> on moduli spaces of unpointed curves.</p>
</div>
</section>
<section id="S10.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">10.2. </span>Genus three</h3>

<div id="S10.SS2.p1" class="ltx_para ltx_noindent">
<p id="S10.SS2.p1.1" class="ltx_p">By Corollary <a href="#S8.Thmthm10" title="Corollary 8.10. ‣ 8. Twisted commutative algebras and tautological rings ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.10</span></a> and Proposition <a href="#S9.Thmthm2" title="Theorem 9.2. ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a>, the twisted commutative algebra <math id="S10.SS2.p1.m1" class="ltx_Math" alttext="R_{3}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>3</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{3}^{\prime\prime}</annotation></semantics></math> is generated by the images of <math id="S10.SS2.p1.m2" class="ltx_Math" alttext="D_{0,1}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">D_{0,1}</annotation></semantics></math> and <math id="S10.SS2.p1.m3" class="ltx_Math" alttext="D_{3,0}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mn>3</mn><mo>,</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">D_{3,0}</annotation></semantics></math>, i.e. <math id="S10.SS2.p1.m4" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math> and the Gross-Schoen cycle. Thus <math id="S10.SS2.p1.m5" class="ltx_Math" alttext="R_{3}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>3</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{3}^{\prime\prime}</annotation></semantics></math> is completely determined if we can find the complete set of relations between these generators. We claim that the product of any two generators vanishes. We have three products we need to check are zero:</p>
</div>
<div id="S10.SS2.p2" class="ltx_para ltx_noindent">
<ol id="S10.I3" class="ltx_enumerate">
<li id="S10.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S10.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="S10.I3.i1.p1.1" class="ltx_p">The relation <math id="S10.I3.i1.p1.m1" class="ltx_Math" alttext="\kappa_{1}^{2}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mn>1</mn><mn>2</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa_{1}^{2}=0</annotation></semantics></math> in <math id="S10.I3.i1.p1.m2" class="ltx_Math" alttext="R^{2}(M_{3},\mathbf{V}_{\langle 0\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{2}(M_{3},\mathbf{V}_{\langle 0\rangle})</annotation></semantics></math> is well known and is a very special case of Looijenga’s theorem (see Section <a href="#S7" title="7. Consequences for Gorenstein conjectures ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>).</p>
</div></li>
<li id="S10.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S10.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="S10.I3.i2.p1.1" class="ltx_p">Modulo the equivalence relation <math id="S10.I3.i2.p1.m1" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>, the relation <math id="S10.I3.i2.p1.m2" class="ltx_Math" alttext="\mathsf{FZ}_{3,3,3}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>3</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{3,3,3}</annotation></semantics></math> simplifies to</p>
<table id="S10.Ex170" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex170.m1" class="ltx_Math" alttext="18432\Delta_{123}\psi_{1}-960\Delta_{123}\kappa_{1}\equiv 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>18432</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mn>960</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow></mrow><mo>≡</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">18432\Delta_{123}\psi_{1}-960\Delta_{123}\kappa_{1}\equiv 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S10.I3.i2.p1.2" class="ltx_p">That is, this is the expression obtained from <math id="S10.I3.i2.p1.m3" class="ltx_Math" alttext="\mathsf{FZ}_{3,3,3}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>3</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{3,3,3}</annotation></semantics></math> by removing all terms which are divisible (in the twisted commutative algebra <math id="S10.I3.i2.p1.m4" class="ltx_Math" alttext="R_{3}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>3</mn></msub><annotation encoding="application/x-tex">R_{3}</annotation></semantics></math>) by <math id="S10.I3.i2.p1.m5" class="ltx_Math" alttext="1\in R^{0}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>∈</mo><mrow><msup><mi>R</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1\in R^{0}(C_{g}^{1})</annotation></semantics></math>, <math id="S10.I3.i2.p1.m6" class="ltx_Math" alttext="\psi_{1}\in R^{1}(C_{g}^{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo>∈</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{1}\in R^{1}(C_{g}^{1})</annotation></semantics></math> and <math id="S10.I3.i2.p1.m7" class="ltx_Math" alttext="\Delta_{12}\in R^{1}(C_{g}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo>∈</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>g</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{12}\in R^{1}(C_{g}^{2})</annotation></semantics></math>. Note that this is the relation we used to show that the generator <math id="S10.I3.i2.p1.m8" class="ltx_Math" alttext="\Delta_{123}\psi_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{123}\psi_{1}</annotation></semantics></math> can be expressed in terms of simpler generators in the proof of Theorem <a href="#S9.Thmthm2" title="Theorem 9.2. ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a>.</p>
</div>
<div id="S10.I3.i2.p2" class="ltx_para ltx_noindent">
<p id="S10.I3.i2.p2.1" class="ltx_p">Now consider instead the pushforward of <math id="S10.I3.i2.p2.m1" class="ltx_Math" alttext="\mathsf{FZ}_{3,2,2}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>3</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{3,2,2}</annotation></semantics></math> along a diagonal inclusion <math id="S10.I3.i2.p2.m2" class="ltx_Math" alttext="C_{g}^{2}\hookrightarrow C_{g}^{3}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mi>g</mi><mn>2</mn></msubsup><mo stretchy="false">↪</mo><msubsup><mi>C</mi><mi>g</mi><mn>3</mn></msubsup></mrow><annotation encoding="application/x-tex">C_{g}^{2}\hookrightarrow C_{g}^{3}</annotation></semantics></math>. Modulo <math id="S10.I3.i2.p2.m3" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>, that relation simplifies to</p>
<table id="S10.Ex171" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex171.m1" class="ltx_Math" alttext="-1152\Delta_{123}\psi_{1}+240\Delta_{123}\kappa_{1}\equiv 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mn>1152</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub></mrow></mrow><mo>+</mo><mrow><mn>240</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow></mrow><mo>≡</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-1152\Delta_{123}\psi_{1}+240\Delta_{123}\kappa_{1}\equiv 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S10.I3.i2.p2.2" class="ltx_p">It is now clear that we obtain <math id="S10.I3.i2.p2.m4" class="ltx_Math" alttext="\Delta_{123}\kappa_{1}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{123}\kappa_{1}\equiv 0</annotation></semantics></math>, so that the product of the Gross–Schoen cycle and <math id="S10.I3.i2.p2.m5" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math> vanishes in <math id="S10.I3.i2.p2.m6" class="ltx_Math" alttext="R_{g}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>g</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{g}^{\prime\prime}</annotation></semantics></math>.</p>
</div></li>
<li id="S10.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S10.I3.i3.p1" class="ltx_para ltx_noindent">
<p id="S10.I3.i3.p1.1" class="ltx_p">Observe first of all that modulo the relation <math id="S10.I3.i3.p1.m1" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>, the only nonzero monomials in <math id="S10.I3.i3.p1.m2" class="ltx_Math" alttext="S_{6}^{4}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mn>6</mn><mn>4</mn></msubsup><annotation encoding="application/x-tex">S_{6}^{4}</annotation></semantics></math> (see Definition <a href="#S5.Thmthm2" title="Definition 5.2. ‣ 5. The Künneth decomposition of the tautological ring ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>) are <math id="S10.I3.i3.p1.m3" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}</annotation></semantics></math> and its <math id="S10.I3.i3.p1.m4" class="ltx_Math" alttext="\mathfrak{S}_{6}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{6}</annotation></semantics></math>-conjugates.</p>
</div>
<div id="S10.I3.i3.p2" class="ltx_para ltx_noindent">
<p id="S10.I3.i3.p2.1" class="ltx_p">For distinct elements <math id="S10.I3.i3.p2.m1" class="ltx_Math" alttext="i,j\in\{1,...,6\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>6</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in\{1,...,6\}</annotation></semantics></math>, consider the pushforward of the relation <math id="S10.I3.i3.p2.m2" class="ltx_Math" alttext="\mathsf{FZ}_{3,5,3}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{3,5,3}</annotation></semantics></math> along the corresponding diagonal inclusion. The observation just made, and the fact that <math id="S10.I3.i3.p2.m3" class="ltx_Math" alttext="\mathsf{FZ}_{3,5,3}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{3,5,3}</annotation></semantics></math> is <math id="S10.I3.i3.p2.m4" class="ltx_Math" alttext="\mathfrak{S}_{5}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mn>5</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{5}</annotation></semantics></math>-invariant, implies that the resulting relation takes the form</p>
<table id="S10.Ex172" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex172.m1" class="ltx_Math" alttext="\sum_{\begin{subarray}{c}S\sqcup T=\{1,\ldots,6\}\\
|S|=|T|=3\\
i,j\in S\end{subarray}}\Delta_{S}\Delta_{T}\equiv 0" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>S</mi><mo>⊔</mo><mi>T</mi></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>6</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>T</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>3</mn></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mi>S</mi></mrow></mtd></mtr></mtable></munder><mrow><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub></mrow></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{\begin{subarray}{c}S\sqcup T=\{1,\ldots,6\}\\
|S|=|T|=3\\
i,j\in S\end{subarray}}\Delta_{S}\Delta_{T}\equiv 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S10.I3.i3.p2.2" class="ltx_p">(up to a nonzero constant), as all other terms in the pushforward of <math id="S10.I3.i3.p2.m5" class="ltx_Math" alttext="\mathsf{FZ}_{3,5,3}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{3,5,3}</annotation></semantics></math> vanish modulo <math id="S10.I3.i3.p2.m6" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>. We think of these relations as <math id="S10.I3.i3.p2.m7" class="ltx_Math" alttext="\binom{6}{2}=15" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mn>6</mn><mn>2</mn></mfrac><mo>)</mo></mrow><mo>=</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">\binom{6}{2}=15</annotation></semantics></math> equations in <math id="S10.I3.i3.p2.m8" class="ltx_Math" alttext="\frac{1}{2}\binom{6}{3}=10" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mn>6</mn><mn>3</mn></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">\frac{1}{2}\binom{6}{3}=10</annotation></semantics></math> unknowns <math id="S10.I3.i3.p2.m9" class="ltx_Math" alttext="\Delta_{S}\Delta_{T}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub></mrow><annotation encoding="application/x-tex">\Delta_{S}\Delta_{T}</annotation></semantics></math>. It is a simple matter of linear algebra to check that the matrix of equations has full rank, so that <math id="S10.I3.i3.p2.m10" class="ltx_Math" alttext="\Delta_{S}\Delta_{T}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{S}\Delta_{T}\equiv 0</annotation></semantics></math> for all <math id="S10.I3.i3.p2.m11" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, <math id="S10.I3.i3.p2.m12" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S10.SS2.p3" class="ltx_para ltx_noindent">
<p id="S10.SS2.p3.1" class="ltx_p">We should also verify that <math id="S10.SS2.p3.m1" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math> and the Gross–Schoen cycle are both nonzero in genus three, and that Poincaré duality holds. Nonvanishing of <math id="S10.SS2.p3.m2" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math> is well known. The square of the Gross–Schoen cycle, pushed down to <math id="S10.SS2.p3.m3" class="ltx_Math" alttext="M_{3}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>3</mn></msub><annotation encoding="application/x-tex">M_{3}</annotation></semantics></math>, equals <math id="S10.SS2.p3.m4" class="ltx_Math" alttext="\frac{7}{4}\kappa_{1}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>7</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\frac{7}{4}\kappa_{1}</annotation></semantics></math> (as one can verify on a computer). This proves both nonvanishing of the Gross–Schoen cycle and Poincaré duality, since the pairing <math id="S10.SS2.p3.m5" class="ltx_Math" alttext="R^{2}(M_{3},\mathbf{V}_{\langle 1,1,1\rangle})\otimes R^{2}(M_{3},\mathbf{V}_{\langle 1,1,1\rangle})\to R^{1}(M_{3},\mathbf{V}_{\langle 0\rangle})\cong\mathbf{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><annotation encoding="application/x-tex">R^{2}(M_{3},\mathbf{V}_{\langle 1,1,1\rangle})\otimes R^{2}(M_{3},\mathbf{V}_{\langle 1,1,1\rangle})\to R^{1}(M_{3},\mathbf{V}_{\langle 0\rangle})\cong\mathbf{Q}</annotation></semantics></math> is exactly given by multiplying the two cycles and pushing the result down to <math id="S10.SS2.p3.m6" class="ltx_Math" alttext="M_{3}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>3</mn></msub><annotation encoding="application/x-tex">M_{3}</annotation></semantics></math>. This proves the genus <math id="S10.SS2.p3.m7" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> case of Theorem <a href="#S10.Thmthm1" title="Theorem 10.1. ‣ 10. Low genus calculations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10.1</span></a>.</p>
</div>
</section>
<section id="S10.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">10.3. </span>Genus four</h3>

<div id="S10.SS3.p1" class="ltx_para ltx_noindent">
<p id="S10.SS3.p1.1" class="ltx_p">By Corollary <a href="#S8.Thmthm10" title="Corollary 8.10. ‣ 8. Twisted commutative algebras and tautological rings ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.10</span></a> and Proposition <a href="#S9.Thmthm2" title="Theorem 9.2. ‣ 9. A consequence of the FZ relations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a> we now have three generators for the twisted commutative algebra <math id="S10.SS3.p1.m1" class="ltx_Math" alttext="R_{4}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>4</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{4}^{\prime\prime}</annotation></semantics></math>: <math id="S10.SS3.p1.m2" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math>, the Gross–Schoen cycle, and the Faber–Pandharipande cycle.</p>
</div>
<div id="S10.SS3.p2" class="ltx_para ltx_noindent">
<p id="S10.SS3.p2.1" class="ltx_p">We claim that <math id="S10.SS3.p2.m1" class="ltx_Math" alttext="\kappa_{1}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>κ</mi><mn>1</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\kappa_{1}^{2}</annotation></semantics></math> and the product of <math id="S10.SS3.p2.m2" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math> and the Gross–Schoen cycle are both nonzero in <math id="S10.SS3.p2.m3" class="ltx_Math" alttext="R_{4}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>4</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{4}^{\prime\prime}</annotation></semantics></math>. Moreover, let us consider the product of two Gross–Schoen cycles. If we consider the subspace of the twisted commutative algebra <math id="S10.SS3.p2.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> spanned by all possible products of two classes <math id="S10.SS3.p2.m5" class="ltx_Math" alttext="D_{3,0}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mn>3</mn><mo>,</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">D_{3,0}</annotation></semantics></math>, then this decomposes as a representation
of <math id="S10.SS3.p2.m6" class="ltx_Math" alttext="\mathfrak{S}_{6}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{6}</annotation></semantics></math> as <math id="S10.SS3.p2.m7" class="ltx_Math" alttext="\sigma_{4,2}\oplus\sigma_{6}=\Ind_{(\mathfrak{S}_{3})^{2}\rtimes\mathfrak{S}_{2}}^{\mathfrak{S}_{6}}\mathbf{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mrow><mn>4</mn><mo>,</mo><mn>2</mn></mrow></msub><mo>⊕</mo><msub><mi>σ</mi><mn>6</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>Ind</mi><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝔖</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋊</mo><msub><mi>𝔖</mi><mn>2</mn></msub></mrow><msub><mi>𝔖</mi><mn>6</mn></msub></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mn>𝟏</mn></mrow></mrow><annotation encoding="application/x-tex">\sigma_{4,2}\oplus\sigma_{6}=\Ind_{(\mathfrak{S}_{3})^{2}\rtimes\mathfrak{S}_{2}}^{\mathfrak{S}_{6}}\mathbf{1}</annotation></semantics></math>. We claim that the representation <math id="S10.SS3.p2.m8" class="ltx_Math" alttext="\sigma_{6}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\sigma_{6}</annotation></semantics></math> goes to zero in <math id="S10.SS3.p2.m9" class="ltx_Math" alttext="R_{4}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>4</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{4}^{\prime\prime}</annotation></semantics></math>, but that the representation <math id="S10.SS3.p2.m10" class="ltx_Math" alttext="\sigma_{4,2}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mrow><mn>4</mn><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\sigma_{4,2}</annotation></semantics></math> survives to <math id="S10.SS3.p2.m11" class="ltx_Math" alttext="R_{4}^{\prime\prime}(6)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mn>4</mn><mo>′′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>6</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{4}^{\prime\prime}(6)</annotation></semantics></math>.</p>
</div>
<div id="S10.SS3.p3" class="ltx_para ltx_noindent">
<p id="S10.SS3.p3.1" class="ltx_p">Finally, we also claim that all other products of generators for the twisted commutative algebra <math id="S10.SS3.p3.m1" class="ltx_Math" alttext="R_{4}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>4</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{4}^{\prime\prime}</annotation></semantics></math> vanish. More precisely, we need to check the following relations:</p>
<ol id="S10.I4" class="ltx_enumerate">
<li id="S10.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S10.I4.i1.p1" class="ltx_para ltx_noindent">
<p id="S10.I4.i1.p1.1" class="ltx_p"><math id="S10.I4.i1.p1.m1" class="ltx_Math" alttext="\kappa_{1}^{3}\equiv 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mn>1</mn><mn>3</mn></msubsup><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa_{1}^{3}\equiv 0</annotation></semantics></math></p>
</div></li>
<li id="S10.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S10.I4.i2.p1" class="ltx_para ltx_noindent">
<p id="S10.I4.i2.p1.1" class="ltx_p"><math id="S10.I4.i2.p1.m1" class="ltx_Math" alttext="\kappa_{1}^{2}\Delta_{123}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>κ</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa_{1}^{2}\Delta_{123}\equiv 0</annotation></semantics></math></p>
</div></li>
<li id="S10.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S10.I4.i3.p1" class="ltx_para ltx_noindent">
<p id="S10.I4.i3.p1.1" class="ltx_p"><math id="S10.I4.i3.p1.m1" class="ltx_Math" alttext="\kappa_{1}\Delta_{12}\psi_{1}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>κ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa_{1}\Delta_{12}\psi_{1}\equiv 0</annotation></semantics></math></p>
</div></li>
<li id="S10.I4.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S10.I4.i4.p1" class="ltx_para ltx_noindent">
<p id="S10.I4.i4.p1.1" class="ltx_p"><math id="S10.I4.i4.p1.m1" class="ltx_Math" alttext="\sum_{\begin{subarray}{c}S\sqcup T=\{1,\ldots,6\}\\
|S|=|T|=3\end{subarray}}\Delta_{S}\Delta_{T}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>S</mi><mo>⊔</mo><mi>T</mi></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>6</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>T</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>3</mn></mrow></mtd></mtr></mtable></msub><mrow><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub></mrow></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{\begin{subarray}{c}S\sqcup T=\{1,\ldots,6\}\\
|S|=|T|=3\end{subarray}}\Delta_{S}\Delta_{T}\equiv 0</annotation></semantics></math></p>
</div></li>
<li id="S10.I4.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S10.I4.i5.p1" class="ltx_para ltx_noindent">
<p id="S10.I4.i5.p1.1" class="ltx_p"><math id="S10.I4.i5.p1.m1" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}\Delta_{789}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>789</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}\Delta_{789}\equiv 0</annotation></semantics></math></p>
</div></li>
<li id="S10.I4.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(6)</span> 
<div id="S10.I4.i6.p1" class="ltx_para ltx_noindent">
<p id="S10.I4.i6.p1.1" class="ltx_p"><math id="S10.I4.i6.p1.m1" class="ltx_Math" alttext="\Delta_{123}\Delta_{45}\psi_{4}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>45</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>4</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{45}\psi_{4}\equiv 0</annotation></semantics></math></p>
</div></li>
<li id="S10.I4.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(7)</span> 
<div id="S10.I4.i7.p1" class="ltx_para ltx_noindent">
<p id="S10.I4.i7.p1.1" class="ltx_p"><math id="S10.I4.i7.p1.m1" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}\kappa_{1}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}\kappa_{1}\equiv 0</annotation></semantics></math></p>
</div></li>
<li id="S10.I4.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(8)</span> 
<div id="S10.I4.i8.p1" class="ltx_para">
<p id="S10.I4.i8.p1.1" class="ltx_p"><math id="S10.I4.i8.p1.m1" class="ltx_Math" alttext="\Delta_{12}\psi_{1}\Delta_{34}\psi_{3}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>34</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>3</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{12}\psi_{1}\Delta_{34}\psi_{3}\equiv 0</annotation></semantics></math></p>
</div></li>
</ol>
</div>
<div id="S10.SS3.p4" class="ltx_para ltx_noindent">
<p id="S10.SS3.p4.1" class="ltx_p">(1) It’s well known that <math id="S10.SS3.p4.m1" class="ltx_Math" alttext="\kappa_{1}^{3}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mn>1</mn><mn>3</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa_{1}^{3}=0</annotation></semantics></math>.</p>
</div>
<div id="S10.SS3.p5" class="ltx_para ltx_noindent">
<p id="S10.SS3.p5.1" class="ltx_p">(2) Modulo <math id="S10.SS3.p5.m1" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math> the only nonzero monomials in <math id="S10.SS3.p5.m2" class="ltx_Math" alttext="S_{3}^{4}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mn>3</mn><mn>4</mn></msubsup><annotation encoding="application/x-tex">S_{3}^{4}</annotation></semantics></math> are <math id="S10.SS3.p5.m3" class="ltx_Math" alttext="\Delta_{123}\psi_{1}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\Delta_{123}\psi_{1}^{2}</annotation></semantics></math>, <math id="S10.SS3.p5.m4" class="ltx_Math" alttext="\Delta_{123}\psi_{1}\kappa_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{123}\psi_{1}\kappa_{1}</annotation></semantics></math>, <math id="S10.SS3.p5.m5" class="ltx_Math" alttext="\Delta_{123}\kappa_{1}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mn>1</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\Delta_{123}\kappa_{1}^{2}</annotation></semantics></math>, and the <math id="S10.SS3.p5.m6" class="ltx_Math" alttext="\mathfrak{S}_{3}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{3}</annotation></semantics></math>-conjugates of <math id="S10.SS3.p5.m7" class="ltx_Math" alttext="\psi_{1}^{2}\Delta_{23}\psi_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>23</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\psi_{1}^{2}\Delta_{23}\psi_{2}</annotation></semantics></math>. The relation <math id="S10.SS3.p5.m8" class="ltx_Math" alttext="\mathsf{FZ}_{4,1,2}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,1,2}</annotation></semantics></math> reduces to <math id="S10.SS3.p5.m9" class="ltx_Math" alttext="\psi_{1}^{2}\equiv 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\psi_{1}^{2}\equiv 0</annotation></semantics></math>, which also implies <math id="S10.SS3.p5.m10" class="ltx_Math" alttext="\psi_{1}^{2}\Delta_{23}\psi_{2}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>23</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>2</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\psi_{1}^{2}\Delta_{23}\psi_{2}\equiv 0</annotation></semantics></math>. This leaves us with three potentially nonzero monomials. But <math id="S10.SS3.p5.m11" class="ltx_Math" alttext="\mathsf{FZ}_{4,3,4}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,3,4}</annotation></semantics></math>, the pushforward along a diagonal of <math id="S10.SS3.p5.m12" class="ltx_Math" alttext="\mathsf{FZ}_{4,2,3}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,2,3}</annotation></semantics></math>, and the pushforward of <math id="S10.SS3.p5.m13" class="ltx_Math" alttext="\mathsf{FZ}_{4,1,2}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,1,2}</annotation></semantics></math>, gives us three linearly independent linear relations between these monomials modulo <math id="S10.SS3.p5.m14" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>.</p>
</div>
<div id="S10.SS3.p6" class="ltx_para ltx_noindent">
<p id="S10.SS3.p6.1" class="ltx_p">(3) The only nonzero monomials in <math id="S10.SS3.p6.m1" class="ltx_Math" alttext="S_{2}^{3}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mn>2</mn><mn>3</mn></msubsup><annotation encoding="application/x-tex">S_{2}^{3}</annotation></semantics></math> modulo <math id="S10.SS3.p6.m2" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math> are <math id="S10.SS3.p6.m3" class="ltx_Math" alttext="\Delta_{12}\psi_{1}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\Delta_{12}\psi_{1}^{2}</annotation></semantics></math> and <math id="S10.SS3.p6.m4" class="ltx_Math" alttext="\Delta_{12}\kappa_{1}\psi_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{12}\kappa_{1}\psi_{1}</annotation></semantics></math>. The relations <math id="S10.SS3.p6.m5" class="ltx_Math" alttext="\mathsf{FZ}_{4,2,3}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,2,3}</annotation></semantics></math> and the pushforward of the relation <math id="S10.SS3.p6.m6" class="ltx_Math" alttext="\mathsf{FZ}_{4,1,2}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,1,2}</annotation></semantics></math> along the diagonal give two distinct linear relations between these monomials modulo <math id="S10.SS3.p6.m7" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>, so both are zero modulo <math id="S10.SS3.p6.m8" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>.</p>
</div>
<div id="S10.SS3.p7" class="ltx_para ltx_noindent">
<p id="S10.SS3.p7.1" class="ltx_p">(4) The relation <math id="S10.SS3.p7.m1" class="ltx_Math" alttext="\psi_{7}\cdot\mathsf{FZ}_{4,7,4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mn>7</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>7</mn><mo>,</mo><mn>4</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\psi_{7}\cdot\mathsf{FZ}_{4,7,4}</annotation></semantics></math>, pushed down along the forgetful map that forgets the <math id="S10.SS3.p7.m2" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math>th marked point, reduces to this expression modulo <math id="S10.SS3.p7.m3" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>. Alternatively, since the expression is <math id="S10.SS3.p7.m4" class="ltx_Math" alttext="\mathfrak{S}_{6}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{6}</annotation></semantics></math>-invariant, its image in <math id="S10.SS3.p7.m5" class="ltx_Math" alttext="R_{4}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>4</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{4}^{\prime\prime}</annotation></semantics></math> lands in the summand <math id="S10.SS3.p7.m6" class="ltx_Math" alttext="R^{\bullet}(M_{4},\mathbf{V}_{\langle 1,1,1,1,1,1\rangle})\otimes\sigma_{6}^{\ast}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mn>6</mn><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">R^{\bullet}(M_{4},\mathbf{V}_{\langle 1,1,1,1,1,1\rangle})\otimes\sigma_{6}^{\ast}</annotation></semantics></math>. But the motive <math id="S10.SS3.p7.m7" class="ltx_Math" alttext="\mathbf{V}_{\langle 1,1,1,1,1,1\rangle}" display="inline" intent=":literal"><semantics><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msub><annotation encoding="application/x-tex">\mathbf{V}_{\langle 1,1,1,1,1,1\rangle}</annotation></semantics></math> is zero.</p>
</div>
<div id="S10.SS3.p8" class="ltx_para ltx_noindent">
<p id="S10.SS3.p8.1" class="ltx_p">(5) Modulo <math id="S10.SS3.p8.m1" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>, the only nonzero monomials in <math id="S10.SS3.p8.m2" class="ltx_Math" alttext="S_{9}^{6}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mn>9</mn><mn>6</mn></msubsup><annotation encoding="application/x-tex">S_{9}^{6}</annotation></semantics></math> are the <math id="S10.SS3.p8.m3" class="ltx_Math" alttext="\mathfrak{S}_{9}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mn>9</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{9}</annotation></semantics></math>-conjugates of <math id="S10.SS3.p8.m4" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}\Delta_{789}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>789</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}\Delta_{789}</annotation></semantics></math>. For any four indices <math id="S10.SS3.p8.m5" class="ltx_Math" alttext="i,j,k,l" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">i,j,k,l</annotation></semantics></math> we may consider the pushforward of <math id="S10.SS3.p8.m6" class="ltx_Math" alttext="\mathsf{FZ}_{4,7,4}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>7</mn><mo>,</mo><mn>4</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,7,4}</annotation></semantics></math> along the <math id="S10.SS3.p8.m7" class="ltx_Math" alttext="i,j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i,j</annotation></semantics></math>-th and <math id="S10.SS3.p8.m8" class="ltx_Math" alttext="k,l" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">k,l</annotation></semantics></math>-th diagonal, to get a relation which up to a scalar must equal</p>
<table id="S10.Ex173" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex173.m1" class="ltx_Math" alttext="\sum_{\begin{subarray}{c}S\sqcup T\sqcup U=\{1,\ldots,9\}\\
|S|=|T|=|U|=3\\
i,j\in S\,\,k,l\in T\end{subarray}}\Delta_{S}\Delta_{T}\Delta_{U}\equiv 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>S</mi><mo>⊔</mo><mi>T</mi><mo>⊔</mo><mi>U</mi></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>9</mn><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>T</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>U</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>3</mn></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mi>S</mi><mo lspace="0.340em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo>,</mo><mrow><mi>l</mi><mo>∈</mo><mi>T</mi></mrow></mrow></mtd></mtr></mtable></munder><mrow><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>U</mi></msub></mrow></mrow><mo>≡</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{\begin{subarray}{c}S\sqcup T\sqcup U=\{1,\ldots,9\}\\
|S|=|T|=|U|=3\\
i,j\in S\,\,k,l\in T\end{subarray}}\Delta_{S}\Delta_{T}\Delta_{U}\equiv 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S10.SS3.p8.2" class="ltx_p">This gives <math id="S10.SS3.p8.m9" class="ltx_Math" alttext="\frac{1}{2}\binom{9}{2,2,5}=378" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mn>9</mn><mrow><mn>2</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>5</mn></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mn>378</mn></mrow><annotation encoding="application/x-tex">\frac{1}{2}\binom{9}{2,2,5}=378</annotation></semantics></math> relations between <math id="S10.SS3.p8.m10" class="ltx_Math" alttext="\frac{1}{3!}\binom{9}{3,3,3}=280" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mrow><mn>3</mn><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mn>9</mn><mrow><mn>3</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>3</mn></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mn>280</mn></mrow><annotation encoding="application/x-tex">\frac{1}{3!}\binom{9}{3,3,3}=280</annotation></semantics></math> unknowns, and one can check using a computer that the resulting matrix has full rank; in particular, <math id="S10.SS3.p8.m11" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}\Delta_{789}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>789</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}\Delta_{789}\equiv 0</annotation></semantics></math>.</p>
</div>
<div id="S10.SS3.p9" class="ltx_para ltx_noindent">
<p id="S10.SS3.p9.1" class="ltx_p">(6) Modulo <math id="S10.SS3.p9.m1" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>, there are exactly <math id="S10.SS3.p9.m2" class="ltx_Math" alttext="11" display="inline" intent=":literal"><semantics><mn>11</mn><annotation encoding="application/x-tex">11</annotation></semantics></math> nonzero monomials in <math id="S10.SS3.p9.m3" class="ltx_Math" alttext="S_{5}^{4}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mn>5</mn><mn>4</mn></msubsup><annotation encoding="application/x-tex">S_{5}^{4}</annotation></semantics></math>: <math id="S10.SS3.p9.m4" class="ltx_Math" alttext="\Delta_{12345}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>12345</mn></msub><annotation encoding="application/x-tex">\Delta_{12345}</annotation></semantics></math>, and the <math id="S10.SS3.p9.m5" class="ltx_Math" alttext="\mathfrak{S}_{5}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mn>5</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{5}</annotation></semantics></math>-conjugates of <math id="S10.SS3.p9.m6" class="ltx_Math" alttext="\Delta_{123}\Delta_{45}\psi_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>45</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{45}\psi_{4}</annotation></semantics></math>. The relation <math id="S10.SS3.p9.m7" class="ltx_Math" alttext="\mathsf{FZ}_{4,5,4}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>4</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,5,4}</annotation></semantics></math>, and the <math id="S10.SS3.p9.m8" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math> different pushforwards of the relation <math id="S10.SS3.p9.m9" class="ltx_Math" alttext="\mathsf{FZ}_{4,4,3}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,4,3}</annotation></semantics></math> along a diagonal inclusion, give <math id="S10.SS3.p9.m10" class="ltx_Math" alttext="11" display="inline" intent=":literal"><semantics><mn>11</mn><annotation encoding="application/x-tex">11</annotation></semantics></math> linear relations between these monomials modulo <math id="S10.SS3.p9.m11" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>. The resulting <math id="S10.SS3.p9.m12" class="ltx_Math" alttext="11\times 11" display="inline" intent=":literal"><semantics><mrow><mn>11</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">11\times 11</annotation></semantics></math> matrix is invertible and we conclude that <math id="S10.SS3.p9.m13" class="ltx_Math" alttext="\Delta_{123}\Delta_{45}\psi_{4}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>45</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>4</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{45}\psi_{4}\equiv 0</annotation></semantics></math>.</p>
</div>
<div id="S10.SS3.p10" class="ltx_para ltx_noindent">
<p id="S10.SS3.p10.1" class="ltx_p">(7) The nonzero monomials in <math id="S10.SS3.p10.m1" class="ltx_Math" alttext="S_{6}^{5}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mn>6</mn><mn>5</mn></msubsup><annotation encoding="application/x-tex">S_{6}^{5}</annotation></semantics></math> are <math id="S10.SS3.p10.m2" class="ltx_Math" alttext="\Delta_{123456}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>123456</mn></msub><annotation encoding="application/x-tex">\Delta_{123456}</annotation></semantics></math>, <math id="S10.SS3.p10.m3" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}\psi_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}\psi_{1}</annotation></semantics></math>, <math id="S10.SS3.p10.m4" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}\kappa_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}\kappa_{1}</annotation></semantics></math>, <math id="S10.SS3.p10.m5" class="ltx_Math" alttext="\Delta_{12}\Delta_{3456}\psi_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>3456</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{12}\Delta_{3456}\psi_{1}</annotation></semantics></math>, and their <math id="S10.SS3.p10.m6" class="ltx_Math" alttext="\mathfrak{S}_{6}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{6}</annotation></semantics></math>-conjugates. This implies that the relation <math id="S10.SS3.p10.m7" class="ltx_Math" alttext="\mathsf{FZ}_{4,5,4}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>4</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,5,4}</annotation></semantics></math>, pushed forward along the <math id="S10.SS3.p10.m8" class="ltx_Math" alttext="i,j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i,j</annotation></semantics></math>-th diagonal and multiplied with <math id="S10.SS3.p10.m9" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math>, must be equal to</p>
<table id="S10.Ex174" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.Ex174.m1" class="ltx_Math" alttext="\sum_{\begin{subarray}{c}S\sqcup T=\{1,\ldots,6\}\\
|S|=|T|=3\\
i,j\in S\end{subarray}}\Delta_{S}\Delta_{T}\kappa_{1}\equiv 0" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>S</mi><mo>⊔</mo><mi>T</mi></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>6</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>T</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>3</mn></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mi>S</mi></mrow></mtd></mtr></mtable></munder><mrow><msub><mi mathvariant="normal">Δ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{\begin{subarray}{c}S\sqcup T=\{1,\ldots,6\}\\
|S|=|T|=3\\
i,j\in S\end{subarray}}\Delta_{S}\Delta_{T}\kappa_{1}\equiv 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S10.SS3.p10.2" class="ltx_p">up to a nonzero scalar, since all the monomials involved in this relation must involve <math id="S10.SS3.p10.m10" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math> and have <math id="S10.SS3.p10.m11" class="ltx_Math" alttext="i,j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i,j</annotation></semantics></math> in the same diagonal block. But this implies <math id="S10.SS3.p10.m12" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}\kappa_{1}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}\kappa_{1}\equiv 0</annotation></semantics></math> by the same calculation as for relation (3) in genus <math id="S10.SS3.p10.m13" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>.</p>
</div>
<div id="S10.SS3.p11" class="ltx_para ltx_noindent">
<p id="S10.SS3.p11.1" class="ltx_p">(8) The nonzero monomials in <math id="S10.SS3.p11.m1" class="ltx_Math" alttext="S_{4}^{4}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mn>4</mn><mn>4</mn></msubsup><annotation encoding="application/x-tex">S_{4}^{4}</annotation></semantics></math> are <math id="S10.SS3.p11.m2" class="ltx_Math" alttext="\Delta_{12}\psi_{1}\Delta_{34}\psi_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>34</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{12}\psi_{1}\Delta_{34}\psi_{3}</annotation></semantics></math>, <math id="S10.SS3.p11.m3" class="ltx_Math" alttext="\psi_{1}^{2}\Delta_{234}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>234</mn></msub></mrow><annotation encoding="application/x-tex">\psi_{1}^{2}\Delta_{234}</annotation></semantics></math>, <math id="S10.SS3.p11.m4" class="ltx_Math" alttext="\Delta_{1234}\psi_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1234</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{1234}\psi_{1}</annotation></semantics></math>, <math id="S10.SS3.p11.m5" class="ltx_Math" alttext="\Delta_{1234}\kappa_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1234</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{1234}\kappa_{1}</annotation></semantics></math> and their <math id="S10.SS3.p11.m6" class="ltx_Math" alttext="\mathfrak{S}_{4}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathfrak{S}_{4}</annotation></semantics></math>-conjugates. Since <math id="S10.SS3.p11.m7" class="ltx_Math" alttext="\psi_{1}^{2}\equiv 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\psi_{1}^{2}\equiv 0</annotation></semantics></math>, as observed in (2) above, we will also have <math id="S10.SS3.p11.m8" class="ltx_Math" alttext="\psi_{1}^{2}\Delta_{234}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>234</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\psi_{1}^{2}\Delta_{234}\equiv 0</annotation></semantics></math>. Moreover, the relation <math id="S10.SS3.p11.m9" class="ltx_Math" alttext="\mathsf{FZ}_{4,4,3}" display="inline" intent=":literal"><semantics><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{FZ}_{4,4,3}</annotation></semantics></math> simplifies to <math id="S10.SS3.p11.m10" class="ltx_Math" alttext="\Delta_{1234}\equiv 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1234</mn></msub><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{1234}\equiv 0</annotation></semantics></math>, so that also <math id="S10.SS3.p11.m11" class="ltx_Math" alttext="\Delta_{1234}\kappa_{1}\equiv 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1234</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{1234}\kappa_{1}\equiv 0</annotation></semantics></math>. This leaves only four potentially nonzero monomials. The relations given by <math id="S10.SS3.p11.m12" class="ltx_Math" alttext="\psi_{1}\cdot\mathsf{FZ}_{4,4,3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\psi_{1}\cdot\mathsf{FZ}_{4,4,3}</annotation></semantics></math>, <math id="S10.SS3.p11.m13" class="ltx_Math" alttext="\Delta_{12}\cdot\mathsf{FZ}_{4,4,3}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\Delta_{12}\cdot\mathsf{FZ}_{4,4,3}</annotation></semantics></math>, <math id="S10.SS3.p11.m14" class="ltx_Math" alttext="\Delta_{13}\cdot\mathsf{FZ}_{4,4,3}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>13</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\Delta_{13}\cdot\mathsf{FZ}_{4,4,3}</annotation></semantics></math> and <math id="S10.SS3.p11.m15" class="ltx_Math" alttext="\Delta_{1,4}\cdot\mathsf{FZ}_{4,4,3}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mn>1</mn><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝖥𝖹</mi><mrow><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\Delta_{1,4}\cdot\mathsf{FZ}_{4,4,3}</annotation></semantics></math> give four linearly independent relations between these monomials, and we conclude that they all vanish modulo <math id="S10.SS3.p11.m16" class="ltx_Math" alttext="\equiv" display="inline" intent=":literal"><semantics><mo>≡</mo><annotation encoding="application/x-tex">\equiv</annotation></semantics></math>.</p>
</div>
<div id="S10.SS3.p12" class="ltx_para ltx_noindent">
<p id="S10.SS3.p12.1" class="ltx_p">We should also prove that all these cycles are nonzero and that Poincaré duality holds. We use that the relation <math id="S10.SS3.p12.m1" class="ltx_Math" alttext="3\kappa_{1}^{2}=-32\kappa_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo rspace="0em">=</mo><mrow><mo lspace="0em">−</mo><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">3\kappa_{1}^{2}=-32\kappa_{2}</annotation></semantics></math> holds in <math id="S10.SS3.p12.m2" class="ltx_Math" alttext="R^{2}(M_{4})=\mathbf{Q}\{\kappa_{1}^{2}\}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝐐</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>κ</mi><mn>1</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{2}(M_{4})=\mathbf{Q}\{\kappa_{1}^{2}\}</annotation></semantics></math>. The Gross–Schoen cycle squared, pushed down to <math id="S10.SS3.p12.m3" class="ltx_Math" alttext="M_{4}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>4</mn></msub><annotation encoding="application/x-tex">M_{4}</annotation></semantics></math>, equals <math id="S10.SS3.p12.m4" class="ltx_Math" alttext="\frac{3}{2}\kappa_{1}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>3</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\frac{3}{2}\kappa_{1}</annotation></semantics></math>. This shows both that the Gross–Schoen cycle is nonzero and that its product with <math id="S10.SS3.p12.m5" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math> is nonzero. The Faber–Pandharipande cycle squared, pushed down to <math id="S10.SS3.p12.m6" class="ltx_Math" alttext="M_{4}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>4</mn></msub><annotation encoding="application/x-tex">M_{4}</annotation></semantics></math>, equals <math id="S10.SS3.p12.m7" class="ltx_Math" alttext="\frac{19}{96}\kappa_{1}^{2}-\frac{4}{3}\kappa_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>19</mn><mn>96</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mfrac><mn>4</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\frac{19}{96}\kappa_{1}^{2}-\frac{4}{3}\kappa_{2}</annotation></semantics></math>, which is then also nonzero. The projection of <math id="S10.SS3.p12.m8" class="ltx_Math" alttext="\Delta_{123}\Delta_{456}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>456</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{123}\Delta_{456}</annotation></semantics></math> onto <math id="S10.SS3.p12.m9" class="ltx_Math" alttext="R^{4}(M_{4},\mathbf{V}_{\langle 2,2,1,1\rangle})\otimes\sigma_{4,2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mrow><mn>2</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>σ</mi><mrow><mn>4</mn><mo>,</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">R^{4}(M_{4},\mathbf{V}_{\langle 2,2,1,1\rangle})\otimes\sigma_{4,2}</annotation></semantics></math>, squared and pushed down to <math id="S10.SS3.p12.m10" class="ltx_Math" alttext="M_{4}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>4</mn></msub><annotation encoding="application/x-tex">M_{4}</annotation></semantics></math>, equals <math id="S10.SS3.p12.m11" class="ltx_Math" alttext="\frac{19877}{29160}\kappa_{1}^{2}-\frac{25}{729}\kappa_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>19877</mn><mn>29160</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>κ</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mfrac><mn>25</mn><mn>729</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\frac{19877}{29160}\kappa_{1}^{2}-\frac{25}{729}\kappa_{2}</annotation></semantics></math>, which is then also nonzero.</p>
</div>
<div id="S10.SS3.p13" class="ltx_para ltx_noindent">
<p id="S10.SS3.p13.1" class="ltx_p">This settles the genus <math id="S10.SS3.p13.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> case, and hence concludes the proof of Theorem <a href="#S10.Thmthm1" title="Theorem 10.1. ‣ 10. Low genus calculations ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10.1</span></a>.</p>
</div>
</section>
<section id="S10.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">10.4. </span>Genus five</h3>

<div id="S10.SS4.p1" class="ltx_para ltx_noindent">
<p id="S10.SS4.p1.1" class="ltx_p">Let us briefly comment on the situation in genus <math id="S10.SS4.p1.m1" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>. The generators for the twisted commutative algebra <math id="S10.SS4.p1.m2" class="ltx_Math" alttext="R_{5}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mn>5</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">R_{5}^{\prime\prime}</annotation></semantics></math> are <math id="S10.SS4.p1.m3" class="ltx_Math" alttext="\kappa_{1}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\kappa_{1}</annotation></semantics></math>, <math id="S10.SS4.p1.m4" class="ltx_Math" alttext="\psi_{1}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\psi_{1}^{2}</annotation></semantics></math>, <math id="S10.SS4.p1.m5" class="ltx_Math" alttext="\Delta_{12}\psi_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{12}\psi_{1}</annotation></semantics></math>, <math id="S10.SS4.p1.m6" class="ltx_Math" alttext="\Delta_{123}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>123</mn></msub><annotation encoding="application/x-tex">\Delta_{123}</annotation></semantics></math>, and <math id="S10.SS4.p1.m7" class="ltx_Math" alttext="\Delta_{1234}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1234</mn></msub><annotation encoding="application/x-tex">\Delta_{1234}</annotation></semantics></math>. For <math id="S10.SS4.p1.m8" class="ltx_Math" alttext="n\leq 7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n\leq 7</annotation></semantics></math> we find that the algebra <math id="S10.SS4.p1.m9" class="ltx_Math" alttext="R^{\bullet}(C_{5}^{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mn>5</mn><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(C_{5}^{n})</annotation></semantics></math> is Gorenstein, and we can compute the groups <math id="S10.SS4.p1.m10" class="ltx_Math" alttext="R^{\bullet}(M_{5},\mathbf{V}_{\langle\lambda\rangle})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>5</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}(M_{5},\mathbf{V}_{\langle\lambda\rangle})</annotation></semantics></math> for <math id="S10.SS4.p1.m11" class="ltx_Math" alttext="|\lambda|\leq 7" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">|\lambda|\leq 7</annotation></semantics></math> by methods like those used in lower genera. One finds the following table of results, in which the classes in the right hand column project onto generators for the tautological groups listed in the left hand column.</p>
<table id="S10.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S10.Ex175"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S10.Ex175.m1" class="ltx_Math" alttext="\displaystyle R^{0}(M_{5})\cong R^{1}(M_{5})\cong R^{2}(M_{5})\cong R^{3}(M_{5})\cong\mathbf{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><annotation encoding="application/x-tex">\displaystyle R^{0}(M_{5})\cong R^{1}(M_{5})\cong R^{2}(M_{5})\cong R^{3}(M_{5})\cong\mathbf{Q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td></tr></tbody>
<tbody id="S10.Ex176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S10.Ex176.m1" class="ltx_Math" alttext="\displaystyle R^{2}(M_{5},\mathbf{V}_{\langle 1\rangle})\cong\mathbf{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>5</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mn>1</mn><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><annotation encoding="application/x-tex">\displaystyle R^{2}(M_{5},\mathbf{V}_{\langle 1\rangle})\cong\mathbf{Q}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S10.Ex176.m2" class="ltx_Math" alttext="\displaystyle\psi_{1}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>ψ</mi><mn>1</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\psi_{1}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S10.Ex177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S10.Ex177.m1" class="ltx_Math" alttext="\displaystyle R^{2}(M_{5},\mathbf{V}_{\langle 1,1\rangle})\cong R^{3}(M_{5},\mathbf{V}_{\langle 1,1\rangle})\cong\mathbf{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>5</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>R</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>5</mn></msub><mo>,</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">⟨</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>𝐐</mi></mrow><annotation encoding="application/x-tex">\displaystyle R^{2}(M_{5},\mathbf{V}_{\langle 1,1\rangle})\cong R^{3}(M_{5},\mathbf{V}_{\langle 1,1\rangle})\cong\mathbf{Q}</annotation></semantics></math></td>
