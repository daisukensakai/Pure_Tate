0 0.0 1.0 121.72 51.84)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 123.71 51.84)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -200.2 -12.4 L -151.79 -34"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.91322 -0.40746 0.40746 0.91322 -153.36 -33.3)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.91322 -0.40746 0.40746 0.91322 -151.54 -34.11)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -211.79 17.02 L -181.51 29"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.92995 0.36769 -0.36769 0.92995 -181.25 29.1)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -68.7 -46.48 L -43.08 -46.48"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -44.8 -46.48)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -42.8 -46.48)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -123.8 -32.23 L -123.8 28.65"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="miter" transform="matrix(0.0 -1.0 -1.0 0.0 -123.8 -32.23)"><path style="fill:none" d="M 0 2.71 C 0.95 2.71 1.72 2.1 1.72 1.36 C 1.72 0.61 0.95 0 0 0"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 -123.8 28.92)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 102.69 -46.48 L 128.31 -46.48"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 126.59 -46.48)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 128.59 -46.48)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 30.08 -31.59 L 30.08 28.65"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="miter" transform="matrix(0.0 -1.0 -1.0 0.0 30.08 -31.59)"><path style="fill:none" d="M 0 2.71 C 0.95 2.71 1.72 2.1 1.72 1.36 C 1.72 0.61 0.95 0 0 0"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 30.08 28.92)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 202.53 -27.21 L 202.53 28.65"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="miter" transform="matrix(0.0 -1.0 -1.0 0.0 202.53 -27.21)"><path style="fill:none" d="M 0 2.71 C 0.95 2.71 1.72 2.1 1.72 1.36 C 1.72 0.61 0.95 0 0 0"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 202.53 28.92)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
