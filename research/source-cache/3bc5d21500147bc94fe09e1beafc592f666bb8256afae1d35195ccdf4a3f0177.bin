isplay="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces S}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 0.87 22.01 L 32.98 22.01"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 33.25 22.01)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 9.29 27.15)"><foreignObject style="--ltx-fo-width:1.14em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="15.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex32.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces p_{13}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.710em">13</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces p_{13}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -52.96 11.14 L -52.96 -12.66"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -52.96 -12.94)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -49.7 -2.18)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="11.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex32.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces p_{2}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.710em">2</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces p_{2}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 70.16 11.14 L 70.16 -12.66"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 70.16 -12.94)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 73.41 -3.82)"><foreignObject style="--ltx-fo-width:1.57em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.08em;font-size:10pt;" height="7.88" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="21.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex32.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\lambda\times\lambda}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">λ</mi><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><mi mathsize="0.700em">λ</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\lambda\times\lambda}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -33.53 -24.55 L 51.81 -24.55"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 52.09 -24.55)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 6.14 -21.3)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0em;font-size:10pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex32.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\lambda}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">λ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\lambda}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p4.4" class="ltx_p"><span id="S2.SS3.p4.4.1" class="ltx_text">we get <math id="S2.SS3.p4.m3" class="ltx_Math" alttext="(p_{13})_{\ast}(p_{2}^{\ast}(\mathfrak{z}^{\prime})^{2}))=(\lambda\times\lambda)^{\ast}(\lambda_{\ast}(\mathfrak{z}^{\prime})^{2})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>13</mn></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>p</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝔷</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝔷</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(p_{13})_{\ast}(p_{2}^{\ast}(\mathfrak{z}^{\prime})^{2}))=(\lambda\times\lambda)^{\ast}(\lambda_{\ast}(\mathfrak{z}^{\prime})^{2}).</annotation></semantics></math> But now</span></p>
<table id="S2.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex33.m1" class="ltx_Math" alttext="\lambda_{\ast}(\mathfrak{z}^{\prime})^{2}=\lambda_{\ast}(\mathfrak{z}^{2}-\mathfrak{z}\cdot\lambda^{\ast}\lambda_{\ast}\mathfrak{z}^{2}+\frac{1}{4}(\lambda^{\ast}\lambda_{\ast}\mathfrak{z}^{2})^{2})=\lambda_{\ast}(\mathfrak{z}^{2})-\lambda_{\ast}(\mathfrak{z}^{2})+0=0.\qed" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>λ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝔷</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><msub><mi>λ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝔷</mi><mn>2</mn></msup><mo>−</mo><mrow><mrow><mi>𝔷</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>λ</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔷</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>λ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔷</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>λ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔷</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔷</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mn>0</mn></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\lambda_{\ast}(\mathfrak{z}^{\prime})^{2}=\lambda_{\ast}(\mathfrak{z}^{2}-\mathfrak{z}\cdot\lambda^{\ast}\lambda_{\ast}\mathfrak{z}^{2}+\frac{1}{4}(\lambda^{\ast}\lambda_{\ast}\mathfrak{z}^{2})^{2})=\lambda_{\ast}(\mathfrak{z}^{2})-\lambda_{\ast}(\mathfrak{z}^{2})+0=0.\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.Thmthm4" class="ltx_theorem ltx_theorem_remarkx">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmthm4.1" class="ltx_text ltx_font_bold">Remark 2.4</span></span><span id="S2.Thmthm4.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmthm4.p1" class="ltx_para">
<p id="S2.Thmthm4.p1.1" class="ltx_p">The decomposition <math id="S2.Thmthm4.p1.m1" class="ltx_Math" alttext="h(X/S)\cong h^{0}(X/S)\oplus h^{\star}(X/S)\oplus h^{2d}(X/S)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>h</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>h</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h(X/S)\cong h^{0}(X/S)\oplus h^{\star}(X/S)\oplus h^{2d}(X/S)</annotation></semantics></math> is not unique: it depends very much on the choice of a cycle <math id="S2.Thmthm4.p1.m2" class="ltx_Math" alttext="\mathfrak{z}" display="inline" intent=":literal"><semantics><mi>𝔷</mi><annotation encoding="application/x-tex">\mathfrak{z}</annotation></semantics></math>. Nevertheless each of the summands on the right hand side is determined up to a canonical isomorphism, independently of <math id="S2.Thmthm4.p1.m3" class="ltx_Math" alttext="\mathfrak{z}" display="inline" intent=":literal"><semantics><mi>𝔷</mi><annotation encoding="application/x-tex">\mathfrak{z}</annotation></semantics></math>. Indeed after Lemma <a href="#S2.Thmthm2" title="Lemma 2.2. ‣ 2.3. Künneth decomposition, the summands 
          
            
              
              h
              0
            
          
         and 
          
            
              
              h
              
                ⁢
                2
                d ‣ 2. Chow motives ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a> we only need to verify this for <math id="S2.Thmthm4.p1.m4" class="ltx_Math" alttext="h^{1}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mn>1</mn></msup><annotation encoding="application/x-tex">h^{1}</annotation></semantics></math>, and a small verification shows that the diagonal in <math id="S2.Thmthm4.p1.m5" class="ltx_Math" alttext="X\times_{S}X" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></msub><mi>X</mi></mrow><annotation encoding="application/x-tex">X\times_{S}X</annotation></semantics></math> composed with the respective projectors gives the required isomorphism. ∎</p>
</div>
</div>
</section>
<section id="S2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.4. </span>Künneth decomposition for abelian schemes</h3>

<div id="S2.SS4.p1" class="ltx_para ltx_noindent">
<p id="S2.SS4.p1.1" class="ltx_p">The decomposition of Lemma <a href="#S2.Thmthm3" title="Lemma 2.3. ‣ 2.3. Künneth decomposition, the summands 
          
            
              
              h
              0
            
          
         and 
          
            
              
              h
              
                ⁢
                2
                d ‣ 2. Chow motives ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> provides a Künneth decomposition for families of curves (or surfaces with no odd cohomology). The other case we will use in this paper is the existence of a motivic Künneth decomposition for abelian schemes:</p>
</div>
<div id="S2.Thmthm5" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmthm5.1" class="ltx_text ltx_font_bold">Theorem 2.5</span></span><span id="S2.Thmthm5.2" class="ltx_text ltx_font_bold"> </span>(Shermenev, Deninger–Murre, Künnemann)<span id="S2.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmthm5.p1" class="ltx_para ltx_noindent">
<p id="S2.Thmthm5.p1.1" class="ltx_p"><span id="S2.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S2.Thmthm5.p1.m1" class="ltx_Math" alttext="A\to S" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">A\to S</annotation></semantics></math> be an abelian scheme of relative dimension <math id="S2.Thmthm5.p1.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>. There exists a Künneth decomposition</span></p>
<table id="S2.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex34.m1" class="ltx_Math" alttext="h(A/S)\cong\bigoplus_{i=0}^{2g}h^{i}(A/S)" display="block" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≅</mo><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></munderover><mrow><msup><mi>h</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h(A/S)\cong\bigoplus_{i=0}^{2g}h^{i}(A/S)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.Thmthm5.p1.2" class="ltx_p"><span id="S2.Thmthm5.p1.2.1" class="ltx_text ltx_font_italic">in which we have <math id="S2.Thmthm5.p1.m3" class="ltx_Math" alttext="h^{i}(A/S)\cong\Sym^{i}h^{1}(A/S)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><msup><mi>Sym</mi><mi>i</mi></msup><mo lspace="0.167em">⁡</mo><msup><mi>h</mi><mn>1</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{i}(A/S)\cong\Sym^{i}h^{1}(A/S)</annotation></semantics></math> for all <math id="S2.Thmthm5.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and <math id="S2.Thmthm5.p1.m5" class="ltx_Math" alttext="\Sym^{i}h^{1}(A/S)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>Sym</mi><mi>i</mi></msup><mo lspace="0.167em">⁡</mo><msup><mi>h</mi><mn>1</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Sym^{i}h^{1}(A/S)=0</annotation></semantics></math> for <math id="S2.Thmthm5.p1.m6" class="ltx_Math" alttext="i&gt;2g" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><annotation encoding="application/x-tex">i&gt;2g</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.SS4.p2" class="ltx_para ltx_noindent">
<p id="S2.SS4.p2.1" class="ltx_p">Shermenev’s proof of this fact starts by choosing a curve <math id="S2.SS4.p2.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> such that its jacobian maps surjectively onto <math id="S2.SS4.p2.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>. This makes the decomposition highly noncanonical, and limits the construction to the absolute case — there is no reason for a general abelian scheme to be a quotient of the jacobian of a family of curves. By contrast, the constructions of Deninger–Murre <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx10" title="" class="ltx_ref">DM91</a>]</cite> and Künnemann <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx39" title="" class="ltx_ref">Kün94</a>]</cite> use Fourier theory and are canonical and functorial.</p>
</div>
<div id="S2.SS4.p3" class="ltx_para ltx_noindent">
<p id="S2.SS4.p3.1" class="ltx_p">The Deninger–Murre decomposition can be described using <em id="S2.SS4.p3.1.1" class="ltx_emph ltx_font_italic">Manin’s identity principle</em> (see e.g. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx66" title="" class="ltx_ref">Sch94</a>, 2.3]</cite>), which says that although a Chow motive <math id="S2.SS4.p3.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> over <math id="S2.SS4.p3.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is not determined by its Chow groups, it is determined by its Chow groups after any base change; more precisely, the functor that takes a smooth proper morphism <math id="S2.SS4.p3.m3" class="ltx_Math" alttext="f\colon T\to S" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>T</mi><mo stretchy="false">→</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">f\colon T\to S</annotation></semantics></math> to the Chow groups of the relative Chow motive <math id="S2.SS4.p3.m4" class="ltx_Math" alttext="f^{\ast}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">f^{\ast}M</annotation></semantics></math> over <math id="S2.SS4.p3.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, determines <math id="S2.SS4.p3.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> completely. For an abelian scheme <math id="S2.SS4.p3.m7" class="ltx_Math" alttext="A\to S" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">A\to S</annotation></semantics></math> we have the morphism <math id="S2.SS4.p3.m8" class="ltx_Math" alttext="[N]\colon A\to A" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi>A</mi><mo stretchy="false">→</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">[N]\colon A\to A</annotation></semantics></math> of multiplication by <math id="S2.SS4.p3.m9" class="ltx_Math" alttext="N&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N&gt;1</annotation></semantics></math>, and the Chow groups of <math id="S2.SS4.p3.m10" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> (and any base change of <math id="S2.SS4.p3.m11" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>) can be decomposed canonically into eigenspaces for <math id="S2.SS4.p3.m12" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, for all <math id="S2.SS4.p3.m13" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>. The summand <math id="S2.SS4.p3.m14" class="ltx_Math" alttext="h^{i}(A/S)" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h^{i}(A/S)</annotation></semantics></math> in the Deninger–Murre decomposition corresponds to the <math id="S2.SS4.p3.m15" class="ltx_Math" alttext="N^{i}" display="inline" intent=":literal"><semantics><msup><mi>N</mi><mi>i</mi></msup><annotation encoding="application/x-tex">N^{i}</annotation></semantics></math>-eigenspace of the Chow groups of <math id="S2.SS4.p3.m16" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>.</p>
</div>
<div id="S2.Thmthm6" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmthm6.1" class="ltx_text ltx_font_bold">Proposition 2.6</span></span><span id="S2.Thmthm6.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmthm6.p1" class="ltx_para">
<p id="S2.Thmthm6.p1.1" class="ltx_p"><span id="S2.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S2.Thmthm6.p1.m1" class="ltx_Math" alttext="C\to S" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">C\to S</annotation></semantics></math> be a family of smooth curves, and <math id="S2.Thmthm6.p1.m2" class="ltx_Math" alttext="J\to S" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">J\to S</annotation></semantics></math> the jacobian. Then there exists an isomorphism of Chow motives <math id="S2.Thmthm6.p1.m3" class="ltx_Math" alttext="h^{1}(C/S)\cong h^{1}(J/S)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{1}(C/S)\cong h^{1}(J/S)</annotation></semantics></math>, where <math id="S2.Thmthm6.p1.m4" class="ltx_Math" alttext="h^{1}(C/S)" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h^{1}(C/S)</annotation></semantics></math> is the summand of <math id="S2.Thmthm6.p1.m5" class="ltx_Math" alttext="h(C/S)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h(C/S)</annotation></semantics></math> described in Lemma <a href="#S2.Thmthm3" title="Lemma 2.3. ‣ 2.3. Künneth decomposition, the summands 
          
            
              
              h
              0
            
          
         and 
          
            
              
              h
              
                ⁢
                2
                d ‣ 2. Chow motives ‣ Tautological classes with twisted coefficients" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> and <math id="S2.Thmthm6.p1.m6" class="ltx_Math" alttext="h^{1}(J/S)" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h^{1}(J/S)</annotation></semantics></math> is the summand of <math id="S2.Thmthm6.p1.m7" class="ltx_Math" alttext="h(J/S)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h(J/S)</annotation></semantics></math> provided by the decomposition of Deninger–Murre.</span></p>
</div>
</div>
<div id="S2.SS4.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Sketch of proof.</h6>
<div id="S2.SS4.p4" class="ltx_para ltx_noindent">
<p id="S2.SS4.p4.1" class="ltx_p"><span id="S2.SS4.p4.1.1" class="ltx_text">After replacing <math id="S2.SS4.p4.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> with a finite étale Galois cover we may assume that <math id="S2.SS4.p4.m2" class="ltx_Math" alttext="C\to S" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">C\to S</annotation></semantics></math> has a section. It is enough to prove the isomorphism under this assumption; since we work with <math id="S2.SS4.p4.m3" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math>-coefficients we may then take Galois invariants to obtain the conclusion over our original base scheme. The section defines an Abel–Jacobi map <math id="S2.SS4.p4.m4" class="ltx_Math" alttext="C\to J" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">C\to J</annotation></semantics></math> and puts us in the situation considered by Shermenev <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx67" title="" class="ltx_ref">She74</a>]</cite>. Shermenev’s construction provides a motivic Künneth decomposition <math id="S2.SS4.p4.m5" class="ltx_Math" alttext="h(J/S)=\bigoplus_{i}h^{i}(J/S)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mi>i</mi></msub><mrow><msup><mi>h</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h(J/S)=\bigoplus_{i}h^{i}(J/S)</annotation></semantics></math> for which it is clear from construction that <math id="S2.SS4.p4.m6" class="ltx_Math" alttext="h^{1}(C/S)=h^{1}(J/S)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{1}(C/S)=h^{1}(J/S)</annotation></semantics></math>. Unfortunately the resulting motivic decomposition of <math id="S2.SS4.p4.m7" class="ltx_Math" alttext="h(J/S)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h(J/S)</annotation></semantics></math> is in general different from that of Deninger–Murre.</span></p>
</div>
<div id="S2.SS4.p5" class="ltx_para">
<p id="S2.SS4.p5.1" class="ltx_p"><span id="S2.SS4.p5.1.1" class="ltx_text">The claim is now that even though the two direct sum decompositions of the Chow groups of <math id="S2.SS4.p5.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> are different, they give rise to the same descending filtration of the Chow groups, so that the two associated graded objects are isomorphic. Since <math id="S2.SS4.p5.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is arbitrary it will then hold also after base change to an arbitrary smooth proper <math id="S2.SS4.p5.m3" class="ltx_Math" alttext="S^{\prime}\to S" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">S^{\prime}\to S</annotation></semantics></math>, and from Manin’s identity principle it will then follow that the motives <math id="S2.SS4.p5.m4" class="ltx_Math" alttext="h^{i}(J/S)" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo>/</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h^{i}(J/S)</annotation></semantics></math> obtained from Shermenev’s decomposition are isomorphic to those of Deninger–Murre. The fact that the two descending filtrations of Chow groups coincide is part of a theorem of Moonen–Polishchuk <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx49" title="" class="ltx_ref">MP10</a>, Theorem 4]</cite>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S3" class="ltx_section" lang="en">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3. </span>Preliminaries from representation theory</h2>

<div id="S3.p1" class="ltx_para ltx_noindent">
<p id="S3.p1.1" class="ltx_p">We define a <em id="S3.p1.1.1" class="ltx_emph ltx_font_italic">partition</em> to be a non-increasing sequence of natural numbers which eventually reaches zero: <math id="S3.p1.m1" class="ltx_Math" alttext="\lambda=(\lambda_{1}\geq\lambda_{2}\geq\lambda_{3}\geq\ldots\geq 0\geq 0\geq\ldots)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>≥</mo><msub><mi>λ</mi><mn>3</mn></msub><mo>≥</mo><mi mathvariant="normal">…</mi><mo>≥</mo><mn>0</mn><mo>≥</mo><mn>0</mn><mo>≥</mo><mi mathvariant="normal">…</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda=(\lambda_{1}\geq\lambda_{2}\geq\lambda_{3}\geq\ldots\geq 0\geq 0\geq\ldots)</annotation></semantics></math>. The <em id="S3.p1.1.2" class="ltx_emph ltx_font_italic">weight</em> of a partition is defined as <math id="S3.p1.m2" class="ltx_Math" alttext="|\lambda|=\sum_{i}\lambda_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">|\lambda|=\sum_{i}\lambda_{i}</annotation></semantics></math>. The <em id="S3.p1.1.3" class="ltx_emph ltx_font_italic">length</em> of a partition is defined as <math id="S3.p1.m3" class="ltx_Math" alttext="\ell(\lambda)=\max\{i\,:\,\lambda_{i}\neq 0\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo lspace="0.448em" rspace="0.448em">:</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>≠</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell(\lambda)=\max\{i\,:\,\lambda_{i}\neq 0\}</annotation></semantics></math>. Partitions are often identified with <em id="S3.p1.1.4" class="ltx_emph ltx_font_italic">Young diagrams</em>. Our convention for Young diagrams is that the numbers <math id="S3.p1.m4" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math> are the lengths of the rows in the diagram. We denote the conjugate partition of <math id="S3.p1.m5" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, obtained by reflecting the Young diagram across the diagonal, by <math id="S3.p1.m6" class="ltx_Math" alttext="\lambda^{T}" display="inline" intent=":literal"><semantics><msup><mi>λ</mi><mi>T</mi></msup><annotation encoding="application/x-tex">\lambda^{T}</annotation></semantics></math>.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1. </span>Schur–Weyl duality</h3>

<div id="S3.SS1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS1.p1.1" class="ltx_p">Let <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a vector space over <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math>. (Everything that follows is true more generally over any field of characteristic zero.) Partitions with <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="\ell(\lambda)\leq\dim(V)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≤</mo><mrow><mo lspace="0.1389em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell(\lambda)\leq\dim(V)</annotation></semantics></math> are in a natural bijection with irreducible finite dimensional representations of <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi>GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V)</annotation></semantics></math> via the theory of highest weight vectors. We write <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="V_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">V_{\lambda}</annotation></semantics></math> for the representation of <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi>GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V)</annotation></semantics></math> corresponding to <math id="S3.SS1.p1.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>. For example, if <math id="S3.SS1.p1.m8" class="ltx_Math" alttext="\lambda=(n\geq 0\geq 0\geq\ldots)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn><mo>≥</mo><mn>0</mn><mo>≥</mo><mi mathvariant="normal">…</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda=(n\geq 0\geq 0\geq\ldots)</annotation></semantics></math>, then <math id="S3.SS1.p1.m9" class="ltx_Math" alttext="V_{\lambda}=\Sym^{n}(V)" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>λ</mi></msub><mo>=</mo><mrow><msup><mi>Sym</mi><mi>n</mi></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{\lambda}=\Sym^{n}(V)</annotation></semantics></math> and <math id="S3.SS1.p1.m10" class="ltx_math_unparsed" alttext="V_{\lambda^{T}}=\wedge^{n}V" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><msub><mrow></mrow><msup><mi>λ</mi><mi>T</mi></msup></msub><mo rspace="0em">=</mo><mo lspace="0em">∧</mo><msup><mrow></mrow><mi>n</mi></msup><mi>V</mi></mrow><annotation encoding="application/x-tex">V_{\lambda^{T}}=\wedge^{n}V</annotation></semantics></math>. If <math id="S3.SS1.p1.m11" class="ltx_Math" alttext="\ell(\lambda)&gt;\dim(V)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">&gt;</mo><mrow><mo lspace="0.1389em" rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell(\lambda)&gt;\dim(V)</annotation></semantics></math> then we define <math id="S3.SS1.p1.m12" class="ltx_Math" alttext="V_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">V_{\lambda}</annotation></semantics></math> to be zero. The representations of the symmetric group are also indexed by partitions: the partitions with <math id="S3.SS1.p1.m13" class="ltx_Math" alttext="|\lambda|=n" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">|\lambda|=n</annotation></semantics></math> are in natural bijection with the representations of the symmetric group <math id="S3.SS1.p1.m14" class="ltx_Math" alttext="\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathfrak{S}_{n}</annotation></semantics></math>, which we denote by <math id="S3.SS1.p1.m15" class="ltx_Math" alttext="\sigma_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\lambda}</annotation></semantics></math>. If <math id="S3.SS1.p1.m16" class="ltx_Math" alttext="\lambda=(n\geq 0\geq 0\geq\ldots)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn><mo>≥</mo><mn>0</mn><mo>≥</mo><mi mathvariant="normal">…</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda=(n\geq 0\geq 0\geq\ldots)</annotation></semantics></math> then <math id="S3.SS1.p1.m17" class="ltx_Math" alttext="\sigma_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\lambda}</annotation></semantics></math> is the trivial representation and <math id="S3.SS1.p1.m18" class="ltx_Math" alttext="\sigma_{\lambda^{T}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><msup><mi>λ</mi><mi>T</mi></msup></msub><annotation encoding="application/x-tex">\sigma_{\lambda^{T}}</annotation></semantics></math> is the sign representation.</p>
</div>
<div id="S3.SS1.p2" class="ltx_para ltx_noindent">
<p id="S3.SS1.p2.1" class="ltx_p">The vector space <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math> carries commuting left and right actions by <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi>GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V)</annotation></semantics></math> and <math id="S3.SS1.p2.m3" class="ltx_Math" alttext="\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathfrak{S}_{n}</annotation></semantics></math>, respectively. <em id="S3.SS1.p2.1.1" class="ltx_emph ltx_font_italic">Schur–Weyl duality</em> in its most basic form is an expression for how to decompose <math id="S3.SS1.p2.m4" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math> into irreducible representations under this action of <math id="S3.SS1.p2.m5" class="ltx_Math" alttext="\GL(V)\times\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msub><mi>𝔖</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\GL(V)\times\mathfrak{S}_{n}</annotation></semantics></math>:</p>
<table id="S3.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex35.m1" class="ltx_Math" alttext="V^{\otimes n}=\bigoplus_{|\lambda|=n}V_{\lambda}\otimes\sigma_{\lambda}^{\ast}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>n</mi></mrow></munder><msub><mi>V</mi><mi>λ</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V^{\otimes n}=\bigoplus_{|\lambda|=n}V_{\lambda}\otimes\sigma_{\lambda}^{\ast}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.2" class="ltx_p">Although <math id="S3.SS1.p2.m6" class="ltx_Math" alttext="\sigma_{\lambda}\cong\sigma_{\lambda}^{\ast}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>λ</mi></msub><mo>≅</mo><msubsup><mi>σ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\sigma_{\lambda}\cong\sigma_{\lambda}^{\ast}</annotation></semantics></math>, we dualize to emphasize that we are considering a right action.</p>
</div>
<div id="S3.SS1.p3" class="ltx_para ltx_noindent">
<p id="S3.SS1.p3.1" class="ltx_p">Schur–Weyl duality can be formulated more abstractly in terms of mutual centralizers. Namely, <math id="S3.SS1.p3.m1" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math> admits commuting actions of <math id="S3.SS1.p3.m2" class="ltx_Math" alttext="\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi>GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V)</annotation></semantics></math> and the group algebra <math id="S3.SS1.p3.m3" class="ltx_Math" alttext="\mathbf{Q}[\mathfrak{S}_{n}]" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝔖</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q}[\mathfrak{S}_{n}]</annotation></semantics></math>, and Schur–Weyl duality is equivalent to the claim that the centralizer of <math id="S3.SS1.p3.m4" class="ltx_Math" alttext="\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi>GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V)</annotation></semantics></math> in <math id="S3.SS1.p3.m5" class="ltx_Math" alttext="\End_{\mathbf{Q}}(V^{\otimes n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>End</mi><mi>𝐐</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\End_{\mathbf{Q}}(V^{\otimes n})</annotation></semantics></math> equals the image of <math id="S3.SS1.p3.m6" class="ltx_Math" alttext="\mathbf{Q}[\mathfrak{S}_{n}]" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝔖</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q}[\mathfrak{S}_{n}]</annotation></semantics></math> in <math id="S3.SS1.p3.m7" class="ltx_Math" alttext="\End_{\mathbf{Q}}(V^{\otimes n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>End</mi><mi>𝐐</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\End_{\mathbf{Q}}(V^{\otimes n})</annotation></semantics></math>, and vice versa. A useful consequence of this more abstract viewpoint is that it produces for all <math id="S3.SS1.p3.m8" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> an explicit idempotent endomorphism of <math id="S3.SS1.p3.m9" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math> whose image is exactly the summand <math id="S3.SS1.p3.m10" class="ltx_Math" alttext="V_{\lambda}\otimes\sigma_{\lambda}^{\ast}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">V_{\lambda}\otimes\sigma_{\lambda}^{\ast}</annotation></semantics></math>.
Namely, the group algebra <math id="S3.SS1.p3.m11" class="ltx_Math" alttext="\mathbf{Q}[\mathfrak{S}_{n}]" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝔖</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q}[\mathfrak{S}_{n}]</annotation></semantics></math> contains a family of orthogonal idempotents called <em id="S3.SS1.p3.1.1" class="ltx_emph ltx_font_italic">Young symmetrizers</em>. If <math id="S3.SS1.p3.m12" class="ltx_Math" alttext="c_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">c_{\lambda}</annotation></semantics></math> denotes a Young symmetrizer corresponding to the partition <math id="S3.SS1.p3.m13" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, then the image of <math id="S3.SS1.p3.m14" class="ltx_Math" alttext="c_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">c_{\lambda}</annotation></semantics></math> is the summand <math id="S3.SS1.p3.m15" class="ltx_Math" alttext="V_{\lambda}\otimes\sigma_{\lambda}^{\ast}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>λ</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">V_{\lambda}\otimes\sigma_{\lambda}^{\ast}</annotation></semantics></math> of <math id="S3.SS1.p3.m16" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2. </span>Symplectic groups and Weyl’s construction</h3>

<div id="S3.SS2.p1" class="ltx_para ltx_noindent">
<p id="S3.SS2.p1.1" class="ltx_p">Suppose that the vector space <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is equipped with a symplectic form. Then partitions of length <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="\ell(\lambda)\leq\frac{1}{2}\dim(V)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell(\lambda)\leq\frac{1}{2}\dim(V)</annotation></semantics></math> are in a bijection with irreducible finite dimensional representations of <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="\Sp(V)" display="inline" intent=":literal"><semantics><mrow><mi>Sp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sp(V)</annotation></semantics></math>, and we write <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="V_{\langle\lambda\rangle}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><annotation encoding="application/x-tex">V_{\langle\lambda\rangle}</annotation></semantics></math> for the representation of <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="\Sp(V)" display="inline" intent=":literal"><semantics><mrow><mi>Sp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sp(V)</annotation></semantics></math> corresponding to <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>. Similarly we set <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="V_{\langle\lambda\rangle}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">V_{\langle\lambda\rangle}=0</annotation></semantics></math> if <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="\ell(\lambda)&gt;\frac{1}{2}\dim(V)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell(\lambda)&gt;\frac{1}{2}\dim(V)</annotation></semantics></math>. The decomposition of <math id="S3.SS2.p1.m9" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math> into irreducible representations of <math id="S3.SS2.p1.m10" class="ltx_Math" alttext="\Sp(V)\times\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Sp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msub><mi>𝔖</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\Sp(V)\times\mathfrak{S}_{n}</annotation></semantics></math> is more complicated than that for <math id="S3.SS2.p1.m11" class="ltx_Math" alttext="\GL(V)" display="inline" intent=":literal"><semantics><mrow><mi>GL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL(V)</annotation></semantics></math>. The first nontrivial example is the case <math id="S3.SS2.p1.m12" class="ltx_Math" alttext="n=2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n=2</annotation></semantics></math>:</p>
<table id="S3.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex36.m1" class="ltx_Math" alttext="V^{\otimes 2}=V_{\langle 2\rangle}\otimes\sigma_{2}^{\ast}\oplus V_{\langle 1,1\rangle}\otimes\sigma_{1,1}^{\ast}\oplus V_{\langle 0\rangle}\otimes\sigma_{1,1}^{\ast}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msup><mo>=</mo><mrow><mrow><msub><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mn>2</mn><mo stretchy="false">⟩</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mn>2</mn><mo>∗</mo></msubsup></mrow><mo>⊕</mo><mrow><msub><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo>⊕</mo><mrow><msub><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V^{\otimes 2}=V_{\langle 2\rangle}\otimes\sigma_{2}^{\ast}\oplus V_{\langle 1,1\rangle}\otimes\sigma_{1,1}^{\ast}\oplus V_{\langle 0\rangle}\otimes\sigma_{1,1}^{\ast}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">The first two terms are exactly what one expects from Schur–Weyl duality. The third term arises because <math id="S3.SS2.p1.m13" class="ltx_math_unparsed" alttext="\wedge^{2}V" display="inline" intent=":literal"><semantics><mrow><mo>∧</mo><msup><mrow></mrow><mn>2</mn></msup><mi>V</mi></mrow><annotation encoding="application/x-tex">\wedge^{2}V</annotation></semantics></math> is not irreducible: it contains the trvial representation spanned by the class of the symplectic form as a subrepresentation.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para ltx_noindent">
<p id="S3.SS2.p2.1" class="ltx_p">The example <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="n=2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n=2</annotation></semantics></math> generalizes to larger values of <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> as follows. We define</p>
<table id="S3.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex37.m1" class="ltx_Math" alttext="V^{\langle n\rangle}\subset V^{\otimes n}" display="block" intent=":literal"><semantics><mrow><msup><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><mo>⊂</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">V^{\langle n\rangle}\subset V^{\otimes n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p2.2" class="ltx_p">to be the subspace of <em id="S3.SS2.p2.2.1" class="ltx_emph ltx_font_italic">traceless tensors</em>, i.e. the intersection of the kernels of all <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="\binom{n}{2}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mn>2</mn></mfrac><mo>)</mo></mrow><annotation encoding="application/x-tex">\binom{n}{2}</annotation></semantics></math> maps</p>
<table id="S3.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex38.m1" class="ltx_Math" alttext="V^{\otimes n}\to V^{\otimes(n-2)}" display="block" intent=":literal"><semantics><mrow><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">V^{\otimes n}\to V^{\otimes(n-2)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p2.3" class="ltx_p">given by contracting with the symplectic form. Alternatively, we can think of <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="V^{\langle n\rangle}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><annotation encoding="application/x-tex">V^{\langle n\rangle}</annotation></semantics></math> as a quotient of <math id="S3.SS2.p2.m5" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math>, where we divide by the images of all <math id="S3.SS2.p2.m6" class="ltx_Math" alttext="\binom{n}{2}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mn>2</mn></mfrac><mo>)</mo></mrow><annotation encoding="application/x-tex">\binom{n}{2}</annotation></semantics></math> maps <math id="S3.SS2.p2.m7" class="ltx_Math" alttext="V^{\otimes(n-2)}\to V^{\otimes n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">→</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">V^{\otimes(n-2)}\to V^{\otimes n}</annotation></semantics></math> given by inserting the class of the symplectic form. The subspace <math id="S3.SS2.p2.m8" class="ltx_Math" alttext="V^{\langle n\rangle}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><annotation encoding="application/x-tex">V^{\langle n\rangle}</annotation></semantics></math> is clearly <math id="S3.SS2.p2.m9" class="ltx_Math" alttext="\Sp(V)" display="inline" intent=":literal"><semantics><mrow><mi>Sp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sp(V)</annotation></semantics></math>-invariant, and Weyl proved that there is an isomorphism</p>
<table id="S3.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex39.m1" class="ltx_Math" alttext="V^{\langle n\rangle}=\bigoplus_{|\lambda|=n}V_{\langle\lambda\rangle}\otimes\sigma_{\lambda}^{\ast}" display="block" intent=":literal"><semantics><mrow><msup><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>n</mi></mrow></munder><msub><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>σ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">V^{\langle n\rangle}=\bigoplus_{|\lambda|=n}V_{\langle\lambda\rangle}\otimes\sigma_{\lambda}^{\ast}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p2.4" class="ltx_p">for all <math id="S3.SS2.p2.m10" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. Thus we know how to decompose the subspace <math id="S3.SS2.p2.m11" class="ltx_Math" alttext="V^{\langle n\rangle}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><annotation encoding="application/x-tex">V^{\langle n\rangle}</annotation></semantics></math> into irreducible representations of <math id="S3.SS2.p2.m12" class="ltx_Math" alttext="\Sp(V)\times\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Sp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msub><mi>𝔖</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\Sp(V)\times\mathfrak{S}_{n}</annotation></semantics></math>. Moreover, we may write <math id="S3.SS2.p2.m13" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math> as the direct sum of <math id="S3.SS2.p2.m14" class="ltx_Math" alttext="V^{\langle n\rangle}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></msup><annotation encoding="application/x-tex">V^{\langle n\rangle}</annotation></semantics></math> and the image of all the maps <math id="S3.SS2.p2.m15" class="ltx_Math" alttext="V^{\otimes(n-2)}\to V^{\otimes n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">→</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">V^{\otimes(n-2)}\to V^{\otimes n}</annotation></semantics></math>; we may write <math id="S3.SS2.p2.m16" class="ltx_Math" alttext="V^{\otimes(n-2)}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">V^{\otimes(n-2)}</annotation></semantics></math> as the direct sum of <math id="S3.SS2.p2.m17" class="ltx_Math" alttext="V^{\langle n-2\rangle}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">⟩</mo></mrow></msup><annotation encoding="application/x-tex">V^{\langle n-2\rangle}</annotation></semantics></math> and the image of all maps <math id="S3.SS2.p2.m18" class="ltx_Math" alttext="V^{\otimes(n-4)}\to V^{\otimes(n-2)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">→</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">V^{\otimes(n-4)}\to V^{\otimes(n-2)}</annotation></semantics></math>, etc. This leads inductively to a decomposition of <math id="S3.SS2.p2.m19" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math> into irreducible <math id="S3.SS2.p2.m20" class="ltx_Math" alttext="\Sp(V)\times\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Sp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msub><mi>𝔖</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\Sp(V)\times\mathfrak{S}_{n}</annotation></semantics></math>-representations. All <math id="S3.SS2.p2.m21" class="ltx_Math" alttext="V_{\langle\lambda\rangle}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mo stretchy="false">⟨</mo><mi>λ</mi><mo stretchy="false">⟩</mo></mrow></msub><annotation encoding="application/x-tex">V_{\langle\lambda\rangle}</annotation></semantics></math> with <math id="S3.SS2.p2.m22" class="ltx_Math" alttext="|\lambda|\leq n" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">|\lambda|\leq n</annotation></semantics></math> and <math id="S3.SS2.p2.m23" class="ltx_Math" alttext="|\lambda|\equiv n\pmod{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>≡</mo><mrow><mi>n</mi><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|\lambda|\equiv n\pmod{2}</annotation></semantics></math> will occur in this decomposition. We refer to this as <em id="S3.SS2.p2.4.1" class="ltx_emph ltx_font_italic">Weyl’s construction</em> of the irreducible representations of <math id="S3.SS2.p2.m24" class="ltx_Math" alttext="\Sp(V)" display="inline" intent=":literal"><semantics><mrow><mi>Sp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sp(V)</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3. </span>Brauer algebra</h3>

<div id="S3.SS3.p1" class="ltx_para ltx_noindent">
<p id="S3.SS3.p1.1" class="ltx_p">We now wish to give a version of Schur–Weyl duality for the symplectic group in terms of mutual centralizer algebras for the action of <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="\Sp(V)" display="inline" intent=":literal"><semantics><mrow><mi>Sp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sp(V)</annotation></semantics></math> on <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math>. The centralizer of <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="\Sp(V)" display="inline" intent=":literal"><semantics><mrow><mi>Sp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sp(V)</annotation></semantics></math> acting on <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math> is larger than <math id="S3.SS3.p1.m5" class="ltx_Math" alttext="\mathbf{Q}[\mathfrak{S}_{n}]" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝔖</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q}[\mathfrak{S}_{n}]</annotation></semantics></math>. It can be described as the algebra of endomorphisms of <math id="S3.SS3.p1.m6" class="ltx_Math" alttext="V^{\otimes n}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">V^{\otimes n}</annotation></semantics></math> generated by <math id="S3.SS3.p1.m7" class="ltx_Math" alttext="\mathbf{Q}[\mathfrak{S}_{n}]" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝔖</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q}[\mathfrak{S}_{n}]</annotation></semantics></math> and the maps given by compositions</p>
<table id="S3.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex40.m1" class="ltx_Math" alttext="V^{\otimes n}\to V^{\otimes(n-2)}\to V^{\otimes n}," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">→</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">V^{\otimes n}\to V^{\otimes(n-2)}\to V^{\otimes n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p1.2" class="ltx_p">where the first map contracts two tensor factors using the symplectic form, and the second map inserts the form. Brauer <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx5" title="" class="ltx_ref">Bra37</a>]</cite> introduced a diagrammatic calculus which is useful for describing endomorphisms in this centralizer algebra.
We give here a category-theoretic treatment of the Brauer algebra. Somewhat similar presentations can be found in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx44" title="" class="ltx_ref">LZ15</a>, <a href="#bib.bibx65" title="" class="ltx_ref">RW15</a>]</cite>.</p>
</div>
<div id="S3.SS3.p2" class="ltx_para ltx_noindent">
<p id="S3.SS3.p2.1" class="ltx_p">Let <math id="S3.SS3.p2.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and <math id="S3.SS3.p2.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> be nonnegative integers. We define an <em id="S3.SS3.p2.1.1" class="ltx_emph ltx_font_italic"><math id="S3.SS3.p2.m3" class="ltx_Math" alttext="(n,m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,m)</annotation></semantics></math>-Brauer diagram</em> to be a diagram of two rows containing <math id="S3.SS3.p2.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and <math id="S3.SS3.p2.m5" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> dots, respectively, and <math id="S3.SS3.p2.m6" class="ltx_Math" alttext="(n+m)/2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">(n+m)/2</annotation></semantics></math> strands connecting these dots pairwise. The set of <math id="S3.SS3.p2.m7" class="ltx_Math" alttext="(n,m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,m)</annotation></semantics></math>-Brauer diagrams is empty unless <math id="S3.SS3.p2.m8" class="ltx_Math" alttext="n\equiv m\pmod{2}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≡</mo><mrow><mi>m</mi><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n\equiv m\pmod{2}</annotation></semantics></math>. Here is a (4,6)-Brauer diagram:</p>
<table id="S3.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
