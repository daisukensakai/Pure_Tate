tion encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathfrak{Br}^{(\delta)}(n,m)\otimes\mathfrak{Br}^{(\delta)}(m,k)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 291.51 0) translate(76.67,0) matrix(1.0 0.0 0.0 1.0 -38.48 0)"><foreignObject style="--ltx-fo-width:4.51em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.75" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="62.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex47.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathfrak{Br}^{(\delta)}(n,k)}" display="inline" intent=":literal"><semantics><mrow><mi>𝔅</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔯</mi><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathfrak{Br}^{(\delta)}(n,k)}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 65.68)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(132.67,0) matrix(1.0 0.0 0.0 1.0 -128.43 0)"><foreignObject style="--ltx-fo-width:17.51em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="242.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex47.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Hom_{\mathcal{C}}(V^{\otimes n},V^{\otimes m})\otimes\Hom_{\mathcal{C}}(V^{\otimes m},V^{\otimes k})}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Hom</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo>,</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mrow><msub><mi>Hom</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msup><mo>,</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>k</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Hom_{\mathcal{C}}(V^{\otimes n},V^{\otimes m})\otimes\Hom_{\mathcal{C}}(V^{\otimes m},V^{\otimes k})}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 265.35 0) translate(102.83,0) matrix(1.0 0.0 0.0 1.0 -64.64 0)"><foreignObject style="--ltx-fo-width:8.29em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="114.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex47.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Hom_{\mathcal{C}}(V^{\otimes n},V^{\otimes k}).}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Hom</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo>,</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>k</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Hom_{\mathcal{C}}(V^{\otimes n},V^{\otimes k}).}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -0.53 23.62 L 106.09 23.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 106.37 23.62)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -85.85 12.18 L -85.85 -12.17"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -85.85 -12.45)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 149.65 12.18 L 149.65 -12.17"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 149.65 -12.45)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 47.1 -25.53 L 79.94 -25.53"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 80.21 -25.53)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS3.p4" class="ltx_para ltx_noindent">
<p id="S3.SS3.p4.1" class="ltx_p">The collection of maps <math id="S3.SS3.p4.m1" class="ltx_Math" alttext="\mathfrak{Br}^{(\delta)}(n,m)\to\Hom_{\mathcal{C}}(V^{\otimes n},V^{\otimes m})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔅</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔯</mi><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>Hom</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>n</mi></mrow></msup><mo>,</mo><msup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{Br}^{(\delta)}(n,m)\to\Hom_{\mathcal{C}}(V^{\otimes n},V^{\otimes m})</annotation></semantics></math> are completely determined by the images of the three diagrams</p>
<table id="S3.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex48.m1.pic1" class="ltx_picture ltx_markedasmath" height="39.3" overflow="visible" version="1.1" viewBox="0 0 277.88 39.3" width="277.88"><g transform="translate(0,39.3) matrix(1 0 0 -1 0 0) translate(1.93,0) translate(0,1.93)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M 1.38 0 C 1.38 0.76 0.76 1.38 0 1.38 C -0.76 1.38 -1.38 0.76 -1.38 0 C -1.38 -0.76 -0.76 -1.38 0 -1.38 C 0.76 -1.38 1.38 -0.76 1.38 0 Z M 0 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(0.2 0.0 0.0 0.2 -1.38 0)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
