            <mi>n</mi>
            <mo>−<!-- − --></mo>
            <mi>m</mi>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>B</mi>
            <mi>M</mi>
          </mrow>
        </msubsup>
        <mo stretchy="false">(</mo>
        <mi>Y</mi>
        <mo stretchy="false">)</mo>
        <mo>×<!-- × --></mo>
        <msup>
          <mi>H</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>m</mi>
          </mrow>
        </msup>
        <mo stretchy="false">(</mo>
        <mi>Y</mi>
        <mo stretchy="false">)</mo>
        <mo stretchy="false">→<!-- → --></mo>
        <mrow class="MJX-TeXAtom-ORD">
          <mi mathvariant="double-struck">Z</mi>
        </mrow>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle H_{2n-m}^{BM}(Y)\times H^{m}(Y)\to \mathbb {Z} }</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/3117aba592c012bb0438fa128a6c923cea1a202d" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -1.171ex; width:25.641ex; height:3.343ex;" alt="{\displaystyle H_{2n-m}^{BM}(Y)\times H^{m}(Y)\to \mathbb {Z} }"/></span></p></blockquote><p id="mwAS8">giving an isomorphism of the two groups.</p>

</section><section data-mw-section-id="15" id="mwATA" aria-labelledby="Algebraic_torus"><div class="mw-heading mw-heading3"><h3 id="Algebraic_torus">Algebraic torus</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Mixed_Hodge_structure&amp;action=edit&amp;section=15" title="Edit section: Algebraic torus"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div><p id="mwATE">
A one dimensional algebraic torus <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt138" id="mwATI" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\mathbb{T}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \mathbb {T} }">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow class="MJX-TeXAtom-ORD">
          <mi mathvariant="double-struck">T</mi>
        </mrow>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle \mathbb {T} }</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/9c039979935c00b3b216cbb065999207872677f6" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:1.55ex; height:2.176ex;" alt="{\displaystyle \mathbb {T} }"/></span> is isomorphic to the variety <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt139" id="mwATM" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\mathbb{P}^1-\\{0,\\infty \\}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \mathbb {P} ^{1}-\{0,\infty \}}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <msup>
          <mrow class="MJX-TeXAtom-ORD">
            <mi mathvariant="double-struck">P</mi>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <mn>1</mn>
          </mrow>
        </msup>
        <mo>−<!-- − --></mo>
        <mo fence="false" stretchy="false">{</mo>
        <mn>0</mn>
        <mo>,</mo>
