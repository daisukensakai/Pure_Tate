    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle h^{p,q}(H_{\mathbb {Z} })=\dim _{\mathbb {C} }{\text{Gr}}_{F^{\bullet }}^{p}{\text{Gr}}_{p+q}^{W_{\bullet }}H_{\mathbb {C} }}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/8f5f202109b00c37a5c71358d11d3ad1bca959ae" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -1.171ex; width:31.724ex; height:3.509ex;" alt="{\displaystyle h^{p,q}(H_{\mathbb {Z} })=\dim _{\mathbb {C} }{\text{Gr}}_{F^{\bullet }}^{p}{\text{Gr}}_{p+q}^{W_{\bullet }}H_{\mathbb {C} }}"/></span></p></blockquote><p id="mwYA">since <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt37" id="mwYQ" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\text{Gr}_{p+q}^{W_\\bullet}H_\\mathbb{C} "}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle {\text{Gr}}_{p+q}^{W_{\bullet }}H_{\mathbb {C} }}">
  <semantics>
