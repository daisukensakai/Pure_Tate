        <mo>=</mo>
        <mn>0</mn>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle W_{-2}H^{1}(U,\mathbb {Q} )(1)=0}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/d4752cb5f8a7deabdfa04d938f3138661e0f331e" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:21.351ex; height:3.176ex;" alt="{\displaystyle W_{-2}H^{1}(U,\mathbb {Q} )(1)=0}"/></span>, in filtered degree <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt104" id="mw9g" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"-1"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle -1}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mo>−<!-- − --></mo>
        <mn>1</mn>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle -1}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/704fb0427140d054dd267925495e78164fee9aac" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.505ex; width:2.971ex; height:2.343ex;" alt="{\displaystyle -1}"/></span> we have <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt105" id="mw9w" data-mw='{"name":"math","attrs":{},"body":{"extsrc":" W_{-1}H^1(U,\\mathbb{Q})(1)=H^1(X,\\mathbb{Q})(1)"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle W_{-1}H^{1}(U,\mathbb {Q} )(1)=H^{1}(X,\mathbb {Q} )(1)}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <msub>
          <mi>W</mi>
