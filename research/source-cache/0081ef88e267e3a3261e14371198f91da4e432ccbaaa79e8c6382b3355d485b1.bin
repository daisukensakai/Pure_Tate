        <mo stretchy="false">(</mo>
        <mi>log</mi>
        <mo>⁡<!-- ⁡ --></mo>
        <mi>D</mi>
        <mo stretchy="false">)</mo>
        <mo stretchy="false">)</mo>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle \mathbb {H} ^{1}(\Omega _{C}^{1}(\log D))}</annotation>
