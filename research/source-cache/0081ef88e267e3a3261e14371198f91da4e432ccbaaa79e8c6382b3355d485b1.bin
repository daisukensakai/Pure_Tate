</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/f5a5edd125a57d9dfb5a9a8b164f8ae0bf20dc6d" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -1.005ex; width:14.923ex; height:3.343ex;" alt="{\displaystyle \mathbb {H} ^{1}(\Omega _{C}^{1}(\log D))}"/></span> has a weight <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt84" id="mwzg" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"2"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle 2}">
  <semantics>
