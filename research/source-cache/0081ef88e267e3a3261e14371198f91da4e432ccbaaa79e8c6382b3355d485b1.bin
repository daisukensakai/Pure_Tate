                <mo>+</mo>
                <mn>1</mn>
              </mrow>
            </msup>
          </mfrac>
        </mrow>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle {\text{Gr}}_{p}^{F^{\bullet }}={\frac {F^{p}}{F^{p+1}}}}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/27aec1135ae06b27c5ecf4950a312563443032ba" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -2.005ex; width:13.992ex; height:5.343ex;" alt="{\displaystyle {\text{Gr}}_{p}^{F^{\bullet }}={\frac {F^{p}}{F^{p+1}}}}"/></span></p></blockquote><p id="mwZg">is the <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt40" id="mwZw" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"(p,q) "}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle (p,q)}">
