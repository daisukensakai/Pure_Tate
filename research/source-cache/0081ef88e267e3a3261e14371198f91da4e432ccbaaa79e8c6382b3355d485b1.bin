        </mrow>
        <mo stretchy="false">)</mo>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle H^{n}(U,\mathbb {C} )}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/e3eccab0ab4cd11dae621ddb76a3c91ff44818de" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:9.626ex; height:2.843ex;" alt="{\displaystyle H^{n}(U,\mathbb {C} )}"/></span> from the mixed Hodge complex defined on the logarithmic complex <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt64" id="mwog" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\Omega_X^\\bullet(\\log D)"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \Omega _{X}^{\bullet }(\log D)}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
