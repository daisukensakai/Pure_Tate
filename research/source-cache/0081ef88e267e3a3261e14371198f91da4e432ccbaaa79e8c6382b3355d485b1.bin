            <mtext>Gr</mtext>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>p</mi>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <msup>
              <mi>F</mi>
              <mrow class="MJX-TeXAtom-ORD">
                <mo>∙<!-- ∙ --></mo>
              </mrow>
            </msup>
          </mrow>
        </msubsup>
        <mo>=</mo>
        <mrow class="MJX-TeXAtom-ORD">
          <mfrac>
            <msup>
              <mi>F</mi>
