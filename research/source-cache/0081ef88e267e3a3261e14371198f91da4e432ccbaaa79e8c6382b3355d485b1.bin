              <mi>F</mi>
              <mrow class="MJX-TeXAtom-ORD">
                <mo>∙<!-- ∙ --></mo>
              </mrow>
            </msup>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>p</mi>
