            </mrow>
          </mrow>
          <mo>′</mo>
        </msubsup>
        <mo>,</mo>
        <msubsup>
          <mi>W</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mo>∙<!-- ∙ --></mo>
          </mrow>
          <mo>′</mo>
        </msubsup>
        <mo>,</mo>
        <msup>
