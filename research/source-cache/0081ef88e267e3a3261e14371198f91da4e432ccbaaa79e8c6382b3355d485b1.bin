            <mi mathvariant="double-struck">Z</mi>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>U</mi>
          </mrow>
        </msub>
        <mover>
          <mo>→</mo>
          <mpadded width="+0.611em" lspace="0.278em" voffset=".15em">
            <mo stretchy="false">[</mo>
            <mo>+</mo>
