</section><section data-mw-section-id="11" id="mwtA" aria-labelledby="Example"><div class="mw-heading mw-heading4"><h4 id="Example">Example</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Mixed_Hodge_structure&amp;action=edit&amp;section=11" title="Edit section: Example"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div><p id="mwtQ">
