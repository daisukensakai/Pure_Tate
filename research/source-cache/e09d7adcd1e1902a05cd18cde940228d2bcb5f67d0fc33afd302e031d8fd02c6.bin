  <!-- Content Editor Module and Styles - defer to not block initial render -->
  
  <style>
/* Content Mode Switcher Styles */
.content-mode-switcher {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  padding: 8px 12px;
  background-color: var(--color-bg-secondary);
  border: 1px solid var(--color-border-secondary);
  border-radius: 8px 8px 0 0;
}

.mode-buttons {
  display: flex;
  gap: 8px;
}

.mode-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border: none;
  background-color: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  border-radius: 4px;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.2s ease;
}

.mode-btn:hover {
  background-color: var(--color-bg-hover, var(--color-bg-tertiary));
  color: var(--color-text-primary);
}

.mode-btn.active {
  background-color: color-mix(in srgb, var(--chrome-dark) 14%, var(--color-bg-secondary));
  color: var(--color-text-primary);
}

/* glide (ui-system): the tinted thumb travels; buttons go transparent so
   it shows through (tex-active keeps its opaque sage chip on top) */
.mode-buttons .sys-glide {
  background-color: color-mix(in srgb, var(--chrome-dark) 14%, var(--color-bg-secondary));
  border-radius: 4px;
  box-shadow: none;
}
.mode-buttons.glide-on .mode-btn { background-color: transparent; }
.mode-buttons.glide-on .mode-btn:hover:not(.active) { background-color: var(--color-bg-hover, var(--color-bg-tertiary)); }
.mode-buttons.glide-on .mode-btn.tex-active { background-color: var(--color-success, var(--sage)); }

.mode-btn.tex-active {
  background-color: var(--color-success, var(--sage));
  color: white;
}

.auto-link-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border: 1px solid var(--color-border-secondary);
  background-color: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  border-radius: 4px;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.2s ease;
  margin-left: auto;
}

.auto-link-btn:hover {
  background-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg-secondary));
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.auto-link-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.mode-indicator {
  font-size: 14px;
  color: var(--color-text-secondary);
}

/* Hand — the switcher (Markdown · TeX · Auto-link) plus the "Currently
   editing in … mode" sentence do not fit one line; the sentence takes its
   own row instead of hanging off the right edge. */
@media (max-width: 699px) {
  .content-mode-switcher {
    flex-wrap: wrap;
    gap: 6px 10px;
  }

  .content-mode-switcher .mode-buttons {
    flex: 1 1 100%;
    flex-wrap: wrap;
  }

  .content-mode-switcher .mode-indicator {
    flex: 1 1 100%;
    font-size: 13px;
  }
}

.current-mode {
  color: var(--color-accent, #5c6b5a);
}

.content-editor {
  border-radius: 0 0 8px 8px;
  border-top: none;
}

.content-editor.tex-mode {
  background-color: var(--color-bg-secondary);
  font-family: 'Courier New', monospace;
}

.image-upload-info {
  margin-top: 8px;
  padding: 8px;
  background-color: var(--color-bg-secondary);
  border: 1px dashed var(--color-border-secondary);
  border-radius: 4px;
  text-align: center;
  font-size: 14px;
  color: var(--color-text-secondary);
}

/* `label.upload-label` matches the specificity of `.form-group label`
   (0,1,1) and loads later — needed to beat the form-group bleed
   (display: block + margin-bottom: 5px + font-weight: 500). */
label.upload-label {
  display: inline;
  margin: 0;
  font-weight: inherit;
  color: var(--color-text-link);
  cursor: pointer;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 2px;
}

label.upload-label:hover {
  color: var(--color-text-link-hover);
  text-decoration: none;
}

.hidden-file-input {
  display: none;
}

.uploading-indicator {
  margin-top: 8px;
  padding: 8px;
  background-color: var(--color-warning-subtle, #fff3cd);
  border: 1px solid var(--color-warning, #ffeaa7);
  border-radius: 4px;
  text-align: center;
  color: var(--color-warning-text, #856404);
}

/* Drag-over highlight for attachable textareas */
textarea.attachable-dragover {
  border-color: var(--color-accent, #007bff) !important;
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent, #007bff) 25%, transparent);
}

/* Preview toggle button styling (injected by editor-preview.js) */
.preview-toggle-btn.active {
  background-color: var(--color-accent, var(--sage-text)) !important;
  color: #fff !important;
  border-color: var(--color-accent, var(--sage-text)) !important;
}
</style>


