        /* Tracer pulses ride each edge via CSS offset-path (same 3.4s cycle as
           the edge/node keyframes above); delays reproduce the old SMIL
           keyTimes windows so pulses still cascade root -> leaves. */
        .prereq-tree-tracer-1 { offset-path: path("M48 86 C82 86 88 48 122 48"); }
        .prereq-tree-tracer-2 { offset-path: path("M48 86 C82 86 88 124 122 124"); animation-delay: 0.27s; }
        .prereq-tree-tracer-3 { offset-path: path("M134 48 C166 48 170 76 204 76"); animation-delay: 1.02s; }
        .prereq-tree-tracer-4 { offset-path: path("M134 124 C166 124 172 146 204 146"); animation-delay: 1.46s; }
        .prereq-tree-tracer-5 { offset-path: path("M216 76 C242 76 250 86 278 86"); animation-delay: 2.11s; }

        .prereq-graph-loading .prereq-tree-tracer {
            animation-name: prereq-tree-tracer-run;
            animation-duration: 3.4s;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
        }

        @keyframes prereq-tree-tracer-run {
            0% { offset-distance: 0%; opacity: 0; }
            7% { opacity: 1; }
            16% { opacity: 1; }
            20% { offset-distance: 100%; opacity: 0.4; }
            24%, 100% { offset-distance: 100%; opacity: 0; }
        }

        @supports not (offset-path: path("M0 0H1")) {
            .prereq-tree-tracer { display: none; }
        }

