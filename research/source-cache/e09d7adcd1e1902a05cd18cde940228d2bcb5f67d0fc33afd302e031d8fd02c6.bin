  <script>
    window.__ANDROMA_SERVER_AUTH__ = false;
    var __andromaAuthHint = window.__ANDROMA_SERVER_AUTH__ || document.cookie.indexOf('logged_in=1') !== -1;
    if (__andromaAuthHint) {
      document.documentElement.classList.add('auth-li');
      
      // Rewrite any logo/home links from / (anonymous landing) to /home
      // (logged-in dashboard). Done client-side because layout.ejs ships in
      // edge-cached HTML that can't branch on session state.
      // Exposed so dynamically-injected nav (e.g. the mobile nav overlay
      // built after DOMContentLoaded) can re-run it after appending.
      window.__hydrateHomeLinks = function(scope) {
        (scope || document).querySelectorAll('[data-home-link]').forEach(function(el) {
          if (el.getAttribute('href') === '/') el.setAttribute('href', '/home');
        });
      };
      document.addEventListener('DOMContentLoaded', function() { window.__hydrateHomeLinks(); });
    }
  </script>
