        .prereq-tree-tracer {
            fill: color-mix(in srgb, var(--color-text-primary, var(--night)) 52%, var(--accent-color, var(--sage-text)));
            opacity: 0;
            filter: drop-shadow(0 1px 2px rgba(29, 36, 51, 0.16));
        }

        .prereq-tree-tracer-accent {
            fill: var(--accent-color, var(--sage-text));
