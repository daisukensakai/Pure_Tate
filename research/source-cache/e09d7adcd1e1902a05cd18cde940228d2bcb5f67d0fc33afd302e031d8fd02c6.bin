            <a href="https://github.com/androma-org/androma/issues" target="_blank" rel="noopener noreferrer" class="github-stars-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="github-stars-count">Feedback</span>
            </a>
          </li>
          <li class="auth-buttons-container">
            <a href="#" id="loginModalBtn" class="btn btn-ghost btn-sm">Sign in</a>
            <a href="/register" id="registerModalBtn" class="btn btn-primary btn-sm">Register</a>
          </li>
        </ul>
      </nav>
    </div>
  </header>
  
  
  <!-- Auth Modal (Passwordless Email Code) -->
  <div id="loginModal" class="auth-modal" style="display: none;">
    <div class="auth-modal-overlay"></div>
    <div class="auth-modal-content">
      <button class="auth-modal-close" id="closeLoginModal">&times;</button>

      <!-- Step 1: Email -->
      <div id="modalStepEmail">
        <div class="auth-modal-header">
          <h2>Sign in to Androma</h2>
          <p>We&rsquo;ll send a one-time code to your email &mdash; no passwords, ever.</p>
        </div>
        <div class="auth-modal-body">
          <div id="modalEmailError" class="auth-alert auth-alert-error" style="display: none;"></div>

          <div class="auth-social-buttons">
            <a href="/auth/google" class="auth-social-btn">
              <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <g fill="none" fill-rule="evenodd">
                  <path d="M17.6 9.2l-.1-1.8H9v3.4h4.8C13.6 12 13 13 12 13.6v2.2h3a8.8 8.8 0 0 0 2.6-6.6z" fill="#4285F4"/>
                  <path d="M9 18c2.4 0 4.5-.8 6-2.2l-3-2.2a5.4 5.4 0 0 1-8-2.9H1V13a9 9 0 0 0 8 5z" fill="#34A853"/>
                  <path d="M4 10.7a5.4 5.4 0 0 1 0-3.4V5H1a9 9 0 0 0 0 8l3-2.3z" fill="#FBBC05"/>
                  <path d="M9 3.6c1.3 0 2.5.4 3.4 1.3L15 2.3A9 9 0 0 0 1 5l3 2.4a5.4 5.4 0 0 1 5-3.7z" fill="#EA4335"/>
                </g>
              </svg>
              Continue with Google
            </a>

            <a href="/auth/orcid" class="auth-social-btn">
              <svg width="18" height="18" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
                <path d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0z" fill="#A6CE39"/>
                <path d="M86.3 186.2H70.9V79.1h15.4v107.1zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.4z" fill="#FFFFFF"/>
                <circle cx="79.1" cy="56.8" r="9.6" fill="#FFFFFF"/>
              </svg>
              Continue with ORCID
            </a>
          </div>

          <div class="auth-divider"><span>or with email</span></div>

          <form id="modalEmailForm">
            <div class="auth-field">
              <label for="modalLoginEmail">Email address</label>
              <div class="auth-input-wrap">
                <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/>
                </svg>
                <input type="email" id="modalLoginEmail" name="email" placeholder="euler@institute.edu" required autocomplete="email">
              </div>
            </div>
            <button type="submit" class="auth-submit-btn" id="modalSendCodeBtn">
              <span class="btn-text">Send sign-in code &rarr;</span>
              <span class="btn-loader" style="display: none;">
                <svg class="spinner" viewBox="0 0 50 50"><circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle></svg>
              </span>
            </button>
            <div class="auth-reassurance">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <span>Passwordless. Each sign-in is verified by a 6-digit code.</span>
            </div>
          </form>
        </div>
      </div>

      <!-- Step 2: Code -->
      <div id="modalStepCode" style="display: none;">
        <div class="auth-modal-header">
          <div class="auth-step-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/>
            </svg>
          </div>
          <h2>Check your inbox</h2>
          <p>We sent a 6-digit code to <strong id="modalCodeEmailDisplay"></strong>. Enter it below to continue.</p>
        </div>
        <div class="auth-modal-body">
          <div id="modalCodeError" class="auth-alert auth-alert-error" style="display: none;"></div>

          <form id="modalCodeForm">
            <div class="auth-code-inputs">
              <input type="text" inputmode="numeric" maxlength="1" class="auth-code-digit modal-code-digit" data-index="0" autocomplete="one-time-code">
              <input type="text" inputmode="numeric" maxlength="1" class="auth-code-digit modal-code-digit" data-index="1">
              <input type="text" inputmode="numeric" maxlength="1" class="auth-code-digit modal-code-digit" data-index="2">
              <span class="auth-code-sep">&ndash;</span>
              <input type="text" inputmode="numeric" maxlength="1" class="auth-code-digit modal-code-digit" data-index="3">
              <input type="text" inputmode="numeric" maxlength="1" class="auth-code-digit modal-code-digit" data-index="4">
              <input type="text" inputmode="numeric" maxlength="1" class="auth-code-digit modal-code-digit" data-index="5">
            </div>
            <button type="submit" class="auth-submit-btn" id="modalVerifyCodeBtn">
              <span class="btn-text">Verify and continue &rarr;</span>
              <span class="btn-loader" style="display: none;">
                <svg class="spinner" viewBox="0 0 50 50"><circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle></svg>
              </span>
            </button>
          </form>

          <div class="auth-code-actions">
            <span>Didn&rsquo;t get it?</span>
            <button type="button" id="modalResendCodeBtn" class="auth-link-btn">Resend code</button>
            <span class="auth-code-actions-sep">&middot;</span>
            <button type="button" id="modalChangeEmailBtn" class="auth-link-btn">Use a different email</button>
          </div>
        </div>
      </div>

      <!-- Step 3: Display Name + Username (new users) -->
      <div id="modalStepUsername" style="display: none;">
        <div class="auth-modal-header">
          <h2>One last step</h2>
          <p>Tell us how you&rsquo;d like to appear on Androma. You can change your name later, but your handle is permanent.</p>
        </div>
        <div class="auth-modal-body">
          <div id="modalUsernameError" class="auth-alert auth-alert-error" style="display: none;"></div>

          <form id="modalUsernameForm">
            <div class="auth-field">
              <label for="modalRegDisplayName">Your name</label>
              <div class="auth-input-wrap">
                <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
                <input type="text" id="modalRegDisplayName" name="display_name" placeholder="e.g. Leonhard Euler" required autocomplete="name" maxlength="80">
              </div>
              <p class="auth-field-hint">Shown on your profile and next to every page or theorem you contribute.</p>
            </div>
            <div class="auth-field">
              <label for="modalRegUsername">Handle</label>
              <div class="auth-handle-wrap">
                <span class="auth-handle-prefix">androma.org/u/</span>
                <input type="text" id="modalRegUsername" name="username" placeholder="gauss42" required autocomplete="username" minlength="3" maxlength="20" pattern="[a-zA-Z0-9_-]+">
              </div>
              <p class="auth-field-hint">3&ndash;20 characters. Letters, numbers, hyphens, underscores. Cannot be changed.</p>
            </div>
            <div class="auth-terms">
              <label class="auth-checkbox-label">
                <input type="checkbox" id="modalAgreeTerms" name="agreeTerms" required>
                <span class="auth-checkbox-custom"></span>
                <span>I agree to the <a href="/terms" target="_blank">Terms of Service</a> and <a href="/privacy" target="_blank">Privacy Policy</a>, and that my contributions will be licensed under <strong>CC BY-SA 4.0</strong>.</span>
              </label>
            </div>
            <button type="submit" class="auth-submit-btn" id="modalCreateAccountBtn">
              <span class="btn-text">Claim handle and continue &rarr;</span>
              <span class="btn-loader" style="display: none;">
                <svg class="spinner" viewBox="0 0 50 50"><circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle></svg>
              </span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Onboarding Welcome Modal -->
  <style>
    /* Onboarding tour modal - personalized first-run showcase */
    #onboardingModal {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px;
      box-sizing: border-box;
      animation: onboardingFadeIn 0.2s ease;
    }
    #onboardingModal .onboarding-overlay {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(28, 27, 25, 0.42);
    }
    #onboardingModal .onboarding-content {
      position: relative;
      background: var(--color-bg-primary);
      border: 1px solid var(--color-border-primary);
      width: 100%;
      max-width: 1120px;
      max-height: calc(100vh - 48px);
      box-shadow: 0 22px 70px rgba(28, 27, 25, 0.22), 0 4px 16px rgba(28, 27, 25, 0.1);
      animation: onboardingSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      overflow: auto;
    }
    @keyframes onboardingSlideUp {
      from { transform: translateY(20px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }
    @keyframes onboardingFadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    .onboarding-close {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 34px;
      height: 34px;
      border: 1px solid var(--color-border-primary);
      background: var(--color-bg-primary);
      color: var(--color-text-secondary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 3;
      transition: border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }
    .onboarding-close:hover {
      color: var(--color-text-primary);
      border-color: var(--color-border-strong, var(--color-border-primary));
      transform: translateY(-1px);
    }
    .onboarding-close svg { width: 16px; height: 16px; }

    .onboarding-shell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 392px;
      min-height: 640px;
    }
    .onboarding-main {
      padding: 44px 52px 42px;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    .onboarding-showcase {
      position: relative;
      overflow: hidden;
      border-left: 1px solid var(--color-border-primary);
      background:
        linear-gradient(90deg, rgba(92, 111, 91, 0.06) 1px, transparent 1px),
        linear-gradient(0deg, rgba(92, 111, 91, 0.06) 1px, transparent 1px),
        var(--color-bg-secondary);
      background-size: 28px 28px, 28px 28px, auto;
      padding: 42px 34px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 28px;
    }

    .onboarding-header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      position: relative;
      z-index: 1;
    }
    .onboarding-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }
    .onboarding-brand img { width: 26px; height: 26px; }
    .onboarding-brand span {
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 600;
      color: var(--color-text-primary);
    }
    .onboarding-eyebrow {
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-tertiary);
    }
    .onboarding-title {
      font-family: 'Baskervville', Georgia, serif;
      font-size: clamp(34px, 5vw, 50px);
      font-weight: 400;
      color: var(--color-text-primary);
      margin: 0;
      line-height: 1.08;
      letter-spacing: 0;
    }
    .onboarding-subhead {
      font-family: var(--font-sans);
      font-size: 15px;
      color: var(--color-text-secondary);
      max-width: 650px;
      line-height: 1.6;
      margin: 8px 0 0;
    }
    .onboarding-subhead strong {
      color: var(--color-text-primary);
      font-weight: 600;
    }

    .onboarding-stage[hidden] { display: none; }
    .onboarding-stage {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .onboarding-personas {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 34px;
      position: relative;
      z-index: 1;
    }
    .onboarding-persona {
      background: var(--color-bg-primary);
      border: 1px solid var(--color-border-primary);
      border-radius: 8px;
      padding: 16px;
      display: grid;
      grid-template-columns: 34px 1fr;
      gap: 12px;
      min-height: 116px;
      cursor: pointer;
      color: var(--color-text-primary);
      text-align: left;
      transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }
    .onboarding-persona:hover,
    .onboarding-persona:focus-visible {
      transform: translateY(-2px);
      border-color: var(--color-accent);
      outline: none;
      background: color-mix(in srgb, var(--color-accent) 6%, var(--color-bg-primary));
    }
    .onboarding-persona-mark {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      border: 1px solid color-mix(in srgb, var(--color-accent) 42%, var(--color-border-primary));
      color: var(--color-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      background: color-mix(in srgb, var(--color-accent) 8%, transparent);
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 700;
    }
    .onboarding-persona-title,
    .onboarding-rec h3 {
      font-family: var(--font-sans);
      font-size: 16px;
      font-weight: 700;
      color: var(--color-text-primary);
      margin: 0;
      line-height: 1.25;
    }
    .onboarding-persona-copy,
    .onboarding-rec p {
      font-family: var(--font-sans);
      font-size: 13px;
      color: var(--color-text-secondary);
      line-height: 1.55;
      margin: 6px 0 0;
      display: block;
    }

    .onboarding-path-top {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 22px;
    }
    .onboarding-back {
      border: 1px solid var(--color-border-primary);
      background: var(--color-bg-primary);
      color: var(--color-text-secondary);
      width: 34px;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: border-color 0.18s ease, color 0.18s ease;
    }
    .onboarding-back:hover {
      color: var(--color-text-primary);
      border-color: var(--color-border-strong, var(--color-border-primary));
    }
    .onboarding-back svg { width: 16px; height: 16px; }
    .onboarding-persona-label {
      font-size: 12px;
      font-family: var(--font-sans);
      font-weight: 600;
      color: var(--color-text-secondary);
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border-primary);
      border-radius: 999px;
      padding: 5px 10px;
    }

    .onboarding-recommendations {
      display: grid;
      gap: 10px;
      margin-top: 26px;
    }
    .onboarding-rec {
      display: grid;
      grid-template-columns: 74px 1fr;
      gap: 14px;
      align-items: start;
      text-decoration: none;
      color: inherit;
      border: 1px solid var(--color-border-primary);
      border-radius: 8px;
      padding: 14px;
      transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }
    .onboarding-rec:hover,
    .onboarding-rec:focus-visible {
      transform: translateX(2px);
      border-color: var(--color-accent);
      outline: none;
      background: color-mix(in srgb, var(--color-accent) 5%, var(--color-bg-primary));
    }
    .onboarding-rec-tag {
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 700;
      color: var(--color-accent);
      border: 1px solid color-mix(in srgb, var(--color-accent) 38%, var(--color-border-primary));
      border-radius: 999px;
      padding: 4px 7px;
      text-align: center;
      line-height: 1.2;
    }

    .onboarding-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: auto;
      padding-top: 30px;
    }
    .onboarding-primary,
    .onboarding-secondary {
      font-family: var(--font-sans);
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      border-radius: 8px;
      padding: 0 16px;
      font-size: 13px;
      cursor: pointer;
      transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
    }
    .onboarding-primary {
      background: var(--color-text-primary);
      color: var(--color-bg-primary);
      border: 1px solid var(--color-text-primary);
    }
    .onboarding-primary:hover { transform: translateY(-1px); }
    .onboarding-secondary {
      color: var(--color-text-primary);
      background: var(--color-bg-primary);
      border: 1px solid var(--color-border-primary);
    }
    .onboarding-secondary:hover {
      transform: translateY(-1px);
      border-color: var(--color-border-strong, var(--color-border-primary));
    }
    .onboarding-skip {
      border: 0;
      background: transparent;
      color: var(--color-text-tertiary);
      cursor: pointer;
      font-family: var(--font-sans);
      font-size: 13px;
      padding: 0;
      border-bottom: 1px dashed var(--color-border-strong, var(--color-border-primary));
    }
    .onboarding-skip:hover { color: var(--color-text-secondary); }
    .onboarding-note {
      color: var(--color-text-tertiary);
      font-size: 12px;
      line-height: 1.5;
      margin: 16px 0 0;
      max-width: 520px;
    }

    .onboarding-preview-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-tertiary);
      margin: 0 0 14px;
    }
    .onboarding-preview {
      border: 1px solid var(--color-border-primary);
      background: var(--color-bg-primary);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 10px 32px rgba(28, 27, 25, 0.08);
    }
    .onboarding-preview-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      border-bottom: 1px solid var(--color-border-primary);
      padding: 10px 12px;
    }
    .onboarding-preview-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-border-primary);
    }
    .onboarding-preview-dot:nth-child(1) { background: #d77b61; }
    .onboarding-preview-dot:nth-child(2) { background: #d6ae4b; }
    .onboarding-preview-dot:nth-child(3) { background: #6d9f74; }
    .onboarding-preview-body { padding: 16px; }
    .onboarding-preview-search {
      border: 1px solid var(--color-border-primary);
      border-radius: 8px;
      padding: 9px 11px;
      color: var(--color-text-secondary);
      font-size: 12px;
      margin-bottom: 14px;
      background: var(--color-bg-secondary);
      overflow-wrap: anywhere;
    }
    .onboarding-preview-result {
      border-left: 2px solid var(--color-accent);
      padding-left: 12px;
      margin-bottom: 16px;
    }
    .onboarding-preview-result h3 {
      font-family: 'Baskervville', Georgia, serif;
      font-size: 22px;
      line-height: 1.15;
      font-weight: 400;
      margin: 0 0 7px;
      color: var(--color-text-primary);
      overflow-wrap: anywhere;
    }
    .onboarding-preview-result p {
      font-size: 12px;
      line-height: 1.55;
      color: var(--color-text-secondary);
      margin: 0;
    }
    .onboarding-preview-flow {
      display: grid;
      gap: 8px;
      margin-top: 16px;
    }
    .onboarding-preview-step {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 9px;
      align-items: center;
      color: var(--color-text-secondary);
      font-size: 12px;
      opacity: 0.5;
      transform: translateY(0);
      animation: onboardingStepIn 6s ease infinite;
      min-width: 0;
    }
    .onboarding-preview-step:nth-child(2) { animation-delay: 1.1s; }
    .onboarding-preview-step:nth-child(3) { animation-delay: 2.2s; }
    .onboarding-preview-step:nth-child(4) { animation-delay: 3.3s; }
    .onboarding-preview-step span:first-child {
      width: 24px;
      height: 24px;
      border: 1px solid color-mix(in srgb, var(--color-accent) 38%, var(--color-border-primary));
      color: var(--color-accent);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
      background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg-primary));
    }
    @keyframes onboardingStepIn {
      0%, 8% { opacity: 0.5; transform: translateY(0); }
      16%, 58% { opacity: 1; transform: translateY(0); }
      72%, 100% { opacity: 0.5; transform: translateY(0); }
    }
    .onboarding-showcase-copy h2 {
      font-family: 'Baskervville', Georgia, serif;
      font-size: 28px;
      line-height: 1.15;
      font-weight: 400;
      color: var(--color-text-primary);
      margin: 0 0 10px;
      letter-spacing: 0;
    }
    .onboarding-showcase-copy p {
      color: var(--color-text-secondary);
      font-size: 13px;
      line-height: 1.6;
      margin: 0;
    }
    .onboarding-mini-map {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 22px;
    }
    .onboarding-mini-map span {
      height: 7px;
      background: color-mix(in srgb, var(--color-accent) 24%, var(--color-border-primary));
    }
    .onboarding-mini-map span:nth-child(2) { background: #6f8fb4; }
    .onboarding-mini-map span:nth-child(3) { background: #be8a5a; }
    .onboarding-mini-map span:nth-child(5) { background: #6d9f74; }

    @media (max-width: 1119px) {
      #onboardingModal { padding: 16px; }
      #onboardingModal .onboarding-content { max-height: calc(100vh - 32px); }
      .onboarding-shell { grid-template-columns: 1fr; min-height: 0; }
      .onboarding-main { padding: 36px 22px 28px; }
      .onboarding-showcase {
        border-left: 0;
        border-top: 1px solid var(--color-border-primary);
        padding: 24px 22px;
      }
      .onboarding-personas { grid-template-columns: 1fr; margin-top: 26px; }
      .onboarding-persona { min-height: 0; }
      .onboarding-rec { grid-template-columns: 1fr; }
      .onboarding-rec-tag { width: fit-content; }
      .onboarding-actions { margin-top: 24px; }
      .onboarding-primary,
      .onboarding-secondary { width: 100%; }
    }
    @media (max-width: 699px) {
      .onboarding-main { padding: 36px 22px 24px; }
      .onboarding-title { font-size: 34px; }
      .onboarding-subhead { font-size: 14px; }
      .onboarding-recommendations { gap: 8px; margin-top: 20px; }
      .onboarding-rec { padding: 12px; }
      .onboarding-actions { padding-top: 20px; }
      .onboarding-showcase { display: none; }
    }
  </style>
  <div id="onboardingModal" role="dialog" aria-modal="true" aria-labelledby="onboardingTitle" style="display: none;">
    <div class="onboarding-overlay"></div>
    <div class="onboarding-content">
      <button type="button" class="onboarding-close" id="onboardingClose" aria-label="Skip onboarding">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="onboarding-shell">
        <section class="onboarding-main">
          <div class="onboarding-stage" data-onboarding-step="persona">
            <div class="onboarding-header">
              <div class="onboarding-brand">
                <img src="/images/logo_nobackground.svg" alt="Androma" width="26" height="26">
                <span>Androma</span>
              </div>
              <span class="onboarding-eyebrow">Quick setup</span>
              <h1 class="onboarding-title" id="onboardingTitle">What brings you to Androma?</h1>
              <p class="onboarding-subhead">Pick the closest answer and we will show the parts of the platform most likely to matter first. <strong>You can use everything either way.</strong></p>
            </div>

            <div class="onboarding-personas" aria-label="Choose a starting point">
              <button type="button" class="onboarding-persona" data-persona="learning">
                <span class="onboarding-persona-mark">01</span>
                <span class="onboarding-persona-body">
                  <span class="onboarding-persona-title">Learning math</span>
                  <span class="onboarding-persona-copy">I am building foundations, revising for exams, or following a course.</span>
                </span>
              </button>
              <button type="button" class="onboarding-persona" data-persona="research">
                <span class="onboarding-persona-mark">02</span>
                <span class="onboarding-persona-body">
                  <span class="onboarding-persona-title">Writing or research</span>
                  <span class="onboarding-persona-copy">I want TeX, theorem links, papers, and a cleaner way to work in public.</span>
                </span>
              </button>
              <button type="button" class="onboarding-persona" data-persona="teaching">
                <span class="onboarding-persona-mark">03</span>
                <span class="onboarding-persona-body">
                  <span class="onboarding-persona-title">Teaching a course</span>
                  <span class="onboarding-persona-copy">I need notes, assignments, questions, and a place for students to gather.</span>
                </span>
              </button>
              <button type="button" class="onboarding-persona" data-persona="contributing">
                <span class="onboarding-persona-mark">04</span>
                <span class="onboarding-persona-body">
                  <span class="onboarding-persona-title">Contributing knowledge</span>
                  <span class="onboarding-persona-copy">I want to improve pages, review changes, or connect results across the wiki.</span>
                </span>
              </button>
              <button type="button" class="onboarding-persona" data-persona="exploring">
                <span class="onboarding-persona-mark">05</span>
                <span class="onboarding-persona-body">
                  <span class="onboarding-persona-title">Just exploring</span>
                  <span class="onboarding-persona-copy">I want a fast overview before I decide where to spend time.</span>
                </span>
              </button>
            </div>

            <div class="onboarding-actions">
              <button type="button" class="onboarding-skip" id="onboardingSkip">Skip for now</button>
            </div>
          </div>

          <div class="onboarding-stage" data-onboarding-step="path" hidden>
            <div class="onboarding-path-top">
              <button type="button" class="onboarding-back" id="onboardingBack" aria-label="Back to choices">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <span class="onboarding-persona-label" id="onboardingPersonaLabel">Learning math</span>
            </div>

            <div class="onboarding-header">
              <span class="onboarding-eyebrow">Recommended start</span>
              <h1 class="onboarding-title" id="onboardingPathTitle">Start with a route through the knowledge graph.</h1>
              <p class="onboarding-subhead" id="onboardingPathSummary">Androma connects pages, theorems, notes, and practice so the next useful thing is never far away.</p>
            </div>

            <div class="onboarding-recommendations" id="onboardingRecommendations"></div>

            <div class="onboarding-actions">
              <a href="/learn" class="onboarding-primary" id="onboardingPrimary">Start with this</a>
              <a href="/pages" class="onboarding-secondary" id="onboardingSecondary">Show me everything</a>
            </div>
            <p class="onboarding-note">This only chooses your first stop. Androma does not lock features by role, and you can come back to any area whenever you like.</p>
          </div>
        </section>

        <aside class="onboarding-showcase" aria-label="Androma preview">
          <div>
            <p class="onboarding-preview-label">Live shape of the platform</p>
            <div class="onboarding-preview" aria-hidden="true">
              <div class="onboarding-preview-bar">
                <span class="onboarding-preview-dot"></span>
                <span class="onboarding-preview-dot"></span>
                <span class="onboarding-preview-dot"></span>
              </div>
              <div class="onboarding-preview-body">
                <div class="onboarding-preview-search" id="onboardingPreviewQuery">Search: compactness in metric spaces</div>
                <div class="onboarding-preview-result">
                  <h3 id="onboardingPreviewTitle">Heine-Borel Theorem</h3>
                  <p id="onboardingPreviewText">A theorem page links definitions, prerequisites, proofs, and nearby ideas into one navigable object.</p>
                </div>
                <div class="onboarding-preview-flow">
                  <div class="onboarding-preview-step"><span>1</span><span id="onboardingPreviewStep1">Find a page or theorem</span></div>
                  <div class="onboarding-preview-step"><span>2</span><span id="onboardingPreviewStep2">Follow the prerequisite trail</span></div>
                  <div class="onboarding-preview-step"><span>3</span><span id="onboardingPreviewStep3">Save it to study</span></div>
                  <div class="onboarding-preview-step"><span>4</span><span id="onboardingPreviewStep4">Discuss or contribute</span></div>
                </div>
              </div>
            </div>
          </div>

          <div class="onboarding-showcase-copy">
            <h2 id="onboardingShowcaseTitle">A wiki that behaves like a workspace.</h2>
            <p id="onboardingShowcaseText">Read, write, teach, discuss, and revise around the same mathematical objects instead of scattering context across separate tools.</p>
            <div class="onboarding-mini-map" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
  

  <main class="layout-full">
    <style>
        /* Warm Patina design system */
        .theorem-title {
            color: var(--color-text-primary, var(--night));
        }

        .theorem-breadcrumb {
            display: flex;
            align-items: center;
            font-size: 14px;
            color: var(--color-text-secondary, var(--ink-2));
            margin-bottom: 16px;
            gap: 8px;
        }

        .breadcrumb-item {
            background: var(--color-bg-secondary, var(--grey-tint));
            padding: 4px 12px;
            border-radius: 18px;
            font-weight: 500;
        }
        .view-tags-btn {
            margin: 0px ;
            gap: 0px;
        }

        .breadcrumb-separator {
            color: var(--color-border-primary, var(--hairline));
        }
        
        /* --- NEW CSS ADDED HERE --- */
        .theorem-box-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px; /* Adds space below the header line */
        }

        .theorem-header-actions {
            display: flex;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .theorem-header-actions::-webkit-scrollbar {
            display: none;
        }

        .theorem-header-actions a {
            white-space: nowrap;
            flex-shrink: 0;
        }

        @media (max-width: 1119px) {
            .theorem-box-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .theorem-header-actions {
                width: 100%;
                gap: 4px;
            }

        }

        .header-action-link {
            font-size: 14px;
            font-weight: 500;
            color: var(--accent-color); /* Patina accent link */
            text-decoration: none;
            transition: text-decoration 0.2s ease;
        }

        .header-action-link:hover {
            text-decoration: underline;
        }
        /* --- END OF NEW CSS --- */

        /* Statement actions inside theorem box */
        .statement-actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
            padding-top: 20px;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
        }

        .statement-actions .left-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: center;
        }

        .statement-actions .right-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-left: auto;
        }

        /* Action buttons removed — using .btn .btn-primary / .btn-secondary instead */

        /* Content styling */
        .content-text {
            font-size: 16px;
            line-height: 1.6;
            color: var(--color-text-primary, var(--night));
        }

        .content-text p {
            margin-bottom: 16px;
        }

        .content-text h1, .content-text h2, .content-text h3 {
            color: var(--color-text-primary, var(--night));
            font-weight: 700;
            margin: 24px 0 16px 0;
        }

        .content-text h1 { font-size: 28px; }
        .content-text h2 { font-size: 24px; }
        .content-text h3 { font-size: 20px; }

        .content-text ul, .content-text ol {
            margin: 16px 0;
            padding-left: 24px;
        }

        .content-text li {
            margin-bottom: 8px;
        }

        .content-text code {
            background: var(--color-bg-secondary, var(--grey-tint));
            padding: 2px 6px;
            border-radius: 4px;
            font-family: 'SF Mono', Monaco, monospace;
            font-size: 14px;
        }

        .content-text pre {
            background: var(--color-bg-secondary, var(--grey-tint));
            padding: 16px;
            border-radius: 8px;
            overflow-x: auto;
            margin: 16px 0;
        }

        /* Navigation tabs */
        .theorem-nav {
            display: flex;
            gap: 0;
            margin-bottom: 0;
            border-bottom: 1px solid var(--color-border-primary, var(--hairline));
        }

        .nav-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            background: transparent;
            border: none;
            border-bottom: 2px solid transparent;
            padding: 12px 20px;
            border-radius: 0;
            font-size: 14px;
            font-weight: 500;
            color: var(--color-text-secondary, var(--ink-2));
            cursor: pointer;
            transition: color 0.2s, border-color 0.2s;
            opacity: 1;
            box-shadow: none;
        }

        .nav-btn:hover {
            color: var(--color-text-primary, var(--night));
            background: transparent;
            transform: none;
            opacity: 1;
        }

        .nav-btn.active {
            background: transparent;
            color: var(--color-text-primary, var(--night));
            opacity: 1;
            box-shadow: none;
            border-bottom-color: var(--color-text-primary, var(--night));
            font-weight: 600;
        }

        /* glide (ui-system): the ink underline travels between sections;
           the active tab stops painting its own once the indicator is live */
        .theorem-nav .sys-glide { background: var(--color-text-primary, var(--night)); }
        .theorem-nav.glide-on .nav-btn.active { border-bottom-color: transparent; }

        .nav-btn.active:hover {
            color: var(--color-text-primary, var(--night));
            transform: none;
        }

        .nav-btn svg {
            width: 18px;
            height: 18px;
        }

        /* Section visibility controls */
        .theorem-section.hideable {
            display: none;
        }

        .theorem-section.hideable.active {
            display: block;
            border: none;
            border-radius: 0;
            padding: 24px 0;
        }

        /* Content sections */
        .theorem-section {
            margin-top: 15px;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--color-border-primary, var(--hairline));
        }

        .section-icon {
            width: 24px;
            height: 24px;
            color: var(--color-text-primary, var(--night));
        }

        .section-header .section-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--color-text-primary, var(--night));
            margin: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        /* Empty state styling */
        .empty-content {
            text-align: center;
            color: var(--color-text-secondary, var(--ink-2));
            font-style: italic;
            padding: 40px 20px;
            background: var(--color-bg-secondary, var(--grey-tint));
            border-radius: 8px;
        }

        .proof-under-construction-state {
            font-style: normal;
        }

        .proof-under-construction-title {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
            color: var(--color-text-primary, var(--night));
        }

        .proof-under-construction-copy {
            margin: 10px auto 0;
            max-width: 680px;
            font-size: 15px;
            line-height: 1.6;
            color: var(--color-text-secondary, var(--ink-2));
        }

        .proof-under-construction-meta {
            margin-top: 18px;
            font-size: 14px;
            color: var(--color-text-tertiary, #7A8391);
        }

        .proof-under-construction-meta a {
            color: var(--color-text-primary, var(--night));
            font-weight: 600;
            text-decoration: none;
        }

        .proof-under-construction-meta a:hover {
            text-decoration: underline;
        }

        .proof-under-construction-illustration {
            width: min(300px, 100%);
            margin: -8px auto 14px;
            color: var(--color-text-primary, var(--night));
        }

        /* Tags section - simplified styling */
        .tags-section {
            background: transparent;
            border-radius: 0;
            padding: 0;
            margin-top: 15px;
            box-shadow: none;
            border-top: 1px solid var(--color-border-primary, var(--hairline));
        }

        .tags-section .section-header {
            display: none;
        }

        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }

        /* Prerequisites section styling */
        .prereq-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .prereq-list li {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 0;
            border-bottom: 1px solid var(--color-bg-secondary, var(--grey-tint));
            font-size: 14px;
        }

        .prereq-list li:last-child {
            border-bottom: none;
        }

        .prereq-check {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .prereq-check.met {
            background: var(--accent-color);
            color: var(--color-text-inverse, #fff);
        }

        .prereq-check.unmet {
            background: var(--color-bg-primary, #fff);
            border: 2px solid var(--color-border-primary, var(--hairline));
        }

        .prereq-check svg {
            width: 12px;
            height: 12px;
        }

        .prereq-name {
            flex: 1;
            min-width: 0;
        }

        .prereq-name a {
            color: var(--color-text-primary, var(--night));
            text-decoration: none;
            font-weight: 500;
        }

        .prereq-name a:hover {
            color: var(--accent-color);
        }

        /* Override internal-wiki-link dotted underline for prerequisite links */
        .prereq-name a.internal-wiki-link {
            border-bottom: none;
        }

        .prereq-name a.internal-wiki-link:hover {
            border-bottom: none;
        }

        .prereq-type-badge {
            font-size: 11px;
            font-weight: 500;
            padding: 2px 8px;
            border-radius: 12px;
            background: var(--color-bg-secondary, var(--grey-tint));
            color: var(--color-text-secondary, var(--ink-2));
            border: 1px solid var(--color-border-primary, var(--hairline));
            flex-shrink: 0;
        }

        .mark-known-btn {
            background: none;
            border: 1px solid var(--color-border-primary, var(--hairline));
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s;
            flex-shrink: 0;
        }

        .mark-known-btn:hover {
            background: var(--accent-color);
            border-color: var(--accent-color);
        }

        .mark-known-btn svg {
            color: var(--color-text-secondary, var(--ink-2));
        }

        .mark-known-btn:hover svg {
            color: white;
        }

        .prereq-progress-bar {
            height: 4px;
            background: var(--color-border-primary, var(--hairline));
            border-radius: 2px;
            margin-bottom: 16px;
            overflow: hidden;
        }

        .prereq-progress-fill {
            height: 100%;
            background: var(--accent-color);
            border-radius: 2px;
            transition: width 0.3s ease;
        }

        .prereq-section-label {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--color-text-secondary, var(--ink-2));
            margin: 16px 0 8px;
            padding: 0;
        }

        .prereq-section-label:first-child {
            margin-top: 0;
        }

        /* Theorem label */
        .theorem-label {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--color-text-secondary, var(--ink-2));
        }

        /* Ready to Learn / Knowledge Gaps status */
        .prerequisite-status-text {
            display: inline-flex;
            align-items: center;
            gap: 0.375em;
            font-size: var(--font-size-md);
            font-weight: var(--font-weight-medium);
            line-height: 1.3;
            padding: 0.5em 1.125em;
            border: 1px solid transparent;
            border-radius: var(--radius-md, 6px);
            box-sizing: border-box;
            white-space: nowrap;
        }

        .prerequisite-status-text svg {
            width: 1.15em;
            height: 1.15em;
            flex-shrink: 0;
        }

        .prerequisite-status-text.ready-to-learn {
            color: var(--color-success-text, #2D6B4A);
            background: var(--color-success-subtle, var(--grey-track));
        }

        .prerequisite-status-text.knowledge-gaps {
            color: var(--color-warning, #926E18);
            background: var(--color-warning-subtle, #F5EAD0);
        }

        .knowledge-gaps-wrapper.theorem-prereq-status-slot {
            min-width: 168px;
            min-height: 34px;
            align-items: center;
            flex-shrink: 0;
        }

        .theorem-prereq-status-slot.is-reserved {
            visibility: hidden;
            pointer-events: none;
        }

        .prerequisite-status-text.prereq-status-skeleton {
            width: 100%;
            min-height: 34px;
            color: transparent;
            background: var(--color-bg-secondary, var(--grey-tint));
            border: 1px solid var(--color-border-primary, var(--hairline));
            position: relative;
            overflow: hidden;
        }

        .prerequisite-status-text.prereq-status-skeleton::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
            transform: translateX(-100%);
            animation: prereq-status-skeleton 1.4s ease-in-out infinite;
        }

        @keyframes prereq-status-skeleton {
            to {
                transform: translateX(100%);
            }
        }

        /* Header action links */
        .view-tags-btn {
            color: var(--color-text-secondary, var(--ink-2));
            font-size: 13px;
            transition: color 0.2s;
        }

        .view-tags-btn:hover {
            color: var(--color-text-primary, var(--night));
        }

        /* Multi-proof: switcher dropdown in the Proof section header. */
        .proof-switcher {
            display: inline-flex;
            align-items: center;
            gap: 8px;
