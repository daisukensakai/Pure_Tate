  <!-- MathJax Configuration with Click-to-Copy and Progressive Rendering -->
  <script type="text/javascript">
    // Preserve MathJax if already fully initialized (e.g. after SPA navigation)
    if (!window.MathJax?.typesetPromise) {
    window.MathJax = {
      // Preload the html package (\href etc.) instead of relying on autoload:
      // on-demand loading races SPA-navigation typesets, intermittently
      // rendering \href without its link.
      loader: { load: ['[tex]/html', '[tex]/mathtools'] },
      options: {
        // Skip processing elements with these classes
        ignoreHtmlClass: 'raw-markdown-content|tex2jax_ignore',
        processHtmlClass: 'tex2jax_process|rendered-markdown-content|page-preview-content|theorem-preview-content|math-chunk',
        // Enable progressive rendering - don't block on large documents
        renderActions: {
          addMenu: [],  // Disable menu to speed up rendering
        }
      },
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true,
        processEnvironments: true,
        processRefs: true,
        // AndromaLocalRefs injects explicit \tag{n}; automatic AMS tags drift
        // when long pages are typeset lazily in chunks.
        tags: 'none',
        useLabelIds: true,
        packages: { '[+]': ['html', 'mathtools'] },
        autoload: {
          unicode: ['unicode'],
          // Setting `autoload` replaces MathJax's default table, which is what
          // silently disabled \href (the cite modal's "Inline Hyperlink" option).
          html: ['href', 'class', 'style', 'cssId']
        }
      },
      svg: {
        fontCache: 'global',
        scale: 1,
        minScale: 0.5
      },
      startup: {
        // Don't typeset automatically on page load - UniversalContentRenderer handles this
        typeset: false,
        ready() {
          MathJax.startup.defaultReady();
          MathJax.startup.promise.then(() => {
            window.mathJaxReady = true;
            document.dispatchEvent(new CustomEvent('mathjax:ready'));
            initializeClickToCopy();

            // Typeset the header page name (may contain LaTeX like "$H = W$")
            const headerPageName = document.querySelector('.header-page-name');
            if (headerPageName && headerPageName.textContent.includes('$')) {
              MathJax.typesetPromise([headerPageName]).catch(() => {});
            }

            // Only run progressive typeset on pages WITHOUT content renderers
            // Pages with content renderers (theorems, pages, etc.) have UniversalContentRenderer
            // which handles MathJax after rendering markdown
            const hasContentRenderers = document.querySelectorAll('.content-renderer').length > 0;
            if (!hasContentRenderers) {
              progressiveTypeset();
            }
          });
        }
      }
    };
    } // end if (!MathJax.typesetPromise)

    // Progressive math rendering - renders in chunks to avoid blocking UI
    async function progressiveTypeset() {
      if (!window.MathJax?.typesetPromise) return;
      
      // Mark page as math-loading
      document.body.classList.add('math-loading');
      
      // Get all elements that might contain math
      const mathContainers = document.querySelectorAll(
        '.wiki-content, .theorem-content, .proof-content, .rendered-markdown-content, .page-preview-content, .page-preview'
      );
      
      // If no specific containers, typeset the whole document in one go
      if (mathContainers.length === 0) {
        try {
          await MathJax.typesetPromise();
        } catch (e) {
          console.warn('MathJax typeset error:', e);
        }
        document.body.classList.remove('math-loading');
        document.body.classList.add('math-ready');
        return;
      }
      
      // Process containers in chunks using requestIdleCallback for non-blocking
      const processChunk = async (containers, index) => {
        if (index >= containers.length) {
          document.body.classList.remove('math-loading');
          document.body.classList.add('math-ready');
          return;
        }
        
        const container = containers[index];
        try {
          await MathJax.typesetPromise([container]);
        } catch (e) {
          console.warn('MathJax chunk error:', e);
        }
        
        // Use requestIdleCallback if available, otherwise setTimeout
        if (window.requestIdleCallback) {
          requestIdleCallback(() => processChunk(containers, index + 1), { timeout: 100 });
        } else {
          setTimeout(() => processChunk(containers, index + 1), 10);
        }
      };
      
      // Start processing
      processChunk(Array.from(mathContainers), 0);
    }
    
    // Click-to-copy functionality
    function initializeClickToCopy() {
      if (window.__andromaMathClickToCopyInitialized) return;
      window.__andromaMathClickToCopyInitialized = true;

      // SVG event targets are not consistent across browsers. Chromium
      // normally reports the glyph inside MathJax's <a>, while Safari can
      // retarget the same click to the surrounding <svg>/<mjx-container>.
      // Resolve through the composed path first, then fall back to the link's
      // rendered hit box so a genuine \href never becomes a copy gesture.
      function findMathLinkForClick(event, mathElement) {
        const path = typeof event.composedPath === 'function' ? event.composedPath() : [];
        for (const node of path) {
          if (!node || node.nodeType !== Node.ELEMENT_NODE) continue;
          const link = node.matches?.('a[href]') ? node : node.closest?.('a[href]');
          if (link && mathElement.contains(link)) return link;
        }

        const direct = event.target?.closest?.('a[href]');
        if (direct && mathElement.contains(direct)) return direct;

        if (!Number.isFinite(event.clientX) || !Number.isFinite(event.clientY)) return null;
        return Array.from(mathElement.querySelectorAll('a[href]')).find(link =>
          Array.from(link.getClientRects()).some(rect =>
            event.clientX >= rect.left && event.clientX <= rect.right &&
            event.clientY >= rect.top && event.clientY <= rect.bottom
          )
        ) || null;
      }

      // Add click handlers to all MathJax elements
      document.addEventListener('click', function(event) {
        const mathElement = event.target?.closest?.('.MathJax');
        if (mathElement) {
          // \href links inside math: left click navigates instead of copying
          // (right click still copies via the contextmenu handler below).
          const mathLink = findMathLinkForClick(event, mathElement);
          if (mathLink) {
            // The geometry fallback means the browser did not expose the link
            // in the event path, so it will not perform anchor activation on
            // its own. Re-dispatch from the anchor; the next pass resolves it
            // from the composed path and falls through to normal SPA/default
            // navigation without copying.
            if (!event.target?.closest?.('a[href]')) {
              event.preventDefault();
              event.stopImmediatePropagation();
              mathLink.click();
            }
            return;
          }

          // An unlinked later use of a locally bound symbol owns the left
          // click: the binding interaction jumps to its declaration. Linked
          // occurrences returned above, so their hyperlink wins instead.
          // Right click still copies the surrounding expression. Passivity
          // is per binding: only a declaration's OWN tokens fall through to
          // copy — another binding's occurrence inside a declaration body
          // still belongs to the binding jump (binding-preview.js is the
          // shared authority on that distinction).
          const bindingOccurrence = event.target.closest('.bind-occ');
          if (bindingOccurrence &&
              !window.AndromaBindingPreview?.passiveOccurrence(bindingOccurrence)) return;

          // Important: Prevent default and stop immediate propagation
          event.preventDefault();
          event.stopImmediatePropagation(); // Stronger than stopPropagation

          copyMathToClipboard(mathElement);
          return false; // Another way to prevent propagation
        }
      }, true); // Use capturing phase to intercept before other handlers

      // Right click copies too — and is the only copy gesture on math that
      // contains an \href link (where left click is reserved for navigation).
      document.addEventListener('contextmenu', function(event) {
        const mathElement = event.target?.closest?.('.MathJax');
        if (mathElement) {
          event.preventDefault();
          event.stopImmediatePropagation();
          copyMathToClipboard(mathElement);
        }
      }, true);
      
      // Add hover styles
      if (document.getElementById('androma-math-copy-styles')) return;
      const style = document.createElement('style');
      style.id = 'androma-math-copy-styles';
      style.textContent = `
        .MathJax {
          cursor: pointer;
          transition: background-color 0.2s, color 0.2s, transform 0.3s ease;
          padding: 0 4px;
          border-radius: var(--radius-sm, 3px);
        }
        .math-copied {
          background-color: var(--math-copied-bg, var(--color-bg-active)) !important;
          color: var(--color-text-primary) !important;
          transform: scale(1.02);
        }
        .copy-toast {
          position: fixed;
          top: 20px;
          right: 20px;
          background-color: var(--color-bg-primary);
          color: var(--color-text-primary);
          border: 1px solid var(--color-border-primary);
          padding: 10px 20px;
          border-radius: var(--radius-md, 6px);
          box-shadow: var(--shadow-lg, 0 12px 24px rgba(0, 0, 0, 0.18));
          opacity: 0;
          transition: opacity 0.3s;
          z-index: 10000;
          font-family: 'Inter', sans-serif;
          font-size: 14px;
          max-width: 300px;
          word-break: break-all;
        }
        .copy-toast.show {
          opacity: 1;
        }
      `;
      document.head.appendChild(style);
    }
    
    // The extractor itself lives in /js/modules/math-source.js so the content
    // renderer's copy paths share one definition of "clean TeX" (binding
    // \class wrappers and \href link metadata removed).
    function getMathLatexSource(mathElement) {
      return window.AndromaMath?.getLatexSource?.(mathElement) || '';
    }

    function copyMathToClipboard(mathElement) {
      const latex = getMathLatexSource(mathElement);
      
      if (latex) {
        // Copy to clipboard
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(latex).then(() => {
            showCopyFeedback(mathElement, latex);
          }).catch(err => {
            console.error('Failed to copy to clipboard:', err);
            fallbackCopyToClipboard(latex);
            showCopyFeedback(mathElement, latex);
          });
        } else {
          fallbackCopyToClipboard(latex);
          showCopyFeedback(mathElement, latex);
        }
      }
    }
    
    function fallbackCopyToClipboard(text) {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-999999px';
      textArea.style.top = '-999999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      
      try {
        document.execCommand('copy');
      } catch (err) {
        console.error('Fallback copy failed:', err);
      }
      
      document.body.removeChild(textArea);
    }
    
    function showCopyFeedback(mathElement, latex) {
      // Visual feedback on math element
      mathElement.classList.add('math-copied');
      setTimeout(() => {
        mathElement.classList.remove('math-copied');
      }, 300);
      
      // Create or update toast notification
      let toast = document.getElementById('copy-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'copy-toast';
        toast.className = 'copy-toast';
        document.body.appendChild(toast);
      }
      
      toast.textContent = `Copied: ${latex.substring(0, 50)}${latex.length > 50 ? '...' : ''}`;
      toast.classList.add('show');
      
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2000);
    }

    initializeClickToCopy();
  </script>
  
  <!-- In the head section - load marked.js asynchronously -->
  <script defer src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <!-- MathJax is loaded on demand by LazyMathRenderer when visible math needs it. -->
  
