  <!-- Universal Content Renderer (must load before preview scripts) -->
  <script type="module">
    // Import and initialize Universal Content Renderer when DOM is ready
    import { UniversalContentRenderer } from '/js/modules/universal-content-renderer.js?v=1.1.7-11ffffbc';
    
    // Make it globally available
    window.UniversalContentRenderer = UniversalContentRenderer;
    
    document.addEventListener('DOMContentLoaded', async function() {
      try {
        // Create renderer with skipAutoInit to prevent double initialization
        window.contentRenderer = new UniversalContentRenderer({
          enableMathJax: true,
          enableMarkdown: true,
          enableWikiLinks: true,
          enableTheremLinks: true,
          skipAutoInit: true // We'll initialize manually
        });

        // Wait for initialization to complete
        await window.contentRenderer.initialize();
        window.__contentRendererReady = true;
        document.dispatchEvent(new CustomEvent('androma:content-renderer-ready'));
        console.log('✅ Universal Content Renderer initialized from layout.ejs');
      } catch (error) {
        console.error('❌ Failed to initialize UniversalContentRenderer:', error);
      }
    });
  </script>
  
