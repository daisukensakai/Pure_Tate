  <!-- Inlined critical CSS — renders infrastructure (bg, header, layout) before external stylesheets -->
  <style>
    /* Critical design tokens */
    :root{--color-bg-primary:#FAFAF8;--color-bg-chrome:#FAFAF8;--color-text-primary:#2C2A26;--color-border-primary:#E8E8E3;--color-bg-secondary:#F4F3F0;--color-nav-icon:#8a877f;--color-nav-icon-hover:#454440;--image-logo-filter:none;--guest-theme-icon-sun-display:flex;--guest-theme-icon-moon-display:none;--font-sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;--font-display:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;--font-size-lg:1rem;--line-height-relaxed:1.6;--font-weight-semibold:600;--header-height:50px;--max-width:1400px;--layout-narrow:768px;--layout-medium:1024px;--layout-wide:1280px;--layout-max:1400px;--content-padding-mobile:16px;--content-padding-tablet:24px;--content-padding-desktop:32px}
    /* Dark mode (the night side) */
    html[data-theme="dark"]{--color-bg-primary:#1e2126;--color-bg-chrome:#191c21;--color-text-primary:#e8eaee;--color-border-primary:rgba(232,234,238,.08);--color-bg-secondary:#262a31;--color-nav-icon:#a7adb8;--color-nav-icon-hover:#e8eaee;--image-logo-filter:invert(1);--guest-theme-icon-sun-display:none;--guest-theme-icon-moon-display:flex}
    /* Box model + body */
    *,*::before,*::after{box-sizing:border-box}
    html{overflow-x:clip;max-width:100vw}
    body{font-family:var(--font-sans);font-size:var(--font-size-lg);line-height:var(--line-height-relaxed);color:var(--color-text-primary);background:var(--color-bg-primary);margin:0;padding:0;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;letter-spacing:-0.01em;display:flex;flex-direction:column;min-height:100vh;overflow-x:clip;max-width:100vw}
    /* Header */
    header{background-color:var(--color-bg-chrome,var(--color-bg-primary));position:fixed;top:0;left:0;right:0;z-index:1000}
    header .container{display:flex;align-items:center;justify-content:space-between;padding:0.5rem 1rem;max-width:var(--max-width);margin:0 auto;height:var(--header-height);box-sizing:border-box}
    header.header-bordered{border-bottom:1px solid var(--color-border-primary)}
    .logo{display:flex;align-items:center;margin-right:.25rem}
    .header-logo-img{display:block;width:24px;height:24px;flex:0 0 24px}
    :where(.header-logo-img,img[src$="logo_nobackground.svg"]){filter:var(--image-logo-filter,none)}
    /* Main + layout containers */
    body > main{min-height:calc(100vh - 110px);padding-top:var(--header-height);display:flex;opacity:0;transition:opacity .2s ease}
    body > main.ready{opacity:1}
    .layout-narrow,.layout-medium,.layout-wide,.layout-max{width:100%;margin-left:auto;margin-right:auto;padding-left:var(--content-padding-mobile);padding-right:var(--content-padding-mobile);box-sizing:border-box}
    .layout-narrow{max-width:var(--layout-narrow)}.layout-medium{max-width:var(--layout-medium)}.layout-wide{max-width:var(--layout-wide)}.layout-max{max-width:var(--layout-max)}
    /* FOUC guards */
    img,svg,video,canvas,picture{max-width:100%;height:auto}
    img[width],svg[width]{max-width:none}
    [hidden],.hidden{display:none!important}
    .content-renderer:not([data-render-ready]):not([data-spa-revealed]) .rendered-markdown-content{opacity:0}
    .content-renderer[data-render-ready] .rendered-markdown-content,.content-renderer[data-spa-revealed] .rendered-markdown-content{opacity:1;transition:opacity .15s ease}
    .math-chunk{transition:opacity .2s ease}.math-chunk-ready{opacity:1}
    /* Typography basics */
    h1,h2,h3,h4,h5,h6{font-weight:var(--font-weight-semibold);font-family:var(--font-display);margin-bottom:.625rem;margin-top:.625rem;color:var(--color-text-primary)}
    a{color:var(--color-text-primary);text-decoration:none}
    /* Mobile */
    @media(max-width: 1119px){body > main{padding-top:0!important}}
  </style>

