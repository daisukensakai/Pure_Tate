  <!-- Theme initialization (prevent FOUC). Cache-safe: read from localStorage
       only — the previous per-user server injection baked the requesting user's
       preferences into cached HTML (different bytes per user). auth-hydrate.js's
       applyUserPreferences re-applies the canonical server-side preferences
       after /api/user/me lands. localStorage carries the user's last-known
       theme across reloads, so the FOUC is suppressed for any repeat visitor. -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('guest-theme') || 'light';
      let effectiveTheme = savedTheme;
      if (savedTheme === 'system') {
        effectiveTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } else if (savedTheme !== 'dark' && savedTheme !== 'light') {
        effectiveTheme = 'light';
      }
      document.documentElement.setAttribute('data-theme', effectiveTheme);
      document.documentElement.setAttribute('data-theme-setting', savedTheme);

      // Color temperature was removed July 2026 — warm was promoted to be
      // the light theme itself (see design-tokens.css). Clear any stale
      // attribute so old localStorage can't resurrect the axis.
      document.documentElement.removeAttribute('data-temperature');

      // Accent is constrained to the nine area colors (colors-sheet §5):
      // a free-hex accent breaks the palette's chroma ceiling.
      const AREA_ACCENTS = ['#7d93b2','#7d9678','#b0955a','#9c7fa6','#6f9497','#b58a72','#8a8fb0','#8faa8b','#918bab'];
      const savedAccent = (localStorage.getItem('guest-accent-color') || '').toLowerCase();
      if (savedAccent && AREA_ACCENTS.includes(savedAccent)) {
        document.documentElement.style.setProperty('--accent-color', savedAccent);
        document.documentElement.style.setProperty('--color-accent', savedAccent);
      }

      const savedFont = localStorage.getItem('guest-font-preference');
      if (savedFont === 'character') {
        document.documentElement.setAttribute('data-font', 'character');
      }

      const savedLocalMathLinkColor = localStorage.getItem('guest-local-math-link-color');
      document.documentElement.setAttribute(
        'data-local-math-link-color',
        savedLocalMathLinkColor === 'off' ? 'off' : 'on'
      );
    })();
  </script>
  
