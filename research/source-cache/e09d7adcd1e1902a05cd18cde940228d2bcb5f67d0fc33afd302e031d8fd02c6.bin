  <script>
    // Theme toggle (desktop header + mobile top bar) — runs for ALL users
    (function() {
      if (window.__andromaThemeToggleInitialized) return;
      window.__andromaThemeToggleInitialized = true;
      var THEME_FALLBACK_TRANSITION_MS = 180;
      var themeTransitionTimer = null;
      function persistThemeChoice(theme) {
        var fetcher = window.csrfFetch || window.fetch;
        return fetcher('/settings/theme', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ theme: theme })
        });
      }

      function prefersReducedThemeMotion() {
        // House policy: the site always animates; OS reduced-motion is ignored.
        return false;
      }

      function applyThemeAttributes(theme, effectiveTheme, source) {
        document.documentElement.setAttribute('data-theme', effectiveTheme);
        document.documentElement.setAttribute('data-theme-setting', theme);
        try {
          document.dispatchEvent(new CustomEvent('androma:themechange', {
            detail: { theme: theme, effectiveTheme: effectiveTheme, source: source }
          }));
        } catch (e) {}
      }

      function applyThemeWithTransition(theme, effectiveTheme, source) {
        var root = document.documentElement;
        if (!prefersReducedThemeMotion() && typeof document.startViewTransition === 'function') {
          root.classList.add('theme-view-transitioning');
          var transition = document.startViewTransition(function() {
            applyThemeAttributes(theme, effectiveTheme, source);
          });
          var cleanup = function() {
            root.classList.remove('theme-view-transitioning');
          };
          if (transition.finished && typeof transition.finished.then === 'function') {
            transition.finished.then(cleanup, cleanup);
          } else {
            setTimeout(cleanup, THEME_FALLBACK_TRANSITION_MS + 80);
          }
          return;
        }

        root.classList.add('theme-fallback-transitioning');
        if (themeTransitionTimer) clearTimeout(themeTransitionTimer);
        applyThemeAttributes(theme, effectiveTheme, source);
        themeTransitionTimer = setTimeout(function() {
          root.classList.remove('theme-fallback-transitioning');
          themeTransitionTimer = null;
        }, THEME_FALLBACK_TRANSITION_MS + 50);
      }

      window.AndromaTheme = window.AndromaTheme || {};
      window.AndromaTheme.apply = applyThemeWithTransition;

      function toggleTheme() {
        var current = document.documentElement.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        applyThemeWithTransition(next, next, 'header-toggle');
        localStorage.setItem('guest-theme', next);
        localStorage.setItem('guest-theme-pending-at', String(Date.now()));
        // Persist for logged-in users so navigation doesn't reset to the DB
        // value via auth-hydrate.
        if (document.cookie.indexOf('logged_in=1') !== -1) {
          try {
            persistThemeChoice(next).then(function(resp) {
              if (resp && resp.ok) localStorage.removeItem('guest-theme-pending-at');
            }).catch(function(){});
          } catch (e) {}
        } else {
          localStorage.removeItem('guest-theme-pending-at');
        }
      }
      var desktop = document.getElementById('guestThemeToggle');
      var mobile = document.getElementById('mobileThemeToggle');
      if (desktop) desktop.addEventListener('click', toggleTheme);
      if (mobile) mobile.addEventListener('click', toggleTheme);
    })();
  </script>

  
