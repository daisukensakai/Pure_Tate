  <!-- Syntax highlighting is loaded only on pages that actually contain code blocks. -->
  <script>
    (function() {
      var hljsPromise = null;

      function hasCodeBlocks(scope) {
        return !!(scope || document).querySelector('pre code, code[class*="language-"]');
      }

      function loadHighlightJs() {
        if (window.hljs && typeof window.hljs.highlightElement === 'function') {
          return Promise.resolve(window.hljs);
        }
        if (hljsPromise) return hljsPromise;

        hljsPromise = new Promise(function(resolve, reject) {
          if (!document.querySelector('link[data-androma-highlight-css]')) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/github.min.css';
            link.dataset.andromaHighlightCss = 'true';
            document.head.appendChild(link);
          }

          var existing = document.querySelector('script[data-androma-highlight-js]');
          if (existing) {
            existing.addEventListener('load', function() { resolve(window.hljs); }, { once: true });
            existing.addEventListener('error', reject, { once: true });
            return;
          }

          var script = document.createElement('script');
          script.src = 'https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/highlight.min.js';
          script.defer = true;
          script.dataset.andromaHighlightJs = 'true';
          script.onload = function() { resolve(window.hljs); };
          script.onerror = reject;
          document.head.appendChild(script);
        });

        return hljsPromise;
      }

      function highlightCode(scope) {
        scope = scope || document;
        if (!hasCodeBlocks(scope)) return;
        loadHighlightJs().then(function(hljs) {
          if (!hljs || typeof hljs.highlightElement !== 'function') return;
          scope.querySelectorAll('pre code:not(.hljs)').forEach(function(block) {
            hljs.highlightElement(block);
          });
        }).catch(function() {});
      }

      window.AndromaHighlight = { ensure: loadHighlightJs, highlight: highlightCode };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { highlightCode(document); });
      } else {
        highlightCode(document);
      }
      document.addEventListener('spa:content-loaded', function() {
        highlightCode(document.querySelector('main') || document);
      });
    })();
  </script>

