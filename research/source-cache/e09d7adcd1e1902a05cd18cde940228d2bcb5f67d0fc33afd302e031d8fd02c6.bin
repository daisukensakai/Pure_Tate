  <!-- Client-side analytics (human-only page views) -->
  <style>
  .consent-bar {
    position: fixed;
    left: var(--spacing-md);
    right: var(--spacing-md);
    bottom: var(--spacing-md);
    z-index: 900;
    max-width: 560px;
    margin-left: auto;
    background: var(--bg-secondary);
    border-radius: var(--radius-lg, 10px);
    box-shadow: 0 6px 28px color-mix(in srgb, var(--ink) 16%, transparent);
    padding: 16px 18px;
    display: none;
  }
  .consent-bar.on { display: block; }
  .consent-bar h2 {
    font-size: 14px;
    font-weight: 650;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .consent-bar p {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-4);
    margin: 0 0 12px;
    max-width: 62ch;
  }
  .consent-bar .consent-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .consent-bar a {
    margin-left: auto;
    font-size: 12px;
    color: var(--ink-4);
  }

  @media (max-width: 700px) {
    .consent-bar { left: var(--spacing-sm); right: var(--spacing-sm); bottom: var(--spacing-sm); }
    .consent-bar .consent-actions { flex-wrap: wrap; }
    .consent-bar a { margin-left: 0; }
  }
</style>

<aside class="consent-bar" id="consent-bar" aria-live="polite">
  <h2>Can we remember your visit?</h2>
  <p>
    We count page views either way, and that needs nothing stored on your device.
    Saying yes lets us group your views into a single visit, which is how we tell
    whether people actually read what's here. It's gone when you close the tab,
    and it never leaves this site.
  </p>
  <div class="consent-actions">
    <button type="button" class="btn btn-primary" data-consent="yes">Allow</button>
    <button type="button" class="btn" data-consent="no">No thanks</button>
    <a href="/privacy">What we collect</a>
  </div>
</aside>

  
  <!-- Google One Tap — engagement-gated sign-in prompt for anonymous visitors -->
  
  
  <!-- PWA Service Worker Registration (HTTPS only) -->
  <script>
    if ('serviceWorker' in navigator && location.protocol === 'https:') {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>

  
  <!-- Mobile Tab Bar (hidden for logged-out, shown by auth-hydrate.js) -->
  <nav class="mobile-tab-bar" id="mobileTabBar" data-auth="nav" style="display:none">
