  <script>
    // Reveal main content (it starts at opacity:0; `.ready` fades it in).
    //
    // IMPORTANT: DOMContentLoaded is blocked by every render-blocking and
    // `defer` script in the document — including the third-party CDN scripts
    // (highlight.js, twemoji, marked from cdn.jsdelivr.net). If any of those
    // stalls on the user's network (e.g. an office/corporate proxy that
    // throttles public CDNs), DOMContentLoaded is delayed and the whole page
    // stays blank until it finally fires. The setTimeout fallback guarantees
    // we reveal regardless, so a stalled third-party script can never blank
    // the page. Render-blocking CSS has already applied by the time this runs,
    // so revealing early does not cause a flash of unstyled content.
    (function() {
      var revealed = false;
      function showContent() {
        if (revealed) return;
        revealed = true;
        var m = document.querySelector('main');
        if (m) m.classList.add('ready');
      }
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        showContent();
      } else {
        document.addEventListener('DOMContentLoaded', showContent);
      }
      // Safety net: never keep the page invisible waiting on slow/blocked scripts.
      setTimeout(showContent, 1000);
    })();
  </script>

  
