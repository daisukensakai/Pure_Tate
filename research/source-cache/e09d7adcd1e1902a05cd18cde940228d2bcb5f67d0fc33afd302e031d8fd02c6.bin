  <!-- Incoming Call Overlay (Colloq notifications on non-workspace pages) -->
  

  <!-- Desktop notifications for new chat messages -->
  

  <!-- Request browser notification permission (once, after first login). Always
       emitted (cache-safe); runtime guard skips for anonymous visitors. -->
  <script>
  (function () {
    if (!document.cookie.includes('logged_in=1')) return;
    if (typeof Notification === 'undefined' || Notification.permission !== 'default') return;
    if (localStorage.getItem('notification_asked')) return;
    setTimeout(function () {
      Notification.requestPermission();
      localStorage.setItem('notification_asked', 'true');
    }, 10000);
  })();
  </script>

  <!-- Mobile Tab Bar Styles -->
  <style>
    /* ── Mobile Top Bar (non-sticky header) ── */
    .mobile-top-bar {
      display: none;
    }

    @media (max-width: 1119px) {
      .mobile-top-bar {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        background: var(--color-bg-primary);
        gap: 10px;
        position: sticky;
        top: 0;
        z-index: 1100;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
      }

      .mobile-top-bar.bar--hidden {
        transform: translateY(-100%);
      }

      .mobile-top-bar.bar--visible {
        transform: translateY(0);
      }

      /* Hamburger button in mobile top bar */
      .mobile-top-bar-hamburger {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 8px;
        background: none;
        cursor: pointer;
        color: var(--color-text-tertiary);
        transition: color 0.15s;
        -webkit-tap-highlight-color: transparent;
      }

      .mobile-top-bar-hamburger:active {
        color: var(--color-text-primary);
      }

      .mobile-top-bar-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        text-decoration: none;
      }

      .mobile-top-bar-logo img {
        width: 22px;
        height: 22px;
      }

      .mobile-top-bar-logo img {
        filter: var(--image-logo-filter, none);
      }

      .mobile-top-bar-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--color-text-primary);
        letter-spacing: -0.01em;
        /* One line — a long page title used to wrap and grow the sticky bar
           from 56px to 72px on every scroll of every wiki page. */
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .mobile-top-bar-spacer {
        flex: 1;
      }

      .mobile-top-bar-search {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 8px;
        background: none;
        cursor: pointer;
        color: var(--color-text-tertiary);
        transition: color 0.15s;
        -webkit-tap-highlight-color: transparent;
      }

      .mobile-top-bar-search:active {
        color: var(--color-text-primary);
      }

      .mobile-top-bar-bell {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        color: var(--color-text-tertiary);
        transition: color 0.15s;
        -webkit-tap-highlight-color: transparent;
      }

      .mobile-top-bar-bell:active {
        color: var(--color-text-primary);
      }

      .mobile-top-bar-bell .notification-badge {
        transform: translate(0px, -16px) scale(0.9);
      }

      /* One row of controls, one size. The theme toggle inherits
         .guest-theme-toggle (30px box, its own stroke colour) and the search
         lens — a thin open circle — reads a size smaller than the bell's
         silhouette at the same nominal 18px, so it gets the optical bump. */
      .mobile-top-bar-search,
      .mobile-top-bar-bell,
      .mobile-top-bar .mobile-theme-toggle,
      .mobile-top-bar-hamburger {
        width: 36px;
        height: 36px;
        padding: 0;
        flex-shrink: 0;
        color: var(--color-text-tertiary);
      }

      .mobile-top-bar svg {
        width: 18px;
        height: 18px;
      }

      .mobile-top-bar .mobile-theme-toggle svg {
        stroke: currentColor;
      }

      .mobile-top-bar-search svg {
        width: 20px;
        height: 20px;
      }
    }

    /* ── Mobile Nav Overlay (hamburger menu) ── */
    .mobile-nav-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.4);
      z-index: 11000;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .mobile-nav-overlay.active {
      display: block;
      opacity: 1;
    }

    .mobile-nav-panel {
      position: absolute;
      top: 0;
      right: 0;
      width: 100%;
      height: 100%;
      background: var(--color-bg-primary);
      padding: 0 0 env(safe-area-inset-bottom, 0px);
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    .mobile-nav-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: calc(16px + env(safe-area-inset-top, 0px)) 20px 16px;
      border-bottom: 1px solid var(--color-border-primary);
      position: sticky;
      top: 0;
      background: var(--color-bg-primary);
      z-index: 1;
    }

    .mobile-nav-account {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 20px;
      border-bottom: 1px solid var(--color-border-primary);
      text-decoration: none;
    }

    .mobile-nav-account-avatar {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      flex: 0 0 44px;
      border-radius: 50%;
      background: var(--color-bg-tertiary, var(--color-bg-secondary));
      color: var(--color-text-secondary);
      font-size: 18px;
      font-weight: 600;
      object-fit: cover;
      overflow: hidden;
    }

    .mobile-nav-account-info {
      display: flex;
      flex-direction: column;
      min-width: 0;
      flex: 1;
    }

    .mobile-nav-account-name {
      font-size: 15px;
      font-weight: 600;
      color: var(--color-text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mobile-nav-account-sub {
      font-size: 13px;
      color: var(--color-text-secondary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mobile-nav-account-chevron {
      flex: 0 0 auto;
      color: var(--color-text-tertiary, var(--color-text-secondary));
    }

    .mobile-nav-signin-row {
      display: flex;
      gap: 8px;
      padding: 16px 20px;
      border-bottom: 1px solid var(--color-border-primary);
    }

    .mobile-nav-signin-btn {
      flex: 1;
      text-align: center;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      color: var(--color-text-primary);
      background: var(--color-bg-secondary);
    }

    .mobile-nav-signin-btn.primary {
      color: var(--color-text-inverse, #fff);
      background: var(--color-text-primary);
    }

    .mobile-nav-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--color-text-primary);
    }

    .mobile-nav-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background: var(--color-bg-secondary);
      border: none;
      border-radius: 50%;
      cursor: pointer;
      color: var(--color-text-secondary);
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      padding: 8px 0;
    }

    .mobile-nav-links a {
      display: block;
      padding: 14px 20px;
      font-size: 15px;
      font-weight: 500;
      color: var(--color-text-primary);
      text-decoration: none;
      transition: background 0.15s;
    }

    .mobile-nav-links a:active {
      background: var(--color-bg-secondary);
    }

    /* ── Mobile Bottom Tab Bar ── */
    .mobile-tab-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--color-bg-primary);
      border-top: 1px solid var(--color-border-primary);
      padding: 6px 16px 14px;
      padding: 6px 16px calc(6px + env(safe-area-inset-bottom, 8px));
      justify-content: space-around;
      align-items: center;
      z-index: 1100;
    }

    @media (max-width: 1119px) {
      .mobile-tab-bar {
        display: none;
      }

      body {
        padding-bottom: 0;
        padding-top: 0 !important;
      }

      /* Hide entire header on mobile — bottom tab bar handles navigation */
      header {
        display: none !important;
      }

      /* Set header height to mobile top bar height for fixed/sticky positioning */
      :root {
        --header-height: 60px !important;
        --mobile-header-height: 0px !important;
      }

      /* Remove top padding that was reserved for header */
      main {
        padding-top: 0 !important;
      }
    }

    .tab-bar-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-decoration: none;
      color: var(--color-text-tertiary);
      transition: color 0.2s;
    }

    .tab-bar-item span {
      font-size: 10px;
      font-weight: 500;
      line-height: 1;
    }

    .tab-bar-item.active {
      color: var(--color-text-primary);
    }

    .tab-bar-item.active span {
      font-weight: 600;
    }

    .tab-bar-item:hover {
      color: var(--color-text-primary);
    }
  </style>
  
