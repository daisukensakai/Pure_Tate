  <script>
    // Auth Modal JavaScript — Passwordless Email Code Flow
    document.addEventListener('DOMContentLoaded', function() {
      const loginModal = document.getElementById('loginModal');
      if (!loginModal) return; // User is logged in

      const loginBtn = document.getElementById('loginModalBtn');
      const closeLoginBtn = document.getElementById('closeLoginModal');
      const loginOverlay = loginModal.querySelector('.auth-modal-overlay');
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

      let modalCurrentEmail = '';

      function modalShowStep(stepId) {
        document.getElementById('modalStepEmail').style.display = 'none';
        document.getElementById('modalStepCode').style.display = 'none';
        document.getElementById('modalStepUsername').style.display = 'none';
        document.getElementById(stepId).style.display = 'block';
      }

      function modalSetLoading(btn, loading) {
        var text = btn.querySelector('.btn-text');
        var loader = btn.querySelector('.btn-loader');
        btn.disabled = loading;
        text.style.display = loading ? 'none' : 'inline';
        loader.style.display = loading ? 'inline-flex' : 'none';
      }

      // Match Modal.submitForm's 200ms in/out so the auth modal feels
      // like the same family. CSS handles the visuals via .is-open;
      // this just gates display:flex around the transition window so
      // the modal isn't taking up layout/clicks while invisible.
      const AUTH_MODAL_EXIT_MS = 200;
      let authModalCloseTimer = null;

      // Optional callback fired AFTER successful auth — lets feature code
      // open the login modal to gate a specific action (e.g. "Add to Deck")
      // and then resume that action without a page reload. Cleared when
      // the user cancels so a stale callback doesn't fire on a later
      // unrelated login.
      let pendingAuthAction = null;

      function openAuthModal(options) {
        // Cancel any in-flight close so re-opens mid-transition behave.
        if (authModalCloseTimer) { clearTimeout(authModalCloseTimer); authModalCloseTimer = null; }
        pendingAuthAction = (options && typeof options.onSuccess === 'function')
          ? options.onSuccess
          : null;
        modalShowStep('modalStepEmail');
        loginModal.style.display = 'flex';
        // Lock scroll on the root element, NOT body: overflow:hidden on body
        // makes body the containing scroll box for position:sticky descendants
        // (scrollTop 0), snapping sticky sidebars/TOCs back to the top of the
        // document — off-screen when the page is scrolled down.
        document.documentElement.style.overflow = 'hidden';
        // Two rAFs: first commits display:flex, second flips .is-open so
        // the transition has a non-active starting state to animate from.
        requestAnimationFrame(() => {
          requestAnimationFrame(() => { loginModal.classList.add('is-open'); });
        });
        setTimeout(() => { document.getElementById('modalLoginEmail').focus(); }, 100);
      }

      // Expose globally so other scripts can trigger the login modal
      window.openAuthModal = openAuthModal;

      function closeAuthModal() {
        // User-initiated close — drop any pending action so it can't fire later.
        pendingAuthAction = null;
        loginModal.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        // Defer display:none + form reset until after the exit transition
        // so the closing modal doesn't visibly snap back to the email step
        // mid-fade.
        authModalCloseTimer = setTimeout(() => {
          loginModal.style.display = 'none';
          modalShowStep('modalStepEmail');
          document.getElementById('modalEmailError').style.display = 'none';
          document.getElementById('modalCodeError').style.display = 'none';
          document.getElementById('modalUsernameError').style.display = 'none';
          document.getElementById('modalLoginEmail').value = '';
          modalClearCode();
          modalVerifying = false;
          authModalCloseTimer = null;
        }, AUTH_MODAL_EXIT_MS);
      }

      // Close the auth modal AFTER a successful sign-in and fire any
      // pending action (e.g. resume "Add to Deck"). Skips the reload path
      // so the in-page context (selected theorem etc.) survives.
      function finishAuthAndResume() {
        const cb = pendingAuthAction;
        pendingAuthAction = null;
        // Same teardown as closeAuthModal but keeps the callback eligible
        // until we explicitly run it below.
        loginModal.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        authModalCloseTimer = setTimeout(() => {
          loginModal.style.display = 'none';
          modalShowStep('modalStepEmail');
          document.getElementById('modalEmailError').style.display = 'none';
          document.getElementById('modalCodeError').style.display = 'none';
          document.getElementById('modalUsernameError').style.display = 'none';
          document.getElementById('modalLoginEmail').value = '';
          modalClearCode();
          modalVerifying = false;
          authModalCloseTimer = null;
        }, AUTH_MODAL_EXIT_MS);
        if (window.hydrateAuthFromSession) window.hydrateAuthFromSession({ probe: true });
        if (cb) {
          // Run after the exit transition so the resumed action's modal
          // doesn't overlap the closing auth modal mid-fade.
          setTimeout(() => { try { cb(); } catch (e) { console.error('Pending auth action error:', e); } }, AUTH_MODAL_EXIT_MS + 50);
        }
      }

      function navigateAfterAuth(data) {
        if (window.hydrateAuthFromSession) window.hydrateAuthFromSession({ probe: true });
        setTimeout(function() {
          window.location.href = (data && data.redirect) || '/home';
        }, 100);
      }

      // Open
      // Sign in opens the modal; Register navigates to the dedicated /register page
      // (which renders the same template with mode='register' for the create-account framing).
      if (loginBtn) loginBtn.addEventListener('click', function(e) { e.preventDefault(); openAuthModal(); });

      // Close — but not while on code/username step (prevent accidental dismiss)
      closeLoginBtn.addEventListener('click', closeAuthModal);
      loginOverlay.addEventListener('click', function() {
        // Only allow overlay-click close on step 1 (email). On code/username steps,
        // closing would lose progress and frustrate users who mistyped.
        var onEmailStep = document.getElementById('modalStepEmail').style.display !== 'none';
        if (onEmailStep) closeAuthModal();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && loginModal.style.display === 'flex') {
          var onEmailStep = document.getElementById('modalStepEmail').style.display !== 'none';
          if (onEmailStep) {
            closeAuthModal();
          } else {
            // On code/username step, Escape goes back to email instead of closing
            var onCodeStep = document.getElementById('modalStepCode').style.display !== 'none';
            if (onCodeStep) {
              modalShowStep('modalStepEmail');
              document.getElementById('modalLoginEmail').focus();
              modalSetLoading(document.getElementById('modalSendCodeBtn'), false);
              modalClearCode();
              document.getElementById('modalCodeError').style.display = 'none';
            }
          }
        }
      });

      // ─── Step 1: Send code ───────────────────
      document.getElementById('modalEmailForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        var emailInput = document.getElementById('modalLoginEmail');
        var errorDiv = document.getElementById('modalEmailError');
        var btn = document.getElementById('modalSendCodeBtn');
        var email = emailInput.value.trim();

        if (!email || !email.includes('@')) {
          errorDiv.textContent = 'Please enter a valid email address.';
          errorDiv.style.display = 'flex';
          return;
        }

        errorDiv.style.display = 'none';
        modalSetLoading(btn, true);

        try {
          var resp = await fetch('/login/send-code', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ email: email })
          });
          var data;
          try { data = await resp.json(); } catch (e) {
            console.error('Non-JSON response from send-code:', resp.status);
            throw new Error('Server error (' + resp.status + ')');
          }

          if (resp.ok && data.success) {
            modalCurrentEmail = email;
            document.getElementById('modalCodeEmailDisplay').textContent = email;
            modalShowStep('modalStepCode');
            var firstDigit = document.querySelector('.modal-code-digit[data-index="0"]');
            if (firstDigit) firstDigit.focus();
          } else {
            errorDiv.textContent = data.error || 'Failed to send code.';
            errorDiv.style.display = 'flex';
            modalSetLoading(btn, false);
          }
        } catch (err) {
          console.error('Send code error:', err);
          errorDiv.textContent = err.message && err.message.includes('Server error')
            ? 'Server error. Please refresh the page and try again.'
            : 'An error occurred. Please try again.';
          errorDiv.style.display = 'flex';
          modalSetLoading(btn, false);
        }
      });

      // ─── Step 2: Verify code ─────────────────
      var modalCodeDigits = document.querySelectorAll('.modal-code-digit');

      modalCodeDigits.forEach(function(input, idx) {
        input.addEventListener('input', function(e) {
          var val = e.target.value.replace(/\D/g, '');
          e.target.value = val.charAt(0) || '';
          if (val && idx < 5) modalCodeDigits[idx + 1].focus();
          if (modalGetCode().length === 6) {
            document.getElementById('modalCodeForm').requestSubmit();
          }
        });
        input.addEventListener('keydown', function(e) {
          if (e.key === 'Backspace' && !e.target.value && idx > 0) {
            modalCodeDigits[idx - 1].focus();
            modalCodeDigits[idx - 1].value = '';
          }
        });
        input.addEventListener('paste', function(e) {
          e.preventDefault();
          var pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
          if (pasted.length >= 6) {
            for (var i = 0; i < 6; i++) modalCodeDigits[i].value = pasted.charAt(i);
            modalCodeDigits[5].focus();
            setTimeout(function() { document.getElementById('modalCodeForm').requestSubmit(); }, 100);
          }
        });
      });

      function modalGetCode() {
        var code = '';
        modalCodeDigits.forEach(function(d) { code += d.value; });
        return code;
      }

      function modalClearCode() {
        modalCodeDigits.forEach(function(d) { d.value = ''; });
      }

      let modalVerifying = false; // Prevent double-submit from auto-submit

      document.getElementById('modalCodeForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        if (modalVerifying) return; // Already verifying

        var errorDiv = document.getElementById('modalCodeError');
        var btn = document.getElementById('modalVerifyCodeBtn');
        var code = modalGetCode();

        if (code.length !== 6) {
          errorDiv.textContent = 'Please enter the full 6-digit code.';
          errorDiv.style.display = 'flex';
          return;
        }

        errorDiv.style.display = 'none';
        modalVerifying = true;
        modalSetLoading(btn, true);

        try {
          var resp = await fetch('/login/verify-code', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ email: modalCurrentEmail, code: code })
          });
          var data;
          try { data = await resp.json(); } catch (e) {
            console.error('Non-JSON response from verify-code:', resp.status);
            throw new Error('Server error (' + resp.status + ')');
          }

          if (resp.ok && data.success) {
            if (data.needsUsername) {
              modalShowStep('modalStepUsername');
              document.getElementById('modalRegDisplayName').focus();
            } else if (data.showOnboarding) {
              navigateAfterAuth(data);
            } else if (pendingAuthAction) {
              // A feature gated this auth attempt with a callback — close
              // the modal and resume the originally intended action
              // instead of reloading the page.
              finishAuthAndResume();
            } else {
              navigateAfterAuth(data);
            }
          } else {
            errorDiv.textContent = data.error || 'Invalid code. Please try again.';
            errorDiv.style.display = 'flex';
            modalClearCode();
            modalCodeDigits[0].focus();
            modalSetLoading(btn, false);
            modalVerifying = false;
          }
        } catch (err) {
          console.error('Verify code error:', err);
          errorDiv.textContent = err.message && err.message.includes('Server error')
            ? 'Server error. Please refresh the page and try again.'
            : 'An error occurred. Please try again.';
          errorDiv.style.display = 'flex';
          modalClearCode();
          modalCodeDigits[0].focus();
          modalSetLoading(btn, false);
          modalVerifying = false;
        }
      });

      // Resend
      document.getElementById('modalResendCodeBtn').addEventListener('click', async function() {
        var btn = this;
        btn.disabled = true;
        btn.textContent = 'Sending...';
        try {
          var resp = await fetch('/login/send-code', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ email: modalCurrentEmail })
          });
          if (resp.ok) {
            btn.textContent = 'Code sent!';
            modalClearCode();
            document.getElementById('modalCodeError').style.display = 'none';
            setTimeout(function() { btn.textContent = 'Resend code'; btn.disabled = false; }, 30000);
          } else { btn.textContent = 'Resend code'; btn.disabled = false; }
        } catch (e) { btn.textContent = 'Resend code'; btn.disabled = false; }
      });

      // Change email
      document.getElementById('modalChangeEmailBtn').addEventListener('click', function() {
        modalShowStep('modalStepEmail');
        document.getElementById('modalLoginEmail').focus();
        modalSetLoading(document.getElementById('modalSendCodeBtn'), false);
        modalClearCode();
      });

      // ─── Step 3: Create account ──────────────
      document.getElementById('modalUsernameForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        var displayNameInput = document.getElementById('modalRegDisplayName');
        var usernameInput = document.getElementById('modalRegUsername');
        var errorDiv = document.getElementById('modalUsernameError');
        var btn = document.getElementById('modalCreateAccountBtn');
        var displayName = displayNameInput.value.trim();
        var username = usernameInput.value.trim();

        if (!displayName) {
          errorDiv.textContent = 'Please enter your name.';
          errorDiv.style.display = 'flex';
          return;
        }
        if (!username || username.length < 3) {
          errorDiv.textContent = 'Handle must be at least 3 characters.';
          errorDiv.style.display = 'flex';
          return;
        }
        if (!/^[a-zA-Z0-9_-]+$/.test(username)) {
          errorDiv.textContent = 'Handle can only contain letters, numbers, hyphens, and underscores.';
          errorDiv.style.display = 'flex';
          return;
        }
        var modalAgreeTermsEl = document.getElementById('modalAgreeTerms');
        if (!modalAgreeTermsEl || !modalAgreeTermsEl.checked) {
          errorDiv.textContent = 'Please agree to the Terms of Service and Privacy Policy to create an account.';
          errorDiv.style.display = 'flex';
          modalAgreeTermsEl && modalAgreeTermsEl.focus();
          return;
        }

        errorDiv.style.display = 'none';
        modalSetLoading(btn, true);

        try {
          var resp = await fetch('/register/complete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ username: username, display_name: displayName, agreeTerms: true })
          });
          var data;
          try { data = await resp.json(); } catch (e) {
            console.error('Non-JSON response from register/complete:', resp.status);
            throw new Error('Server error (' + resp.status + ')');
          }

          if (resp.ok && data.success) {
            if (pendingAuthAction) {
              finishAuthAndResume();
            } else {
              navigateAfterAuth(data);
            }
          } else {
            errorDiv.textContent = data.error || 'Failed to create account.';
            errorDiv.style.display = 'flex';
            modalSetLoading(btn, false);
          }
        } catch (err) {
          console.error('Register error:', err);
          errorDiv.textContent = err.message && err.message.includes('Server error')
            ? 'Server error. Please refresh the page and try again.'
            : 'An error occurred. Please try again.';
          errorDiv.style.display = 'flex';
          modalSetLoading(btn, false);
        }
      });
    });
  </script>

  <!-- Onboarding Tour JavaScript -->
  <script>
  (function() {
    const onboardingPersonas = {
      learning: {
        label: 'Learning math',
        title: 'Build from definitions into practice.',
        summary: 'Start with connected learning paths, then move into study cards, prerequisite trails, and course discussions when you need help.',
        primaryHref: '/learn',
        primaryLabel: 'Open learning paths',
        secondaryHref: '/study',
        secondaryLabel: 'Try study cards',
        previewQuery: 'Search: compactness in metric spaces',
        previewTitle: 'Heine-Borel Theorem',
        previewText: 'A theorem page links definitions, prerequisites, proofs, and nearby examples into one navigable object.',
        previewSteps: ['Find the right topic', 'Follow prerequisites', 'Save cards to study', 'Ask where you get stuck'],
        showcaseTitle: 'A map that turns into practice.',
        showcaseText: 'Androma keeps the page, theorem, proof, and study workflow close together so learning feels less like tab archaeology.',
        recommendations: [
          { tag: 'Path', title: 'Learning paths', text: 'Follow curated sequences through pages, theorems, and examples.', href: '/learn' },
          { tag: 'Practice', title: 'Study library', text: 'Save ideas and return to them as cards when it is time to revise.', href: '/study' },
          { tag: 'Help', title: 'Course spaces', text: 'Use notes, questions, and discussions around a class or programme.', href: '/courses' }
        ]
      },
      research: {
        label: 'Writing or research',
        title: 'Turn TeX into linked mathematical work.',
        summary: 'Use Androma as a research surface: write TeX, cite wiki objects, attach papers, and keep your contributions tied to your profile.',
        primaryHref: '/tex',
        primaryLabel: 'Open the TeX editor',
        secondaryHref: '/theorems',
        secondaryLabel: 'Browse theorems',
        previewQuery: 'Draft: spectral radius proof',
        previewTitle: '\u03b8(fg) = \u03b8(f)\u03b8(g)',
        previewText: 'Drafts can point at theorem records, wiki pages, papers, and review threads without losing the mathematical trail.',
        previewSteps: ['Draft in TeX', 'Link theorems and pages', 'Attach papers or ORCID', 'Publish with review'],
        showcaseTitle: 'A writing desk with the wiki attached.',
        showcaseText: 'The important references do not sit beside the work. They become part of the work.',
        recommendations: [
          { tag: 'Write', title: 'TeX projects', text: 'Create and revise mathematical notes with Androma-aware links.', href: '/tex' },
          { tag: 'Cite', title: 'Theorem database', text: 'Find reusable statements and proofs to cite from your draft.', href: '/theorems' },
          { tag: 'Profile', title: 'Papers and identity', text: 'Connect papers, ORCID, and public contributions to your profile.', href: '/papers' }
        ]
      },
      teaching: {
        label: 'Teaching a course',
        title: 'Give a course one connected home.',
        summary: 'Create a course space where notes, assignments, Q&A, live sessions, and shared resources sit next to the mathematical wiki.',
        primaryHref: '/courses',
        primaryLabel: 'Open courses',
        secondaryHref: '/schedule',
        secondaryLabel: 'View schedule',
        previewQuery: 'Course: Functional Analysis',
        previewTitle: 'Week 3: Compact Operators',
        previewText: 'Course pages can gather notes, assignments, questions, and linked wiki references around the same syllabus.',
        previewSteps: ['Create the course hub', 'Attach notes and resources', 'Collect student questions', 'Run reviews or live sessions'],
        showcaseTitle: 'Teaching without rebuilding the context.',
        showcaseText: 'Students can move from a lecture note to the underlying theorem and back again without leaving the course space.',
        recommendations: [
          { tag: 'Course', title: 'Course spaces', text: 'Organize notes, people, resources, assignments, and questions.', href: '/courses' },
          { tag: 'Plan', title: 'Schedule', text: 'Put seminars, classes, and live sessions where students expect them.', href: '/schedule' },
          { tag: 'Discuss', title: 'Community feed', text: 'Keep updates and mathematical conversations visible.', href: '/feed' }
        ]
      },
      contributing: {
        label: 'Contributing knowledge',
        title: 'Improve the wiki with reviewable changes.',
        summary: 'Browse the knowledge graph, edit pages, open pull requests, and connect definitions, results, proofs, and discussions.',
        primaryHref: '/pages',
        primaryLabel: 'Browse pages',
        secondaryHref: '/pull-requests',
        secondaryLabel: 'View pull requests',
        previewQuery: 'Edit: Banach fixed point theorem',
        previewTitle: 'Pull request opened',
        previewText: 'Androma treats mathematical edits like durable contributions: reviewable, attributable, and connected to related objects.',
        previewSteps: ['Find a gap', 'Edit a page or theorem', 'Open a pull request', 'Discuss and merge'],
        showcaseTitle: 'A wiki that remembers the work.',
        showcaseText: 'Contribution history, review, attribution, and discussion live close to the knowledge they improve.',
        recommendations: [
          { tag: 'Browse', title: 'Wiki pages', text: 'Find areas that need clarification, examples, or references.', href: '/pages' },
          { tag: 'Review', title: 'Pull requests', text: 'Review changes and follow how mathematical content evolves.', href: '/pull-requests' },
          { tag: 'Create', title: 'New content', text: 'Add pages, theorem statements, or references when something is missing.', href: '/new' }
        ]
      },
      exploring: {
        label: 'Just exploring',
        title: 'See the whole platform in one pass.',
        summary: 'Start with the wiki map, then peek at the theorem database, learning paths, TeX projects, and the community layer.',
        primaryHref: '/pages',
        primaryLabel: 'Explore the wiki',
        secondaryHref: '/feed',
        secondaryLabel: 'See the feed',
        previewQuery: 'Search: Fourier transform',
        previewTitle: 'Connected mathematical objects',
        previewText: 'Pages, theorems, papers, courses, and discussions are separate views over the same mathematical graph.',
        previewSteps: ['Browse the wiki', 'Open a theorem', 'Peek at TeX and courses', 'Follow community activity'],
        showcaseTitle: 'Not just pages. A mathematical commons.',
        showcaseText: 'If you are not sure where to begin, the wiki view gives the fastest sense of what Androma is becoming.',
        recommendations: [
          { tag: 'Map', title: 'All pages', text: 'Start with the broad knowledge graph and follow what looks interesting.', href: '/pages' },
          { tag: 'Results', title: 'Theorems', text: 'See how formal statements, proofs, and references are organized.', href: '/theorems' },
          { tag: 'Pulse', title: 'Feed', text: 'Watch discussions, edits, and course activity as they happen.', href: '/feed' }
        ]
      }
    };

    let selectedOnboardingPersona = 'exploring';

    function setOnboardingText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    }

    function showOnboardingStep(stepName) {
      document.querySelectorAll('#onboardingModal [data-onboarding-step]').forEach(function(step) {
        step.hidden = step.getAttribute('data-onboarding-step') !== stepName;
      });
      const modal = document.getElementById('onboardingModal');
      if (modal) {
        modal.setAttribute('aria-labelledby', stepName === 'path' ? 'onboardingPathTitle' : 'onboardingTitle');
      }
    }

    function updateOnboardingPreview(profile) {
      setOnboardingText('onboardingPreviewQuery', profile.previewQuery);
      setOnboardingText('onboardingPreviewTitle', profile.previewTitle);
      setOnboardingText('onboardingPreviewText', profile.previewText);
      setOnboardingText('onboardingShowcaseTitle', profile.showcaseTitle);
      setOnboardingText('onboardingShowcaseText', profile.showcaseText);
      profile.previewSteps.forEach(function(step, index) {
        setOnboardingText('onboardingPreviewStep' + (index + 1), step);
      });
    }

    function renderOnboardingRecommendations(profile) {
      const container = document.getElementById('onboardingRecommendations');
      if (!container) return;
      container.textContent = '';

      profile.recommendations.forEach(function(item) {
        const link = document.createElement('a');
        link.className = 'onboarding-rec';
        link.href = item.href;

        const tag = document.createElement('span');
        tag.className = 'onboarding-rec-tag';
        tag.textContent = item.tag;

        const body = document.createElement('div');
        const title = document.createElement('h3');
        const text = document.createElement('p');
        title.textContent = item.title;
        text.textContent = item.text;
        body.appendChild(title);
        body.appendChild(text);

        link.appendChild(tag);
        link.appendChild(body);
        link.addEventListener('click', function(e) {
          e.preventDefault();
          completeOnboarding(item.href);
        });
        container.appendChild(link);
      });
    }

    function personalizeOnboarding(persona) {
      const profile = onboardingPersonas[persona] || onboardingPersonas.exploring;
      selectedOnboardingPersona = persona;
      const modal = document.getElementById('onboardingModal');
      if (modal) modal.setAttribute('aria-labelledby', 'onboardingPathTitle');

      setOnboardingText('onboardingPersonaLabel', profile.label);
      setOnboardingText('onboardingPathTitle', profile.title);
      setOnboardingText('onboardingPathSummary', profile.summary);
      updateOnboardingPreview(profile);
      renderOnboardingRecommendations(profile);

      const primary = document.getElementById('onboardingPrimary');
      const secondary = document.getElementById('onboardingSecondary');
      if (primary) {
        primary.href = profile.primaryHref;
        primary.textContent = profile.primaryLabel;
      }
      if (secondary) {
        secondary.href = profile.secondaryHref;
        secondary.textContent = profile.secondaryLabel;
      }

      try {
        localStorage.setItem('androma:onboardingPersona', persona);
      } catch (e) {}

      showOnboardingStep('path');
      setTimeout(function() {
        if (primary) primary.focus();
      }, 0);
    }

    function resetOnboardingModal() {
      selectedOnboardingPersona = 'exploring';
      const modal = document.getElementById('onboardingModal');
      if (modal) modal.setAttribute('aria-labelledby', 'onboardingTitle');
      updateOnboardingPreview(onboardingPersonas.exploring);
      showOnboardingStep('persona');
    }

    function showOnboardingModal(persona) {
      const modal = document.getElementById('onboardingModal');
      if (!modal) return;
      resetOnboardingModal();
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      if (persona && onboardingPersonas[persona]) {
        personalizeOnboarding(persona);
      }
    }

    // Expose globally so the login handler can call it
    window.showOnboardingModal = showOnboardingModal;

    function hideOnboardingModal() {
      const modal = document.getElementById('onboardingModal');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    function markOnboardingDismissedLocally() {
      try {
        sessionStorage.setItem('androma:onboardingDismissed', '1');
      } catch (e) {}
    }

    function hasOnboardingDismissedLocally() {
      try {
        return sessionStorage.getItem('androma:onboardingDismissed') === '1';
      } catch (e) {
        return false;
      }
    }

    async function completeOnboarding(options) {
      const navigateTo = typeof options === 'string' ? options : options?.navigateTo;
      const shouldReload = typeof options === 'object' && options?.reload === true;
      hideOnboardingModal();
      markOnboardingDismissedLocally();

      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/api/onboarding/complete', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-CSRF-Token': csrfToken,
          },
          body: JSON.stringify({ persona: selectedOnboardingPersona }),
        });
        if (!resp.ok) {
          throw new Error('Onboarding completion failed with status ' + resp.status);
        }
      } catch (e) {
        console.error('Failed to mark onboarding complete:', e);
      }
      if (navigateTo) {
        window.location.href = navigateTo;
      } else if (shouldReload) {
        window.location.reload();
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const skipBtn = document.getElementById('onboardingSkip');
      const overlay = document.querySelector('.onboarding-overlay');
      const closeBtn = document.getElementById('onboardingClose');
      const backBtn = document.getElementById('onboardingBack');
      const primary = document.getElementById('onboardingPrimary');
      const secondary = document.getElementById('onboardingSecondary');
      const personaButtons = document.querySelectorAll('#onboardingModal .onboarding-persona');

      personaButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          personalizeOnboarding(button.getAttribute('data-persona'));
        });
      });

      if (backBtn) backBtn.addEventListener('click', function() { showOnboardingStep('persona'); });
      if (skipBtn) skipBtn.addEventListener('click', function(e) { e.preventDefault(); completeOnboarding(); });
      if (closeBtn) closeBtn.addEventListener('click', function(e) { e.preventDefault(); completeOnboarding(); });
      if (overlay) overlay.addEventListener('click', function() { completeOnboarding(); });
      if (primary) primary.addEventListener('click', function(e) { e.preventDefault(); completeOnboarding(primary.getAttribute('href')); });
      if (secondary) secondary.addEventListener('click', function(e) { e.preventDefault(); completeOnboarding(secondary.getAttribute('href')); });

      // Esc to skip
      document.addEventListener('keydown', function(e) {
        const modal = document.getElementById('onboardingModal');
        if (!modal || modal.style.display !== 'flex') return;
        if (e.key === 'Escape') completeOnboarding();
      });

      
    });
  })();
  </script>

  <!-- Basecoat JavaScript for interactive components (opt-in) -->
  
  
  <!-- Logo Navigation Dropdown Handler -->
  <script>
  (function() {
    // Check if mobile
    function isMobile() {
      return window.innerWidth <= 768 || 
             ('ontouchstart' in window && window.innerWidth <= 1024);
    }
    
    // Close all mobile dropdowns
    function closeAllMobileDropdowns() {
      document.querySelectorAll('.mobile-active').forEach(el => {
        el.classList.remove('mobile-active');
      });
      // Also remove active-panel class from dropdown panels
      document.querySelectorAll('.mobile-active-panel').forEach(el => {
        el.classList.remove('mobile-active-panel');
      });
      // Also close notifications dropdown
      const notificationsDropdown = document.getElementById('notificationsDropdown');
      if (notificationsDropdown) {
        notificationsDropdown.classList.remove('active');
      }
      // Remove body scroll lock — unless the mobile nav overlay owns it, which
      // manages its own lock and is not one of the dropdowns closed here.
      var navOverlayEl = document.querySelector('.mobile-nav-overlay.active');
      if (!navOverlayEl) {
        document.body.style.overflow = '';
      }
    }
    
    // === Close buttons handler ===
    document.querySelectorAll('.mobile-dropdown-close').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        closeAllMobileDropdowns();
      });
    });
    
    // === Logo Dropdown ===
    const logoDropdown = document.querySelector('.logo-dropdown');
    const logoLink = document.getElementById('logo-nav-link');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const dropdownPanel = logoDropdown ? logoDropdown.querySelector('.nav-dropdown-panel') : null;
    
    // Mobile hamburger menu button opens the dropdown
    if (logoDropdown && mobileMenuBtn && dropdownPanel) {
      function handleMobileMenuClick(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const isActive = logoDropdown.classList.contains('mobile-active');
        closeAllMobileDropdowns();
        
        if (!isActive) {
          // Move dropdown panel to body to escape stacking context on mobile
          if (isMobile() && !dropdownPanel.dataset.movedToBody) {
            document.body.appendChild(dropdownPanel);
            dropdownPanel.dataset.movedToBody = 'true';
          }
          logoDropdown.classList.add('mobile-active');
          dropdownPanel.classList.add('mobile-active-panel');
          document.body.style.overflow = 'hidden'; // Prevent background scroll
        }
      }
      
      mobileMenuBtn.addEventListener('click', handleMobileMenuClick);
      // Also handle touchend for better iOS support
      mobileMenuBtn.addEventListener('touchend', function(e) {
        e.preventDefault();
        handleMobileMenuClick(e);
      });
      
      // Close when clicking a link inside dropdown (use event delegation for moved panel)
      dropdownPanel.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (link && link.href) {
          closeAllMobileDropdowns();
          // Navigation will happen naturally after menu closes
        }
      });
    }
    
    // Logo click navigates home on desktop (no special handling needed, just let it work)
    
    // === Mobile Search Toggle ===
    const mobileSearchBtn = document.getElementById('mobile-search-btn');
    const searchBox = document.querySelector('.search-box');
    const headerEl = document.querySelector('header');
    
    if (mobileSearchBtn) {
      mobileSearchBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        // Trigger the spotlight search by clicking the header search input
        const searchInput = document.getElementById('search-input');
        if (searchInput) {
          searchInput.click();
        }
      });
    }
    
    // === Profile Dropdown ===
    const profileDropdown = document.querySelector('.profile-dropdown');
    const profileBtn = document.getElementById('profile-dropdown-btn');
    
    if (profileDropdown && profileBtn) {
      profileBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const isActive = profileDropdown.classList.contains('active') || profileDropdown.classList.contains('mobile-active');
        
        // Close all other dropdowns
        closeAllMobileDropdowns();
        document.querySelectorAll('.nav-dropdown-container.active, .profile-dropdown.active').forEach(el => {
          el.classList.remove('active');
        });
        
        if (!isActive) {
          if (isMobile()) {
            profileDropdown.classList.add('mobile-active');
            document.body.style.overflow = 'hidden';
          } else {
            profileDropdown.classList.add('active');
          }
        }
      });
      
      // Close when clicking a link inside dropdown
      const profileDropdownLinks = profileDropdown.querySelectorAll('.profile-dropdown-panel a');
      profileDropdownLinks.forEach(function(link) {
        link.addEventListener('click', function() {
          profileDropdown.classList.remove('active');
          closeAllMobileDropdowns();
        });
      });
      
      // Close profile dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (!isMobile() && profileDropdown.classList.contains('active') && !profileDropdown.contains(e.target)) {
          profileDropdown.classList.remove('active');
        }
      });
    }
    
    // === Notifications Dropdown (mobile support) ===
    const notificationsBtn = document.getElementById('notificationsBtn');
    const notificationsDropdown = document.getElementById('notificationsDropdown');
    
    if (notificationsBtn && notificationsDropdown) {
      // Mobile-specific handling - add class and body scroll lock
      // Note: Don't stopPropagation so that notifications.js can still fetch
      notificationsBtn.addEventListener('click', function(e) {
        if (isMobile()) {
          // Close other mobile dropdowns first
          const logoDropdownCurrent = document.querySelector('.logo-dropdown.active');
          const profileDropdownCurrent = document.querySelector('.profile-dropdown-menu.active');
          if (logoDropdownCurrent) logoDropdownCurrent.classList.remove('active');
          if (profileDropdownCurrent) profileDropdownCurrent.classList.remove('active');
          
          // Toggle body scroll lock based on new state
          // (notifications.js toggles the 'active' class)
          setTimeout(() => {
            if (notificationsDropdown.classList.contains('active')) {
              document.body.style.overflow = 'hidden';
            } else {
              document.body.style.overflow = '';
            }
          }, 0);
        }
      });
    }
    
    // Close dropdowns when clicking outside (mobile)
    document.addEventListener('click', function(e) {
      if (isMobile()) {
        // Check if click is outside all dropdowns
        const isInsideLogoDropdown = logoDropdown && logoDropdown.contains(e.target);
        const isInsideProfileDropdown = profileDropdown && profileDropdown.contains(e.target);
        const isInsideNotifications = notificationsDropdown && notificationsDropdown.contains(e.target);
        const isNotificationsBtn = e.target === notificationsBtn || (notificationsBtn && notificationsBtn.contains(e.target));
        
        if (!isInsideLogoDropdown && !isInsideProfileDropdown && !isInsideNotifications && !isNotificationsBtn) {
          closeAllMobileDropdowns();
        }
      }
    });
    
    // Close on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeAllMobileDropdowns();
      }
    });
    
    // Handle window resize
    window.addEventListener('resize', function() {
      if (!isMobile()) {
        closeAllMobileDropdowns();
      }
    });
    
    // Handle back button / history for mobile
    window.addEventListener('popstate', function() {
      if (isMobile()) {
        closeAllMobileDropdowns();
      }
    });
  })();
  </script>
  
  <!-- Theme System Listener -->
  <script>
  (function() {
    // Listen for system theme changes when user has "system" mode selected
    const themeSetting = document.documentElement.getAttribute('data-theme-setting');
    
    if (themeSetting === 'system') {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      
      function updateTheme(e) {
        const newTheme = e.matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', newTheme);
      }
      
      mediaQuery.addEventListener('change', updateTheme);
    }
  })();
  </script>
  
  <!-- Global Theorem Citation Knowledge Button Handler (Event Delegation) -->
  <script>
  (function() {
    document.addEventListener('click', async function(e) {
      const btn = e.target.closest('.theorem-citation-knowledge-btn');
      if (!btn) return;
      
      e.preventDefault();
      e.stopPropagation();
      
      // Check if already being handled by direct event listener
      if (btn.dataset.handlerAttached === 'true') {
        console.log('🔄 Button has direct handler, letting it handle');
        return;
      }
      
      const theoremId = btn.dataset.theoremId;
      const isKnown = btn.dataset.isKnown === 'true';
      
      console.log(`🖱️ [Global] Knowledge button clicked for theorem ${theoremId}, isKnown=${isKnown}`);
      
      // Disable button during request
      btn.disabled = true;
      btn.style.opacity = '0.6';
      
      try {
        const endpoint = isKnown 
          ? `/theorems/${theoremId}/remove-from-knowledge`
          : `/theorems/${theoremId}/add-to-knowledge`;
        
        const method = isKnown ? 'DELETE' : 'POST';
        
        const response = await fetch(endpoint, {
          method: method,
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        if (response.ok) {
          const result = await response.json();
          
          // Update button state
          const newIsKnown = !isKnown;
          btn.dataset.isKnown = newIsKnown.toString();
          
          // Update button icon and text
          const icon = btn.querySelector('svg');
          if (icon) {
            if (newIsKnown) {
              icon.innerHTML = '<circle cx="12" cy="12" r="10" fill="currentColor" stroke="currentColor"></circle><path d="M9 12l2 2 4-4" stroke="white" stroke-width="2"></path>';
            } else {
              icon.innerHTML = '<g transform="scale(0.24)"><g stroke="currentColor" fill="none" stroke-width="6" stroke-linecap="round"><path d="M10.5 47.5 Q 16.7 35.6, 27.5 27.5"/><path d="M27.5 27.5 Q 40.7 20.6, 55.5 19.5"/><path d="M55.5 19.5 Q 68.2 21.7, 78.5 29.5"/><path d="M78.5 29.5 Q 86.3 39.5, 90.5 51.5"/><path d="M39.5 71.5 Q 37.4 48.4, 27.5 27.5"/></g><g fill="currentColor" stroke="none"><circle cx="39.5" cy="71.5" r="18.2"/><circle cx="10.5" cy="47.5" r="5.3"/><circle cx="27.5" cy="27.5" r="7.1"/><circle cx="55.5" cy="19.5" r="8.1"/><circle cx="78.5" cy="29.5" r="5.9"/><circle cx="90.5" cy="51.5" r="4.3"/></g></g>';
            }
          }
          
          // Update button text
          if (newIsKnown) {
            btn.innerHTML = btn.innerHTML.replace(/Add to Knowledge|Remove from Knowledge/g, 'Theorem Known');
          } else {
            btn.innerHTML = btn.innerHTML.replace(/Add to Knowledge|Theorem Known/g, 'Add to Knowledge');
          }
          
          // Show notification
          if (typeof window.showNotification === 'function') {
            window.showNotification(result.message, 'success');
          }
          
        } else {
          const errorData = await response.json().catch(() => ({ error: 'Request failed' }));
          throw new Error(errorData.error || 'Request failed');
        }
        
      } catch (error) {
        console.error('Error updating knowledge status:', error);
        
        if (typeof window.showNotification === 'function') {
          window.showNotification(error.message || 'Failed to update knowledge status', 'error');
        }
      } finally {
        // Re-enable button
        btn.disabled = false;
        btn.style.opacity = '1';
      }
    });
  })();
  </script>
  
