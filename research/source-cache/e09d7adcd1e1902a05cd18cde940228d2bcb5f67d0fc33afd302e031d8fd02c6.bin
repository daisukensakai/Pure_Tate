  <script>
    // Client-side active tab detection (fallback for when currentPage isn't set)
    (function() {
      const path = window.location.pathname;
      const tabs = document.querySelectorAll('.tab-bar-item');
      tabs.forEach(function(tab) {
        const href = tab.getAttribute('href');
        if ((href === '/messages' && (path.startsWith('/messages') || path.startsWith('/messagesmain'))) ||
            (href === '/workspace' && path === '/workspace') ||
            (href === '/feed' && path.startsWith('/feed')) ||
            (href === '/profile' && path.startsWith('/profile'))) {
          tab.classList.add('active');
        }
      });
    })();

  </script>

  <!-- Mobile Top Bar handlers -->
  <script>
    // Mobile Top Bar search button — opens spotlight search
    var mobileTopBarSearch = document.getElementById('mobileTopBarSearch');
    if (mobileTopBarSearch) {
      mobileTopBarSearch.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var searchInput = document.getElementById('search-input');
        if (searchInput) {
          searchInput.click();
        }
      });
    }

    // Mobile hamburger menu — creates and toggles a navigation overlay
    var mobileHamburger = document.getElementById('mobileTopBarHamburger');
    if (mobileHamburger) {
      // Create mobile nav overlay (once)
      var navOverlay = document.createElement('div');
      navOverlay.className = 'mobile-nav-overlay';
      navOverlay.innerHTML = '<div class="mobile-nav-panel">' +
        '<div class="mobile-nav-header">' +
          '<span class="mobile-nav-title">Navigate</span>' +
          '<button class="mobile-nav-close" aria-label="Close menu">' +
            '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
              '<line x1="18" y1="6" x2="6" y2="18"></line>' +
              '<line x1="6" y1="6" x2="18" y2="18"></line>' +
            '</svg>' +
          '</button>' +
        '</div>' +
        '<div class="mobile-nav-account-slot"></div>' +
        '<nav class="mobile-nav-links">' +
          '<a href="/" data-home-link>Home</a>' +
          '<a href="/theorems">Theorems</a>' +
          '<a href="/pages">Pages</a>' +
          '<a href="/math-areas">Math Areas</a>' +
          '<a href="/study">Study</a>' +
          '<a href="/schedule" data-demo-blocked-nav>Schedule</a>' +
          '<a href="/workspace">Workspace</a>' +
          '<a href="/events">Events</a>' +
          '<a href="/discussions" data-demo-blocked-nav>Discussions</a>' +
          '<a href="/feed" data-demo-blocked-nav>Feed</a>' +
          '<a href="/messages" data-requires-auth>Messages</a>' +
          '<a href="/notifications" data-requires-auth>Notifications</a>' +
          '<a href="/profile" data-requires-auth>Profile</a>' +
          '<a href="/settings" data-requires-auth>Settings</a>' +
          '<div data-requires-auth style="border-top: 1px solid var(--color-border-primary, #e5e5e5); margin-top: 8px; padding-top: 8px;">' +
            '<a href="/logout" style="color: var(--color-text-secondary, #888);">Log out</a>' +
          '</div>' +
        '</nav>' +
      '</div>';
      document.body.appendChild(navOverlay);
      if (typeof window.__hydrateHomeLinks === 'function') window.__hydrateHomeLinks(navOverlay);

      // Account section: shows who is signed in (avatar + name), or sign-in
      // buttons for guests. Rendered on every open because auth state hydrates
      // asynchronously via auth-hydrate.js after page load.
      function escapeHtmlText(s) {
        return String(s).replace(/[&<>"']/g, function(c) {
          return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
        });
      }
      function renderMobileNavAccount() {
        var slot = navOverlay.querySelector('.mobile-nav-account-slot');
        var loggedIn = document.body.dataset.userLoggedIn === 'true';
        if (loggedIn) {
          var name = window.currentDisplayName || window.currentUsername || 'Your account';
          var username = window.currentUsername || '';
          var avatar = window.currentUserAvatar || '';
          var avatarHtml = avatar
            ? '<img class="mobile-nav-account-avatar" src="' + escapeHtmlText(avatar) + '" alt="">'
            : '<span class="mobile-nav-account-avatar">' + escapeHtmlText(name.charAt(0).toUpperCase()) + '</span>';
          slot.innerHTML = '<a class="mobile-nav-account" href="/profile">' +
            avatarHtml +
            '<span class="mobile-nav-account-info">' +
              '<span class="mobile-nav-account-name">' + escapeHtmlText(name) + '</span>' +
              (username ? '<span class="mobile-nav-account-sub">@' + escapeHtmlText(username) + '</span>' : '') +
            '</span>' +
            '<svg class="mobile-nav-account-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>' +
          '</a>';
          slot.querySelector('.mobile-nav-account').addEventListener('click', closeMobileNav);
        } else {
          slot.innerHTML = '<div class="mobile-nav-signin-row">' +
            '<a href="#" class="mobile-nav-signin-btn primary" data-mobile-nav-signin>Sign in</a>' +
            '<a href="/register" class="mobile-nav-signin-btn">Register</a>' +
          '</div>';
          var signinBtn = slot.querySelector('[data-mobile-nav-signin]');
          signinBtn.addEventListener('click', function(e) {
            e.preventDefault();
            closeMobileNav();
            var loginBtn = document.getElementById('loginModalBtn');
            if (loginBtn) loginBtn.click();
            else window.location.href = '/register';
          });
        }
        navOverlay.querySelectorAll('.mobile-nav-links [data-requires-auth]').forEach(function(el) {
          el.style.display = loggedIn ? '' : 'none';
        });
      }

      // Scroll lock. `body { overflow: hidden }` alone does not hold on mobile:
      // the page keeps scrolling under the panel on touch, and because the
      // scrolling element stops being scrollable the position is lost, so the
      // background silently jumps to the top. Pinning the body at its current
      // offset freezes it for real and restores the exact position on close.
      var navScrollY = 0;
      function lockBackgroundScroll() {
        navScrollY = window.scrollY || document.documentElement.scrollTop || 0;
        document.body.style.position = 'fixed';
        document.body.style.top = (-navScrollY) + 'px';
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
        document.body.style.overflow = 'hidden';
      }
      function unlockBackgroundScroll() {
        if (document.body.style.position !== 'fixed') return;
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, navScrollY);
      }

      function openMobileNav() {
        renderMobileNavAccount();
        navOverlay.classList.add('active');
        lockBackgroundScroll();
      }
      function closeMobileNav() {
        navOverlay.classList.remove('active');
        unlockBackgroundScroll();
      }

      mobileHamburger.addEventListener('click', function(e) {
        e.preventDefault();
        // The header's outside-click handler calls closeAllMobileDropdowns() on
        // any click it doesn't recognise, which clears the body scroll lock the
        // line below just set. This overlay is not one of its dropdowns, so the
        // event must not reach it.
        e.stopPropagation();
        openMobileNav();
      });

      navOverlay.querySelector('.mobile-nav-close').addEventListener('click', closeMobileNav);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && navOverlay.classList.contains('active')) closeMobileNav();
      });
      navOverlay.addEventListener('click', function(e) {
        if (e.target === navOverlay) closeMobileNav();
      });
      // Close on link click
      navOverlay.querySelectorAll('.mobile-nav-links a').forEach(function(link) {
        link.addEventListener('click', closeMobileNav);
      });
    }
  </script>

  <!-- Colloq Pip Auto-Reconnect: restores voice call on page reload / SPA navigation -->
  <script>
  (function() {
    // Only auto-reconnect if NOT on a workspace page (workspace manages its own ColloqManager)
    if (window.location.pathname.startsWith('/workspace') || window.location.pathname.startsWith('/messages')) return;

    var session = null;
    try {
      var raw = sessionStorage.getItem('colloq_active');
      if (raw) session = JSON.parse(raw);
    } catch(e) {}

    if (!session || !session.channelId) return;

    // Load LiveKit + ColloqManager if not already loaded
    function loadScript(src, cb) {
      if (document.querySelector('script[src*="' + src.split('?')[0] + '"]')) { cb(); return; }
      var s = document.createElement('script');
      s.src = src;
      s.onload = cb;
      s.onerror = function() { console.warn('[Colloq Pip] Failed to load', src); };
      document.head.appendChild(s);
    }

    loadScript('https://cdn.jsdelivr.net/npm/livekit-client@2/dist/livekit-client.umd.js', function() {
      loadScript('/js/messagesmain/colloq-manager.js?v=1.1.7-11ffffbc', function() {
        if (!window.ColloqManager || !window.LivekitClient) return;

        var pipEl = document.getElementById('colloqPip');
        if (!pipEl) return;

        // Create a ColloqManager, build pip UI, then use normal join() flow
        var mgr = new window.ColloqManager({
          container: pipEl,
          channelId: session.channelId,
          currentUserId: window.currentUserId || '',
          currentUsername: window.currentUsername || ''
        });
        mgr.isPipMode = true;
        mgr.pipChannelName = session.channelName || '#channel';
        mgr.pipServerSlug = session.serverSlug || '';
        var savedTimerStart = session.timerStart || Date.now();

        // Build pip UI and mount it
        mgr._buildPip();
        pipEl.appendChild(mgr.pipEl);
        pipEl.hidden = false;

        // Use the normal join() — fetches a fresh token, connects, publishes audio
        mgr.join().then(function() {
          // Hide the bar (join() shows it), we only want the pip
          if (mgr.barEl) mgr.barEl.style.display = 'none';
          // Restore timer to continue from original start
          mgr._timerStartedAt = savedTimerStart;
          mgr._updatePipTimer();
          if (mgr._timerInterval) clearInterval(mgr._timerInterval);
          mgr._timerInterval = setInterval(mgr._updatePipTimer.bind(mgr), 1000);
          // Sync pip UI
          mgr._renderPipParticipants();
          mgr._updatePipMuteButton();

          window._colloqPipManager = mgr;
          console.log('[Colloq Pip] Rejoined call for channel', session.channelId);
        }).catch(function(err) {
          console.error('[Colloq Pip] Rejoin failed:', err);
          pipEl.hidden = true;
          sessionStorage.removeItem('colloq_active');
        });
      });
    });
  })();
  </script>

  <!-- Inline comment/reply submission (no page reload) -->
  <script>
  (function() {
    // Detect entity context from the page (blog vs discussion)
    var _commentEntityType = document.querySelector('.comment[data-entity-type]');
    var _entityType = _commentEntityType ? _commentEntityType.getAttribute('data-entity-type') : 'blog';
    var _entityId = _commentEntityType ? _commentEntityType.getAttribute('data-discussion-id') : '';
    // Fallback: extract slug from URL for blog pages (e.g. /blog/my-post → my-post)
    if (!_entityId && _entityType === 'blog') {
      var blogMatch = window.location.pathname.match(/^\/blog\/([^/]+)/);
      if (blogMatch) _entityId = blogMatch[1];
    }

    function renderCommentHTML(c) {
      var avatar = window.AndromaAvatar
        ? window.AndromaAvatar.render({ avatar: c.authorProfilePicture, username: c.username, display_name: c.display_name }, { size: 32, className: 'comment-author-avatar', loading: 'lazy' })
        : (c.authorProfilePicture
          ? '<img src="' + c.authorProfilePicture + '" alt="' + (c.username || '') + '" class="comment-author-avatar-img" referrerpolicy="no-referrer">'
          : '<span class="comment-author-avatar">' + ((c.display_name || c.username || '?').charAt(0).toUpperCase()) + '</span>');

      // Determine comment path from the form that submitted
      var commentForm = document.querySelector('.comment-form') || document.querySelector('.reply-form');
      var commentPath = commentForm ? commentForm.getAttribute('action') : '';
      var displayName = c.display_name || c.username || 'Unknown';

      return '<div class="comment" id="comment-' + c.id + '" data-comment-id="' + c.id + '" data-entity-type="' + _entityType + '" data-discussion-id="' + _entityId + '">' +
        '<div class="comment-avatar-col">' + avatar + '</div>' +
        '<div class="comment-main">' +
          '<div class="comment-header">' +
            '<a href="/profile?user=' + encodeURIComponent(c.username) + '" class="comment-author-link" data-username="' + (c.username || '') + '">' + displayName + '</a>' +
            '<span class="comment-handle">@' + (c.username || 'unknown') + '</span>' +
            '<span class="comment-meta-dot">&middot;</span>' +
            '<span class="comment-time">just now</span>' +
          '</div>' +
          '<div class="comment-body content-renderer" data-renderer-id="comment-' + c.id + '" data-comment-id="' + c.id + '">' +
            '<div class="raw-markdown-content" style="display:none;">' + c.content + '</div>' +
            '<div class="rendered-markdown-content"></div>' +
          '</div>' +
          '<div class="comment-footer">' +
            '<div class="comment-votes-inline">' +
              '<button type="button" class="comment-vote-btn comment-upvote-btn upvoted" data-comment-id="' + c.id + '" data-vote-type="1" title="Upvote">' +
                '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 12V4M4 8l4-4 4 4"></path></svg>' +
              '</button>' +
              '<span class="comment-vote-count" data-comment-id="' + c.id + '">1</span>' +
              '<button type="button" class="comment-vote-btn comment-downvote-btn" data-comment-id="' + c.id + '" data-vote-type="-1" title="Downvote">' +
                '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 4v8M4 8l4 4 4-4"></path></svg>' +
              '</button>' +
            '</div>' +
            '<button class="comment-action reply-btn" data-comment-id="' + c.id + '">Reply</button>' +
            '<div class="comment-reactions-inline" data-comment-id="' + c.id + '">' +
              '<button class="add-reaction-btn-sm" data-comment-id="' + c.id + '" title="Add reaction">' +
                '<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm3.82 1.636a.75.75 0 0 1 1.038.175l.007.009c.103.118.22.222.35.31.264.178.683.37 1.285.37.602 0 1.02-.192 1.285-.371.13-.088.247-.192.35-.31l.007-.008a.75.75 0 0 1 1.222.87l-.614-.431c.614.43.614.431.613.431v.001l-.001.002-.002.003-.005.007-.014.019a1.984 1.984 0 0 1-.184.213c-.16.166-.338.316-.53.445-.63.418-1.37.638-2.127.629-.946 0-1.652-.308-2.126-.63a3.32 3.32 0 0 1-.715-.657l-.014-.02-.005-.006-.002-.003v-.002h-.001l.613-.432-.614.43a.75.75 0 0 1 .183-1.044ZM12 7a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM5 8a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path></svg>' +
              '</button>' +
            '</div>' +
            '<button class="comment-action edit-comment-btn" data-comment-id="' + c.id + '">Edit</button>' +
            '<button class="comment-action delete-comment-btn" data-comment-id="' + c.id + '">Delete</button>' +
          '</div>' +
          '<div class="reply-form-container" data-parent-id="' + c.id + '" style="display:none;">' +
            '<form action="' + commentPath + '" method="POST" class="reply-form">' +
              '<textarea name="content" class="reply-textarea" placeholder="Write a reply..." required></textarea>' +
              '<input type="hidden" name="parent_id" value="' + c.id + '">' +
              '<div class="reply-form-footer">' +
                '<button type="button" class="cancel-reply-btn">Cancel</button>' +
                '<button type="submit" class="submit-reply-btn">Reply</button>' +
              '</div>' +
            '</form>' +
          '</div>' +
        '</div>' +
      '</div>';
    }

    function initCommentRenderer(el) {
      if (window.UniversalContentRenderer) {
        try {
          var renderer = new window.UniversalContentRenderer({
            enableMathJax: true, enableMarkdown: true, enableWikiLinks: true,
            skipAutoInit: true, rootElement: el
          });
          renderer.initialize();
        } catch(e) { console.warn('Comment render failed:', e); }
      }
      // Bind interactive handlers on the new comment element
      bindCommentHandlers(el);
    }

    function bindCommentHandlers(commentEl) {
      // Skip if the page has its own reply delegation (blog, discussions)
      // Those pages set window._commentReplyDelegated = true
      if (window._commentReplyDelegated) return;

      // Reply toggle — fallback for pages without their own delegation
      commentEl.querySelectorAll('.reply-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var cid = this.dataset.commentId;
          var container = document.querySelector('.reply-form-container[data-parent-id="' + cid + '"]');
          if (container) {
            var show = !container.classList.contains('active');
            container.style.display = show ? 'block' : 'none';
            container.classList.toggle('active', show);
            var ta = container.querySelector('.reply-textarea');
            if (ta && show) ta.focus();
          }
        });
      });

      // Cancel reply
      commentEl.querySelectorAll('.cancel-reply-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var container = this.closest('.reply-form-container');
          if (container) { container.style.display = 'none'; container.classList.remove('active'); }
        });
      });
    }

    // Ctrl/Cmd+Enter to submit comment
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
        var textarea = e.target;
        if (textarea.tagName === 'TEXTAREA' && textarea.closest('.comment-form, .reply-form')) {
          e.preventDefault();
          var form = textarea.closest('form');
          if (form) form.requestSubmit();
        }
      }
    });

    document.addEventListener('submit', function(e) {
      var form = e.target;
      if (!form.classList.contains('comment-form') && !form.classList.contains('reply-form')) return;
      if (form.hasAttribute('data-spa-ignore')) return;
      // If the shared comment-interactions module is loaded, let it handle submissions
      if (typeof CommentInteractions !== 'undefined') return;

      e.preventDefault();
      var submitBtn = form.querySelector('button[type="submit"]');
      var origText = submitBtn ? submitBtn.textContent : '';
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Posting...'; }

      var csrfMeta = document.querySelector('meta[name="csrf-token"]');
      var headers = { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' };
      if (csrfMeta) headers['X-CSRF-Token'] = csrfMeta.getAttribute('content');

      fetch(form.action, {
        method: 'POST',
        headers: headers,
        body: new URLSearchParams(new FormData(form)),
        credentials: 'include'
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (!data.success || !data.comment) throw new Error('Unexpected response');

        var html = renderCommentHTML(data.comment);
        var parentId = form.querySelector('input[name="parent_id"]');
        var isReply = parentId && parentId.value;

        if (isReply) {
          // Insert reply into parent comment's replies container
          var parentEl = document.getElementById('comment-' + parentId.value);
          if (parentEl) {
            var repliesContainer = parentEl.querySelector('.comment-replies');
            if (!repliesContainer) {
              repliesContainer = document.createElement('div');
              repliesContainer.className = 'comment-replies';
              parentEl.querySelector('.comment-main').appendChild(repliesContainer);
            }
            repliesContainer.insertAdjacentHTML('beforeend', html);
            initCommentRenderer(repliesContainer.lastElementChild);
          }
          // Hide reply form
          var replyContainer = form.closest('.reply-form-container');
          if (replyContainer) { replyContainer.style.display = 'none'; replyContainer.classList.remove('active'); }
        } else {
          // Append to comments list
          var list = document.getElementById('comments-list') || document.querySelector('.comments-list');
          if (list) {
            // Remove "no comments" placeholder
            var noComments = list.querySelector('.no-comments');
            if (noComments) noComments.remove();
            list.insertAdjacentHTML('beforeend', html);
            initCommentRenderer(list.lastElementChild);
          }
        }

        // Clear textarea
        var textarea = form.querySelector('textarea');
        if (textarea) textarea.value = '';

        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = origText; }
      })
      .catch(function(err) {
        console.error('Comment submit error:', err);
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = origText; }
      });
    }, true);
  })();
  </script>
  <script src="/js/auth-hydrate.js?v=1.1.7-11ffffbc" defer></script>

