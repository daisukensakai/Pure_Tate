            margin: 0 0 4px; line-height: 1.3;
        }

        .prereq-graph-subtitle {
            font-size: 13px; color: var(--color-text-secondary, var(--ink-2)); margin: 0; line-height: 1.4;
        }

        .prereq-graph-stats {
            display: flex; gap: 8px; flex-shrink: 0; flex-wrap: wrap;
        }

        .prereq-stat-chip {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 4px 10px; border-radius: 9999px;
            background: var(--color-bg-secondary, var(--grey-tint)); font-size: 12px; font-weight: 500;
            color: var(--color-text-primary, var(--night)); white-space: nowrap;
        }

        .prereq-stat-chip strong {
            color: var(--color-text-primary, var(--night)); font-weight: 600;
        }

        .prereq-graph-loading {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            min-height: 240px;
            padding: 44px 20px;
            color: var(--color-text-secondary, var(--ink-2));
            font-size: 14px;
            background: var(--prereq-graph-surface);
        }

        .prereq-graph-loader-visual {
            width: min(360px, 82vw);
            max-width: 100%;
            height: auto;
            overflow: visible;
            color: var(--accent-color, var(--sage-text));
        }

        .prereq-tree-ghost-edge {
            fill: none;
            stroke: color-mix(in srgb, var(--color-text-primary, var(--night)) 11%, transparent);
            stroke-width: 1.35;
            stroke-linecap: round;
        }

        .prereq-tree-ghost-node {
            fill: var(--prereq-graph-node-bg);
            stroke: color-mix(in srgb, var(--color-text-primary, var(--night)) 22%, transparent);
            stroke-width: 1.5;
        }

        .prereq-tree-active {
            filter: drop-shadow(0 1px 3px rgba(90, 122, 106, 0.08));
        }

        .prereq-tree-edge {
            fill: none;
            stroke: color-mix(in srgb, var(--color-text-primary, var(--night)) 22%, transparent);
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-dasharray: 1;
            stroke-dashoffset: 1;
