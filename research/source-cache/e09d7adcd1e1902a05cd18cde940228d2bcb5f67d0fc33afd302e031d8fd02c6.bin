  <!-- Notifications script (self-gates on logged_in cookie) -->
  
  <script>
    // Unread message badge (channels + DMs) — driven by the global WS
    // listener below. Fetches the actual total only on:
    //   1. initial page load
    //   2. WS event indicating something changed
    //   3. tab refocus (fallback in case WS missed an event)
    // No timer-based polling.
    (function() {
      function hasLoginCookie() {
        try { return /(?:^|;\s*)logged_in=1(?:;|$)/.test(document.cookie); }
        catch (e) { return false; }
      }

      function _doUpdate() {
        if (!hasLoginCookie()) return;
        fetch('/api/messagesmain/unread-count')
          .then(r => r.json())
          .then(data => {
            if (!data.success) return;
            const badge = document.getElementById('messages-unread-badge');
            if (!badge) return;
            if (data.total > 0) {
              badge.textContent = data.total > 99 ? '99+' : data.total;
              badge.style.display = '';
            } else {
              badge.style.display = 'none';
            }
          })
          .catch(() => {});
      }
      // Debounced wrapper — server switches / mark-read bursts dispatch
      // multiple conversation:read + unread:bump events in the same tick.
      // Coalesce them so we hit /api/messagesmain/unread-count once per burst.
      let _t = null;
      function updateMessagesBadge() {
        if (_t) return;
        _t = setTimeout(() => { _t = null; _doUpdate(); }, 150);
      }
      // Expose globally so /messages can trigger refresh after marking read
      window.updateMessagesBadge = updateMessagesBadge;
      // Initial check after page load (immediate, no delay)
      if (hasLoginCookie()) {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', updateMessagesBadge);
        } else {
          updateMessagesBadge();
        }
      }
      // WS-driven updates (events dispatched by the global WS listener below)
      window.addEventListener('message:new', updateMessagesBadge);
      window.addEventListener('unread:bump', updateMessagesBadge);
      window.addEventListener('conversation:read', updateMessagesBadge);
      // Tab refocus — refresh in case WS missed an event during sleep/lock
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) updateMessagesBadge();
      });
    })();
  </script>

  <!--
    Global messaging WebSocket — opened on every logged-in page so the
    top-bar badges (Messages, Notifications) update in real time without
    polling. /messages page also opens its own MessageSocket via
    workspace-v2.js (for subscribe/unsubscribe) — that's a separate
    connection but cheap; the broadcaster pushes via sendToUser to all of
    a user's sockets, so both stay in sync.
  -->
  
  <script>
    (function() {
      // Cache-safe runtime guard: only connect when the browser has the
      // non-HttpOnly logged_in cookie set by /login. Anonymous visitors
      // and pre-login no-op here without breaking page load.
      if (!document.cookie.includes('logged_in=1')) return;
      if (window.__andromaGlobalMessagingWsStarted) return;
      window.__andromaGlobalMessagingWsStarted = true;

      let ws = null;
      let reconnectDelay = 1000;
      const MAX_DELAY = 30000;
      let pingTimer = null;

      function connect() {
        if (ws && (ws.readyState === WebSocket.CONNECTING || ws.readyState === WebSocket.OPEN)) return;
        const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
        try { ws = new WebSocket(proto + '//' + location.host + '/ws/messages'); }
        catch (e) { scheduleReconnect(); return; }

        ws.onopen = () => {
          reconnectDelay = 1000;
          if (pingTimer) clearInterval(pingTimer);
          pingTimer = setInterval(() => {
            try { ws.send(JSON.stringify({ type: 'ping' })); } catch (e) {}
          }, 25000);
        };

        ws.onmessage = (ev) => {
          let data;
          try { data = JSON.parse(ev.data); } catch (e) { return; }
          if (!data || !data.type) return;
          // Fan all server-pushed events out as window events so badges,
          // call UI, notifications, and page-local message views can react
          // without polling.
          window.dispatchEvent(new CustomEvent(data.type, { detail: data }));
        };

        ws.onclose = () => {
          if (pingTimer) { clearInterval(pingTimer); pingTimer = null; }
          ws = null;
          scheduleReconnect();
        };
        ws.onerror = () => { /* onclose will follow */ };
      }

      function scheduleReconnect() {
        setTimeout(() => {
          reconnectDelay = Math.min(reconnectDelay * 2, MAX_DELAY);
          connect();
        }, reconnectDelay);
      }

      // Connect once on load (allow inline scripts above to register listeners first)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', connect);
      } else {
        connect();
      }
    })();
  </script>

