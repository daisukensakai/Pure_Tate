jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":727,"ProductCode":null,"Year":1989,"Volume":2,"IssueNumber":2,"IssueDirectory":"1989-02-02","FreeFlag":"Y","EndMatterUrl":"/1989-02-02/jams-2-2-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":728,"ProductCode":null,"Year":1989,"Volume":2,"IssueNumber":3,"IssueDirectory":"1989-02-03","FreeFlag":"Y","EndMatterUrl":"/1989-02-03/jams-2-3-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":729,"ProductCode":null,"Year":1989,"Volume":2,"IssueNumber":4,"IssueDirectory":"1989-02-04","FreeFlag":"Y","EndMatterUrl":"/1989-02-04/jams-2-4-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":722,"ProductCode":null,"Year":1988,"Volume":1,"IssueNumber":1,"IssueDirectory":"1988-01-01","FreeFlag":"Y","EndMatterUrl":"/1988-01-01/jams-1-1-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":723,"ProductCode":null,"Year":1988,"Volume":1,"IssueNumber":2,"IssueDirectory":"1988-01-02","FreeFlag":"Y","EndMatterUrl":"/1988-01-02/jams-1-2-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":724,"ProductCode":null,"Year":1988,"Volume":1,"IssueNumber":3,"IssueDirectory":"1988-01-03","FreeFlag":"Y","EndMatterUrl":"/1988-01-03/jams-1-3-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]},{"IssueId":725,"ProductCode":null,"Year":1988,"Volume":1,"IssueNumber":4,"IssueDirectory":"1988-01-04","FreeFlag":"Y","EndMatterUrl":"/1988-01-04/jams-1-4-print-matter.pdf","FileUrlHost":"https://www.ams.org/journals/jams","HomeUrlHost":"https://pubs.ams.org/jams","DirectFileUrl":"","Articles":[]}],"NonIssueArticles":[{"ArticleId":92955,"JournalProductCode":"JAMS","IssueId":null,"ManuscriptId":1081,"DocumentType":"ARTICLE","Title":"Hilbert\u0026rsquo;s tenth problem via additive combinatorics","DOI":"10.1090/jams/1081","PII":"S0894-0347-2026-01081-8","Issue":null,"IssueDirectory":"0000-000-00","StartPage":null,"EndPage":null,"PostDate":"2026-08-10T00:00:00","PrimaryMsc":"11G05, 03D35, 03D25, 11D99","SecondaryMsc":null,"MscSchema":"2020","Abstract":"For all infinite rings $R$ that are finitely generated over $\\mathbb {Z}$, we show that Hilbert\u2019s tenth problem has a negative answer. This is accomplished by constructing elliptic curves $E$ without rank growth in certain quadratic extensions $L/K$. To achieve such a result unconditionally, our key innovation is to combine techniques from additive combinatorics with $2$-descent.","EnhancedReferences":"\u003Cul\u003E\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Alpoge%2C%20Levent\u0022\u003ELevent Alp\u0026ouml;ge\u003C/a\u003E, \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Bhargava%2C%20Manjul\u0022\u003EManjul Bhargava\u003C/a\u003E, \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Ho%2C%20Wei\u0022\u003EWei Ho\u003C/a\u003E, and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Shnidman%2C%20Ari\u0022\u003EAri Shnidman\u003C/a\u003E, \u003Cem\u003ERank stability in quadratic extensions and Hilbert\u0026rsquo;s tenth problem for the ring of integers of a number field\u003C/em\u003E, Invent. Math. \u003Cstrong\u003E243\u003C/strong\u003E (2026), no.\u0026nbsp;3, 1129\u0026ndash;1139.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=5008163\u0022\u003EMR \u003Cstrong\u003E5008163\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1007/s00222-025-01392-3\u0022\u003E10.1007/s00222-025-01392-3\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Cesnavicius%2C%20Kestutis\u0022\u003EK\u0026#x119;stutis \u0026#x10C;esnavi\u0026#x10D;ius\u003C/a\u003E, \u003Cem\u003EThe $p$-parity conjecture for elliptic curves with a $p$-isogeny\u003C/em\u003E, J. Reine Angew. Math. \u003Cstrong\u003E719\u003C/strong\u003E (2016), 45\u0026ndash;73.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=3552491\u0022\u003EMR \u003Cstrong\u003E3552491\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1515/crelle-2014-0040\u0022\u003E10.1515/crelle-2014-0040\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Cornelissen%2C%20Gunther\u0022\u003EGunther Cornelissen\u003C/a\u003E, \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Pheidas%2C%20Thanases\u0022\u003EThanases Pheidas\u003C/a\u003E, and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Zahidi%2C%20Karim\u0022\u003EKarim Zahidi\u003C/a\u003E, \u003Cem\u003EDivision-ample sets and the Diophantine problem for rings of integers\u003C/em\u003E, J. Th\u0026eacute;or. Nombres Bordeaux \u003Cstrong\u003E17\u003C/strong\u003E (2005), no.\u0026nbsp;3, 727\u0026ndash;735 (English, with English and French summaries).  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=2212121\u0022\u003EMR \u003Cstrong\u003E2212121\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.5802/jtnb.516\u0022\u003E10.5802/jtnb.516\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Cowland%20Kellock%2C%20Lilybelle\u0022\u003ELilybelle Cowland Kellock\u003C/a\u003E and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Dokchitser%2C%20Vladimir\u0022\u003EVladimir Dokchitser\u003C/a\u003E, \u003Cem\u003ERoot numbers and parity phenomena\u003C/em\u003E, Bull. Lond. Math. Soc. \u003Cstrong\u003E55\u003C/strong\u003E (2023), no.\u0026nbsp;6, 2557\u0026ndash;2597.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=4689540\u0022\u003EMR \u003Cstrong\u003E4689540\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.1112/blms.12931\u0022\u003E10.1112/blms.12931\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Davis%2C%20Martin\u0022\u003EMartin Davis\u003C/a\u003E, \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Putnam%2C%20Hilary\u0022\u003EHilary Putnam\u003C/a\u003E, and \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Robinson%2C%20Julia\u0022\u003EJulia Robinson\u003C/a\u003E, \u003Cem\u003EThe decision problem for exponential diophantine equations\u003C/em\u003E, Ann. of Math. (2) \u003Cstrong\u003E74\u003C/strong\u003E (1961), 425\u0026ndash;436.  \u003Ca href=\u0022https://mathscinet.ams.org/mathscinet-getitem?mr=133227\u0022\u003EMR \u003Cstrong\u003E133227\u003C/strong\u003E\u003C/a\u003E, DOI \u003Ca href=\u0022https://doi.org/10.2307/1970289\u0022\u003E10.2307/1970289\u003C/a\u003E\u003C/li\u003E\n\n\n\u003Cli\u003E\u003Ca href=\u0022https://mathscinet.ams.org/mathscinet/search/authors.html?authorName=Denef%2C%20J.\u0022\u003EJ. Denef\u003C/a\u003E, \u003Ca href=\u0022/tran/1980-257-01/S0002-9947-1980-0549163-X/\u0022 class=\u0022amsJournalReferenceTitle\u0022\u003E\u003Cem\u003EDiophantine sets over algebraic integer rings. II\u003C/em\u003E\u003C/a\u003E, \u003Ca href=\u0022/tran/\u0022\u003ETrans. A