    <annotation encoding="application/x-tex">{\displaystyle {\begin{aligned}X&amp;=\lambda {\frac {\partial f}{\partial x}}(p,q,r),\\Y&amp;=\lambda {\frac {\partial f}{\partial y}}(p,q,r),\\Z&amp;=\lambda {\frac {\partial f}{\partial z}}(p,q,r).\end{aligned}}}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/d0de0d259b020d30c7573b010b713af2ac8cfaf0" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -8.171ex; width:18.481ex; height:17.509ex;" alt="{\displaystyle {\begin{aligned}X&amp;=\lambda {\frac {\partial f}{\partial x}}(p,q,r),\\Y&amp;=\lambda {\frac {\partial f}{\partial y}}(p,q,r),\\Z&amp;=\lambda {\frac {\partial f}{\partial z}}(p,q,r).\end{aligned}}}"/></span></dd></dl>

<p id="mwNg">Eliminating <span class="texhtml mvar" style="font-style:italic;" about="#mwt19" typeof="mw:Transclusion" id="mwNw" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"p"}},"i":0}}]}'>p</span>, <span class="texhtml mvar" style="font-style:italic;" about="#mwt20" typeof="mw:Transclusion" id="mwOA" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"q"}},"i":0}}]}'>q</span>, <span class="texhtml mvar" style="font-style:italic;" about="#mwt21" typeof="mw:Transclusion" id="mwOQ" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"r"}},"i":0}}]}'>r</span>, and <span class="texhtml mvar" style="font-style:italic;" about="#mwt22" typeof="mw:Transclusion" id="mwOg" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"λ"}},"i":0}}]}'>λ</span> from these equations, along with <span class="texhtml " about="#mwt23" typeof="mw:Transclusion" id="mwOw" data-mw='{"parts":[{"template":{"target":{"wt":"math","href":"./Template:Math"},"params":{"1":{"wt":"&apos;&apos;Xp&apos;&apos; + &apos;&apos;Yq&apos;&apos; + &apos;&apos;Zr&apos;&apos; {{=}} 0"}},"i":0}}]}'><i>Xp</i> + <i>Yq</i> + <i>Zr</i> = 0</span>, gives the equation in <span class="texhtml mvar" style="font-style:italic;" about="#mwt24" typeof="mw:Transclusion" id="mwPA" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"X"}},"i":0}}]}'>X</span>, <span class="texhtml mvar" style="font-style:italic;" about="#mwt25" typeof="mw:Transclusion" id="mwPQ" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"Y"}},"i":0}}]}'>Y</span> and <span class="texhtml mvar" style="font-style:italic;" about="#mwt26" typeof="mw:Transclusion" id="mwPg" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"Z"}},"i":0}}]}'>Z</span> of the dual curve.</p>
<figure typeof="mw:File/Thumb" id="mwPw" data-mw='{"attribs":[["thumbtime",{"txt":"0.5"}]]}'><span id="mwQA"><video poster="//upload.wikimedia.org/wikipedia/commons/thumb/9/95/Dual.webm/330px-seek%3D0.5-Dual.webm.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser" controls="" preload="none" data-mw-tmh="" height="229" width="458" resource="https://en.wikipedia.org/wiki/File:Dual.webm" data-durationhint="4" class="mw-file-element" id="mwQQ"><source src="//upload.wikimedia.org/wikipedia/commons/9/95/Dual.webm?utm_source=en.wikipedia.org&amp;utm_campaign=index&amp;utm_content=original" type='video/webm; codecs="vp8"' data-file-width="458" data-file-height="229" id="mwQg"/><source src="//upload.wikimedia.org/wikipedia/commons/transcoded/9/95/Dual.webm/Dual.webm.240p.vp9.webm" type='video/webm; codecs="vp9, opus"' data-width="426" data-height="214" data-transcodekey="240p.vp9.webm" id="mwQw"/></video></span><figcaption id="mwRA">On the left: the ellipse <span class="texhtml " about="#mwt27" typeof="mw:Transclusion" id="mwRQ" data-mw='{"parts":[{"template":{"target":{"wt":"math","href":"./Template:Math"},"params":{"1":{"wt":"({{sfrac|&apos;&apos;x&apos;&apos;|2}}){{su|p=2}} + ({{sfrac|&apos;&apos;y&apos;&apos;|3}}){{su|p=2}} {{=}} 1"}},"i":0}}]}'>(<style data-mw-deduplicate="TemplateStyles:r1354360663" typeof="mw:Extension/templatestyles" about="#mwt28" data-mw='{"name":"templatestyles","attrs":{"src":"Sfrac/styles.css"}}'>.mw-parser-output .sfrac{white-space:nowrap}.mw-parser-output .sfrac.tion,.mw-parser-output .sfrac .tion{display:inline-block;vertical-align:-0.5em;font-size:85%;text-align:center;margin-left:.1em;margin-right:.1em}.mw-parser-output .sfrac .num{display:block;border-bottom:1px solid}.mw-parser-output .sfrac .den{display:block;line-height:1.5em}.mw-parser-output .sr-only{border:0;clip:rect(0,0,0,0);clip-path:polygon(0px 0px,0px 0px,0px 0px);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px}</style><span class="sfrac"><span typeof="mw:Entity">⁠</span><span class="tion"><span class="num"><i>x</i></span><span class="sr-only">/</span><span class="den">2</span></span><span typeof="mw:Entity">⁠</span></span>)<span class="nowrap"><span style="display:inline-block;margin-bottom:-0.3em;vertical-align:0.8em;line-height:1.2em;font-size:80%;text-align:left"><sup style="font-size:inherit;line-height:inherit;vertical-align:baseline">2</sup><br/><sub style="font-size:inherit;line-height:inherit;vertical-align:baseline"></sub></span></span> + (<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1354360663" about="#mwt29" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Sfrac/styles.css"}}'/><span class="sfrac"><span typeof="mw:Entity">⁠</span><span class="tion"><span class="num"><i>y</i></span><span class="sr-only">/</span><span class="den">3</span></span><span typeof="mw:Entity">⁠</span></span>)<span class="nowrap"><span style="display:inline-block;margin-bottom:-0.3em;vertical-align:0.8em;line-height:1.2em;font-size:80%;text-align:left"><sup style="font-size:inherit;line-height:inherit;vertical-align:baseline">2</sup><br/><sub style="font-size:inherit;line-height:inherit;vertical-align:baseline"></sub></span></span> = 1</span> with tangent lines <span class="texhtml " about="#mwt30" typeof="mw:Transclusion" id="mwRg" data-mw='{"parts":[{"template":{"target":{"wt":"math","href":"./Template:Math"},"params":{"1":{"wt":"&apos;&apos;xX&apos;&apos; + &apos;&apos;yY&apos;&apos; {{=}} 1"}},"i":0}}]}'><i>xX</i> + <i>yY</i> = 1</span> for any <span class="texhtml mvar" style="font-style:italic;" about="#mwt31" typeof="mw:Transclusion" id="mwRw" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"X"}},"i":0}}]}'>X</span>, <span class="texhtml mvar" style="font-style:italic;" about="#mwt32" typeof="mw:Transclusion" id="mwSA" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"Y"}},"i":0}}]}'>Y</span>, such that <span class="texhtml " about="#mwt33" typeof="mw:Transclusion" id="mwSQ" data-mw='{"parts":[{"template":{"target":{"wt":"math","href":"./Template:Math"},"params":{"1":{"wt":"(2&apos;&apos;X&apos;&apos;)&lt;sup>2&lt;/sup> + (3&apos;&apos;Y&apos;&apos;)&lt;sup>2&lt;/sup> {{=}} 1"}},"i":0}}]}'>(2<i>X</i>)<sup>2</sup> + (3<i>Y</i>)<sup>2</sup> = 1</span>.<br id="mwSg"/>On the right: the dual ellipse <span class="texhtml " about="#mwt34" typeof="mw:Transclusion" id="mwSw" data-mw='{"parts":[{"template":{"target":{"wt":"math","href":"./Template:Math"},"params":{"1":{"wt":"(2&apos;&apos;X&apos;&apos;)&lt;sup>2&lt;/sup> + (3&apos;&apos;Y&apos;&apos;)&lt;sup>2&lt;/sup> {{=}} 1"}},"i":0}}]}'>(2<i>X</i>)<sup>2</sup> + (3<i>Y</i>)<sup>2</sup> = 1</span>. Each tangent to the first ellipse corresponds to a point on the second one (marked with the same color).</figcaption></figure>

<section data-mw-section-id="2" id="mwTA" aria-labelledby="Conic"><div class="mw-heading mw-heading3"><h3 id="Conic">Conic</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Dual_curve&amp;action=edit&amp;section=2" title="Edit section: Conic"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwTQ">For example, let <span class="texhtml mvar" style="font-style:italic;" about="#mwt35" typeof="mw:Transclusion" id="mwTg" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"C"}},"i":0}}]}'>C</span> be the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Conic_section" title="Conic section" id="mwTw">conic</a> <span class="texhtml " about="#mwt36" typeof="mw:Transclusion" id="mwUA" data-mw='{"parts":[{"template":{"target":{"wt":"math","href":"./Template:Math"},"params":{"1":{"wt":"&apos;&apos;ax&apos;&apos;&lt;sup>2&lt;/sup> + &apos;&apos;by&apos;&apos;&lt;sup>2&lt;/sup> + &apos;&apos;cz&apos;&apos;&lt;sup>2&lt;/sup> {{=}} 0"}},"i":0}}]}'><i>ax</i><sup>2</sup> + <i>by</i><sup>2</sup> + <i>cz</i><sup>2</sup> = 0</span>. The dual is found by eliminating <span class="texhtml mvar" style="font-style:italic;" about="#mwt37" typeof="mw:Transclusion" id="mwUQ" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"p"}},"i":0}}]}'>p</span>, <span class="texhtml mvar" style="font-style:italic;" about="#mwt38" typeof="mw:Transclusion" id="mwUg" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"q"}},"i":0}}]}'>q</span>, <span class="texhtml mvar" style="font-style:italic;" about="#mwt39" typeof="mw:Transclusion" id="mwUw" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"r"}},"i":0}}]}'>r</span>, and <span class="texhtml mvar" style="font-style:italic;" about="#mwt40" typeof="mw:Transclusion" id="mwVA" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"λ"}},"i":0}}]}'>λ</span> from the equations</p>
<dl id="mwVQ"><dd id="mwVg"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt41" id="mwVw" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\begin{array}{c} \nX= 2\\lambda ap, \\ \\ Y=2\\lambda bq, \\ \\ Z=2\\lambda cr,\\\\\nXp+Yq+Zr=0.\n\\end{array}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle {\begin{array}{c}X=2\lambda ap,\ \ Y=2\lambda bq,\ \ Z=2\lambda cr,\\Xp+Yq+Zr=0.\end{array}}}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow class="MJX-TeXAtom-ORD">
          <mtable rowspacing="4pt" columnspacing="1em">
            <mtr>
              <mtd>
                <mi>X</mi>
                <mo>=</mo>
                <mn>2</mn>
                <mi>λ<!-- λ --></mi>
                <mi>a</mi>
                <mi>p</mi>
                <mo>,</mo>
                <mtext> </mtext>
                <mtext> </mtext>
                <mi>Y</mi>
                <mo>=</mo>
                <mn>2</mn>
