              <mi>c</mi>
            </mrow>
          </mfrac>
        </mrow>
        <mo>=</mo>
        <mn>0.</mn>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle {\frac {X^{2}}{2\lambda a}}+{\frac {Y^{2}}{2\lambda b}}+{\frac {Z^{2}}{2\lambda c}}=0.}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/facdcbe2c9838039641a01e54b4dd810e2fd4eb0" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -2.005ex; width:23.884ex; height:5.843ex;" alt="{\displaystyle {\frac {X^{2}}{2\lambda a}}+{\frac {Y^{2}}{2\lambda b}}+{\frac {Z^{2}}{2\lambda c}}=0.}"/></span></dd></dl>
<p id="mwXw">Clearing <span class="texhtml " about="#mwt46" typeof="mw:Transclusion" id="mwYA" data-mw='{"parts":[{"template":{"target":{"wt":"math","href":"./Template:Math"},"params":{"1":{"wt":"2&apos;&apos;λ&apos;&apos;"}},"i":0}}]}'>2<i>λ</i></span> from the denominators, the equation of the dual is</p>
<dl id="mwYQ"><dd id="mwYg"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt47" id="mwYw" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\frac{X^2}{a}+\\frac{Y^2}{b}+\\frac{Z^2}{c}=0."}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle {\frac {X^{2}}{a}}+{\frac {Y^{2}}{b}}+{\frac {Z^{2}}{c}}=0.}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow class="MJX-TeXAtom-ORD">
          <mfrac>
            <msup>
              <mi>X</mi>
              <mrow class="MJX-TeXAtom-ORD">
                <mn>2</mn>
              </mrow>
            </msup>
            <mi>a</mi>
