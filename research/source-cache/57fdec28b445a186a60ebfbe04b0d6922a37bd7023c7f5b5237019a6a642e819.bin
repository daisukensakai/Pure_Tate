        <mi>n</mi>
        <mo stretchy="false">)</mo>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle \mathbb {G} (k,n)}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/1faa66d185fbb770833de385a4022f2f17a43d44" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:7.257ex; height:2.843ex;" alt="{\displaystyle \mathbb {G} (k,n)}"/></span> parameterizing <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt116" id="mwwQ" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"H \\subset X \\subset \\mathbb{P}^n"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle H\subset X\subset \mathbb {P} ^{n}}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mi>H</mi>
        <mo>⊂<!-- ⊂ --></mo>
        <mi>X</mi>
        <mo>⊂<!-- ⊂ --></mo>
        <msup>
