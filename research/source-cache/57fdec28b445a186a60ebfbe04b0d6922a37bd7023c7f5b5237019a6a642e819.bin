          <mi>Sym</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mn>2</mn>
          </mrow>
        </msup>
        <mo>⁡<!-- ⁡ --></mo>
        <mi>M</mi>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle \operatorname {Sym} ^{2}M}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/21930188359f6ebe7defa4cbc48add9e81c75b73" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.671ex; width:8.339ex; height:3.009ex;" alt="{\displaystyle \operatorname {Sym} ^{2}M}"/></span> are locally isomorphic to <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt182" id="mwATY" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\Complex^2 \\times \\Complex^2/\\{\\pm 1\\}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \mathbb {C} ^{2}\times \mathbb {C} ^{2}/\{\pm 1\}}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
