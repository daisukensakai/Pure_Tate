<figure typeof="mw:File/Thumb" id="mwBg"><a href="https://en.wikipedia.org/wiki/File:Hodge_conjecture.png" class="mw-file-description" id="mwBw"><img resource="https://en.wikipedia.org/wiki/File:Hodge_conjecture.png" src="//upload.wikimedia.org/wikipedia/commons/thumb/a/a0/Hodge_conjecture.png/500px-Hodge_conjecture.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/a/a0/Hodge_conjecture.png/960px-Hodge_conjecture.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="3501" data-file-height="1431" data-file-type="bitmap" height="172" width="420" class="mw-file-element" id="mwCA"/></a><figcaption id="mwCQ">Topological features of a space <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt10" id="mwCg" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"X"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle X}">
  <semantics>
