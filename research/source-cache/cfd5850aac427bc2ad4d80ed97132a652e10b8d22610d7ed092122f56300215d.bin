<dl id="mwXw"><dd id="mwYA"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt30" id="mwYQ" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\int_Z i^*\\alpha"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle \int _{Z}i^{*}\alpha }">
