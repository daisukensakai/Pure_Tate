mathcal{M}}_{0,(A\cap B^{c})\cup q}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 166.77 0) translate(60.3,0) matrix(1.0 0.0 0.0 1.0 -21.13 0)"><foreignObject style="--ltx-fo-width:2.05em;--ltx-fo-height:0.57em;--ltx-fo-depth:0.29em;font-size:10pt;" height="11.82" overflow="visible" transform="matrix(1 0 0 -1 0 7.86)" width="28.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.E4.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\overline{\mathcal{M}}_{1,A},}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>A</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\overline{\mathcal{M}}_{1,A},}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -19.86 24.72 L 74.73 24.72"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 75.01 24.72)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 21.57 29.37)"><foreignObject style="--ltx-fo-width:0.89em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.56" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.E4.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\iota_{B}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">ι</mi><mi mathsize="0.710em">B</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\iota_{B}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -43.69 13.85 L -43.69 -11.83"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -43.69 -12.11)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 99.99 11.97 L 99.99 -12.05"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 99.99 -12.33)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 103.24 -2.74)"><foreignObject style="--ltx-fo-width:1.04em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="14.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.E4.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces f_{A}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">f</mi><mi mathsize="0.710em">A</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces f_{A}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 39.97 -22.34 L 72.07 -22.34"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 72.35 -22.34)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
