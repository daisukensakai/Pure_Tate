          <mover>
            <mrow>
              <msup>
                <mi>F</mi>
                <mrow class="MJX-TeXAtom-ORD">
                  <mi>q</mi>
                </mrow>
              </msup>
              <mi>H</mi>
            </mrow>
            <mo accent="false">¯<!-- ¯ --></mo>
          </mover>
