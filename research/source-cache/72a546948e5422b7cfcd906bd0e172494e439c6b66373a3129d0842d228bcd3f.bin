    <annotation encoding="application/x-tex">{\displaystyle F^{p}H=\bigoplus \nolimits _{i\geq p}H^{i,n-i}.}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/edbcd93f396d59358e222fc9d196afbf9affb5b7" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -1.671ex; width:21.678ex; height:4.176ex;" alt="{\displaystyle F^{p}H=\bigoplus \nolimits _{i\geq p}H^{i,n-i}.}"/></span></dd></dl>

<p id="mwMw">For example, if <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt16" id="mwNA" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"X"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle X}">
  <semantics>
