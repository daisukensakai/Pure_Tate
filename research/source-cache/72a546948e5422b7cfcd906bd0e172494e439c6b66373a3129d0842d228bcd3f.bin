  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/bf6a12a26cb879a261ac821e0bf5f68bd36ba4af" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:8.761ex; height:2.509ex;" alt="{\displaystyle C=i^{p-q}}"/></span> on <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt38" id="mwYg" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"H^{p,q}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle H^{p,q}}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
