          </mrow>
        </msup>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle H^{q,p}}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/e21041a6a6849dce8acf7665b358ed4d3d9b5b7d" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:4.376ex; height:2.343ex;" alt="{\displaystyle H^{q,p}}"/></span>:</p>

<dl id="mwHw"><dd id="mwIA"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt8" id="mwIQ" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"H := H_{\\Z}\\otimes_{\\Z} \\Complex = \\bigoplus\\nolimits_{p+q=n}H^{p,q},"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle H:=H_{\mathbb {Z} }\otimes _{\mathbb {Z} }\mathbb {C} =\bigoplus \nolimits _{p+q=n}H^{p,q},}">
