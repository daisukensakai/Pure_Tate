            <mo>,</mo>
            <mi>q</mi>
          </mrow>
        </msup>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle H^{p,q}}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/fb00ccee8c508c8c48f7948cf82cdcc53c801fb8" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:4.376ex; height:2.343ex;" alt="{\displaystyle H^{p,q}}"/></span> is <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt7" id="mwHg" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"H^{q,p}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle H^{q,p}}">
  <semantics>
