        <mi>H</mi>
        <mo>.</mo>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle \forall p,q\</annotation></semantics></math><span typeof="mw:DisplaySpace"> </span>:\ p+q=n+1,\qquad F^{p}H\cap {\overline {F^{q}H}}=0\quad {\text{and}}\quad F^{p}H\oplus {\overline {F^{q}H}}=H.}
  
</span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/02c6d5ae8afdc89362e5f7c52153f3c88c8dea61" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.671ex; width:70.815ex; height:3.343ex;" alt="{\displaystyle \forall p,q\ :\ p+q=n+1,\qquad F^{p}H\cap {\overline {F^{q}H}}=0\quad {\text{and}}\quad F^{p}H\oplus {\overline {F^{q}H}}=H.}"/></span></dd></dl>

<p id="mwLQ">The relation between these two descriptions is given as follows:</p>

<dl id="mwLg"><dd id="mwLw"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt14" id="mwMA" data-mw='{"name":"math","attrs":{},"body":{"extsrc":" H^{p,q}=F^p H\\cap \\overline{F^q H},"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle H^{p,q}=F^{p}H\cap {\overline {F^{q}H}},}">
  <semantics>
