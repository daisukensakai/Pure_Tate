    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle H^{p,q}=F^{p}H\cap {\overline {F^{q}H}},}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/3e097c5172b213cf1e3c3d89ca652f458c180434" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.671ex; width:20.71ex; height:3.343ex;" alt="{\displaystyle H^{p,q}=F^{p}H\cap {\overline {F^{q}H}},}"/></span></dd>
<dd id="mwMQ"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt15" id="mwMg" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"F^p H= \\bigoplus\\nolimits_{i\\geq p} H^{i,n-i}. "}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle F^{p}H=\bigoplus \nolimits _{i\geq p}H^{i,n-i}.}">
  <semantics>
