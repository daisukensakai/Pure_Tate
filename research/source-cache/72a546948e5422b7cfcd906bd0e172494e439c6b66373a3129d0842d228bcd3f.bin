    <annotation encoding="application/x-tex">{\displaystyle F^{p}\operatorname {gr} _{n}^{W}H=\left(F^{p}\cap W_{n}\otimes \mathbb {C} +W_{n-1}\otimes \mathbb {C} \right)/W_{n-1}\otimes \mathbb {C} .}</annotation>
