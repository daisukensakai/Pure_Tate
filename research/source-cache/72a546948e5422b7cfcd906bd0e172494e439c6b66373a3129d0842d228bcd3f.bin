<dl id="mw2w"><dd id="mw3A"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt84" id="mw3Q" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\operatorname{gr}_n^{W} H = W_n\\otimes\\Complex /W_{n-1}\\otimes\\Complex"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \operatorname {gr} _{n}^{W}H=W_{n}\otimes \mathbb {C} /W_{n-1}\otimes \mathbb {C} }">
