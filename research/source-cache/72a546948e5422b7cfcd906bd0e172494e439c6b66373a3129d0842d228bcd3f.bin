        <mo>+</mo>
        <mn>1</mn>
        <mo>,</mo>
        <mspace width="2em"></mspace>
        <msup>
          <mi>F</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>p</mi>
          </mrow>
        </msup>
        <mi>H</mi>
        <mo>∩<!-- ∩ --></mo>
        <mrow class="MJX-TeXAtom-ORD">
          <mover>
            <mrow>
              <msup>
                <mi>F</mi>
                <mrow class="MJX-TeXAtom-ORD">
                  <mi>q</mi>
                </mrow>
              </msup>
              <mi>H</mi>
            </mrow>
            <mo accent="false">¯<!-- ¯ --></mo>
          </mover>
        </mrow>
        <mo>=</mo>
        <mn>0</mn>
        <mspace width="1em"></mspace>
        <mrow class="MJX-TeXAtom-ORD">
          <mtext>and</mtext>
        </mrow>
        <mspace width="1em"></mspace>
        <msup>
          <mi>F</mi>
