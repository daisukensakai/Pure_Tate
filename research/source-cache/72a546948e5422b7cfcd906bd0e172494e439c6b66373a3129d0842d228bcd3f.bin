</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/a76b71ff499779c9fdade9cbea2a984ba68e587f" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:28.702ex; height:3.009ex;" alt="{\displaystyle \operatorname {gr} _{n}^{W}H=W_{n}\otimes \mathbb {C} /W_{n-1}\otimes \mathbb {C} }"/></span></dd></dl>

<p id="mw3g">is defined by</p>

<dl id="mw3w"><dd id="mw4A"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt85" id="mw4Q" data-mw='{"name":"math","attrs":{},"body":{"extsrc":" F^p \\operatorname{gr}_n^W H = \\left (F^p\\cap W_n\\otimes\\Complex +W_{n-1} \\otimes \\Complex \\right )/W_{n-1}\\otimes\\Complex."}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle F^{p}\operatorname {gr} _{n}^{W}H=\left(F^{p}\cap W_{n}\otimes \mathbb {C} +W_{n-1}\otimes \mathbb {C} \right)/W_{n-1}\otimes \mathbb {C} .}">
  <semantics>
