        <mo stretchy="false">(</mo>
        <mi>p</mi>
        <mo>∈<!-- ∈ --></mo>
        <mrow class="MJX-TeXAtom-ORD">
          <mi mathvariant="double-struck">Z</mi>
        </mrow>
        <mo stretchy="false">)</mo>
        <mo>,</mo>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle F^{p}H(p\in \mathbb {Z} ),}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/42d6f429f2519daacada4abc7ad3038809cb5d9d" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:12.954ex; height:2.843ex;" alt="{\displaystyle F^{p}H(p\in \mathbb {Z} ),}"/></span> subject to the condition</p>

<dl id="mwKg"><dd id="mwKw"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt13" id="mwLA" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\forall p, q \\ : \\ p + q = n+1, \\qquad F^p H\\cap\\overline{F^q H}=0 \\quad \\text{and} \\quad F^p H \\oplus \\overline{F^q H}=H."}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \forall p,q\ :\ p+q=n+1,\qquad F^{p}H\cap {\overline {F^{q}H}}=0\quad {\text{and}}\quad F^{p}H\oplus {\overline {F^{q}H}}=H.}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mi mathvariant="normal">∀<!-- ∀ --></mi>
