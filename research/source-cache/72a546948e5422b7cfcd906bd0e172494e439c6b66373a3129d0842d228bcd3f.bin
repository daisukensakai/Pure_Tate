<p id="mwAZ0">has fibers</p>
<dl id="mwAZ4"><dd id="mwAZ8"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt148" id="mwAaA" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"X_t = f^{-1}(\\{t\\}) = \\left \\{(x,y)\\in\\Complex ^2: y^6 - x^6 = t \\right \\}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle X_{t}=f^{-1}(\{t\})=\left\{(x,y)\in \mathbb {C} ^{2}:y^{6}-x^{6}=t\right\}}">
