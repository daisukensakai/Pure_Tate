    <annotation encoding="application/x-tex">{\displaystyle \psi (g)=\sum _{x\in G/H}{\widehat {\chi }}\left(x^{-1}gx\right),}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/5950d336a809e8eedd49b252bd16f5d1c1c868fd" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -3.505ex; width:24.695ex; height:6.009ex;" alt="{\displaystyle \psi (g)=\sum _{x\in G/H}{\widehat {\chi }}\left(x^{-1}gx\right),}"/></span></dd></dl>

<p id="mwqw">where the sum is taken over a system of representatives of the left cosets of <span class="texhtml mvar" style="font-style:italic;" about="#mwt86" typeof="mw:Transclusion" id="mwrA" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"H"}},"i":0}}]}'>H</span> in <span class="texhtml mvar" style="font-style:italic;" about="#mwt87" typeof="mw:Transclusion" id="mwrQ" data-mw='{"parts":[{"template":{"target":{"wt":"mvar","href":"./Template:Mvar"},"params":{"1":{"wt":"G"}},"i":0}}]}'>G</span> and</p>

<dl id="mwrg"><dd id="mwrw"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt88" id="mwsA" data-mw='{"name":"math","attrs":{},"body":{"extsrc":" \\widehat{\\chi} (k) = \\begin{cases} \\chi(k) &amp; \\text{if } k \\in H \\\\ 0 &amp; \\text{otherwise}\\end{cases}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle {\widehat {\chi }}(k)={\begin{cases}\chi (k)&amp;{\text{if }}k\in H\\0&amp;{\text{otherwise}}\end{cases}}}">
  <semantics>
