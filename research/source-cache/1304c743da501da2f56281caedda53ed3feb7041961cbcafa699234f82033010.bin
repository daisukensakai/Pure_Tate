        <mo stretchy="false">(</mo>
        <mi>g</mi>
        <mi>h</mi>
        <mo>,</mo>
        <mi>π<!-- π --></mi>
        <mo stretchy="false">(</mo>
        <msup>
          <mi>h</mi>
