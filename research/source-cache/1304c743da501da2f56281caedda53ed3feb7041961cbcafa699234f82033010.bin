    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle (g,x)\sim (gh,\pi (h^{-1})(x)){\text{ for all }}h\in H.}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/c0ccf19400bae4f1094cb100aacbc099328fd1aa" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:37.512ex; height:3.176ex;" alt="{\displaystyle (g,x)\sim (gh,\pi (h^{-1})(x)){\text{ for all }}h\in H.}"/></span></dd></dl>

<p id="mwAQE">Denote the equivalence class of <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt129" id="mwAQI" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"(g,x)"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle (g,x)}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
