          <mrow class="MJX-TeXAtom-ORD">
            <mi>H</mi>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>G</mi>
          </mrow>
        </msubsup>
        <mo>⁡<!-- ⁡ --></mo>
        <mi>π<!-- π --></mi>
        <mo>=</mo>
