          <mo>{</mo>
          <mrow>
            <mi>ϕ<!-- ϕ --></mi>
            <mo>:<!-- : --></mo>
            <mi>G</mi>
            <mo stretchy="false">→<!-- → --></mo>
            <mi>V</mi>
            <mtext> </mtext>
            <mo>:</mo>
            <mtext> </mtext>
            <mi>ϕ<!-- ϕ --></mi>
            <mo stretchy="false">(</mo>
            <mi>g</mi>
