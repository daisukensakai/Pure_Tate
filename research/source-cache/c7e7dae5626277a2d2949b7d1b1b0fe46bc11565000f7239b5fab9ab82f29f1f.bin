    <p id="captcha-message" style="display: none" class="alert alert-warning" role="alert">The tag you filled in for the captcha is wrong. You need to write <span class="tag">06PT</span>, in case you are confused.</p>

    <script type="text/javascript">
// enter in captcha fields causes \ref to appear (?!)
$("input#check").on("keypress", function(e) {
  if (e.which == 13) {
    // always stop the event
    e.preventDefault();

    // perform clientside check as for actual submit
    if ($("#check").val() != $("#hidden-tag").val()) {
      // explain captcha
      $("#captcha-message").toggle();
    }
    else {
      $("form#comment-form").submit();
    }
  }
});
    </script>
