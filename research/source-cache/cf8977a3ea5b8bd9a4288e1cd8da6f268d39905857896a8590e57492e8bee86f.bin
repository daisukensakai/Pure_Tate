</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/6413fe01c088d830443c0706467e15a9968d5f4e" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:3.162ex; height:2.676ex;" alt="{\displaystyle A^{\Omega }}"/></span> given above. The subgroup <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt58" id="mwUA" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"A^{\\Omega}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle A^{\Omega }}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <msup>
          <mi>A</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mi mathvariant="normal">Ω<!-- Ω --></mi>
          </mrow>
        </msup>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle A^{\Omega }}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/6413fe01c088d830443c0706467e15a9968d5f4e" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:3.162ex; height:2.676ex;" alt="{\displaystyle A^{\Omega }}"/></span> of <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt59" id="mwUQ" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"A^{\\Omega} \\rtimes H"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle A^{\Omega }\rtimes H}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <msup>
          <mi>A</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mi mathvariant="normal">Ω<!-- Ω --></mi>
          </mrow>
        </msup>
        <mo>⋊<!-- ⋊ --></mo>
        <mi>H</mi>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle A^{\Omega }\rtimes H}</annotation>
