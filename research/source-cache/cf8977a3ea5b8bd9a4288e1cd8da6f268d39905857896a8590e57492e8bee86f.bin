    <annotation encoding="application/x-tex">{\displaystyle \Lambda }</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/0ac0a4a98a414e3480335f9ba652d12571ec6733" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:1.613ex; height:2.176ex;" alt="{\displaystyle \Lambda }"/></span> on which <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt116" id="mwsg" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"A\\operatorname{Wr}_\\Omega H"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle A\operatorname {Wr} _{\Omega }H}">
