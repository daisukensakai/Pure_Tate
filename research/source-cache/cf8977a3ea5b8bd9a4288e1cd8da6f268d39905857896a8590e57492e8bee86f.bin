  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/f65c48c049679e678c9bf9aab0281fd4e9a60665" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.671ex; width:9.3ex; height:2.509ex;" alt="{\displaystyle A\operatorname {Wr} _{\Omega }H}"/></span> or the restricted wreath product <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt74" id="mwaw" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"A\\operatorname{wr}_\\Omega H"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle A\operatorname {wr} _{\Omega }H}">
