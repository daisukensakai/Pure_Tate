<p id="S9.I2.i3.p1.1" class="ltx_p">genus <math id="S9.I2.i3.p1.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>: <math id="S9.I2.i3.p1.m2" class="ltx_Math" alttext="N=38" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>38</mn></mrow><annotation encoding="application/x-tex">N=38</annotation></semantics></math>, <math id="S9.I2.i3.p1.m3" class="ltx_Math" alttext="44" display="inline" intent=":literal"><semantics><mn>44</mn><annotation encoding="application/x-tex">44</annotation></semantics></math>, <math id="S9.I2.i3.p1.m4" class="ltx_Math" alttext="54" display="inline" intent=":literal"><semantics><mn>54</mn><annotation encoding="application/x-tex">54</annotation></semantics></math>, <math id="S9.I2.i3.p1.m5" class="ltx_Math" alttext="81" display="inline" intent=":literal"><semantics><mn>81</mn><annotation encoding="application/x-tex">81</annotation></semantics></math>;</p>
</div></li>
<li id="S9.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S9.I2.i4.p1" class="ltx_para">
<p id="S9.I2.i4.p1.1" class="ltx_p">genus <math id="S9.I2.i4.p1.m1" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>: <math id="S9.I2.i4.p1.m2" class="ltx_Math" alttext="N=42" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>42</mn></mrow><annotation encoding="application/x-tex">N=42</annotation></semantics></math>, <math id="S9.I2.i4.p1.m3" class="ltx_Math" alttext="51" display="inline" intent=":literal"><semantics><mn>51</mn><annotation encoding="application/x-tex">51</annotation></semantics></math>, <math id="S9.I2.i4.p1.m4" class="ltx_Math" alttext="55" display="inline" intent=":literal"><semantics><mn>55</mn><annotation encoding="application/x-tex">55</annotation></semantics></math>, <math id="S9.I2.i4.p1.m5" class="ltx_Math" alttext="56" display="inline" intent=":literal"><semantics><mn>56</mn><annotation encoding="application/x-tex">56</annotation></semantics></math>, <math id="S9.I2.i4.p1.m6" class="ltx_Math" alttext="63" display="inline" intent=":literal"><semantics><mn>63</mn><annotation encoding="application/x-tex">63</annotation></semantics></math>, <math id="S9.I2.i4.p1.m7" class="ltx_Math" alttext="72" display="inline" intent=":literal"><semantics><mn>72</mn><annotation encoding="application/x-tex">72</annotation></semantics></math>, <math id="S9.I2.i4.p1.m8" class="ltx_Math" alttext="75" display="inline" intent=":literal"><semantics><mn>75</mn><annotation encoding="application/x-tex">75</annotation></semantics></math>;</p>
</div></li>
