<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S1.Ex43.m1" class="ltx_Math" alttext="\displaystyle\tau^{\prime}_{1k}:t_{1}\mapsto t^{\prime}_{1}=c_{1}^{-1}t_{1}c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>τ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">↦</mo><msubsup><mi>t</mi><mn>1</mn><mo>′</mo></msubsup><mo>=</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tau^{\prime}_{1k}:t_{1}\mapsto t^{\prime}_{1}=c_{1}^{-1}t_{1}c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S1.Ex43.5.1" class="ltx_text ltx_markedasmath ltx_font_italic">where
