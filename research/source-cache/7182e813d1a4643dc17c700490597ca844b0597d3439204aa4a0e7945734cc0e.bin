<tbody id="S1.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S1.Ex44.m1" class="ltx_Math" alttext="\displaystyle\tau^{\prime}_{1k}:\lambda_{k}\mapsto\lambda_{k}^{\prime}=(d_{1}^{-1}t_{1}d_{1})\lambda_{k}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>τ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo stretchy="false">↦</mo><msubsup><mi>λ</mi><mi>k</mi><mo>′</mo></msubsup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>d</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>k</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tau^{\prime}_{1k}:\lambda_{k}\mapsto\lambda_{k}^{\prime}=(d_{1}^{-1}t_{1}d_{1})\lambda_{k},</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S1.Ex44.5.1" class="ltx_text ltx_markedasmath ltx_font_italic">where <math id="S1.Ex44.m2.m1" class="ltx_Math" alttext="d_{1}=u_{k-1}[\lambda_{k},\mu_{k}]\mu_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>u</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">d_{1}=u_{k-1}[\lambda_{k},\mu_{k}]\mu_{k}</annotation></semantics></math></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S1.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
