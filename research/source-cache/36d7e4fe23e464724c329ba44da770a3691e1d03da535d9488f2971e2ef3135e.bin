fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex24.m1.pic1.28" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(8.26,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex24.m1.pic1.29" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(3.46,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex24.m1.pic1.30" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS4.p4.2" class="ltx_p"><span id="S4.SS1.SSS4.p4.2.1" class="ltx_text">This intersection comes from the reduced ramification fiber.</span></p>
</div>
<div id="S4.SS1.SSS4.p5" class="ltx_para">
<p id="S4.SS1.SSS4.p5.1" class="ltx_p"><span id="S4.SS1.SSS4.p5.1.1" class="ltx_text">We already know from <a href="#S4.Thmthm5" title="Proposition 4.5. ‣ 4.1.2 Inequalities I. ‣ 4.1 Degree three analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.5</span></a> that <math id="S4.SS1.SSS4.p5.m1" class="ltx_Math" alttext="c(\Delta_{{\rm split}},{{\mathsf{Y}}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta_{{\rm split}},{{\mathsf{Y}}})\geq 0</annotation></semantics></math> and <math id="S4.SS1.SSS4.p5.m2" class="ltx_Math" alttext="c(\Delta_{{\rm ram}},{{\mathsf{Y}}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>ram</mi></msub><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta_{{\rm ram}},{{\mathsf{Y}}})\geq 0</annotation></semantics></math>. We conclude by <a href="#S4.Thmthm8" title="Corollary 4.8. ‣ 4.1.4 Inequalities II. ‣ 4.1 Degree three analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.8</span></a></span></p>
</div>
<div id="S4.SS1.SSS4.p6" class="ltx_para">
<p id="S4.SS1.SSS4.p6.1" class="ltx_p"><span id="S4.SS1.SSS4.p6.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="S4.SS1.SSS5" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.1.5 <math id="S4.SS1.SSS5.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-vertex divisors III.</h4>

<div id="S4.SS1.SSS5.p1" class="ltx_para">
<p id="S4.SS1.SSS5.p1.1" class="ltx_p">Now let us consider the case where a scheme <math id="S4.SS1.SSS5.p1.m1" class="ltx_Math" alttext="\{3p_{1}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{3p_{1}\}</annotation></semantics></math> is in the base locus of <math id="S4.SS1.SSS5.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|{\mathcal{O}}_{{\bf F}}(C)|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|{\mathcal{O}}_{{\bf F}}(C)|</annotation></semantics></math>, as in section <a href="#S2.SS12.SSS9" title="2.12.9 Variation on the basic construction II. ‣ 2.12 Constructions of partial pencils. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.12.9</span></a>.</p>
</div>
<div id="S4.SS1.SSS5.p2" class="ltx_para">
<p id="S4.SS1.SSS5.p2.1" class="ltx_p">We have two special fibers corresponding to intersections with divisors <math id="S4.SS1.SSS5.p2.m1" class="ltx_Math" alttext="\Delta_{{\rm split}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><annotation encoding="application/x-tex">\Delta_{{\rm split}}</annotation></semantics></math> and <math id="S4.SS1.SSS5.p2.m2" class="ltx_Math" alttext="\Delta_{{\rm ram}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>ram</mi></msub><annotation encoding="application/x-tex">\Delta_{{\rm ram}}</annotation></semantics></math>. We let <math id="S4.SS1.SSS5.p2.m3" class="ltx_Math" alttext="p^{\prime\prime}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mo>′′</mo></msup><annotation encoding="application/x-tex">p^{\prime\prime}</annotation></semantics></math> denote the resulting partial pencil.</p>
</div>
<div id="S4.Thmthm10" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm10.2" class="ltx_text ltx_font_bold">Proposition 4.10</span></span><span id="S4.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm10.p1" class="ltx_para">
<p id="S4.Thmthm10.p1.1" class="ltx_p"><span id="S4.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">The second modified partial pencil <math id="S4.Thmthm10.p1.m1" class="ltx_Math" alttext="p^{\prime\prime}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mo>′′</mo></msup><annotation encoding="application/x-tex">p^{\prime\prime}</annotation></semantics></math> has the following intersection numbers:</span></p>
<table id="S4.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex25.m1" class="ltx_Math" alttext="\displaystyle\lambda\cdot p^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\lambda\cdot p^{\prime\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex25.m2" class="ltx_Math" alttext="\displaystyle=g_{R}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=g_{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex26.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p^{\prime\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex26.m2" class="ltx_Math" alttext="\displaystyle=7g_{R}+5" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>+</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=7g_{R}+5</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex27.m1" class="ltx_Math" alttext="\displaystyle\Delta\cdot p^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\Delta\cdot p^{\prime\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex27.m2" class="ltx_Math" alttext="\displaystyle=-1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0em">=</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex28.m1" class="ltx_Math" alttext="\displaystyle\Delta_{{\rm split}}\cdot p^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{{\rm split}}\cdot p^{\prime\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex28.m2" class="ltx_Math" alttext="\displaystyle=1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex29.m1" class="ltx_Math" alttext="\displaystyle\Delta_{{\rm ram}}\cdot p^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>ram</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{{\rm ram}}\cdot p^{\prime\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex29.m2" class="ltx_Math" alttext="\displaystyle=1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex30.m1" class="ltx_Math" alttext="\displaystyle{\mathsf{X}}\cdot p^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><mi>𝖷</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle{\mathsf{X}}\cdot p^{\prime\prime}</annotation></semantics></math></td>
