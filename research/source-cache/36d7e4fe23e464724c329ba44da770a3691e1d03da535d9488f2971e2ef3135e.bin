<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex55.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex55.m2" class="ltx_Math" alttext="\displaystyle=v+6g_{R}+2" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>v</mi><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=v+6g_{R}+2</annotation></semantics></math></td>
