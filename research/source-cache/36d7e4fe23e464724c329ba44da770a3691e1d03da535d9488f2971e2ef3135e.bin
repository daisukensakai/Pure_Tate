container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex3.m1.pic1.24" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(27.46,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex3.m1.pic1.25" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(22.66,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex3.m1.pic1.26" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(17.86,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex3.m1.pic1.27" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(13.06,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex3.m1.pic1.28" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(8.26,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex3.m1.pic1.29" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(3.46,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex3.m1.pic1.30" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p3.3" class="ltx_p">As far as numerics go, we have:</p>
</div>
<div id="S4.Thmthm1" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm1.2" class="ltx_text ltx_font_bold">Proposition 4.1</span></span><span id="S4.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm1.p1" class="ltx_para">
<p id="S4.Thmthm1.p1.1" class="ltx_p"><span id="S4.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">The partial pencil <math id="S4.Thmthm1.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> constructed above has the following intersection numbers with various divisors:</span></p>
<table id="S4.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex4.m1" class="ltx_Math" alttext="\displaystyle\lambda\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\lambda\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex4.m2" class="ltx_Math" alttext="\displaystyle=g_{R}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=g_{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex5.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex5.m2" class="ltx_Math" alttext="\displaystyle=7g_{R}+3" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>+</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=7g_{R}+3</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex6.m1" class="ltx_Math" alttext="\displaystyle\Delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\Delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex6.m2" class="ltx_Math" alttext="\displaystyle=-1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0em">=</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex7.m1" class="ltx_Math" alttext="\displaystyle\Delta_{{\rm split}}\cdot p" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{{\rm split}}\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex7.m2" class="ltx_Math" alttext="\displaystyle=1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex8.m1" class="ltx_Math" alttext="\displaystyle{\mathsf{X}}\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>𝖷</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle{\mathsf{X}}\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex8.m2" class="ltx_Math" alttext="\displaystyle\geq 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\geq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.SSS1.p4" class="ltx_para">
<p id="S4.SS1.SSS1.p4.1" class="ltx_p"><span id="S4.SS1.SSS1.p4.1.1" class="ltx_text">We explain <math id="S4.SS1.SSS1.p4.m1" class="ltx_Math" alttext="\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\delta\cdot p</annotation></semantics></math> and <math id="S4.SS1.SSS1.p4.m2" class="ltx_Math" alttext="{\mathsf{X}}\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>𝖷</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">{\mathsf{X}}\cdot p</annotation></semantics></math> - the rest are clear. The original pencil <math id="S4.SS1.SSS1.p4.m3" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|{\mathcal{O}}_{{\bf F}}(C)|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|{\mathcal{O}}_{{\bf F}}(C)|</annotation></semantics></math> had <math id="S4.SS1.SSS1.p4.m4" class="ltx_Math" alttext="7g_{R}+6" display="inline" intent=":literal"><semantics><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>+</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">7g_{R}+6</annotation></semantics></math> nodes occurring in its total space. We must then add the contribution from the self intersection of the three gluing sections, each of which is <math id="S4.SS1.SSS1.p4.m5" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math>. This explains the total <math id="S4.SS1.SSS1.p4.m6" class="ltx_Math" alttext="7g_{R}+3" display="inline" intent=":literal"><semantics><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>+</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">7g_{R}+3</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS1.SSS1.p5" class="ltx_para">
<p id="S4.SS1.SSS1.p5.1" class="ltx_p"><span id="S4.SS1.SSS1.p5.1.1" class="ltx_text">The inequality <math id="S4.SS1.SSS1.p5.m1" class="ltx_Math" alttext="{\mathsf{X}}\cdot p\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖷</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\mathsf{X}}\cdot p\geq 0</annotation></semantics></math> follows form the observation that the deformations of the pencil <math id="S4.SS1.SSS1.p5.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> sweep out the entire boundary divisor <math id="S4.SS1.SSS1.p5.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> in which it lies. Since <math id="S4.SS1.SSS1.p5.m4" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S4.SS1.SSS1.p5.m5" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> are defined by taking closures, no higher boundary divisor can be a component of either. Therefore, <math id="S4.SS1.SSS1.p5.m6" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> must intersect both <math id="S4.SS1.SSS1.p5.m7" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S4.SS1.SSS1.p5.m8" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> nonnegatively.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm2" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm2.2" class="ltx_text ltx_font_italic">Remark 4.2</span></span><span id="S4.Thmthm2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmthm2.p1" class="ltx_para">
<p id="S4.Thmthm2.p1.1" class="ltx_p">The skeptical reader may wonder why the numbers occuring for the partial pencil <math id="S4.Thmthm2.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> in <a href="#S4.Thmthm1" title="Proposition 4.1. ‣ 4.1.1 
            
              2
            
          -vertex divisors I. ‣ 4.1 Degree three analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.1</span></a> differ from those of a “standard pencil” of genus <math id="S4.Thmthm2.p1.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> as in <a href="#S3.Thmthm11" title="Proposition 3.11. ‣ 3.9 Constructing families of trigonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.11</span></a>. The reason is that the partial pencil <math id="S4.Thmthm2.p1.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> above is not linearly equivalent to the standard pencil, as is evident by the fact that it intersects higher boundary divisors.</p>
</div>
</div>
</section>
<section id="S4.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.1.2 Inequalities I.</h4>

<div id="S4.SS1.SSS2.p1" class="ltx_para">
<p id="S4.SS1.SSS2.p1.1" class="ltx_p">Let <math id="S4.SS1.SSS2.p1.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> and <math id="S4.SS1.SSS2.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> be as in <a href="#S4.Thmthm1" title="Proposition 4.1. ‣ 4.1.1 
            
              2
            
          -vertex divisors I. ‣ 4.1 Degree three analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.1</span></a>.</p>
</div>
<div id="S4.Thmthm3" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm3.2" class="ltx_text ltx_font_bold">Lemma 4.3</span></span><span id="S4.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm3.p1" class="ltx_para">
<p id="S4.Thmthm3.p1.1" class="ltx_p"><span id="S4.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">We have the following inequality:</span></p>
<table id="S4.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E1.m1" class="ltx_Math" alttext="c(\Delta,{{\mathsf{Y}}})\geq c(\Delta_{{\rm split}},{{\mathsf{Y}}})+3g-6g_{R}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mo>−</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c(\Delta,{{\mathsf{Y}}})\geq c(\Delta_{{\rm split}},{{\mathsf{Y}}})+3g-6g_{R}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.1)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.SSS2.p2" class="ltx_para">
<p id="S4.SS1.SSS2.p2.1" class="ltx_p"><span id="S4.SS1.SSS2.p2.1.1" class="ltx_text">We intersect the partial pencil <math id="S4.SS1.SSS2.p2.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> with the equality <math id="S4.SS1.SSS2.p2.m2" class="ltx_Math" alttext="{\mathsf{X}}=a\lambda-b\delta-{{\mathsf{Y}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝖷</mi><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>−</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>−</mo><mi>𝖸</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{X}}=a\lambda-b\delta-{{\mathsf{Y}}}</annotation></semantics></math> and use <a href="#S4.Thmthm1" title="Proposition 4.1. ‣ 4.1.1 
            
              2
            
          -vertex divisors I. ‣ 4.1 Degree three analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.1</span></a>.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm4" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm4.2" class="ltx_text ltx_font_bold">Corollary 4.4</span></span><span id="S4.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm4.p1" class="ltx_para">
<p id="S4.Thmthm4.p1.1" class="ltx_p"><span id="S4.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">Keeping the same setting as above, assume <math id="S4.Thmthm4.p1.m1" class="ltx_Math" alttext="g_{R}\leq g_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>R</mi></msub><mo>≤</mo><msub><mi>g</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">g_{R}\leq g_{L}</annotation></semantics></math>. Then <math id="S4.Thmthm4.p1.m2" class="ltx_Math" alttext="c(\Delta_{{\rm split}},{{\mathsf{Y}}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta_{{\rm split}},{{\mathsf{Y}}})\geq 0</annotation></semantics></math> implies <math id="S4.Thmthm4.p1.m3" class="ltx_Math" alttext="c(\Delta,{{\mathsf{Y}}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta,{{\mathsf{Y}}})\geq 0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.SSS2.p3" class="ltx_para">
<p id="S4.SS1.SSS2.p3.1" class="ltx_p"><span id="S4.SS1.SSS2.p3.1.1" class="ltx_text">This follows from the previous lemma and the observation that <math id="S4.SS1.SSS2.p3.m1" class="ltx_Math" alttext="g_{R}+g_{L}=g-2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>R</mi></msub><mo>+</mo><msub><mi>g</mi><mi>L</mi></msub></mrow><mo>=</mo><mrow><mi>g</mi><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">g_{R}+g_{L}=g-2</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm5" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm5.2" class="ltx_text ltx_font_bold">Proposition 4.5</span></span><span id="S4.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm5.p1" class="ltx_para">
<p id="S4.Thmthm5.p1.1" class="ltx_p"><span id="S4.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">Keeping the same setting as the previous corollary, we have:</span></p>
<table id="S4.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex9.m1" class="ltx_Math" alttext="c(\Delta,{\mathsf{Y}})\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c(\Delta,{\mathsf{Y}})\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.SSS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.SSS2.p4" class="ltx_para">
<p id="S4.SS1.SSS2.p4.1" class="ltx_p"><span id="S4.SS1.SSS2.p4.1.1" class="ltx_text">Suppose <math id="S4.SS1.SSS2.p4.m1" class="ltx_Math" alttext="g_{R}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>R</mi></msub><annotation encoding="application/x-tex">g_{R}</annotation></semantics></math> is even. Then by repeatedly using corollary <a href="#S4.Thmthm4" title="Corollary 4.4. ‣ 4.1.2 Inequalities I. ‣ 4.1 Degree three analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>, we see: <span id="S4.SS1.SSS2.p4.1.1.1" class="ltx_text ltx_font_slanted">In order to deduce <math id="S4.SS1.SSS2.p4.m2" class="ltx_Math" alttext="c(\Delta,{\mathsf{Y}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta,{\mathsf{Y}})\geq 0</annotation></semantics></math> it suffices to show <math id="S4.SS1.SSS2.p4.m3" class="ltx_Math" alttext="c(\Delta_{0},{{\mathsf{Y}}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta_{0},{{\mathsf{Y}}})\geq 0</annotation></semantics></math> for the boundary divisor <math id="S4.SS1.SSS2.p4.m4" class="ltx_Math" alttext="\Delta_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\Delta_{0}</annotation></semantics></math> which has the dual graph <math id="S4.SS1.SSS2.p4.m5" class="ltx_Math" alttext="\Gamma_{\Delta_{0}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">\Gamma_{\Delta_{0}}</annotation></semantics></math></span>:</span></p>
<table id="S4.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S4.Ex10.m1.pic1" class="ltx_picture ltx_markedasmath" height="31.29" overflow="visible" style="vertical-align:-16.481772454856788px" version="1.1" viewBox="23.46 16.48 125.02 31.29" width="125.02"><g transform="matrix(1 0 0 -1 23.457068072095094 31.287611743235004) translate(0,3.46) translate(23.46,0)"><g transform="translate(-3.46,0) translate(0,-3.07)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:10pt;" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 6.15)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex10.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{\bullet}" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\textstyle{\bullet}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(-22.56,0) translate(0,7.87) translate(4.15,0) translate(0,-1.39)"><foreignObject style="--ltx-fo-width:0.95em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.56" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="13.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex10.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{\scriptstyle v_{L}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">v</mi><mi mathsize="0.710em">L</mi></msub><annotation encoding="application/x-tex">\textstyle{\scriptstyle v_{L}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(-23.46,0) translate(0,-8.27) translate(4.15,0) translate(0,-2.18)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.45em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.13" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="14.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex10.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{\scriptstyle g-2}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">g</mi><mo mathsize="0.700em">−</mo><mn mathsize="0.700em">2</mn></mrow><annotation encoding="application/x-tex">\textstyle{\scriptstyle g-2}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(75.28,0) translate(0,-3.07)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:10pt;" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 6.15)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex10.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\bullet}" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\textstyle{\bullet}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(79.55,0) translate(0,7.87) translate(4.15,0) translate(0,-1.39)"><foreignObject style="--ltx-fo-width:0.99em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.56" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="13.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex10.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{\scriptstyle v_{R}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">v</mi><mi mathsize="0.710em">R</mi></msub><annotation encoding="application/x-tex">\textstyle{\scriptstyle v_{R}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(83.64,0) translate(0,-7.87) translate(4.15,0) translate(0,-3.12)"><foreignObject style="--ltx-fo-width:0.4em;--ltx-fo-height:0.45em;--ltx-fo-depth:0em;font-size:10pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="5.52"><span class="ltx_foreignobject_container"><span class=