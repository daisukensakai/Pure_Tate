<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex50.m1" class="ltx_Math" alttext="\displaystyle{{\mathsf{X}}}\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>𝖷</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle{{\mathsf{X}}}\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex50.m2" class="ltx_Math" alttext="\displaystyle\geq 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\geq 0</annotation></semantics></math></td>
