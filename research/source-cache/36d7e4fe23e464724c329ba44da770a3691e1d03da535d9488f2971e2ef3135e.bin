gnObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.46" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(65.87,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.47" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(61.07,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.48" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(56.27,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.49" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(51.47,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.50" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(46.67,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.51" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(41.86,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.52" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(37.06,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.53" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(32.26,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.54" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(27.46,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.55" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(22.66,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.56" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(17.86,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.57" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(13.06,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.58" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(8.26,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.59" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(3.46,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex78.m1.pic1.60" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S4.SS4.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.4.2 </h4>

<div id="S4.SS4.SSS2.p1" class="ltx_para">
<p id="S4.SS4.SSS2.p1.1" class="ltx_p">Recall the construction of pentagonal families found in section <a href="#S3.SS12.SSS2" title="3.12.2 Constructing families of pentagonal curves II. ‣ 3.12 Constructing families of pentagonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.12.2</span></a>. We had the genus <math id="S4.SS4.SSS2.p1.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> fibration</p>
<table id="S4.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex79.m1" class="ltx_Math" alttext="{\bf F}\subset{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})\longrightarrow{\bf P}^{1}_{s}" display="block" intent=":literal"><semantics><mrow><mi>𝐅</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover><mo lspace="0em" movablelimits="false">⋀</mo><mn>2</mn></mover><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">{\bf F}\subset{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})\longrightarrow{\bf P}^{1}_{s}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p1.2" class="ltx_p">on which we considered the linear system <math id="S4.SS4.SSS2.p1.m2" class="ltx_Math" alttext="|H_{1}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|H_{1}|</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.SSS2.p2" class="ltx_para">
<p id="S4.SS4.SSS2.p2.1" class="ltx_p">The surface <math id="S4.SS4.SSS2.p2.m1" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> is a complete intersection of five relative hyperplane divisors <math id="S4.SS4.SSS2.p2.m2" class="ltx_Math" alttext="H_{2},...,H_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>H</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">H_{2},...,H_{6}</annotation></semantics></math> having divisor classes <math id="S4.SS4.SSS2.p2.m3" class="ltx_Math" alttext="\zeta+k_{2}f,...,\zeta+k_{6}f" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mn>6</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta+k_{2}f,...,\zeta+k_{6}f</annotation></semantics></math> in the scroll <math id="S4.SS4.SSS2.p2.m4" class="ltx_Math" alttext="{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})\longrightarrow{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})\longrightarrow{\bf P}^{1}_{s}</annotation></semantics></math>. Therefore <math id="S4.SS4.SSS2.p2.m5" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> spans a <math id="S4.SS4.SSS2.p2.m6" class="ltx_Math" alttext="{\bf P}^{4}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>4</mn></msup><annotation encoding="application/x-tex">{\bf P}^{4}</annotation></semantics></math>-bundle subscroll <math id="S4.SS4.SSS2.p2.m7" class="ltx_Math" alttext="{\bf P}({\mathcal{E}}_{{\bf F}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}({\mathcal{E}}_{{\bf F}})</annotation></semantics></math>, in which the fibers of <math id="S4.SS4.SSS2.p2.m8" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> are degree five elliptic normal curves in <math id="S4.SS4.SSS2.p2.m9" class="ltx_Math" alttext="{\bf P}^{4}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>4</mn></msup><annotation encoding="application/x-tex">{\bf P}^{4}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS4.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.4.3 </h4>

<div id="S4.SS4.SSS3.p1" class="ltx_para">
<p id="S4.SS4.SSS3.p1.1" class="ltx_p">The rank <math id="S4.SS4.SSS3.p1.m1" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> vector bundle <math id="S4.SS4.SSS3.p1.m2" class="ltx_Math" alttext="{\mathcal{E}}_{{\bf F}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐅</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{{\bf F}}</annotation></semantics></math> is defined by a sequence on <math id="S4.SS4.SSS3.p1.m3" class="ltx_Math" alttext="{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{s}</annotation></semantics></math>:</p>
<table id="S4.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex80.m1" class="ltx_Math" alttext="0\longrightarrow\bigoplus_{i=2}^{6}{\mathcal{O}}(-k_{i})\longrightarrow\bigwedge^{2}{\mathcal{F}}^{\vee}\longrightarrow{\mathcal{E}}_{{\bf F}}\longrightarrow 0." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo rspace="0.111em" stretchy="false">⟶</mo><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mn>6</mn></munderover><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>k</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em" stretchy="false">⟶</mo><mrow><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">⟶</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐅</mi></msub><mo stretchy="false">⟶</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\longrightarrow\bigoplus_{i=2}^{6}{\mathcal{O}}(-k_{i})\longrightarrow\bigwedge^{2}{\mathcal{F}}^{\vee}\longrightarrow{\mathcal{E}}_{{\bf F}}\longrightarrow 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS3.p2" class="ltx_para">
<p id="S4.SS4.SSS3.p2.1" class="ltx_p">Picking a general pencil <math id="S4.SS4.SSS3.p2.m1" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|H_{1}|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|H_{1}|</annotation></semantics></math> on the surface <math id="S4.SS4.SSS3.p2.m2" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> is then equivalent to varying an inclusion <math id="S4.SS4.SSS3.p2.m3" class="ltx_Math" alttext="{\mathcal{O}}(-k_{1})\hookrightarrow{\mathcal{E}}_{{\bf F}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐅</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(-k_{1})\hookrightarrow{\mathcal{E}}_{{\bf F}}</annotation></semantics></math> with the parameter <math id="S4.SS4.SSS3.p2.m4" class="ltx_Math" alttext="t\in{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">t\in{\bf P}^{1}_{t}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS4.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.4.4 </h4>

<div id="S4.SS4.SSS4.p1" class="ltx_para">
<p id="S4.SS4.SSS4.p1.1" class="ltx_p">Put differently, a general pencil <math id="S4.SS4.SSS4.p1.m1" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|H_{1}|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|H_{1}|</annotation></semantics></math> is the same as a sequence of vector bundles on <math id="S4.SS4.SSS4.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}_{t}\times{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\times{\bf P}^{1}_{s}</annotation></semantics></math>:</p>
<table id="S4.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E9.m1" class="ltx_Math" alttext="0\longrightarrow{\mathcal{O}}(-k_{1}R_{s}-R_{t})\longrightarrow f_{s}^{*}{\mathcal{E}}_{{\bf F}}\longrightarrow{\mathcal{W}}\longrightarrow 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">⟶</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo>−</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mrow><msubsup><mi>f</mi><mi>s</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐅</mi></msub></mrow><mo stretchy="false">⟶</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">⟶</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\longrightarrow{\mathcal{O}}(-k_{1}R_{s}-R_{t})\longrightarrow f_{s}^{*}{\mathcal{E}}_{{\bf F}}\longrightarrow{\mathcal{W}}\longrightarrow 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.9)</span></td></tr></tbody>
</table>
<p id="S4.SS4.SSS4.p1.2" class="ltx_p">where <math id="S4.SS4.SSS4.p1.m3" class="ltx_Math" alttext="f_{s},f_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>s</mi></msub><mo>,</mo><msub><mi>f</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">f_{s},f_{t}</annotation></semantics></math> are respective projections to <math id="S4.SS4.SSS4.p1.m4" class="ltx_Math" alttext="{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{t}</annotation></semantics></math> and <math id="S4.SS4.SSS4.p1.m5" class="ltx_Math" alttext="{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{s}</annotation></semantics></math> and <math id="S4.SS4.SSS4.p1.m6" class="ltx_Math" alttext="R_{s}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>s</mi></msub><annotation encoding="application/x-tex">R_{s}</annotation></semantics></math> and <math id="S4.SS4.SSS4.p1.m7" class="ltx_Math" alttext="R_{t}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>t</mi></msub><annotation encoding="application/x-tex">R_{t}</annotation></semantics></math> are ruling lines parametrized by <math id="S4.SS4.SSS4.p1.m8" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and <math id="S4.SS4.SSS4.p1.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.SSS4.p2" class="ltx_para">
<p id="S4.SS4.SSS4.p2.1" class="ltx_p">The vector bundle <math id="S4.SS4.SSS4.p2.m1" class="ltx_Math" alttext="{\mathcal{W}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">{\mathcal{W}}</annotation></semantics></math> restricts for all <math id="S4.SS4.SSS4.p2.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> to <math id="S4.SS4.SSS4.p2.m3" class="ltx_Math" alttext="{\mathcal{W}}_{t}={\mathcal{E}}_{\alpha_{t}}\otimes\det{\mathcal{E}}_{\alpha_{t}}^{\vee}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>α</mi><mi>t</mi></msub></msub><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" rspace="0.167em">det</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>α</mi><mi>t</mi></msub><mo>∨</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{W}}_{t}={\mathcal{E}}_{\alpha_{t}}\otimes\det{\mathcal{E}}_{\alpha_{t}}^{\vee}</annotation></semantics></math>, where <math id="S4.SS4.SSS4.p2.m4" class="ltx_Math" alttext="\alpha_{t}{\colon}C_{t}\longrightarrow{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>t</mi></msub><mo stretchy="false">⟶</mo><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}{\colon}C_{t}\longrightarrow{\bf P}^{1}_{s}</annotation></semantics></math> is the degree five branched cover parametrized by <math id="S4.SS4.SSS4.p2.m5" class="ltx_Math" alttext="t\in{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">t\in{\bf P}^{1}_{t}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.SSS4.p3" class="ltx_para">
<p id="S4.SS4.SSS4.p3.1" class="ltx_p">Note that <math id="S4.SS4.SSS4.p3.m1" class="ltx_Math" alttext="k_{1}=\lceil\frac{5(g_{R}+4)}{6}\rceil" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mfrac><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mi>R</mi></msub><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>6</mn></mfrac><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">k_{1}=\lceil\frac{5(g_{R}+4)}{6}\rceil</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS4.SSS5" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.4.5 </h4>

<div id="S4.SS4.SSS5.p1" class="ltx_para">
<p id="S4.SS4.SSS5.p1.1" class="ltx_p">Let <math id="S4.SS4.SSS5.p1.m1" class="ltx_Math" alttext="{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{t}</annotation></semantics></math> be a general genus <math id="S4.SS4.SSS5.p1.m2" class="ltx_Math" alttext="g_{R}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>R</mi></msub><annotation encoding="application/x-tex">g_{R}</annotation></semantics></math> pencil <math id="S4.SS4.SSS5.p1.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> in <math id="S4.SS4.SSS5.p1.m4" class="ltx_Math" alttext="|H_{1}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|H_{1}|</annotation></semantics></math> with <math id="S4.SS4.SSS5.p1.m5" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> distinct basepoints imposed in a fiber <math id="S4.SS4.SSS5.p1.m6" class="ltx_Math" alttext="F\subset{\bf F}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⊂</mo><mi>𝐅</mi></mrow><annotation encoding="application/x-tex">F\subset{\bf F}</annotation></semantics></math>. We denote by</p>
<table id="S4.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex81.m1" class="ltx_Math" alttext="\alpha{\colon}{\mathcal{C}}_{L}\cup{\mathcal{C}}_{R}\longrightarrow{\mathcal{P}}_{L}\cup{\mathcal{P}}_{R}" display="block" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>L</mi></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>R</mi></msub></mrow><mo stretchy="false">⟶</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>L</mi></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>R</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha{\colon}{\mathcal{C}}_{L}\cup{\mathcal{C}}_{R}\longrightarrow{\mathcal{P}}_{L}\cup{\mathcal{P}}_{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS5.p1.2" class="ltx_p">the ensuing partial pencil whose variation is given by <math id="S4.SS4.SSS5.p1.m7" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|H_{1}|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|H_{1}|</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.SSS5.p2" class="ltx_para">
<p id="S4.SS4.SSS5.p2.1" class="ltx_p">The difficulty with using a pencil <math id="S4.SS4.SSS5.p2.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> as constructed above to prove <a href="#S3.Thmthm7" title="Theorem 3.7 (Key result for ). ‣ 3.7 The key result. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.7</span></a> is that we need to calculate the intersection of <math id="S4.SS4.SSS5.p2.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> with the Maroni divisor <math id="S4.SS4.SSS5.p2.m3" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS4.SSS6" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.4.6 Maroni special curves in <math id="S4.SS4.SSS6.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>.</h4>

<div id="S4.SS4.SSS6.p1" class="ltx_para">
<p id="S4.SS4.SSS6.p1.1" class="ltx_p">In this section, let <math id="S4.SS4.SSS6.p1.m1" class="ltx_Math" alttext="\beta{\colon}C_{L}\cup C_{R}\longrightarrow P_{L}\cup P_{R}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>C</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>C</mi><mi>R</mi></msub></mrow><mo stretchy="false">⟶</mo><mrow><msub><mi>P</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>P</mi><mi>R</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta{\colon}C_{L}\cup C_{R}\longrightarrow P_{L}\cup P_{R}</annotation></semantics></math> be a curve in <math id="S4.SS4.SSS6.p1.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>. In particular, there is no ramification occurring above the node <math id="S4.SS4.SSS6.p1.m3" class="ltx_Math" alttext="x=P_{L}\cap P_{R}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><msub><mi>P</mi><mi>L</mi></msub><mo>∩</mo><msub><mi>P</mi><mi>R</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x=P_{L}\cap P_{R}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.SSS6.p2" class="ltx_para">
<p id="S4.SS4.SSS6.p2.1" class="ltx_p">The Tschirnhausen bundles <math id="S4.SS4.SSS6.p2.m1" class="ltx_Math" alttext="{\mathcal{E}}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{L}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p2.m2" class="ltx_Math" alttext="{\mathcal{E}}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{R}</annotation></semantics></math> glue together to form <math id="S4.SS4.SSS6.p2.m3" class="ltx_Math" alttext="{\mathcal{E}}_{\beta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\beta}</annotation></semantics></math>. In particular, the scroll <math id="S4.SS4.SSS6.p2.m4" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}_{\beta}</annotation></semantics></math> is created by gluing <math id="S4.SS4.SSS6.p2.m5" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}_{L}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}_{L}</annotation></semantics></math> to <math id="S4.SS4.SSS6.p2.m6" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}_{R}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}_{R}</annotation></semantics></math> along the <math id="S4.SS4.SSS6.p2.m7" class="ltx_Math" alttext="{\bf P}^{3}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>3</mn></msup><annotation encoding="application/x-tex">{\bf P}^{3}</annotation></semantics></math> lying over the node <math id="S4.SS4.SSS6.p2.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm27" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm27.2" class="ltx_text ltx_font_bold">Definition 4.27</span></span><span id="S4.Thmthm27.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm27.p1" class="ltx_para">
<p id="S4.Thmthm27.p1.1" class="ltx_p">Let <math id="S4.Thmthm27.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}={\mathcal{O}}(k)^{\oplus m}\oplus{\mathcal{O}}(k+1)^{\oplus n}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>m</mi></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>n</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}={\mathcal{O}}(k)^{\oplus m}\oplus{\mathcal{O}}(k+1)^{\oplus n}</annotation></semantics></math> be a balanced vector bundle on <math id="S4.Thmthm27.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>. The <span id="S4.Thmthm27.p1.1.1" class="ltx_text ltx_font_slanted">directrix</span> of <math id="S4.Thmthm27.p1.m3" class="ltx_Math" alttext="{\bf P}{\mathcal{A}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{A}}</annotation></semantics></math> is the subscroll associated to the surjection <math id="S4.Thmthm27.p1.m4" class="ltx_Math" alttext="{\mathcal{A}}\twoheadrightarrow{\mathcal{O}}(k)^{\oplus m}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">↠</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>m</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}\twoheadrightarrow{\mathcal{O}}(k)^{\oplus m}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.SS4.SSS6.p3" class="ltx_para">
<p id="S4.SS4.SSS6.p3.1" class="ltx_p">Now assume <math id="S4.SS4.SSS6.p3.m1" class="ltx_Math" alttext="{\mathcal{E}}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{L}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p3.m2" class="ltx_Math" alttext="{\mathcal{E}}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{R}</annotation></semantics></math> are each balanced. Then each scroll <math id="S4.SS4.SSS6.p3.m3" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}_{L}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}_{L}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p3.m4" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}_{R}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}_{R}</annotation></semantics></math> has its directrix subscroll <math id="S4.SS4.SSS6.p3.m5" class="ltx_Math" alttext="\Sigma_{L}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\Sigma_{L}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p3.m6" class="ltx_Math" alttext="\Sigma_{R}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\Sigma_{R}</annotation></semantics></math> which, due to the assumption <math id="S4.SS4.SSS6.p3.m7" class="ltx_Math" alttext="4\mid g" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo fence="false">|</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">4\mid g</annotation></semantics></math>, have “complementary” rank, i.e. the dimension of the fibers of <math id="S4.SS4.SSS6.p3.m8" class="ltx_Math" alttext="\Sigma_{L}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\Sigma_{L}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p3.m9" class="ltx_Math" alttext="\Sigma_{R}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\Sigma_{R}</annotation></semantics></math> add to <math id="S4.SS4.SSS6.p3.m10" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm28" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm28.2" class="ltx_text ltx_font_bold">Theorem 4.28</span></span><span id="S4.Thmthm28.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm28.p1" class="ltx_para">
<p id="S4.Thmthm28.p1.1" class="ltx_p"><span id="S4.Thmthm28.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm28.p1.m1" class="ltx_Math" alttext="\beta\in\Delta" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">\beta\in\Delta</annotation></semantics></math> be such that <math id="S4.Thmthm28.p1.m2" class="ltx_Math" alttext="{\mathcal{E}}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{L}</annotation></semantics></math> and <math id="S4.Thmthm28.p1.m3" class="ltx_Math" alttext="{\mathcal{E}}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{R}</annotation></semantics></math> are both balanced. Then <math id="S4.Thmthm28.p1.m4" class="ltx_Math" alttext="\beta\in{\mathsf{M}}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mi>𝖬</mi></mrow><annotation encoding="application/x-tex">\beta\in{\mathsf{M}}</annotation></semantics></math> if and only if the directrices <math id="S4.Thmthm28.p1.m5" class="ltx_Math" alttext="\Sigma_{L}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\Sigma_{L}</annotation></semantics></math> and <math id="S4.Thmthm28.p1.m6" class="ltx_Math" alttext="\Sigma_{R}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\Sigma_{R}</annotation></semantics></math> intersect nontrivially.</span></p>
</div>
<div id="S4.Thmthm28.p2" class="ltx_para">
<p id="S4.Thmthm28.p2.1" class="ltx_p"><span id="S4.Thmthm28.p2.1.1" class="ltx_text ltx_font_italic">More generally, let <math id="S4.Thmthm28.p2.m1" class="ltx_Math" alttext="\beta_{t}{\colon}{\mathcal{C}}_{L,t}\cup{\mathcal{C}}_{R,t}\longrightarrow{\mathcal{P}}_{L,t}\cup{\mathcal{P}}_{R,t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">⟶</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}{\colon}{\mathcal{C}}_{L,t}\cup{\mathcal{C}}_{R,t}\longrightarrow{\mathcal{P}}_{L,t}\cup{\mathcal{P}}_{R,t}</annotation></semantics></math> be a family of <math id="S4.Thmthm28.p2.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-component covers parameterized by a map <math id="S4.Thmthm28.p2.m3" class="ltx_Math" alttext="\varphi{\colon}{\text{\rm Spec}\,}k[[t]]\longrightarrow\Delta" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mtext>Spec</mtext><mo lspace="0.170em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">⟶</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><annotation encoding="application/x-tex">\varphi{\colon}{\text{\rm Spec}\,}k[[t]]\longrightarrow\Delta</annotation></semantics></math>, with <math id="S4.Thmthm28.p2.m4" class="ltx_Math" alttext="x(t)={\mathcal{P}}_{L,t}\cap{\mathcal{P}}_{R,t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">x(t)={\mathcal{P}}_{L,t}\cap{\mathcal{P}}_{R,t}</annotation></semantics></math> the family of nodes, such that</span></p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="{\mathcal{E}}_{L,t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{L,t}</annotation></semantics></math><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="{\mathcal{E}}_{R,t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{R,t}</annotation></semantics></math><span id="S4.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">, the two components of </span><math id="S4.I1.i1.p1.m3" class="ltx_Math" alttext="{\mathcal{E}}_{\beta_{t}}," display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{\beta_{t}},</annotation></semantics></math><span id="S4.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> are balanced for all </span><math id="S4.I1.i1.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="S4.I1.i1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">The total spaces of the family of directrices </span><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="\Sigma_{L,t}\subset{\bf P}{\mathcal{E}}_{L,t}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>⊂</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{L,t}\subset{\bf P}{\mathcal{E}}_{L,t}</annotation></semantics></math><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="\Sigma_{R,t}\subset{\bf P}{\mathcal{E}}_{R,t}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>⊂</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{R,t}\subset{\bf P}{\mathcal{E}}_{R,t}</annotation></semantics></math><span id="S4.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> meet at a zero dimensional scheme supported above </span><math id="S4.I1.i2.p1.m3" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math><span id="S4.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S4.Thmthm28.p2.2" class="ltx_p"><span id="S4.Thmthm28.p2.2.1" class="ltx_text ltx_font_italic">Then:</span></p>
<table id="S4.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex82.m1" class="ltx_Math" alttext="\deg\varphi^{-1}({\mathsf{M}})={\rm length}\left(\Sigma_{L,t}\cap\Sigma_{R,t}\cap{\bf P}({\mathcal{E}}_{\beta_{t}}|_{x(t)})\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msup><mi>φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>length</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∩</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∩</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo stretchy="false">|</mo></mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\deg\varphi^{-1}({\mathsf{M}})={\rm length}\left(\Sigma_{L,t}\cap\Sigma_{R,t}\cap{\bf P}({\mathcal{E}}_{\beta_{t}}|_{x(t)})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.Thmthm29" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm29.2" class="ltx_text ltx_font_italic">Remark 4.29</span></span><span id="S4.Thmthm29.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmthm29.p1" class="ltx_para">
<p id="S4.Thmthm29.p1.1" class="ltx_p">The theorem’s content comes from the fact that the Maroni divisor <math id="S4.Thmthm29.p1.m1" class="ltx_Math" alttext="{\mathsf{M}}\subset\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><mrow><mi>𝖬</mi><mo>⊂</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\mathsf{M}}\subset\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> is defined by taking a <span id="S4.Thmthm29.p1.1.1" class="ltx_text ltx_font_slanted">closure</span>, which means that one must be careful when analyzing it in the boundary. Furthermore, the theorem is true for any degree <math id="S4.Thmthm29.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, as will be apparent in the proof.</p>
</div>
</div>
<div id="S4.SS4.SSS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS4.SSS6.p4" class="ltx_para">
<p id="S4.SS4.SSS6.p4.1" class="ltx_p"><span id="S4.SS4.SSS6.p4.1.1" class="ltx_text">The first statement is straightforward: one checks that <math id="S4.SS4.SSS6.p4.m1" class="ltx_Math" alttext="h^{1}({\rm End\,}{\mathcal{E}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>End</mi><mo lspace="0.170em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{1}({\rm End\,}{\mathcal{E}})=0</annotation></semantics></math> if and only if the directrices do not meet. Then we conclude by semicontinuity.</span></p>
</div>
<div id="S4.SS4.SSS6.p5" class="ltx_para">
<p id="S4.SS4.SSS6.p5.1" class="ltx_p"><span id="S4.SS4.SSS6.p5.1.1" class="ltx_text">The second statement is not immediate. We must understand how to interpret the Maroni divisor <math id="S4.SS4.SSS6.p5.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>, which is defined by taking a closure, near the point <math id="S4.SS4.SSS6.p5.m2" class="ltx_math_unparsed" alttext="[\beta{\colon}C_{L}\cup C_{R}\longrightarrow P_{L}\cup P_{R}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>β</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>C</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>C</mi><mi>R</mi></msub><mo stretchy="false">⟶</mo><msub><mi>P</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>P</mi><mi>R</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\beta{\colon}C_{L}\cup C_{R}\longrightarrow P_{L}\cup P_{R}]</annotation></semantics></math> in the boundary <math id="S4.SS4.SSS6.p5.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>.
For this, let <math id="S4.SS4.SSS6.p5.m4" class="ltx_Math" alttext="(B,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(B,0)</annotation></semantics></math> denote a versal deformation space of <math id="S4.SS4.SSS6.p5.m5" class="ltx_Math" alttext="[\beta]\in\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>β</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">[\beta]\in\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math>, and let <math id="S4.SS4.SSS6.p5.m6" class="ltx_Math" alttext="\pi{\colon}{\mathcal{P}}_{B}\longrightarrow B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>B</mi></msub><mo stretchy="false">⟶</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi{\colon}{\mathcal{P}}_{B}\longrightarrow B</annotation></semantics></math> denote the versal family of targets. So <math id="S4.SS4.SSS6.p5.m7" class="ltx_Math" alttext="\pi^{-1}(0)=P_{L}\cup P_{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>P</mi><mi>R</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\pi^{-1}(0)=P_{L}\cup P_{R}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS6.p6" class="ltx_para">
<p id="S4.SS4.SSS6.p6.1" class="ltx_p"><span id="S4.SS4.SSS6.p6.1.1" class="ltx_text">We continue to let <math id="S4.SS4.SSS6.p6.m1" class="ltx_Math" alttext="\Delta\subset B" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⊂</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\Delta\subset B</annotation></semantics></math> and <math id="S4.SS4.SSS6.p6.m2" class="ltx_Math" alttext="{\mathsf{M}}\subset B" display="inline" intent=":literal"><semantics><mrow><mi>𝖬</mi><mo>⊂</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">{\mathsf{M}}\subset B</annotation></semantics></math> denote the local boundary divisor and Maroni divisor in the versal space <math id="S4.SS4.SSS6.p6.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS6.p7" class="ltx_para">
<p id="S4.SS4.SSS6.p7.1" class="ltx_p"><span id="S4.SS4.SSS6.p7.1.1" class="ltx_text">Over <math id="S4.SS4.SSS6.p7.m1" class="ltx_Math" alttext="{\mathcal{P}}_{B}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>B</mi></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{B}</annotation></semantics></math> we have the versal Tschirnhausen bundle <math id="S4.SS4.SSS6.p7.m2" class="ltx_Math" alttext="{\mathcal{E}}_{\rm versal}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\rm versal}</annotation></semantics></math>. Pick smooth points <math id="S4.SS4.SSS6.p7.m3" class="ltx_Math" alttext="s_{L}\in P_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>L</mi></msub><mo>∈</mo><msub><mi>P</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">s_{L}\in P_{L}</annotation></semantics></math> <math id="S4.SS4.SSS6.p7.m4" class="ltx_Math" alttext="s_{R}\in P_{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>R</mi></msub><mo>∈</mo><msub><mi>P</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">s_{R}\in P_{R}</annotation></semantics></math> and extend them to sections <math id="S4.SS4.SSS6.p7.m5" class="ltx_Math" alttext="\sigma_{L},\sigma_{R}\subset{\mathcal{P}}_{B}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>L</mi></msub><mo>,</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>B</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sigma_{L},\sigma_{R}\subset{\mathcal{P}}_{B}</annotation></semantics></math>. (There are no obstructions to extending.) By assumption <math id="S4.SS4.SSS6.p7.m6" class="ltx_Math" alttext="{\mathcal{E}}_{\beta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\beta}</annotation></semantics></math> restricts as <math id="S4.SS4.SSS6.p7.m7" class="ltx_Math" alttext="{\mathcal{O}}(a)^{\oplus r}\oplus{\mathcal{O}}(a-1)^{\oplus 4-r}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>r</mi></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mn>4</mn></mrow><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(a)^{\oplus r}\oplus{\mathcal{O}}(a-1)^{\oplus 4-r}</annotation></semantics></math> on <math id="S4.SS4.SSS6.p7.m8" class="ltx_Math" alttext="P_{L}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>L</mi></msub><annotation encoding="application/x-tex">P_{L}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p7.m9" class="ltx_Math" alttext="{\mathcal{O}}(b)^{\oplus 4-r}\oplus{\mathcal{O}}(b-1)^{\oplus r}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mn>4</mn></mrow><mo>−</mo><mi>r</mi></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>r</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(b)^{\oplus 4-r}\oplus{\mathcal{O}}(b-1)^{\oplus r}</annotation></semantics></math> on <math id="S4.SS4.SSS6.p7.m10" class="ltx_Math" alttext="P_{R}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>R</mi></msub><annotation encoding="application/x-tex">P_{R}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS6.p8" class="ltx_para">
<p id="S4.SS4.SSS6.p8.1" class="ltx_p"><span id="S4.SS4.SSS6.p8.1.1" class="ltx_text">Now we twist <math id="S4.SS4.SSS6.p8.m1" class="ltx_Math" alttext="{\mathcal{E}}_{\rm versal}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\rm versal}</annotation></semantics></math> down by the line bundle <math id="S4.SS4.SSS6.p8.m2" class="ltx_Math" alttext="{\mathcal{O}}_{{\mathcal{P}}_{B}}(a\sigma_{L}+b\sigma_{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>B</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>L</mi></msub></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{{\mathcal{P}}_{B}}(a\sigma_{L}+b\sigma_{R})</annotation></semantics></math> to get a bundle <math id="S4.SS4.SSS6.p8.m3" class="ltx_Math" alttext="{\mathcal{E}}^{\prime}_{{\rm versal}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{E}}^{\prime}_{{\rm versal}}</annotation></semantics></math> such that <math id="S4.SS4.SSS6.p8.m4" class="ltx_Math" alttext="{\mathcal{E}}^{\prime}_{{\rm versal}}|_{0}:={\mathcal{E}}^{\prime}_{{\rm versal}}|_{P_{L}\cup P_{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>:=</mo><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mrow><msub><mi>P</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>P</mi><mi>R</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathcal{E}}^{\prime}_{{\rm versal}}|_{0}:={\mathcal{E}}^{\prime}_{{\rm versal}}|_{P_{L}\cup P_{R}}</annotation></semantics></math> restricts to <math id="S4.SS4.SSS6.p8.m5" class="ltx_Math" alttext="{\mathcal{A}}_{L}:={\mathcal{O}}^{\oplus r}\oplus{\mathcal{O}}(-1)^{\oplus 4-r}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>L</mi></msub><mo>:=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>⊕</mo><mi>r</mi></mrow></msup><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mn>4</mn></mrow><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{L}:={\mathcal{O}}^{\oplus r}\oplus{\mathcal{O}}(-1)^{\oplus 4-r}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p8.m6" class="ltx_Math" alttext="{\mathcal{A}}_{R}:={\mathcal{O}}^{\oplus 4-r}\oplus{\mathcal{O}}(-1)^{\oplus r}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>R</mi></msub><mo>:=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mrow><mo>⊕</mo><mn>4</mn></mrow><mo>−</mo><mi>r</mi></mrow></msup><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{R}:={\mathcal{O}}^{\oplus 4-r}\oplus{\mathcal{O}}(-1)^{\oplus r}</annotation></semantics></math> on <math id="S4.SS4.SSS6.p8.m7" class="ltx_Math" alttext="P_{L}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>L</mi></msub><annotation encoding="application/x-tex">P_{L}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p8.m8" class="ltx_Math" alttext="P_{R}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>R</mi></msub><annotation encoding="application/x-tex">P_{R}</annotation></semantics></math> respectively.</span></p>
</div>
<div id="S4.SS4.SSS6.p9" class="ltx_para">
<p id="S4.SS4.SSS6.p9.1" class="ltx_p"><span id="S4.SS4.SSS6.p9.1.1" class="ltx_text">Take the exact sequence on <math id="S4.SS4.SSS6.p9.m1" class="ltx_Math" alttext="{\mathcal{P}}_{B}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>B</mi></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{B}</annotation></semantics></math></span></p>
<table id="S4.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex83.m1" class="ltx_Math" alttext="0\longrightarrow{\mathcal{E}}^{\prime}_{{\rm versal}}\longrightarrow{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})\longrightarrow{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})|_{\sigma_{L}}\longrightarrow 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">⟶</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">⟶</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">+</mo><msub><mi>σ</mi><mi>L</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><msub><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">+</mo><msub><mi>σ</mi><mi>L</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msub><mi>σ</mi><mi>L</mi></msub></msub><mo stretchy="false">⟶</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\longrightarrow{\mathcal{E}}^{\prime}_{{\rm versal}}\longrightarrow{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})\longrightarrow{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})|_{\sigma_{L}}\longrightarrow 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS6.p9.2" class="ltx_p"><span id="S4.SS4.SSS6.p9.2.1" class="ltx_text">and push it down via <math id="S4.SS4.SSS6.p9.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>. Since <math id="S4.SS4.SSS6.p9.m3" class="ltx_Math" alttext="{\mathcal{E}}^{\prime}_{{\rm versal}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{E}}^{\prime}_{{\rm versal}}</annotation></semantics></math> restricts on the generic fiber of <math id="S4.SS4.SSS6.p9.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> to <math id="S4.SS4.SSS6.p9.m5" class="ltx_Math" alttext="{\mathcal{O}}(-1)^{\oplus 4}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(-1)^{\oplus 4}</annotation></semantics></math>, we conclude that <math id="S4.SS4.SSS6.p9.m6" class="ltx_Math" alttext="\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})=0</annotation></semantics></math>, and that <math id="S4.SS4.SSS6.p9.m7" class="ltx_Math" alttext="R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})</annotation></semantics></math> is supported on a codimension one subvariety containing the Maroni divisor <math id="S4.SS4.SSS6.p9.m8" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>. Furthermore, the Bogomolov expression for <math id="S4.SS4.SSS6.p9.m9" class="ltx_Math" alttext="{\mathcal{E}}^{\prime}_{\rm versal}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{E}}^{\prime}_{\rm versal}</annotation></semantics></math> comes from computing <math id="S4.SS4.SSS6.p9.m10" class="ltx_Math" alttext="c_{1}R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c_{1}R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})</annotation></semantics></math> over the locus <math id="S4.SS4.SSS6.p9.m11" class="ltx_Math" alttext="B\setminus\Delta" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>∖</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">B\setminus\Delta</annotation></semantics></math>, so the Maroni divisor <math id="S4.SS4.SSS6.p9.m12" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> occurs with multiplicity one as a component of the support of <math id="S4.SS4.SSS6.p9.m13" class="ltx_Math" alttext="R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS6.p10" class="ltx_para">
<p id="S4.SS4.SSS6.p10.1" class="ltx_p"><span id="S4.SS4.SSS6.p10.1.1" class="ltx_text">This also means that any other component of the support of <math id="S4.SS4.SSS6.p10.m1" class="ltx_Math" alttext="R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})</annotation></semantics></math> must be supported on <math id="S4.SS4.SSS6.p10.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>. However, it is easy to check that for a general point in <math id="S4.SS4.SSS6.p10.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>, the directrices <math id="S4.SS4.SSS6.p10.m4" class="ltx_Math" alttext="\Sigma_{L}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\Sigma_{L}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p10.m5" class="ltx_Math" alttext="\Sigma_{R}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\Sigma_{R}</annotation></semantics></math> do not meet, and that this translates into vanishing of <math id="S4.SS4.SSS6.p10.m6" class="ltx_Math" alttext="R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})</annotation></semantics></math> at such a point.</span></p>
</div>
<div id="S4.SS4.SSS6.p11" class="ltx_para">
<p id="S4.SS4.SSS6.p11.1" class="ltx_p"><span id="S4.SS4.SSS6.p11.1.1" class="ltx_text">Therefore, <span id="S4.SS4.SSS6.p11.1.1.1" class="ltx_text ltx_font_slanted">the Maroni divisor <math id="S4.SS4.SSS6.p11.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> is simply the codimension one support of <math id="S4.SS4.SSS6.p11.m2" class="ltx_Math" alttext="R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})</annotation></semantics></math>.</span></span></p>
</div>
<div id="S4.SS4.SSS6.p12" class="ltx_para">
<p id="S4.SS4.SSS6.p12.1" class="ltx_p"><span id="S4.SS4.SSS6.p12.1.1" class="ltx_text">By pushing forward, we end up with a sequence of <math id="S4.SS4.SSS6.p12.m1" class="ltx_Math" alttext="{\mathcal{O}}_{B}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>B</mi></msub><annotation encoding="application/x-tex">{\mathcal{O}}_{B}</annotation></semantics></math>–modules:</span></p>
<table id="S4.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E10.m1" class="ltx_Math" alttext="0\longrightarrow\pi_{*}{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})\longrightarrow{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})|_{\sigma_{L}}\longrightarrow R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})\longrightarrow 0." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo stretchy="false">⟶</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">+</mo><msub><mi>σ</mi><mi>L</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><msub><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">+</mo><msub><mi>σ</mi><mi>L</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msub><mi>σ</mi><mi>L</mi></msub></msub><mo stretchy="false">⟶</mo><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\longrightarrow\pi_{*}{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})\longrightarrow{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})|_{\sigma_{L}}\longrightarrow R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})\longrightarrow 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.10)</span></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS6.p13" class="ltx_para">
<p id="S4.SS4.SSS6.p13.1" class="ltx_p"><span id="S4.SS4.SSS6.p13.1.1" class="ltx_text">The second sheaf is clearly locally free, and so is the first. Indeed, it suffices to show that <math id="S4.SS4.SSS6.p13.m1" class="ltx_Math" alttext="h^{0}({\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})|_{P_{L}\cup P_{R}})=d-1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">+</mo><msub><mi>σ</mi><mi>L</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><msub><mi>P</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>P</mi><mi>R</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})|_{P_{L}\cup P_{R}})=d-1</annotation></semantics></math> regardless of whether the directrices meet or not. This is straightforward: it follows from the fact that <math id="S4.SS4.SSS6.p13.m2" class="ltx_Math" alttext="{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})|_{P_{L}\cup P_{R}}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">+</mo><msub><mi>σ</mi><mi>L</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><msub><mi>P</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>P</mi><mi>R</mi></msub></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}^{\prime}_{{\rm versal}}(+\sigma_{L})|_{P_{L}\cup P_{R}}</annotation></semantics></math> restricts to a globally generated bundle on <math id="S4.SS4.SSS6.p13.m3" class="ltx_Math" alttext="P_{L}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>L</mi></msub><annotation encoding="application/x-tex">P_{L}</annotation></semantics></math> and has trivial <math id="S4.SS4.SSS6.p13.m4" class="ltx_Math" alttext="h^{1}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mn>1</mn></msup><annotation encoding="application/x-tex">h^{1}</annotation></semantics></math> on either. component. We conclude that the support of <math id="S4.SS4.SSS6.p13.m5" class="ltx_Math" alttext="R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})</annotation></semantics></math> is pure codimension one.</span></p>
</div>
<div id="S4.SS4.SSS6.p14" class="ltx_para">
<p id="S4.SS4.SSS6.p14.1" class="ltx_p"><span id="S4.SS4.SSS6.p14.1.1" class="ltx_text">Now we specialize our attention to the type of family parameterized by <math id="S4.SS4.SSS6.p14.m1" class="ltx_Math" alttext="{\text{\rm Spec}\,}k[[t]]" display="inline" intent=":literal"><semantics><mrow><mtext>Spec</mtext><mo lspace="0.170em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\text{\rm Spec}\,}k[[t]]</annotation></semantics></math> found in the statement of the theorem. Thus, we have a map <math id="S4.SS4.SSS6.p14.m2" class="ltx_Math" alttext="\varphi{\colon}{\text{\rm Spec}\,}k[[t]]\longrightarrow\Delta\subset B" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mtext>Spec</mtext><mo lspace="0.170em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">⟶</mo><mi mathvariant="normal">Δ</mi><mo>⊂</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\varphi{\colon}{\text{\rm Spec}\,}k[[t]]\longrightarrow\Delta\subset B</annotation></semantics></math> whose closed point maps to <math id="S4.SS4.SSS6.p14.m3" class="ltx_Math" alttext="0\in B" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>∈</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">0\in B</annotation></semantics></math>, and whose generic point does not lie in <math id="S4.SS4.SSS6.p14.m4" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS6.p15" class="ltx_para">
<p id="S4.SS4.SSS6.p15.1" class="ltx_p"><span id="S4.SS4.SSS6.p15.1.1" class="ltx_text">We let <math id="S4.SS4.SSS6.p15.m1" class="ltx_Math" alttext="\beta_{t}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\beta_{t}</annotation></semantics></math> denote this family of covers, and we see that we must compute the power of <math id="S4.SS4.SSS6.p15.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> which annihilates the <math id="S4.SS4.SSS6.p15.m3" class="ltx_Math" alttext="k[[t]]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k[[t]]</annotation></semantics></math>-module <math id="S4.SS4.SSS6.p15.m4" class="ltx_Math" alttext="\varphi^{*}R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi^{*}R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})</annotation></semantics></math>. (We need not worry about cohomology and base change issues, thanks to the free resolution <a href="#S4.E10" title="In Proof. ‣ 4.4.6 Maroni special curves in 
            
              Δ
            
          . ‣ 4.4 Degree five analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.10</span></a>. Also, we will suppress the “versal” and pullbacks in our notation and only write <math id="S4.SS4.SSS6.p15.m5" class="ltx_Math" alttext="R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{\beta_{t}})." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{\beta_{t}}).</annotation></semantics></math>)</span></p>
</div>
<div id="S4.SS4.SSS6.p16" class="ltx_para">
<p id="S4.SS4.SSS6.p16.1" class="ltx_p"><span id="S4.SS4.SSS6.p16.1.1" class="ltx_text">In fact, we will compute this annihilator by using a different resolution of the module <math id="S4.SS4.SSS6.p16.m1" class="ltx_Math" alttext="\varphi^{*}R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>versal</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi^{*}R^{1}\pi_{*}({\mathcal{E}}^{\prime}_{{\rm versal}})</annotation></semantics></math> which is available to us precisely because we have a family of two-component admissible covers.</span></p>
</div>
<div id="S4.SS4.SSS6.p17" class="ltx_para">
<p id="S4.SS4.SSS6.p17.1" class="ltx_p"><span id="S4.SS4.SSS6.p17.1.1" class="ltx_text">Let <math id="S4.SS4.SSS6.p17.m1" class="ltx_Math" alttext="\nu{\colon}{\mathcal{P}}_{L,t}\sqcup{\mathcal{P}}_{R,t}\longrightarrow{\mathcal{P}}_{L,t}\cup{\mathcal{P}}_{R,t}" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>⊔</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">⟶</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu{\colon}{\mathcal{P}}_{L,t}\sqcup{\mathcal{P}}_{R,t}\longrightarrow{\mathcal{P}}_{L,t}\cup{\mathcal{P}}_{R,t}</annotation></semantics></math> denote the normalization. Then we use consider the following exact sequence on <math id="S4.SS4.SSS6.p17.m2" class="ltx_Math" alttext="{\mathcal{P}}_{L,t}\cup{\mathcal{P}}_{R,t}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathcal{P}}_{L,t}\cup{\mathcal{P}}_{R,t}</annotation></semantics></math>:</span></p>
</div>
<div id="S4.SS4.SSS6.p18" class="ltx_para">
<table id="S4.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E11.m1" class="ltx_Math" alttext="0\longrightarrow{\mathcal{E}}^{\prime}_{\beta_{t}}\longrightarrow\nu_{*}\nu^{*}{\mathcal{E}}^{\prime}_{\beta_{t}}\longrightarrow{\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)}\longrightarrow 0," display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo stretchy="false">⟶</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup><mo stretchy="false">⟶</mo><mrow><msub><mi>ν</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ν</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup></mrow><mo stretchy="false">⟶</mo><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">⟶</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">0\longrightarrow{\mathcal{E}}^{\prime}_{\beta_{t}}\longrightarrow\nu_{*}\nu^{*}{\mathcal{E}}^{\prime}_{\beta_{t}}\longrightarrow{\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)}\longrightarrow 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.11)</span></td></tr></tbody>
</table>
<p id="S4.SS4.SSS6.p18.1" class="ltx_p"><span id="S4.SS4.SSS6.p18.1.1" class="ltx_text">where <math id="S4.SS4.SSS6.p18.m1" class="ltx_Math" alttext="x(t)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x(t)</annotation></semantics></math> is the family of nodes. We therefore seek the length of the cokernel of the restriction map</span></p>
<table id="S4.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex84.m1" class="ltx_Math" alttext="\rho{\colon}H^{0}(\nu_{*}\nu^{*}{\mathcal{E}}^{\prime}_{\beta_{t}})\longrightarrow H^{0}({\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)})." display="block" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ν</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ν</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho{\colon}H^{0}(\nu_{*}\nu^{*}{\mathcal{E}}^{\prime}_{\beta_{t}})\longrightarrow H^{0}({\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS6.p19" class="ltx_para">
<p id="S4.SS4.SSS6.p19.1" class="ltx_p"><span id="S4.SS4.SSS6.p19.1.1" class="ltx_text">The latter is clearly a free <math id="S4.SS4.SSS6.p19.m1" class="ltx_Math" alttext="k[[t]]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k[[t]]</annotation></semantics></math>-module of rank <math id="S4.SS4.SSS6.p19.m2" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS6.p20" class="ltx_para">
<p id="S4.SS4.SSS6.p20.1" class="ltx_p"><span id="S4.SS4.SSS6.p20.1.1" class="ltx_text">By assumption, the bundle <math id="S4.SS4.SSS6.p20.m1" class="ltx_Math" alttext="{\mathcal{E}}^{\prime}_{\beta_{t}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{E}}^{\prime}_{\beta_{t}}</annotation></semantics></math> restricts to <math id="S4.SS4.SSS6.p20.m2" class="ltx_Math" alttext="{\mathcal{A}}_{L,t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{A}}_{L,t}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p20.m3" class="ltx_Math" alttext="{\mathcal{A}}_{R,t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{A}}_{R,t}</annotation></semantics></math> on <math id="S4.SS4.SSS6.p20.m4" class="ltx_Math" alttext="{\mathcal{P}}_{L,t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{L,t}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p20.m5" class="ltx_Math" alttext="{\mathcal{P}}_{R,t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{R,t}</annotation></semantics></math> respectively, where</span></p>
<table id="S4.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex85.m1" class="ltx_Math" alttext="{\mathcal{A}}_{L,t}={\mathcal{O}}_{{\mathcal{P}}_{L,t}}^{\oplus r}\oplus{\mathcal{O}}_{{\mathcal{P}}_{L,t}}(-1)^{\oplus 4-r}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo>⊕</mo><mi>r</mi></mrow></msubsup><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mn>4</mn></mrow><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{L,t}={\mathcal{O}}_{{\mathcal{P}}_{L,t}}^{\oplus r}\oplus{\mathcal{O}}_{{\mathcal{P}}_{L,t}}(-1)^{\oplus 4-r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS6.p20.2" class="ltx_p"><span id="S4.SS4.SSS6.p20.2.1" class="ltx_text">and</span></p>
<table id="S4.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex86.m1" class="ltx_Math" alttext="{\mathcal{A}}_{R,t}={\mathcal{O}}_{{\mathcal{P}}_{R,t}}^{\oplus 4-r}\oplus{\mathcal{O}}_{{\mathcal{P}}_{R,t}}(-1)^{\oplus r}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mrow><mo>⊕</mo><mn>4</mn></mrow><mo>−</mo><mi>r</mi></mrow></msubsup><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{R,t}={\mathcal{O}}_{{\mathcal{P}}_{R,t}}^{\oplus 4-r}\oplus{\mathcal{O}}_{{\mathcal{P}}_{R,t}}(-1)^{\oplus r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS6.p20.3" class="ltx_p"><span id="S4.SS4.SSS6.p20.3.1" class="ltx_text">therefore we get</span></p>
<table id="S4.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex87.m1" class="ltx_Math" alttext="H^{0}(\nu_{*}\nu^{*}{\mathcal{E}}^{\prime}_{\beta_{t}})=k[[t]]\langle e_{1},...,e_{r}\rangle\oplus k[[t]]\langle f_{1},...,f_{4-r}\rangle" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ν</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ν</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mi>r</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>⊕</mo><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mrow><mn>4</mn><mo>−</mo><mi>r</mi></mrow></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}(\nu_{*}\nu^{*}{\mathcal{E}}^{\prime}_{\beta_{t}})=k[[t]]\langle e_{1},...,e_{r}\rangle\oplus k[[t]]\langle f_{1},...,f_{4-r}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS6.p20.4" class="ltx_p"><span id="S4.SS4.SSS6.p20.4.1" class="ltx_text">where <math id="S4.SS4.SSS6.p20.m6" class="ltx_Math" alttext="e_{i}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mi>i</mi></msub><annotation encoding="application/x-tex">e_{i}</annotation></semantics></math> and <math id="S4.SS4.SSS6.p20.m7" class="ltx_Math" alttext="f_{j}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>j</mi></msub><annotation encoding="application/x-tex">f_{j}</annotation></semantics></math> are bases for the free <math id="S4.SS4.SSS6.p20.m8" class="ltx_Math" alttext="k[[t]]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k[[t]]</annotation></semantics></math>–modules <math id="S4.SS4.SSS6.p20.m9" class="ltx_Math" alttext="H^{0}({\mathcal{A}}_{L,t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{A}}_{L,t})</annotation></semantics></math> and <math id="S4.SS4.SSS6.p20.m10" class="ltx_Math" alttext="H^{0}({\mathcal{A}}_{R,t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{A}}_{R,t})</annotation></semantics></math> respectively.</span></p>
</div>
<div id="S4.SS4.SSS6.p21" class="ltx_para">
<p id="S4.SS4.SSS6.p21.1" class="ltx_p"><span id="S4.SS4.SSS6.p21.1.1" class="ltx_text">Hence the length of the cokernel of <math id="S4.SS4.SSS6.p21.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is given by order of vanishing of the determinant of the matrix <math id="S4.SS4.SSS6.p21.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> at <math id="S4.SS4.SSS6.p21.m3" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS6.p22" class="ltx_para">
<p id="S4.SS4.SSS6.p22.1" class="ltx_p"><span id="S4.SS4.SSS6.p22.1.1" class="ltx_text">Now we simply notice that in the projective bundle <math id="S4.SS4.SSS6.p22.m1" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)}</annotation></semantics></math> over <math id="S4.SS4.SSS6.p22.m2" class="ltx_Math" alttext="{\text{\rm Spec}\,}k[[t]]" display="inline" intent=":literal"><semantics><mrow><mtext>Spec</mtext><mo lspace="0.170em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\text{\rm Spec}\,}k[[t]]</annotation></semantics></math>, the equations <math id="S4.SS4.SSS6.p22.m3" class="ltx_Math" alttext="\rho(e_{1})=...\rho(e_{r})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho(e_{1})=...\rho(e_{r})=0</annotation></semantics></math> cut out the scheme <math id="S4.SS4.SSS6.p22.m4" class="ltx_Math" alttext="\Sigma_{L,t}\cap{\bf P}{\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∩</mo><msub><mrow><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\Sigma_{L,t}\cap{\bf P}{\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)}</annotation></semantics></math> and similarly <math id="S4.SS4.SSS6.p22.m5" class="ltx_Math" alttext="\rho(f_{1})=...\rho(f_{4-r})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mn>4</mn><mo>−</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho(f_{1})=...\rho(f_{4-r})=0</annotation></semantics></math> cut out the scheme <math id="S4.SS4.SSS6.p22.m6" class="ltx_Math" alttext="\Sigma_{R,t}\cap{\bf P}{\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∩</mo><msub><mrow><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mi>β</mi><mi>t</mi></msub><mo>′</mo></msubsup></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\Sigma_{R,t}\cap{\bf P}{\mathcal{E}}^{\prime}_{\beta_{t}}|_{x(t)}</annotation></semantics></math>. The theorem now follows by the simple observation that the scheme theoretic intersection of these two linear subschemes is given by the vanishing of the determinant of <math id="S4.SS4.SSS6.p22.m7" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS6.p23" class="ltx_para">
<p id="S4.SS4.SSS6.p23.1" class="ltx_p"><span id="S4.SS4.SSS6.p23.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="S4.SS4.SSS7" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.4.7 The partial pencil <math id="S4.SS4.SSS7.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> avoids <math id="S4.SS4.SSS7.m2" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math>.</h4>

<div id="S4.Thmthm30" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm30.2" class="ltx_text ltx_font_bold">Proposition 4.30</span></span><span id="S4.Thmthm30.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm30.p1" class="ltx_para">
<p id="S4.Thmthm30.p1.1" class="ltx_p"><span id="S4.Thmthm30.p1.1.1" class="ltx_text ltx_font_italic">A general partial pencil family <math id="S4.Thmthm30.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> as in section <a href="#S4.SS4.SSS5" title="4.4.5 ‣ 4.4 Degree five analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4.5</span></a> avoids the Casnati-Ekedahl divisor <math id="S4.Thmthm30.p1.m2" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS4.SSS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS4.SSS7.p1" class="ltx_para">
<p id="S4.SS4.SSS7.p1.1" class="ltx_p"><span id="S4.SS4.SSS7.p1.1.1" class="ltx_text">The partial pencil <math id="S4.SS4.SSS7.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> varies with the parameter <math id="S4.SS4.SSS7.p1.m2" class="ltx_Math" alttext="t\in{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">t\in{\bf P}^{1}_{t}</annotation></semantics></math>, and <math id="S4.SS4.SSS7.p1.m3" class="ltx_Math" alttext="t=\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t=\infty</annotation></semantics></math> gives the split fiber. Let <math id="S4.SS4.SSS7.p1.m4" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> denote the admissible cover in <math id="S4.SS4.SSS7.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> parameterized by <math id="S4.SS4.SSS7.p1.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS7.p2" class="ltx_para">
<p id="S4.SS4.SSS7.p2.1" class="ltx_p"><span id="S4.SS4.SSS7.p2.1.1" class="ltx_text">First, consider <math id="S4.SS4.SSS7.p2.m1" class="ltx_Math" alttext="t\neq\infty." display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>≠</mo><mi mathvariant="normal">∞</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t\neq\infty.</annotation></semantics></math> The right side <math id="S4.SS4.SSS7.p2.m2" class="ltx_Math" alttext="C_{R,t}\subset{\bf F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>⊂</mo><mi>𝐅</mi></mrow><annotation encoding="application/x-tex">C_{R,t}\subset{\bf F}</annotation></semantics></math> intersects every degree <math id="S4.SS4.SSS7.p2.m3" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> elliptic normal curve fiber <math id="S4.SS4.SSS7.p2.m4" class="ltx_Math" alttext="F_{s}\subset{\bf F}\subset{\bf P}{\mathcal{E}}_{{\bf F}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>s</mi></msub><mo>⊂</mo><mi>𝐅</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐅</mi></msub></mrow></mrow><annotation encoding="application/x-tex">F_{s}\subset{\bf F}\subset{\bf P}{\mathcal{E}}_{{\bf F}}</annotation></semantics></math> as a hyperplane section. Let <math id="S4.SS4.SSS7.p2.m5" class="ltx_Math" alttext="{\mathcal{F}}_{R,t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{R,t}</annotation></semantics></math> denote the Casnati-Ekedahl bundle for the pentagonal curve <math id="S4.SS4.SSS7.p2.m6" class="ltx_Math" alttext="C_{R,t}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">C_{R,t}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS7.p3" class="ltx_para">
<p id="S4.SS4.SSS7.p3.1" class="ltx_p"><span id="S4.SS4.SSS7.p3.1.1" class="ltx_text">Consider the vector bundle defined by the formula:</span></p>
<table id="S4.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex88.m1" class="ltx_Math" alttext="\widetilde{{\mathcal{F}}}|_{s}:=\{\text{Quadrics in ${\bf P}({\mathcal{E}}_{{\bf F}})|_{s}$ containing $F_{s}$}\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>~</mo></mover><mo stretchy="false">|</mo></mrow><mi>s</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>Quadrics in </mtext><msub><mrow><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>s</mi></msub><mtext> containing </mtext><msub><mi>F</mi><mi>s</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{F}}}|_{s}:=\{\text{Quadrics in ${\bf P}({\mathcal{E}}_{{\bf F}})|_{s}$ containing $F_{s}$}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS7.p3.2" class="ltx_p"><span id="S4.SS4.SSS7.p3.2.1" class="ltx_text">As explained in the proof of <a href="#S1.Thmthm12" title="Lemma 1.12. ‣ 1.6 The Casnati-Ekedahl loci 
          
            
              C
              
                
                
                  (
                  F
                  )
                
              
            
          
        . ‣ 1 Invariants of a branched cover. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">1.12</span></a>, part <math id="S4.SS4.SSS7.p3.m1" class="ltx_Math" alttext="(d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d)</annotation></semantics></math>, the natural restriction map</span></p>
<table id="S4.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex89.m1" class="ltx_Math" alttext="{\rm res}{\colon}\widetilde{{\mathcal{F}}}\longrightarrow{\mathcal{F}}_{R,t}" display="block" intent=":literal"><semantics><mrow><mi>res</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>~</mo></mover><mo stretchy="false">⟶</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">{\rm res}{\colon}\widetilde{{\mathcal{F}}}\longrightarrow{\mathcal{F}}_{R,t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS7.p3.3" class="ltx_p"><span id="S4.SS4.SSS7.p3.3.1" class="ltx_text">is an isomorphism for all <math id="S4.SS4.SSS7.p3.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS7.p4" class="ltx_para">
<p id="S4.SS4.SSS7.p4.1" class="ltx_p"><span id="S4.SS4.SSS7.p4.1.1" class="ltx_text">This means that the family of Casnati-Ekedahl bundles <math id="S4.SS4.SSS7.p4.m1" class="ltx_Math" alttext="{\mathcal{F}}_{R,t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>R</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{R,t}</annotation></semantics></math>, <math id="S4.SS4.SSS7.p4.m2" class="ltx_Math" alttext="t\in{\bf A}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>𝐀</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">t\in{\bf A}^{1}_{t}</annotation></semantics></math>, regarded as a vector bundle on <math id="S4.SS4.SSS7.p4.m3" class="ltx_Math" alttext="{\bf A}^{1}_{t}\times{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐀</mi><mi>t</mi><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">{\bf A}^{1}_{t}\times{\bf P}^{1}_{s}</annotation></semantics></math> is the pullback of the bundle <math id="S4.SS4.SSS7.p4.m4" class="ltx_Math" alttext="\widetilde{{\mathcal{F}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{{\mathcal{F}}}</annotation></semantics></math> under the projection to <math id="S4.SS4.SSS7.p4.m5" class="ltx_Math" alttext="{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{s}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS7.p5" class="ltx_para">
<p id="S4.SS4.SSS7.p5.1" class="ltx_p"><span id="S4.SS4.SSS7.p5.1.1" class="ltx_text">Since the left sides <math id="S4.SS4.SSS7.p5.m1" class="ltx_Math" alttext="{\bf C}_{L,t}" display="inline" intent=":literal"><semantics><msub><mi>𝐂</mi><mrow><mi>L</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\bf C}_{L,t}</annotation></semantics></math> of the partial pencil <math id="S4.SS4.SSS7.p5.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> are constant (including points of attachment), we conclude:</span></p>
<table id="S4.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span id="S4.Ex90.1" class="ltx_text ltx_markedasmath ltx_font_slanted">The family of Casnati-Ekedahl bundles <math id="S4.Ex90.m1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\alpha_{t}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>α</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\alpha_{t}}</annotation></semantics></math> is constant for <math id="S4.Ex90.m1.m2" class="ltx_Math" alttext="t\neq\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≠</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\neq\infty</annotation></semantics></math>.</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS7.p6" class="ltx_para">
<p id="S4.SS4.SSS7.p6.1" class="ltx_p"><span id="S4.SS4.SSS7.p6.1.1" class="ltx_text">Therefore, by a similar analysis as in the proof of <a href="#S4.Thmthm28" title="Theorem 4.28. ‣ 4.4.6 Maroni special curves in 
            
              Δ
            
          . ‣ 4.4 Degree five analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.28</span></a>, we conclude that by choosing the pencil <math id="S4.SS4.SSS7.p6.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, <math id="S4.SS4.SSS7.p6.m2" class="ltx_Math" alttext="C_{L}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>L</mi></msub><annotation encoding="application/x-tex">C_{L}</annotation></semantics></math>, and the points of attachment on <math id="S4.SS4.SSS7.p6.m3" class="ltx_Math" alttext="C_{L}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>L</mi></msub><annotation encoding="application/x-tex">C_{L}</annotation></semantics></math> generically, we may avoid <math id="S4.SS4.SSS7.p6.m4" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> for <math id="S4.SS4.SSS7.p6.m5" class="ltx_Math" alttext="t\neq\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≠</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\neq\infty</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS7.p7" class="ltx_para">
<p id="S4.SS4.SSS7.p7.1" class="ltx_p"><span id="S4.SS4.SSS7.p7.1.1" class="ltx_text">It remains to understand why the split fiber at <math id="S4.SS4.SSS7.p7.m1" class="ltx_Math" alttext="t=\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t=\infty</annotation></semantics></math> is not in <math id="S4.SS4.SSS7.p7.m2" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math>. For this, we will refer again back to <a href="#S1.Thmthm12" title="Lemma 1.12. ‣ 1.6 The Casnati-Ekedahl loci 
          
            
              C
              
                
                
                  (
                  F
                  )
                
              
            
          
        . ‣ 1 Invariants of a branched cover. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">1.12</span></a> part <math id="S4.SS4.SSS7.p7.m3" class="ltx_Math" alttext="(d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d)</annotation></semantics></math>, but for slightly different reasons.</span></p>
</div>
<div id="S4.SS4.SSS7.p8" class="ltx_para">
<p id="S4.SS4.SSS7.p8.1" class="ltx_p"><span id="S4.SS4.SSS7.p8.1.1" class="ltx_text">The admissible cover parameterized by <math id="S4.SS4.SSS7.p8.m1" class="ltx_Math" alttext="t=\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t=\infty</annotation></semantics></math></span></p>
<table id="S4.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex91.m1" class="ltx_Math" alttext="\alpha_{\infty}{\colon}C_{L}\cup C_{M}\cup C^{\prime}_{R}\longrightarrow P_{L}\cup P_{M}\cup P_{R}" display="block" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>C</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>C</mi><mi>M</mi></msub><mo>∪</mo><msubsup><mi>C</mi><mi>R</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">⟶</mo><mrow><msub><mi>P</mi><mi>L</mi></msub><mo>∪</mo><msub><mi>P</mi><mi>M</mi></msub><mo>∪</mo><msub><mi>P</mi><mi>R</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha_{\infty}{\colon}C_{L}\cup C_{M}\cup C^{\prime}_{R}\longrightarrow P_{L}\cup P_{M}\cup P_{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS7.p8.2" class="ltx_p"><span id="S4.SS4.SSS7.p8.2.1" class="ltx_text">has three components, with the left curve <math id="S4.SS4.SSS7.p8.m2" class="ltx_Math" alttext="C_{L}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>L</mi></msub><annotation encoding="application/x-tex">C_{L}</annotation></semantics></math> being the fixed curve we have glued to the varying right side. The curve <math id="S4.SS4.SSS7.p8.m3" class="ltx_Math" alttext="C_{M}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>M</mi></msub><annotation encoding="application/x-tex">C_{M}</annotation></semantics></math> is isomorphic to the fiber <math id="S4.SS4.SSS7.p8.m4" class="ltx_Math" alttext="F\subset{\bf F}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⊂</mo><mi>𝐅</mi></mrow><annotation encoding="application/x-tex">F\subset{\bf F}</annotation></semantics></math> which split off in the original pencil <math id="S4.SS4.SSS7.p8.m5" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|H_{1}|," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|H_{1}|,</annotation></semantics></math> and the curve <math id="S4.SS4.SSS7.p8.m6" class="ltx_Math" alttext="C^{\prime}_{R}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>R</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">C^{\prime}_{R}</annotation></semantics></math> is the residual curve in the divisor class <math id="S4.SS4.SSS7.p8.m7" class="ltx_Math" alttext="H_{1}-F" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>−</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">H_{1}-F</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS7.p9" class="ltx_para">
<p id="S4.SS4.SSS7.p9.1" class="ltx_p"><span id="S4.SS4.SSS7.p9.1.1" class="ltx_text">By <a href="#S1.Thmthm12" title="Lemma 1.12. ‣ 1.6 The Casnati-Ekedahl loci 
          
            
              C
              
                
                
                  (
                  F
                  )
                
              
            
          
        . ‣ 1 Invariants of a branched cover. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">1.12</span></a>, we know that the Casnati-Ekedahl bundle <math id="S4.SS4.SSS7.p9.m1" class="ltx_Math" alttext="{\mathcal{F}}_{M}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>M</mi></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{M}</annotation></semantics></math> for the middle map</span></p>
<table id="S4.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex92.m1" class="ltx_Math" alttext="\alpha_{\infty,M}{\colon}C_{M}\longrightarrow P_{M}" display="block" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><mi>M</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>M</mi></msub><mo stretchy="false">⟶</mo><msub><mi>P</mi><mi>M</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha_{\infty,M}{\colon}C_{M}\longrightarrow P_{M}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS7.p9.2" class="ltx_p"><span id="S4.SS4.SSS7.p9.2.1" class="ltx_text">is perfectly balanced, isomorphic to <math id="S4.SS4.SSS7.p9.m2" class="ltx_Math" alttext="{\mathcal{O}}(2)^{\oplus 5}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(2)^{\oplus 5}</annotation></semantics></math>. We furthermore know from arguments earlier in this proof, we know that the Casnati-Ekedahl bundle, up to twisting by a line bundle on <math id="S4.SS4.SSS7.p9.m3" class="ltx_Math" alttext="{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{s}</annotation></semantics></math>, is isomorphic to the vector bundle <math id="S4.SS4.SSS7.p9.m4" class="ltx_Math" alttext="\widetilde{{\mathcal{F}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{{\mathcal{F}}}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.SSS7.p10" class="ltx_para">
<p id="S4.SS4.SSS7.p10.1" class="ltx_p"><span id="S4.SS4.SSS7.p10.1.1" class="ltx_text">With this description of <math id="S4.SS4.SSS7.p10.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\alpha_{\infty}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>α</mi><mi mathvariant="normal">∞</mi></msub></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\alpha_{\infty}}</annotation></semantics></math>, and by similar arguments to the proof of <a href="#S4.Thmthm28" title="Theorem 4.28. ‣ 4.4.6 Maroni special curves in 
            
              Δ
            
          . ‣ 4.4 Degree five analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.28</span></a>, we see that for a general choice of residual curve <math id="S4.SS4.SSS7.p10.m2" class="ltx_Math" alttext="C^{\prime}_{R}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>R</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">C^{\prime}_{R}</annotation></semantics></math>, the bundle <math id="S4.SS4.SSS7.p10.m3" class="ltx_Math" alttext="{\mathcal{F}}_{\alpha_{\infty}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>α</mi><mi mathvariant="normal">∞</mi></msub></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\alpha_{\infty}}</annotation></semantics></math> obeys <math id="S4.SS4.SSS7.p10.m4" class="ltx_Math" alttext="h^{1}({\rm End\,}{\mathcal{F}}_{\alpha_{\infty}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>End</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi>α</mi><mi mathvariant="normal">∞</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{1}({\rm End\,}{\mathcal{F}}_{\alpha_{\infty}})=0</annotation></semantics></math>, which implies that <math id="S4.SS4.SSS7.p10.m5" class="ltx_Math" alttext="\alpha_{\infty}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\alpha_{\infty}</annotation></semantics></math> is Casnati-Ekedahl general.</span></p>
</div>
<div id="S4.SS4.SSS7.p11" class="ltx_para">
<p id="S4.SS4.SSS7.p11.1" class="ltx_p"><span id="S4.SS4.SSS7.p11.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S4.Thmthm31" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm31.2" class="ltx_text ltx_font_italic">Remark 4.31</span></span><span id="S4.Thmthm31.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmthm31.p1" class="ltx_para">
<p id="S4.Thmthm31.p1.1" class="ltx_p">The fact that <math id="S4.Thmthm31.p1.m1" class="ltx_Math" alttext="{\mathsf{CE}}\cdot p=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖢𝖤</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\mathsf{CE}}\cdot p=0</annotation></semantics></math> was the original motivation in considering this particular construction of partial pencil <math id="S4.Thmthm31.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.</p>
</div>
</div>
</section>
</section>
<section id="S4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">4.5 A proposition on “rotating directrices.”</h3>

<div id="S4.SS5.p1" class="ltx_para">
<p id="S4.SS5.p1.1" class="ltx_p">Given <a href="#S4.Thmthm28" title="Theorem 4.28. ‣ 4.4.6 Maroni special curves in 
            
              Δ
            
          . ‣ 4.4 Degree five analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.28</span></a>, we are now ready to compute the intersection of <math id="S4.SS5.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> with the divisor <math id="S4.SS5.p1.m2" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>. We see that the computation translates into a question about the variation of directrices in a family of balanced scrolls.</p>
</div>
<section id="S4.SS5.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.5.1 </h4>

<div id="S4.SS5.SSS1.p1" class="ltx_para">
<p id="S4.SS5.SSS1.p1.1" class="ltx_p">We begin with the following general setup. Let <math id="S4.SS5.SSS1.p1.m1" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math> be a vector bundle on <math id="S4.SS5.SSS1.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{s}</annotation></semantics></math> of rank <math id="S4.SS5.SSS1.p1.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>. On <math id="S4.SS5.SSS1.p1.m4" class="ltx_Math" alttext="{\bf P}^{1}_{t}\times{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\times{\bf P}^{1}_{s}</annotation></semantics></math>, consider an exact sequence of the form</p>
<table id="S4.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex93.m1" class="ltx_Math" alttext="0\longrightarrow\mathcal{O}(-aR_{s}-R_{t})\longrightarrow f_{s}^{*}{\mathcal{V}}\longrightarrow{\mathcal{W}}\longrightarrow 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">⟶</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo>−</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mrow><msubsup><mi>f</mi><mi>s</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo stretchy="false">⟶</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">⟶</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\longrightarrow\mathcal{O}(-aR_{s}-R_{t})\longrightarrow f_{s}^{*}{\mathcal{V}}\longrightarrow{\mathcal{W}}\longrightarrow 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.SSS1.p1.2" class="ltx_p">where <math id="S4.SS5.SSS1.p1.m5" class="ltx_Math" alttext="R_{s}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>s</mi></msub><annotation encoding="application/x-tex">R_{s}</annotation></semantics></math> and <math id="S4.SS5.SSS1.p1.m6" class="ltx_Math" alttext="R_{t}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>t</mi></msub><annotation encoding="application/x-tex">R_{t}</annotation></semantics></math> denote the ruling line classes parametrized by <math id="S4.SS5.SSS1.p1.m7" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and <math id="S4.SS5.SSS1.p1.m8" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, respectively. We let <math id="S4.SS5.SSS1.p1.m9" class="ltx_Math" alttext="f_{s}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>s</mi></msub><annotation encoding="application/x-tex">f_{s}</annotation></semantics></math> and <math id="S4.SS5.SSS1.p1.m10" class="ltx_Math" alttext="f_{t}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>t</mi></msub><annotation encoding="application/x-tex">f_{t}</annotation></semantics></math> denote the projections of <math id="S4.SS5.SSS1.p1.m11" class="ltx_Math" alttext="{\bf P}^{1}_{t}\times{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\times{\bf P}^{1}_{s}</annotation></semantics></math> to the respective factors, and <math id="S4.SS5.SSS1.p1.m12" class="ltx_Math" alttext="\pi_{s}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\pi_{s}</annotation></semantics></math> and <math id="S4.SS5.SSS1.p1.m13" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> denote the respective maps from <math id="S4.SS5.SSS1.p1.m14" class="ltx_Math" alttext="{\bf P}{\mathcal{V}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{V}}</annotation></semantics></math> to <math id="S4.SS5.SSS1.p1.m15" class="ltx_Math" alttext="{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{s}</annotation></semantics></math> and <math id="S4.SS5.SSS1.p1.m16" class="ltx_Math" alttext="{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{t}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS5.SSS1.p2" class="ltx_para">
<p id="S4.SS5.SSS1.p2.1" class="ltx_p">We further assume that <math id="S4.SS5.SSS1.p2.m1" class="ltx_Math" alttext="{\mathcal{W}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">{\mathcal{W}}</annotation></semantics></math> splits as</p>
<table id="S4.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex94.m1" class="ltx_Math" alttext="{\mathcal{W}}_{t}=\mathcal{O}(l)^{\oplus r}\oplus\mathcal{O}(l+1)^{\oplus N-1-r}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>r</mi></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mi>N</mi></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{W}}_{t}=\mathcal{O}(l)^{\oplus r}\oplus\mathcal{O}(l+1)^{\oplus N-1-r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.SSS1.p2.2" class="ltx_p">for some <math id="S4.SS5.SSS1.p2.m2" class="ltx_Math" alttext="1\leq r\leq N-2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>r</mi><mo>≤</mo><mrow><mi>N</mi><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq r\leq N-2</annotation></semantics></math> and all <math id="S4.SS5.SSS1.p2.m3" class="ltx_Math" alttext="t\in{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">t\in{\bf P}^{1}_{t}</annotation></semantics></math>. In other words, we assume that <math id="S4.SS5.SSS1.p2.m4" class="ltx_Math" alttext="{\mathcal{W}}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathcal{W}}_{t}</annotation></semantics></math> is balanced, though not perfectly balanced, for all <math id="S4.SS5.SSS1.p2.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS5.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.5.2 </h4>

<div id="S4.SS5.SSS2.p1" class="ltx_para">
<p id="S4.SS5.SSS2.p1.1" class="ltx_p">Pick a point <math id="S4.SS5.SSS2.p1.m1" class="ltx_Math" alttext="s=0\in{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mn>0</mn><mo>∈</mo><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">s=0\in{\bf P}^{1}_{s}</annotation></semantics></math> and consider the preimage <math id="S4.SS5.SSS2.p1.m2" class="ltx_Math" alttext="X:=\pi_{s}^{-1}(0)\subset{\bf P}{\mathcal{V}}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>:=</mo><mrow><msubsup><mi>π</mi><mi>s</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">X:=\pi_{s}^{-1}(0)\subset{\bf P}{\mathcal{V}}.</annotation></semantics></math> Then <math id="S4.SS5.SSS2.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is isomorphic to the product <math id="S4.SS5.SSS2.p1.m4" class="ltx_Math" alttext="{\bf P}^{N-1}\times{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐏</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">{\bf P}^{N-1}\times{\bf P}^{1}_{t}</annotation></semantics></math>. If we intersect <math id="S4.SS5.SSS2.p1.m5" class="ltx_Math" alttext="{\bf P}{\mathcal{D}}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{D}}_{t}</annotation></semantics></math> with <math id="S4.SS5.SSS2.p1.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, we get a family of <math id="S4.SS5.SSS2.p1.m7" class="ltx_Math" alttext="{\bf P}^{r-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{r-1}</annotation></semantics></math>’s in <math id="S4.SS5.SSS2.p1.m8" class="ltx_Math" alttext="{\bf P}^{N-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{N-1}</annotation></semantics></math> parametrized by <math id="S4.SS5.SSS2.p1.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Letting <math id="S4.SS5.SSS2.p1.m10" class="ltx_Math" alttext="Y\subset X" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>⊂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">Y\subset X</annotation></semantics></math> denote the total space of this family, our intention is to compute the “degree” of <math id="S4.SS5.SSS2.p1.m11" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>, viewed as a one parameter family of <math id="S4.SS5.SSS2.p1.m12" class="ltx_Math" alttext="(r-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r-1)</annotation></semantics></math>-planes in <math id="S4.SS5.SSS2.p1.m13" class="ltx_Math" alttext="{\bf P}^{N-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{N-1}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm32" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm32.2" class="ltx_text ltx_font_italic">Remark 4.32</span></span><span id="S4.Thmthm32.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmthm32.p1" class="ltx_para">
<p id="S4.Thmthm32.p1.1" class="ltx_p">If we imagine the scrolls <math id="S4.Thmthm32.p1.m1" class="ltx_Math" alttext="{\bf P}{\mathcal{W}}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{W}}_{t}</annotation></semantics></math> as varying with time, we may imagine their directrices <math id="S4.Thmthm32.p1.m2" class="ltx_Math" alttext="{\bf P}{\mathcal{D}}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{D}}_{t}</annotation></semantics></math> as “rotating” in the total space <math id="S4.Thmthm32.p1.m3" class="ltx_Math" alttext="{\bf P}{\mathcal{W}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{W}}</annotation></semantics></math>, and this amount of rotation is quantified by the degree mentioned above.</p>
</div>
</div>
<div id="S4.Thmthm33" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm33.2" class="ltx_text ltx_font_bold">Proposition 4.33</span></span><span id="S4.Thmthm33.3" class="ltx_text ltx_font_bold"> </span>(Rotating directrices)<span id="S4.Thmthm33.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm33.p1" class="ltx_para">
<p id="S4.Thmthm33.p1.1" class="ltx_p"><span id="S4.Thmthm33.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm33.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and <math id="S4.Thmthm33.p1.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> denote the pullbacks of the hyperplane class of <math id="S4.Thmthm33.p1.m3" class="ltx_Math" alttext="{\bf P}^{N-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{N-1}</annotation></semantics></math> and <math id="S4.Thmthm33.p1.m4" class="ltx_Math" alttext="{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{t}</annotation></semantics></math>, respectively, to <math id="S4.Thmthm33.p1.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Then the class of the total space of <math id="S4.Thmthm33.p1.m6" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> in the Chow ring of <math id="S4.Thmthm33.p1.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is given by</span></p>
<table id="S4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E12.m1" class="ltx_Math" alttext="[Y]=H^{N-r}+(a+l+1)H^{N-r-1}\cdot F." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mi>Y</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><msup><mi>H</mi><mrow><mi>N</mi><mo>−</mo><mi>r</mi></mrow></msup><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mi>N</mi><mo>−</mo><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>F</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[Y]=H^{N-r}+(a+l+1)H^{N-r-1}\cdot F.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.12)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS5.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS5.SSS2.p2" class="ltx_para">
<p id="S4.SS5.SSS2.p2.1" class="ltx_p"><span id="S4.SS5.SSS2.p2.1.1" class="ltx_text">Let <math id="S4.SS5.SSS2.p2.m1" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math> be any vector bundle on <math id="S4.SS5.SSS2.p2.m2" class="ltx_Math" alttext="{\bf P}^{1}_{t}\times{\bf P}^{1}_{s}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝐏</mi><mi>s</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\times{\bf P}^{1}_{s}</annotation></semantics></math> such that <math id="S4.SS5.SSS2.p2.m3" class="ltx_Math" alttext="{\mathcal{A}}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathcal{A}}_{t}</annotation></semantics></math> has vanishing higher cohomology for all <math id="S4.SS5.SSS2.p2.m4" class="ltx_Math" alttext="t\in{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">t\in{\bf P}^{1}_{t}</annotation></semantics></math>. We can compute the degree of the pushforward <math id="S4.SS5.SSS2.p2.m5" class="ltx_math_unparsed" alttext="f_{t*}{\mathcal{A}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><msub><mrow></mrow><mrow><mi>t</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">f_{t*}{\mathcal{A}}</annotation></semantics></math> using the Grothendieck-Riemann-Roch formula; we get:</span></p>
<table id="S4.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E13.m1" class="ltx_math_unparsed" alttext="\deg\,(f_{t*}{\mathcal{A}})=c_{1}{\mathcal{A}}\cdot R_{s}+\frac{c_{1}^{2}{\mathcal{A}}}{2}-c_{2}{\mathcal{A}}." display="block" intent=":literal"><semantics><mrow><mi>deg</mi><mrow><mo lspace="0.170em" stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>t</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>c</mi><mn>1</mn></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>R</mi><mi>s</mi></msub><mo>+</mo><mfrac><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><mn>2</mn></mfrac><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\deg\,(f_{t*}{\mathcal{A}})=c_{1}{\mathcal{A}}\cdot R_{s}+\frac{c_{1}^{2}{\mathcal{A}}}{2}-c_{2}{\mathcal{A}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.13)</span></td></tr></tbody>
</table>
</div>
<div id="S4.SS5.SSS2.p3" class="ltx_para">
<p id="S4.SS5.SSS2.p3.1" class="ltx_p"><span id="S4.SS5.SSS2.p3.1.1" class="ltx_text">We apply this formula to <math id="S4.SS5.SSS2.p3.m1" class="ltx_Math" alttext="{\mathcal{A}}={\mathcal{W}}(-(l+1)R_{s})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}={\mathcal{W}}(-(l+1)R_{s})</annotation></semantics></math>. For this, we first note that</span></p>
<table id="S4.EGx27" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S4.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex95.m1" class="ltx_Math" alttext="\displaystyle c_{1}{\mathcal{W}}=c_{1}{\mathcal{V}}+aR_{s}+R_{t}=\deg{\mathcal{V}}\cdot R_{s}+aR_{s}+R_{t}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo>+</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow><mo>+</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>R</mi><mi>s</mi></msub></mrow><mo>+</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow><mo>+</mo><msub><mi>R</mi><mi>t</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle c_{1}{\mathcal{W}}=c_{1}{\mathcal{V}}+aR_{s}+R_{t}=\deg{\mathcal{V}}\cdot R_{s}+aR_{s}+R_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex96.m1" class="ltx_Math" alttext="\displaystyle c_{2}{\mathcal{W}}=\deg{\mathcal{V}}+2a," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><mo>=</mo><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle c_{2}{\mathcal{W}}=\deg{\mathcal{V}}+2a,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.SSS2.p3.2" class="ltx_p"><span id="S4.SS5.SSS2.p3.2.1" class="ltx_text">and so</span></p>
<table id="S4.EGx28" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S4.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex97.m1" class="ltx_Math" alttext="\displaystyle c_{1}{\mathcal{W}}(-(l+1)R_{s})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c_{1}{\mathcal{W}}(-(l+1)R_{s})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.Ex97.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex97.m3" class="ltx_Math" alttext="\displaystyle\deg{\mathcal{V}}\cdot R_{s}+aR_{s}+R_{t}-(N-1)(l+1)R_{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>R</mi><mi>s</mi></msub></mrow><mo>+</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow><mo>+</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\deg{\mathcal{V}}\cdot R_{s}+aR_{s}+R_{t}-(N-1)(l+1)R_{s}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex98.m1" class="ltx_Math" alttext="\displaystyle c_{2}{\mathcal{W}}(-(l+1)R_{s})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c_{2}{\mathcal{W}}(-(l+1)R_{s})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.Ex98.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex98.m3" class="ltx_Math" alttext="\displaystyle\deg{\mathcal{V}}+2a+(N-2)(-(l+1)R_{s})c_{1}{\mathcal{W}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\deg{\mathcal{V}}+2a+(N-2)(-(l+1)R_{s})c_{1}{\mathcal{W}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.Ex99.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex99.m2" class="ltx_Math" alttext="\displaystyle\deg{\mathcal{V}}+2a-(N-2)(l+1)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\deg{\mathcal{V}}+2a-(N-2)(l+1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS5.SSS2.p4" class="ltx_para">
<p id="S4.SS5.SSS2.p4.1" class="ltx_p"><span id="S4.SS5.SSS2.p4.1.1" class="ltx_text">Plugging this into (<a href="#S4.E13" title="In Proof. ‣ 4.5.2 ‣ 4.5 A proposition on “rotating directrices.” ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.13</span></a>) gives:</span></p>
<table id="S4.EGx29" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S4.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex100.m1" class="ltx_math_unparsed" alttext="\displaystyle\deg\,f_{t*}{\mathcal{W}}(-(l+1)R_{s})" display="inline" intent=":literal"><semantics><mrow><mi>deg</mi><msub><mi>f</mi><mrow><mi>t</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><msub><mi>R</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\deg\,f_{t*}{\mathcal{W}}(-(l+1)R_{s})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.Ex100.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex100.m3" class="ltx_Math" alttext="\displaystyle 1+[\deg{\mathcal{V}}+a-(N-1)(l+1)]-[\deg{\mathcal{V}}+2a-(N-2)(l+1)]" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo>+</mo><mi>a</mi></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1+[\deg{\mathcal{V}}+a-(N-1)(l+1)]-[\deg{\mathcal{V}}+2a-(N-2)(l+1)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.Ex101.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex101.m2" class="ltx_Math" alttext="\displaystyle-a-l." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mi>a</mi></mrow><mo>−</mo><mi>l</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-a-l.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS5.SSS2.p5" class="ltx_para">
<p id="S4.SS5.SSS2.p5.1" class="ltx_p"><span id="S4.SS5.SSS2.p5.1.1" class="ltx_text">Now consider the sequence which gives rise to the vector bundle <math id="S4.SS5.SSS2.p5.m1" class="ltx_Math" alttext="{\mathcal{D}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">{\mathcal{D}}</annotation></semantics></math>:</span></p>
<table id="S4.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex102.m1" class="ltx_math_unparsed" alttext="0\longrightarrow f_{t}^{*}f_{t*}{\mathcal{W}}(-(l+1)R_{s})\longrightarrow{\mathcal{W}}(-(l+1)R_{s})\longrightarrow{\mathcal{D}}\longrightarrow 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">⟶</mo><msubsup><mi>f</mi><mi>t</mi><mo>∗</mo></msubsup><msub><mi>f</mi><mrow><mi>t</mi><mo lspace="0.222em">∗</mo></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><msub><mi>R</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟶</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><msub><mi>R</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟶</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">⟶</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\longrightarrow f_{t}^{*}f_{t*}{\mathcal{W}}(-(l+1)R_{s})\longrightarrow{\mathcal{W}}(-(l+1)R_{s})\longrightarrow{\mathcal{D}}\longrightarrow 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.SSS2.p5.2" class="ltx_p"><span id="S4.SS5.SSS2.p5.2.1" class="ltx_text">The family of bundles <math id="S4.SS5.SSS2.p5.m2" class="ltx_Math" alttext="{\bf P}{\mathcal{D}}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{D}}_{t}</annotation></semantics></math>, <math id="S4.SS5.SSS2.p5.m3" class="ltx_Math" alttext="t\in{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">t\in{\bf P}^{1}_{t}</annotation></semantics></math>, is the family of directrices of <math id="S4.SS5.SSS2.p5.m4" class="ltx_Math" alttext="{\bf P}{\mathcal{W}}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{W}}_{t}</annotation></semantics></math>. If we let <math id="S4.SS5.SSS2.p5.m5" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> be the hyperplane class associated to the <math id="S4.SS5.SSS2.p5.m6" class="ltx_Math" alttext="{\mathcal{O}}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(1)</annotation></semantics></math> on <math id="S4.SS5.SSS2.p5.m7" class="ltx_Math" alttext="{\bf P}{\mathcal{W}}(-(l+1)R_{s})" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{W}}(-(l+1)R_{s})</annotation></semantics></math>, we get the equality</span></p>
<table id="S4.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex103.m1" class="ltx_Math" alttext="[{\bf P}{\mathcal{D}}]=\eta^{N-1-r}+(a+l)R_{t}\cdot\eta^{N-2-r}" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><msup><mi>η</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>r</mi></mrow></msup><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>η</mi><mrow><mi>N</mi><mo>−</mo><mn>2</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">[{\bf P}{\mathcal{D}}]=\eta^{N-1-r}+(a+l)R_{t}\cdot\eta^{N-2-r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.SSS2.p5.3" class="ltx_p"><span id="S4.SS5.SSS2.p5.3.1" class="ltx_text">in the Chow ring of <math id="S4.SS5.SSS2.p5.m8" class="ltx_Math" alttext="{\bf P}{\mathcal{W}}(-(l+1)R_{s})" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{W}}(-(l+1)R_{s})</annotation></semantics></math>. If we denote by <math id="S4.SS5.SSS2.p5.m9" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> the natural hyperplane class for <math id="S4.SS5.SSS2.p5.m10" class="ltx_Math" alttext="{\bf P}{\mathcal{W}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{W}}</annotation></semantics></math>, we see that <math id="S4.SS5.SSS2.p5.m11" class="ltx_Math" alttext="\eta=\zeta-(l+1)R_{s}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta=\zeta-(l+1)R_{s}</annotation></semantics></math>, and so in terms of <math id="S4.SS5.SSS2.p5.m12" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math>,</span></p>
<table id="S4.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex104.m1" class="ltx_Math" alttext="[{\bf P}{\mathcal{D}}]=\left(\zeta-(l+1)R_{s}\right)^{N-1-r}+(a+l)R_{t}\cdot(\zeta-(l+1)R_{s})^{N-2-r}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>r</mi></mrow></msup><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>2</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[{\bf P}{\mathcal{D}}]=\left(\zeta-(l+1)R_{s}\right)^{N-1-r}+(a+l)R_{t}\cdot(\zeta-(l+1)R_{s})^{N-2-r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.SSS2.p5.4" class="ltx_p"><span id="S4.SS5.SSS2.p5.4.1" class="ltx_text">In the Chow ring of the ambient space <math id="S4.SS5.SSS2.p5.m13" class="ltx_Math" alttext="{\bf P}{\mathcal{V}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{V}}</annotation></semantics></math>,</span></p>
<table id="S4.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex105.m1" class="ltx_Math" alttext="[{\bf P}{\mathcal{D}}]=(\zeta+aR_{s}+R_{t})\cdot\left(\zeta-(l+1)R_{s}\right)^{N-1-r}+(a+l)R_{t}\cdot(\zeta-(l+1)R_{s})^{N-2-r}" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow><mo>+</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>2</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">[{\bf P}{\mathcal{D}}]=(\zeta+aR_{s}+R_{t})\cdot\left(\zeta-(l+1)R_{s}\right)^{N-1-r}+(a+l)R_{t}\cdot(\zeta-(l+1)R_{s})^{N-2-r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS5.SSS2.p6" class="ltx_para">
<p id="S4.SS5.SSS2.p6.1" class="ltx_p"><span id="S4.SS5.SSS2.p6.1.1" class="ltx_text">Now, we want to understand <math id="S4.SS5.SSS2.p6.m1" class="ltx_Math" alttext="{\bf P}{\mathcal{D}}\cap R_{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><mo>∩</mo><msub><mi>R</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{D}}\cap R_{s}</annotation></semantics></math>. In particular, we want to know its class in the Chow ring of <math id="S4.SS5.SSS2.p6.m2" class="ltx_math_unparsed" alttext="X={\bf P}^{N-1}_{\{s=0\}}\times{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mi>𝐏</mi><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>s</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐏</mi><msup><mrow></mrow><mn>1</mn></msup><msub><mrow></mrow><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">X={\bf P}^{N-1}_{\{s=0\}}\times{\bf P}^{1}_{t}</annotation></semantics></math>. So we intersect with <math id="S4.SS5.SSS2.p6.m3" class="ltx_Math" alttext="R_{s}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>s</mi></msub><annotation encoding="application/x-tex">R_{s}</annotation></semantics></math> to obtain</span></p>
<table id="S4.EGx30" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S4.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex106.m1" class="ltx_Math" alttext="\displaystyle[{\bf P}{\mathcal{D}}]\cdot R_{s}=[\left(\zeta-(l+1)R_{s}\right)^{N-1-r}+(a+l)R_{t}\cdot(\zeta-(l+1)R_{s})^{N-2-r}]\cdot[\zeta+aR_{s}+R_{t}]\cdot R_{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>R</mi><mi>s</mi></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>r</mi></mrow></msup><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>2</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">[</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>s</mi></msub></mrow><mo>+</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>R</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle[{\bf P}{\mathcal{D}}]\cdot R_{s}=[\left(\zeta-(l+1)R_{s}\right)^{N-1-r}+(a+l)R_{t}\cdot(\zeta-(l+1)R_{s})^{N-2-r}]\cdot[\zeta+aR_{s}+R_{t}]\cdot R_{s}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS5.SSS2.p7" class="ltx_para">
<p id="S4.SS5.SSS2.p7.1" class="ltx_p"><span id="S4.SS5.SSS2.p7.1.1" class="ltx_text">Using the fact that <math id="S4.SS5.SSS2.p7.m1" class="ltx_Math" alttext="R_{s}^{2}=R_{t}^{2}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>s</mi><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>R</mi><mi>t</mi><mn>2</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{s}^{2}=R_{t}^{2}=0</annotation></semantics></math>, we can easily calculate this product. If we let <math id="S4.SS5.SSS2.p7.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and <math id="S4.SS5.SSS2.p7.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> be the pullbacks of the hyperplane classes in <math id="S4.SS5.SSS2.p7.m4" class="ltx_math_unparsed" alttext="{\bf P}^{N-1}_{\{s=0\}}\times{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>s</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐏</mi><msup><mrow></mrow><mn>1</mn></msup><msub><mrow></mrow><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}^{N-1}_{\{s=0\}}\times{\bf P}^{1}_{t}</annotation></semantics></math>, then the class of the scroll swept out by the directrices of <math id="S4.SS5.SSS2.p7.m5" class="ltx_Math" alttext="{\bf P}{\mathcal{W}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{W}}</annotation></semantics></math> is</span></p>
<table id="S4.Ex107" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex107.m1" class="ltx_math_unparsed" alttext="[{\bf P}{\mathcal{D}}\cap\{s=0\}]=H^{N-r}+(a+l+1)H^{N-r-1}\cdot F," display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>∩</mo><mrow><mo stretchy="false">{</mo><mi>s</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><msup><mi>H</mi><mrow><mi>N</mi><mo>−</mo><mi>r</mi></mrow></msup><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>+</mo><mi>l</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><msup><mi>H</mi><mrow><mi>N</mi><mo>−</mo><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>F</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">[{\bf P}{\mathcal{D}}\cap\{s=0\}]=H^{N-r}+(a+l+1)H^{N-r-1}\cdot F,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.SSS2.p7.2" class="ltx_p"><span id="S4.SS5.SSS2.p7.2.1" class="ltx_text">which is what the proposition claims.
∎</span></p>
</div>
</div>
<div id="S4.SS5.SSS2.p8" class="ltx_para">
<p id="S4.SS5.SSS2.p8.1" class="ltx_p">Therefore, the “degree" of this scroll swept out by the directrices in <math id="S4.SS5.SSS2.p8.m1" class="ltx_math_unparsed" alttext="{\bf P}^{N-1}_{\{s=0\}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>s</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">{\bf P}^{N-1}_{\{s=0\}}</annotation></semantics></math> is <math id="S4.SS5.SSS2.p8.m2" class="ltx_Math" alttext="a+l+1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>+</mo><mi>l</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">a+l+1</annotation></semantics></math>. By this we mean the following: If <math id="S4.SS5.SSS2.p8.m3" class="ltx_math_unparsed" alttext="\Lambda^{N-r-1}\subset{\bf P}^{N-1}_{\{s=0\}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>⊂</mo><mi>𝐏</mi><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>s</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\Lambda^{N-r-1}\subset{\bf P}^{N-1}_{\{s=0\}}</annotation></semantics></math> is a general <math id="S4.SS5.SSS2.p8.m4" class="ltx_Math" alttext="N-r-1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>−</mo><mi>r</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N-r-1</annotation></semantics></math> dimensional subspace, then the family of <math id="S4.SS5.SSS2.p8.m5" class="ltx_Math" alttext="r-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r-1</annotation></semantics></math> dimensional planes <math id="S4.SS5.SSS2.p8.m6" class="ltx_Math" alttext="{\bf P}{\mathcal{D}}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{D}}_{t}</annotation></semantics></math>, <math id="S4.SS5.SSS2.p8.m7" class="ltx_Math" alttext="t\in{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">t\in{\bf P}^{1}_{t}</annotation></semantics></math>, viewed as subspaces of <math id="S4.SS5.SSS2.p8.m8" class="ltx_math_unparsed" alttext="{\bf P}^{N-1}_{\{s=0\}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><msup><mrow></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>s</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">{\bf P}^{N-1}_{\{s=0\}}</annotation></semantics></math>, will intersect <math id="S4.SS5.SSS2.p8.m9" class="ltx_Math" alttext="\Lambda^{N-r-1}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Λ</mi><mrow><mi>N</mi><mo>−</mo><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\Lambda^{N-r-1}</annotation></semantics></math> at <math id="S4.SS5.SSS2.p8.m10" class="ltx_Math" alttext="a+l+1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>+</mo><mi>l</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">a+l+1</annotation></semantics></math> values of <math id="S4.SS5.SSS2.p8.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS5.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.5.3 </h4>

<div id="S4.SS5.SSS3.p1" class="ltx_para">
<p id="S4.SS5.SSS3.p1.1" class="ltx_p">Let <math id="S4.SS5.SSS3.p1.m1" class="ltx_Math" alttext="k_{R}:=\lceil 5(g_{R}+4)/6\rceil" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mi>R</mi></msub><mo>:=</mo><mrow><mo stretchy="false">⌈</mo><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mi>R</mi></msub><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>6</mn></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">k_{R}:=\lceil 5(g_{R}+4)/6\rceil</annotation></semantics></math> and <math id="S4.SS5.SSS3.p1.m2" class="ltx_math_unparsed" alttext="m_{R}:=\lceil-3(g_{R}+4)/4\rceil" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>R</mi></msub><mo>:=</mo><mrow><mo stretchy="false">⌈</mo><mo lspace="0em">−</mo><mn>3</mn><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>R</mi></msub><mo>+</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>4</mn><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">m_{R}:=\lceil-3(g_{R}+4)/4\rceil</annotation></semantics></math>. Then we have:</p>
</div>
<div id="S4.Thmthm34" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm34.2" class="ltx_text ltx_font_bold">Proposition 4.34</span></span><span id="S4.Thmthm34.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm34.p1" class="ltx_para">
<p id="S4.Thmthm34.p1.1" class="ltx_p"><span id="S4.Thmthm34.p1.1.1" class="ltx_text ltx_font_italic">Maintain the setting of section <a href="#S4.SS4.SSS5" title="4.4.5 ‣ 4.4 Degree five analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4.5</span></a>. The intersection number of the partial pencil <math id="S4.Thmthm34.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> with the Maroni divisor <math id="S4.Thmthm34.p1.m2" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> is:</span></p>
<table id="S4.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex108.m1" class="ltx_Math" alttext="{\mathsf{M}}\cdot p=k_{R}+m_{R}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝖬</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo>=</mo><mrow><msub><mi>k</mi><mi>R</mi></msub><mo>+</mo><msub><mi>m</mi><mi>R</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{M}}\cdot p=k_{R}+m_{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS5.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS5.SSS3.p2" class="ltx_para">
<p id="S4.SS5.SSS3.p2.1" class="ltx_p"><span id="S4.SS5.SSS3.p2.1.1" class="ltx_text">This follows from <a href="#S4.Thmthm33" title="Proposition 4.33 (Rotating directrices). ‣ 4.5.2 ‣ 4.5 A proposition on “rotating directrices.” ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.33</span></a> with the substitutions <math id="S4.SS5.SSS3.p2.m1" class="ltx_Math" alttext="{\mathcal{V}}:={\mathcal{E}}_{{\bf F}},a=k_{R}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>:=</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐅</mi></msub></mrow><mo>,</mo><mrow><mi>a</mi><mo>=</mo><msub><mi>k</mi><mi>R</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{V}}:={\mathcal{E}}_{{\bf F}},a=k_{R},</annotation></semantics></math> and <math id="S4.SS5.SSS3.p2.m2" class="ltx_Math" alttext="l+1=m_{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo>=</mo><msub><mi>m</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">l+1=m_{R}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm35" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm35.2" class="ltx_text ltx_font_italic">Remark 4.35</span></span><span id="S4.Thmthm35.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmthm35.p1" class="ltx_para">
<p id="S4.Thmthm35.p1.1" class="ltx_p">There remains to understand the case when the splitting type of <math id="S4.Thmthm35.p1.m1" class="ltx_Math" alttext="{\mathcal{W}}_{t}={\mathcal{O}}(l+1)^{N-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>t</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{W}}_{t}={\mathcal{O}}(l+1)^{N-1}</annotation></semantics></math>, i.e. the generic scroll is perfectly balanced.</p>
</div>
<div id="S4.Thmthm35.p2" class="ltx_para">
<p id="S4.Thmthm35.p2.1" class="ltx_p">Then for finitely many <math id="S4.Thmthm35.p2.m1" class="ltx_Math" alttext="t\in{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">t\in{\bf P}^{1}_{t}</annotation></semantics></math>, the scroll <math id="S4.Thmthm35.p2.m2" class="ltx_Math" alttext="{\bf P}{\mathcal{W}}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{W}}_{t}</annotation></semantics></math> will change splitting type to <math id="S4.Thmthm35.p2.m3" class="ltx_Math" alttext="{\mathcal{O}}(l)\oplus{\mathcal{O}}(l+1)^{\oplus N-2}\oplus{\mathcal{O}}(l+2)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mi>N</mi></mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(l)\oplus{\mathcal{O}}(l+1)^{\oplus N-2}\oplus{\mathcal{O}}(l+2)</annotation></semantics></math>. The number of times this occurs is easily calculated, and the result is still <math id="S4.Thmthm35.p2.m4" class="ltx_Math" alttext="a+l+1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>+</mo><mi>l</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">a+l+1</annotation></semantics></math>.</p>
</div>
</div>
</section>
<section id="S4.SS5.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.5.4 Intersection numbers for the partial pencil <math id="S4.SS5.SSS4.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.</h4>

<div id="S4.SS5.SSS4.p1" class="ltx_para">
<p id="S4.SS5.SSS4.p1.1" class="ltx_p">Let <math id="S4.SS5.SSS4.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> be as in section <a href="#S4.SS4.SSS5" title="4.4.5 ‣ 4.4 Degree five analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4.5</span></a>, and let <math id="S4.SS5.SSS4.p1.m2" class="ltx_Math" alttext="k_{R}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>R</mi></msub><annotation encoding="application/x-tex">k_{R}</annotation></semantics></math> and <math id="S4.SS5.SSS4.p1.m3" class="ltx_Math" alttext="m_{R}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>R</mi></msub><annotation encoding="application/x-tex">m_{R}</annotation></semantics></math> be as in the previous section.</p>
</div>
<div id="S4.SS5.SSS4.p2" class="ltx_para">
<p id="S4.SS5.SSS4.p2.1" class="ltx_p">The split element in <math id="S4.SS5.SSS4.p2.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> gives an intersection with a new divisor <math id="S4.SS5.SSS4.p2.m2" class="ltx_Math" alttext="\Delta_{{\rm split}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><annotation encoding="application/x-tex">\Delta_{{\rm split}}</annotation></semantics></math> with dual graph <math id="S4.SS5.SSS4.p2.m3" class="ltx_Math" alttext="\Gamma_{\Delta_{{\rm split}}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub></msub><annotation encoding="application/x-tex">\Gamma_{\Delta_{{\rm split}}}</annotation></semantics></math>:</p>
</div>
<div id="S4.SS5.SSS4.p3" class="ltx_para">
<table id="S4.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
