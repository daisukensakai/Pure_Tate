n class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex44.m1.pic1.41" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(17.86,-23.62)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex44.m1.pic1.42" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(13.06,-23.62)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex44.m1.pic1.43" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(8.26,-23.62)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex44.m1.pic1.44" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(3.46,-23.62)"><fore