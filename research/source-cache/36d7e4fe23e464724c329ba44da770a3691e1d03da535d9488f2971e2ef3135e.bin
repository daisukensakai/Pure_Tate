<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex40.m2" class="ltx_Math" alttext="\displaystyle=1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle=1</annotation></semantics></math></td>
