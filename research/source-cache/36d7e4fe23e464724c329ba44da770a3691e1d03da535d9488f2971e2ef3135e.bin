0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex21.m1.pic1.28" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(8.26,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex21.m1.pic1.29" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(3.46,0)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex21.m1.pic1.30" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS4.p1.2" class="ltx_p">As before, we let <math id="S4.SS1.SSS4.p1.m4" class="ltx_Math" alttext="g_{R},g_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>R</mi></msub><mo>,</mo><msub><mi>g</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">g_{R},g_{L}</annotation></semantics></math> denote the genera of <math id="S4.SS1.SSS4.p1.m5" class="ltx_Math" alttext="v_{R},v_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>R</mi></msub><mo>,</mo><msub><mi>v</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">v_{R},v_{L}</annotation></semantics></math> and assume that <math id="S4.SS1.SSS4.p1.m6" class="ltx_Math" alttext="g_{R}\leq g_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>R</mi></msub><mo>≤</mo><msub><mi>g</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">g_{R}\leq g_{L}</annotation></semantics></math>. We consider the partial pencil <math id="S4.SS1.SSS4.p1.m7" class="ltx_Math" alttext="p^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mo>′</mo></msup><annotation encoding="application/x-tex">p^{\prime}</annotation></semantics></math> whose intersection numbers are recorded in <a href="#S4.Thmthm6" title="Proposition 4.6. ‣ 4.1.3 
            
              2
            
          -vertex divisors II. ‣ 4.1 Degree three analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.6</span></a>.</p>
</div>
<div id="S4.Thmthm7" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm7.2" class="ltx_text ltx_font_bold">Lemma 4.7</span></span><span id="S4.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm7.p1" class="ltx_para">
<p id="S4.Thmthm7.p1.1" class="ltx_p"><span id="S4.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">We have the following inequality:</span></p>
<table id="S4.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E2.m1" class="ltx_Math" alttext="c(\Delta,{{\mathsf{Y}}})\geq c(\Delta_{{\rm split}},{{\mathsf{Y}}})+c(\Delta_{{\rm ram}},{{\mathsf{Y}}})+4g-6g_{R}" display="block" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>ram</mi></msub><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mo>−</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">c(\Delta,{{\mathsf{Y}}})\geq c(\Delta_{{\rm split}},{{\mathsf{Y}}})+c(\Delta_{{\rm ram}},{{\mathsf{Y}}})+4g-6g_{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.2)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.SSS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.SSS4.p2" class="ltx_para">
<p id="S4.SS1.SSS4.p2.1" class="ltx_p"><span id="S4.SS1.SSS4.p2.1.1" class="ltx_text">We intersect <math id="S4.SS1.SSS4.p2.m1" class="ltx_Math" alttext="p^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mo>′</mo></msup><annotation encoding="application/x-tex">p^{\prime}</annotation></semantics></math> with <math id="S4.SS1.SSS4.p2.m2" class="ltx_Math" alttext="{\mathsf{X}}=a\lambda-b\delta-{{\mathsf{Y}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝖷</mi><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>−</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>−</mo><mi>𝖸</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{X}}=a\lambda-b\delta-{{\mathsf{Y}}}</annotation></semantics></math> and use <a href="#S4.Thmthm6" title="Proposition 4.6. ‣ 4.1.3 
            
              2
            
          -vertex divisors II. ‣ 4.1 Degree three analysis. ‣ 4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">4.6</span></a>.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm8" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm8.2" class="ltx_text ltx_font_bold">Corollary 4.8</span></span><span id="S4.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm8.p1" class="ltx_para">
<p id="S4.Thmthm8.p1.1" class="ltx_p"><span id="S4.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">Keep the setting of the previous lemma. If <math id="S4.Thmthm8.p1.m1" class="ltx_Math" alttext="c(\Delta_{{\rm split}},{{\mathsf{Y}}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta_{{\rm split}},{{\mathsf{Y}}})\geq 0</annotation></semantics></math> and <math id="S4.Thmthm8.p1.m2" class="ltx_Math" alttext="c(\Delta_{{\rm ram}},{{\mathsf{Y}}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>ram</mi></msub><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta_{{\rm ram}},{{\mathsf{Y}}})\geq 0</annotation></semantics></math> , then <math id="S4.Thmthm8.p1.m3" class="ltx_Math" alttext="c(\Delta,{{\mathsf{Y}}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta,{{\mathsf{Y}}})\geq 0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.Thmthm9" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm9.2" class="ltx_text ltx_font_bold">Proposition 4.9</span></span><span id="S4.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm9.p1" class="ltx_para">
<p id="S4.Thmthm9.p1.1" class="ltx_p"><span id="S4.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">Keeping the same setting as the previous corollary, we have:</span></p>
<table id="S4.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex22.m1" class="ltx_Math" alttext="c(\Delta,{\mathsf{Y}})\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c(\Delta,{\mathsf{Y}})\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.SSS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.SSS4.p3" class="ltx_para">
<p id="S4.SS1.SSS4.p3.1" class="ltx_p"><span id="S4.SS1.SSS4.p3.1.1" class="ltx_text">The family <math id="S4.SS1.SSS4.p3.m1" class="ltx_Math" alttext="p^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mo>′</mo></msup><annotation encoding="application/x-tex">p^{\prime}</annotation></semantics></math> has a split element corresponding to an intersection with the divisor <math id="S4.SS1.SSS4.p3.m2" class="ltx_Math" alttext="\Delta_{{\rm split}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><annotation encoding="application/x-tex">\Delta_{{\rm split}}</annotation></semantics></math> which has dual graph:</span></p>
</div>
<div id="S4.SS1.SSS4.p4" class="ltx_para">
<table id="S4.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S4.Ex23.m1.pic1" class="ltx_picture ltx_markedasmath" height="33.21" overflow="visible" style="vertical-align:-16.481772454856788px" version="1.1" viewBox="29.49 16.48 135.60 33.21" width="135.60"><g transform="matrix(1 0 0 -1 29.49158449596565 33.21213627877664) translate(0,3.46) translate(29.49,0)"><g transform="translate(-3.46,0) translate(0,-3.07)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:10pt;" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 6.15)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex23.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{\bullet}" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\textstyle{\bullet}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(-22.56,0) translate(0,7.87) translate(4.15,0) translate(0,-3.31)"><foreignObject style="--ltx-fo-width:0.95em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.1em;font-size:10pt;" height="9.41" overflow="visible" transform="matrix(1 0 0 -1 0 8.02)" width="13.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.Ex23.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{\scriptstyle v^{\prime}_{L}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">v</mi><mi mathsize="0.710em">L</mi><mo mathsize="0.710em">′</mo></msubsup><annotation encoding="application/x-tex">\textstyle{\scriptstyle v^{\prime}_{L}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(-29.49,0) translate(0,-8.27) translate(4.15,0) translate(0,-2.18)"><foreignObject style="--ltx-fo-width:1.96em;--ltx-fo-height:0.45em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.13" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="27.06"><sp