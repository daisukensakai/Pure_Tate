<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex54.m1" class="ltx_Math" alttext="\displaystyle\lambda\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\lambda\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex54.m2" class="ltx_Math" alttext="\displaystyle=g_{R}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=g_{R}</annotation></semantics></math></td>
