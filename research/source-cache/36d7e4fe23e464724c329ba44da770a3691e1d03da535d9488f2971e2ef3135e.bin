pan class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex43.m1.pic1.42" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(13.06,-11.76)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex43.m1.pic1.43" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(8.26,-11.16)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex43.m1.pic1.44" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(3.46,-10.56)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.Ex43.m1.pic1.45" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS7.p6.2" class="ltx_p"><span id="S4.SS1.SSS7.p6.2.1" class="ltx_text">However, this dual graph is actually "unstable" in <math id="S4.SS1.SSS7.p6.m4" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> - the corresponding cover in <math id="S4.SS1.SSS7.p6.m5" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> is just an irreducible nodal curve whose normalization is the curve represented by <math id="S4.SS1.SSS7.p6.m6" class="ltx_Math" alttext="v_{L}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>L</mi></msub><annotation encoding="application/x-tex">v_{L}</annotation></semantics></math>. Therefore, this is an intersection with <math id="S4.SS1.SSS7.p6.m7" class="ltx_Math" alttext="\Delta_{{\rm irr}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>irr</mi></msub><annotation encoding="application/x-tex">\Delta_{{\rm irr}}</annotation></semantics></math>, which has coefficient <math id="S4.SS1.SSS7.p6.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> in the divisor class <math id="S4.SS1.SSS7.p6.m9" class="ltx_Math" alttext="{\mathsf{Y}}" display="inline" intent=":literal"><semantics><mi>𝖸</mi><annotation encoding="application/x-tex">{\mathsf{Y}}</annotation></semantics></math>. (Recall that <math id="S4.SS1.SSS7.p6.m10" class="ltx_Math" alttext="{\mathsf{Y}}" display="inline" intent=":literal"><semantics><mi>𝖸</mi><annotation encoding="application/x-tex">{\mathsf{Y}}</annotation></semantics></math> is supported on the higher boundary divisors.)
∎</span></p>
</div>
</div>
</section>
<section id="S4.SS1.SSS8" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.1.8 <math id="S4.SS1.SSS8.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> vertices.</h4>

<div id="S4.SS1.SSS8.p1" class="ltx_para">
<p id="S4.SS1.SSS8.p1.1" class="ltx_p">Now suppose the dual graph for <math id="S4.SS1.SSS8.p1.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> looks like <math id="S4.SS1.SSS8.p1.m2" class="ltx_Math" alttext="\Gamma_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">\Gamma_{\Delta}</annotation></semantics></math>:</p>
<table id="S4.Ex44" class="ltx_equation ltx_eqn_table">

