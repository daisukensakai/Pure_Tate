<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex69.m1" class="ltx_Math" alttext="\displaystyle\Delta\cdot p^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\Delta\cdot p^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex69.m2" class="ltx_Math" alttext="\displaystyle=-1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0em">=</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex70.m1" class="ltx_Math" alttext="\displaystyle\Delta_{{\rm split}}\cdot p^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>split</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{{\rm split}}\cdot p^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex70.m2" class="ltx_Math" alttext="\displaystyle=1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle=1</annotation></semantics></math></td>
