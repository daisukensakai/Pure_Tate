<div id="S4.Thmthm14" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm14.2" class="ltx_text ltx_font_bold">Proposition 4.14</span></span><span id="S4.Thmthm14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm14.p1" class="ltx_para">
<p id="S4.Thmthm14.p1.1" class="ltx_p"><span id="S4.Thmthm14.p1.1.1" class="ltx_text ltx_font_italic">The intersection numbers for <math id="S4.Thmthm14.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> are:</span></p>
<table id="S4.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex37.m1" class="ltx_Math" alttext="\displaystyle\lambda\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\lambda\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex37.m2" class="ltx_Math" alttext="\displaystyle=g_{R}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=g_{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex38.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex38.m2" class="ltx_Math" alttext="\displaystyle=8g_{R}+2" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=8g_{R}+2</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex39.m1" class="ltx_Math" alttext="\displaystyle\Delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\Delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex39.m2" class="ltx_Math" alttext="\displaystyle=-1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0em">=</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-1</annotation></semantics></math></td>
