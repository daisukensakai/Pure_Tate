<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex72.m2" class="ltx_Math" alttext="\displaystyle\geq 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\geq 0</annotation></semantics></math></td>
