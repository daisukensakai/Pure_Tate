0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.66" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(120.61,-30.54)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.67" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(115.81,-31.5)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.68" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(111.01,-32.46)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.69" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(106.2,-33.42)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.70" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(101.4,-34.38)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.71" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(96.6,-35.34)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.72" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(91.8,-36.3)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.73" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(87,-37.26)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.74" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g><g transform="translate(82.2,-38.22)"><foreignObject style="--ltx-fo-width:0.33em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="4.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">-</span></span></foreignObject><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.Ex37.m1.pic1.75" class="ltx_ERROR undefined">\crvi</span></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.SS14.SSS3.p16" class="ltx_para">
<p id="S2.SS14.SSS3.p16.1" class="ltx_p"><span id="S2.SS14.SSS3.p16.1.1" class="ltx_text">We then vary the genus <math id="S2.SS14.SSS3.p16.m1" class="ltx_Math" alttext="g(v)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(v)</annotation></semantics></math> vertex <math id="S2.SS14.SSS3.p16.m2" class="ltx_Math" alttext="v^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>′</mo></msup><annotation encoding="application/x-tex">v^{\prime}</annotation></semantics></math> in a pencil of <math id="S2.SS14.SSS3.p16.m3" class="ltx_Math" alttext="|2\tau+f|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo>+</mo><mi>f</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|2\tau+f|</annotation></semantics></math> hyperelliptic curves in <math id="S2.SS14.SSS3.p16.m4" class="ltx_Math" alttext="{\bf F}_{g_{v}}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><msub><mi>g</mi><mi>v</mi></msub></msub><annotation encoding="application/x-tex">{\bf F}_{g_{v}}</annotation></semantics></math> as in section <a href="#S2.SS13.SSS2" title="2.13.2 Hyperelliptic families. ‣ 2.13 Some explicit partial pencils. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.13.2</span></a>.</span></p>
</div>
<div id="S2.SS14.SSS3.p17" class="ltx_para">
<p id="S2.SS14.SSS3.p17.1" class="ltx_p"><span id="S2.SS14.SSS3.p17.1.1" class="ltx_text">The resulting test curve will produce a reduction in total excess. We continue using such families to reduce excess to zero.</span></p>
</div>
<div id="S2.SS14.SSS3.p18" class="ltx_para">
<p id="S2.SS14.SSS3.p18.1" class="ltx_p"><span id="S2.SS14.SSS3.p18.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S2.SS14.SSS3.p19" class="ltx_para">
<p id="S2.SS14.SSS3.p19.1" class="ltx_p">Finally, we show that the enumeratively relevant coefficients are zero.</p>
</div>
<div id="S2.Thmthm20" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmthm20.2" class="ltx_text ltx_font_bold">Proposition 2.20</span></span><span id="S2.Thmthm20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmthm20.p1" class="ltx_para">
<p id="S2.Thmthm20.p1.1" class="ltx_p"><span id="S2.Thmthm20.p1.1.1" class="ltx_text ltx_font_italic">The enumeratively relevant coefficients <math id="S2.Thmthm20.p1.m1" class="ltx_Math" alttext="c(\Delta^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Δ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c(\Delta^{\prime})</annotation></semantics></math> are zero.</span></p>
</div>
</div>
<div id="S2.SS14.SSS3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS14.SSS3.p20" class="ltx_para">
<p id="S2.SS14.SSS3.p20.1" class="ltx_p"><span id="S2.SS14.SSS3.p20.1.1" class="ltx_text">This proposition follows from <a href="#S2.Thmthm15" title="Lemma 2.15. ‣ Proof. ‣ 2.14.1 Independence of the boundary of 
            
              
                
                
                  ~
                  H
                
                
                  
                    
                    
                    
                  
                  
                    d
                    ,
                    g
                  
                
              
            
          . ‣ 2.14 Independence of the boundary. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">2.15</span></a>, as we now explain. We note that the Picard groups of the moduli stacks <math id="S2.SS14.SSS3.p20.m1" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{d,g},\overline{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{d,g},\overline{{\mathcal{H}}}_{d,g}</annotation></semantics></math> are the same as that of their coarse spaces after tensoring with <math id="S2.SS14.SSS3.p20.m2" class="ltx_Math" alttext="{\bf Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">{\bf Q}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS14.SSS3.p21" class="ltx_para">
<p id="S2.SS14.SSS3.p21.1" class="ltx_p"><span id="S2.SS14.SSS3.p21.1.1" class="ltx_text">The moduli spaces <math id="S2.SS14.SSS3.p21.m1" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}</annotation></semantics></math> and <math id="S2.SS14.SSS3.p21.m2" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{d,g}</annotation></semantics></math> share a common open subspace. This means there is a rational map of coarse varieties</span></p>
<table id="S2.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex38.m1" class="ltx_Math" alttext="G{\colon}\widetilde{H}_{d,g}\longrightarrow\overline{H}_{d,g}" display="block" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mover accent="true"><mi>H</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><mo stretchy="false">⟶</mo><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">G{\colon}\widetilde{H}_{d,g}\longrightarrow\overline{H}_{d,g}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS14.SSS3.p21.2" class="ltx_p"><span id="S2.SS14.SSS3.p21.2.1" class="ltx_text">where <math id="S2.SS14.SSS3.p21.m3" class="ltx_Math" alttext="\widetilde{H}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>H</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{H}_{d,g}</annotation></semantics></math> and <math id="S2.SS14.SSS3.p21.m4" class="ltx_Math" alttext="\overline{H}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\overline{H}_{d,g}</annotation></semantics></math> denote coarse spaces. The birational map <math id="S2.SS14.SSS3.p21.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is defined away from a codimension two set in <math id="S2.SS14.SSS3.p21.m6" class="ltx_Math" alttext="\widetilde{H}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>H</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{H}_{d,g}</annotation></semantics></math>, and is one-to-one on the level of points.</span></p>
</div>
<div id="S2.SS14.SSS3.p22" class="ltx_para">
<p id="S2.SS14.SSS3.p22.1" class="ltx_p"><span id="S2.SS14.SSS3.p22.1.1" class="ltx_text">The boundary divisors in the image of <math id="S2.SS14.SSS3.p22.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> are precisely the enumeratively relevant divisors. Therefore, any hypothetical nontrivial relation <a href="#S2.E3" title="In 2.14.2 ‣ 2.14 Independence of the boundary. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> would pull back to a nontrivial relation in <math id="S2.SS14.SSS3.p22.m2" class="ltx_Math" alttext="{\rm Pic}_{{\bf Q}}\,\widetilde{H}_{d,g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pic</mi><mi>𝐐</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>H</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\rm Pic}_{{\bf Q}}\,\widetilde{H}_{d,g}</annotation></semantics></math>, which <a href="#S2.Thmthm14" title="Proposition 2.14. ‣ 2.14.1 Independence of the boundary of 
            
              
                
                
                  ~
                  H
                
                
                  
                    
                    
                    
                  
                  
                    d
                    ,
                    g
                  
                
              
            
          . ‣ 2.14 Independence of the boundary. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">2.14</span></a> prohibits. Thus our proposition follows from <a href="#S2.Thmthm14" title="Proposition 2.14. ‣ 2.14.1 Independence of the boundary of 
            
              
                
                
                  ~
                  H
                
                
                  
                    
                    
                    
                  
                  
                    d
                    ,
                    g
                  
                
              
            
          . ‣ 2.14 Independence of the boundary. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">2.14</span></a>.
∎</span></p>
</div>
</div>
<div id="S2.SS14.SSS3.p23" class="ltx_para">
<p id="S2.SS14.SSS3.p23.1" class="ltx_p"><a href="#Thmmaintheorem1" title="Theorem A (Independence of the boundary). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">A</span></a>now follows from <a href="#S2.Thmthm18" title="Lemma 2.18. ‣ 2.14.3 ‣ 2.14 Independence of the boundary. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">2.18</span></a>, <a href="#S2.Thmthm19" title="Lemma 2.19. ‣ 2.14.3 ‣ 2.14 Independence of the boundary. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">2.19</span></a>, and <a href="#S2.Thmthm20" title="Proposition 2.20. ‣ 2.14.3 ‣ 2.14 Independence of the boundary. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">2.20</span></a>.</p>
</div>
</section>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>One parameter families and <a href="#Thmmaintheorem2" title="Theorem B (Rigidity and Extremality). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">B</span></a>.</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">Throughout this section, we work primarily in the partial compactification <math id="S3.p1.m1" class="ltx_Math" alttext="\widetilde{\mathcal{H}}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{H}}_{d,g}</annotation></semantics></math>. Our first goal is to understand basic numerical quantities attached to general complete one parameter families in <math id="S3.p1.m2" class="ltx_Math" alttext="\widetilde{\mathcal{H}}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{H}}_{d,g}</annotation></semantics></math>.</p>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">Next, we investigate basic families of trigonal, tetragonal, and pentagonal curves. The existence of these families leads to the proof of <a href="#Thmmaintheorem2" title="Theorem B (Rigidity and Extremality). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">B</span></a>, which we naturally break into three parts by the degree.</p>
</div>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p">Finally, we end by discussing a purely speculative approach to showing extremality/rigidity of the Maroni divisor for higher degrees <math id="S3.p3.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.1 </h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">Let</p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex1.m1.pic1" class="ltx_picture ltx_markedasmath" height="63.46" overflow="visible" style="vertical-align:-50.985490168973556px" version="1.1" viewBox="9.15 50.99 84.95 63.46" width="84.95"><g transform="matrix(1 0 0 -1 9.147799227830532 63.458003657346154) translate(0,3.46) translate(9.15,0)"><g transform="translate(-9.15,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.72em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex1.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{{\mathcal{C}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\textstyle{{\mathcal{C}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.147799227830532 -0.27673578005007266 L 9.147799227830532 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(25.36,0) translate(0,6.24) translate(4.15,0) translate(0,-2.09)"><foreignObject style="--ltx-fo-width:0.52em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="7.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex1.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\alpha}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">α</mi><annotation encoding="application/x-tex">\scriptstyle{\alpha}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(56.62,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.147799227830532 -0.27673578005007266 L 56.62000969400771 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 56.62000969400771 -0.27673578005007266 L 56.62000969400771 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 5.759786434550989 -7.610350076103501 L 5.815843007072004 -7.615818495042462" fill="none" stroke="#000000"></path><g transform="translate(1.66,0) translate(0,-28.1) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex1.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{f}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">f</mi><annotation encoding="application/x-tex">\scriptstyle{f}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(25.2,0) translate(0,-33.23)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -1.97 7.19" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.38 3.84" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 5.759786434550989 -7.610350076103501 L 25.204217366299986 -33.228034809514234" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 25.14816079377897 -33.228034809514234 L 25.204217366299986 -33.228034809514234" fill="none" stroke="#000000"></path><g transform="translate(56.62,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.79em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="10.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex1.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{{\bf P}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">\textstyle{{\bf P}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 60.360809406403504 -7.610350076103501 L 60.360809406403504 -7.610350076103501" fill="none" stroke="#000000"></path><g transform="translate(49.55,0) translate(0,-27.2) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex1.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{p}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">p</mi><annotation encoding="application/x-tex">\scriptstyle{p}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(40.68,0) translate(0,-33.23)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 6.41 3.8" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 2.02 7.17" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 60.360809406403504 -7.610350076103501 L 40.68250327547738 -33.228034809514234" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 40.68250327547738 -33.228034809514234 L 40.68250327547738 -33.228034809514234" fill="none" stroke="#000000"></path><g transform="translate(24.09,0) translate(0,-43.38) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.67em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex1.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{S}" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\textstyle{S}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">be a family of degree <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> branched coverings <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="\alpha_{s}:C_{s}\longrightarrow{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>s</mi></msub><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha_{s}:C_{s}\longrightarrow{\bf P}^{1}</annotation></semantics></math>, <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math>, where <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="{\bf P}:={\bf P}^{1}\times S" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>:=</mo><mrow><msup><mi>𝐏</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">{\bf P}:={\bf P}^{1}\times S</annotation></semantics></math>. Suppose <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is a complete smooth curve, and <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is generically smooth with genus <math id="S3.SS1.p1.m7" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> at-worst-nodal fibers. In other words, we have a family <math id="S3.SS1.p1.m8" class="ltx_Math" alttext="S\longrightarrow\widetilde{\mathcal{H}}_{d,g}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">⟶</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">S\longrightarrow\widetilde{\mathcal{H}}_{d,g}</annotation></semantics></math> not entirely lying in the boundary.</p>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">Our first task is to compute the invariants <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> and <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> for the family <math id="S3.SS1.p2.m3" class="ltx_Math" alttext="f{\colon}{\mathcal{C}}\longrightarrow S" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">⟶</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">f{\colon}{\mathcal{C}}\longrightarrow S</annotation></semantics></math> in terms of the Chern classes of the Tschirnhausen bundle <math id="S3.SS1.p2.m4" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math> and the bundle of quadrics <math id="S3.SS1.p2.m5" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> associated to the branched covering of surfaces <math id="S3.SS1.p2.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>. Here, <math id="S3.SS1.p2.m7" class="ltx_Math" alttext="\lambda=c_{1}({\bf E}^{g})" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐄</mi><mi>g</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda=c_{1}({\bf E}^{g})</annotation></semantics></math> where <math id="S3.SS1.p2.m8" class="ltx_Math" alttext="{\bf E}^{g}:=f_{*}(\omega_{f})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐄</mi><mi>g</mi></msup><mo>:=</mo><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf E}^{g}:=f_{*}(\omega_{f})</annotation></semantics></math> is the Hodge bundle, and <math id="S3.SS1.p2.m9" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> denotes the number of singular fibers counted with the usual multiplicity.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.2 </h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">Recall that the bundle <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="{\mathcal{E}}^{\vee}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><annotation encoding="application/x-tex">{\mathcal{E}}^{\vee}</annotation></semantics></math> for the map <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is defined by the formula:</p>
<table id="S3.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E1.m1" class="ltx_Math" alttext="\alpha_{*}{\mathcal{O}}_{{\mathcal{C}}}={\mathcal{O}}_{{\bf P}}\oplus{\mathcal{E}}^{\vee}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐏</mi></msub><mo>⊕</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha_{*}{\mathcal{O}}_{{\mathcal{C}}}={\mathcal{O}}_{{\bf P}}\oplus{\mathcal{E}}^{\vee}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.1)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">In what follows, <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="ch" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">ch</annotation></semantics></math> and <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="ch_{k}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">ch_{k}</annotation></semantics></math> will denote the Chern character and the degree <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> part of the Chern character, respectively.</p>
</div>
<div id="S3.Thmthm1" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm1.2" class="ltx_text ltx_font_bold">Proposition 3.1</span></span><span id="S3.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm1.p1" class="ltx_para">
<p id="S3.Thmthm1.p1.1" class="ltx_p"><span id="S3.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">For the family <math id="S3.Thmthm1.p1.m1" class="ltx_Math" alttext="f{\colon}{\mathcal{C}}\longrightarrow S" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">⟶</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">f{\colon}{\mathcal{C}}\longrightarrow S</annotation></semantics></math> above, we have:</span></p>
<table id="S3.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E2.m1" class="ltx_Math" alttext="\displaystyle\lambda=ch_{2}({\mathcal{E}})-\frac{c_{1}^{2}({\mathcal{E}})}{b}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>b</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda=ch_{2}({\mathcal{E}})-\frac{c_{1}^{2}({\mathcal{E}})}{b}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.2)</span></td></tr></tbody>
<tbody id="S3.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E3.m1" class="ltx_Math" alttext="\displaystyle\kappa=d\cdot ch_{2}{\mathcal{E}}-ch_{2}{\mathcal{F}}+\left(\frac{1}{2}-\frac{8}{b}\right)c_{1}^{2}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>=</mo><mrow><mrow><mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>c</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>8</mn><mi>b</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\kappa=d\cdot ch_{2}{\mathcal{E}}-ch_{2}{\mathcal{F}}+\left(\frac{1}{2}-\frac{8}{b}\right)c_{1}^{2}{\mathcal{E}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.3)</span></td></tr></tbody>
<tbody id="S3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E4.m1" class="ltx_Math" alttext="\displaystyle\delta=(12-d)ch_{2}{\mathcal{E}}+ch_{2}{\mathcal{F}}-\left(\frac{1}{2}-\frac{4}{b}\right)c_{1}^{2}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>12</mn><mo>−</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>4</mn><mi>b</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\delta=(12-d)ch_{2}{\mathcal{E}}+ch_{2}{\mathcal{F}}-\left(\frac{1}{2}-\frac{4}{b}\right)c_{1}^{2}{\mathcal{E}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.4)</span></td></tr></tbody>
</table>
<p id="S3.Thmthm1.p1.2" class="ltx_p"><span id="S3.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S3.Thmthm1.p1.m2" class="ltx_Math" alttext="b=2g+2d-2" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">b=2g+2d-2</annotation></semantics></math> is the number of branch points.</span></p>
</div>
</div>
<div id="S3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p"><span id="S3.SS2.p2.1.1" class="ltx_text">First we recall that the Grothendieck-Riemann-Roch formula yields:</span></p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_Math" alttext="\lambda=\chi({\mathcal{O}}_{{\mathcal{C}}})-\chi({\mathcal{O}}_{S})(1-g)." display="block" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>=</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lambda=\chi({\mathcal{O}}_{{\mathcal{C}}})-\chi({\mathcal{O}}_{S})(1-g).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p2.2" class="ltx_p"><span id="S3.SS2.p2.2.1" class="ltx_text">Since <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="\chi({\mathcal{O}}_{{\mathcal{C}}})=\chi(\alpha_{*}{\mathcal{O}}_{{\mathcal{C}}})=\chi({\mathcal{O}}_{{\bf P}})+\chi({\mathcal{E}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐏</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi({\mathcal{O}}_{{\mathcal{C}}})=\chi(\alpha_{*}{\mathcal{O}}_{{\mathcal{C}}})=\chi({\mathcal{O}}_{{\bf P}})+\chi({\mathcal{E}}^{\vee})</annotation></semantics></math> we get:</span></p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\lambda=\chi({\mathcal{O}}_{{\bf P}})+\chi({\mathcal{E}}^{\vee})-(1-g)\chi({\mathcal{O}}_{S})." display="block" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>=</mo><mrow><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐏</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lambda=\chi({\mathcal{O}}_{{\bf P}})+\chi({\mathcal{E}}^{\vee})-(1-g)\chi({\mathcal{O}}_{S}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p"><span id="S3.SS2.p3.1.1" class="ltx_text">We calculate <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="\chi({\mathcal{E}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi({\mathcal{E}}^{\vee})</annotation></semantics></math> by applying the Hirzebruch-Reimann-Roch formula to the bundle <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="{\mathcal{E}}^{\vee}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><annotation encoding="application/x-tex">{\mathcal{E}}^{\vee}</annotation></semantics></math>. This says that</span></p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_Math" alttext="\chi({\mathcal{E}}^{\vee})=[ch({\mathcal{E}}^{\vee})\cdot Td(T_{{\bf P}})]_{2}=ch_{2}({\mathcal{E}}^{\vee})+c_{1}({\mathcal{E}})(K_{{\bf P}}/2)+(d-1)\chi({\mathcal{O}}_{{\bf P}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>𝐏</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msub><mo>=</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mi>𝐏</mi></msub><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐏</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\chi({\mathcal{E}}^{\vee})=[ch({\mathcal{E}}^{\vee})\cdot Td(T_{{\bf P}})]_{2}=ch_{2}({\mathcal{E}}^{\vee})+c_{1}({\mathcal{E}})(K_{{\bf P}}/2)+(d-1)\chi({\mathcal{O}}_{{\bf P}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p"><span id="S3.SS2.p4.1.1" class="ltx_text">Let <math id="S3.SS2.p4.m1" class="ltx_Math" alttext="\sigma\in{\rm Pic}\,_{{\bf Q}}{\bf P}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>∈</mo><mrow><msub><mi>Pic</mi><mi>𝐐</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><mi>𝐏</mi></mrow></mrow><annotation encoding="application/x-tex">\sigma\in{\rm Pic}\,_{{\bf Q}}{\bf P}</annotation></semantics></math> denote the rational section class <math id="S3.SS2.p4.m2" class="ltx_math_unparsed" alttext="[-\omega_{p}/2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><msub><mi>ω</mi><mi>p</mi></msub><mo>/</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-\omega_{p}/2]</annotation></semantics></math>, so that <math id="S3.SS2.p4.m3" class="ltx_Math" alttext="\sigma^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma^{2}=0</annotation></semantics></math>. Since the degree of <math id="S3.SS2.p4.m4" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math> is <math id="S3.SS2.p4.m5" class="ltx_Math" alttext="g+d-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>+</mo><mi>d</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g+d-1</annotation></semantics></math> when restricted to any <math id="S3.SS2.p4.m6" class="ltx_Math" alttext="{\bf P}^{1}\times\{s\}\subset{\bf P}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐏</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>s</mi><mo stretchy="false">}</mo></mrow></mrow><mo>⊂</mo><mi>𝐏</mi></mrow><annotation encoding="application/x-tex">{\bf P}^{1}\times\{s\}\subset{\bf P}</annotation></semantics></math>, we may write <math id="S3.SS2.p4.m7" class="ltx_Math" alttext="c_{1}({\mathcal{E}})=(g+d-1)\sigma+mf" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>+</mo><mi>d</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{1}({\mathcal{E}})=(g+d-1)\sigma+mf</annotation></semantics></math>, where <math id="S3.SS2.p4.m8" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is the class of a fiber of <math id="S3.SS2.p4.m9" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.p5" class="ltx_para">
<p id="S3.SS2.p5.1" class="ltx_p"><span id="S3.SS2.p5.1.1" class="ltx_text">Squaring gives</span></p>
<table id="S3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex5.m1" class="ltx_Math" alttext="m=\frac{c_{1}^{2}{\mathcal{E}}}{b}." display="block" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>=</mo><mfrac><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mi>b</mi></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">m=\frac{c_{1}^{2}{\mathcal{E}}}{b}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p5.2" class="ltx_p"><span id="S3.SS2.p5.2.1" class="ltx_text">The equality <math id="S3.SS2.p5.m1" class="ltx_Math" alttext="K_{{\bf P}}/2=-\sigma-\chi({\mathcal{O}}_{S})\cdot f" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mi>𝐏</mi></msub><mo>/</mo><mn>2</mn></mrow><mo rspace="0em">=</mo><mrow><mrow><mo lspace="0em">−</mo><mi>σ</mi></mrow><mo>−</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>f</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">K_{{\bf P}}/2=-\sigma-\chi({\mathcal{O}}_{S})\cdot f</annotation></semantics></math> implies</span></p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_Math" alttext="c_{1}({\mathcal{E}})\cdot K_{{\bf P}}/2=-m-(g+d-1)\chi({\mathcal{O}}_{S})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>K</mi><mi>𝐏</mi></msub></mrow><mo>/</mo><mn>2</mn></mrow><mo rspace="0em">=</mo><mrow><mrow><mo lspace="0em">−</mo><mi>m</mi></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>+</mo><mi>d</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c_{1}({\mathcal{E}})\cdot K_{{\bf P}}/2=-m-(g+d-1)\chi({\mathcal{O}}_{S}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p6" class="ltx_para">
<p id="S3.SS2.p6.1" class="ltx_p"><span id="S3.SS2.p6.1.1" class="ltx_text">Altogether, we obtain</span></p>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="\lambda=ch_{2}({\mathcal{E}}^{\vee})-m+d\chi({\mathcal{O}}_{{\bf P}})-d\chi({\mathcal{O}}_{S})=ch_{2}({\mathcal{E}}^{\vee})-\frac{c_{1}^{2}{\mathcal{E}}}{b}," display="block" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>=</mo><mrow><mrow><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐏</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mfrac><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mi>b</mi></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda=ch_{2}({\mathcal{E}}^{\vee})-m+d\chi({\mathcal{O}}_{{\bf P}})-d\chi({\mathcal{O}}_{S})=ch_{2}({\mathcal{E}}^{\vee})-\frac{c_{1}^{2}{\mathcal{E}}}{b},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p6.2" class="ltx_p"><span id="S3.SS2.p6.2.1" class="ltx_text">since <math id="S3.SS2.p6.m1" class="ltx_Math" alttext="\chi({\mathcal{O}}_{{\bf P}})=\chi({\mathcal{O}}_{S})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐏</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi({\mathcal{O}}_{{\bf P}})=\chi({\mathcal{O}}_{S})</annotation></semantics></math>. This gives (<a href="#S3.E2" title="In Proposition 3.1. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>).</span></p>
</div>
<div id="S3.SS2.p7" class="ltx_para">
<p id="S3.SS2.p7.1" class="ltx_p"><span id="S3.SS2.p7.1.1" class="ltx_text">Mumford’s relation <math id="S3.SS2.p7.m1" class="ltx_Math" alttext="12\lambda=\kappa+\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>=</mo><mrow><mi>κ</mi><mo>+</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">12\lambda=\kappa+\delta</annotation></semantics></math> implies we need only compute <math id="S3.SS2.p7.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>. The computation of <math id="S3.SS2.p7.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> uses the Grothendieck-Riemann-Roch formula applied to the line bundle <math id="S3.SS2.p7.m4" class="ltx_Math" alttext="\omega_{\alpha}^{\otimes 2}" display="inline" intent=":literal"><semantics><msubsup><mi>ω</mi><mi>α</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msubsup><annotation encoding="application/x-tex">\omega_{\alpha}^{\otimes 2}</annotation></semantics></math> and the map <math id="S3.SS2.p7.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> as in the proof of <a href="#S1.Thmthm14" title="Proposition 1.14 (Conjecture 
            
              2.5
            
           in []). ‣ 1.7 Relating 
          
            
              ⁢
              
                
                c
                1
              
              
                
                
                  (
                  E
                  )
                
              
            
          
         and 
          
            
              ⁢
              
                
                c
                1
              
              
                
                
                  (
                  F
                  )
                
              
            
          
        . ‣ 1 Invariants of a branched cover. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.14</span></a>:</span></p>
<table id="S3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex8.m1" class="ltx_Math" alttext="ch(\alpha_{*}\omega_{\alpha}^{\otimes 2})Td(T_{\pi})=\alpha_{*}(ch(\omega_{\alpha}^{\otimes 2})Td(T_{f}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>α</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ω</mi><mi>α</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">ch(\alpha_{*}\omega_{\alpha}^{\otimes 2})Td(T_{\pi})=\alpha_{*}(ch(\omega_{\alpha}^{\otimes 2})Td(T_{f})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p8" class="ltx_para">
<p id="S3.SS2.p8.1" class="ltx_p"><span id="S3.SS2.p8.1.1" class="ltx_text">By using <math id="S3.SS2.p8.m1" class="ltx_Math" alttext="ch(\alpha_{*}\omega_{\alpha}^{\otimes 2})=ch({\rm Sym}^{2}{\mathcal{E}})-ch({\mathcal{F}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>α</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>Sym</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">ch(\alpha_{*}\omega_{\alpha}^{\otimes 2})=ch({\rm Sym}^{2}{\mathcal{E}})-ch({\mathcal{F}})</annotation></semantics></math> and taking degree <math id="S3.SS2.p8.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> parts of the above equation, we end up with the equality</span></p>
<table id="S3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex9.m1" class="ltx_Math" alttext="ch_{2}({\rm Sym}^{2}{\mathcal{E}})-ch_{2}({\mathcal{E}})-ch_{2}({\mathcal{F}})=c_{1}^{2}(\omega_{\alpha})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>Sym</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">ch_{2}({\rm Sym}^{2}{\mathcal{E}})-ch_{2}({\mathcal{E}})-ch_{2}({\mathcal{F}})=c_{1}^{2}(\omega_{\alpha}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p9" class="ltx_para">
<p id="S3.SS2.p9.1" class="ltx_p"><span id="S3.SS2.p9.1.1" class="ltx_text">Finally, by using <math id="S3.SS2.p9.m1" class="ltx_Math" alttext="c_{1}(\omega_{f})=c_{1}(\omega_{\alpha})+\alpha_{*}c_{1}(\omega_{\pi})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{1}(\omega_{f})=c_{1}(\omega_{\alpha})+\alpha_{*}c_{1}(\omega_{\pi})</annotation></semantics></math>, one checks that</span></p>
<table id="S3.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex10.m1" class="ltx_Math" alttext="\kappa=c_{1}^{2}(\omega_{f})=c_{1}^{2}(\omega_{\alpha})-\frac{8}{b}c_{1}^{2}({\mathcal{E}})." display="block" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>=</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ω</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mn>8</mn><mi>b</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\kappa=c_{1}^{2}(\omega_{f})=c_{1}^{2}(\omega_{\alpha})-\frac{8}{b}c_{1}^{2}({\mathcal{E}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p10" class="ltx_para">
<p id="S3.SS2.p10.1" class="ltx_p"><span id="S3.SS2.p10.1.1" class="ltx_text">Putting all of the above together yields <a href="#S3.E3" title="In Proposition 3.1. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>.</span></p>
</div>
<div id="S3.SS2.p11" class="ltx_para">
<p id="S3.SS2.p11.1" class="ltx_p"><span id="S3.SS2.p11.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S3.SS2.p12" class="ltx_para">
<p id="S3.SS2.p12.1" class="ltx_p">Let <math id="S3.SS2.p12.m1" class="ltx_Math" alttext="{\mathsf{T}}\subset S" display="inline" intent=":literal"><semantics><mrow><mi>𝖳</mi><mo>⊂</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">{\mathsf{T}}\subset S</annotation></semantics></math> and <math id="S3.SS2.p12.m2" class="ltx_Math" alttext="{\mathsf{D}}\subset S" display="inline" intent=":literal"><semantics><mrow><mi>𝖣</mi><mo>⊂</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">{\mathsf{D}}\subset S</annotation></semantics></math> denote the divisors of points in <math id="S3.SS2.p12.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> where the map <math id="S3.SS2.p12.m4" class="ltx_Math" alttext="\alpha_{s}{\colon}C_{s}\longrightarrow{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>s</mi></msub><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha_{s}{\colon}C_{s}\longrightarrow{\bf P}^{1}</annotation></semantics></math> has a triple ramification point and a <math id="S3.SS2.p12.m5" class="ltx_Math" alttext="(2,2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2,2)</annotation></semantics></math> pair of “doubled" ramification points, respectively.</p>
</div>
<div id="S3.Thmthm2" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm2.2" class="ltx_text ltx_font_bold">Proposition 3.2</span></span><span id="S3.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm2.p1" class="ltx_para">
<p id="S3.Thmthm2.p1.1" class="ltx_p"><span id="S3.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">We have the following equalities:</span></p>
<table id="S3.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E5.m1" class="ltx_Math" alttext="\displaystyle{\mathsf{T}}=(3d-12)ch_{2}{\mathcal{E}}-3ch_{2}{\mathcal{F}}+\frac{3}{2}c_{1}^{2}{\mathcal{E}}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖳</mi><mo>=</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>12</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathsf{T}}=(3d-12)ch_{2}{\mathcal{E}}-3ch_{2}{\mathcal{F}}+\frac{3}{2}c_{1}^{2}{\mathcal{E}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.5)</span></td></tr></tbody>
<tbody id="S3.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E6.m1" class="ltx_Math" alttext="\displaystyle{\mathsf{D}}=4ch_{2}{\mathcal{F}}-(4d-12)ch_{2}{\mathcal{E}}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖣</mi><mo>=</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>12</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathsf{D}}=4ch_{2}{\mathcal{F}}-(4d-12)ch_{2}{\mathcal{E}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.6)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p13" class="ltx_para">
<p id="S3.SS2.p13.1" class="ltx_p"><span id="S3.SS2.p13.1.1" class="ltx_text">Let</span></p>
<table id="S3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.E7.m1.pic1" class="ltx_picture ltx_markedasmath" height="63.46" overflow="visible" style="vertical-align:-50.985490168973556px" version="1.1" viewBox="9.15 50.99 84.95 63.46" width="84.95"><g transform="matrix(1 0 0 -1 9.147799227830532 63.458003657346154) translate(0,3.46) translate(9.15,0)"><g transform="translate(-9.15,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.72em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E7.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{{\mathcal{C}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\textstyle{{\mathcal{C}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.147799227830532 -0.27673578005007266 L 9.147799227830532 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(25.36,0) translate(0,6.24) translate(4.15,0) translate(0,-2.09)"><foreignObject style="--ltx-fo-width:0.52em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="7.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E7.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\alpha}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">α</mi><annotation encoding="application/x-tex">\scriptstyle{\alpha}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(56.62,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.147799227830532 -0.27673578005007266 L 56.62000969400771 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 56.62000969400771 -0.27673578005007266 L 56.62000969400771 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 5.759786434550989 -7.610350076103501 L 5.815843007072004 -7.615818495042462" fill="none" stroke="#000000"></path><g transform="translate(1.66,0) translate(0,-28.1) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E7.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{f}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">f</mi><annotation encoding="application/x-tex">\scriptstyle{f}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(25.2,0) translate(0,-33.23)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -1.97 7.19" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.38 3.84" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 5.759786434550989 -7.610350076103501 L 25.204217366299986 -33.228034809514234" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 25.14816079377897 -33.228034809514234 L 25.204217366299986 -33.228034809514234" fill="none" stroke="#000000"></path><g transform="translate(56.62,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.79em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="10.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E7.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{{\bf P}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">\textstyle{{\bf P}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 60.360809406403504 -7.610350076103501 L 60.360809406403504 -7.610350076103501" fill="none" stroke="#000000"></path><g transform="translate(49.55,0) translate(0,-26.47) translate(4.15,0) translate(0,-2.09)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="6.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E7.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\pi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">π</mi><annotation encoding="application/x-tex">\scriptstyle{\pi}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(40.68,0) translate(0,-33.23)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 6.41 3.8" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 2.02 7.17" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 60.360809406403504 -7.610350076103501 L 40.68250327547738 -33.228034809514234" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 40.68250327547738 -33.228034809514234 L 40.68250327547738 -33.228034809514234" fill="none" stroke="#000000"></path><g transform="translate(24.09,0) translate(0,-43.38) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.67em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E7.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{S}" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\textstyle{S}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.7)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p13.2" class="ltx_p"><span id="S3.SS2.p13.2.1" class="ltx_text">be a general family of covers in <math id="S3.SS2.p13.m1" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{d,g}</annotation></semantics></math> with <math id="S3.SS2.p13.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> being a complete curve. We pick the family general enough so that the ramification divisor <math id="S3.SS2.p13.m3" class="ltx_Math" alttext="R\subset{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⊂</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">R\subset{\mathcal{C}}</annotation></semantics></math> of the finite map <math id="S3.SS2.p13.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is smooth and maps birationally onto the branch divisor <math id="S3.SS2.p13.m5" class="ltx_Math" alttext="B\subset{\bf P}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⊂</mo><mi>𝐏</mi></mrow><annotation encoding="application/x-tex">B\subset{\bf P}</annotation></semantics></math>, with <math id="S3.SS2.p13.m6" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> having simple nodes and cusps only. The cusps of <math id="S3.SS2.p13.m7" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> will then count as intersections of our family with the divisor <math id="S3.SS2.p13.m8" class="ltx_Math" alttext="{\mathsf{T}}" display="inline" intent=":literal"><semantics><mi>𝖳</mi><annotation encoding="application/x-tex">{\mathsf{T}}</annotation></semantics></math> and the nodes of <math id="S3.SS2.p13.m9" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> will count as intersections with the divisor <math id="S3.SS2.p13.m10" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math>. We then see that</span></p>
<table id="S3.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E8.m1" class="ltx_Math" alttext="p_{a}(B)-p_{a}(R)={\mathsf{T}}+{\mathsf{D}}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>𝖳</mi><mo>+</mo><mi>𝖣</mi></mrow></mrow><annotation encoding="application/x-tex">p_{a}(B)-p_{a}(R)={\mathsf{T}}+{\mathsf{D}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.8)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p13.3" class="ltx_p"><span id="S3.SS2.p13.3.1" class="ltx_text">By adjunction on <math id="S3.SS2.p13.m11" class="ltx_Math" alttext="{\mathcal{C}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">{\mathcal{C}}</annotation></semantics></math> and <math id="S3.SS2.p13.m12" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math>, this leads to the relation</span></p>
<table id="S3.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E9.m1" class="ltx_Math" alttext="B^{2}+c_{1}\omega_{\pi}\cdot B-(R^{2}+c_{1}\omega_{f}\cdot R)=B^{2}-2R^{2}={\mathsf{T}}+{\mathsf{D}}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>B</mi><mn>2</mn></msup><mo>+</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ω</mi><mi>π</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>B</mi></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mn>2</mn></msup><mo>+</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ω</mi><mi>f</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>R</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow></mrow><mo>=</mo><mrow><mi>𝖳</mi><mo>+</mo><mi>𝖣</mi></mrow></mrow><annotation encoding="application/x-tex">B^{2}+c_{1}\omega_{\pi}\cdot B-(R^{2}+c_{1}\omega_{f}\cdot R)=B^{2}-2R^{2}={\mathsf{T}}+{\mathsf{D}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.9)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p14" class="ltx_para">
<p id="S3.SS2.p14.1" class="ltx_p"><span id="S3.SS2.p14.1.1" class="ltx_text">On the other hand, the ramification divisor <math id="S3.SS2.p14.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is itself a branched cover of <math id="S3.SS2.p14.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> under the map <math id="S3.SS2.p14.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>. The branch points of the map <math id="S3.SS2.p14.m4" class="ltx_Math" alttext="f|_{R}{\colon}R\longrightarrow S" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>f</mi><mo stretchy="false">|</mo></mrow><mi>R</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>R</mi><mo stretchy="false">⟶</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">f|_{R}{\colon}R\longrightarrow S</annotation></semantics></math> provide intersections with <math id="S3.SS2.p14.m5" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> or with <math id="S3.SS2.p14.m6" class="ltx_Math" alttext="{\mathsf{T}}" display="inline" intent=":literal"><semantics><mi>𝖳</mi><annotation encoding="application/x-tex">{\mathsf{T}}</annotation></semantics></math>. By adjunction on the surface <math id="S3.SS2.p14.m7" class="ltx_Math" alttext="{\mathcal{C}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">{\mathcal{C}}</annotation></semantics></math>, we get the equality</span></p>
<table id="S3.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E10.m1" class="ltx_Math" alttext="R^{2}+R\cdot c_{1}\omega_{f}=2R^{2}+B\cdot c_{1}\omega_{\pi}={\mathsf{T}}+\delta" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo>+</mo><mrow><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ω</mi><mi>f</mi></msub></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ω</mi><mi>π</mi></msub></mrow></mrow><mo>=</mo><mrow><mi>𝖳</mi><mo>+</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">R^{2}+R\cdot c_{1}\omega_{f}=2R^{2}+B\cdot c_{1}\omega_{\pi}={\mathsf{T}}+\delta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.10)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p15" class="ltx_para">
<p id="S3.SS2.p15.1" class="ltx_p"><span id="S3.SS2.p15.1.1" class="ltx_text">Recall that <math id="S3.SS2.p15.m1" class="ltx_Math" alttext="B=2c_{1}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">B=2c_{1}{\mathcal{E}}</annotation></semantics></math>, so <math id="S3.SS2.p15.m2" class="ltx_Math" alttext="B^{2}=4c_{1}^{2}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>2</mn></msup><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">B^{2}=4c_{1}^{2}{\mathcal{E}}</annotation></semantics></math>. Furthermore, from the proof of <a href="#S3.Thmthm1" title="Proposition 3.1. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.1</span></a> we see that <math id="S3.SS2.p15.m3" class="ltx_Math" alttext="B\cdot\omega_{\pi}=\frac{-2c_{1}^{2}{\mathcal{E}}}{b}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>ω</mi><mi>π</mi></msub></mrow><mo>=</mo><mfrac><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mi>b</mi></mfrac></mrow><annotation encoding="application/x-tex">B\cdot\omega_{\pi}=\frac{-2c_{1}^{2}{\mathcal{E}}}{b}</annotation></semantics></math>. The current proposition now follows from <a href="#S3.Thmthm1" title="Proposition 3.1. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.1</span></a> and the following lemma:</span></p>
</div>
<div id="S3.Thmthm3" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm3.2" class="ltx_text ltx_font_bold">Lemma 3.3</span></span><span id="S3.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm3.p1" class="ltx_para">
<p id="S3.Thmthm3.p1.1" class="ltx_p"><span id="S3.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">We have</span></p>
<table id="S3.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E11.m1" class="ltx_Math" alttext="R^{2}=d\cdot ch_{2}{\mathcal{E}}-ch_{2}{\mathcal{F}}+\frac{c_{1}^{2}{\mathcal{E}}}{2}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mn>2</mn></msup><mo>=</mo><mrow><mrow><mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>c</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></mrow><mo>+</mo><mfrac><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mn>2</mn></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R^{2}=d\cdot ch_{2}{\mathcal{E}}-ch_{2}{\mathcal{F}}+\frac{c_{1}^{2}{\mathcal{E}}}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.11)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS2.3.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S3.Thmthm3" title="Lemma 3.3. ‣ Proof. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.3</span></a>.</h6>
<div id="S3.SS2.p16" class="ltx_para">
<p id="S3.SS2.p16.1" class="ltx_p"><span id="S3.SS2.p16.1.1" class="ltx_text">This follows from applying the Grothendieck-Riemann-Roch formula to the map <math id="S3.SS2.p16.m1" class="ltx_Math" alttext="\alpha{\colon}{\mathcal{C}}\longrightarrow{\bf P}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">⟶</mo><mi>𝐏</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha{\colon}{\mathcal{C}}\longrightarrow{\bf P}</annotation></semantics></math> and the sheaf <math id="S3.SS2.p16.m2" class="ltx_Math" alttext="{\mathcal{O}}_{{\mathcal{C}}}(2R)=\omega_{\alpha}^{\otimes 2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mi>ω</mi><mi>α</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{{\mathcal{C}}}(2R)=\omega_{\alpha}^{\otimes 2}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.SS2.p17" class="ltx_para">
<p id="S3.SS2.p17.1" class="ltx_p"><span id="S3.SS2.p17.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S3.Thmthm4" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm4.2" class="ltx_text ltx_font_bold">Proposition 3.4</span></span><span id="S3.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm4.p1" class="ltx_para">
<p id="S3.Thmthm4.p1.1" class="ltx_p"><span id="S3.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">For a family <math id="S3.Thmthm4.p1.m1" class="ltx_Math" alttext="f{\colon}{\mathcal{C}}\longrightarrow S" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">⟶</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">f{\colon}{\mathcal{C}}\longrightarrow S</annotation></semantics></math> as above,</span></p>
<table id="S3.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E12.m1" class="ltx_Math" alttext="24(b-1)\lambda-3(b-2)\delta+6{\mathsf{D}}-(b-10){\mathsf{T}}=0" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mn>24</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝖣</mi></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mn>10</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝖳</mi></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">24(b-1)\lambda-3(b-2)\delta+6{\mathsf{D}}-(b-10){\mathsf{T}}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.12)</span></td></tr></tbody>
</table>
<p id="S3.Thmthm4.p1.2" class="ltx_p"><span id="S3.Thmthm4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S3.Thmthm4.p1.m2" class="ltx_Math" alttext="b=2g+2d-2" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">b=2g+2d-2</annotation></semantics></math> is the number of branch points.</span></p>
</div>
</div>
<div id="S3.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p18" class="ltx_para">
<p id="S3.SS2.p18.1" class="ltx_p"><span id="S3.SS2.p18.1.1" class="ltx_text">This follows immediately from <a href="#S3.Thmthm1" title="Proposition 3.1. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.1</span></a> and <a href="#S3.Thmthm2" title="Proposition 3.2. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.2</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.3 </h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">Given the relation in <a href="#S3.Thmthm4" title="Proposition 3.4. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.4</span></a>, we will use <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="\lambda,\delta" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>,</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\lambda,\delta</annotation></semantics></math>, and <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math> as generators for the <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="{\bf Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">{\bf Q}</annotation></semantics></math>-vector subspace of <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="{{\rm Pic}\,}_{{\bf Q}}\widetilde{\mathcal{H}}_{d,g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pic</mi><mi>𝐐</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{{\rm Pic}\,}_{{\bf Q}}\widetilde{\mathcal{H}}_{d,g}</annotation></semantics></math> spanned by <math id="S3.SS3.p1.m5" class="ltx_Math" alttext="\lambda,\delta,{\mathsf{T}}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>𝖳</mi></mrow><annotation encoding="application/x-tex">\lambda,\delta,{\mathsf{T}}</annotation></semantics></math>, and <math id="S3.SS3.p1.m6" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math>. It can be proved that these three divisor classes are independent in <math id="S3.SS3.p1.m7" class="ltx_Math" alttext="{{\rm Pic}\,}_{{\bf Q}}\widetilde{\mathcal{H}}_{d,g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pic</mi><mi>𝐐</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{{\rm Pic}\,}_{{\bf Q}}\widetilde{\mathcal{H}}_{d,g}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">DP15</a>]</cite>[Proposition 2.15]. Furthermore, we note that the relation (<a href="#S3.E12" title="In Proposition 3.4. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.12</span></a>) shows that the analogous divisors (with abuse of notation) <math id="S3.SS3.p1.m8" class="ltx_Math" alttext="\lambda,\delta,{\mathsf{T}}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>𝖳</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda,\delta,{\mathsf{T}},</annotation></semantics></math> and <math id="S3.SS3.p1.m9" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math> are dependent in <math id="S3.SS3.p1.m10" class="ltx_Math" alttext="{{\rm Pic}\,}_{{\bf Q}}\overline{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pic</mi><mi>𝐐</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{{\rm Pic}\,}_{{\bf Q}}\overline{{\mathcal{H}}}_{d,g}</annotation></semantics></math>, modulo higher boundary divisors. We will choose to use the divisors <math id="S3.SS3.p1.m11" class="ltx_Math" alttext="\lambda,\delta" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>,</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\lambda,\delta</annotation></semantics></math> and <math id="S3.SS3.p1.m12" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math> as generators of the subspace spanned by <math id="S3.SS3.p1.m13" class="ltx_Math" alttext="\lambda,\delta,{\mathsf{T}}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>𝖳</mi></mrow><annotation encoding="application/x-tex">\lambda,\delta,{\mathsf{T}}</annotation></semantics></math>, and <math id="S3.SS3.p1.m14" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.4 The divisor classes of <math id="S3.SS4.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.SS4.m2" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math>.</h3>

<div id="S3.SS4.p1" class="ltx_para">
<p id="S3.SS4.p1.1" class="ltx_p">We now express the classes of the divisors <math id="S3.SS4.p1.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.SS4.p1.m2" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> in terms of <math id="S3.SS4.p1.m3" class="ltx_Math" alttext="\lambda,\delta" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>,</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\lambda,\delta</annotation></semantics></math>, and <math id="S3.SS4.p1.m4" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math> in the Picard group of the partial compactification <math id="S3.SS4.p1.m5" class="ltx_Math" alttext="\widetilde{\mathcal{H}}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\mathcal{H}}_{d,g}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS4.p2" class="ltx_para">
<p id="S3.SS4.p2.1" class="ltx_p">Since <math id="S3.SS4.p2.m1" class="ltx_Math" alttext="\pi\colon{\bf P}\longrightarrow\widetilde{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝐏</mi><mo stretchy="false">⟶</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\pi\colon{\bf P}\longrightarrow\widetilde{{\mathcal{H}}}_{d,g}</annotation></semantics></math> is a <math id="S3.SS4.p2.m2" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>-bundle, we can use the Bogomolov expressions for the universal bundles <math id="S3.SS4.p2.m3" class="ltx_Math" alttext="{\mathcal{E}}_{univ}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{univ}</annotation></semantics></math> and <math id="S3.SS4.p2.m4" class="ltx_Math" alttext="{\mathcal{F}}_{univ}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{univ}</annotation></semantics></math>, respectively. Given any rank <math id="S3.SS4.p2.m5" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> locally free sheaf <math id="S3.SS4.p2.m6" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> on <math id="S3.SS4.p2.m7" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math>, the Bogomolov expression for <math id="S3.SS4.p2.m8" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> is</p>
<table id="S3.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E13.m1" class="ltx_Math" alttext="\text{Bog}({\mathcal{G}}):=c_{2}({\mathcal{G}})-\frac{(r-1)}{2r}c_{1}^{2}({\mathcal{G}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>Bog</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{Bog}({\mathcal{G}}):=c_{2}({\mathcal{G}})-\frac{(r-1)}{2r}c_{1}^{2}({\mathcal{G}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.13)</span></td></tr></tbody>
</table>
<p id="S3.SS4.p2.2" class="ltx_p">(It is, up to scaling, the unique linear combination of <math id="S3.SS4.p2.m9" class="ltx_Math" alttext="c_{2}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>2</mn></msub><annotation encoding="application/x-tex">c_{2}</annotation></semantics></math> and <math id="S3.SS4.p2.m10" class="ltx_Math" alttext="c_{1}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">c_{1}^{2}</annotation></semantics></math> which is invariant under tensoring by line bundles.) When <math id="S3.SS4.p2.m11" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> restricts to a perfectly balanced bundle on the general fiber of <math id="S3.SS4.p2.m12" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, the Bogomolov expression <math id="S3.SS4.p2.m13" class="ltx_Math" alttext="\text{Bog}({\mathcal{G}})" display="inline" intent=":literal"><semantics><mrow><mtext>Bog</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Bog}({\mathcal{G}})</annotation></semantics></math> detects the change in splitting type of <math id="S3.SS4.p2.m14" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> on the fibers of the <math id="S3.SS4.p2.m15" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>-bundle <math id="S3.SS4.p2.m16" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">Mor98</a>]</cite>. Using <a href="#S3.Thmthm1" title="Proposition 3.1. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.1</span></a> and <a href="#S3.Thmthm2" title="Proposition 3.2. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, we conclude:</p>
</div>
<div id="S3.Thmthm5" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm5.2" class="ltx_text ltx_font_bold">Proposition 3.5</span></span><span id="S3.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm5.p1" class="ltx_para">
<p id="S3.Thmthm5.p1.1" class="ltx_p"><span id="S3.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">In <math id="S3.Thmthm5.p1.m1" class="ltx_Math" alttext="{\rm Pic}_{{\bf Q}}\,\widetilde{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pic</mi><mi>𝐐</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\rm Pic}_{{\bf Q}}\,\widetilde{{\mathcal{H}}}_{d,g}</annotation></semantics></math>, the divisors <math id="S3.Thmthm5.p1.m2" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.Thmthm5.p1.m3" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math>, when they exist, are expressible in terms of <math id="S3.Thmthm5.p1.m4" class="ltx_Math" alttext="\lambda,\delta" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>,</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\lambda,\delta</annotation></semantics></math>, and <math id="S3.Thmthm5.p1.m5" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math>. These expressions are:</span></p>
<table id="S3.EGx4" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex11.m1" class="ltx_Math" alttext="\displaystyle{\mathsf{M}}=\left(\frac{\frac{10-d}{d-1}b-8}{b-10}\right)\lambda-\left(\frac{\frac{1}{d-1}b-2}{b-10}\right)\delta+\left(\frac{\frac{1}{d-1}b-2}{4(b-10)}\right){\mathsf{D}}" display="inline" intent=":literal"><semantics><mrow><mi>𝖬</mi><mo>=</mo><mrow><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><mrow><mn>10</mn><mo>−</mo><mi>d</mi></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>−</mo><mn>8</mn></mrow><mrow><mi>b</mi><mo>−</mo><mn>10</mn></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>−</mo><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>−</mo><mn>2</mn></mrow><mrow><mi>b</mi><mo>−</mo><mn>10</mn></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>−</mo><mn>2</mn></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mn>10</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝖣</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathsf{M}}=\left(\frac{\frac{10-d}{d-1}b-8}{b-10}\right)\lambda-\left(\frac{\frac{1}{d-1}b-2}{b-10}\right)\delta+\left(\frac{\frac{1}{d-1}b-2}{4(b-10)}\right){\mathsf{D}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex12.m1" class="ltx_Math" alttext="\displaystyle{\mathsf{CE}}=\left(\frac{(21-d-\frac{54}{d})b-8d+24}{b-10}\right)\lambda-\left(\frac{(2-\frac{6}{d})b-2d+6}{b-10}\right)\delta+\left(\frac{(1-\frac{6}{d})b-2d+16}{4(b-10)}\right){\mathsf{D}}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖢𝖤</mi><mo>=</mo><mrow><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>21</mn><mo>−</mo><mi>d</mi><mo>−</mo><mfrac><mn>54</mn><mi>d</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>−</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>+</mo><mn>24</mn></mrow><mrow><mi>b</mi><mo>−</mo><mn>10</mn></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>−</mo><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mfrac><mn>6</mn><mi>d</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>+</mo><mn>6</mn></mrow><mrow><mi>b</mi><mo>−</mo><mn>10</mn></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>6</mn><mi>d</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>+</mo><mn>16</mn></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mn>10</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝖣</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathsf{CE}}=\left(\frac{(21-d-\frac{54}{d})b-8d+24}{b-10}\right)\lambda-\left(\frac{(2-\frac{6}{d})b-2d+6}{b-10}\right)\delta+\left(\frac{(1-\frac{6}{d})b-2d+16}{4(b-10)}\right){\mathsf{D}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm5.p1.2" class="ltx_p"><span id="S3.Thmthm5.p1.2.1" class="ltx_text ltx_font_italic">Here, as usual, <math id="S3.Thmthm5.p1.m6" class="ltx_Math" alttext="b=2d+2g-2" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">b=2d+2g-2</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS4.p3" class="ltx_para">
<p id="S3.SS4.p3.1" class="ltx_p"><span id="S3.SS4.p3.1.1" class="ltx_text">Follows from <a href="#S3.Thmthm1" title="Proposition 3.1. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.1</span></a> and <a href="#S3.Thmthm2" title="Proposition 3.2. ‣ 3.2 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.2</span></a> and the Bogomolov expression (<a href="#S3.E13" title="In 3.4 The divisor classes of 
          
            M
          
         and 
          
            CE
          
        . ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.13</span></a>).
∎</span></p>
</div>
</div>
<div id="S3.Thmthm6" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm6.2" class="ltx_text ltx_font_bold">Corollary 3.6</span></span><span id="S3.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm6.p1" class="ltx_para">
<p id="S3.Thmthm6.p1.1" class="ltx_p"><span id="S3.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm6.p1.m1" class="ltx_Math" alttext="d\geq 4." display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>≥</mo><mn>4</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d\geq 4.</annotation></semantics></math> Then the divisor classes <math id="S3.Thmthm6.p1.m2" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.Thmthm6.p1.m3" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> and boundary divisors of <math id="S3.Thmthm6.p1.m4" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}</annotation></semantics></math> are linearly independent. The same is true when <math id="S3.Thmthm6.p1.m5" class="ltx_Math" alttext="d=3" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d=3</annotation></semantics></math> when we omit <math id="S3.Thmthm6.p1.m6" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> (which is zero).</span></p>
</div>
</div>
<div id="S3.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS4.p4" class="ltx_para">
<p id="S3.SS4.p4.1" class="ltx_p"><span id="S3.SS4.p4.1.1" class="ltx_text">This follows from the independence of <math id="S3.SS4.p4.m1" class="ltx_Math" alttext="\lambda,\delta," display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>,</mo><mi>δ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda,\delta,</annotation></semantics></math> and <math id="S3.SS4.p4.m2" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math> and the boundary which is a consequence of <a href="#Thmmaintheorem1" title="Theorem A (Independence of the boundary). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">A</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.5 The effective divisor class <math id="S3.SS5.m1" class="ltx_Math" alttext="{\mathsf{X}}" display="inline" intent=":literal"><semantics><mi>𝖷</mi><annotation encoding="application/x-tex">{\mathsf{X}}</annotation></semantics></math>.</h3>

<div id="S3.SS5.p1" class="ltx_para">
<p id="S3.SS5.p1.1" class="ltx_p">Now we notice in <a href="#S3.Thmthm5" title="Proposition 3.5. ‣ 3.4 The divisor classes of 
          
            M
          
         and 
          
            CE
          
        . ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.5</span></a> that when <math id="S3.SS5.p1.m1" class="ltx_Math" alttext="d\leq 5" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≤</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">d\leq 5</annotation></semantics></math>, the coefficient of <math id="S3.SS5.p1.m2" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math> is positive in <math id="S3.SS5.p1.m3" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and negative in <math id="S3.SS5.p1.m4" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math>. We let <math id="S3.SS5.p1.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be the unique (up to scaling) effective linear combination of <math id="S3.SS5.p1.m6" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.SS5.p1.m7" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> making the coefficient of <math id="S3.SS5.p1.m8" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math> zero.</p>
</div>
<div id="S3.SS5.p2" class="ltx_para">
<p id="S3.SS5.p2.1" class="ltx_p">In <math id="S3.SS5.p2.m1" class="ltx_Math" alttext="{\rm Pic}_{{\bf Q}}\widetilde{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pic</mi><mi>𝐐</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\rm Pic}_{{\bf Q}}\widetilde{{\mathcal{H}}}_{d,g}</annotation></semantics></math> the divisor class <math id="S3.SS5.p2.m2" class="ltx_Math" alttext="{\mathsf{X}}" display="inline" intent=":literal"><semantics><mi>𝖷</mi><annotation encoding="application/x-tex">{\mathsf{X}}</annotation></semantics></math> has the form</p>
<table id="S3.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex13.m1" class="ltx_Math" alttext="{\mathsf{X}}=a\lambda-b\delta" display="block" intent=":literal"><semantics><mrow><mi>𝖷</mi><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>−</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{X}}=a\lambda-b\delta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS5.p2.2" class="ltx_p">for some <math id="S3.SS5.p2.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="S3.SS5.p2.m4" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>. The reader can check that the ratio <math id="S3.SS5.p2.m5" class="ltx_Math" alttext="a/b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a/b</annotation></semantics></math> is <math id="S3.SS5.p2.m6" class="ltx_Math" alttext="(13g+15)/2g" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>13</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>15</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">(13g+15)/2g</annotation></semantics></math> and <math id="S3.SS5.p2.m7" class="ltx_Math" alttext="(31g+44)/5g" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>31</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>44</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>5</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">(31g+44)/5g</annotation></semantics></math> when <math id="S3.SS5.p2.m8" class="ltx_Math" alttext="d=4" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">d=4</annotation></semantics></math> and <math id="S3.SS5.p2.m9" class="ltx_Math" alttext="d=5" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">d=5</annotation></semantics></math>, respectively. Furthermore, when <math id="S3.SS5.p2.m10" class="ltx_Math" alttext="d=3" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d=3</annotation></semantics></math>, neither <math id="S3.SS5.p2.m11" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> nor <math id="S3.SS5.p2.m12" class="ltx_Math" alttext="{\mathsf{D}}" display="inline" intent=":literal"><semantics><mi>𝖣</mi><annotation encoding="application/x-tex">{\mathsf{D}}</annotation></semantics></math> exist, and the slope <math id="S3.SS5.p2.m13" class="ltx_Math" alttext="a/b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a/b</annotation></semantics></math> of <math id="S3.SS5.p2.m14" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> is <math id="S3.SS5.p2.m15" class="ltx_Math" alttext="(7g+6)/g" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>6</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">(7g+6)/g</annotation></semantics></math>. These are precisely the numbers <math id="S3.SS5.p2.m16" class="ltx_Math" alttext="s(\mathcal{M}^{1}_{d,g})" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s(\mathcal{M}^{1}_{d,g})</annotation></semantics></math> occurring in <a href="#Thmmaintheorem3" title="Theorem C (Slope bounds). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">C</span></a>.</p>
</div>
</section>
<section id="S3.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.6 </h3>

<div id="S3.SS6.p1" class="ltx_para">
<p id="S3.SS6.p1.1" class="ltx_p">Now we pass to the compactification of Hurwitz space <math id="S3.SS6.p1.m1" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> constructed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">Deo13</a>]</cite>. <math id="S3.SS6.p1.m2" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> parametrizes admissible covers where at most two branch points are allowed to coincide at any given point in the target. See fig. <a href="#S3.F4" title="Figure 4 ‣ 3.6 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. We may think of <math id="S3.SS6.p1.m3" class="ltx_Math" alttext="{\mathsf{X}}" display="inline" intent=":literal"><semantics><mi>𝖷</mi><annotation encoding="application/x-tex">{\mathsf{X}}</annotation></semantics></math> as an effective divisor in <math id="S3.SS6.p1.m4" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> (by taking closures of <math id="S3.SS6.p1.m5" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.SS6.p1.m6" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math>) and then write</p>
<table id="S3.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E14.m1" class="ltx_Math" alttext="{\mathsf{X}}=a\lambda-b\delta-{\mathsf{Y}}" display="block" intent=":literal"><semantics><mrow><mi>𝖷</mi><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>−</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>−</mo><mi>𝖸</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{X}}=a\lambda-b\delta-{\mathsf{Y}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.14)</span></td></tr></tbody>
</table>
<p id="S3.SS6.p1.2" class="ltx_p">where <math id="S3.SS6.p1.m7" class="ltx_Math" alttext="{\mathsf{Y}}" display="inline" intent=":literal"><semantics><mi>𝖸</mi><annotation encoding="application/x-tex">{\mathsf{Y}}</annotation></semantics></math> is supported on the higher boundary divisors of the admissible covers compactification. Such an expression is unique, due to <a href="#Thmmaintheorem1" title="Theorem A (Independence of the boundary). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div>
<figure id="S3.F4" class="ltx_figure"><object type="image/svg+xml" data="/html/1508.06016/assets/Deopurkarcovers.svg" id="S3.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" width="357" height="115"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span><span id="S3.F4.3" class="ltx_text" style="font-size:90%;">Two covers in <math id="S3.F4.m9" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math>. <math id="S3.F4.m10" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is also a point in the partial compactification <math id="S3.F4.m11" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}_{d,g}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><mo mathsize="1.110em">~</mo></mover><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}_{d,g}}</annotation></semantics></math>. Note that <math id="S3.F4.m12" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> has <math id="S3.F4.m13" class="ltx_Math" alttext="(2,2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2,2)</annotation></semantics></math> ramification and also has a node. <math id="S3.F4.m14" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> is an element in <math id="S3.F4.m15" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> - it also has <math id="S3.F4.m16" class="ltx_Math" alttext="(2,2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2,2)</annotation></semantics></math> ramification and a node which does not lie over the node of the target.</span></figcaption>
</figure>
</section>
<section id="S3.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.7 The key result.</h3>

<div id="S3.SS7.p1" class="ltx_para">
<p id="S3.SS7.p1.1" class="ltx_p">The following is the key statement allowing us to establish slope bounds
<a href="#Thmmaintheorem3" title="Theorem C (Slope bounds). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">C</span></a>:</p>
</div>
<div id="S3.Thmthm7" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm7.2" class="ltx_text ltx_font_bold">Theorem 3.7</span></span><span id="S3.Thmthm7.3" class="ltx_text ltx_font_bold"> </span>(Key result for <a href="#Thmmaintheorem3" title="Theorem C (Slope bounds). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">C</span></a>)<span id="S3.Thmthm7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm7.p1" class="ltx_para">
<p id="S3.Thmthm7.p1.1" class="ltx_p"><span id="S3.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm7.p1.m1" class="ltx_Math" alttext="d=3,4" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>=</mo><mn>3</mn></mrow><mo>,</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">d=3,4</annotation></semantics></math> or <math id="S3.Thmthm7.p1.m2" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>, and let <math id="S3.Thmthm7.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> be such that <math id="S3.Thmthm7.p1.m4" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.Thmthm7.p1.m5" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> both exist as effective divisors in <math id="S3.Thmthm7.p1.m6" class="ltx_Math" alttext="{\mathcal{H}}_{d,g}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{d,g}</annotation></semantics></math>. Then the divisor class <math id="S3.Thmthm7.p1.m7" class="ltx_Math" alttext="{\mathsf{Y}}" display="inline" intent=":literal"><semantics><mi>𝖸</mi><annotation encoding="application/x-tex">{\mathsf{Y}}</annotation></semantics></math> appearing in (<a href="#S3.E14" title="In 3.6 ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.14</span></a>) is an effective combination of boundary divisors.</span></p>
</div>
</div>
<div id="S3.SS7.p2" class="ltx_para">
<p id="S3.SS7.p2.1" class="ltx_p">The proof of <a href="#S3.Thmthm7" title="Theorem 3.7 (Key result for ). ‣ 3.7 The key result. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.7</span></a> will be the subject of section <a href="#S4" title="4 The slope problem. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<div id="S3.Thmthm8" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm8.2" class="ltx_text ltx_font_italic">Remark 3.8</span></span><span id="S3.Thmthm8.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm8.p1" class="ltx_para">
<p id="S3.Thmthm8.p1.1" class="ltx_p">We only want to demonstrate the effectivity of <math id="S3.Thmthm8.p1.m1" class="ltx_Math" alttext="{{\mathsf{Y}}}" display="inline" intent=":literal"><semantics><mi>𝖸</mi><annotation encoding="application/x-tex">{{\mathsf{Y}}}</annotation></semantics></math> – we will not calculate the exact class of <math id="S3.Thmthm8.p1.m2" class="ltx_Math" alttext="{{\mathsf{Y}}}" display="inline" intent=":literal"><semantics><mi>𝖸</mi><annotation encoding="application/x-tex">{{\mathsf{Y}}}</annotation></semantics></math>. (To see an exact expression of the class of <math id="S3.Thmthm8.p1.m3" class="ltx_Math" alttext="{{\mathsf{M}}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{{\mathsf{M}}}</annotation></semantics></math> in <math id="S3.Thmthm8.p1.m4" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{3,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{3,g}</annotation></semantics></math>, we refer the reader to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx15" title="" class="ltx_ref">DP12</a>]</cite>.)</p>
</div>
</div>
<div id="S3.Thmthm9" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm9.2" class="ltx_text ltx_font_italic">Remark 3.9</span></span><span id="S3.Thmthm9.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm9.p1" class="ltx_para">
<p id="S3.Thmthm9.p1.1" class="ltx_p">The reason we use Deopurkar’s compactification <math id="S3.Thmthm9.p1.m1" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> as opposed to the usual space of twisted stable maps <math id="S3.Thmthm9.p1.m2" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}</annotation></semantics></math> is clear: one parameter families of branched covers typically have pairs of branch points colliding. If we did not use Deopurkar’s space, we would have to perform base changes every time two branch points collided, which would be an unnecessary complication.</p>
</div>
</div>
</section>
<section id="S3.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.8 The locus <math id="S3.SS8.m1" class="ltx_Math" alttext="\mathcal{M}^{1}_{d,g}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>1</mn></msubsup><annotation encoding="application/x-tex">\mathcal{M}^{1}_{d,g}</annotation></semantics></math></h3>

<div id="S3.SS8.p1" class="ltx_para">
<p id="S3.SS8.p1.1" class="ltx_p">We should justify our passage to the space <math id="S3.SS8.p1.m1" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> when considering the slope problem for the loci <math id="S3.SS8.p1.m2" class="ltx_Math" alttext="\mathcal{M}^{1}_{d,g}\subset{\overline{\mathcal{M}}_{g}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>1</mn></msubsup><mo>⊂</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mi>g</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}^{1}_{d,g}\subset{\overline{\mathcal{M}}_{g}}</annotation></semantics></math>. A sweeping family <math id="S3.SS8.p1.m3" class="ltx_Math" alttext="S\longrightarrow\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">⟶</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">S\longrightarrow\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> can automatically be regarded as a sweeping family <math id="S3.SS8.p1.m4" class="ltx_Math" alttext="S\longrightarrow\mathcal{M}^{1}_{d,g}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">⟶</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">S\longrightarrow\mathcal{M}^{1}_{d,g}</annotation></semantics></math> having the same slope. The converse is also true, which roughly states that a sweeping family in <math id="S3.SS8.p1.m5" class="ltx_Math" alttext="\mathcal{M}^{1}_{d,g}\subset{\overline{\mathcal{M}}_{g}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>1</mn></msubsup><mo>⊂</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mi>g</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}^{1}_{d,g}\subset{\overline{\mathcal{M}}_{g}}</annotation></semantics></math> can be “lifted” to a sweeping family in <math id="S3.SS8.p1.m6" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{2}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{2}</annotation></semantics></math> with the same slope. In the cases of interest for us, the inequality <math id="S3.SS8.p1.m7" class="ltx_Math" alttext="d\leq g/2+1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≤</mo><mrow><mrow><mi>g</mi><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">d\leq g/2+1</annotation></semantics></math> holds, so we assume it in the next lemma:</p>
</div>
<div id="S3.Thmthm10" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm10.2" class="ltx_text ltx_font_bold">Lemma 3.10</span></span><span id="S3.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm10.p1" class="ltx_para">
<p id="S3.Thmthm10.p1.1" class="ltx_p"><span id="S3.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm10.p1.m1" class="ltx_Math" alttext="f{\colon}S\longrightarrow\mathcal{M}^{1}_{d,g}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">⟶</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">f{\colon}S\longrightarrow\mathcal{M}^{1}_{d,g}</annotation></semantics></math> be a sweeping family parametrized by a smooth proper curve <math id="S3.Thmthm10.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, and suppose <math id="S3.Thmthm10.p1.m3" class="ltx_Math" alttext="d\leq g/2+1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≤</mo><mrow><mrow><mi>g</mi><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">d\leq g/2+1</annotation></semantics></math>. Then there exists a sweeping family <math id="S3.Thmthm10.p1.m4" class="ltx_Math" alttext="f^{\prime}{\colon}S^{\prime}\longrightarrow\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">⟶</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">f^{\prime}{\colon}S^{\prime}\longrightarrow\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> parametrized by a smooth proper curve <math id="S3.Thmthm10.p1.m5" class="ltx_Math" alttext="S^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>′</mo></msup><annotation encoding="application/x-tex">S^{\prime}</annotation></semantics></math> such that <math id="S3.Thmthm10.p1.m6" class="ltx_Math" alttext="s(S^{\prime})=s(S)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s(S^{\prime})=s(S)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS8.p2" class="ltx_para">
<p id="S3.SS8.p2.1" class="ltx_p"><span id="S3.SS8.p2.1.1" class="ltx_text">To say that <math id="S3.SS8.p2.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is a sweeping family is to say there exists a proper flat family of curves</span></p>
<table id="S3.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex14.m1" class="ltx_Math" alttext="g{\colon}{\mathcal{S}}\longrightarrow B" display="block" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">⟶</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">g{\colon}{\mathcal{S}}\longrightarrow B</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.p2.2" class="ltx_p"><span id="S3.SS8.p2.2.1" class="ltx_text">and a dominant morphism <math id="S3.SS8.p2.m2" class="ltx_Math" alttext="m{\colon}{\mathcal{S}}\longrightarrow\mathcal{M}^{1}_{d,g}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">⟶</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">m{\colon}{\mathcal{S}}\longrightarrow\mathcal{M}^{1}_{d,g}</annotation></semantics></math> where <math id="S3.SS8.p2.m3" class="ltx_Math" alttext="g^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g^{-1}(0)</annotation></semantics></math> = <math id="S3.SS8.p2.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> for some point <math id="S3.SS8.p2.m5" class="ltx_Math" alttext="0\in B" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>∈</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">0\in B</annotation></semantics></math>. We may assume <math id="S3.SS8.p2.m6" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is integral and normal.</span></p>
</div>
<div id="S3.SS8.p3" class="ltx_para">
<p id="S3.SS8.p3.1" class="ltx_p"><span id="S3.SS8.p3.1.1" class="ltx_text">Let</span></p>
<table id="S3.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex15.m1" class="ltx_Math" alttext="q{\colon}{\overline{\mathcal{M}}_{g}}\longrightarrow\overline{M}_{g}" display="block" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mi>g</mi></msub><mo stretchy="false">⟶</mo><msub><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mi>g</mi></msub></mrow></mrow><annotation encoding="application/x-tex">q{\colon}{\overline{\mathcal{M}}_{g}}\longrightarrow\overline{M}_{g}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.p3.2" class="ltx_p"><span id="S3.SS8.p3.2.1" class="ltx_text">be the map to the coarse space. Then, by abusing notation, we let <math id="S3.SS8.p3.m1" class="ltx_Math" alttext="m{\colon}{\mathcal{S}}\longrightarrow\overline{M}_{g}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">⟶</mo><msub><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mi>g</mi></msub></mrow></mrow><annotation encoding="application/x-tex">m{\colon}{\mathcal{S}}\longrightarrow\overline{M}_{g}</annotation></semantics></math> also denote the composite morphism to the coarse space. We then take the fiber product</span></p>
</div>
<div id="S3.SS8.p4" class="ltx_para">
<table id="S3.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.E15.m1.pic1" class="ltx_picture ltx_markedasmath" height="73.57" overflow="visible" style="vertical-align:-57.24366281608897px" version="1.1" viewBox="31.20 57.24 132.67 73.57" width="132.67"><g transform="matrix(1 0 0 -1 31.19893467935995 73.56522537554483) translate(0,3.46) translate(31.2,0)"><g transform="translate(-31.2,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.91em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.47em;font-size:10pt;" height="18.8" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="54.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E15.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{{\mathcal{S}}\times_{\overline{M}_{g}}\overline{H}_{d,g}^{(2)}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mi>g</mi></msub></msub><msubsup><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{{\mathcal{S}}\times_{\overline{M}_{g}}\overline{H}_{d,g}^{(2)}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 31.19893467935995 -0.27673578005007266 L 31.19893467935995 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(31.4,0) translate(0,8.16) translate(4.15,0) translate(0,-4.01)"><foreignObject style="--ltx-fo-width:0.98em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10pt;" height="8.02" overflow="visible" transform="matrix(1 0 0 -1 0 8.02)" width="13.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E15.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{m^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em">m</mi><mo mathsize="0.710em">′</mo></msup><annotation encoding="application/x-tex">\scriptstyle{m^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(69.39,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 31.19893467935995 -0.27673578005007266 L 69.38885237082944 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 69.38885237082944 -0.27673578005007266 L 69.38885237082944 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -14.121400150369276 L 0.27673578005007266 -14.121400150369276" fill="none" stroke="#000000"></path><g transform="translate(-14.78,0) translate(0,-22.39) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E15.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{f}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">f</mi><annotation encoding="application/x-tex">\scriptstyle{f}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-34.62)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.62404404436056 L 0.27673578005007266 -14.121400150369276" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.62404404436056 L 0.27673578005007266 -34.62404404436056" fill="none" stroke="#000000"></path><g transform="translate(69.39,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.61em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.29em;font-size:10pt;" height="16.24" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="22.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E15.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{\overline{H}_{d,g}^{(2)}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\textstyle{\overline{H}_{d,g}^{(2)}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 84.3876276138958 -11.569253138458645 L 84.94109917399595 -11.569253138458645" fill="none" stroke="#000000"></path><g transform="translate(84.67,0) translate(0,-22.39) translate(4.15,0) translate(0,-3.31)"><foreignObject style="--ltx-fo-width:0.61em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:10pt;" height="6.62" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="8.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E15.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{F}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">F</mi><annotation encoding="application/x-tex">\scriptstyle{F}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(84.67,0) translate(0,-36.22)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 84.3876276138958 -36.22297596037429 L 84.94109917399595 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 84.3876276138958 -36.22297596037429 L 84.94109917399595 -36.22297596037429" fill="none" stroke="#000000"></path><g transform="translate(-7.99,0) translate(0,-44.77) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.56em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="7.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E15.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{{\mathcal{S}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\textstyle{{\mathcal{S}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 7.994722920828577 -45.04788510776645 L 7.994722920828577 -44.494413547666305" fill="none" stroke="#000000"></path><g transform="translate(33.27,0) translate(0,-51.01) translate(4.15,0) translate(0,-2.09)"><foreignObject style="--ltx-fo-width:0.71em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="9.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E15.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{m}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">m</mi><annotation encoding="application/x-tex">\scriptstyle{m}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(73.84,0) translate(0,-44.77)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 7.994722920828577 -45.04788510776645 L 73.8352048078711 -44.494413547666305" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 73.8352048078711 -45.04788510776645 L 73.8352048078711 -44.494413547666305" fill="none" stroke="#000000"></path><g transform="translate(73.84,0) translate(0,-44.77) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.97em;--ltx-fo-height:0.57em;--ltx-fo-depth:0.29em;font-size:10pt;" height="11.82" overflow="visible" transform="matrix(1 0 0 -1 0 7.86)" width="13.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E15.m1.pic1.m10" class="ltx_Math" alttext="\textstyle{\overline{M}_{g}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mi>g</mi></msub><annotation encoding="application/x-tex">\textstyle{\overline{M}_{g}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.15)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS8.p5" class="ltx_para">
<p id="S3.SS8.p5.1" class="ltx_p"><span id="S3.SS8.p5.1.1" class="ltx_text">The inequality <math id="S3.SS8.p5.m1" class="ltx_Math" alttext="d\leq g/2+1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≤</mo><mrow><mrow><mi>g</mi><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">d\leq g/2+1</annotation></semantics></math> implies that the forgetful map <math id="S3.SS8.p5.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is generically finite onto the <math id="S3.SS8.p5.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-gonal locus. Since <math id="S3.SS8.p5.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> dominates the <math id="S3.SS8.p5.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-gonal locus, we conclude that <math id="S3.SS8.p5.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is dominant. Therefore, we may choose a component <math id="S3.SS8.p5.m7" class="ltx_Math" alttext="Z\subset{\mathcal{S}}\times_{\overline{M}_{g}}\overline{H}_{d,g}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mi>g</mi></msub></msub><msubsup><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">Z\subset{\mathcal{S}}\times_{\overline{M}_{g}}\overline{H}_{d,g}^{2}</annotation></semantics></math> dominating <math id="S3.SS8.p5.m8" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS8.p6" class="ltx_para">
<p id="S3.SS8.p6.1" class="ltx_p"><span id="S3.SS8.p6.1.1" class="ltx_text">Now we appeal to the fact that <math id="S3.SS8.p6.m1" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math> is a “global quotient” stack (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx18" title="" class="ltx_ref">EHKV01</a>]</cite>), that is to say there exists a finite cover <math id="S3.SS8.p6.m2" class="ltx_Math" alttext="Z^{\prime}\longrightarrow Z" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mo>′</mo></msup><mo stretchy="false">⟶</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">Z^{\prime}\longrightarrow Z</annotation></semantics></math> with a morphism <math id="S3.SS8.p6.m3" class="ltx_Math" alttext="\widetilde{m}^{\prime}{\colon}Z^{\prime}\longrightarrow\overline{{\mathcal{H}}}_{d,g}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>m</mi><mo>~</mo></mover><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>Z</mi><mo>′</mo></msup><mo stretchy="false">⟶</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\widetilde{m}^{\prime}{\colon}Z^{\prime}\longrightarrow\overline{{\mathcal{H}}}_{d,g}^{2}</annotation></semantics></math> lifting the morphism <math id="S3.SS8.p6.m4" class="ltx_Math" alttext="m^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mo>′</mo></msup><annotation encoding="application/x-tex">m^{\prime}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS8.p7" class="ltx_para">
<p id="S3.SS8.p7.1" class="ltx_p"><span id="S3.SS8.p7.1.1" class="ltx_text">We replace <math id="S3.SS8.p7.m1" class="ltx_Math" alttext="Z^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>Z</mi><mo>′</mo></msup><annotation encoding="application/x-tex">Z^{\prime}</annotation></semantics></math> with its normalization and consider the natural surjective map <math id="S3.SS8.p7.m2" class="ltx_Math" alttext="t{\colon}Z^{\prime}\longrightarrow B" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>Z</mi><mo>′</mo></msup><mo stretchy="false">⟶</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">t{\colon}Z^{\prime}\longrightarrow B</annotation></semantics></math>. Since <math id="S3.SS8.p7.m3" class="ltx_Math" alttext="Z^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>Z</mi><mo>′</mo></msup><annotation encoding="application/x-tex">Z^{\prime}</annotation></semantics></math> is normal, the general fiber of <math id="S3.SS8.p7.m4" class="ltx_Math" alttext="\widetilde{m}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>m</mi><mo>~</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\widetilde{m}^{\prime}</annotation></semantics></math> will be a smooth curve <math id="S3.SS8.p7.m5" class="ltx_Math" alttext="S^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>′</mo></msup><annotation encoding="application/x-tex">S^{\prime}</annotation></semantics></math>, and will map finitely onto the corresponding fiber of the original family <math id="S3.SS8.p7.m6" class="ltx_Math" alttext="g{\colon}{\mathcal{S}}\longrightarrow B" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">⟶</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">g{\colon}{\mathcal{S}}\longrightarrow B</annotation></semantics></math>. The lemma follows by considering the family of admissible covers parametrized by <math id="S3.SS8.p7.m7" class="ltx_Math" alttext="S^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>′</mo></msup><annotation encoding="application/x-tex">S^{\prime}</annotation></semantics></math>, i.e. <math id="S3.SS8.p7.m8" class="ltx_Math" alttext="s(S^{\prime})=s(S)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s(S^{\prime})=s(S)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS9" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.9 Constructing families of trigonal curves.</h3>

<div id="S3.SS9.p1" class="ltx_para">
<p id="S3.SS9.p1.1" class="ltx_p">Let <math id="S3.SS9.p1.m1" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> denote either the Hirzebruch surface <math id="S3.SS9.p1.m2" class="ltx_Math" alttext="{\bf F}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\bf F}_{0}</annotation></semantics></math> or <math id="S3.SS9.p1.m3" class="ltx_Math" alttext="{\bf F}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\bf F}_{1}</annotation></semantics></math> (depending on the parity of the genus), and let <math id="S3.SS9.p1.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> be a smooth trigonal curve of genus <math id="S3.SS9.p1.m5" class="ltx_Math" alttext="g_{R}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>R</mi></msub><annotation encoding="application/x-tex">g_{R}</annotation></semantics></math> on <math id="S3.SS9.p1.m6" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS9.p2" class="ltx_para">
<p id="S3.SS9.p2.1" class="ltx_p">We choose a general pencil <math id="S3.SS9.p2.m1" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|{\mathcal{O}}_{{\bf F}}(C)|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|{\mathcal{O}}_{{\bf F}}(C)|</annotation></semantics></math>, and let <math id="S3.SS9.p2.m2" class="ltx_Math" alttext="p{\colon}Y\longrightarrow{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">⟶</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">p{\colon}Y\longrightarrow{\bf P}^{1}_{t}</annotation></semantics></math> be the total space. Then we have</p>
</div>
<div id="S3.Thmthm11" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm11.2" class="ltx_text ltx_font_bold">Proposition 3.11</span></span><span id="S3.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm11.p1" class="ltx_para">
<p id="S3.Thmthm11.p1.1" class="ltx_p"><span id="S3.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">The intersection numbers of the pencil <math id="S3.Thmthm11.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> are:</span></p>
<table id="S3.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex16.m1" class="ltx_Math" alttext="\displaystyle\lambda\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\lambda\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex16.m2" class="ltx_Math" alttext="\displaystyle=g_{R}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=g_{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex17.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex17.m2" class="ltx_Math" alttext="\displaystyle=7g_{R}+6" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>+</mo><mn>6</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=7g_{R}+6</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm11.p1.2" class="ltx_p"><span id="S3.Thmthm11.p1.2.1" class="ltx_text ltx_font_italic">Furthermore, the pencil <math id="S3.Thmthm11.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> only has irreducible nodal singular fibers.</span></p>
</div>
</div>
<div id="S3.SS9.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS9.p3" class="ltx_para">
<p id="S3.SS9.p3.1" class="ltx_p"><span id="S3.SS9.p3.1.1" class="ltx_text">This is a standard computation and application of Bertini’s theorem - we omit it.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS10" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.10 Rigidity and Extremality of <math id="S3.SS10.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> for trigonal curves.</h3>

<div id="S3.SS10.p1" class="ltx_para">
<p id="S3.SS10.p1.1" class="ltx_p">We are ready to prove our first extremality and rigidity result – the case of the Maroni divisor <math id="S3.SS10.p1.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> in <math id="S3.SS10.p1.m2" class="ltx_Math" alttext="\overline{{\mathcal{H}}}^{(2)}_{3,g}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}^{(2)}_{3,g}</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmthm12" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm12.2" class="ltx_text ltx_font_bold">Definition 3.12</span></span><span id="S3.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm12.p1" class="ltx_para">
<p id="S3.Thmthm12.p1.1" class="ltx_p">A closed subvariety (or substack) <math id="S3.Thmthm12.p1.m1" class="ltx_Math" alttext="Y\subset X" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>⊂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">Y\subset X</annotation></semantics></math> is <span id="S3.Thmthm12.p1.1.1" class="ltx_text ltx_font_slanted">rigid</span> if there exists no nonconstant family <math id="S3.Thmthm12.p1.m2" class="ltx_Math" alttext="\mathcal{{\mathcal{Y}}}\subset X\times{\text{\rm Spec}\,}k[[t]]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⊂</mo><mrow><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mtext>Spec</mtext></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{{\mathcal{Y}}}\subset X\times{\text{\rm Spec}\,}k[[t]]</annotation></semantics></math>, flat over <math id="S3.Thmthm12.p1.m3" class="ltx_Math" alttext="{\text{\rm Spec}\,}k[[t]]" display="inline" intent=":literal"><semantics><mrow><mtext>Spec</mtext><mo lspace="0.170em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\text{\rm Spec}\,}k[[t]]</annotation></semantics></math>, with <math id="S3.Thmthm12.p1.m4" class="ltx_Math" alttext="{\mathcal{Y}}\cap X\times\{0\}=Y" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>∩</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>=</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">{\mathcal{Y}}\cap X\times\{0\}=Y</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.Thmthm13" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm13.2" class="ltx_text ltx_font_bold">Theorem 3.13</span></span><span id="S3.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm13.p1" class="ltx_para">
<p id="S3.Thmthm13.p1.1" class="ltx_p"><span id="S3.Thmthm13.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm13.p1.m1" class="ltx_Math" alttext="g\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">g\geq 4</annotation></semantics></math> be even. Then the Maroni divisor <math id="S3.Thmthm13.p1.m2" class="ltx_Math" alttext="{\mathsf{M}}\subset\overline{{\mathcal{H}}}^{(2)}_{3,g}" display="inline" intent=":literal"><semantics><mrow><mi>𝖬</mi><mo>⊂</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\mathsf{M}}\subset\overline{{\mathcal{H}}}^{(2)}_{3,g}</annotation></semantics></math> is rigid and extremal in the effective cone of divisors <math id="S3.Thmthm13.p1.m3" class="ltx_Math" alttext="{\rm Eff}\,(\overline{{\mathcal{H}}}^{(2)}_{3,g})." display="inline" intent=":literal"><semantics><mrow><mrow><mi>Eff</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm Eff}\,(\overline{{\mathcal{H}}}^{(2)}_{3,g}).</annotation></semantics></math></span></p>
</div>
</div>
<div id="S3.SS10.p2" class="ltx_para">
<p id="S3.SS10.p2.1" class="ltx_p">First we prove the following proposition:</p>
</div>
<div id="S3.Thmthm14" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm14.2" class="ltx_text ltx_font_bold">Proposition 3.14</span></span><span id="S3.Thmthm14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm14.p1" class="ltx_para">
<p id="S3.Thmthm14.p1.1" class="ltx_p"><span id="S3.Thmthm14.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm14.p1.m1" class="ltx_Math" alttext="[{\bf P}^{1}_{t}]\in A_{1}(\widetilde{{\mathcal{H}}}_{3,g}\setminus{\mathsf{M}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mi>𝖬</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[{\bf P}^{1}_{t}]\in A_{1}(\widetilde{{\mathcal{H}}}_{3,g}\setminus{\mathsf{M}})</annotation></semantics></math> be the curve class given by a pencil <math id="S3.Thmthm14.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|{\mathcal{O}}_{{\bf F}_{0}}(C)|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>𝐅</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|{\mathcal{O}}_{{\bf F}_{0}}(C)|</annotation></semantics></math> as in section <a href="#S3.SS9" title="3.9 Constructing families of trigonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.9</span></a>. Then there exists a positive integer <math id="S3.Thmthm14.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> with the following property: There exists an irreducible proper curve in the class <math id="S3.Thmthm14.p1.m4" class="ltx_Math" alttext="m[{\bf P}^{1}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">m[{\bf P}^{1}_{t}]</annotation></semantics></math> contained entirely in <math id="S3.Thmthm14.p1.m5" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{3,g}\setminus{\mathsf{M}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mi>𝖬</mi></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{3,g}\setminus{\mathsf{M}}</annotation></semantics></math> which passes through any two prescribed points <math id="S3.Thmthm14.p1.m6" class="ltx_Math" alttext="\alpha_{1},\alpha_{2}\in\widetilde{{\mathcal{H}}}_{3,g}\setminus{\mathsf{M}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo>∈</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mi>𝖬</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha_{1},\alpha_{2}\in\widetilde{{\mathcal{H}}}_{3,g}\setminus{\mathsf{M}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS10.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS10.p3" class="ltx_para">
<p id="S3.SS10.p3.1" class="ltx_p"><span id="S3.SS10.p3.1.1" class="ltx_text">In the linear system <math id="S3.SS10.p3.m1" class="ltx_Math" alttext="|{\mathcal{O}}_{{\bf F}_{0}}(C)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>𝐅</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\mathcal{O}}_{{\bf F}_{0}}(C)|</annotation></semantics></math>, which is a projective space, we remove the codimension two locus <math id="S3.SS10.p3.m2" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> of curves which are worse-than-nodal. Since this locus has codimension <math id="S3.SS10.p3.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, there exists an integer <math id="S3.SS10.p3.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> with the property that we may join any two points in the complement <math id="S3.SS10.p3.m5" class="ltx_Math" alttext="|{\mathcal{O}}_{{\bf F}_{0}}(C)|\setminus Z" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>𝐅</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>∖</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">|{\mathcal{O}}_{{\bf F}_{0}}(C)|\setminus Z</annotation></semantics></math> by a complete curve <math id="S3.SS10.p3.m6" class="ltx_Math" alttext="S\subset|{\mathcal{O}}_{{\bf F}_{0}}(C)|\setminus Z" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>𝐅</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>∖</mo><mi>Z</mi></mrow></mrow><annotation encoding="application/x-tex">S\subset|{\mathcal{O}}_{{\bf F}_{0}}(C)|\setminus Z</annotation></semantics></math> of degree <math id="S3.SS10.p3.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS10.p4" class="ltx_para">
<p id="S3.SS10.p4.1" class="ltx_p"><span id="S3.SS10.p4.1.1" class="ltx_text">The resulting curve class <math id="S3.SS10.p4.m1" class="ltx_Math" alttext="[S]\in A_{1}(\widetilde{{\mathcal{H}}}_{3,g}\setminus{\mathsf{M}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mi>𝖬</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[S]\in A_{1}(\widetilde{{\mathcal{H}}}_{3,g}\setminus{\mathsf{M}})</annotation></semantics></math> is clearly <math id="S3.SS10.p4.m2" class="ltx_Math" alttext="m[{\bf P}^{1}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">m[{\bf P}^{1}_{t}]</annotation></semantics></math>, and serves our purposes.
∎</span></p>
</div>
</div>
<div id="S3.SS10.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S3.Thmthm13" title="Theorem 3.13. ‣ 3.10 Rigidity and Extremality of 
          
            M
          
         for trigonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.13</span></a>.</h6>
<div id="S3.SS10.p5" class="ltx_para">
<p id="S3.SS10.p5.1" class="ltx_p"><span id="S3.SS10.p5.1.1" class="ltx_text">By considering the one-parameter family <math id="S3.SS10.p5.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> from the proof of <a href="#S3.Thmthm14" title="Proposition 3.14. ‣ 3.10 Rigidity and Extremality of 
          
            M
          
         for trigonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.14</span></a>, we see that there exists a complete one parameter family of twisted admissible covers, which we continue to denote by <math id="S3.SS10.p5.m2" class="ltx_Math" alttext="S\longrightarrow\overline{{\mathcal{H}}}^{(2)}_{3,g}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">⟶</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">S\longrightarrow\overline{{\mathcal{H}}}^{(2)}_{3,g}</annotation></semantics></math>, which avoids <math id="S3.SS10.p5.m3" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>, and only intersects <math id="S3.SS10.p5.m4" class="ltx_Math" alttext="\Delta_{{\rm irr}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>irr</mi></msub><annotation encoding="application/x-tex">\Delta_{{\rm irr}}</annotation></semantics></math> and <math id="S3.SS10.p5.m5" class="ltx_Math" alttext="{\mathsf{T}}" display="inline" intent=":literal"><semantics><mi>𝖳</mi><annotation encoding="application/x-tex">{\mathsf{T}}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS10.p6" class="ltx_para">
<p id="S3.SS10.p6.1" class="ltx_p"><span id="S3.SS10.p6.1.1" class="ltx_text">Furthermore, <math id="S3.SS10.p6.m1" class="ltx_Math" alttext="[S]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[S]</annotation></semantics></math> is flexible enough to pass through any two points in the complement <math id="S3.SS10.p6.m2" class="ltx_Math" alttext="\overline{{\mathcal{H}}}^{(2)}_{3,g}\setminus({\mathsf{M}}\cup\{\text{higher boundary div.}\})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mtext>higher boundary div.</mtext><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}^{(2)}_{3,g}\setminus({\mathsf{M}}\cup\{\text{higher boundary div.}\})</annotation></semantics></math>. Therefore, <math id="S3.SS10.p6.m3" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> cannot be deformed to a divisor <math id="S3.SS10.p6.m4" class="ltx_Math" alttext="M^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mo>′</mo></msup><annotation encoding="application/x-tex">M^{\prime}</annotation></semantics></math> since <math id="S3.SS10.p6.m5" class="ltx_Math" alttext="[S]\cdot{\mathsf{M}}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mi>S</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝖬</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">[S]\cdot{\mathsf{M}}=0</annotation></semantics></math>, while <math id="S3.SS10.p6.m6" class="ltx_Math" alttext="[S]\cdot M^{\prime}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mi>S</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mi>M</mi><mo>′</mo></msup></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">[S]\cdot M^{\prime}&gt;0</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS10.p7" class="ltx_para">
<p id="S3.SS10.p7.1" class="ltx_p"><span id="S3.SS10.p7.1.1" class="ltx_text">Moreover, if</span></p>
<table id="S3.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex18.m1" class="ltx_Math" alttext="{\mathsf{M}}=\sum_{i}a_{i}E_{i},\,\,\,\,\,a_{i}&gt;0" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝖬</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>i</mi></msub></mrow></mrow></mrow><mo rspace="1.017em">,</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{M}}=\sum_{i}a_{i}E_{i},\,\,\,\,\,a_{i}&gt;0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS10.p7.2" class="ltx_p"><span id="S3.SS10.p7.2.1" class="ltx_text">is an effective combination of cycles <math id="S3.SS10.p7.m1" class="ltx_Math" alttext="E_{i}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>i</mi></msub><annotation encoding="application/x-tex">E_{i}</annotation></semantics></math> in <math id="S3.SS10.p7.m2" class="ltx_Math" alttext="{\rm Pic}\,_{{\bf Q}}\overline{{\mathcal{H}}}^{(2)}_{3,g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pic</mi><mi>𝐐</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\rm Pic}\,_{{\bf Q}}\overline{{\mathcal{H}}}^{(2)}_{3,g}</annotation></semantics></math>, none of which are supported on <math id="S3.SS10.p7.m3" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>, we deduce: <span id="S3.SS10.p7.2.1.1" class="ltx_text ltx_font_slanted">The <math id="S3.SS10.p7.m4" class="ltx_Math" alttext="E_{i}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>i</mi></msub><annotation encoding="application/x-tex">E_{i}</annotation></semantics></math> must be supported on the higher boundary divisors in <math id="S3.SS10.p7.m5" class="ltx_Math" alttext="\overline{{\mathcal{H}}}^{(2)}_{3,g}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}^{(2)}_{3,g}</annotation></semantics></math>.</span></span></p>
</div>
<div id="S3.SS10.p8" class="ltx_para">
<p id="S3.SS10.p8.1" class="ltx_p"><span id="S3.SS10.p8.1.1" class="ltx_text">But if <math id="S3.SS10.p8.m1" class="ltx_Math" alttext="a_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{i}&gt;0</annotation></semantics></math>, we would obtain a nontrivial relation among <math id="S3.SS10.p8.m2" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and the higher boundary divisors, which is impossible by <a href="#S3.Thmthm6" title="Corollary 3.6. ‣ 3.4 The divisor classes of 
          
            M
          
         and 
          
            CE
          
        . ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.6</span></a>.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm15" class="ltx_theorem ltx_theorem_rmk">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm15.2" class="ltx_text ltx_font_italic">Remark 3.15</span></span><span id="S3.Thmthm15.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm15.p1" class="ltx_para">
<p id="S3.Thmthm15.p1.1" class="ltx_p">The method of proof of <a href="#S3.Thmthm13" title="Theorem 3.13. ‣ 3.10 Rigidity and Extremality of 
          
            M
          
         for trigonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.13</span></a> also shows that <math id="S3.Thmthm15.p1.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> is rigid and extremal when viewed as a divisor in <math id="S3.Thmthm15.p1.m2" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{3,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{3,g}</annotation></semantics></math> or <math id="S3.Thmthm15.p1.m3" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{3,g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{3,g}</annotation></semantics></math>. For the former, we use the same family <math id="S3.Thmthm15.p1.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. For the later, we pass to the admissible replacement of <math id="S3.Thmthm15.p1.m5" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> (base change required).</p>
</div>
</div>
</section>
<section id="S3.SS11" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.11 Constructing families of tetragonal curves.</h3>

<div id="S3.SS11.p1" class="ltx_para">
<p id="S3.SS11.p1.1" class="ltx_p">For any branched cover <math id="S3.SS11.p1.m1" class="ltx_math_unparsed" alttext="[\alpha{\colon}C\longrightarrow{\bf P}^{1}]\in\widetilde{{\mathcal{H}}}_{4,g}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>C</mi><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo stretchy="false">]</mo></mrow><mo>∈</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">[\alpha{\colon}C\longrightarrow{\bf P}^{1}]\in\widetilde{{\mathcal{H}}}_{4,g}</annotation></semantics></math>, the Casnati-Ekedahl resolution is determined by the map</p>
<table id="S3.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E16.m1" class="ltx_Math" alttext="\pi^{*}{\mathcal{F}}(-2)\longrightarrow{\mathcal{O}}_{{\bf P}{\mathcal{E}}}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\pi^{*}{\mathcal{F}}(-2)\longrightarrow{\mathcal{O}}_{{\bf P}{\mathcal{E}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.16)</span></td></tr></tbody>
</table>
<p id="S3.SS11.p1.2" class="ltx_p">which in turn is determined, up to scalar multiple, by a global section <math id="S3.SS11.p1.m2" class="ltx_Math" alttext="\eta\in H^{0}({\bf P}^{1},{\mathcal{F}}^{\vee}\otimes{\rm Sym}^{2}{\mathcal{E}})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>Sym</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta\in H^{0}({\bf P}^{1},{\mathcal{F}}^{\vee}\otimes{\rm Sym}^{2}{\mathcal{E}})</annotation></semantics></math>. For a general tetragonal curve <math id="S3.SS11.p1.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, the bundles <math id="S3.SS11.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> and <math id="S3.SS11.p1.m5" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math> are balanced, and we assume they are throughout this section.</p>
</div>
<div id="S3.SS11.p2" class="ltx_para">
<p id="S3.SS11.p2.1" class="ltx_p">The locus <math id="S3.SS11.p2.m1" class="ltx_Math" alttext="Z\subset{\bf P}(H^{0}({\bf P}^{1},{\mathcal{F}}^{\vee}\otimes{\rm Sym}^{2}{\mathcal{E}}))" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>Sym</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\subset{\bf P}(H^{0}({\bf P}^{1},{\mathcal{F}}^{\vee}\otimes{\rm Sym}^{2}{\mathcal{E}}))</annotation></semantics></math> parametrizing worse-than-nodal schemes in <math id="S3.SS11.p2.m2" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}</annotation></semantics></math> is has codimension two, as seen by a straightforward parameter count and Bertini’s theorem.</p>
</div>
<section id="S3.SS11.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">3.11.1 Constructing families of tetragonal curves I.</h4>

<div id="S3.SS11.SSS1.p1" class="ltx_para">
<p id="S3.SS11.SSS1.p1.1" class="ltx_p">Take a general linear pencil <math id="S3.SS11.SSS1.p1.m1" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset{\bf P}(H^{0}({\bf P}^{1},{\mathcal{F}}^{\vee}\otimes{\rm Sym}^{2}{\mathcal{E}}))" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>Sym</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset{\bf P}(H^{0}({\bf P}^{1},{\mathcal{F}}^{\vee}\otimes{\rm Sym}^{2}{\mathcal{E}}))</annotation></semantics></math>, and consider the resulting family <math id="S3.SS11.SSS1.p1.m2" class="ltx_Math" alttext="f{\colon}{\mathcal{C}}\longrightarrow{\bf P}^{1}_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">⟶</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f{\colon}{\mathcal{C}}\longrightarrow{\bf P}^{1}_{t}.</annotation></semantics></math> We have the exact analogue of <a href="#S3.Thmthm14" title="Proposition 3.14. ‣ 3.10 Rigidity and Extremality of 
          
            M
          
         for trigonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.14</span></a>:</p>
</div>
<div id="S3.Thmthm16" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm16.2" class="ltx_text ltx_font_bold">Proposition 3.16</span></span><span id="S3.Thmthm16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm16.p1" class="ltx_para">
<p id="S3.Thmthm16.p1.1" class="ltx_p"><span id="S3.Thmthm16.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm16.p1.m1" class="ltx_Math" alttext="[{\bf P}^{1}_{t}]\in A_{1}(\widetilde{{\mathcal{H}}}_{4,g}\setminus{\mathsf{M}}\cup{\mathsf{CE}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mi>𝖬</mi></mrow><mo>∪</mo><mi>𝖢𝖤</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[{\bf P}^{1}_{t}]\in A_{1}(\widetilde{{\mathcal{H}}}_{4,g}\setminus{\mathsf{M}}\cup{\mathsf{CE}})</annotation></semantics></math> be the curve class given by a pencil <math id="S3.Thmthm16.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset{\bf P}(H^{0}({\bf P}^{1},{\mathcal{F}}^{\vee}\otimes{\rm Sym}^{2}{\mathcal{E}}))" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>Sym</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset{\bf P}(H^{0}({\bf P}^{1},{\mathcal{F}}^{\vee}\otimes{\rm Sym}^{2}{\mathcal{E}}))</annotation></semantics></math> as above. Then there exists a positive integer <math id="S3.Thmthm16.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> with the following property: There exists an irreducible proper curve of class <math id="S3.Thmthm16.p1.m4" class="ltx_Math" alttext="m[{\bf P}^{1}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">m[{\bf P}^{1}_{t}]</annotation></semantics></math> contained in <math id="S3.Thmthm16.p1.m5" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{4,g}\setminus({\mathsf{M}}\cup{\mathsf{CE}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∪</mo><mi>𝖢𝖤</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{4,g}\setminus({\mathsf{M}}\cup{\mathsf{CE}})</annotation></semantics></math> which passes through any two prescribed points <math id="S3.Thmthm16.p1.m6" class="ltx_Math" alttext="\alpha_{1},\alpha_{2}\in\widetilde{{\mathcal{H}}}_{4,g}\setminus({\mathsf{M}}\cup{\mathsf{CE}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo>∈</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∪</mo><mi>𝖢𝖤</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha_{1},\alpha_{2}\in\widetilde{{\mathcal{H}}}_{4,g}\setminus({\mathsf{M}}\cup{\mathsf{CE}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS11.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS11.SSS1.p2" class="ltx_para">
<p id="S3.SS11.SSS1.p2.1" class="ltx_p"><span id="S3.SS11.SSS1.p2.1.1" class="ltx_text">The proof is the same as the proof of <a href="#S3.Thmthm14" title="Proposition 3.14. ‣ 3.10 Rigidity and Extremality of 
          
            M
          
         for trigonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.14</span></a>.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm17" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm17.2" class="ltx_text ltx_font_bold">Theorem 3.17</span></span><span id="S3.Thmthm17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm17.p1" class="ltx_para">
<p id="S3.Thmthm17.p1.1" class="ltx_p"><span id="S3.Thmthm17.p1.1.1" class="ltx_text ltx_font_italic">The effective divisors <math id="S3.Thmthm17.p1.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.Thmthm17.p1.m2" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> are rigid and extremal in the effective cone of divisors <math id="S3.Thmthm17.p1.m3" class="ltx_Math" alttext="{\rm Eff}\,(\overline{{\mathcal{H}}}^{(2)}_{4,g})" display="inline" intent=":literal"><semantics><mrow><mi>Eff</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm Eff}\,(\overline{{\mathcal{H}}}^{(2)}_{4,g})</annotation></semantics></math> with the exception of <math id="S3.Thmthm17.p1.m4" class="ltx_Math" alttext="{\mathcal{H}}_{4,3}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{4,3}</annotation></semantics></math> where the divisor <math id="S3.Thmthm17.p1.m5" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> has two components <math id="S3.Thmthm17.p1.m6" class="ltx_Math" alttext="{\mathsf{A}}" display="inline" intent=":literal"><semantics><mi>𝖠</mi><annotation encoding="application/x-tex">{\mathsf{A}}</annotation></semantics></math> and <math id="S3.Thmthm17.p1.m7" class="ltx_Math" alttext="{\mathsf{B}}" display="inline" intent=":literal"><semantics><mi>𝖡</mi><annotation encoding="application/x-tex">{\mathsf{B}}</annotation></semantics></math>, both of which are extremal and rigid.</span></p>
</div>
</div>
<div id="S3.SS11.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS11.SSS1.p3" class="ltx_para">
<p id="S3.SS11.SSS1.p3.1" class="ltx_p"><span id="S3.SS11.SSS1.p3.1.1" class="ltx_text">We prove the theorem for <math id="S3.SS11.SSS1.p3.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>; the argument for <math id="S3.SS11.SSS1.p3.m2" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> is the same, up to the exception. Suppose we could write</span></p>
<table id="S3.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex19.m1" class="ltx_Math" alttext="{\mathsf{M}}=\sum_{i}a_{i}E_{i}" display="block" intent=":literal"><semantics><mrow><mi>𝖬</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{M}}=\sum_{i}a_{i}E_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS1.p3.2" class="ltx_p"><span id="S3.SS11.SSS1.p3.2.1" class="ltx_text">where <math id="S3.SS11.SSS1.p3.m3" class="ltx_Math" alttext="E_{i}\subset\overline{{\mathcal{H}}}^{(2)}_{4,g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>i</mi></msub><mo>⊂</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">E_{i}\subset\overline{{\mathcal{H}}}^{(2)}_{4,g}</annotation></semantics></math> are irreducible effective divisors, none supported on <math id="S3.SS11.SSS1.p3.m4" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.SS11.SSS1.p3.m5" class="ltx_Math" alttext="a_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{i}&gt;0</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS11.SSS1.p4" class="ltx_para">
<p id="S3.SS11.SSS1.p4.1" class="ltx_p"><span id="S3.SS11.SSS1.p4.1.1" class="ltx_text">The curve class <math id="S3.SS11.SSS1.p4.m1" class="ltx_Math" alttext="m[{\bf P}^{1}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">m[{\bf P}^{1}_{t}]</annotation></semantics></math> clearly has zero intersection with <math id="S3.SS11.SSS1.p4.m2" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>, and therefore must have zero intersection with each irreducible divisor <math id="S3.SS11.SSS1.p4.m3" class="ltx_Math" alttext="E_{i}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>i</mi></msub><annotation encoding="application/x-tex">E_{i}</annotation></semantics></math>. <a href="#S3.Thmthm16" title="Proposition 3.16. ‣ 3.11.1 Constructing families of tetragonal curves I. ‣ 3.11 Constructing families of tetragonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.16</span></a> then implies that the divisors <math id="S3.SS11.SSS1.p4.m4" class="ltx_Math" alttext="E_{i}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>i</mi></msub><annotation encoding="application/x-tex">E_{i}</annotation></semantics></math> must be supported possibly on <math id="S3.SS11.SSS1.p4.m5" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> or the higher boundary divisors. The same proposition also implies that <math id="S3.SS11.SSS1.p4.m6" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> is rigid: a deformation <math id="S3.SS11.SSS1.p4.m7" class="ltx_Math" alttext="M^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mo>′</mo></msup><annotation encoding="application/x-tex">M^{\prime}</annotation></semantics></math> would have to intersect the class <math id="S3.SS11.SSS1.p4.m8" class="ltx_Math" alttext="m[{\bf P}^{1}]" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">m[{\bf P}^{1}]</annotation></semantics></math> nontrivially.</span></p>
</div>
<div id="S3.SS11.SSS1.p5" class="ltx_para">
<p id="S3.SS11.SSS1.p5.1" class="ltx_p"><span id="S3.SS11.SSS1.p5.1.1" class="ltx_text">We conclude that the relation <math id="S3.SS11.SSS1.p5.m1" class="ltx_Math" alttext="{\mathsf{M}}=\sum a_{i}E_{i}" display="inline" intent=":literal"><semantics><mrow><mi>𝖬</mi><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{M}}=\sum a_{i}E_{i}</annotation></semantics></math> then gives a linear dependence among the boundary divisors of <math id="S3.SS11.SSS1.p5.m2" class="ltx_Math" alttext="\overline{{\mathcal{H}}}^{(2)}_{4,g}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}^{(2)}_{4,g}</annotation></semantics></math> and <math id="S3.SS11.SSS1.p5.m3" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math>. This is impossible by <a href="#S3.Thmthm6" title="Corollary 3.6. ‣ 3.4 The divisor classes of 
          
            M
          
         and 
          
            CE
          
        . ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.6</span></a>.</span></p>
</div>
<div id="S3.SS11.SSS1.p6" class="ltx_para">
<p id="S3.SS11.SSS1.p6.1" class="ltx_p"><span id="S3.SS11.SSS1.p6.1.1" class="ltx_text">We now address the exception. The central observation is that the Casnati-Ekedahl divisor <math id="S3.SS11.SSS1.p6.m1" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> is <span id="S3.SS11.SSS1.p6.1.1.1" class="ltx_text ltx_font_slanted">reducible</span>precisely when <math id="S3.SS11.SSS1.p6.m2" class="ltx_Math" alttext="g=3" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">g=3</annotation></semantics></math>. In fact, when <math id="S3.SS11.SSS1.p6.m3" class="ltx_Math" alttext="g=3" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">g=3</annotation></semantics></math>, the Casnati-Ekedahl divisor <math id="S3.SS11.SSS1.p6.m4" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> contains <math id="S3.SS11.SSS1.p6.m5" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> as an irreducible component, and has one residual component.</span></p>
</div>
<div id="S3.SS11.SSS1.p7" class="ltx_para">
<p id="S3.SS11.SSS1.p7.1" class="ltx_p"><span id="S3.SS11.SSS1.p7.1.1" class="ltx_text">The irreducibility of the Casnati-Ekedahl divisor <math id="S3.SS11.SSS1.p7.m1" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> in all other cases is proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">DP15</a>]</cite>[Proposition 4.7] and the reducible example is discussed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">DP15</a>]</cite>[Example 4.8].</span></p>
</div>
<div id="S3.SS11.SSS1.p8" class="ltx_para">
<p id="S3.SS11.SSS1.p8.1" class="ltx_p"><span id="S3.SS11.SSS1.p8.1.1" class="ltx_text">With this caution, the rest of the argument for <math id="S3.SS11.SSS1.p8.m1" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> goes through as in the above argument for <math id="S3.SS11.SSS1.p8.m2" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS11.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">3.11.2 Constructing families of tetragonal curves II.</h4>

<div id="S3.SS11.SSS2.p1" class="ltx_para">
<p id="S3.SS11.SSS2.p1.1" class="ltx_p">The Casnati-Ekedahl resolution <a href="#S3.E16" title="In 3.11 Constructing families of tetragonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.16</span></a> reflects a classical fact about tetragonal curves: A genus <math id="S3.SS11.SSS2.p1.m1" class="ltx_Math" alttext="g_{R}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>R</mi></msub><annotation encoding="application/x-tex">g_{R}</annotation></semantics></math> cover <math id="S3.SS11.SSS2.p1.m2" class="ltx_math_unparsed" alttext="[\alpha\colon C\longrightarrow{\bf P}^{1}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>C</mi><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\alpha\colon C\longrightarrow{\bf P}^{1}]</annotation></semantics></math> rests in its relative canonical embedding <math id="S3.SS11.SSS2.p1.m3" class="ltx_Math" alttext="\pi\colon{\bf P}\mathcal{{\mathcal{E}}}\longrightarrow{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi\colon{\bf P}\mathcal{{\mathcal{E}}}\longrightarrow{\bf P}^{1}</annotation></semantics></math> as a complete intersection of two relative conic divisors <math id="S3.SS11.SSS2.p1.m4" class="ltx_Math" alttext="Q_{u}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>u</mi></msub><annotation encoding="application/x-tex">Q_{u}</annotation></semantics></math> and <math id="S3.SS11.SSS2.p1.m5" class="ltx_Math" alttext="Q_{v}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>v</mi></msub><annotation encoding="application/x-tex">Q_{v}</annotation></semantics></math> in the linear systems <math id="S3.SS11.SSS2.p1.m6" class="ltx_Math" alttext="|2\zeta-uf|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|2\zeta-uf|</annotation></semantics></math> and <math id="S3.SS11.SSS2.p1.m7" class="ltx_Math" alttext="|2\zeta-vf|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|2\zeta-vf|</annotation></semantics></math>, respectively. Here <math id="S3.SS11.SSS2.p1.m8" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> and <math id="S3.SS11.SSS2.p1.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> denote the hyperplane and fiber classes of <math id="S3.SS11.SSS2.p1.m10" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS11.SSS2.p2" class="ltx_para">
<p id="S3.SS11.SSS2.p2.1" class="ltx_p">The integers <math id="S3.SS11.SSS2.p2.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="S3.SS11.SSS2.p2.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> are such that <math id="S3.SS11.SSS2.p2.m3" class="ltx_Math" alttext="{\mathcal{F}}_{\alpha}={\mathcal{O}}(u)\oplus{\mathcal{O}}(v)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>α</mi></msub><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\alpha}={\mathcal{O}}(u)\oplus{\mathcal{O}}(v)</annotation></semantics></math>. Moreover by <a href="#S1.Thmthm14" title="Proposition 1.14 (Conjecture 
            
              2.5
            
           in []). ‣ 1.7 Relating 
          
            
              ⁢
              
                
                c
                1
              
              
                
                
                  (
                  E
                  )
                
              
            
          
         and 
          
            
              ⁢
              
                
                c
                1
              
              
                
                
                  (
                  F
                  )
                
              
            
          
        . ‣ 1 Invariants of a branched cover. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">1.14</span></a>, <math id="S3.SS11.SSS2.p2.m4" class="ltx_Math" alttext="u+v=g_{R}+3." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow><mo>=</mo><mrow><msub><mi>g</mi><mi>R</mi></msub><mo>+</mo><mn>3</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u+v=g_{R}+3.</annotation></semantics></math> We assume that <math id="S3.SS11.SSS2.p2.m5" class="ltx_Math" alttext="u\leq v" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>≤</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">u\leq v</annotation></semantics></math>, so that generically in <math id="S3.SS11.SSS2.p2.m6" class="ltx_Math" alttext="{\mathcal{H}}_{4,g_{R}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><msub><mi>g</mi><mi>R</mi></msub></mrow></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{4,g_{R}}</annotation></semantics></math>, <math id="S3.SS11.SSS2.p2.m7" class="ltx_Math" alttext="v=\lceil{\frac{g_{R}+3}{2}\rceil}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mfrac><mrow><msub><mi>g</mi><mi>R</mi></msub><mo>+</mo><mn>3</mn></mrow><mn>2</mn></mfrac><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">v=\lceil{\frac{g_{R}+3}{2}\rceil}</annotation></semantics></math>. For a general cover <math id="S3.SS11.SSS2.p2.m8" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, the line bundle <math id="S3.SS11.SSS2.p2.m9" class="ltx_Math" alttext="{\mathcal{O}}_{{\bf P}{\mathcal{E}}}(2\zeta-vf)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{{\bf P}{\mathcal{E}}}(2\zeta-vf)</annotation></semantics></math> is globally generated on <math id="S3.SS11.SSS2.p2.m10" class="ltx_Math" alttext="\bf{P}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">\bf{P}{\mathcal{E}}</annotation></semantics></math>, and <math id="S3.SS11.SSS2.p2.m11" class="ltx_Math" alttext="{\mathcal{O}}_{{\bf P}{\mathcal{E}}}(2\zeta-uf)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{{\bf P}{\mathcal{E}}}(2\zeta-uf)</annotation></semantics></math> is very ample. We assume from here on that the bundles <math id="S3.SS11.SSS2.p2.m12" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math> and <math id="S3.SS11.SSS2.p2.m13" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> are balanced.</p>
</div>
</section>
<section id="S3.SS11.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">3.11.3 </h4>

<div id="S3.SS11.SSS3.p1" class="ltx_para">
<p id="S3.SS11.SSS3.p1.1" class="ltx_p">Fix a smooth surface <math id="S3.SS11.SSS3.p1.m1" class="ltx_Math" alttext="{\bf F}\in|2\zeta-vf|" display="inline" intent=":literal"><semantics><mrow><mi>𝐅</mi><mo>∈</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf F}\in|2\zeta-vf|</annotation></semantics></math>, and consider a general pencil <math id="S3.SS11.SSS3.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|2\zeta-uf|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|2\zeta-uf|</annotation></semantics></math> on <math id="S3.SS11.SSS3.p1.m3" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math>. Let <math id="S3.SS11.SSS3.p1.m4" class="ltx_Math" alttext="p\colon Y\longrightarrow{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">⟶</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">p\colon Y\longrightarrow{\bf P}^{1}_{t}</annotation></semantics></math> denote the total space of the pencil. So <math id="S3.SS11.SSS3.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is a family of tetragonal curves, and <math id="S3.SS11.SSS3.p1.m6" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is the blow up of <math id="S3.SS11.SSS3.p1.m7" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> at the base locus of the pencil. We compute the invariants <math id="S3.SS11.SSS3.p1.m8" class="ltx_Math" alttext="\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\delta\cdot p</annotation></semantics></math> and <math id="S3.SS11.SSS3.p1.m9" class="ltx_Math" alttext="\lambda\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\lambda\cdot p</annotation></semantics></math> using standard methods.</p>
</div>
<div id="S3.Thmthm18" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm18.2" class="ltx_text ltx_font_bold">Proposition 3.18</span></span><span id="S3.Thmthm18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm18.p1" class="ltx_para">
<p id="S3.Thmthm18.p1.1" class="ltx_p"><span id="S3.Thmthm18.p1.1.1" class="ltx_text ltx_font_italic">For a general pencil <math id="S3.Thmthm18.p1.m1" class="ltx_Math" alttext="p\colon Y\longrightarrow{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">⟶</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">p\colon Y\longrightarrow{\bf P}^{1}_{t}</annotation></semantics></math> of the type described above,</span></p>
<table id="S3.EGx6" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex20.m1" class="ltx_Math" alttext="\displaystyle\lambda\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\lambda\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex20.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex20.m3" class="ltx_Math" alttext="\displaystyle g_{R}," display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>R</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle g_{R},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex21.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex21.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex21.m3" class="ltx_Math" alttext="\displaystyle v+6g_{R}+6." display="inline" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>+</mo><mn>6</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle v+6g_{R}+6.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm18.p1.2" class="ltx_p"><span id="S3.Thmthm18.p1.2.1" class="ltx_text ltx_font_italic">Furthermore, every singular fiber of <math id="S3.Thmthm18.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is simply nodal.</span></p>
</div>
</div>
<div id="S3.SS11.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS11.SSS3.p2" class="ltx_para">
<p id="S3.SS11.SSS3.p2.1" class="ltx_p"><span id="S3.SS11.SSS3.p2.1.1" class="ltx_text">The last statement is a straightforward application of Bertini’s theorem.</span></p>
</div>
<div id="S3.SS11.SSS3.p3" class="ltx_para">
<p id="S3.SS11.SSS3.p3.1" class="ltx_p"><span id="S3.SS11.SSS3.p3.1.1" class="ltx_text">Since <math id="S3.SS11.SSS3.p3.m1" class="ltx_Math" alttext="\chi({\mathcal{O}}_{{\mathsf{Y}}})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝖸</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\chi({\mathcal{O}}_{{\mathsf{Y}}})=1</annotation></semantics></math> (<math id="S3.SS11.SSS3.p3.m2" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is rational), it follows that</span></p>
<table id="S3.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex22.m1" class="ltx_Math" alttext="\lambda\cdot p=\chi({\mathcal{O}}_{{\mathsf{Y}}})-\chi({\mathcal{O}}_{{\bf P}^{1}_{t}})\chi({\mathcal{O}}_{C_{{\rm gen}}})=g_{R}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo>=</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝖸</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>C</mi><mi>gen</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda\cdot p=\chi({\mathcal{O}}_{{\mathsf{Y}}})-\chi({\mathcal{O}}_{{\bf P}^{1}_{t}})\chi({\mathcal{O}}_{C_{{\rm gen}}})=g_{R},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS3.p3.2" class="ltx_p"><span id="S3.SS11.SSS3.p3.2.1" class="ltx_text">where <math id="S3.SS11.SSS3.p3.m3" class="ltx_Math" alttext="C_{{\rm gen}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>gen</mi></msub><annotation encoding="application/x-tex">C_{{\rm gen}}</annotation></semantics></math> denotes the curve in the pencil.</span></p>
</div>
<div id="S3.SS11.SSS3.p4" class="ltx_para">
<p id="S3.SS11.SSS3.p4.1" class="ltx_p"><span id="S3.SS11.SSS3.p4.1.1" class="ltx_text">We now compute <math id="S3.SS11.SSS3.p4.m1" class="ltx_Math" alttext="\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\delta\cdot p</annotation></semantics></math>. We recall the following fact, easily seen using jet bundles: <span id="S3.SS11.SSS3.p4.1.1.1" class="ltx_text ltx_font_slanted">If <math id="S3.SS11.SSS3.p4.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is an ample line bundle on a surface <math id="S3.SS11.SSS3.p4.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, then a general pencil in <math id="S3.SS11.SSS3.p4.m4" class="ltx_Math" alttext="|L|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|L|</annotation></semantics></math> has <math id="S3.SS11.SSS3.p4.m5" class="ltx_Math" alttext="c_{2}(L+L\otimes\Omega_{S})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">Ω</mi><mi>S</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c_{2}(L+L\otimes\Omega_{S})</annotation></semantics></math> singular elements.</span></span></p>
</div>
<div id="S3.SS11.SSS3.p5" class="ltx_para">
<p id="S3.SS11.SSS3.p5.1" class="ltx_p"><span id="S3.SS11.SSS3.p5.1.1" class="ltx_text">Letting <math id="S3.SS11.SSS3.p5.m1" class="ltx_Math" alttext="L:={\mathcal{O}}_{\bf F}(2\zeta-uf)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>:=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L:={\mathcal{O}}_{\bf F}(2\zeta-uf)</annotation></semantics></math>, get:</span></p>
<table id="S3.EGx7" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex23.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex23.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex23.m3" class="ltx_Math" alttext="\displaystyle c_{2}(L+L\otimes\Omega_{\bf F})=c_{1}(L)\cdot c_{1}(L\otimes\Omega_{\bf F})+c_{2}(L\otimes\Omega_{\bf F})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c_{2}(L+L\otimes\Omega_{\bf F})=c_{1}(L)\cdot c_{1}(L\otimes\Omega_{\bf F})+c_{2}(L\otimes\Omega_{\bf F})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex24.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex24.m2" class="ltx_Math" alttext="\displaystyle c_{1}(L)[K_{\bf F}+2c_{1}(L)]+c_{2}(\Omega_{\bf F})+c_{1}(L)K_{\bf F}+c_{1}^{2}(L)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>K</mi><mi>𝐅</mi></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>𝐅</mi></msub></mrow><mo>+</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c_{1}(L)[K_{\bf F}+2c_{1}(L)]+c_{2}(\Omega_{\bf F})+c_{1}(L)K_{\bf F}+c_{1}^{2}(L)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex25.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex25.m2" class="ltx_Math" alttext="\displaystyle 3c_{1}^{2}(L)+2c_{1}(L)\cdot K_{\bf F}+c_{2}(\Omega_{{\bf F}})" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>K</mi><mi>𝐅</mi></msub></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 3c_{1}^{2}(L)+2c_{1}(L)\cdot K_{\bf F}+c_{2}(\Omega_{{\bf F}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex26.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex26.m2" class="ltx_Math" alttext="\displaystyle 2(2g_{R}-2)+c_{1}^{2}(L)+c_{2}(\Omega_{{\bf F}}).\hskip 72.26999pt" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo><mspace style="width:7.397em;" width="7.397em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle 2(2g_{R}-2)+c_{1}^{2}(L)+c_{2}(\Omega_{{\bf F}}).\hskip 72.26999pt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS11.SSS3.p6" class="ltx_para">
<p id="S3.SS11.SSS3.p6.1" class="ltx_p"><span id="S3.SS11.SSS3.p6.1.1" class="ltx_text">We compute <math id="S3.SS11.SSS3.p6.m1" class="ltx_Math" alttext="c_{1}^{2}(L)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c_{1}^{2}(L)</annotation></semantics></math>:</span></p>
<table id="S3.EGx8" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex27.m1" class="ltx_Math" alttext="\displaystyle c_{1}^{2}(L)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c_{1}^{2}(L)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex27.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex27.m3" class="ltx_Math" alttext="\displaystyle(2\zeta-uf)^{2}(2\zeta-vf)=[4\zeta^{2}-4u\zeta f][2\zeta-vf]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ζ</mi><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(2\zeta-uf)^{2}(2\zeta-vf)=[4\zeta^{2}-4u\zeta f][2\zeta-vf]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex28.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex28.m2" class="ltx_Math" alttext="\displaystyle 8\zeta^{3}-8u-4v=8(u+v)-8u-4v=4v," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ζ</mi><mn>3</mn></msup></mrow><mo>−</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo>=</mo><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 8\zeta^{3}-8u-4v=8(u+v)-8u-4v=4v,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS3.p6.2" class="ltx_p"><span id="S3.SS11.SSS3.p6.2.1" class="ltx_text">which means</span></p>
<table id="S3.EGx9" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex29.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex29.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex29.m3" class="ltx_Math" alttext="\displaystyle 2(2g_{R}-2)+4v+c_{2}(\Omega_{{\bf F}})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2(2g_{R}-2)+4v+c_{2}(\Omega_{{\bf F}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS3.p6.3" class="ltx_p"><span id="S3.SS11.SSS3.p6.3.1" class="ltx_text">So it suffices to compute <math id="S3.SS11.SSS3.p6.m2" class="ltx_Math" alttext="c_{2}(\Omega_{{\bf F}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c_{2}(\Omega_{{\bf F}})</annotation></semantics></math>. In order to compute this, we use the exact sequence of sheaves on <math id="S3.SS11.SSS3.p6.m3" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}</annotation></semantics></math>:</span></p>
<table id="S3.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex30.m1" class="ltx_Math" alttext="0\longrightarrow{\mathcal{O}}_{{\bf F}}(-2\zeta+vf)\longrightarrow\Omega_{{\bf P}{\mathcal{E}}}|_{{\bf F}}\longrightarrow\Omega_{{\bf F}}\longrightarrow 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">⟶</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow></mrow><mo>+</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><msub><mrow><msub><mi mathvariant="normal">Ω</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mi>𝐅</mi></msub><mo stretchy="false">⟶</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub><mo stretchy="false">⟶</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\longrightarrow{\mathcal{O}}_{{\bf F}}(-2\zeta+vf)\longrightarrow\Omega_{{\bf P}{\mathcal{E}}}|_{{\bf F}}\longrightarrow\Omega_{{\bf F}}\longrightarrow 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS3.p6.4" class="ltx_p"><span id="S3.SS11.SSS3.p6.4.1" class="ltx_text">Put <math id="S3.SS11.SSS3.p6.m4" class="ltx_Math" alttext="M:={\mathcal{O}}_{{\bf F}}(-2\zeta+vf)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>:=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow></mrow><mo>+</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M:={\mathcal{O}}_{{\bf F}}(-2\zeta+vf)</annotation></semantics></math>. Then the Whitney sum formula says:</span></p>
<table id="S3.EGx10" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex31.m1" class="ltx_Math" alttext="\displaystyle c(\Omega_{{\bf F}})\cdot(1+c_{1}(M)t)=c(\Omega_{{\bf P}{\mathcal{E}}}|_{{\bf F}})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi mathvariant="normal">Ω</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c(\Omega_{{\bf F}})\cdot(1+c_{1}(M)t)=c(\Omega_{{\bf P}{\mathcal{E}}}|_{{\bf F}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS3.p6.5" class="ltx_p"><span id="S3.SS11.SSS3.p6.5.1" class="ltx_text">and so we get:</span></p>
<table id="S3.EGx11" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex32.m1" class="ltx_Math" alttext="\displaystyle c_{2}(\Omega_{{\bf F}})=c_{1}^{2}(M)-K_{{\bf P}{\mathcal{E}}}|_{{\bf F}}\cdot c_{1}(M)+c_{2}(\Omega_{{\bf P}{\mathcal{E}}})|_{{\bf F}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mrow><msub><mi>K</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo rspace="0.055em" stretchy="false">|</mo></mrow><mi>𝐅</mi></msub><mo rspace="0.222em">⋅</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msub><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>𝐅</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle c_{2}(\Omega_{{\bf F}})=c_{1}^{2}(M)-K_{{\bf P}{\mathcal{E}}}|_{{\bf F}}\cdot c_{1}(M)+c_{2}(\Omega_{{\bf P}{\mathcal{E}}})|_{{\bf F}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS11.SSS3.p7" class="ltx_para">
<p id="S3.SS11.SSS3.p7.1" class="ltx_p"><span id="S3.SS11.SSS3.p7.1.1" class="ltx_text">The canonical class of <math id="S3.SS11.SSS3.p7.m1" class="ltx_Math" alttext="{\bf P}{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">{\bf P}{\mathcal{E}}</annotation></semantics></math>, <math id="S3.SS11.SSS3.p7.m2" class="ltx_Math" alttext="K_{{\bf P}{\mathcal{E}}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><annotation encoding="application/x-tex">K_{{\bf P}{\mathcal{E}}}</annotation></semantics></math>, is <math id="S3.SS11.SSS3.p7.m3" class="ltx_Math" alttext="-3\zeta+(u+v-2)f" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">-3\zeta+(u+v-2)f</annotation></semantics></math>, so the first part of the right hand expression becomes</span></p>
<table id="S3.EGx12" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex33.m1" class="ltx_Math" alttext="\displaystyle-4\zeta^{3}+4u+4v-8=-8." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ζ</mi><mn>3</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo>−</mo><mn>8</mn></mrow><mo rspace="0em">=</mo><mrow><mo lspace="0em">−</mo><mn>8</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-4\zeta^{3}+4u+4v-8=-8.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS3.p7.2" class="ltx_p"><span id="S3.SS11.SSS3.p7.2.1" class="ltx_text">In order to compute <math id="S3.SS11.SSS3.p7.m4" class="ltx_Math" alttext="c_{2}(\Omega_{{\bf P}{\mathcal{E}}})|_{{\bf F}}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>𝐅</mi></msub><annotation encoding="application/x-tex">c_{2}(\Omega_{{\bf P}{\mathcal{E}}})|_{{\bf F}}</annotation></semantics></math> , we consider the Euler sequence</span></p>
<table id="S3.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex34.m1" class="ltx_Math" alttext="0\longrightarrow\Omega_{\pi}\longrightarrow\pi^{*}{\mathcal{E}}(-1)\longrightarrow{\mathcal{O}}\longrightarrow 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">⟶</mo><msub><mi mathvariant="normal">Ω</mi><mi>π</mi></msub><mo stretchy="false">⟶</mo><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="false">⟶</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\longrightarrow\Omega_{\pi}\longrightarrow\pi^{*}{\mathcal{E}}(-1)\longrightarrow{\mathcal{O}}\longrightarrow 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS3.p7.3" class="ltx_p"><span id="S3.SS11.SSS3.p7.3.1" class="ltx_text">and the relative cotangent sequence</span></p>
<table id="S3.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex35.m1" class="ltx_Math" alttext="0\longrightarrow{\mathcal{O}}(-2f)\longrightarrow\Omega_{{\bf P}{\mathcal{E}}}\longrightarrow\Omega_{\pi}\longrightarrow 0." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo stretchy="false">⟶</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><msub><mi mathvariant="normal">Ω</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo stretchy="false">⟶</mo><msub><mi mathvariant="normal">Ω</mi><mi>π</mi></msub><mo stretchy="false">⟶</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\longrightarrow{\mathcal{O}}(-2f)\longrightarrow\Omega_{{\bf P}{\mathcal{E}}}\longrightarrow\Omega_{\pi}\longrightarrow 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS3.p7.4" class="ltx_p"><span id="S3.SS11.SSS3.p7.4.1" class="ltx_text">We find that:</span></p>
<table id="S3.EGx13" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex36.m1" class="ltx_Math" alttext="\displaystyle c_{2}(\Omega_{{\bf P}{\mathcal{E}}})|_{{\bf F}}=3v+6u-4g_{R}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>𝐅</mi></msub><mo>=</mo><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle c_{2}(\Omega_{{\bf P}{\mathcal{E}}})|_{{\bf F}}=3v+6u-4g_{R}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS11.SSS3.p7.5" class="ltx_p"><span id="S3.SS11.SSS3.p7.5.1" class="ltx_text">and</span></p>
<table id="S3.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex37.m1" class="ltx_Math" alttext="c_{2}(\Omega_{{\bf F}})=3v+6u-4g_{R}-8." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Ω</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>−</mo><mn>8</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c_{2}(\Omega_{{\bf F}})=3v+6u-4g_{R}-8.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS11.SSS3.p8" class="ltx_para">
<p id="S3.SS11.SSS3.p8.1" class="ltx_p"><span id="S3.SS11.SSS3.p8.1.1" class="ltx_text">The proposition now follows by putting these calculations together.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S3.SS12" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">3.12 Constructing families of pentagonal curves.</h3>

<div id="S3.SS12.p1" class="ltx_para">
<p id="S3.SS12.p1.1" class="ltx_p">The middle map</p>
<table id="S3.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E17.m1" class="ltx_Math" alttext="m{\colon}\pi^{*}{\mathcal{N}}_{2}(-3)\longrightarrow\pi^{*}{\mathcal{N}}_{1}(-2)" display="block" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">m{\colon}\pi^{*}{\mathcal{N}}_{2}(-3)\longrightarrow\pi^{*}{\mathcal{N}}_{1}(-2)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.17)</span></td></tr></tbody>
</table>
<p id="S3.SS12.p1.2" class="ltx_p">in the Casnati-Ekedahl resolution of a pentagonal curve <math id="S3.SS12.p1.m1" class="ltx_Math" alttext="C\subset{\bf P}({\mathcal{E}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C\subset{\bf P}({\mathcal{E}})</annotation></semantics></math> is well-known <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx7" title="" class="ltx_ref">Cas96</a>]</cite> to be “skew-symmetric" in the following sense. By duality, <math id="S3.SS12.p1.m2" class="ltx_Math" alttext="{\mathcal{N}}_{2}={\mathcal{N}}_{1}^{\vee}\otimes\det{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mn>2</mn></msub><mo>=</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒩</mi><mn>1</mn><mo>∨</mo></msubsup><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" rspace="0.167em">det</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{N}}_{2}={\mathcal{N}}_{1}^{\vee}\otimes\det{\mathcal{E}}</annotation></semantics></math> where <math id="S3.SS12.p1.m3" class="ltx_Math" alttext="{\mathcal{N}}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathcal{N}}_{1}</annotation></semantics></math> is simply the Casnati-Ekedahl bundle which we have been calling <math id="S3.SS12.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math>. A homomorphism from <math id="S3.SS12.p1.m5" class="ltx_Math" alttext="\pi^{*}{\mathcal{F}}^{\vee}\otimes\det{{\mathcal{E}}}(-3)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" rspace="0.167em">det</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{*}{\mathcal{F}}^{\vee}\otimes\det{{\mathcal{E}}}(-3)</annotation></semantics></math> to <math id="S3.SS12.p1.m6" class="ltx_Math" alttext="\pi^{*}{\mathcal{F}}(-2)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{*}{\mathcal{F}}(-2)</annotation></semantics></math> can be thought of as an element of the vector space</p>
<table id="S3.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex38.m1" class="ltx_Math" alttext="H^{0}({\bf P}^{1},{\mathcal{F}}\otimes{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" movablelimits="false" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">H^{0}({\bf P}^{1},{\mathcal{F}}\otimes{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.p1.3" class="ltx_p">and a skew symmetric element is by definition an element of the subspace</p>
<table id="S3.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex39.m1" class="ltx_Math" alttext="H^{0}({\bf P}^{1},\bigwedge^{2}{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo rspace="0em">,</mo><mrow><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" movablelimits="false" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{0}({\bf P}^{1},\bigwedge^{2}{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS12.p2" class="ltx_para">
<p id="S3.SS12.p2.1" class="ltx_p">The homomorphism <math id="S3.SS12.p2.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> can be regarded as an element (which we continue to call <math id="S3.SS12.p2.m2" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math>) in</p>
<table id="S3.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex40.m1" class="ltx_Math" alttext="H^{0}({\bf P}^{1},Hom(\bigwedge^{2}{\mathcal{F}}^{\vee},{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}))." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover><mo lspace="0em" movablelimits="false">⋀</mo><mn>2</mn></mover><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" movablelimits="false" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{0}({\bf P}^{1},Hom(\bigwedge^{2}{\mathcal{F}}^{\vee},{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.p2.2" class="ltx_p">It is also easy to check (e.g. for all points <math id="S3.SS12.p2.m3" class="ltx_Math" alttext="p\in{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">p\in{\bf P}^{1}</annotation></semantics></math>) that</p>
<table id="S3.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex41.m1" class="ltx_Math" alttext="m{\colon}\bigwedge^{2}{\mathcal{F}}^{\vee}\longrightarrow{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}" display="block" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">⟶</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" movablelimits="false" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">m{\colon}\bigwedge^{2}{\mathcal{F}}^{\vee}\longrightarrow{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.p2.3" class="ltx_p">is surjective. Let</p>
<table id="S3.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E18.m1" class="ltx_Math" alttext="0\longrightarrow{\mathcal{K}}\longrightarrow\bigwedge^{2}{\mathcal{F}}^{\vee}\longrightarrow{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}\longrightarrow 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">⟶</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo rspace="0.111em" stretchy="false">⟶</mo><mrow><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">⟶</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" movablelimits="false" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow><mo stretchy="false">⟶</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\longrightarrow{\mathcal{K}}\longrightarrow\bigwedge^{2}{\mathcal{F}}^{\vee}\longrightarrow{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}\longrightarrow 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.18)</span></td></tr></tbody>
</table>
<p id="S3.SS12.p2.4" class="ltx_p">be the resulting exact sequence of vector bundles. This sequence gives rise to a chain of inclusions <math id="S3.SS12.p2.m4" class="ltx_Math" alttext="C\subset{\bf P}({\mathcal{E}})={\bf P}({\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})\subset{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C\subset{\bf P}({\mathcal{E}})={\bf P}({\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})\subset{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})</annotation></semantics></math>, where the first inclusion is the relative canonical embedding of <math id="S3.SS12.p2.m5" class="ltx_Math" alttext="\alpha{\colon}C\longrightarrow{\bf P}^{1}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha{\colon}C\longrightarrow{\bf P}^{1}.</annotation></semantics></math></p>
</div>
<section id="S3.SS12.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">3.12.1 Constructing families of pentagonal curves I.</h4>

<div id="S3.SS12.SSS1.p1" class="ltx_para">
<p id="S3.SS12.SSS1.p1.1" class="ltx_p">Our first family of pentagonal curves is a generic pencil</p>
<table id="S3.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex42.m1" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset{\bf P}(H^{0}({\bf P}^{1},\bigwedge^{2}{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}))." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo rspace="0em">,</mo><mrow><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" movablelimits="false" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset{\bf P}(H^{0}({\bf P}^{1},\bigwedge^{2}{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS12.SSS1.p2" class="ltx_para">
<p id="S3.SS12.SSS1.p2.1" class="ltx_p">Let <math id="S3.SS12.SSS1.p2.m1" class="ltx_Math" alttext="f{\colon}{\mathcal{C}}\longrightarrow{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">⟶</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">f{\colon}{\mathcal{C}}\longrightarrow{\bf P}^{1}_{t}</annotation></semantics></math> be the resulting family of pentagonal curves. A parameter count shows that the closed locus <math id="S3.SS12.SSS1.p2.m2" class="ltx_Math" alttext="Z\subset{\bf P}(H^{0}({\bf P}^{1},\bigwedge^{2}{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}))" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo rspace="0em">,</mo><mrow><msup><mo>⋀</mo><mn>2</mn></msup><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\subset{\bf P}(H^{0}({\bf P}^{1},\bigwedge^{2}{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}))</annotation></semantics></math> parametrizing subschemes which are worse-than-nodal has codimension two. This leads to the following proposition analogous to <a href="#S3.Thmthm14" title="Proposition 3.14. ‣ 3.10 Rigidity and Extremality of 
          
            M
          
         for trigonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.14</span></a> and <a href="#S3.Thmthm16" title="Proposition 3.16. ‣ 3.11.1 Constructing families of tetragonal curves I. ‣ 3.11 Constructing families of tetragonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.16</span></a>:</p>
</div>
<div id="S3.Thmthm19" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm19.2" class="ltx_text ltx_font_bold">Proposition 3.19</span></span><span id="S3.Thmthm19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm19.p1" class="ltx_para">
<p id="S3.Thmthm19.p1.1" class="ltx_p"><span id="S3.Thmthm19.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm19.p1.m1" class="ltx_Math" alttext="[{\bf P}^{1}_{t}]\in A_{1}(\widetilde{{\mathcal{H}}}_{5,g}\setminus{\mathsf{M}}\cup{\mathsf{CE}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>5</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mi>𝖬</mi></mrow><mo>∪</mo><mi>𝖢𝖤</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[{\bf P}^{1}_{t}]\in A_{1}(\widetilde{{\mathcal{H}}}_{5,g}\setminus{\mathsf{M}}\cup{\mathsf{CE}})</annotation></semantics></math> be the curve class given by a pencil <math id="S3.Thmthm19.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset{\bf P}(H^{0}({\bf P}^{1},\bigwedge^{2}{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}))" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo rspace="0em">,</mo><mrow><msup><mo>⋀</mo><mn>2</mn></msup><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset{\bf P}(H^{0}({\bf P}^{1},\bigwedge^{2}{\mathcal{F}}\otimes{\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee}))</annotation></semantics></math> as above. Then there exists a positive integer <math id="S3.Thmthm19.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> with the following property: There exists an irreducible proper curve of class <math id="S3.Thmthm19.p1.m4" class="ltx_Math" alttext="m[{\bf P}^{1}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">m[{\bf P}^{1}_{t}]</annotation></semantics></math> contained in <math id="S3.Thmthm19.p1.m5" class="ltx_Math" alttext="\widetilde{{\mathcal{H}}}_{4,g}\setminus({\mathsf{M}}\cup{\mathsf{CE}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∪</mo><mi>𝖢𝖤</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\mathcal{H}}}_{4,g}\setminus({\mathsf{M}}\cup{\mathsf{CE}})</annotation></semantics></math> which passes through any two prescribed points <math id="S3.Thmthm19.p1.m6" class="ltx_Math" alttext="\alpha_{1},\alpha_{2}\in\widetilde{{\mathcal{H}}}_{5,g}\setminus({\mathsf{M}}\cup{\mathsf{CE}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo>∈</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>~</mo></mover><mrow><mn>5</mn><mo>,</mo><mi>g</mi></mrow></msub><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∪</mo><mi>𝖢𝖤</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha_{1},\alpha_{2}\in\widetilde{{\mathcal{H}}}_{5,g}\setminus({\mathsf{M}}\cup{\mathsf{CE}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS12.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS12.SSS1.p3" class="ltx_para">
<p id="S3.SS12.SSS1.p3.1" class="ltx_p"><span id="S3.SS12.SSS1.p3.1.1" class="ltx_text">The proof goes exactly like the proof of <a href="#S3.Thmthm16" title="Proposition 3.16. ‣ 3.11.1 Constructing families of tetragonal curves I. ‣ 3.11 Constructing families of tetragonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.16</span></a>.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm20" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm20.2" class="ltx_text ltx_font_bold">Theorem 3.20</span></span><span id="S3.Thmthm20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm20.p1" class="ltx_para">
<p id="S3.Thmthm20.p1.1" class="ltx_p"><span id="S3.Thmthm20.p1.1.1" class="ltx_text ltx_font_italic">The effective divisors <math id="S3.Thmthm20.p1.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.Thmthm20.p1.m2" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> are rigid and span extremal rays in the effective cone of divisors <math id="S3.Thmthm20.p1.m3" class="ltx_Math" alttext="{\rm Eff}\,(\overline{{\mathcal{H}}}^{(2)}_{5,g})." display="inline" intent=":literal"><semantics><mrow><mrow><mi>Eff</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>5</mn><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm Eff}\,(\overline{{\mathcal{H}}}^{(2)}_{5,g}).</annotation></semantics></math></span></p>
</div>
</div>
<div id="S3.SS12.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS12.SSS1.p4" class="ltx_para">
<p id="S3.SS12.SSS1.p4.1" class="ltx_p"><span id="S3.SS12.SSS1.p4.1.1" class="ltx_text">The proof is exactly like the proof of <a href="#S3.Thmthm17" title="Theorem 3.17. ‣ 3.11.1 Constructing families of tetragonal curves I. ‣ 3.11 Constructing families of tetragonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.17</span></a> once we know the irreducibility of <math id="S3.SS12.SSS1.p4.m1" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S3.SS12.SSS1.p4.m2" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math>. The former is found in part <math id="S3.SS12.SSS1.p4.m3" class="ltx_Math" alttext="(4)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(4)</annotation></semantics></math> of <a href="#S1.Thmthm9" title="Theorem 1.9 (Deopurkar, P- []). ‣ 1.5 The Maroni loci 
          
            
              M
              
                
                
                  (
                  E
                  )
                
              
            
          
        . ‣ 1 Invariants of a branched cover. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">1.9</span></a>, while the irreducibility is proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">DP15</a>]</cite>[Proposition 5.2].
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS12.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">3.12.2 Constructing families of pentagonal curves II.</h4>

<div id="S3.SS12.SSS2.p1" class="ltx_para">
<p id="S3.SS12.SSS2.p1.1" class="ltx_p">The geometric description of the embedding <math id="S3.SS12.SSS2.p1.m1" class="ltx_Math" alttext="i{\colon}C\,{\hookrightarrow}\,{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo lspace="0.448em" rspace="0.448em" stretchy="false">↪</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">i{\colon}C\,{\hookrightarrow}\,{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})</annotation></semantics></math> is particularly simple and easy to work with, and allows for a second useful construction of families of pentagonal curves.</p>
</div>
<div id="S3.SS12.SSS2.p2" class="ltx_para">
<p id="S3.SS12.SSS2.p2.1" class="ltx_p">Inside the <math id="S3.SS12.SSS2.p2.m1" class="ltx_Math" alttext="{\bf P}^{9}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>9</mn></msup><annotation encoding="application/x-tex">{\bf P}^{9}</annotation></semantics></math>-bundle <math id="S3.SS12.SSS2.p2.m2" class="ltx_Math" alttext="{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})</annotation></semantics></math> lies is the Grassmannian bundle <math id="S3.SS12.SSS2.p2.m3" class="ltx_Math" alttext="{\bf G}\subset{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>𝐆</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf G}\subset{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})</annotation></semantics></math> which parametrizes the decomposable alternating tensors <math id="S3.SS12.SSS2.p2.m4" class="ltx_Math" alttext="a\wedge b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∧</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a\wedge b</annotation></semantics></math>. <math id="S3.SS12.SSS2.p2.m5" class="ltx_Math" alttext="{\bf G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">{\bf G}</annotation></semantics></math> restricts to the Grassmannian <math id="S3.SS12.SSS2.p2.m6" class="ltx_Math" alttext="{\bf G}(1,4)\subset{\bf P}^{9}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐆</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msup><mi>𝐏</mi><mn>9</mn></msup></mrow><annotation encoding="application/x-tex">{\bf G}(1,4)\subset{\bf P}^{9}</annotation></semantics></math> in every fiber of the projective bundle <math id="S3.SS12.SSS2.p2.m7" class="ltx_Math" alttext="{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})</annotation></semantics></math>. The curve <math id="S3.SS12.SSS2.p2.m8" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is simply the intersection of the sub scroll <math id="S3.SS12.SSS2.p2.m9" class="ltx_Math" alttext="{\bf P}({\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}({\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})</annotation></semantics></math> with <math id="S3.SS12.SSS2.p2.m10" class="ltx_Math" alttext="{\bf G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">{\bf G}</annotation></semantics></math> in <math id="S3.SS12.SSS2.p2.m11" class="ltx_Math" alttext="{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS12.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">3.12.3 </h4>

<div id="S3.SS12.SSS3.p1" class="ltx_para">
<p id="S3.SS12.SSS3.p1.1" class="ltx_p">We rephrase this more conveniently for our purposes. Let <math id="S3.SS12.SSS3.p1.m1" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> denote the divisor class on <math id="S3.SS12.SSS3.p1.m2" class="ltx_Math" alttext="{\bf G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">{\bf G}</annotation></semantics></math> associated to the restriction of the natural <math id="S3.SS12.SSS3.p1.m3" class="ltx_Math" alttext="{\mathcal{O}}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(1)</annotation></semantics></math> on <math id="S3.SS12.SSS3.p1.m4" class="ltx_Math" alttext="{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})</annotation></semantics></math>, and let <math id="S3.SS12.SSS3.p1.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> denote the fiber of the natural projection <math id="S3.SS12.SSS3.p1.m6" class="ltx_Math" alttext="\varphi{\colon}{\bf G}\longrightarrow{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝐆</mi><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\varphi{\colon}{\bf G}\longrightarrow{\bf P}^{1}</annotation></semantics></math>. Since the kernel <math id="S3.SS12.SSS3.p1.m7" class="ltx_Math" alttext="{\mathcal{K}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">{\mathcal{K}}</annotation></semantics></math> in (<a href="#S3.E18" title="In 3.12 Constructing families of pentagonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.18</span></a>) is a rank <math id="S3.SS12.SSS3.p1.m8" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math> vector bundle on <math id="S3.SS12.SSS3.p1.m9" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>, it splits as</p>
<table id="S3.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E19.m1" class="ltx_Math" alttext="{\mathcal{K}}={\mathcal{O}}_{{\bf P}^{1}}(-k_{1})\oplus...\oplus{\mathcal{O}}_{{\bf P}^{1}}(-k_{6})." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>=</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mi mathvariant="normal">…</mi><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>k</mi><mn>6</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{K}}={\mathcal{O}}_{{\bf P}^{1}}(-k_{1})\oplus...\oplus{\mathcal{O}}_{{\bf P}^{1}}(-k_{6}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.19)</span></td></tr></tbody>
</table>
<p id="S3.SS12.SSS3.p1.2" class="ltx_p">What this means is that the curve <math id="S3.SS12.SSS3.p1.m10" class="ltx_Math" alttext="C\subset{\bf G}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mi>𝐆</mi></mrow><annotation encoding="application/x-tex">C\subset{\bf G}</annotation></semantics></math>, being the intersection of <math id="S3.SS12.SSS3.p1.m11" class="ltx_Math" alttext="{\bf P}({\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0.222em">⊗</mo><mrow><mo lspace="0.055em" rspace="0.167em">det</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∨</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}({\mathcal{E}}\otimes\det{\mathcal{E}}^{\vee})</annotation></semantics></math> with <math id="S3.SS12.SSS3.p1.m12" class="ltx_Math" alttext="{\bf G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">{\bf G}</annotation></semantics></math>, is a complete intersection of six divisors <math id="S3.SS12.SSS3.p1.m13" class="ltx_Math" alttext="H_{i}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>i</mi></msub><annotation encoding="application/x-tex">H_{i}</annotation></semantics></math> <math id="S3.SS12.SSS3.p1.m14" class="ltx_Math" alttext="(i=1,...,6)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>6</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i=1,...,6)</annotation></semantics></math> on <math id="S3.SS12.SSS3.p1.m15" class="ltx_Math" alttext="{\bf G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">{\bf G}</annotation></semantics></math> with divisor classes <math id="S3.SS12.SSS3.p1.m16" class="ltx_Math" alttext="[H_{i}]=\zeta+k_{i}f" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msub><mi>H</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">[H_{i}]=\zeta+k_{i}f</annotation></semantics></math>.</p>
</div>
<div id="S3.SS12.SSS3.p2" class="ltx_para">
<p id="S3.SS12.SSS3.p2.1" class="ltx_p">From sequence (<a href="#S3.E18" title="In 3.12 Constructing families of pentagonal curves. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.18</span></a>) (and by recalling from <a href="#S1.Thmthm14" title="Proposition 1.14 (Conjecture 
            
              2.5
            
           in []). ‣ 1.7 Relating 
          
            
              ⁢
              
                
                c
                1
              
              
                
                
                  (
                  E
                  )
                
              
            
          
         and 
          
            
              ⁢
              
                
                c
                1
              
              
                
                
                  (
                  F
                  )
                
              
            
          
        . ‣ 1 Invariants of a branched cover. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">1.14</span></a> that <math id="S3.SS12.SSS3.p2.m1" class="ltx_Math" alttext="\deg{\mathcal{F}}=2\deg{\mathcal{E}}=2(g+4)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\deg{\mathcal{F}}=2\deg{\mathcal{E}}=2(g+4)</annotation></semantics></math>), we conclude</p>
<table id="S3.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex43.m1" class="ltx_math_unparsed" alttext="\deg{\mathcal{K}}=-\sum k_{i}=-5(g+4)." display="block" intent=":literal"><semantics><mrow><mi>deg</mi><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.055em">−</mo><mo movablelimits="false">∑</mo><msub><mi>k</mi><mi>i</mi></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mn>5</mn><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>+</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\deg{\mathcal{K}}=-\sum k_{i}=-5(g+4).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS3.p2.2" class="ltx_p">Let us order the <math id="S3.SS12.SSS3.p2.m2" class="ltx_Math" alttext="k_{i}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>i</mi></msub><annotation encoding="application/x-tex">k_{i}</annotation></semantics></math> so <math id="S3.SS12.SSS3.p2.m3" class="ltx_Math" alttext="k_{1}\geq...\geq k_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>≥</mo><mi mathvariant="normal">…</mi><mo>≥</mo><msub><mi>k</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">k_{1}\geq...\geq k_{6}</annotation></semantics></math>. Then <math id="S3.SS12.SSS3.p2.m4" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> is the largest effective divisor among the hyperplane sections <math id="S3.SS12.SSS3.p2.m5" class="ltx_Math" alttext="H_{i}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>i</mi></msub><annotation encoding="application/x-tex">H_{i}</annotation></semantics></math>, meaning <math id="S3.SS12.SSS3.p2.m6" class="ltx_Math" alttext="H_{1}-H_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>−</mo><msub><mi>H</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">H_{1}-H_{j}</annotation></semantics></math> is effective for all <math id="S3.SS12.SSS3.p2.m7" class="ltx_Math" alttext="j\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j\geq 2</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS12.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">3.12.4 </h4>

<div id="S3.SS12.SSS4.p1" class="ltx_para">
<p id="S3.SS12.SSS4.p1.1" class="ltx_p">We consider the surface</p>
<table id="S3.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex44.m1" class="ltx_Math" alttext="{\bf F}:=\bigcap_{i=2}^{6}H_{i}." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝐅</mi><mo rspace="0.111em">:=</mo><mrow><munderover><mo movablelimits="false">⋂</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mn>6</mn></munderover><msub><mi>H</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bf F}:=\bigcap_{i=2}^{6}H_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p1.2" class="ltx_p"><math id="S3.SS12.SSS4.p1.m1" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> will be the surface on which we construct families as in section <a href="#S2.SS12" title="2.12 Constructions of partial pencils. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.12</span></a>. <math id="S3.SS12.SSS4.p1.m2" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> is easily seen to be a genus <math id="S3.SS12.SSS4.p1.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> fibration over <math id="S3.SS12.SSS4.p1.m4" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math> – we let <math id="S3.SS12.SSS4.p1.m5" class="ltx_Math" alttext="\varphi{\colon}{\bf F}\longrightarrow{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝐅</mi><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\varphi{\colon}{\bf F}\longrightarrow{\bf P}^{1}</annotation></semantics></math> denote the natural projection. Our pencils will lie in the linear system <math id="S3.SS12.SSS4.p1.m6" class="ltx_Math" alttext="|H_{1}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|H_{1}|</annotation></semantics></math>, considered as a system of divisors on <math id="S3.SS12.SSS4.p1.m7" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math>. We also assume that <math id="S3.SS12.SSS4.p1.m8" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> is a smooth surface - this can be verified by Bertini’s theorem in all cases we consider.</p>
</div>
<div id="S3.Thmthm21" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm21.2" class="ltx_text ltx_font_bold">Proposition 3.21</span></span><span id="S3.Thmthm21.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm21.p1" class="ltx_para">
<p id="S3.Thmthm21.p1.1" class="ltx_p"><span id="S3.Thmthm21.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm21.p1.m1" class="ltx_Math" alttext="{\bf P}^{1}_{t}\subset|H_{1}|" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><mo>⊂</mo><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}^{1}_{t}\subset|H_{1}|</annotation></semantics></math> be a general pencil of curves on <math id="S3.Thmthm21.p1.m2" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math>. Assume the base locus of <math id="S3.Thmthm21.p1.m3" class="ltx_Math" alttext="{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">{\bf P}^{1}_{t}</annotation></semantics></math> is simple, and that all curves parametrized are at-worst-nodal. Let <math id="S3.Thmthm21.p1.m4" class="ltx_Math" alttext="p{\colon}X\longrightarrow{\bf P}^{1}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">⟶</mo><msubsup><mi>𝐏</mi><mi>t</mi><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">p{\colon}X\longrightarrow{\bf P}^{1}_{t}</annotation></semantics></math> denote the total space of the pencil.
Then</span></p>
<table id="S3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex45.m1" class="ltx_Math" alttext="\displaystyle\lambda\cdot{p}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\lambda\cdot{p}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex45.m2" class="ltx_Math" alttext="\displaystyle=2g+3-k_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>3</mn></mrow><mo>−</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2g+3-k_{1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex46.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex46.m2" class="ltx_Math" alttext="\displaystyle=13g+32-7k_{1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mn>13</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>32</mn></mrow><mo>−</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=13g+32-7k_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS12.SSS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS12.SSS4.p2" class="ltx_para">
<p id="S3.SS12.SSS4.p2.1" class="ltx_p"><span id="S3.SS12.SSS4.p2.1.1" class="ltx_text">We first compute the relevant numerical invariants of the surface <math id="S3.SS12.SSS4.p2.m1" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math>. Adjunction on the relative Grassmannian <math id="S3.SS12.SSS4.p2.m2" class="ltx_Math" alttext="{\bf G}\subset{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mi>𝐆</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf G}\subset{\bf P}(\bigwedge^{2}{\mathcal{F}}^{\vee})</annotation></semantics></math> gives the equality</span></p>
<table id="S3.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex47.m1" class="ltx_Math" alttext="\deg K_{{\bf F}}=(\sum_{i=2}^{6}(\zeta+k_{i}f)+K_{{\bf G}})|_{{\bf F}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msub><mi>K</mi><mi>𝐅</mi></msub></mrow><mo>=</mo><msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mn>6</mn></munderover><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>K</mi><mi>𝐆</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mi>𝐅</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\deg K_{{\bf F}}=(\sum_{i=2}^{6}(\zeta+k_{i}f)+K_{{\bf G}})|_{{\bf F}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p2.2" class="ltx_p"><span id="S3.SS12.SSS4.p2.2.1" class="ltx_text">so we must compute the canonical class <math id="S3.SS12.SSS4.p2.m3" class="ltx_Math" alttext="K_{{\bf G}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>𝐆</mi></msub><annotation encoding="application/x-tex">K_{{\bf G}}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS12.SSS4.p3" class="ltx_para">
<p id="S3.SS12.SSS4.p3.1" class="ltx_p"><span id="S3.SS12.SSS4.p3.1.1" class="ltx_text">The relative tangent bundle for <math id="S3.SS12.SSS4.p3.m1" class="ltx_Math" alttext="g\colon{\bf G}\longrightarrow{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝐆</mi><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">g\colon{\bf G}\longrightarrow{\bf P}^{1}</annotation></semantics></math> is</span></p>
<table id="S3.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex48.m1" class="ltx_Math" alttext="T_{g}=Hom(S^{3},Q^{2})=(S^{3})^{\vee}\otimes Q^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>g</mi></msub><mo>=</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mn>3</mn></msup><mo>,</mo><msup><mi>Q</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mn>3</mn></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>∨</mo></msup><mo rspace="0.222em">⊗</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{g}=Hom(S^{3},Q^{2})=(S^{3})^{\vee}\otimes Q^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p3.2" class="ltx_p"><span id="S3.SS12.SSS4.p3.2.1" class="ltx_text">Here <math id="S3.SS12.SSS4.p3.m2" class="ltx_Math" alttext="S^{3}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>3</mn></msup><annotation encoding="application/x-tex">S^{3}</annotation></semantics></math> and <math id="S3.SS12.SSS4.p3.m3" class="ltx_Math" alttext="Q^{2}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mn>2</mn></msup><annotation encoding="application/x-tex">Q^{2}</annotation></semantics></math> are the universal sub and quotient bundles parametrized by the relative Grassmannian <math id="S3.SS12.SSS4.p3.m4" class="ltx_Math" alttext="{\bf G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">{\bf G}</annotation></semantics></math>. In other words, <math id="S3.SS12.SSS4.p3.m5" class="ltx_Math" alttext="c_{1}(Q^{2})=\zeta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>Q</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>ζ</mi></mrow><annotation encoding="application/x-tex">c_{1}(Q^{2})=\zeta</annotation></semantics></math>, while <math id="S3.SS12.SSS4.p3.m6" class="ltx_Math" alttext="c_{1}(S^{3})=-\zeta+g^{*}c_{1}({\mathcal{F}}^{\vee})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0em">=</mo><mrow><mrow><mo lspace="0em">−</mo><mi>ζ</mi></mrow><mo>+</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{1}(S^{3})=-\zeta+g^{*}c_{1}({\mathcal{F}}^{\vee})</annotation></semantics></math>. Therefore,</span></p>
<table id="S3.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex49.m1" class="ltx_Math" alttext="\displaystyle K_{{\bf G}}+2f" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>𝐆</mi></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle K_{{\bf G}}+2f</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex49.m2" class="ltx_Math" alttext="\displaystyle=-c_{1}((S^{3})^{\vee}\otimes Q^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0em">=</mo><mrow><mo lspace="0em">−</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mn>3</mn></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>∨</mo></msup><mo rspace="0.222em">⊗</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-c_{1}((S^{3})^{\vee}\otimes Q^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex50.m1" class="ltx_Math" alttext="\displaystyle=-[3\zeta+2(\zeta-g^{*}c_{1}{\mathcal{F}}^{\vee})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0em">=</mo><mrow><mo lspace="0em">−</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>−</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-[3\zeta+2(\zeta-g^{*}c_{1}{\mathcal{F}}^{\vee})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex51.m1" class="ltx_Math" alttext="\displaystyle=-5\zeta+2c_{1}{\mathcal{F}}^{\vee}\cdot f" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0em">=</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>f</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-5\zeta+2c_{1}{\mathcal{F}}^{\vee}\cdot f</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS12.SSS4.p4" class="ltx_para">
<p id="S3.SS12.SSS4.p4.1" class="ltx_p"><span id="S3.SS12.SSS4.p4.1.1" class="ltx_text">Altogether, the canonical class of <math id="S3.SS12.SSS4.p4.m1" class="ltx_Math" alttext="{\bf G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">{\bf G}</annotation></semantics></math> is</span></p>
<table id="S3.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E20.m1" class="ltx_Math" alttext="K_{{\bf G}}=-5\zeta+(2c_{1}{\mathcal{F}}^{\vee}-2)\cdot f." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mi>𝐆</mi></msub><mo rspace="0em">=</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo>−</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>f</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{{\bf G}}=-5\zeta+(2c_{1}{\mathcal{F}}^{\vee}-2)\cdot f.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.20)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS12.SSS4.p5" class="ltx_para">
<p id="S3.SS12.SSS4.p5.1" class="ltx_p"><span id="S3.SS12.SSS4.p5.1.1" class="ltx_text">From this, we conclude that the canonical class <math id="S3.SS12.SSS4.p5.m1" class="ltx_Math" alttext="K_{{\bf F}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>𝐅</mi></msub><annotation encoding="application/x-tex">K_{{\bf F}}</annotation></semantics></math> is</span></p>
<table id="S3.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex53.m1" class="ltx_Math" alttext="\displaystyle K_{{\bf F}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>𝐅</mi></msub><annotation encoding="application/x-tex">\displaystyle K_{{\bf F}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex53.m2" class="ltx_Math" alttext="\displaystyle=(H_{2}+H_{3}+...+H_{6}+K_{{\bf G}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mn>2</mn></msub><mo>+</mo><msub><mi>H</mi><mn>3</mn></msub><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><msub><mi>H</mi><mn>6</mn></msub><mo>+</mo><msub><mi>K</mi><mi>𝐆</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(H_{2}+H_{3}+...+H_{6}+K_{{\bf G}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex54.m1" class="ltx_Math" alttext="\displaystyle=(\sum_{i=2}^{6}k_{i}+2c_{1}{\mathcal{F}}^{\vee}-2)\cdot f" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mn>6</mn></munderover></mstyle><msub><mi>k</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow></mrow><mo>−</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(\sum_{i=2}^{6}k_{i}+2c_{1}{\mathcal{F}}^{\vee}-2)\cdot f</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex55.m1" class="ltx_Math" alttext="\displaystyle=(g+2-k_{1})\cdot f" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>g</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(g+2-k_{1})\cdot f</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p5.2" class="ltx_p"><span id="S3.SS12.SSS4.p5.2.1" class="ltx_text">where we have suppressed the “restriction" symbols.</span></p>
</div>
<div id="S3.SS12.SSS4.p6" class="ltx_para">
<p id="S3.SS12.SSS4.p6.1" class="ltx_p"><span id="S3.SS12.SSS4.p6.1.1" class="ltx_text">We must also compute relevant intersection products on <math id="S3.SS12.SSS4.p6.m1" class="ltx_Math" alttext="{\bf G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">{\bf G}</annotation></semantics></math>. We first notice that on <math id="S3.SS12.SSS4.p6.m2" class="ltx_Math" alttext="{\bf G}" display="inline" intent=":literal"><semantics><mi>𝐆</mi><annotation encoding="application/x-tex">{\bf G}</annotation></semantics></math>,</span></p>
<table id="S3.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex56.m1" class="ltx_Math" alttext="\zeta^{6}\cdot f=5." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>ζ</mi><mn>6</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>f</mi></mrow><mo>=</mo><mn>5</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta^{6}\cdot f=5.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p6.2" class="ltx_p"><span id="S3.SS12.SSS4.p6.2.1" class="ltx_text">Indeed, the Grassmannian <math id="S3.SS12.SSS4.p6.m3" class="ltx_Math" alttext="{\bf G}(1,4)\subset{\bf P}^{9}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐆</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msup><mi>𝐏</mi><mn>9</mn></msup></mrow><annotation encoding="application/x-tex">{\bf G}(1,4)\subset{\bf P}^{9}</annotation></semantics></math> has degree <math id="S3.SS12.SSS4.p6.m4" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>. Secondly we note that</span></p>
<table id="S3.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex57.m1" class="ltx_Math" alttext="\zeta^{7}=a\cdot c_{1}{\mathcal{F}}^{\vee}+b" display="block" intent=":literal"><semantics><mrow><msup><mi>ζ</mi><mn>7</mn></msup><mo>=</mo><mrow><mrow><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo>+</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">\zeta^{7}=a\cdot c_{1}{\mathcal{F}}^{\vee}+b</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p6.3" class="ltx_p"><span id="S3.SS12.SSS4.p6.3.1" class="ltx_text">for some fixed constants <math id="S3.SS12.SSS4.p6.m5" class="ltx_Math" alttext="a,b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a,b</annotation></semantics></math> which do not depend on <math id="S3.SS12.SSS4.p6.m6" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>. This follows from the fact that <math id="S3.SS12.SSS4.p6.m7" class="ltx_Math" alttext="\zeta^{7}-(\zeta+l\cdot f)^{7}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ζ</mi><mn>7</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><mi>l</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>7</mn></msup></mrow><annotation encoding="application/x-tex">\zeta^{7}-(\zeta+l\cdot f)^{7}</annotation></semantics></math> is a linear function in <math id="S3.SS12.SSS4.p6.m8" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. It easily follows that <math id="S3.SS12.SSS4.p6.m9" class="ltx_Math" alttext="b=0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b=0</annotation></semantics></math> and <math id="S3.SS12.SSS4.p6.m10" class="ltx_Math" alttext="a=14" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mn>14</mn></mrow><annotation encoding="application/x-tex">a=14</annotation></semantics></math>, so that:</span></p>
<table id="S3.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex58.m1" class="ltx_Math" alttext="\zeta^{7}=14c_{1}{\mathcal{F}}^{\vee}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>ζ</mi><mn>7</mn></msup><mo>=</mo><mrow><mn>14</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta^{7}=14c_{1}{\mathcal{F}}^{\vee}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS12.SSS4.p7" class="ltx_para">
<p id="S3.SS12.SSS4.p7.1" class="ltx_p"><span id="S3.SS12.SSS4.p7.1.1" class="ltx_text">On <math id="S3.SS12.SSS4.p7.m1" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math>, we consider the linear series <math id="S3.SS12.SSS4.p7.m2" class="ltx_Math" alttext="|\zeta+k_{1}f|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\zeta+k_{1}f|</annotation></semantics></math> and a general pencil <math id="S3.SS12.SSS4.p7.m3" class="ltx_Math" alttext="p\subset|\zeta+k_{1}f|" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⊂</mo><mrow><mo stretchy="false">|</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">p\subset|\zeta+k_{1}f|</annotation></semantics></math>. The pencil <math id="S3.SS12.SSS4.p7.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> has <math id="S3.SS12.SSS4.p7.m5" class="ltx_Math" alttext="B=(\zeta+k_{1}f)^{2}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">B=(\zeta+k_{1}f)^{2}</annotation></semantics></math> basepoints. This number can now be calculated:</span></p>
</div>
<div id="S3.SS12.SSS4.p8" class="ltx_para">
<table id="S3.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex59.m1" class="ltx_Math" alttext="\displaystyle B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\displaystyle B</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex59.m2" class="ltx_Math" alttext="\displaystyle=(\zeta+k_{1}f)^{2}\cdot[{\bf F}]=(\zeta+k_{1}f)\cdot\prod_{i=1}^{6}(\zeta+k_{i}f)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">[</mo><mi>𝐅</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>6</mn></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>+</mo><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(\zeta+k_{1}f)^{2}\cdot[{\bf F}]=(\zeta+k_{1}f)\cdot\prod_{i=1}^{6}(\zeta+k_{i}f)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex60.m1" class="ltx_Math" alttext="\displaystyle=\zeta^{7}+(2k_{1}+k_{2}+...+k_{6})\zeta^{6}\cdot f" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>ζ</mi><mn>7</mn></msup><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>k</mi><mn>2</mn></msub><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><msub><mi>k</mi><mn>6</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ζ</mi><mn>6</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>f</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\zeta^{7}+(2k_{1}+k_{2}+...+k_{6})\zeta^{6}\cdot f</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex61.m1" class="ltx_Math" alttext="\displaystyle=\zeta^{7}+5(5(g+4)+k_{1})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>ζ</mi><mn>7</mn></msup><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\zeta^{7}+5(5(g+4)+k_{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex62.m1" class="ltx_Math" alttext="\displaystyle=14c_{1}{\mathcal{F}}^{\vee}+25(g+4)+5k_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>14</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∨</mo></msup></mrow><mo>+</mo><mrow><mn>25</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=14c_{1}{\mathcal{F}}^{\vee}+25(g+4)+5k_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex63.m1" class="ltx_Math" alttext="\displaystyle=5k_{1}-3(g+4)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=5k_{1}-3(g+4).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p8.1" class="ltx_p"><span id="S3.SS12.SSS4.p8.1.1" class="ltx_text">Here we have used <math id="S3.SS12.SSS4.p8.m1" class="ltx_Math" alttext="c_{1}({\mathcal{F}})=2c_{1}({\mathcal{E}})=2(g+4)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{1}({\mathcal{F}})=2c_{1}({\mathcal{E}})=2(g+4)</annotation></semantics></math> and <math id="S3.SS12.SSS4.p8.m2" class="ltx_Math" alttext="\sum_{i}k_{i}=5(g+4)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><msub><mi>k</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i}k_{i}=5(g+4)</annotation></semantics></math>.
Since <math id="S3.SS12.SSS4.p8.m3" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> is assumed to be smooth, we can determine the topological Euler characteristic <math id="S3.SS12.SSS4.p8.m4" class="ltx_Math" alttext="\chi_{{\rm top}}({\bf F})" display="inline" intent=":literal"><semantics><mrow><msub><mi>χ</mi><mi>top</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐅</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi_{{\rm top}}({\bf F})</annotation></semantics></math> by the Noether formula:</span></p>
<table id="S3.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E21.m1" class="ltx_Math" alttext="\chi(\mathcal{O}_{\bf F})=\frac{K_{{\bf F}}^{2}+\chi_{{\rm top}}({\bf F})}{12}=\frac{\chi_{{\rm top}}({\bf F})}{12}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msubsup><mi>K</mi><mi>𝐅</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi>χ</mi><mi>top</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐅</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mn>12</mn></mfrac><mo>=</mo><mfrac><mrow><msub><mi>χ</mi><mi>top</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐅</mi><mo stretchy="false">)</mo></mrow></mrow><mn>12</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\chi(\mathcal{O}_{\bf F})=\frac{K_{{\bf F}}^{2}+\chi_{{\rm top}}({\bf F})}{12}=\frac{\chi_{{\rm top}}({\bf F})}{12}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.21)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS12.SSS4.p9" class="ltx_para">
<p id="S3.SS12.SSS4.p9.1" class="ltx_p"><span id="S3.SS12.SSS4.p9.1.1" class="ltx_text">On the other hand, let <math id="S3.SS12.SSS4.p9.m1" class="ltx_Math" alttext="g{\colon}{\bf F}\longrightarrow{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝐅</mi><mo stretchy="false">⟶</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">g{\colon}{\bf F}\longrightarrow{\bf P}^{1}</annotation></semantics></math> be the projection which realizes <math id="S3.SS12.SSS4.p9.m2" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> as a family of genus <math id="S3.SS12.SSS4.p9.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> curves. (These are degree five elliptic normal curves.) Then Grothendieck-Riemann-Roch applied to the family <math id="S3.SS12.SSS4.p9.m4" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> gives:</span></p>
<table id="S3.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E22.m1" class="ltx_Math" alttext="\lambda_{g}=\chi(\mathcal{O}_{\bf F})-\chi(\mathcal{O}_{{\bf P}^{1}})\chi(\mathcal{O}_{E_{gen}})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mi>g</mi></msub><mo>=</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>E</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lambda_{g}=\chi(\mathcal{O}_{\bf F})-\chi(\mathcal{O}_{{\bf P}^{1}})\chi(\mathcal{O}_{E_{gen}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.22)</span></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p9.2" class="ltx_p"><span id="S3.SS12.SSS4.p9.2.1" class="ltx_text">which implies</span></p>
<table id="S3.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex64.m1" class="ltx_Math" alttext="\chi(\mathcal{O}_{\bf F})=c_{1}\mathcal{E}-k_{1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>−</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\chi(\mathcal{O}_{\bf F})=c_{1}\mathcal{E}-k_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p9.3" class="ltx_p"><span id="S3.SS12.SSS4.p9.3.1" class="ltx_text">and thus</span></p>
<table id="S3.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex65.m1" class="ltx_Math" alttext="\chi_{{\rm top}}({\bf F})=12(c_{1}\mathcal{E}-k_{1})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>χ</mi><mi>top</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐅</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>−</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\chi_{{\rm top}}({\bf F})=12(c_{1}\mathcal{E}-k_{1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS12.SSS4.p10" class="ltx_para">
<p id="S3.SS12.SSS4.p10.1" class="ltx_p"><span id="S3.SS12.SSS4.p10.1.1" class="ltx_text">The total space of the pencil <math id="S3.SS12.SSS4.p10.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is the blow up of <math id="S3.SS12.SSS4.p10.m2" class="ltx_Math" alttext="{\bf F}" display="inline" intent=":literal"><semantics><mi>𝐅</mi><annotation encoding="application/x-tex">{\bf F}</annotation></semantics></math> at the <math id="S3.SS12.SSS4.p10.m3" class="ltx_Math" alttext="B=5m_{6}-3c_{1}\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>6</mn></msub></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">B=5m_{6}-3c_{1}\mathcal{E}</annotation></semantics></math> basepoints, therefore:</span></p>
<table id="S3.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex66.m1" class="ltx_Math" alttext="\chi_{{\rm top}}(X)=12(c_{1}\mathcal{E}-k_{1})+5k_{1}-3c_{1}\mathcal{E}=9c_{1}\mathcal{E}-7k_{1}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mi>top</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>−</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mo>=</mo><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>−</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi_{{\rm top}}(X)=12(c_{1}\mathcal{E}-k_{1})+5k_{1}-3c_{1}\mathcal{E}=9c_{1}\mathcal{E}-7k_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS12.SSS4.p11" class="ltx_para">
<p id="S3.SS12.SSS4.p11.1" class="ltx_p"><span id="S3.SS12.SSS4.p11.1.1" class="ltx_text">This implies</span></p>
<table id="S3.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex67.m1" class="ltx_Math" alttext="\delta\cdot p=9c_{1}\mathcal{E}-7k_{1}-2(2-2g)=13g-7k_{1}+32" display="block" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo>=</mo><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>−</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>13</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></mrow><mo>+</mo><mn>32</mn></mrow></mrow><annotation encoding="application/x-tex">\delta\cdot p=9c_{1}\mathcal{E}-7k_{1}-2(2-2g)=13g-7k_{1}+32</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p11.2" class="ltx_p"><span id="S3.SS12.SSS4.p11.2.1" class="ltx_text">Furthermore, we know</span></p>
<table id="S3.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex68.m1" class="ltx_Math" alttext="\chi(\mathcal{O}_{{\bf F}})=\chi(\mathcal{O}_{X})=c_{1}\mathcal{E}-k_{1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐅</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>−</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\chi(\mathcal{O}_{{\bf F}})=\chi(\mathcal{O}_{X})=c_{1}\mathcal{E}-k_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS12.SSS4.p11.3" class="ltx_p"><span id="S3.SS12.SSS4.p11.3.1" class="ltx_text">which means</span></p>
<table id="S3.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex69.m1" class="ltx_Math" alttext="\lambda\cdot p=2g-k_{1}+3." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo>=</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo>+</mo><mn>3</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lambda\cdot p=2g-k_{1}+3.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS12.SSS4.p12" class="ltx_para">
<p id="S3.SS12.SSS4.p12.1" class="ltx_p"><span id="S3.SS12.SSS4.p12.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>The slope problem.</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">Our objective in this section is to prove <a href="#S3.Thmthm7" title="Theorem 3.7 (Key result for ). ‣ 3.7 The key result. ‣ 3 One parameter families and . ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">3.7</span></a> and hence <a href="#Thmmaintheorem3" title="Theorem C (Slope bounds). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">C</span></a>. The basic strategy is simple enough, although implementing it will involve some care.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">We want to show the divisor class <math id="S4.p2.m1" class="ltx_Math" alttext="{\mathsf{Y}}" display="inline" intent=":literal"><semantics><mi>𝖸</mi><annotation encoding="application/x-tex">{\mathsf{Y}}</annotation></semantics></math>, which is supported on the higher boundary, is an <span id="S4.p2.1.1" class="ltx_text ltx_font_slanted">effective</span> combination of higher boundary divisors of <math id="S4.p2.m2" class="ltx_Math" alttext="\overline{{\mathcal{H}}}_{d,g}^{(2)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\overline{{\mathcal{H}}}_{d,g}^{(2)}</annotation></semantics></math>.</p>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">Given any higher boundary divisor <math id="S4.p3.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>, we will let <math id="S4.p3.m2" class="ltx_Math" alttext="c(\Delta,{\mathsf{Y}})" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c(\Delta,{\mathsf{Y}})</annotation></semantics></math> denote the coefficient of <math id="S4.p3.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> in the expression of <math id="S4.p3.m4" class="ltx_Math" alttext="{\mathsf{Y}}" display="inline" intent=":literal"><semantics><mi>𝖸</mi><annotation encoding="application/x-tex">{\mathsf{Y}}</annotation></semantics></math>. This is well-defined thanks to <a href="#Thmmaintheorem1" title="Theorem A (Independence of the boundary). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div>
<div id="S4.p4" class="ltx_para">
<p id="S4.p4.1" class="ltx_p">Our task is then:</p>
<table id="S4.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span id="S4.Ex1.1" class="ltx_text ltx_markedasmath ltx_font_slanted">To prove the inequality <math id="S4.Ex1.m1.m1" class="ltx_Math" alttext="c(\Delta,{\mathsf{Y}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta,{\mathsf{Y}})\geq 0</annotation></semantics></math> for every higher boundary divisor <math id="S4.Ex1.m1.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>.</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p4.2" class="ltx_p">We will accomplish this by a sort of induction on the complexity of the dual graph <math id="S4.p4.m1" class="ltx_Math" alttext="\Gamma_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">\Gamma_{\Delta}</annotation></semantics></math> , similar to that found in the proof of <a href="#Thmmaintheorem1" title="Theorem A (Independence of the boundary). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">A</span></a>. The induction will be provided to us by carefully selected partial pencils <math id="S4.p4.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> which lie entirely within <math id="S4.p4.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> and intersect (very few) other boundary divisors <math id="S4.p4.m4" class="ltx_Math" alttext="\Delta^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Δ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\Delta^{\prime}</annotation></semantics></math> for which we already know <math id="S4.p4.m5" class="ltx_Math" alttext="c(\Delta^{\prime},{\mathsf{Y}})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Δ</mi><mo>′</mo></msup><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\Delta^{\prime},{\mathsf{Y}})\geq 0</annotation></semantics></math>. From these “prior” inequalities, we are able to deduce the inequality for <math id="S4.p4.m6" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>.</p>
</div>
<div id="S4.p5" class="ltx_para">
<p id="S4.p5.1" class="ltx_p">For notational convenience, the symbol “<math id="S4.p5.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>” will stand for “the higher boundary divisor currently under investigation.” It will change per section. All other boundary divisors arising in the analysis of <math id="S4.p5.m2" class="ltx_Math" alttext="c(\Delta,{\mathsf{Y}})" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>𝖸</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c(\Delta,{\mathsf{Y}})</annotation></semantics></math> will be represented by the symbol <math id="S4.p5.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> with some decorations or subscripts.</p>
</div>
<div id="S4.p6" class="ltx_para">
<p id="S4.p6.1" class="ltx_p">The overall method is somewhat tedious and repetitive. Therefore, we have adopted the following plan: We provide many details in the degree three case, showing the reader exactly how the inductive procedure goes.</p>
</div>
<div id="S4.p7" class="ltx_para">
<p id="S4.p7.1" class="ltx_p">In the degree four and five cases, we skip the demonstration of details which follow from methods found in the degree <math id="S4.p7.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> case, and focus only on the new challenges which arise when implementing the inductive procedure.</p>
</div>
<div id="S4.p8" class="ltx_para">
<p id="S4.p8.1" class="ltx_p">Throughout this entire section, we assume we are in the natural setting of <a href="#Thmmaintheorem3" title="Theorem C (Slope bounds). ‣ 0.2 Outline and main results. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">C</span></a>: <math id="S4.p8.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S4.p8.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> are such that <math id="S4.p8.m3" class="ltx_Math" alttext="{\mathsf{M}}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">{\mathsf{M}}</annotation></semantics></math> and <math id="S4.p8.m4" class="ltx_Math" alttext="{\mathsf{CE}}" display="inline" intent=":literal"><semantics><mi>𝖢𝖤</mi><annotation encoding="application/x-tex">{\mathsf{CE}}</annotation></semantics></math> exist as divisors.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsection">4.1 Degree three analysis.</h3>

<section id="S4.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_runin ltx_font_bold ltx_title_subsubsection">4.1.1 <math id="S4.SS1.SSS1.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-vertex divisors I.</h4>

<div id="S4.SS1.SSS1.p1" class="ltx_para">
<p id="S4.SS1.SSS1.p1.1" class="ltx_p">Impose three distinct points on a ruling line <math id="S4.SS1.SSS1.p1.m1" class="ltx_Math" alttext="F\subset{\bf F}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⊂</mo><mi>𝐅</mi></mrow><annotation encoding="application/x-tex">F\subset{\bf F}</annotation></semantics></math> to be in the base locus of a pencil <math id="S4.SS1.SSS1.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> as in section <a href="#S2.SS12" title="2.12 Constructions of partial pencils. ‣ 2 Compactifications. ‣ Special Codimension One Loci in Hurwitz Spaces" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.12</span></a>.</p>
</div>
<div id="S4.SS1.SSS1.p2" class="ltx_para">
<p id="S4.SS1.SSS1.p2.1" class="ltx_p">We then attach an unchanging cover <math id="S4.SS1.SSS1.p2.m1" class="ltx_Math" alttext="\alpha_{L}{\colon}C_{L}\longrightarrow P_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>L</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>L</mi></msub><mo stretchy="false">⟶</mo><msub><mi>P</mi><mi>L</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha_{L}{\colon}C_{L}\longrightarrow P_{L}</annotation></semantics></math> along the three gluing sections to end up with a partial pencil which we continue to denote by <math id="S4.SS1.SSS1.p2.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.SSS1.p3" class="ltx_para">
<p id="S4.SS1.SSS1.p3.1" class="ltx_p">The partial pencil <math id="S4.SS1.SSS1.p3.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> lives entirely within a boundary divisor <math id="S4.SS1.SSS1.p3.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> having dual graph
<math id="S4.SS1.SSS1.p3.m3" class="ltx_Math" alttext="\Gamma_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">\Gamma_{\Delta}</annotation></semantics></math>:</p>
<table id="S4.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
