<div id="S4.Thmthm25" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm25.2" class="ltx_text ltx_font_bold">Proposition 4.25</span></span><span id="S4.Thmthm25.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm25.p1" class="ltx_para">
<p id="S4.Thmthm25.p1.1" class="ltx_p"><span id="S4.Thmthm25.p1.1.1" class="ltx_text ltx_font_italic">Then the intersection numbers for the resulting family <math id="S4.Thmthm25.p1.m1" class="ltx_Math" alttext="p^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mo>′</mo></msup><annotation encoding="application/x-tex">p^{\prime}</annotation></semantics></math> are:</span></p>
<table id="S4.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex67.m1" class="ltx_Math" alttext="\displaystyle\lambda\cdot p^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\lambda\cdot p^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex67.m2" class="ltx_Math" alttext="\displaystyle=g_{R}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=g_{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex68.m1" class="ltx_Math" alttext="\displaystyle\delta\cdot p^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\delta\cdot p^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex68.m2" class="ltx_Math" alttext="\displaystyle=v+6g_{R}+3" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>v</mi><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>R</mi></msub></mrow><mo>+</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=v+6g_{R}+3</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
