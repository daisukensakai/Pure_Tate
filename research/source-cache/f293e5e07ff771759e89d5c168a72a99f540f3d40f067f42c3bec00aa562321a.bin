.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.155020074460356 -44.02936568840157 L 49.4168562497838 -43.47589412830142" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 49.4168562497838 -44.02936568840157 L 49.4168562497838 -43.47589412830142" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 9.155020074460356 -36.86850275821139 L 9.171129741064325 -36.86850275821139" fill="none" stroke="#000000" stroke-dasharray="5"></path><g transform="translate(47.99,0) translate(0,-7.69)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -7.19 -1.95" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -3.87 -6.37" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.155020074460356 -36.86850275821139 L 47.984531645921976 -7.687203531461879" fill="none" stroke="#000000" stroke-dasharray="5"></path><path style="--ltx-stroke-color:#000000;" d="M 47.96981547603605 -7.687203531461879 L 47.984531645921976 -7.687203531461879" fill="none" stroke="#000000" stroke-dasharray="5"></path><g transform="translate(49.42,0) translate(0,-43.75) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:0.67em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.Ex2.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{S}" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\textstyle{S}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
