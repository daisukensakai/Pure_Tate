<p id="mw5w">and</p>

<p id="mw6A"><span class="mwe-math-element mwe-math-element-block" typeof="mw:Extension/math" about="#mwt58" id="mw6Q" data-mw='{"name":"math","attrs":{"display":"block"},"body":{"extsrc":"0 \\to H_1^{BM}(\\R ^n-\\{0\\}) \\to H_0^{BM}(\\{0\\}) \\to H_0^{BM}(\\R ^n) \\to H_0^{BM}(\\R ^n-\\{0\\}) \\to 0"}}'><span class="mwe-math-mathml-display mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block" alttext="{\displaystyle 0\to H_{1}^{BM}(\mathbb {R} ^{n}-\{0\})\to H_{0}^{BM}(\{0\})\to H_{0}^{BM}(\mathbb {R} ^{n})\to H_{0}^{BM}(\mathbb {R} ^{n}-\{0\})\to 0}">
