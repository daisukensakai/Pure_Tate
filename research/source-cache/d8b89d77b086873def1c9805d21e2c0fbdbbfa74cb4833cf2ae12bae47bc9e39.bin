        <mo stretchy="false">(</mo>
        <mi>F</mi>
        <mo stretchy="false">)</mo>
        <mo stretchy="false">→<!-- → --></mo>
        <msubsup>
          <mi>H</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>i</mi>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>B</mi>
            <mi>M</mi>
          </mrow>
        </msubsup>
        <mo stretchy="false">(</mo>
        <mi>X</mi>
        <mo stretchy="false">)</mo>
        <mo stretchy="false">→<!-- → --></mo>
        <msubsup>
          <mi>H</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>i</mi>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>B</mi>
            <mi>M</mi>
          </mrow>
        </msubsup>
        <mo stretchy="false">(</mo>
        <mi>U</mi>
        <mo stretchy="false">)</mo>
        <mo stretchy="false">→<!-- → --></mo>
