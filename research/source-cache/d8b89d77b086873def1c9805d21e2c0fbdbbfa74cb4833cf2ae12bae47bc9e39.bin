</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/10ed19635af54c07601bdce17b67b756885e2d58" class="mwe-math-fallback-image-display mw-invert skin-invert" aria-hidden="true" style="vertical-align: -1.005ex; width:30.049ex; height:3.176ex;" alt="{\displaystyle H_{1}^{BM}(\mathbb {R} ^{n}-\{0\})\cong H_{0}^{BM}(\{0\})}"/></span>
and</p>

<p id="mw8A"><span class="mwe-math-element mwe-math-element-block" typeof="mw:Extension/math" about="#mwt61" id="mw8Q" data-mw='{"name":"math","attrs":{"display":"block"},"body":{"extsrc":"0 \\cong H_0^{BM}(\\R ^n) \\cong H_0^{BM}(\\R ^n-\\{0\\})"}}'><span class="mwe-math-mathml-display mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block" alttext="{\displaystyle 0\cong H_{0}^{BM}(\mathbb {R} ^{n})\cong H_{0}^{BM}(\mathbb {R} ^{n}-\{0\})}">
  <semantics>
