          </mrow>
        </msubsup>
        <mo stretchy="false">(</mo>
        <mo fence="false" stretchy="false">{</mo>
        <mn>0</mn>
        <mo fence="false" stretchy="false">}</mo>
        <mo stretchy="false">)</mo>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle H_{1}^{BM}(\mathbb {R} ^{n}-\{0\})\cong H_{0}^{BM}(\{0\})}</annotation>
