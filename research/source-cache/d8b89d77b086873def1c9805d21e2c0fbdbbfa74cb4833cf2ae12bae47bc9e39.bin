          <mi>H</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>i</mi>
            <mo>−<!-- − --></mo>
            <mn>1</mn>
          </mrow>
          <mrow class="MJX-TeXAtom-ORD">
