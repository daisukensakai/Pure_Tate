  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/052d64b1b9a1fc6033faf73a5d884e10417795a6" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -1.005ex; width:5.31ex; height:3.176ex;" alt="{\displaystyle H_{1}^{BM}}"/></span> as <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt67" id="mw_A" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\R _{>0}."}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \mathbb {R} _{>0}.}">
  <semantics>
