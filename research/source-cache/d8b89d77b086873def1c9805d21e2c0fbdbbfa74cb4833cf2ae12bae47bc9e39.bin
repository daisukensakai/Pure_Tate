    <annotation encoding="application/x-tex">{\displaystyle S^{1}\times \mathbb {R} }</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/ba0264e060cff9ceca8631a720823501f52a8efe" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:7.094ex; height:2.676ex;" alt="{\displaystyle S^{1}\times \mathbb {R} }"/></span> has homology</p>

<p id="mw4A"><span class="mwe-math-element mwe-math-element-block" typeof="mw:Extension/math" about="#mwt55" id="mw4Q" data-mw='{"name":"math","attrs":{"display":"block"},"body":{"extsrc":" H_k^{BM}(S^1\\times \\R ) = \\begin{cases}\n\\Z &amp; k = 1 \\\\\n\\Z &amp; k = 2 \\\\\n0 &amp; \\text{otherwise}\n\\end{cases}\n"}}'><span class="mwe-math-mathml-display mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block" alttext="{\displaystyle H_{k}^{BM}(S^{1}\times \mathbb {R} )={\begin{cases}\mathbb {Z} &amp;k=1\\\mathbb {Z} &amp;k=2\\0&amp;{\text{otherwise}}\end{cases}}}">
