t-size:10pt;" height="14.25" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="144.31"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E6.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{\pi^{*}{\mathscr{O}}_{\mathbb{P}^{1}}(-5k)\otimes{\mathscr{O}}_{\mathbb{P}{\mathscr{E}}^{\vee}}(-4)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathscript">ℰ</mi><mo>∨</mo></msup></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\pi^{*}{\mathscr{O}}_{\mathbb{P}^{1}}(-5k)\otimes{\mathscr{O}}_{\mathbb{P}{\mathscr{E}}^{\vee}}(-4)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 193.42840798286807 -0.27673578005007266 L 193.42840798286807 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(226.64,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 193.42840798286807 -0.27673578005007266 L 226.63720831495607 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 226.63720831495607 -0.27673578005007266 L 226.63720831495607 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(226.64,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:16.13em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.28em;font-size:10pt;" height="14.25" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="223.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E6.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{\pi^{*}\left({\mathscr{O}}_{\mathbb{P}^{1}}(-2k)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-3k)\right)\otimes{\mathscr{O}}_{\mathbb{P}{\mathscr{E}}^{\vee}}(-2)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathscript">ℰ</mi><mo>∨</mo></msup></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\pi^{*}\left({\mathscr{O}}_{\mathbb{P}^{1}}(-2k)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-3k)\right)\otimes{\mathscr{O}}_{\mathbb{P}{\mathscr{E}}^{\vee}}(-2)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 458.06950217743577 -0.27673578005007266 L 458.06950217743577 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(496.67,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 458.06950217743577 -0.27673578005007266 L 496.65935342698174 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 496.65935342698174 -0.27673578005007266 L 496.65935342698174 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(96.2,0) translate(0,-43.82) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.43em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.24em;font-size:10pt;" height="12.71" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="33.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E6.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{{\mathscr{O}}_{\mathbb{P}{\mathscr{E}}^{\vee}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathscript">ℰ</mi><mo>∨</mo></msup></mrow></msub><annotation encoding="application/x-tex">\textstyle{{\mathscr{O}}_{\mathbb{P}{\mathscr{E}}^{\vee}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 138.05232635916096 -44.093888809163985 L 138.05232635916096 -43.54041724906384" fill="none" stroke="#000000"></path><g transform="translate(328.17,0) translate(0,-43.82)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 138.05232635916096 -44.093888809163985 L 328.16780146283037 -43.54041724906384" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 328.16780146283037 -44.093888809163985 L 328.16780146283037 -43.54041724906384" fill="none" stroke="#000000"></path><g transform="translate(328.17,0) translate(0,-43.82) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.45em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="20.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E6.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{{\mathscr{O}}_{C}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><annotation encoding="application/x-tex">\textstyle{{\mathscr{O}}_{C}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 356.53888791597484 -44.093888809163985 L 356.53888791597484 -43.54041724906384" fill="none" stroke="#000000"></path><g transform="translate(491.28,0) translate(0,-43.82)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 356.53888791597484 -44.093888809163985 L 491.2782813959371 -43.54041724906384" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 491.2782813959371 -44.093888809163985 L 491.2782813959371 -43.54041724906384" fill="none" stroke="#000000"></path><g transform="translate(491.28,0) translate(0,-43.82) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E6.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{0.}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{0.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.2" class="ltx_p">The numerology (which applies similarly to the other vertices) is explained by (<a href="#S3.Ex5" title="In 3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>).</p>
</div>
<div id="S3.p10" class="ltx_para ltx_noindent">
<p id="S3.p10.1" class="ltx_p">3.4.
<span id="S3.p10.1.1" class="ltx_text ltx_font_italic">Proof of Theorem <a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</span></p>
</div>
<div id="S3.p11" class="ltx_para">
<p id="S3.p11.1" class="ltx_p">We begin by reviewing more geometry about tetragonal covers.
(This is classical, so rather than trying to find the first reference, we refer the reader to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">LVaW</a>, §3]</cite>.) Suppose <math id="S3.p11.m1" class="ltx_Math" alttext="\pi:C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi:C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> is such a cover. Then <math id="S3.p11.m2" class="ltx_Math" alttext="C\hookrightarrow\mathbb{P}{\mathscr{E}}_{\pi}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">↪</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathscript">ℰ</mi><mi>π</mi><mo>∨</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">C\hookrightarrow\mathbb{P}{\mathscr{E}}_{\pi}^{\vee}</annotation></semantics></math> is the complete intersection of two divisors <math id="S3.p11.m3" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> and <math id="S3.p11.m4" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> in <math id="S3.p11.m5" class="ltx_Math" alttext="\mathbb{P}{\mathscr{E}}_{\pi}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathscript">ℰ</mi><mi>π</mi><mo>∨</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{P}{\mathscr{E}}_{\pi}^{\vee}</annotation></semantics></math>. The divisors <math id="S3.p11.m6" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> and <math id="S3.p11.m7" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> are of
class <math id="S3.p11.m8" class="ltx_Math" alttext="2H+f_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo>+</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">2H+f_{1}</annotation></semantics></math> and <math id="S3.p11.m9" class="ltx_Math" alttext="2H+f_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo>+</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">2H+f_{2}</annotation></semantics></math>, where <math id="S3.p11.m10" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is the class of <math id="S3.p11.m11" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}E^{\vee}}(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mo>∨</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}E^{\vee}}(1)</annotation></semantics></math>, and</p>
<table id="S3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E7.m1" class="ltx_Math" alttext="f_{1}+f_{2}=d+g-1=e_{1}+e_{2}+e_{3}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>+</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mrow><mi>d</mi><mo>+</mo><mi>g</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{1}+f_{2}=d+g-1=e_{1}+e_{2}+e_{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p11.2" class="ltx_p">Say <math id="S3.p11.m12" class="ltx_Math" alttext="f_{2}\geq f_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>≥</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">f_{2}\geq f_{1}</annotation></semantics></math> without loss of generality. The “equation” of <math id="S3.p11.m13" class="ltx_Math" alttext="\Delta_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Delta_{k}</annotation></semantics></math> is of the following form. Let <math id="S3.p11.m14" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math>, <math id="S3.p11.m15" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math>, <math id="S3.p11.m16" class="ltx_Math" alttext="x_{3}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>3</mn></msub><annotation encoding="application/x-tex">x_{3}</annotation></semantics></math> be the projective coordinates on the <math id="S3.p11.m17" class="ltx_Math" alttext="\mathbb{P}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{2}</annotation></semantics></math>-bundle <math id="S3.p11.m18" class="ltx_Math" alttext="\mathbb{P}{\mathscr{E}}_{\pi}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathscript">ℰ</mi><mi>π</mi><mo>∨</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{P}{\mathscr{E}}_{\pi}^{\vee}</annotation></semantics></math> corresponding to <math id="S3.p11.m19" class="ltx_Math" alttext="e_{1}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mn>1</mn></msub><annotation encoding="application/x-tex">e_{1}</annotation></semantics></math>, <math id="S3.p11.m20" class="ltx_Math" alttext="e_{2}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mn>2</mn></msub><annotation encoding="application/x-tex">e_{2}</annotation></semantics></math>, <math id="S3.p11.m21" class="ltx_Math" alttext="e_{3}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mn>3</mn></msub><annotation encoding="application/x-tex">e_{3}</annotation></semantics></math> (so <math id="S3.p11.m22" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> has “weight” <math id="S3.p11.m23" class="ltx_Math" alttext="-e_{i}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">-e_{i}</annotation></semantics></math>). Let <math id="S3.p11.m24" class="ltx_Math" alttext="(s,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,t)</annotation></semantics></math> be the projective coordinates on the base <math id="S3.p11.m25" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>. Then <math id="S3.p11.m26" class="ltx_Math" alttext="\Delta_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Delta_{k}</annotation></semantics></math> has equation</p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex3.m1.pic1" class="ltx_picture ltx_markedasmath" height="48.39" overflow="visible" style="vertical-align:-35.948583788440914px" version="1.1" viewBox="34.92 35.95 425.27 48.39" width="425.27"><g transform="matrix(1 0 0 -1 34.924849313176715 48.38807562731337) translate(0,3.46) translate(34.93,0)"><g transform="translate(-34.93,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.45em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="61.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{a^{k}_{11}(s,t)x_{1}^{2}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>11</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{a^{k}_{11}(s,t)x_{1}^{2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(67.38,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.08em;font-size:10pt;" height="9.22" overflow="visible" transform="matrix(1 0 0 -1 0 8.07)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{+}" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\textstyle{+}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(118.89,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.47em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="75.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{a^{k}_{12}(s,t)x_{1}x_{2}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>12</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\textstyle{a^{k}_{12}(s,t)x_{1}x_{2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(235.31,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.08em;font-size:10pt;" height="9.22" overflow="visible" transform="matrix(1 0 0 -1 0 8.07)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{+}" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\textstyle{+}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(286.82,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.45em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="61.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{a^{k}_{22}(s,t)x_{2}^{2}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>22</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{a^{k}_{22}(s,t)x_{2}^{2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(-9.53,0) translate(0,-12.44) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.08em;font-size:10pt;" height="9.22" overflow="visible" transform="matrix(1 0 0 -1 0 8.07)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{+}" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\textstyle{+}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(34.93,0) translate(0,-12.44) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.47em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="75.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{a^{k}_{13}(s,t)x_{1}x_{3}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>13</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\textstyle{a^{k}_{13}(s,t)x_{1}x_{3}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(151.34,0) translate(0,-12.44) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.08em;font-size:10pt;" height="9.22" overflow="visible" transform="matrix(1 0 0 -1 0 8.07)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{+}" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\textstyle{+}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(202.86,0) translate(0,-12.44) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.47em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="75.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m9" class="ltx_Math" alttext="\textstyle{a^{k}_{23}(s,t)x_{2}x_{3}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>23</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\textstyle{a^{k}_{23}(s,t)x_{2}x_{3}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(356.67,0) translate(0,-12.44) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.83em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="25.37"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m11" class="ltx_Math" alttext="\textstyle{=0.}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{=0.}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(67.38,0) translate(0,-24.88) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.08em;font-size:10pt;" height="9.22" overflow="visible" transform="matrix(1 0 0 -1 0 8.07)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m13" class="ltx_Math" alttext="\textstyle{+}" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\textstyle{+}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(125.95,0) translate(0,-24.88) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.45em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="61.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex3.m1.pic1.m14" class="ltx_Math" alttext="\textstyle{a^{k}_{33}(s,t)x_{3}^{2}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>33</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>3</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{a^{k}_{33}(s,t)x_{3}^{2}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p11.3" class="ltx_p">Here <math id="S3.p11.m27" class="ltx_Math" alttext="a^{k}_{ij}(s,t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a^{k}_{ij}(s,t)</annotation></semantics></math> is homogeneous (in <math id="S3.p11.m28" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and <math id="S3.p11.m29" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>) of degree <math id="S3.p11.m30" class="ltx_Math" alttext="e_{i}+e_{j}-f_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo>−</mo><msub><mi>f</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">e_{i}+e_{j}-f_{k}</annotation></semantics></math>. In particular, the equation for <math id="S3.p11.m31" class="ltx_Math" alttext="\Delta_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Delta_{k}</annotation></semantics></math> has “weight” <math id="S3.p11.m32" class="ltx_Math" alttext="-f_{k}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>f</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">-f_{k}</annotation></semantics></math>. Notice that if <math id="S3.p11.m33" class="ltx_Math" alttext="e_{i}+e_{j}-f_{k}&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo>−</mo><msub><mi>f</mi><mi>k</mi></msub></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e_{i}+e_{j}-f_{k}&lt;0</annotation></semantics></math>, then necessarily <math id="S3.p11.m34" class="ltx_Math" alttext="a^{k}_{ij}(s,t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a^{k}_{ij}(s,t)=0</annotation></semantics></math>.</p>
</div>
<div id="S3.p12" class="ltx_para">
<p id="S3.p12.1" class="ltx_p">Rather than looking for which triples <math id="S3.p12.m1" class="ltx_Math" alttext="(e_{1},e_{2},e_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e_{1},e_{2},e_{3})</annotation></semantics></math> are achievable from such <math id="S3.p12.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, we ask which quintuples <math id="S3.p12.m3" class="ltx_Math" alttext="(e_{1},e_{2},e_{3};f_{1},f_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e_{1},e_{2},e_{3};f_{1},f_{2})</annotation></semantics></math> are achievable.</p>
</div>
<div id="S3.p13" class="ltx_para">
<p id="S3.p13.1" class="ltx_p">By our conventions, we have <math id="S3.p13.m1" class="ltx_Math" alttext="e_{1}\leq e_{2}\leq e_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>e</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">e_{1}\leq e_{2}\leq e_{3}</annotation></semantics></math> and <math id="S3.p13.m2" class="ltx_Math" alttext="f_{1}\leq f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">f_{1}\leq f_{2}</annotation></semantics></math>.</p>
</div>
<div id="S3.p14" class="ltx_para ltx_noindent">
<p id="S3.p14.1" class="ltx_p">3.5. 
Now if <math id="S3.p14.m1" class="ltx_Math" alttext="f_{1}&gt;2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{1}&gt;2e_{1}</annotation></semantics></math>, then <math id="S3.p14.m2" class="ltx_Math" alttext="f_{2}&gt;2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}&gt;2e_{1}</annotation></semantics></math> as well, so <math id="S3.p14.m3" class="ltx_Math" alttext="a^{1}_{11}=a^{2}_{11}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>11</mn><mn>1</mn></msubsup><mo>=</mo><msubsup><mi>a</mi><mn>11</mn><mn>2</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a^{1}_{11}=a^{2}_{11}=0</annotation></semantics></math>, and the equations for <math id="S3.p14.m4" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> and <math id="S3.p14.m5" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> have no <math id="S3.p14.m6" class="ltx_Math" alttext="x_{1}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">x_{1}^{2}</annotation></semantics></math> term, so both <math id="S3.p14.m7" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> and <math id="S3.p14.m8" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> contain the section <math id="S3.p14.m9" class="ltx_Math" alttext="V(x_{2},x_{3})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>x</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(x_{2},x_{3})</annotation></semantics></math> of <math id="S3.p14.m10" class="ltx_Math" alttext="\mathbb{P}{\mathscr{E}}_{\pi}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathscript">ℰ</mi><mi>π</mi><mo>∨</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{P}{\mathscr{E}}_{\pi}^{\vee}</annotation></semantics></math>. But then the complete intersection is reducible, not an irreducible quadruple cover. Hence we have <math id="S3.p14.m11" class="ltx_Math" alttext="f_{1}\leq 2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{1}\leq 2e_{1}</annotation></semantics></math>.</p>
</div>
<div id="S3.p15" class="ltx_para ltx_noindent">
<p id="S3.p15.1" class="ltx_p">3.6. 
Also, if <math id="S3.p15.m1" class="ltx_Math" alttext="f_{2}&gt;2e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}&gt;2e_{2}</annotation></semantics></math>, then <math id="S3.p15.m2" class="ltx_Math" alttext="f_{2}&gt;e_{1}+e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}&gt;e_{1}+e_{2}</annotation></semantics></math> and <math id="S3.p15.m3" class="ltx_Math" alttext="f_{2}&gt;2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}&gt;2e_{1}</annotation></semantics></math> as well, so <math id="S3.p15.m4" class="ltx_Math" alttext="a^{2}_{11}=a^{2}_{12}=a^{2}_{22}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>11</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>a</mi><mn>12</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>a</mi><mn>22</mn><mn>2</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a^{2}_{11}=a^{2}_{12}=a^{2}_{22}=0</annotation></semantics></math>, and hence the equation for <math id="S3.p15.m5" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> is divisible by <math id="S3.p15.m6" class="ltx_Math" alttext="x_{3}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>3</mn></msub><annotation encoding="application/x-tex">x_{3}</annotation></semantics></math>, and <math id="S3.p15.m7" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> is thus reducible, so the complete intersection <math id="S3.p15.m8" class="ltx_Math" alttext="\Delta_{1}\cap\Delta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>∩</mo><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{1}\cap\Delta_{2}</annotation></semantics></math> cannot be an integral curve. Hence we have <math id="S3.p15.m9" class="ltx_Math" alttext="f_{2}\leq 2e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}\leq 2e_{2}</annotation></semantics></math>.</p>
</div>
<div id="S3.p16" class="ltx_para ltx_noindent">
<p id="S3.p16.1" class="ltx_p">3.7. The five inequalities cut out a polytope <math id="S3.p16.m1" class="ltx_Math" alttext="\mathcal{Q}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{Q}^{\prime}</annotation></semantics></math> with vertices</p>
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E8.m1" class="ltx_Math" alttext="\displaystyle(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\;\overline{f}_{1},\overline{f}_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\;\overline{f}_{1},\overline{f}_{2})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.E8.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E8.m3" class="ltx_Math" alttext="\displaystyle\left(\frac{1}{3},\frac{1}{3},\frac{1}{3};\;\frac{1}{2},\frac{1}{2}\right),\;\left(\frac{1}{4},\frac{1}{4},\frac{1}{2};\;\frac{1}{2},\frac{1}{2}\right),\;\left(\frac{1}{4},\frac{3}{8},\frac{3}{8};\;\frac{1}{2},\frac{1}{2}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mo rspace="0.447em">,</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mo rspace="0.447em">,</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>8</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>8</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\frac{1}{3},\frac{1}{3},\frac{1}{3};\;\frac{1}{2},\frac{1}{2}\right),\;\left(\frac{1}{4},\frac{1}{4},\frac{1}{2};\;\frac{1}{2},\frac{1}{2}\right),\;\left(\frac{1}{4},\frac{3}{8},\frac{3}{8};\;\frac{1}{2},\frac{1}{2}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex4.m1" class="ltx_Math" alttext="\displaystyle\left(\frac{1}{3},\frac{1}{3},\frac{1}{3};\;\frac{1}{3},\frac{2}{3}\right),\;\left(0,\frac{1}{2},\frac{1}{2};\;0,1\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow><mo rspace="0.447em">,</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mn> 0</mn><mo>,</mo><mn>1</mn><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(\frac{1}{3},\frac{1}{3},\frac{1}{3};\;\frac{1}{3},\frac{2}{3}\right),\;\left(0,\frac{1}{2},\frac{1}{2};\;0,1\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p16.2" class="ltx_p">where <math id="S3.p16.m2" class="ltx_Math" alttext="\overline{f}_{k}\coloneq f_{k}/(g+3)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msub><mo>≔</mo><mrow><msub><mi>f</mi><mi>k</mi></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\overline{f}_{k}\coloneq f_{k}/(g+3)</annotation></semantics></math>. (Compare the first three coordinates of each vertex with Figure <a href="#S3.F2" title="Figure 2 ‣ 3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.)</p>
</div>
<div id="S3.p17" class="ltx_para ltx_noindent">
<p id="S3.p17.1" class="ltx_p">3.8. Notice further that if <math id="S3.p17.m1" class="ltx_Math" alttext="f_{2}&gt;e_{1}+e_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}&gt;e_{1}+e_{3}</annotation></semantics></math>, then <math id="S3.p17.m2" class="ltx_Math" alttext="f_{2}&gt;e_{1}+e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}&gt;e_{1}+e_{2}</annotation></semantics></math> and <math id="S3.p17.m3" class="ltx_Math" alttext="f_{2}&gt;2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}&gt;2e_{1}</annotation></semantics></math>, so <math id="S3.p17.m4" class="ltx_Math" alttext="a^{2}_{13}=a^{2}_{12}=a^{2}_{11}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>13</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>a</mi><mn>12</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>a</mi><mn>11</mn><mn>2</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a^{2}_{13}=a^{2}_{12}=a^{2}_{11}=0</annotation></semantics></math>, so the conic bundle <math id="S3.p17.m5" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> is of the form</p>
<table id="S3.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(9)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E9.m1" class="ltx_Math" alttext="a_{22}^{2}x_{2}^{2}+a^{2}_{23}x_{2}x_{3}+a^{2}_{33}x_{3}^{2}=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>a</mi><mn>22</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>a</mi><mn>23</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>3</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi>a</mi><mn>33</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>3</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">a_{22}^{2}x_{2}^{2}+a^{2}_{23}x_{2}x_{3}+a^{2}_{33}x_{3}^{2}=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p17.2" class="ltx_p">so the fibers (over geometric points of <math id="S3.p17.m6" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>) are pairs of lines (both passing through <math id="S3.p17.m7" class="ltx_Math" alttext="x_{2}=x_{3}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>=</mo><msub><mi>x</mi><mn>3</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{2}=x_{3}=0</annotation></semantics></math>), and a short argument shows that the complete intersection factors through a hyperelliptic cover (with equation given by (<a href="#S3.E9" title="In 3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), except taken in the <math id="S3.p17.m8" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>-bundle with projective coordinates <math id="S3.p17.m9" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math> and <math id="S3.p17.m10" class="ltx_Math" alttext="x_{3}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>3</mn></msub><annotation encoding="application/x-tex">x_{3}</annotation></semantics></math>). Thus
for primitive covers, we have an additional linear inequality <math id="S3.p17.m11" class="ltx_Math" alttext="f_{2}\leq e_{1}+e_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}\leq e_{1}+e_{3}</annotation></semantics></math>.</p>
</div>
<div id="S3.p18" class="ltx_para ltx_noindent">
<p id="S3.p18.1" class="ltx_p">3.9. This, along with the five previous inequalities, cut out a convex polytope <math id="S3.p18.m1" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> with vertices</p>
<table id="S3.EGx2" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S3.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(10)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E10.m1" class="ltx_Math" alttext="\displaystyle(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\;\overline{f}_{1},\overline{f}_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\;\overline{f}_{1},\overline{f}_{2})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.E10.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E10.m3" class="ltx_Math" alttext="\displaystyle\left(\frac{1}{3},\frac{1}{3},\frac{1}{3};\;\frac{1}{2},\frac{1}{2}\right),\;\left(\frac{1}{4},\frac{1}{4},\frac{1}{2};\;\frac{1}{2},\frac{1}{2}\right),\;\left(\frac{1}{4},\frac{3}{8},\frac{3}{8};\;\frac{1}{2},\frac{1}{2}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mo rspace="0.447em">,</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mo rspace="0.447em">,</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>8</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>8</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\frac{1}{3},\frac{1}{3},\frac{1}{3};\;\frac{1}{2},\frac{1}{2}\right),\;\left(\frac{1}{4},\frac{1}{4},\frac{1}{2};\;\frac{1}{2},\frac{1}{2}\right),\;\left(\frac{1}{4},\frac{3}{8},\frac{3}{8};\;\frac{1}{2},\frac{1}{2}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex5.m1" class="ltx_Math" alttext="\displaystyle\left(\frac{1}{3},\frac{1}{3},\frac{1}{3};\;\frac{1}{3},\frac{2}{3}\right),\;\left(\frac{1}{5},\frac{2}{5},\frac{2}{5};\;\frac{2}{5},\frac{3}{5}\right),\;\left(\frac{1}{6},\frac{1}{3},\frac{1}{2};\;\frac{1}{3},\frac{2}{3}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow><mo rspace="0.447em">,</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>5</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mn>5</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mn>5</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mn>5</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>5</mn></mfrac></mstyle><mo>)</mo></mrow><mo rspace="0.447em">,</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>6</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(\frac{1}{3},\frac{1}{3},\frac{1}{3};\;\frac{1}{3},\frac{2}{3}\right),\;\left(\frac{1}{5},\frac{2}{5},\frac{2}{5};\;\frac{2}{5},\frac{3}{5}\right),\;\left(\frac{1}{6},\frac{1}{3},\frac{1}{2};\;\frac{1}{3},\frac{2}{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p18.2" class="ltx_p">See Figure <a href="#S3.F4" title="Figure 4 ‣ 3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> for a picture of <math id="S3.p18.m2" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math>.
The astute reader will observe that we have proved Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> in the case <math id="S3.p18.m3" class="ltx_Math" alttext="d=4" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">d=4</annotation></semantics></math>: the projection of the polytope <math id="S3.p18.m4" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> to the first three coordinates is <math id="S3.p18.m5" class="ltx_Math" alttext="\mathcal{P}_{4}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{4}</annotation></semantics></math>. We have shown a necessary condition for a quintuple to come from a primitive tetragonal cover, and we now show sufficiency.</p>
</div>
<figure id="S3.F4" class="ltx_figure"><img src="2410.22531v4/3dprint.jpeg" id="S3.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" width="311" height="200" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4. </span>The polytope showing possible <math id="S3.F4.m4" class="ltx_Math" alttext="(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\;\overline{f}_{1},\overline{f}_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\;\overline{f}_{1},\overline{f}_{2})</annotation></semantics></math> for primitive tetragonal covers, portrayable in <math id="S3.F4.m5" class="ltx_Math" alttext="\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>3</mn></msup><annotation encoding="application/x-tex">\mathbb{R}^{3}</annotation></semantics></math> using the linear conditions <math id="S3.F4.m6" class="ltx_Math" alttext="\overline{e}_{1}+\overline{e}_{2}+\overline{e}_{3}=\overline{f}_{1}+\overline{f}_{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>+</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>+</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>+</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\overline{e}_{1}+\overline{e}_{2}+\overline{e}_{3}=\overline{f}_{1}+\overline{f}_{2}=1</annotation></semantics></math> (cf. Figure <a href="#S0.F1" title="Figure 1 ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>).
</figcaption>
</figure>
<div id="S3.p19" class="ltx_para">
<p id="S3.p19.1" class="ltx_p">We observe next that if <math id="S3.p19.m1" class="ltx_Math" alttext="2e_{1}-f_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">2e_{1}-f_{1}&gt;0</annotation></semantics></math>, then the divisor <math id="S3.p19.m2" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> is ample: it is easily seen to separate points and tangent vectors on the <math id="S3.p19.m3" class="ltx_Math" alttext="\mathbb{P}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{2}</annotation></semantics></math>-bundle <math id="S3.p19.m4" class="ltx_Math" alttext="\mathbb{P}{\mathscr{E}}^{\vee}_{\pi}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathscript">ℰ</mi><mi>π</mi><mo>∨</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{P}{\mathscr{E}}^{\vee}_{\pi}</annotation></semantics></math>. This condition holds for all of <math id="S3.p19.m5" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> except for a quadrilateral <math id="S3.p19.m6" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> on the boundary, so we assume now that <math id="S3.p19.m7" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> is ample. Fix now a point <math id="S3.p19.m8" class="ltx_Math" alttext="(e_{1},e_{2},e_{3};f_{1},f_{2})\in\mathbb{Z}^{5}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℤ</mi><mn>5</mn></msup></mrow><annotation encoding="application/x-tex">(e_{1},e_{2},e_{3};f_{1},f_{2})\in\mathbb{Z}^{5}</annotation></semantics></math> arising from a point in <math id="S3.p19.m9" class="ltx_Math" alttext="\mathcal{Q}\setminus Q" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>∖</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">\mathcal{Q}\setminus Q</annotation></semantics></math>, by scaling the latter point by <math id="S3.p19.m10" class="ltx_Math" alttext="g+3" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>+</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">g+3</annotation></semantics></math>.</p>
</div>
<div id="S3.p20" class="ltx_para">
<p id="S3.p20.1" class="ltx_p">By Bertini’s Theorem, if we can show that a generally chosen <math id="S3.p20.m1" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> is smooth away from finitely many points, then ampleness of the class of <math id="S3.p20.m2" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> means that a generally chosen <math id="S3.p20.m3" class="ltx_Math" alttext="\Delta_{1}\cap\Delta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>∩</mo><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{1}\cap\Delta_{2}</annotation></semantics></math> will give a smooth curve (in particular a quartic cover of <math id="S3.p20.m4" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>). Now a general fiber (over a generally chosen point of <math id="S3.p20.m5" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math> of a generally chosen <math id="S3.p20.m6" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> will have the equation <math id="S3.p20.m7" class="ltx_Math" alttext="?x_{1}x_{3}+?x_{3}^{2}+?x_{2}x_{3}+?x_{2}^{2}+??" display="inline" intent=":literal"><semantics><mrow><mrow><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>3</mn></msub></mrow><mo>+</mo><mrow><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>3</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>3</mn></msub></mrow><mo>+</mo><mrow><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mi>?</mi></mrow></mrow><annotation encoding="application/x-tex">?x_{1}x_{3}+?x_{3}^{2}+?x_{2}x_{3}+?x_{2}^{2}+??</annotation></semantics></math>, with the single question marks generally chosen nonzero values, and the double question marks indicating that possibly there are additional monomials <math id="S3.p20.m8" class="ltx_Math" alttext="x_{1}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">x_{1}^{2}</annotation></semantics></math> and <math id="S3.p20.m9" class="ltx_Math" alttext="x_{1}x_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">x_{1}x_{2}</annotation></semantics></math> appearing. Thus the general fiber is easily seen to be a smooth conic, so the generally chosen <math id="S3.p20.m10" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> is generically smooth over <math id="S3.p20.m11" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>, as desired.</p>
</div>
<div id="S3.p21" class="ltx_para ltx_noindent">
<p id="S3.p21.1" class="ltx_p">3.10.
<span id="S3.p21.1.1" class="ltx_text ltx_font_italic">The remaining case <math id="S3.p21.m1" class="ltx_Math" alttext="2e_{1}=f_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>=</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">2e_{1}=f_{1}</annotation></semantics></math> (when <math id="S3.p21.m2" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> is not ample).</span></p>
</div>
<div id="S3.p22" class="ltx_para">
<p id="S3.p22.1" class="ltx_p">The edge case where <math id="S3.p22.m1" class="ltx_Math" alttext="2e_{1}=f_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>=</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">2e_{1}=f_{1}</annotation></semantics></math> is similar. In this case, <math id="S3.p22.m2" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> does not separate points: it contracts the points on the section <math id="S3.p22.m3" class="ltx_Math" alttext="x_{2}=x_{3}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>=</mo><msub><mi>x</mi><mn>3</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{2}=x_{3}=0</annotation></semantics></math>. But away from this section, the divisor class <math id="S3.p22.m4" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> separates points and tangent vectors, so <math id="S3.p22.m5" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> is the pullback of a very ample divisor contracting <math id="S3.p22.m6" class="ltx_Math" alttext="\mathbb{P}{\mathscr{E}}^{\vee}_{\pi}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathscript">ℰ</mi><mi>π</mi><mo>∨</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{P}{\mathscr{E}}^{\vee}_{\pi}</annotation></semantics></math> along this section. The previous arguments then apply essentially without change.</p>
</div>
<div id="S3.p23" class="ltx_para ltx_noindent">
<p id="S3.p23.1" class="ltx_p">3.11.
<span id="S3.p23.1.1" class="ltx_text ltx_font_bold">Existence of primitive covers.</span> 

At this point we have shown that for all points of <math id="S3.p23.m1" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math>, the corresponding general complete intersection is a tetragonal cover of <math id="S3.p23.m2" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math> by a smooth curve. We need to show next that this cover is primitive, i.e., that it does not factor through a double cover of <math id="S3.p23.m3" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>. If the general such cover is imprimitive, then the monodromy group of the cover lies in <math id="S3.p23.m4" class="ltx_Math" alttext="D_{4}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>4</mn></msub><annotation encoding="application/x-tex">D_{4}</annotation></semantics></math>, so the resolvent cubic is reducible. To show this is not the case, we need to exhibit a single example where the resolvent cubic is irreducible. We do this by exhibiting an example where the resolvent cubic is irreducible over the generic point of <math id="S3.p23.m5" class="ltx_Math" alttext="\mathbb{P}^{1}=\Proj\mathbb{C}[s,t]" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo>=</mo><mrow><mi>Proj</mi><mo lspace="0.167em">⁡</mo><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}^{1}=\Proj\mathbb{C}[s,t]</annotation></semantics></math>.</p>
</div>
<div id="S3.p24" class="ltx_para">
<p id="S3.p24.1" class="ltx_p">In preparation, notice that for all</p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_Math" alttext="(i,j,k)\in\{(1,1,1),(2,3,1),(1,3,2),(2,2,2)\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(i,j,k)\in\{(1,1,1),(2,3,1),(1,3,2),(2,2,2)\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p24.2" class="ltx_p">we have <math id="S3.p24.m1" class="ltx_Math" alttext="e_{i}+e_{j}-f_{k}\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo>−</mo><msub><mi>f</mi><mi>k</mi></msub></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e_{i}+e_{j}-f_{k}\geq 0</annotation></semantics></math>
(<math id="S3.p24.m2" class="ltx_Math" alttext="2e_{1}\geq f_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>≥</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">2e_{1}\geq f_{1}</annotation></semantics></math> by §<a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, then <math id="S3.p24.m3" class="ltx_Math" alttext="e_{2}+e_{3}\geq f_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>≥</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">e_{2}+e_{3}\geq f_{1}</annotation></semantics></math> from <math id="S3.p24.m4" class="ltx_Math" alttext="e_{3}\geq e_{2}\geq e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>3</mn></msub><mo>≥</mo><msub><mi>e</mi><mn>2</mn></msub><mo>≥</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">e_{3}\geq e_{2}\geq e_{1}</annotation></semantics></math>, <math id="S3.p24.m5" class="ltx_Math" alttext="2e_{2}\geq f_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo>≥</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">2e_{2}\geq f_{2}</annotation></semantics></math> by §<a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, <math id="S3.p24.m6" class="ltx_Math" alttext="e_{1}+e_{3}\geq f_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>≥</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">e_{1}+e_{3}\geq f_{2}</annotation></semantics></math> by §<a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>).
Furthermore, we cannot have <math id="S3.p24.m7" class="ltx_Math" alttext="e_{2}+e_{3}-f_{1}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e_{2}+e_{3}-f_{1}=0</annotation></semantics></math>, as then <math id="S3.p24.m8" class="ltx_Math" alttext="2e_{1}-f_{1}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">2e_{1}-f_{1}=0</annotation></semantics></math> as well, from which <math id="S3.p24.m9" class="ltx_Math" alttext="e_{1}=e_{2}=e_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>=</mo><msub><mi>e</mi><mn>2</mn></msub><mo>=</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">e_{1}=e_{2}=e_{3}</annotation></semantics></math>, but then <math id="S3.p24.m10" class="ltx_Math" alttext="2e_{1}=f_{1}\leq(f_{1}+f_{2})/2=(e_{1}+e_{2}+e_{3})/2=3e_{1}/2" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>=</mo><msub><mi>f</mi><mn>1</mn></msub><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>+</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">2e_{1}=f_{1}\leq(f_{1}+f_{2})/2=(e_{1}+e_{2}+e_{3})/2=3e_{1}/2</annotation></semantics></math> from which <math id="S3.p24.m11" class="ltx_Math" alttext="e_{1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e_{1}=0</annotation></semantics></math>, contradicting the irreducibility of <math id="S3.p24.m12" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>.</p>
</div>
<div id="S3.p25" class="ltx_para">
<p id="S3.p25.1" class="ltx_p">Consider now the special case where <math id="S3.p25.m1" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> is given by
<math id="S3.p25.m2" class="ltx_Math" alttext="s^{2e_{1}-f_{1}}x_{1}^{2}+2s^{e_{2}+e_{3}-f_{1}-1}tx_{2}x_{3}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>s</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mrow><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>3</mn></msub></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s^{2e_{1}-f_{1}}x_{1}^{2}+2s^{e_{2}+e_{3}-f_{1}-1}tx_{2}x_{3}=0</annotation></semantics></math>, and <math id="S3.p25.m3" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> is given by <math id="S3.p25.m4" class="ltx_Math" alttext="2s^{e_{1}+e_{3}-f_{2}}x_{1}x_{3}+s^{2e_{2}-f_{2}}x_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mrow><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>3</mn></msub></mrow><mo>+</mo><mrow><msup><mi>s</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">2s^{e_{1}+e_{3}-f_{2}}x_{1}x_{3}+s^{2e_{2}-f_{2}}x_{2}^{2}=0</annotation></semantics></math>.</p>
</div>
<div id="S3.p26" class="ltx_para">
<p id="S3.p26.1" class="ltx_p">The cubic resolvent is (readily shown to be, and well-known to be)</p>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="\det\left(x\left(\begin{array}[]{ccc}s^{2e_{1}-f_{1}}&amp;0&amp;0\\
0&amp;0&amp;s^{e_{2}+e_{3}-f_{1}-1}t\\
0&amp;s^{e_{2}+e_{3}-f_{1}-1}t&amp;0\end{array}\right)+y\left(\begin{array}[]{ccc}0&amp;0&amp;s^{e_{1}+e_{3}-f_{2}}\\
0&amp;s^{2e_{2}-f_{2}}&amp;0\\
s^{e_{1}+e_{3}-f_{2}}&amp;0&amp;0\end{array}\right)\right)" display="block" intent=":literal"><semantics><mrow><mrow><mo movablelimits="false" rspace="0em">det</mo><mrow><mo>(</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msup><mi>s</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub></mrow></msup></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mrow><msup><mi>s</mi><mrow><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><msup><mi>s</mi><mrow><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>y</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mphantom></mphantom><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><msup><mi>s</mi><mrow><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></msup></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msup><mi>s</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></msup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msup><mi>s</mi><mrow><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></msup></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\det\left(x\left(\begin{array}[]{ccc}s^{2e_{1}-f_{1}}&amp;0&amp;0\\
0&amp;0&amp;s^{e_{2}+e_{3}-f_{1}-1}t\\
0&amp;s^{e_{2}+e_{3}-f_{1}-1}t&amp;0\end{array}\right)+y\left(\begin{array}[]{ccc}0&amp;0&amp;s^{e_{1}+e_{3}-f_{2}}\\
0&amp;s^{2e_{2}-f_{2}}&amp;0\\
s^{e_{1}+e_{3}-f_{2}}&amp;0&amp;0\end{array}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p26.2" class="ltx_p">which is</p>
<table id="S3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex8.m1" class="ltx_Math" alttext="-s^{2e_{1}+2e_{2}+2e_{3}}\left((t/s)^{2}(x/s^{f_{1}})^{3}+(y/s^{f_{2}})^{3}\right)" display="block" intent=":literal"><semantics><mrow><mo>−</mo><mrow><msup><mi>s</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>/</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>/</mo><msup><mi>s</mi><msub><mi>f</mi><mn>1</mn></msub></msup></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>/</mo><msup><mi>s</mi><msub><mi>f</mi><mn>2</mn></msub></msup></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-s^{2e_{1}+2e_{2}+2e_{3}}\left((t/s)^{2}(x/s^{f_{1}})^{3}+(y/s^{f_{2}})^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p26.3" class="ltx_p">which is easily seen to be an irreducible cubic in <math id="S3.p26.m1" class="ltx_Math" alttext="\mathbb{C}(s,t)[x,y]" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{C}(s,t)[x,y]</annotation></semantics></math> (for example using Eisenstein’s criterion).</p>
</div>
<div id="S3.p27" class="ltx_para ltx_noindent">
<p id="S3.p27.1" class="ltx_p">3.12.
<span id="S3.p27.1.1" class="ltx_text ltx_font_bold">Completing the proof of Theorem <a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</span> 
The following claim will prove that the possible scrollar invariants of primitive tetragonal covers of genus <math id="S3.p27.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> are those in the (closed) polytope <math id="S3.p27.m2" class="ltx_Math" alttext="\mathcal{P}_{4}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{4}</annotation></semantics></math>, scaled by <math id="S3.p27.m3" class="ltx_Math" alttext="g+3" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>+</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">g+3</annotation></semantics></math>. This will complete the proof of the part of Theorem <a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> dealing with primitive covers.</p>
</div>
<div id="S3.p28" class="ltx_para ltx_noindent">
<p id="S3.p28.1" class="ltx_p">3.13.
<span id="S3.p28.1.1" class="ltx_text ltx_font_bold">Claim. —</span>  <span id="S3.p28.1.2" class="ltx_text ltx_font_italic">Suppose <math id="S3.p28.m1" class="ltx_Math" alttext="0&lt;e_{1}\leq e_{2}\leq e_{3}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>e</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>e</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">0&lt;e_{1}\leq e_{2}\leq e_{3}</annotation></semantics></math> are integers with <math id="S3.p28.m2" class="ltx_Math" alttext="\frac{1}{g+3}(e_{1},e_{2},e_{3})\in\mathcal{P}_{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mrow><mi>g</mi><mo>+</mo><mn>3</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">\frac{1}{g+3}(e_{1},e_{2},e_{3})\in\mathcal{P}_{4}</annotation></semantics></math>. Then there are integers <math id="S3.p28.m3" class="ltx_Math" alttext="f_{1}\leq f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">f_{1}\leq f_{2}</annotation></semantics></math> with <math id="S3.p28.m4" class="ltx_Math" alttext="\frac{1}{g+3}(e_{1},e_{2},e_{3};f_{1},f_{2})\in\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mrow><mi>g</mi><mo>+</mo><mn>3</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">\frac{1}{g+3}(e_{1},e_{2},e_{3};f_{1},f_{2})\in\mathcal{Q}</annotation></semantics></math>.</span>
<span id="S3.p28.1.3" class="ltx_text ltx_font_italic">Proof. </span>Take <math id="S3.p28.m5" class="ltx_Math" alttext="f_{1}=\min(2e_{1},\lfloor\frac{e_{1}+e_{2}+e_{3}}{2}\rfloor)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mn>2</mn></mfrac><mo stretchy="false">⌋</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1}=\min(2e_{1},\lfloor\frac{e_{1}+e_{2}+e_{3}}{2}\rfloor)</annotation></semantics></math>, and <math id="S3.p28.m6" class="ltx_Math" alttext="f_{2}=g+3-f_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><mi>g</mi><mo>+</mo><mn>3</mn></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}=g+3-f_{1}</annotation></semantics></math>. We show that <math id="S3.p28.m7" class="ltx_Math" alttext="(e_{1},e_{2},e_{3};f_{1},f_{2})\in\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">(e_{1},e_{2},e_{3};f_{1},f_{2})\in\mathcal{Q}</annotation></semantics></math> by showing that it satisfies the six desired inequalities. Four of them are automatic, so we need only check (a) <math id="S3.p28.m8" class="ltx_Math" alttext="f_{2}\leq 2e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}\leq 2e_{2}</annotation></semantics></math> and (b) <math id="S3.p28.m9" class="ltx_Math" alttext="f_{2}\leq e_{1}+e_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}\leq e_{1}+e_{3}</annotation></semantics></math>.</p>
</div>
<div id="S3.p29" class="ltx_para">
<p id="S3.p29.1" class="ltx_p">For (a): <math id="S3.p29.m1" class="ltx_Math" alttext="f_{2}\leq 2e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}\leq 2e_{2}</annotation></semantics></math> is equivalent to <math id="S3.p29.m2" class="ltx_Math" alttext="e_{1}+e_{2}+e_{3}-f_{1}\leq 2e_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{1}+e_{2}+e_{3}-f_{1}\leq 2e_{2}</annotation></semantics></math>, which is equivalent to <math id="S3.p29.m3" class="ltx_Math" alttext="e_{1}+e_{3}\leq e_{2}+f_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>≤</mo><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>f</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{1}+e_{3}\leq e_{2}+f_{1}</annotation></semantics></math>. So it suffices to show that (a1) <math id="S3.p29.m4" class="ltx_Math" alttext="e_{1}+e_{3}\leq e_{2}+2e_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>≤</mo><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">e_{1}+e_{3}\leq e_{2}+2e_{1}</annotation></semantics></math> and (a2) <math id="S3.p29.m5" class="ltx_Math" alttext="e_{1}+e_{3}\leq e_{2}+\lfloor\frac{e_{1}+e_{2}+e_{3}}{2}\rfloor" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>≤</mo><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mn>2</mn></mfrac><mo stretchy="false">⌋</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">e_{1}+e_{3}\leq e_{2}+\lfloor\frac{e_{1}+e_{2}+e_{3}}{2}\rfloor</annotation></semantics></math>. (a1) is one of the inequalities defining <math id="S3.p29.m6" class="ltx_Math" alttext="\mathcal{P}_{4}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{4}</annotation></semantics></math>. (a2) is easily manipulated to <math id="S3.p29.m7" class="ltx_Math" alttext="e_{2}\geq\lceil\frac{e_{1}+e_{2}+e_{3}}{4}\rceil" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>≥</mo><mrow><mo stretchy="false">⌈</mo><mfrac><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mn>4</mn></mfrac><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">e_{2}\geq\lceil\frac{e_{1}+e_{2}+e_{3}}{4}\rceil</annotation></semantics></math>. But by inspection of the vertices of <math id="S3.p29.m8" class="ltx_Math" alttext="\mathcal{P}_{4}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{4}</annotation></semantics></math>, <math id="S3.p29.m9" class="ltx_Math" alttext="\overline{e}_{2}\geq 1/4" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>≥</mo><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">\overline{e}_{2}\geq 1/4</annotation></semantics></math>, so <math id="S3.p29.m10" class="ltx_Math" alttext="e_{2}\geq\frac{e_{1}+e_{2}+e_{3}}{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>≥</mo><mfrac><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">e_{2}\geq\frac{e_{1}+e_{2}+e_{3}}{4}</annotation></semantics></math>, and <math id="S3.p29.m11" class="ltx_Math" alttext="e_{2}\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">e_{2}\in\mathbb{Z}</annotation></semantics></math>, so this case is complete.</p>
</div>
<div id="S3.p30" class="ltx_para">
<p id="S3.p30.1" class="ltx_p">Inequality (b) is equivalent to <math id="S3.p30.m1" class="ltx_Math" alttext="e_{2}\leq f_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">e_{2}\leq f_{1}</annotation></semantics></math>, so it suffices to show (b1) <math id="S3.p30.m2" class="ltx_Math" alttext="e_{2}\leq 2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{2}\leq 2e_{1}</annotation></semantics></math> and (b2) <math id="S3.p30.m3" class="ltx_Math" alttext="e_{2}\leq\lfloor\frac{e_{1}+e_{2}+e_{3}}{2}\rfloor" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>≤</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mn>2</mn></mfrac><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">e_{2}\leq\lfloor\frac{e_{1}+e_{2}+e_{3}}{2}\rfloor</annotation></semantics></math>. (b1) is one of the inequalities defining <math id="S3.p30.m4" class="ltx_Math" alttext="\mathcal{P}_{4}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{4}</annotation></semantics></math>.
By inspection of the vertices of <math id="S3.p30.m5" class="ltx_Math" alttext="\mathcal{P}_{4}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{4}</annotation></semantics></math>, <math id="S3.p30.m6" class="ltx_Math" alttext="\overline{e}_{2}\leq 1/2" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\overline{e}_{2}\leq 1/2</annotation></semantics></math>, so <math id="S3.p30.m7" class="ltx_Math" alttext="e_{2}\leq\frac{e_{1}+e_{2}+e_{3}}{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>≤</mo><mfrac><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">e_{2}\leq\frac{e_{1}+e_{2}+e_{3}}{2}</annotation></semantics></math>, so (b2) follows as <math id="S3.p30.m8" class="ltx_Math" alttext="e_{2}\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">e_{2}\in\mathbb{Z}</annotation></semantics></math>. ∎</p>
</div>
<div id="S3.p31" class="ltx_para">
<p id="S3.p31.1" class="ltx_p">Finally, note that <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx26" title="" class="ltx_ref">KO</a>]</cite> proves that if <math id="S3.p31.m1" class="ltx_Math" alttext="(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3})</annotation></semantics></math> lies in <math id="S3.p31.m2" class="ltx_Math" alttext="\mathcal{P}_{4}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>4</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">\mathcal{P}_{4}^{\prime}</annotation></semantics></math>, then it is realized by some smooth bi-hyperelliptic cover. In all cases, the smoothness of <math id="S3.p31.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> implies the irreducibility of <math id="S3.p31.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, as <math id="S3.p31.m5" class="ltx_math_unparsed" alttext="h^{0}(C,{\mathscr{O}}_{C})=\oplus_{i=0}^{3}h^{0}(\mathbb{P}^{1},{\mathscr{O}}(-e_{i}))=1" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><msubsup><mo lspace="0em">⊕</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>3</mn></msubsup><msup><mi>h</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo>,</mo><mi class="ltx_font_mathscript">𝒪</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>e</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h^{0}(C,{\mathscr{O}}_{C})=\oplus_{i=0}^{3}h^{0}(\mathbb{P}^{1},{\mathscr{O}}(-e_{i}))=1</annotation></semantics></math>. This concludes the proof of Theorem <a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. ∎</p>
</div>
<div id="S3.p32" class="ltx_para ltx_noindent">
<p id="S3.p32.1" class="ltx_p">3.14.
<span id="S3.p32.1.1" class="ltx_text ltx_font_bold">The remainder of <math id="S3.p32.m1" class="ltx_Math" alttext="\mathcal{Q}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{Q}^{\prime}</annotation></semantics></math>: the exclusively “bi-hyperelliptic” or “<math id="S3.p32.m2" class="ltx_Math" alttext="D_{4}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>4</mn></msub><annotation encoding="application/x-tex">D_{4}</annotation></semantics></math> monodromy” locus.</span> 
We now consider the remaining points in the polytope described by (<a href="#S3.Ex4" title="In 3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>). We are in the regime where <math id="S3.p32.m3" class="ltx_Math" alttext="f_{2}&gt;e_{1}+e_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{2}&gt;e_{1}+e_{3}</annotation></semantics></math> so <math id="S3.p32.m4" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> is given by (<a href="#S3.E9" title="In 3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>). This
surface is singular along the entire section <math id="S3.p32.m5" class="ltx_Math" alttext="x_{2}=x_{3}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>=</mo><msub><mi>x</mi><mn>3</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{2}=x_{3}=0</annotation></semantics></math>. Thus any complete intersection <math id="S3.p32.m6" class="ltx_Math" alttext="\Delta_{1}\cap\Delta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>∩</mo><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{1}\cap\Delta_{2}</annotation></semantics></math> will be singular <span id="S3.p32.1.2" class="ltx_text ltx_font_italic">unless</span> <math id="S3.p32.m7" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> does not intersect this section <math id="S3.p32.m8" class="ltx_Math" alttext="x_{2}=x_{3}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>=</mo><msub><mi>x</mi><mn>3</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{2}=x_{3}=0</annotation></semantics></math>. Translation: unless <math id="S3.p32.m9" class="ltx_Math" alttext="a^{1}_{11}(s,t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>11</mn><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a^{1}_{11}(s,t)</annotation></semantics></math> is a constant, i.e., <math id="S3.p32.m10" class="ltx_Math" alttext="f_{1}=2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{1}=2e_{1}</annotation></semantics></math>, there cannot be a complete intersection that is a smooth curve. Thus outside of the locus <math id="S3.p32.m11" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> all remaining smooth curves are in the plane <math id="S3.p32.m12" class="ltx_Math" alttext="f_{1}=2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{1}=2e_{1}</annotation></semantics></math>. In this case, <math id="S3.p32.m13" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> is <span id="S3.p32.1.3" class="ltx_text ltx_font_italic">not</span> ample, but its failure of ampleness is our friend: a general section of <math id="S3.p32.m14" class="ltx_Math" alttext="{\mathscr{O}}(\Delta_{1})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{O}}(\Delta_{1})</annotation></semantics></math> will be nonzero along all of <math id="S3.p32.m15" class="ltx_Math" alttext="x_{2}=x_{3}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>=</mo><msub><mi>x</mi><mn>3</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{2}=x_{3}=0</annotation></semantics></math>, and away from this locus Bertini’s Theorem applies. Then in this case the previous arguments apply without change, and a general such complete intersection will give a tetragonal cover by a regular curve, except of course this cover factors through a hyperelliptic cover of <math id="S3.p32.m16" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>.
Note only that the point <math id="S3.p32.m17" class="ltx_Math" alttext="(0,1/2,1/2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1/2,1/2)</annotation></semantics></math> is excluded because from the start we had a strict inequality <math id="S3.p32.m18" class="ltx_Math" alttext="e_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e_{1}&gt;0</annotation></semantics></math>.</p>
</div>
<div id="S3.p33" class="ltx_para ltx_noindent">
<p id="S3.p33.1" class="ltx_p">3.15.
<span id="S3.p33.1.1" class="ltx_text ltx_font_bold">Quintuples in <math id="S3.p33.m1" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> arising from smooth bi-hyperelliptic covers.</span>  We now ask which quintuples <math id="S3.p33.m2" class="ltx_Math" alttext="(e_{1},e_{2},e_{3};f_{1},f_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e_{1},e_{2},e_{3};f_{1},f_{2})</annotation></semantics></math> occur from smooth bi-hyperelliptic covers. If the quintuple <math id="S3.p33.m3" class="ltx_Math" alttext="(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\overline{f}_{1},\overline{f}_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\overline{f}_{1},\overline{f}_{2})</annotation></semantics></math> is contained in <math id="S3.p33.m4" class="ltx_Math" alttext="\mathcal{Q}^{\prime}\setminus\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup><mo>∖</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">\mathcal{Q}^{\prime}\setminus\mathcal{Q}</annotation></semantics></math>, then the discussion above provides an affirmative answer precisely when <math id="S3.p33.m5" class="ltx_Math" alttext="f_{1}=2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{1}=2e_{1}</annotation></semantics></math>. We now prove that any quintuple <math id="S3.p33.m6" class="ltx_Math" alttext="(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\overline{f}_{1},\overline{f}_{2})\in\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\overline{f}_{1},\overline{f}_{2})\in\mathcal{Q}</annotation></semantics></math> occurs from a smooth bi-hyperelliptic curve.</p>
</div>
<div id="S3.p34" class="ltx_para">
<p id="S3.p34.1" class="ltx_p">If <math id="S3.p34.m1" class="ltx_Math" alttext="2e_{1}=f_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>=</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">2e_{1}=f_{1}</annotation></semantics></math>, then we have shown in §<a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> that the general corresponding complete intersection is primitive (hence not bi-hyperelliptic). Therefore, to show the existence of a smooth bi-hyperelliptic curve with the prescribed invariants, we restrict to a special subfamily of complete intersections. Namely, take the conic bundle <math id="S3.p34.m2" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> to be general subject to the condition that <math id="S3.p34.m3" class="ltx_Math" alttext="a_{11}^{2}=a_{12}^{2}=a_{13}^{2}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>11</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>a</mi><mn>12</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>a</mi><mn>13</mn><mn>2</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{11}^{2}=a_{12}^{2}=a_{13}^{2}=0</annotation></semantics></math>. Now, the argument of §<a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> applies without change, and a general such complete intersection is a smooth bi-hyperelliptic curve (a short calculation shows that the cubic resolvent is reducible, and hence the curve is bi-hyperelliptic).</p>
</div>
<div id="S3.p35" class="ltx_para">
<p id="S3.p35.1" class="ltx_p">Now, if <math id="S3.p35.m1" class="ltx_Math" alttext="2e_{1}&gt;f_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>&gt;</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">2e_{1}&gt;f_{1}</annotation></semantics></math>, again we have shown in §<a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> that the general corresponding complete intersection is primitive, so we restrict to a special family. Choose a general polynomial <math id="S3.p35.m2" class="ltx_Math" alttext="p(s,t)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(s,t)</annotation></semantics></math> of degree <math id="S3.p35.m3" class="ltx_Math" alttext="e_{3}-e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>3</mn></msub><mo>−</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">e_{3}-e_{2}</annotation></semantics></math>. Consider conic bundles <math id="S3.p35.m4" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> and <math id="S3.p35.m5" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math> subject to the conditions that <math id="S3.p35.m6" class="ltx_Math" alttext="a_{11}^{2}=a_{12}^{2}=a_{12}^{1}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>11</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>a</mi><mn>12</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>a</mi><mn>12</mn><mn>1</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{11}^{2}=a_{12}^{2}=a_{12}^{1}=0</annotation></semantics></math> and <math id="S3.p35.m7" class="ltx_Math" alttext="a_{23}^{2}=pa_{22}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>23</mn><mn>2</mn></msubsup><mo>=</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mn>22</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">a_{23}^{2}=pa_{22}^{2}</annotation></semantics></math> and <math id="S3.p35.m8" class="ltx_Math" alttext="a_{23}^{1}=pa_{22}^{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mn>23</mn><mn>1</mn></msubsup><mo>=</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mn>22</mn><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">a_{23}^{1}=pa_{22}^{1}</annotation></semantics></math>. Fix a general choice of <math id="S3.p35.m9" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math>. Observe that it is smooth away from finitely many points; a general fiber is a smooth conic and no fiber over <math id="S3.p35.m10" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math> is a double line. Again, the cubic resolvent is easily seen to be reducible.</p>
</div>
<div id="S3.p36" class="ltx_para">
<p id="S3.p36.1" class="ltx_p">Now, notice that the class of <math id="S3.p36.m1" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> separates points away from <math id="S3.p36.m2" class="ltx_Math" alttext="V(a_{22}^{2})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>22</mn><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(a_{22}^{2})</annotation></semantics></math>. It separates tangent vectors away from the union of <math id="S3.p36.m3" class="ltx_Math" alttext="V(x_{2},x_{3})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>x</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(x_{2},x_{3})</annotation></semantics></math> and <math id="S3.p36.m4" class="ltx_Math" alttext="V(x_{1},x_{3})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(x_{1},x_{3})</annotation></semantics></math>. Therefore by Bertini’s theorem, a general intersection <math id="S3.p36.m5" class="ltx_Math" alttext="\Delta_{1}\cap\Delta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>∩</mo><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{1}\cap\Delta_{2}</annotation></semantics></math> is smooth on <math id="S3.p36.m6" class="ltx_Math" alttext="\mathbb{P}({\mathscr{E}})^{\vee}\setminus\{V(a_{22}^{2})\cup V(x_{1},x_{3})\cup V(x_{2},x_{3})\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathscript">ℰ</mi><mo stretchy="false">)</mo></mrow><mo>∨</mo></msup></mrow><mo>∖</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>22</mn><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>x</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}({\mathscr{E}})^{\vee}\setminus\{V(a_{22}^{2})\cup V(x_{1},x_{3})\cup V(x_{2},x_{3})\}</annotation></semantics></math>.</p>
</div>
<div id="S3.p37" class="ltx_para">
<p id="S3.p37.1" class="ltx_p">To complete the proof, observe that for a general choice of <math id="S3.p37.m1" class="ltx_Math" alttext="\Delta_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Delta_{1}</annotation></semantics></math> and <math id="S3.p37.m2" class="ltx_Math" alttext="\Delta_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Delta_{2}</annotation></semantics></math>, we have:</p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p">there are no singular points of <math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="\Delta_{1}\cap\Delta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>∩</mo><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{1}\cap\Delta_{2}</annotation></semantics></math> contained on <math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="V(a_{22}^{2})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>22</mn><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(a_{22}^{2})</annotation></semantics></math> (on these fibers, the intersection of <math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="\Delta_{1}\cap\Delta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>∩</mo><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{1}\cap\Delta_{2}</annotation></semantics></math> is generically <math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> distinct points);</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p">the intersection of <math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="\Delta_{1}\cap\Delta_{2}\cap V(x_{1},x_{3})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>∩</mo><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub><mo>∩</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{1}\cap\Delta_{2}\cap V(x_{1},x_{3})</annotation></semantics></math> is trivial (this follows from the fact that <math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="a_{22}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mn>22</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">a_{22}^{2}</annotation></semantics></math> and <math id="S3.I1.i2.p1.m3" class="ltx_Math" alttext="a_{22}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mn>22</mn><mn>1</mn></msubsup><annotation encoding="application/x-tex">a_{22}^{1}</annotation></semantics></math> share no common factors);</p>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i3.p1.1" class="ltx_p">and there are no singular points of <math id="S3.I1.i3.p1.m1" class="ltx_Math" alttext="\Delta_{1}\cap\Delta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>∩</mo><msub><mi mathvariant="normal">Δ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta_{1}\cap\Delta_{2}</annotation></semantics></math> contained on <math id="S3.I1.i3.p1.m2" class="ltx_Math" alttext="V(x_{2},x_{3})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>x</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(x_{2},x_{3})</annotation></semantics></math> (to see this, compute the rank of the Jacobian matrix at any point of intersection).</p>
</div></li>
</ol>
</div>
<div id="S3.p38" class="ltx_para ltx_noindent">
<p id="S3.p38.1" class="ltx_p">3.16.
<span id="S3.p38.1.1" class="ltx_text ltx_font_bold">Quintuples <math id="S3.p38.m1" class="ltx_Math" alttext="(e_{1},e_{2},e_{3};f_{1},f_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e_{1},e_{2},e_{3};f_{1},f_{2})</annotation></semantics></math> arising from smooth covers.</span> 
For a number of reasons it is worth considering which quintuples <math id="S3.p38.m2" class="ltx_Math" alttext="(e_{1},e_{2},e_{3};f_{1},f_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e_{1},e_{2},e_{3};f_{1},f_{2})</annotation></semantics></math> correspond to smooth covers. (For example: these track the entire resolution of <math id="S3.p38.m3" class="ltx_Math" alttext="C\hookrightarrow\mathbb{P}{\mathscr{E}}^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">↪</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathscript">ℰ</mi><mo>∨</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C\hookrightarrow\mathbb{P}{\mathscr{E}}^{\vee}</annotation></semantics></math>; the <math id="S3.p38.m4" class="ltx_Math" alttext="f_{i}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>i</mi></msub><annotation encoding="application/x-tex">f_{i}</annotation></semantics></math> correspond to the resolvent cubic; and more.) The above discussion is enough to determine the achievable quintuples, and the result is more striking than when we just identify the possible <math id="S3.p38.m5" class="ltx_Math" alttext="(e_{1},e_{2},e_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e_{1},e_{2},e_{3})</annotation></semantics></math>; we get the union of two polytopes of different dimensions (see Figure <a href="#S0.F1" title="Figure 1 ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>).</p>
</div>
<div id="S3.p39" class="ltx_para ltx_noindent">
<p id="S3.p39.1" class="ltx_p">3.17.
<span id="S3.p39.1.1" class="ltx_text ltx_font_bold">Fun remarks about the “fin”.</span> 
There are even more phenomena worth pointing out. For the purposes of this discussion, we call the two-dimensional triangular offshoot the “fin” (where to be precise, the fin excludes the boundary where it meets the <math id="S3.p39.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-dimensional polytope shown in Figure <a href="#S3.F4" title="Figure 4 ‣ 3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>). The moduli space of quartic covers of fixed genus is irreducible – so perhaps it is surprising to see that its image (admittedly, under <math id="S3.p39.m2" class="ltx_Math" alttext="\operatorname{Tsch}" display="inline" intent=":literal"><semantics><mi>Tsch</mi><annotation encoding="application/x-tex">\operatorname{Tsch}</annotation></semantics></math>, and asymptotically as <math id="S3.p39.m3" class="ltx_Math" alttext="g\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">g\rightarrow\infty</annotation></semantics></math>) has two pieces.</p>
</div>
<div id="S3.p40" class="ltx_para ltx_noindent">
<p id="S3.p40.1" class="ltx_p">3.18.
<span id="S3.p40.1.1" class="ltx_text ltx_font_italic">The “bulk” of quartic covers live on the “balanced” vertex of <math id="S3.p40.m1" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math>.</span> 
The generic quartic cover of fixed genus is balanced (i.e. <math id="S3.p40.m2" class="ltx_Math" alttext="e_{3}-e_{1}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mn>3</mn></msub><mo>−</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e_{3}-e_{1}\leq 1</annotation></semantics></math>). This implies that the “bulk” of the “mass” of the moduli space is concentrated on the “balanced” vertex, where the <math id="S3.p40.m3" class="ltx_Math" alttext="\overline{e}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\overline{e}_{i}</annotation></semantics></math> are all equal and the <math id="S3.p40.m4" class="ltx_Math" alttext="\overline{f}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\overline{f}_{j}</annotation></semantics></math> are both equal.</p>
</div>
<div id="S3.p41" class="ltx_para">
<p id="S3.p41.1" class="ltx_p">In §<a href="#S8" title="8. Motivation and analogy from number theory ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> we make this statement precise by defining a <em id="S3.p41.1.1" class="ltx_emph ltx_font_italic">density function</em> <math id="S3.p41.m1" class="ltx_Math" alttext="\rho_{ref}^{\rm{geo}}\colon\mathbb{R}^{5}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ρ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mi>geo</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mn>5</mn></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\rho_{ref}^{\rm{geo}}\colon\mathbb{R}^{5}\rightarrow\mathbb{R}</annotation></semantics></math> which sends a point <math id="S3.p41.m2" class="ltx_Math" alttext="(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\overline{f}_{1},\overline{f}_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>f</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\overline{e}_{1},\overline{e}_{2},\overline{e}_{3};\overline{f}_{1},\overline{f}_{2})</annotation></semantics></math> to a quantity which reflects the “proportion” of quartic curves with those given invariants. Surprisingly, <math id="S3.p41.m3" class="ltx_Math" alttext="\rho_{ref}^{\rm{geo}}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mi>geo</mi></msubsup><annotation encoding="application/x-tex">\rho_{ref}^{\rm{geo}}</annotation></semantics></math> is a piecewise linear function, supported on the region pictured on Figure <a href="#S0.F1" title="Figure 1 ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, and continuous on its support. We give an explicit formula for <math id="S3.p41.m4" class="ltx_Math" alttext="\rho_{ref}^{\rm{geo}}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mi>geo</mi></msubsup><annotation encoding="application/x-tex">\rho_{ref}^{\rm{geo}}</annotation></semantics></math> (Proposition <a href="#S8" title="8. Motivation and analogy from number theory ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), and show that <math id="S3.p41.m5" class="ltx_Math" alttext="\rho_{ref}^{geo}(1/3,1/3,1/3;1/2,1/2)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ρ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho_{ref}^{geo}(1/3,1/3,1/3;1/2,1/2)=1</annotation></semantics></math>, and this is where it obtains its maximum value.</p>
</div>
<div id="S3.p42" class="ltx_para ltx_noindent">
<p id="S3.p42.1" class="ltx_p">3.19.
<span id="S3.p42.1.1" class="ltx_text ltx_font_italic">But, a codimension <math id="S3.p42.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> sublocus of <math id="S3.p42.m2" class="ltx_Math" alttext="\mathcal{H}_{4,g}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{H}_{4,g}</annotation></semantics></math> lives as far away from the balanced vertex as possible.</span></p>
</div>
<figure id="S3.F5" class="ltx_figure"><img src="2410.22531v4/hlines.png" id="S3.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" width="603" height="439" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5. </span>A depiction of the geography of degree <math id="S3.F5.m4" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> covers of <math id="S3.F5.m5" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>. The “fin” is drawn in blue, and the yellow lines indicate the loci where the hyperelliptic subcover has fixed genus. The leftmost yellow point corresponds to the hyperelliptic subcover having genus <math id="S3.F5.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.</figcaption>
</figure>
<div id="S3.p43" class="ltx_para">
<p id="S3.p43.1" class="ltx_p">However, there is one other point where <math id="S3.p43.m1" class="ltx_Math" alttext="\rho^{geo}_{ref}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msubsup><annotation encoding="application/x-tex">\rho^{geo}_{ref}</annotation></semantics></math> obtains its maximum value of <math id="S3.p43.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, and that is at the <span id="S3.p43.1.1" class="ltx_text ltx_font_italic">least</span> balanced vertex, <math id="S3.p43.m3" class="ltx_Math" alttext="(0,1/2,1/2;0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1/2,1/2;0,1)</annotation></semantics></math>, which is the point farthest from <math id="S3.p43.m4" class="ltx_Math" alttext="\mathcal{P}_{4}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{4}</annotation></semantics></math>. Here, the picture is as follows. We have already shown that covers in the fin are bi-hyperelliptic, but in fact we can do better: such covers have a <em id="S3.p43.1.2" class="ltx_emph ltx_font_italic">distinguished</em> quadratic subcover, and the genus of that quadratic subcover is precisely <math id="S3.p43.m5" class="ltx_Math" alttext="e_{1}-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e_{1}-1</annotation></semantics></math>.</p>
</div>
<div id="S3.p44" class="ltx_para ltx_noindent">
<p id="S3.p44.1" class="ltx_p">3.20.
<span id="S3.p44.1.1" class="ltx_text ltx_font_bold">Lemma.</span>   <span id="S3.p44.1.2" class="ltx_text ltx_font_italic">Let <math id="S3.p44.m1" class="ltx_Math" alttext="C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> be a quartic cover whose scrollar invariants lie on the fin. Then <math id="S3.p44.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> has a distinguished quadratic subcover, and that quadratic subcover has genus <math id="S3.p44.m3" class="ltx_Math" alttext="h=e_{1}-1" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">h=e_{1}-1</annotation></semantics></math>.
</span></p>
</div>
<div id="S3.p45" class="ltx_para ltx_noindent">
<p id="S3.p45.1" class="ltx_p"><span id="S3.p45.1.1" class="ltx_text ltx_font_italic">Proof. </span>Because <math id="S3.p45.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> lies in the fin, <math id="S3.p45.m2" class="ltx_Math" alttext="e_{2}&gt;e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>&gt;</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">e_{2}&gt;e_{1}</annotation></semantics></math>. Consider the multiplication map <math id="S3.p45.m3" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}\otimes\pi_{*}{\mathscr{O}}_{C}\rightarrow\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>π</mi><mo>∗</mo></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}\otimes\pi_{*}{\mathscr{O}}_{C}\rightarrow\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math> and fix a splitting of <math id="S3.p45.m4" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math>. Let <math id="S3.p45.m5" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math> be the subbundle <math id="S3.p45.m6" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})</annotation></semantics></math>. Because <math id="S3.p45.m7" class="ltx_Math" alttext="e_{2}&gt;2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{2}&gt;2e_{1}</annotation></semantics></math>, the image of <math id="S3.p45.m8" class="ltx_Math" alttext="{\mathscr{A}}\otimes{\mathscr{A}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow><annotation encoding="application/x-tex">{\mathscr{A}}\otimes{\mathscr{A}}</annotation></semantics></math> under the multiplication map lies in <math id="S3.p45.m9" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math>; in other words, <math id="S3.p45.m10" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math> is a quadratic <math id="S3.p45.m11" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-subalgebra of <math id="S3.p45.m12" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math>. Therefore <math id="S3.p45.m13" class="ltx_Math" alttext="C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> factors through the hyperelliptic curve <math id="S3.p45.m14" class="ltx_Math" alttext="\underline{\operatorname{Spec}}\;{\mathscr{A}}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>Spec</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.447em" rspace="0em">​</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow><annotation encoding="application/x-tex">\underline{\operatorname{Spec}}\;{\mathscr{A}}</annotation></semantics></math>, which visibly has genus <math id="S3.p45.m15" class="ltx_Math" alttext="e_{1}-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e_{1}-1</annotation></semantics></math>.
∎</p>
</div>
<div id="S3.p46" class="ltx_para">
<p id="S3.p46.1" class="ltx_p">Upon fixing a genus <math id="S3.p46.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>, each possible value of <math id="S3.p46.m2" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> gives rise to a line in the fin (explicitly, the line <math id="S3.p46.m3" class="ltx_Math" alttext="\frac{h}{g+3}=\overline{e}_{1}-\frac{1}{g+3}" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>h</mi><mrow><mi>g</mi><mo>+</mo><mn>3</mn></mrow></mfrac><mo>=</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>−</mo><mfrac><mn>1</mn><mrow><mi>g</mi><mo>+</mo><mn>3</mn></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\frac{h}{g+3}=\overline{e}_{1}-\frac{1}{g+3}</annotation></semantics></math>). Upon fixing <math id="S3.p46.m4" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>, the “bulk” of the moduli space of quartic covers factoring through genus <math id="S3.p46.m5" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> hyperelliptic curves lies where the line meets the edge of the fin given by <math id="S3.p46.m6" class="ltx_Math" alttext="\overline{e}_{2}=\overline{e}_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>=</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\overline{e}_{2}=\overline{e}_{3}</annotation></semantics></math> (a glance at Figure <a href="#S3.F5" title="Figure 5 ‣ 3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> may be enlightening). Concretely: fix a value <math id="S3.p46.m7" class="ltx_Math" alttext="0\leq\overline{h}\leq 1/4" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mover accent="true"><mi>h</mi><mo stretchy="true">¯</mo></mover><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq\overline{h}\leq 1/4</annotation></semantics></math>. Then, the maximum value of <math id="S3.p46.m8" class="ltx_Math" alttext="\rho_{ref}^{geo}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msubsup><annotation encoding="application/x-tex">\rho_{ref}^{geo}</annotation></semantics></math> restricted to the hyperplane <math id="S3.p46.m9" class="ltx_Math" alttext="\overline{e}_{1}=\overline{h}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>=</mo><mover accent="true"><mi>h</mi><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">\overline{e}_{1}=\overline{h}</annotation></semantics></math> is achieved precisely when <math id="S3.p46.m10" class="ltx_Math" alttext="\overline{e}_{2}=\overline{e}_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>=</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\overline{e}_{2}=\overline{e}_{3}</annotation></semantics></math>.</p>
</div>
<div id="S3.p47" class="ltx_para">
<p id="S3.p47.1" class="ltx_p">Now, the maximum value of <math id="S3.p47.m1" class="ltx_Math" alttext="\rho_{ref}^{geo}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msubsup><annotation encoding="application/x-tex">\rho_{ref}^{geo}</annotation></semantics></math> on the fin is attained at the least balanced vertex <math id="S3.p47.m2" class="ltx_Math" alttext="(0,1/2,1/2;0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1/2,1/2;0,1)</annotation></semantics></math>, which is precisely the point where <math id="S3.p47.m3" class="ltx_Math" alttext="\overline{h}=0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>h</mi><mo stretchy="true">¯</mo></mover><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\overline{h}=0</annotation></semantics></math>. In this case, the dimension of the moduli space of bi-hyperelliptic quartic covers whose quadratic subcover is a genus <math id="S3.p47.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> curve is precisely <math id="S3.p47.m5" class="ltx_Math" alttext="2g+1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2g+1</annotation></semantics></math>. Compare this to the dimension of the moduli space of quartic covers, which is <math id="S3.p47.m6" class="ltx_Math" alttext="2g+3" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2g+3</annotation></semantics></math>. The two spaces have comparable dimension as <math id="S3.p47.m7" class="ltx_Math" alttext="g\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">g\rightarrow\infty</annotation></semantics></math>, and the difference in dimensions is always <math id="S3.p47.m8" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>! This explains why <math id="S3.p47.m9" class="ltx_Math" alttext="\rho_{ref}^{geo}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msubsup><annotation encoding="application/x-tex">\rho_{ref}^{geo}</annotation></semantics></math> attains the same value at both vertices.</p>
</div>
<div id="S3.p48" class="ltx_para ltx_noindent">
<p id="S3.p48.1" class="ltx_p">3.21.
<span id="S3.p48.1.1" class="ltx_text ltx_font_italic">Arithmetic meaning of the fin.</span> 
This discussion is related to the remarkable arithmetic fact due to Bhargava that, when ordered by absolute discriminant, a positive portion of quartic number fields have Galois group <math id="S3.p48.m1" class="ltx_Math" alttext="D_{4}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>4</mn></msub><annotation encoding="application/x-tex">D_{4}</annotation></semantics></math>, not <math id="S3.p48.m2" class="ltx_Math" alttext="S_{4}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mn>4</mn></msub><annotation encoding="application/x-tex">S_{4}</annotation></semantics></math>; see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">Bh</a>, Thm. 4]</cite>.</p>
</div>
<div id="S3.p49" class="ltx_para">
<p id="S3.p49.1" class="ltx_p">Qualitatively, our discussion above shows that there are lots of quartic covers whose scrollar invariants lie either at the “balanced” vertex or the “least balanced” vertex. The scrollar invariants of curves are analogous to the successive minima of rings of integers in number fields (see §<a href="#S8" title="8. Motivation and analogy from number theory ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> for details). It is possible to show <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">Ve3</a>, Thm. 5.5]</cite> that when ordered by absolute discriminant, that <math id="S3.p49.m1" class="ltx_Math" alttext="S_{4}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mn>4</mn></msub><annotation encoding="application/x-tex">S_{4}</annotation></semantics></math>-fields tend to lie at the “balanced” vertex, and <math id="S3.p49.m2" class="ltx_Math" alttext="D_{4}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>4</mn></msub><annotation encoding="application/x-tex">D_{4}</annotation></semantics></math>-fields tend to lie at the “least balanced” vertex. The fact that the density function <math id="S3.p49.m3" class="ltx_Math" alttext="\rho_{ref}^{geo}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msubsup><annotation encoding="application/x-tex">\rho_{ref}^{geo}</annotation></semantics></math> takes value <math id="S3.p49.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> on both vertices reflects the fact that a positive portion of quartic number fields have Galois group <math id="S3.p49.m5" class="ltx_Math" alttext="D_{4}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>4</mn></msub><annotation encoding="application/x-tex">D_{4}</annotation></semantics></math>.</p>
</div>
<figure id="S3.F6" class="ltx_figure"><img src="2410.22531v4/sexticcartoon.png" id="S3.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" width="577" height="439" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 6. </span>A tale of two fins: in this cartoon drawing, <math id="S3.F6.m4" class="ltx_Math" alttext="Q_{3}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>3</mn></msub><annotation encoding="application/x-tex">Q_{3}</annotation></semantics></math> is the union of the blue and orange region, <math id="S3.F6.m5" class="ltx_Math" alttext="Q_{2}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>2</mn></msub><annotation encoding="application/x-tex">Q_{2}</annotation></semantics></math> is the union of the green and orange region, and <math id="S3.F6.m6" class="ltx_Math" alttext="\mathcal{P}_{6}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{6}</annotation></semantics></math> is their intersection. The two unbalanced points at the top, as well as the balanced point at the bottom, are labeled.</figcaption>
</figure>
<div id="S3.p50" class="ltx_para ltx_noindent">
<p id="S3.p50.1" class="ltx_p">3.22.
<span id="S3.p50.1.1" class="ltx_text ltx_font_italic">“Fins” occur in all composite degrees.</span> 
This is not a peculiarity of <math id="S3.p50.m1" class="ltx_Math" alttext="d=4" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">d=4</annotation></semantics></math>; there is a similar story with “fins” in all non-prime degrees. (This should be seen as analogous to the fact that Malle’s conjecture guesses that there are many field extensions with Galois group not <math id="S3.p50.m2" class="ltx_Math" alttext="S_{d}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>d</mi></msub><annotation encoding="application/x-tex">S_{d}</annotation></semantics></math> when <math id="S3.p50.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is composite).</p>
</div>
<div id="S3.p51" class="ltx_para">
<p id="S3.p51.1" class="ltx_p">The key ideas are visible in the case <math id="S3.p51.m1" class="ltx_Math" alttext="d=6" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">d=6</annotation></semantics></math>. Define</p>
</div>
<div id="S3.p52" class="ltx_para">
<table id="S3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex9.m1" class="ltx_math_unparsed" alttext="Q_{3}:=\left.\begin{cases}(\overline{e}_{1},\dots,\overline{e}_{5})\;:\;\sum\overline{e}_{i}=1,\;0\leq\overline{e}_{1}\leq\cdots\leq\overline{e}_{5},\text{ and }\\
\overline{e}_{2}\leq 2\overline{e}_{1},\;\overline{e}_{4}\leq\overline{e}_{3}+\overline{e}_{1},\;\overline{e}_{5}\leq\overline{e}_{3}+\overline{e}_{2},\;\text{ and }\overline{e}_{5}\leq\overline{e}_{1}+\overline{e}_{4}\end{cases}\right\}\subset\mathbb{R}^{5}." display="block" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>3</mn></msub><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mn>5</mn></msub><mo rspace="0.558em" stretchy="false">)</mo><mo rspace="0.558em">:</mo><mstyle displaystyle="false"><mo>∑</mo></mstyle><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo>,</mo><mn> 0</mn><mo>≤</mo><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo rspace="0.1389em">≤</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≤</mo><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mn>5</mn></msub><mo>,</mo><mtext> and </mtext></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>4</mn></msub><mo>≤</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>+</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>5</mn></msub><mo>≤</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>+</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>5</mn></msub></mrow><mo>≤</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>+</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>4</mn></msub></mrow></mrow></mrow></mtd><mtd></mtd></mtr></mtable></mrow><mo>}</mo><mo>⊂</mo><msup><mi>ℝ</mi><mn>5</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{3}:=\left.\begin{cases}(\overline{e}_{1},\dots,\overline{e}_{5})\;:\;\sum\overline{e}_{i}=1,\;0\leq\overline{e}_{1}\leq\cdots\leq\overline{e}_{5},\text{ and }\\
\overline{e}_{2}\leq 2\overline{e}_{1},\;\overline{e}_{4}\leq\overline{e}_{3}+\overline{e}_{1},\;\overline{e}_{5}\leq\overline{e}_{3}+\overline{e}_{2},\;\text{ and }\overline{e}_{5}\leq\overline{e}_{1}+\overline{e}_{4}\end{cases}\right\}\subset\mathbb{R}^{5}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.p53" class="ltx_para">
<table id="S3.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex10.m1" class="ltx_math_unparsed" alttext="Q_{2}:=\left.\begin{cases}(\overline{e}_{1},\dots,\overline{e}_{5})\;:\;\sum\overline{e}_{i}=1,\;0\leq\overline{e}_{1}\leq\cdots\leq\overline{e}_{5},\text{ and }\\
\overline{e}_{3}\leq\overline{e}_{1}+\overline{e}_{2},\;\overline{e}_{4}\leq 2\overline{e}_{2},\;\overline{e}_{5}\leq\overline{e}_{3}+\overline{e}_{2},\;\text{ and }\overline{e}_{5}\leq\overline{e}_{1}+\overline{e}_{4}\end{cases}\right\}\subset\mathbb{R}^{5}." display="block" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>2</mn></msub><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mn>5</mn></msub><mo rspace="0.558em" stretchy="false">)</mo><mo rspace="0.558em">:</mo><mstyle displaystyle="false"><mo>∑</mo></mstyle><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo>,</mo><mn> 0</mn><mo>≤</mo><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo rspace="0.1389em">≤</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≤</mo><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mn>5</mn></msub><mo>,</mo><mtext> and </mtext></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>≤</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>+</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>4</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>5</mn></msub><mo>≤</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>+</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>5</mn></msub></mrow><mo>≤</mo><mrow><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>+</mo><msub><mover accent="true"><mi>e</mi><mo stretchy="true">¯</mo></mover><mn>4</mn></msub></mrow></mrow></mrow></mtd><mtd></mtd></mtr></mtable></mrow><mo>}</mo><mo>⊂</mo><msup><mi>ℝ</mi><mn>5</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{2}:=\left.\begin{cases}(\overline{e}_{1},\dots,\overline{e}_{5})\;:\;\sum\overline{e}_{i}=1,\;0\leq\overline{e}_{1}\leq\cdots\leq\overline{e}_{5},\text{ and }\\
\overline{e}_{3}\leq\overline{e}_{1}+\overline{e}_{2},\;\overline{e}_{4}\leq 2\overline{e}_{2},\;\overline{e}_{5}\leq\overline{e}_{3}+\overline{e}_{2},\;\text{ and }\overline{e}_{5}\leq\overline{e}_{1}+\overline{e}_{4}\end{cases}\right\}\subset\mathbb{R}^{5}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.p54" class="ltx_para">
<p id="S3.p54.1" class="ltx_p">A suitable generalization of Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> shows that the scrollar invariants of a sextic curve lie in <math id="S3.p54.m1" class="ltx_Math" alttext="Q_{3}\cup Q_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>3</mn></msub><mo>∪</mo><msub><mi>Q</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">Q_{3}\cup Q_{2}</annotation></semantics></math>; moreover it is not hard to check that <math id="S3.p54.m2" class="ltx_Math" alttext="Q_{3}\cap Q_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>3</mn></msub><mo>∩</mo><msub><mi>Q</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">Q_{3}\cap Q_{2}</annotation></semantics></math> is precisely <math id="S3.p54.m3" class="ltx_Math" alttext="\mathcal{P}_{6}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{6}</annotation></semantics></math>. (For a proof, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx35" title="" class="ltx_ref">Ve2</a>, Thm. 1.26]</cite>). One might conjecture that the possible scrollar invariants of sextic curves are precisely those that (appropriately scaled) lie in <math id="S3.p54.m4" class="ltx_Math" alttext="Q_{2}\cup Q_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>2</mn></msub><mo>∪</mo><msub><mi>Q</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">Q_{2}\cup Q_{3}</annotation></semantics></math>, but this is not necessary for the discussion here.</p>
</div>
<div id="S3.p55" class="ltx_para ltx_noindent">
<p id="S3.p55.1" class="ltx_p">3.23.
<span id="S3.p55.1.1" class="ltx_text ltx_font_bold">Proposition. —</span>   <span id="S3.p55.1.2" class="ltx_text ltx_font_italic">If <math id="S3.p55.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is a sextic cover whose scrollar invariants lie in <math id="S3.p55.m2" class="ltx_Math" alttext="Q_{2}\smallsetminus\mathcal{P}_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>2</mn></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">Q_{2}\smallsetminus\mathcal{P}_{6}</annotation></semantics></math>, then <math id="S3.p55.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> factors through a distinguished double cover with scrollar invariant <math id="S3.p55.m4" class="ltx_Math" alttext="e_{1}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mn>1</mn></msub><annotation encoding="application/x-tex">e_{1}</annotation></semantics></math>. Similarly, if <math id="S3.p55.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is a sextic cover whose scrollar invariants lie in <math id="S3.p55.m6" class="ltx_Math" alttext="Q_{3}\smallsetminus\mathcal{P}_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>3</mn></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">Q_{3}\smallsetminus\mathcal{P}_{6}</annotation></semantics></math>, then <math id="S3.p55.m7" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> factors through a distinguished triple cover whose scrollar invariants are <math id="S3.p55.m8" class="ltx_Math" alttext="(e_{1},e_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e_{1},e_{2})</annotation></semantics></math>.
</span></p>
</div>
<div id="S3.p56" class="ltx_para ltx_noindent">
<p id="S3.p56.1" class="ltx_p"><span id="S3.p56.1.1" class="ltx_text ltx_font_italic">Proof. </span>Consider the multiplication map <math id="S3.p56.m1" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}\otimes\pi_{*}{\mathscr{O}}_{C}\rightarrow\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>π</mi><mo>∗</mo></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}\otimes\pi_{*}{\mathscr{O}}_{C}\rightarrow\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math> and fix a splitting of <math id="S3.p56.m2" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math>. Let <math id="S3.p56.m3" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math> be the subbundle <math id="S3.p56.m4" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})</annotation></semantics></math>. If <math id="S3.p56.m5" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math> is a quadratic <math id="S3.p56.m6" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-subalgebra of <math id="S3.p56.m7" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math>, then <math id="S3.p56.m8" class="ltx_Math" alttext="C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> factors through the hyperelliptic curve <math id="S3.p56.m9" class="ltx_Math" alttext="\underline{\operatorname{Spec}}\;{\mathscr{A}}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>Spec</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.447em" rspace="0em">​</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow><annotation encoding="application/x-tex">\underline{\operatorname{Spec}}\;{\mathscr{A}}</annotation></semantics></math>, which visibly has scrollar invariant <math id="S3.p56.m10" class="ltx_Math" alttext="e_{1}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mn>1</mn></msub><annotation encoding="application/x-tex">e_{1}</annotation></semantics></math>.</p>
</div>
<div id="S3.p57" class="ltx_para">
<p id="S3.p57.1" class="ltx_p">If <math id="S3.p57.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> has scrollar invariants lying in <math id="S3.p57.m2" class="ltx_Math" alttext="Q_{2}\smallsetminus\mathcal{P}_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>2</mn></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">Q_{2}\smallsetminus\mathcal{P}_{6}</annotation></semantics></math>, then <math id="S3.p57.m3" class="ltx_Math" alttext="e_{2}&gt;2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{2}&gt;2e_{1}</annotation></semantics></math> or <math id="S3.p57.m4" class="ltx_Math" alttext="e_{4}&gt;e_{1}+e_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>4</mn></msub><mo>&gt;</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{4}&gt;e_{1}+e_{3}</annotation></semantics></math>. If <math id="S3.p57.m5" class="ltx_Math" alttext="e_{2}&gt;2e_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{2}&gt;2e_{1}</annotation></semantics></math>, then the image of <math id="S3.p57.m6" class="ltx_Math" alttext="{\mathscr{A}}\otimes{\mathscr{A}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow><annotation encoding="application/x-tex">{\mathscr{A}}\otimes{\mathscr{A}}</annotation></semantics></math> under the multiplication map lies in <math id="S3.p57.m7" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math> so <math id="S3.p57.m8" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math> is a quadratic <math id="S3.p57.m9" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-subalgebra of <math id="S3.p57.m10" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math>. If <math id="S3.p57.m11" class="ltx_Math" alttext="e_{4}&gt;e_{1}+e_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>4</mn></msub><mo>&gt;</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{4}&gt;e_{1}+e_{3}</annotation></semantics></math>, let <math id="S3.p57.m12" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> be the subbundle <math id="S3.p57.m13" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}\oplus\dots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{3})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mi mathvariant="normal">⋯</mi><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}\oplus\dots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{3})</annotation></semantics></math>. Then the image of <math id="S3.p57.m14" class="ltx_Math" alttext="{\mathscr{A}}\otimes\mathcal{B}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow><annotation encoding="application/x-tex">{\mathscr{A}}\otimes\mathcal{B}</annotation></semantics></math> lies in <math id="S3.p57.m15" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math>, so <math id="S3.p57.m16" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math> is a quadratic <math id="S3.p57.m17" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-subalgebra of <math id="S3.p57.m18" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math>, as required.</p>
</div>
<div id="S3.p58" class="ltx_para">
<p id="S3.p58.1" class="ltx_p">If <math id="S3.p58.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> has scrollar invariants lying in <math id="S3.p58.m2" class="ltx_Math" alttext="Q_{3}\smallsetminus\mathcal{P}_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>3</mn></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">Q_{3}\smallsetminus\mathcal{P}_{6}</annotation></semantics></math>, then <math id="S3.p58.m3" class="ltx_Math" alttext="e_{3}&gt;e_{1}+e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>3</mn></msub><mo>&gt;</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{3}&gt;e_{1}+e_{2}</annotation></semantics></math> or <math id="S3.p58.m4" class="ltx_Math" alttext="e_{4}&gt;2e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>4</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{4}&gt;2e_{2}</annotation></semantics></math>. In the first case, letting <math id="S3.p58.m5" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math> be the subbundle as above and letting <math id="S3.p58.m6" class="ltx_Math" alttext="\mathcal{C}={\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}={\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{2})</annotation></semantics></math>, we have that the image of <math id="S3.p58.m7" class="ltx_Math" alttext="{\mathscr{A}}\otimes\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">{\mathscr{A}}\otimes\mathcal{C}</annotation></semantics></math> lies in <math id="S3.p58.m8" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math>, and therefore <math id="S3.p58.m9" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> is a cubic <math id="S3.p58.m10" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebra. If <math id="S3.p58.m11" class="ltx_Math" alttext="e_{4}&gt;2e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>4</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{4}&gt;2e_{2}</annotation></semantics></math>, then letting <math id="S3.p58.m12" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> be as above, we see that the image of <math id="S3.p58.m13" class="ltx_Math" alttext="\mathcal{C}\otimes\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\mathcal{C}\otimes\mathcal{C}</annotation></semantics></math> lies in <math id="S3.p58.m14" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math>, so <math id="S3.p58.m15" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> is a cubic <math id="S3.p58.m16" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebra as required. (See Lemma <a href="#S4" title="4. Scrollar invariants of primitive covers lie in the polytope 
        
          
            
            P
            d ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> for more details.)
∎</p>
</div>
<div id="S3.p59" class="ltx_para">
<p id="S3.p59.1" class="ltx_p">Let <math id="S3.p59.m1" class="ltx_Math" alttext="\rho^{geo}" display="inline" intent=":literal"><semantics><msup><mi>ρ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msup><annotation encoding="application/x-tex">\rho^{geo}</annotation></semantics></math> be the (conjectural) density function constructed in §<a href="#S8" title="8. Motivation and analogy from number theory ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. It is conjecturally (Conjecture <a href="#S8" title="8. Motivation and analogy from number theory ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) a piecewise linear function supported on a polytope, and we expect that its support will be <math id="S3.p59.m2" class="ltx_Math" alttext="Q_{3}\cup Q_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>3</mn></msub><mo>∪</mo><msub><mi>Q</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">Q_{3}\cup Q_{2}</annotation></semantics></math>. Because a general sextic cover has balanced scrollar invariants (i.e. <math id="S3.p59.m3" class="ltx_Math" alttext="e_{5}-e_{1}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mn>5</mn></msub><mo>−</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e_{5}-e_{1}\leq 1</annotation></semantics></math>), we expect that <math id="S3.p59.m4" class="ltx_Math" alttext="\rho^{geo}(1/5,\dots,1/5)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ρ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mn>5</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>5</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho^{geo}(1/5,\dots,1/5)=1</annotation></semantics></math>. (And this is indeed the analogue of the observation that the “bulk” of quartic covers lie on the “balanced” vertex).</p>
</div>
<div id="S3.p60" class="ltx_para">
<p id="S3.p60.1" class="ltx_p">Upon fixing a genus <math id="S3.p60.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>, each possible value of <math id="S3.p60.m2" class="ltx_Math" alttext="e_{1}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mn>1</mn></msub><annotation encoding="application/x-tex">e_{1}</annotation></semantics></math> gives rise to a <math id="S3.p60.m3" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-dimensional polytope in <math id="S3.p60.m4" class="ltx_Math" alttext="Q_{2}\smallsetminus\mathcal{P}_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>2</mn></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">Q_{2}\smallsetminus\mathcal{P}_{6}</annotation></semantics></math>. We now consider the dimension of the moduli space of sextic covers factoring through double covers with scrollar invariant <math id="S3.p60.m5" class="ltx_Math" alttext="e_{1}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mn>1</mn></msub><annotation encoding="application/x-tex">e_{1}</annotation></semantics></math>. A short calculation shows that this dimension is largest precisely when <math id="S3.p60.m6" class="ltx_Math" alttext="e_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e_{1}=1</annotation></semantics></math>, and indeed the dimension of that moduli space is <math id="S3.p60.m7" class="ltx_Math" alttext="2g+3" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2g+3</annotation></semantics></math>. A general such curve has scrollar invariants <math id="S3.p60.m8" class="ltx_Math" alttext="(1,e_{2},\dots,e_{5})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,e_{2},\dots,e_{5})</annotation></semantics></math> where <math id="S3.p60.m9" class="ltx_Math" alttext="e_{5}-e_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mn>5</mn></msub><mo>−</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e_{5}-e_{2}\leq 1</annotation></semantics></math>.</p>
</div>
<div id="S3.p61" class="ltx_para">
<p id="S3.p61.1" class="ltx_p">Similarly, each possible value of <math id="S3.p61.m1" class="ltx_Math" alttext="e_{1},e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">e_{1},e_{2}</annotation></semantics></math> gives rise to a <math id="S3.p61.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-dimensional polytope in <math id="S3.p61.m3" class="ltx_Math" alttext="Q_{3}\smallsetminus\mathcal{P}_{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>3</mn></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>6</mn></msub></mrow><annotation encoding="application/x-tex">Q_{3}\smallsetminus\mathcal{P}_{6}</annotation></semantics></math>. The dimension of the moduli space of sextic covers factoring through triple covers with scrollar invariants <math id="S3.p61.m4" class="ltx_Math" alttext="e_{1},e_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">e_{1},e_{2}</annotation></semantics></math> is largest when <math id="S3.p61.m5" class="ltx_Math" alttext="e_{1}=e_{2}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>=</mo><msub><mi>e</mi><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e_{1}=e_{2}=1</annotation></semantics></math>, and in this case the dimension is also <math id="S3.p61.m6" class="ltx_Math" alttext="2g+3" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2g+3</annotation></semantics></math>. A general such curve has scrollar invariants <math id="S3.p61.m7" class="ltx_Math" alttext="(1,1,e_{3},e_{4},e_{5})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub><mo>,</mo><msub><mi>e</mi><mn>4</mn></msub><mo>,</mo><msub><mi>e</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1,e_{3},e_{4},e_{5})</annotation></semantics></math> where <math id="S3.p61.m8" class="ltx_Math" alttext="e_{5}-e_{3}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mn>5</mn></msub><mo>−</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e_{5}-e_{3}\leq 1</annotation></semantics></math>.</p>
</div>
<div id="S3.p62" class="ltx_para">
<p id="S3.p62.1" class="ltx_p">The dimension of the moduli space of sextic covers is <math id="S3.p62.m1" class="ltx_Math" alttext="2g+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">2g+7</annotation></semantics></math>. Because the difference in dimensions <math id="S3.p62.m2" class="ltx_Math" alttext="(2g+7)-(2g+3)=4" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>7</mn></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">(2g+7)-(2g+3)=4</annotation></semantics></math> is a constant, we have that if the density function <math id="S3.p62.m3" class="ltx_Math" alttext="\rho^{geo}" display="inline" intent=":literal"><semantics><msup><mi>ρ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msup><annotation encoding="application/x-tex">\rho^{geo}</annotation></semantics></math> is defined on the points <math id="S3.p62.m4" class="ltx_Math" alttext="(0,1/4,1/4,1/4,1/4)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1/4,1/4,1/4,1/4)</annotation></semantics></math> and <math id="S3.p62.m5" class="ltx_Math" alttext="(0,0,1/3,1/3,1/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0,1/3,1/3,1/3)</annotation></semantics></math>, then the density function achieves its maximum value of <math id="S3.p62.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> on these points.</p>
</div>
<div id="S3.p63" class="ltx_para">
<p id="S3.p63.1" class="ltx_p">In general composite degree <math id="S3.p63.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, the “fin” points will be of the form <math id="S3.p63.m2" class="ltx_Math" alttext="(0,\dots,0,1/(d-k),\dots,1/(d-k))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,\dots,0,1/(d-k),\dots,1/(d-k))</annotation></semantics></math> for each nontrivial proper divisor <math id="S3.p63.m3" class="ltx_Math" alttext="k\mid d" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo fence="false">|</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">k\mid d</annotation></semantics></math>. They are attained by covers of the form <math id="S3.p63.m4" class="ltx_Math" alttext="C\rightarrow\mathbb{P}^{1}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C\rightarrow\mathbb{P}^{1}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> where the first map has degree <math id="S3.p63.m5" class="ltx_Math" alttext="d/k" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>/</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">d/k</annotation></semantics></math> and the map <math id="S3.p63.m6" class="ltx_Math" alttext="\mathbb{P}^{1}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{P}^{1}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> has degree <math id="S3.p63.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Scrollar invariants of primitive covers lie in the polytope <math id="S4.m1" class="ltx_Math" alttext="\mathcal{P}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{d}</annotation></semantics></math></h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">We now prove Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.
Our argument should be interpreted as an adaptation of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx34" title="" class="ltx_ref">Ve1</a>, Thm. 1.1.8]</cite> (see also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx34" title="" class="ltx_ref">Ve1</a>, §2.2]</cite>) to a geometric context.</p>
</div>
<div id="S4.p2" class="ltx_para ltx_noindent">
<p id="S4.p2.1" class="ltx_p">4.1.
<span id="S4.p2.1.1" class="ltx_text ltx_font_italic">Observation.</span> 
Consider the <math id="S4.p2.m1" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebra structure on the vector bundle <math id="S4.p2.m2" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}={\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{d-1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}={\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{d-1})</annotation></semantics></math> (<a href="#S1.E3" title="In 1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>). By convention we take <math id="S4.p2.m3" class="ltx_Math" alttext="e_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e_{0}=0</annotation></semantics></math>, and call the “<math id="S4.p2.m4" class="ltx_Math" alttext="{\mathscr{O}}(-e_{i})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{O}}(-e_{i})</annotation></semantics></math>” summand the <math id="S4.p2.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th summand. Under the product structure in this sheaf of algebras, the product of the <math id="S4.p2.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th summand and the <math id="S4.p2.m7" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>th summand, decomposed again into summands, must be zero in any summand <math id="S4.p2.m8" class="ltx_Math" alttext="{\mathscr{O}}(-e_{k})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{O}}(-e_{k})</annotation></semantics></math> where <math id="S4.p2.m9" class="ltx_Math" alttext="e_{k}&gt;e_{i}+e_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>k</mi></msub><mo>&gt;</mo><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">e_{k}&gt;e_{i}+e_{j}</annotation></semantics></math>, as <math id="S4.p2.m10" class="ltx_Math" alttext="\operatorname{Hom}({\mathscr{O}}(-e_{i})\otimes{\mathscr{O}}(-e_{j}),{\mathscr{O}}(-e_{k}))=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{Hom}({\mathscr{O}}(-e_{i})\otimes{\mathscr{O}}(-e_{j}),{\mathscr{O}}(-e_{k}))=0</annotation></semantics></math> in that case.</p>
</div>
<div id="S4.p3" class="ltx_para ltx_noindent">
<p id="S4.p3.1" class="ltx_p">4.2. 
Choose a point <math id="S4.p3.m1" class="ltx_Math" alttext="\infty\in\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">∞</mi><mo>∈</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\infty\in\mathbb{P}^{1}</annotation></semantics></math>, and choose a coordinate <math id="S4.p3.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> on <math id="S4.p3.m3" class="ltx_Math" alttext="\mathbb{A}^{1}=\mathbb{P}^{1}\setminus\{\infty\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔸</mi><mn>1</mn></msup><mo>=</mo><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{A}^{1}=\mathbb{P}^{1}\setminus\{\infty\}</annotation></semantics></math>, i.e., an isomorphism <math id="S4.p3.m4" class="ltx_Math" alttext="\mathbb{P}^{1}\setminus\{\infty\}\cong\operatorname{Spec}\mathbb{C}[t]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">}</mo></mrow></mrow><mo>≅</mo><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}^{1}\setminus\{\infty\}\cong\operatorname{Spec}\mathbb{C}[t]</annotation></semantics></math>. Then the splitting <math id="S4.p3.m5" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}={\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{d-1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}={\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{d-1})</annotation></semantics></math>
induces a splitting of the <math id="S4.p3.m6" class="ltx_Math" alttext="\mathbb{C}[t]" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{C}[t]</annotation></semantics></math>-algebra
<math id="S4.p3.m7" class="ltx_Math" alttext="\Gamma(\mathbb{A}^{1},\pi_{*}({\mathscr{O}}_{C}))" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔸</mi><mn>1</mn></msup><mo>,</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Gamma(\mathbb{A}^{1},\pi_{*}({\mathscr{O}}_{C}))</annotation></semantics></math> into
<math id="S4.p3.m8" class="ltx_Math" alttext="\Gamma(\mathbb{A}^{1},\pi_{*}({\mathscr{O}}_{C}))=\mathbb{C}[t]\oplus\mathbb{C}[t]x_{1}\oplus\cdots\oplus\mathbb{C}[t]x_{d-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔸</mi><mn>1</mn></msup><mo>,</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo>⊕</mo><mrow><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mrow><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma(\mathbb{A}^{1},\pi_{*}({\mathscr{O}}_{C}))=\mathbb{C}[t]\oplus\mathbb{C}[t]x_{1}\oplus\cdots\oplus\mathbb{C}[t]x_{d-1}</annotation></semantics></math>
(as a <math id="S4.p3.m9" class="ltx_Math" alttext="\mathbb{C}[t]" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{C}[t]</annotation></semantics></math>-module); here we have chosen a generator <math id="S4.p3.m10" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> of the <math id="S4.p3.m11" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th summand of
<math id="S4.p3.m12" class="ltx_Math" alttext="\Gamma(\mathbb{A}^{1},\pi_{*}({\mathscr{O}}_{C}))" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔸</mi><mn>1</mn></msup><mo>,</mo><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Gamma(\mathbb{A}^{1},\pi_{*}({\mathscr{O}}_{C}))</annotation></semantics></math>.
Considered as a rational section of <math id="S4.p3.m13" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math>, <math id="S4.p3.m14" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> has a pole at <math id="S4.p3.m15" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math> of order <math id="S4.p3.m16" class="ltx_Math" alttext="e_{i}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mi>i</mi></msub><annotation encoding="application/x-tex">e_{i}</annotation></semantics></math>.
Now <math id="S4.p3.m17" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, <math id="S4.p3.m18" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math>, …, <math id="S4.p3.m19" class="ltx_Math" alttext="x_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">x_{d-1}</annotation></semantics></math> are a basis for <math id="S4.p3.m20" class="ltx_Math" alttext="K(C)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(C)</annotation></semantics></math> as a <math id="S4.p3.m21" class="ltx_Math" alttext="K(\mathbb{P}^{1})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(\mathbb{P}^{1})</annotation></semantics></math>-module (where <math id="S4.p3.m22" class="ltx_Math" alttext="K(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(\cdot)</annotation></semantics></math> indicates the function field).</p>
</div>
<div id="S4.p4" class="ltx_para ltx_noindent">
<p id="S4.p4.1" class="ltx_p">4.3. We now recall a beautiful result of
Hou, Leung and Xiang <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx25" title="" class="ltx_ref">HoLX</a>]</cite>, which is a field-theoretic analogue of Kneser’s theorem in additive combinatorics. (<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">BacSZ</a>]</cite> generalized the result, but we do not need that version here.)</p>
</div>
<div id="S4.p5" class="ltx_para">
<p id="S4.p5.1" class="ltx_p">Suppose <math id="S4.p5.m1" class="ltx_Math" alttext="L/K" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">L/K</annotation></semantics></math> is a finite degree field extension of characteristic zero fields. (We won’t need this fact, but we remark that the results stated here in fact hold over any field, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">BacSZ</a>]</cite>.) Suppose that <math id="S4.p5.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="S4.p5.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> are two nonzero <math id="S4.p5.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-subvector spaces of <math id="S4.p5.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. Let <math id="S4.p5.m6" class="ltx_Math" alttext="AB" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">AB</annotation></semantics></math> be the <math id="S4.p5.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-vector space spanned by elements of the form <math id="S4.p5.m8" class="ltx_Math" alttext="ab" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">ab</annotation></semantics></math> for <math id="S4.p5.m9" class="ltx_Math" alttext="a\in A" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">a\in A</annotation></semantics></math> and <math id="S4.p5.m10" class="ltx_Math" alttext="b\in B" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">b\in B</annotation></semantics></math>. Given <math id="S4.p5.m11" class="ltx_Math" alttext="\dim_{K}A" display="inline" intent=":literal"><semantics><mrow><msub><mo>dim</mo><mi>K</mi></msub><mi>A</mi></mrow><annotation encoding="application/x-tex">\dim_{K}A</annotation></semantics></math> and <math id="S4.p5.m12" class="ltx_Math" alttext="\dim_{K}B" display="inline" intent=":literal"><semantics><mrow><msub><mo>dim</mo><mi>K</mi></msub><mi>B</mi></mrow><annotation encoding="application/x-tex">\dim_{K}B</annotation></semantics></math>, Hou-Leung-Xiang give a lower bound on <math id="S4.p5.m13" class="ltx_Math" alttext="\dim_{K}AB" display="inline" intent=":literal"><semantics><mrow><msub><mo>dim</mo><mi>K</mi></msub><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\dim_{K}AB</annotation></semantics></math>, which we now describe.</p>
</div>
<div id="S4.p6" class="ltx_para">
<p id="S4.p6.1" class="ltx_p">Define <math id="S4.p6.m1" class="ltx_Math" alttext="\operatorname{Stab}(AB)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Stab}(AB)</annotation></semantics></math> to be the set of elements in <math id="S4.p6.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> stabilizing <math id="S4.p6.m3" class="ltx_Math" alttext="AB" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">AB</annotation></semantics></math> when acting by multiplication in the field:</p>
<table id="S4.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex11.m1" class="ltx_Math" alttext="\operatorname{Stab}(AB):=\{x\in L:x(AB)\subset AB\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>∈</mo><mi>L</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Stab}(AB):=\{x\in L:x(AB)\subset AB\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p6.2" class="ltx_p">Notice that <math id="S4.p6.m4" class="ltx_Math" alttext="\operatorname{Stab}(AB)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Stab}(AB)</annotation></semantics></math> is an intermediate field extension of <math id="S4.p6.m5" class="ltx_Math" alttext="L/K" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">L/K</annotation></semantics></math>: it contains <math id="S4.p6.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, and is clearly closed under field operations (where defined).</p>
</div>
<div id="S4.p7" class="ltx_para ltx_noindent">
<p id="S4.p7.1" class="ltx_p">4.4.
<span id="S4.p7.1.1" class="ltx_text ltx_font_bold">Lemma <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx25" title="" class="ltx_ref">HoLX</a>, Thm. 2.4]</cite>. —</span>  <span id="S4.p7.1.2" class="ltx_text ltx_font_italic">We have</span></p>
<table id="S4.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex12.m1" class="ltx_Math" alttext="\dim_{K}AB\geq\dim_{K}A+\dim_{K}B-\dim_{K}\operatorname{Stab}(AB)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>dim</mo><mi>K</mi></msub><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo rspace="0.1389em">≥</mo><mrow><mrow><mrow><msub><mo lspace="0.1389em" rspace="0.167em">dim</mo><mi>K</mi></msub><mi>A</mi></mrow><mo>+</mo><mrow><msub><mo lspace="0em" rspace="0.167em">dim</mo><mi>K</mi></msub><mi>B</mi></mrow></mrow><mo>−</mo><mrow><msub><mo lspace="0em" rspace="0.167em">dim</mo><mi>K</mi></msub><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dim_{K}AB\geq\dim_{K}A+\dim_{K}B-\dim_{K}\operatorname{Stab}(AB).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.p8" class="ltx_para ltx_noindent">
<p id="S4.p8.1" class="ltx_p">4.5.
<span id="S4.p8.1.1" class="ltx_text ltx_font_italic">Proof of Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</span> 
Suppose otherwise that there are <math id="S4.p8.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="S4.p8.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> such that <math id="S4.p8.m3" class="ltx_Math" alttext="e_{i+j}&gt;e_{i}+e_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow></msub><mo>&gt;</mo><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">e_{i+j}&gt;e_{i}+e_{j}</annotation></semantics></math>. In Lemma <a href="#S4" title="4. Scrollar invariants of primitive covers lie in the polytope 
        
          
            
            P
            d ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, let <math id="S4.p8.m4" class="ltx_Math" alttext="K=K(\mathbb{P}^{1})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K=K(\mathbb{P}^{1})</annotation></semantics></math>, let <math id="S4.p8.m5" class="ltx_Math" alttext="L=K(C)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L=K(C)</annotation></semantics></math>, let <math id="S4.p8.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> be the <math id="S4.p8.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-subvector space of <math id="S4.p8.m8" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> generated by <math id="S4.p8.m9" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, <math id="S4.p8.m10" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math>, …, <math id="S4.p8.m11" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>, and let <math id="S4.p8.m12" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> be the <math id="S4.p8.m13" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-subvector space generated by <math id="S4.p8.m14" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, <math id="S4.p8.m15" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math>, …, <math id="S4.p8.m16" class="ltx_Math" alttext="x_{j}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>j</mi></msub><annotation encoding="application/x-tex">x_{j}</annotation></semantics></math>. From Observation <a href="#S4" title="4. Scrollar invariants of primitive covers lie in the polytope 
        
          
            
            P
            d ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, <math id="S4.p8.m17" class="ltx_Math" alttext="AB" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">AB</annotation></semantics></math> is contained in the <math id="S4.p8.m18" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-subvector space generated by <math id="S4.p8.m19" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, <math id="S4.p8.m20" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math>, …, <math id="S4.p8.m21" class="ltx_Math" alttext="x_{i+j-1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">x_{i+j-1}</annotation></semantics></math>, so by Lemma <a href="#S4" title="4. Scrollar invariants of primitive covers lie in the polytope 
        
          
            
            P
            d ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> we have</p>
<table id="S4.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex13.m1" class="ltx_Math" alttext="i+j\geq(i+1)+(j+1)-\dim_{K}\operatorname{Stab}(AB)" display="block" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>≥</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mo lspace="0em" rspace="0.167em">dim</mo><mi>K</mi></msub><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">i+j\geq(i+1)+(j+1)-\dim_{K}\operatorname{Stab}(AB)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p8.2" class="ltx_p">from which <math id="S4.p8.m22" class="ltx_Math" alttext="\dim_{K}\operatorname{Stab}(AB)\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>dim</mo><mi>K</mi></msub><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\dim_{K}\operatorname{Stab}(AB)\geq 2</annotation></semantics></math>. Because <math id="S4.p8.m23" class="ltx_Math" alttext="\operatorname{Stab}(AB)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Stab}(AB)</annotation></semantics></math> is an intermediate field of <math id="S4.p8.m24" class="ltx_Math" alttext="L/K" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>/</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">L/K</annotation></semantics></math>, strictly containing <math id="S4.p8.m25" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, and by the primitivity hypothesis, there are no strictly intermediate fields, we must have <math id="S4.p8.m26" class="ltx_Math" alttext="\operatorname{Stab}(AB)=L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\operatorname{Stab}(AB)=L</annotation></semantics></math>, from which <math id="S4.p8.m27" class="ltx_Math" alttext="AB=L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>=</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">AB=L</annotation></semantics></math>, contradicting the fact that <math id="S4.p8.m28" class="ltx_Math" alttext="AB" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">AB</annotation></semantics></math> is contained in the vector subspace of <math id="S4.p8.m29" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> generated by <math id="S4.p8.m30" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, <math id="S4.p8.m31" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math>, …, <math id="S4.p8.m32" class="ltx_Math" alttext="x_{i+j-1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">x_{i+j-1}</annotation></semantics></math>. ∎</p>
</div>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5. </span>The possible scrollar invariants do not form a convex set if <math id="S5.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is not a prime power</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">(This section does not rely on the results of §<a href="#S4" title="4. Scrollar invariants of primitive covers lie in the polytope 
        
          
            
            P
            d ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. It is only placed here because of where it is in the narrative of the introduction.)</p>
</div>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p">In this section, we show that if <math id="S5.p2.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is not a prime power, then the possible scrollar invariants do not form a convex set for infinitely many <math id="S5.p2.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>. With some care this argument should be modifiable to show the result for all <math id="S5.p2.m3" class="ltx_math_unparsed" alttext="g\gg_{d}1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≫</mo><msub><mrow></mrow><mi>d</mi></msub><mn>1</mn></mrow><annotation encoding="application/x-tex">g\gg_{d}1</annotation></semantics></math> (for <math id="S5.p2.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> not a prime power), but it did not seem worth the trouble. For small <math id="S5.p2.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>, nonconvexity could plausibly “accidentally” fail because of the paucity of integer points. The argument is a bit intricate, so for the sake of comprehensibility, we first give a concrete example for <math id="S5.p2.m6" class="ltx_Math" alttext="d=6" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">d=6</annotation></semantics></math>, then give the case when <math id="S5.p2.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is the product of two distinct primes, and finally give the general argument.</p>
</div>
<div id="S5.p3" class="ltx_para ltx_noindent">
<p id="S5.p3.1" class="ltx_p">5.1.
<span id="S5.p3.1.1" class="ltx_text ltx_font_bold">The case <math id="S5.p3.m1" class="ltx_Math" alttext="d=6" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">d=6</annotation></semantics></math>.</span> 
Our strategy is as follows. We will construct two sextic covers <math id="S5.p3.m2" class="ltx_Math" alttext="\pi:C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi:C\rightarrow\mathbb{P}^{1}</annotation></semantics></math>, both by genus <math id="S5.p3.m3" class="ltx_Math" alttext="g=994" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>994</mn></mrow><annotation encoding="application/x-tex">g=994</annotation></semantics></math> curves, which have scrollar invariants <math id="S5.p3.m4" class="ltx_Math" alttext="(1,166,167,332,333)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1,166,167,332,333</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,166,167,332,333)</annotation></semantics></math> and <math id="S5.p3.m5" class="ltx_Math" alttext="(1,2,331,332,333)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>331</mn><mo>,</mo><mn>332</mn><mo>,</mo><mn>333</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,2,331,332,333)</annotation></semantics></math> respectively. We then show that there can be no such cover with scrollar invariant <math id="S5.p3.m6" class="ltx_Math" alttext="(1,111,222,332,333)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1,111,222,332,333</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,111,222,332,333)</annotation></semantics></math>, which lies on the line segment joining the previous two points.</p>
</div>
<div id="S5.p4" class="ltx_para ltx_noindent">
<p id="S5.p4.1" class="ltx_p">5.2.
<span id="S5.p4.1.1" class="ltx_text ltx_font_italic">The two covers.</span> 
Each cover will be constructed as a compositum of a hyperelliptic (degree 2) and a cubic (degree 3) cover. In particular, these covers are not primitive, which is of course necessary given Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="S5.p5" class="ltx_para">
<p id="S5.p5.1" class="ltx_p">Choose a general homogeneous polynomial <math id="S5.p5.m1" class="ltx_Math" alttext="f(x,y)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(x,y)</annotation></semantics></math> of degree <math id="S5.p5.m2" class="ltx_Math" alttext="r_{2}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>2</mn></msub><annotation encoding="application/x-tex">r_{2}</annotation></semantics></math> (to be named later, where <math id="S5.p5.m3" class="ltx_Math" alttext="2|r_{2}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo fence="false">|</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">2|r_{2}</annotation></semantics></math>). Consider the hyperelliptic cover given by</p>
<table id="S5.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(11)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E11.m1" class="ltx_Math" alttext="z^{2}=f(x,y)," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>z</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">z^{2}=f(x,y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p5.2" class="ltx_p">say <math id="S5.p5.m4" class="ltx_Math" alttext="\pi_{2}:C_{2}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi_{2}:C_{2}\rightarrow\mathbb{P}^{1}</annotation></semantics></math>. Then <math id="S5.p5.m5" class="ltx_math_unparsed" alttext="(\pi_{2})_{*}{\mathscr{O}}_{C_{2}}\cong{\mathscr{O}}\oplus{\mathscr{O}}(-r_{2}/2)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mn>2</mn></msub></msub><mo>≅</mo><mi class="ltx_font_mathscript">𝒪</mi><mo>⊕</mo><mi class="ltx_font_mathscript">𝒪</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\pi_{2})_{*}{\mathscr{O}}_{C_{2}}\cong{\mathscr{O}}\oplus{\mathscr{O}}(-r_{2}/2)</annotation></semantics></math>, and indeed we should interpret the <math id="S5.p5.m6" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebra <math id="S5.p5.m7" class="ltx_Math" alttext="(\pi_{2})_{*}{\mathscr{O}}_{C_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">(\pi_{2})_{*}{\mathscr{O}}_{C_{2}}</annotation></semantics></math> as <math id="S5.p5.m8" class="ltx_math_unparsed" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mi>z</mi></mrow><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z</annotation></semantics></math>, with multiplication induced by the relation (<a href="#S5.E11" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>), i.e., multiplication in the <math id="S5.p5.m9" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebra</p>
<table id="S5.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex14.m1" class="ltx_math_unparsed" alttext="\left({\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z\right)\times\left({\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z\right)\rightarrow\left({\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z\right)" display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mi>z</mi><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>(</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mi>z</mi><mo>)</mo></mrow><mo stretchy="false">→</mo><mrow><mo>(</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mi>z</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\left({\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z\right)\times\left({\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z\right)\rightarrow\left({\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p5.3" class="ltx_p">is given by <math id="S5.p5.m10" class="ltx_Math" alttext="z\times z\rightarrow(f(x,y),0)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>z</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>z</mi></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">z\times z\rightarrow(f(x,y),0)</annotation></semantics></math>.</p>
</div>
<div id="S5.p6" class="ltx_para">
<p id="S5.p6.1" class="ltx_p">Similarly choose a general homogeneous polynomial <math id="S5.p6.m1" class="ltx_Math" alttext="g(x,y)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(x,y)</annotation></semantics></math> of degree <math id="S5.p6.m2" class="ltx_Math" alttext="r_{3}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>3</mn></msub><annotation encoding="application/x-tex">r_{3}</annotation></semantics></math> (to be named later, where <math id="S5.p6.m3" class="ltx_Math" alttext="3|r_{3}" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo fence="false">|</mo><msub><mi>r</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">3|r_{3}</annotation></semantics></math>). Consider the trigonal cover given by</p>
<table id="S5.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(12)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E12.m1" class="ltx_Math" alttext="w^{3}=g(x,y)," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>w</mi><mn>3</mn></msup><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">w^{3}=g(x,y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p6.2" class="ltx_p">say <math id="S5.p6.m4" class="ltx_Math" alttext="\pi_{3}:C_{3}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>3</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi_{3}:C_{3}\rightarrow\mathbb{P}^{1}</annotation></semantics></math>, so we similarly have an isomorphism of <math id="S5.p6.m5" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebras</p>
<table id="S5.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex15.m1" class="ltx_math_unparsed" alttext="(\pi_{3})_{*}{\mathscr{O}}_{C_{3}}\overset{\sim}{\longleftrightarrow}{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{3}/3)w\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2r_{3}/3)w^{2}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mn>3</mn></msub></msub><mover accent="true"><mo stretchy="false">⟷</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>3</mn></msub><mo>/</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mi>w</mi><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><msub><mi>r</mi><mn>3</mn></msub><mo>/</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><msup><mi>w</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">(\pi_{3})_{*}{\mathscr{O}}_{C_{3}}\overset{\sim}{\longleftrightarrow}{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{3}/3)w\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2r_{3}/3)w^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p6.3" class="ltx_p">with multiplication induced by the relation (<a href="#S5.E12" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).</p>
</div>
<div id="S5.p7" class="ltx_para">
<p id="S5.p7.1" class="ltx_p">Now consider the sextic cover <math id="S5.p7.m1" class="ltx_Math" alttext="\pi:C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi:C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> given by both (<a href="#S5.E11" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) and (<a href="#S5.E12" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) (i.e., the compositum), so we have an isomorphism of <math id="S5.p7.m2" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebras</p>
<table id="S5.EGx3" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S5.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex16.m1" class="ltx_Math" alttext="\displaystyle\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.Ex16.m2" class="ltx_Math" alttext="\displaystyle\overset{\sim}{\longleftrightarrow}" display="inline" intent=":literal"><semantics><mover accent="true"><mo stretchy="false">⟷</mo><mo mathsize="0.700em">∼</mo></mover><annotation encoding="application/x-tex">\displaystyle\overset{\sim}{\longleftrightarrow}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex16.m3" class="ltx_math_unparsed" alttext="\displaystyle{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{3}/3)w\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2r_{3}/3)w^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>3</mn></msub><mo>/</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mi>w</mi><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><msub><mi>r</mi><mn>3</mn></msub><mo>/</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><msup><mi>w</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{3}/3)w\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2r_{3}/3)w^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex17.m1" class="ltx_math_unparsed" alttext="\displaystyle\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2-r_{3}/3)zw\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2-2r_{3}/3)zw^{2}" display="inline" intent=":literal"><semantics><mrow><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mi>z</mi><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn><mo>−</mo><msub><mi>r</mi><mn>3</mn></msub><mo>/</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mi>z</mi><mi>w</mi><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn><mo>−</mo><mn>2</mn><msub><mi>r</mi><mn>3</mn></msub><mo>/</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mi>z</mi><msup><mi>w</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2)z\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2-r_{3}/3)zw\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-r_{2}/2-2r_{3}/3)zw^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p7.2" class="ltx_p">with multiplication induced by both relations (<a href="#S5.E11" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) and (<a href="#S5.E12" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>). By the generality of our choice of <math id="S5.p7.m3" class="ltx_Math" alttext="f(x,y)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(x,y)</annotation></semantics></math> and <math id="S5.p7.m4" class="ltx_Math" alttext="g(x,y)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(x,y)</annotation></semantics></math>, they have isolated roots distinct from each other, and it is straightforward to check that <math id="S5.p7.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is smooth. We thus visibly see the scrollar invariants over the cover <math id="S5.p7.m6" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> as <math id="S5.p7.m7" class="ltx_Math" alttext="(r_{3}/3,2r_{3}/3,r_{2}/2,r_{2}/2+r_{3}/3,r_{2}/2+2r_{3}/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>3</mn></msub><mo>/</mo><mn>3</mn></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>3</mn></msub></mrow><mo>/</mo><mn>3</mn></mrow><mo>,</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mrow><msub><mi>r</mi><mn>3</mn></msub><mo>/</mo><mn>3</mn></mrow></mrow><mo>,</mo><mrow><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>3</mn></msub></mrow><mo>/</mo><mn>3</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r_{3}/3,2r_{3}/3,r_{2}/2,r_{2}/2+r_{3}/3,r_{2}/2+2r_{3}/3)</annotation></semantics></math>, ordered. Choosing <math id="S5.p7.m8" class="ltx_Math" alttext="r_{2}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r_{2}=2</annotation></semantics></math> and <math id="S5.p7.m9" class="ltx_Math" alttext="r_{3}=498" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>3</mn></msub><mo>=</mo><mn>498</mn></mrow><annotation encoding="application/x-tex">r_{3}=498</annotation></semantics></math> (and reordering the summands) yields the first cover, and <math id="S5.p7.m10" class="ltx_Math" alttext="r_{2}=662" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>=</mo><mn>662</mn></mrow><annotation encoding="application/x-tex">r_{2}=662</annotation></semantics></math> and <math id="S5.p7.m11" class="ltx_Math" alttext="r_{3}=3" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>3</mn></msub><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">r_{3}=3</annotation></semantics></math> yields the second.</p>
</div>
<div id="S5.p8" class="ltx_para ltx_noindent">
<p id="S5.p8.1" class="ltx_p">5.3.
<span id="S5.p8.1.1" class="ltx_text ltx_font_italic">The impossibility of <math id="S5.p8.m1" class="ltx_Math" alttext="(1,111,222,332,333)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1,111,222,332,333</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,111,222,332,333)</annotation></semantics></math>.</span> 
Finally, we show that we cannot have a sextic cover <math id="S5.p8.m2" class="ltx_Math" alttext="\pi:C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi:C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> from an irreducible curve
with</p>
<table id="S5.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(13)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E13.m1" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}\cong{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-1)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-111)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-222)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-332)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-333)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo>≅</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>111</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>222</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>332</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>333</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}\cong{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-1)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-111)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-222)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-332)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-333).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p8.2" class="ltx_p">Consider the structure coefficients of the multiplication map of this <math id="S5.p8.m3" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebra. If <math id="S5.p8.m4" class="ltx_Math" alttext="E_{0}={\mathscr{O}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>0</mn></msub><mo>=</mo><mi class="ltx_font_mathscript">𝒪</mi></mrow><annotation encoding="application/x-tex">E_{0}={\mathscr{O}}</annotation></semantics></math>, …, <math id="S5.p8.m5" class="ltx_Math" alttext="E_{5}={\mathscr{O}}(-e_{5})" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>5</mn></msub><mo>=</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mn>5</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{5}={\mathscr{O}}(-e_{5})</annotation></semantics></math> are the summands of <math id="S5.p8.m6" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}</annotation></semantics></math>, then these coefficients are elements of <math id="S5.p8.m7" class="ltx_Math" alttext="\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=H^{0}(\mathbb{P}^{1},{\mathscr{O}}(e_{i}+e_{j}-e_{k}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>E</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>E</mi><mi>j</mi></msub></mrow><mo>,</mo><msub><mi>E</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo>,</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo>−</mo><msub><mi>e</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=H^{0}(\mathbb{P}^{1},{\mathscr{O}}(e_{i}+e_{j}-e_{k}))</annotation></semantics></math>, which is necessarily zero if <math id="S5.p8.m8" class="ltx_Math" alttext="e_{i}+e_{j}&lt;e_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo>&lt;</mo><msub><mi>e</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">e_{i}+e_{j}&lt;e_{k}</annotation></semantics></math>.</p>
</div>
<div id="S5.p9" class="ltx_para">
<p id="S5.p9.1" class="ltx_p">Now consider the field extension <math id="S5.p9.m1" class="ltx_Math" alttext="K(C)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(C)</annotation></semantics></math> over <math id="S5.p9.m2" class="ltx_Math" alttext="K=K(\mathbb{P}^{1})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K=K(\mathbb{P}^{1})</annotation></semantics></math>, with basis <math id="S5.p9.m3" class="ltx_Math" alttext="1=x_{0},x_{1},\dots,x_{5}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>=</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">1=x_{0},x_{1},\dots,x_{5}</annotation></semantics></math> corresponding to the summands of (<a href="#S5.E13" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>). The structure coefficients are as described in the previous paragraph. In particular, the <math id="S5.p9.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-vector space spanned by <math id="S5.p9.m5" class="ltx_Math" alttext="x_{0}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>0</mn></msub><annotation encoding="application/x-tex">x_{0}</annotation></semantics></math> and <math id="S5.p9.m6" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> is a subalgebra of <math id="S5.p9.m7" class="ltx_Math" alttext="K(C)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(C)</annotation></semantics></math> (as <math id="S5.p9.m8" class="ltx_Math" alttext="1+1&lt;111" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>+</mo><mn>1</mn></mrow><mo>&lt;</mo><mn>111</mn></mrow><annotation encoding="application/x-tex">1+1&lt;111</annotation></semantics></math>, so <math id="S5.p9.m9" class="ltx_Math" alttext="\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>E</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>E</mi><mi>j</mi></msub></mrow><mo>,</mo><msub><mi>E</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=0</annotation></semantics></math> for <math id="S5.p9.m10" class="ltx_Math" alttext="i,j\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i,j\leq 1</annotation></semantics></math>, <math id="S5.p9.m11" class="ltx_Math" alttext="k\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k\geq 2</annotation></semantics></math>), and is thus necessarily a subfield <math id="S5.p9.m12" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> of <math id="S5.p9.m13" class="ltx_Math" alttext="K(C)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(C)</annotation></semantics></math>, of degree <math id="S5.p9.m14" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> over <math id="S5.p9.m15" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. The <math id="S5.p9.m16" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-vector space spanned by <math id="S5.p9.m17" class="ltx_Math" alttext="x_{0}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>0</mn></msub><annotation encoding="application/x-tex">x_{0}</annotation></semantics></math>, <math id="S5.p9.m18" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math>, and <math id="S5.p9.m19" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math> is preserved by the multiplication by <math id="S5.p9.m20" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> (as <math id="S5.p9.m21" class="ltx_Math" alttext="1+111&lt;222" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>+</mo><mn>111</mn></mrow><mo>&lt;</mo><mn>222</mn></mrow><annotation encoding="application/x-tex">1+111&lt;222</annotation></semantics></math>, so <math id="S5.p9.m22" class="ltx_Math" alttext="\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>E</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>E</mi><mi>j</mi></msub></mrow><mo>,</mo><msub><mi>E</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=0</annotation></semantics></math> for <math id="S5.p9.m23" class="ltx_Math" alttext="i\leq 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leq 1</annotation></semantics></math>, <math id="S5.p9.m24" class="ltx_Math" alttext="j\leq 2" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j\leq 2</annotation></semantics></math>, <math id="S5.p9.m25" class="ltx_Math" alttext="k\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">k\geq 3</annotation></semantics></math>), so it is a vector space over <math id="S5.p9.m26" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. But it is a 3-dimensional <math id="S5.p9.m27" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-vector space, and thus cannot be a vector space over a degree <math id="S5.p9.m28" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> field extension <math id="S5.p9.m29" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> of <math id="S5.p9.m30" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, contradiction.</p>
</div>
<div id="S5.p10" class="ltx_para ltx_noindent">
<p id="S5.p10.1" class="ltx_p">5.4.
<span id="S5.p10.1.1" class="ltx_text ltx_font_bold">The case <math id="S5.p10.m1" class="ltx_Math" alttext="d=pq" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><annotation encoding="application/x-tex">d=pq</annotation></semantics></math> where <math id="S5.p10.m2" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> are distinct primes.</span> 
We extend this idea to the case <math id="S5.p10.m3" class="ltx_Math" alttext="d=pq" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><annotation encoding="application/x-tex">d=pq</annotation></semantics></math>. We first construct two covers, both as composita of cyclic covers of degree <math id="S5.p10.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and <math id="S5.p10.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, and determine their scrollar invariants. We then consider the “midpoint” of their scrollar invariants, and show that it cannot be achieved as the scrollar invariants of a cover of <math id="S5.p10.m6" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math> by an irreducible curve.</p>
</div>
<div id="S5.p11" class="ltx_para ltx_noindent">
<p id="S5.p11.1" class="ltx_p">5.5.
<span id="S5.p11.1.1" class="ltx_text ltx_font_italic">The two covers.</span>  Take <math id="S5.p11.m1" class="ltx_Math" alttext="(a_{1},b_{1})=(2,2+2N(p-1))" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>b</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mrow><mn>2</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a_{1},b_{1})=(2,2+2N(p-1))</annotation></semantics></math> and <math id="S5.p11.m2" class="ltx_Math" alttext="(a_{2},b_{2})=(2+2N(q-1),2)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo>,</mo><msub><mi>b</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a_{2},b_{2})=(2+2N(q-1),2)</annotation></semantics></math> for <math id="S5.p11.m3" class="ltx_math_unparsed" alttext="N\gg_{p,q}1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≫</mo><msub><mrow></mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mn>1</mn></mrow><annotation encoding="application/x-tex">N\gg_{p,q}1</annotation></semantics></math>.
The <math id="S5.p11.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th cover (<math id="S5.p11.m5" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math>) is the compositum of a general cyclic cover of degree <math id="S5.p11.m6" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> over a degree <math id="S5.p11.m7" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math> generally chosen branch locus and a general degree <math id="S5.p11.m8" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> cyclic cover over a degree <math id="S5.p11.m9" class="ltx_Math" alttext="b_{i}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>i</mi></msub><annotation encoding="application/x-tex">b_{i}</annotation></semantics></math> generally chosen branch locus. The scrollar invariants of the cyclic degree <math id="S5.p11.m10" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> cover are <math id="S5.p11.m11" class="ltx_Math" alttext="(a_{i},\dots,(p-1)a_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{i},\dots,(p-1)a_{i})</annotation></semantics></math> and the scrollar invariants of the cyclic degree <math id="S5.p11.m12" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> cover are <math id="S5.p11.m13" class="ltx_Math" alttext="(b_{i},\dots,(q-1)b_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>i</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b_{i},\dots,(q-1)b_{i})</annotation></semantics></math>. Let the two covers be denoted <math id="S5.p11.m14" class="ltx_Math" alttext="\pi_{1}\colon C_{1}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi_{1}\colon C_{1}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> and <math id="S5.p11.m15" class="ltx_Math" alttext="\pi_{2}\colon C_{2}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi_{2}\colon C_{2}\rightarrow\mathbb{P}^{1}</annotation></semantics></math>, and let <math id="S5.p11.m16" class="ltx_Math" alttext="\pi\colon C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi\colon C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> be the compositum.</p>
</div>
<div id="S5.p12" class="ltx_para">
<p id="S5.p12.1" class="ltx_p">The pushforward of the structure sheaf (with summands not necessarily written in increasing order) is</p>
<table id="S5.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex18.m1" class="ltx_Math" alttext="(\pi_{i})_{*}{\mathscr{O}}_{C_{i}}\cong\bigoplus_{j=0}^{p-1}\bigoplus_{k=0}^{q-1}{\mathscr{O}}_{\mathbb{P}^{1}}(-ja_{i}-kb_{i})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mi>i</mi></msub></msub></mrow><mo rspace="0.111em">≅</mo><mrow><munderover><mo movablelimits="false" rspace="0em">⨁</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub></mrow></mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(\pi_{i})_{*}{\mathscr{O}}_{C_{i}}\cong\bigoplus_{j=0}^{p-1}\bigoplus_{k=0}^{q-1}{\mathscr{O}}_{\mathbb{P}^{1}}(-ja_{i}-kb_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p12.2" class="ltx_p">which has degree
<math id="S5.p12.m1" class="ltx_Math" alttext="(pq/2)((p-1)a_{i}+(q-1)b_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(pq/2)((p-1)a_{i}+(q-1)b_{i})</annotation></semantics></math>, which is independent of <math id="S5.p12.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div>
<div id="S5.p13" class="ltx_para">
<p id="S5.p13.1" class="ltx_p">With summands written in decreasing order, the vector bundle <math id="S5.p13.m1" class="ltx_Math" alttext="(\pi_{1})_{*}{\mathscr{O}}_{C_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">(\pi_{1})_{*}{\mathscr{O}}_{C_{1}}</annotation></semantics></math> is:</p>
<table id="S5.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(14)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E14.m1" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2)\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2(p-1))\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-b_{1})\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2-b_{1})\oplus\cdots." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>b</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo>−</mo><msub><mi>b</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2)\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2(p-1))\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-b_{1})\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2-b_{1})\oplus\cdots.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p13.2" class="ltx_p">Note that the summands at each step decrease by either <math id="S5.p13.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> or <math id="S5.p13.m3" class="ltx_Math" alttext="b_{1}-2(p-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mn>1</mn></msub><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b_{1}-2(p-1)</annotation></semantics></math>.
With summands written in decreasing order, the vector bundle <math id="S5.p13.m4" class="ltx_Math" alttext="(\pi_{2})_{*}{\mathscr{O}}_{C_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">(\pi_{2})_{*}{\mathscr{O}}_{C_{2}}</annotation></semantics></math> is:</p>
<table id="S5.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(15)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E15.m1" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2)\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2(q-1))\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-a_{2})\oplus\cdots." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>a</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2)\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2(q-1))\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-a_{2})\oplus\cdots.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p13.3" class="ltx_p">The summands at each step decrease by either <math id="S5.p13.m5" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> or <math id="S5.p13.m6" class="ltx_Math" alttext="a_{2}-2(q-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{2}-2(q-1)</annotation></semantics></math>.
The (vector bundle corresponding to the) average of the (lattice points corresponding to) the two scrollar invariants above begins as:</p>
<table id="S5.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(16)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E16.m1" class="ltx_math_unparsed" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2)\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2(p-1))\oplus(-b_{1}/2-p)\oplus(-2-b_{1}/2-p)\oplus\cdots." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>⊕</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>b</mi><mn>1</mn></msub><mo>/</mo><mn>2</mn><mo>−</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>⊕</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><mo>−</mo><msub><mi>b</mi><mn>1</mn></msub><mo>/</mo><mn>2</mn><mo>−</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2)\oplus\cdots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-2(p-1))\oplus(-b_{1}/2-p)\oplus(-2-b_{1}/2-p)\oplus\cdots.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p13.4" class="ltx_p">As in the special case <math id="S5.p13.m7" class="ltx_Math" alttext="d=6" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">d=6</annotation></semantics></math>, the condition <math id="S5.p13.m8" class="ltx_Math" alttext="N\gg 1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≫</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N\gg 1</annotation></semantics></math> implies that the first <math id="S5.p13.m9" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> summands form a subalgebra (<math id="S5.p13.m10" class="ltx_Math" alttext="2(p-1)+2(p-1)&lt;b_{1}/2+p" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><mrow><msub><mi>b</mi><mn>1</mn></msub><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">2(p-1)+2(p-1)&lt;b_{1}/2+p</annotation></semantics></math>, so <math id="S5.p13.m11" class="ltx_Math" alttext="\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>E</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>E</mi><mi>j</mi></msub></mrow><mo>,</mo><msub><mi>E</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=0</annotation></semantics></math> for <math id="S5.p13.m12" class="ltx_Math" alttext="i,j&lt;p" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>&lt;</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">i,j&lt;p</annotation></semantics></math> and <math id="S5.p13.m13" class="ltx_Math" alttext="k\geq p" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">k\geq p</annotation></semantics></math>), so they correspond to a degree <math id="S5.p13.m14" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> field extension <math id="S5.p13.m15" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> of <math id="S5.p13.m16" class="ltx_Math" alttext="K=K(\mathbb{P}^{1})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K=K(\mathbb{P}^{1})</annotation></semantics></math>.</p>
</div>
<div id="S5.p14" class="ltx_para ltx_noindent">
<p id="S5.p14.1" class="ltx_p">5.6.
<span id="S5.p14.1.1" class="ltx_text ltx_font_bold">Claim. —</span>  <span id="S5.p14.1.2" class="ltx_text ltx_font_italic">The first <math id="S5.p14.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> summands, pulled back to the generic point of <math id="S5.p14.m2" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>, are preserved by multiplication by elements of <math id="S5.p14.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p15" class="ltx_para ltx_noindent">
<p id="S5.p15.1" class="ltx_p"><span id="S5.p15.1.1" class="ltx_text ltx_font_italic">Proof. </span>By our observations about how the degrees of the summands of (<a href="#S5.E14" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) and (<a href="#S5.E15" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) increase (written just after the two equation displays), in (<a href="#S5.E16" title="In 5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) the summands satisfy</p>
<table id="S5.EGx4" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S5.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex19.m1" class="ltx_Math" alttext="\displaystyle-\deg E_{q}+\deg E_{q-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msub><mi>E</mi><mi>q</mi></msub></mrow></mrow><mo>+</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msub><mi>E</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\deg E_{q}+\deg E_{q-1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.Ex19.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex19.m3" class="ltx_Math" alttext="\displaystyle\frac{2+(a_{2}-2(q-1))}{2}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{2+(a_{2}-2(q-1))}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.Ex20.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex20.m2" class="ltx_Math" alttext="\displaystyle a_{2}/2-q+2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mi>q</mi></mrow><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle a_{2}/2-q+2</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.Ex21.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex21.m2" class="ltx_Math" alttext="\displaystyle 1+N(q-1)-q+2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>q</mi></mrow><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle 1+N(q-1)-q+2</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.Ex22.m1" class="ltx_Math" alttext="\displaystyle&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">\displaystyle&gt;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex22.m2" class="ltx_Math" alttext="\displaystyle 2(p-1)\quad\quad\text{(as $N\gg 1$)}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mtext>(as </mtext><mrow><mi>N</mi><mo>≫</mo><mn>1</mn></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2(p-1)\quad\quad\text{(as $N\gg 1$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.Ex23.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex23.m2" class="ltx_Math" alttext="\displaystyle-\deg E_{p-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msub><mi>E</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\deg E_{p-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p15.2" class="ltx_p">Thus <math id="S5.p15.m1" class="ltx_Math" alttext="\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>E</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>E</mi><mi>j</mi></msub></mrow><mo>,</mo><msub><mi>E</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{Hom}(E_{i}\otimes E_{j},E_{k})=0</annotation></semantics></math> for <math id="S5.p15.m2" class="ltx_Math" alttext="i&lt;p" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">i&lt;p</annotation></semantics></math>, <math id="S5.p15.m3" class="ltx_Math" alttext="j&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">j&lt;q</annotation></semantics></math>, and <math id="S5.p15.m4" class="ltx_Math" alttext="k\geq q" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">k\geq q</annotation></semantics></math>. ∎</p>
</div>
<div id="S5.p16" class="ltx_para">
<p id="S5.p16.1" class="ltx_p">Thus the first <math id="S5.p16.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> summands form a vector space over <math id="S5.p16.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. But a <math id="S5.p16.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-dimensional vector space over <math id="S5.p16.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> cannot be a vector space over a degree <math id="S5.p16.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> field extension <math id="S5.p16.m6" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> of <math id="S5.p16.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.</p>
</div>
<div id="S5.p17" class="ltx_para ltx_noindent">
<p id="S5.p17.1" class="ltx_p">5.7.
<span id="S5.p17.1.1" class="ltx_text ltx_font_bold">The general case <math id="S5.p17.m1" class="ltx_Math" alttext="d=pqn" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">d=pqn</annotation></semantics></math> where <math id="S5.p17.m2" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> are distinct primes.</span>  The general case is a mild variation; we take composita of <span id="S5.p17.1.2" class="ltx_text ltx_font_italic">three</span> cyclic field extensions, where the third is degree <math id="S5.p17.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> over a degree generally chosen branch locus with <math id="S5.p17.m4" class="ltx_math_unparsed" alttext="M\gg_{N}1" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>≫</mo><msub><mrow></mrow><mi>N</mi></msub><mn>1</mn></mrow><annotation encoding="application/x-tex">M\gg_{N}1</annotation></semantics></math>. (We use the same <math id="S5.p17.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> in constructing both of the two covers analogous to §<a href="#S5" title="5. The possible scrollar invariants do not form a convex set if 
        
          d
        
       is not a prime power ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.) In the direct sum decomposition of the two covers constructed, the nontrivial summands of the third cyclic extension do not appear in the first <math id="S5.p17.m6" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> summands, and thus do not interact with the previous argument.</p>
</div>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6. </span>All concave scrollar invariants (a positive proportion of the polytope <math id="S6.m1" class="ltx_Math" alttext="\mathcal{P}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{d}</annotation></semantics></math>) are achieved</h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">In this section, we prove Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. The degree of the cover is of course <math id="S6.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, and the genus of <math id="S6.p1.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is <math id="S6.p1.m3" class="ltx_Math" alttext="\sum e_{i}-(d-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∑</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sum e_{i}-(d-1)</annotation></semantics></math> (from §<a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>).</p>
</div>
<div id="S6.p2" class="ltx_para ltx_noindent">
<p id="S6.p2.1" class="ltx_p">6.1. We begin by fixing some terminology. Let <math id="S6.p2.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> be a nonnegative integer. Suppose <math id="S6.p2.m2" class="ltx_Math" alttext="C\subset\mathbb{F}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><msub><mi>𝔽</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">C\subset\mathbb{F}_{a}</annotation></semantics></math> is a curve in class <math id="S6.p2.m3" class="ltx_Math" alttext="dD+kF\in\operatorname{Pic}\mathbb{F}_{a}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo>+</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></mrow><mo>∈</mo><mrow><mi>Pic</mi><mo lspace="0.167em">⁡</mo><msub><mi>𝔽</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">dD+kF\in\operatorname{Pic}\mathbb{F}_{a}</annotation></semantics></math>, where the base <math id="S6.p2.m4" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math> has projective coordinates <math id="S6.p2.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and <math id="S6.p2.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Suppose <math id="S6.p2.m7" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> has equation (informally speaking, in “toric coordinates”)</p>
<table id="S6.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(17)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E17.m1" class="ltx_Math" alttext="f=f_{0}x^{d}+\dots+f_{d}y^{d}," display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>=</mo><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><msub><mi>f</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f=f_{0}x^{d}+\dots+f_{d}y^{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p2.2" class="ltx_p">where <math id="S6.p2.m8" class="ltx_Math" alttext="f_{i}\in\mathbb{C}[s,t]" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>∈</mo><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{i}\in\mathbb{C}[s,t]</annotation></semantics></math> is homogeneous of degree <math id="S6.p2.m9" class="ltx_Math" alttext="k+ia" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">k+ia</annotation></semantics></math>. Here <math id="S6.p2.m10" class="ltx_Math" alttext="y=0" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">y=0</annotation></semantics></math> is the directrix of <math id="S6.p2.m11" class="ltx_Math" alttext="\mathbb{F}_{a}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{a}</annotation></semantics></math>. The following theorem is the key input that gives us direct control of the scrollar invariants of <math id="S6.p2.m12" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>.</p>
</div>
<div id="S6.p3" class="ltx_para ltx_noindent">
<p id="S6.p3.1" class="ltx_p">6.2.
<span id="S6.p3.1.1" class="ltx_text ltx_font_bold">Theorem. —</span>   <span id="S6.p3.1.2" class="ltx_text ltx_font_italic"> With the notation as above, <math id="S6.p3.m1" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C}\cong{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-k-a)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-k-2a)\oplus\dots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-k-(d-1)a)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo>≅</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mi>k</mi></mrow><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mi>k</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mi mathvariant="normal">⋯</mi><mo>⊕</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mi>k</mi></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C}\cong{\mathscr{O}}_{\mathbb{P}^{1}}\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-k-a)\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-k-2a)\oplus\dots\oplus{\mathscr{O}}_{\mathbb{P}^{1}}(-k-(d-1)a)</annotation></semantics></math> with the following algebra structure. Let <math id="S6.p3.m2" class="ltx_Math" alttext="E_{0},\dots,E_{d-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>E</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">E_{0},\dots,E_{d-1}</annotation></semantics></math> be the <math id="S6.p3.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> summands. For <math id="S6.p3.m4" class="ltx_Math" alttext="i\leq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\leq j</annotation></semantics></math>, the multiplication map <math id="S6.p3.m5" class="ltx_Math" alttext="E_{i}\otimes E_{j}\rightarrow E_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>E</mi><mi>j</mi></msub></mrow><mo stretchy="false">→</mo><msub><mi>E</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">E_{i}\otimes E_{j}\rightarrow E_{k}</annotation></semantics></math> is given by:</span></p>
<table id="S6.EGx5" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S6.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex24.m1" class="ltx_Math" alttext="\displaystyle-f_{i+j-k}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>f</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle-f_{i+j-k}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S6.Ex24.1.3.1" class="ltx_text ltx_markedasmath ltx_font_italic">if <math id="S6.Ex24.m2.m1" class="ltx_Math" alttext="\max\{i+j-d,1\}\leq k\leq i" display="inline" intent=":literal"><semantics><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>d</mi></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">\max\{i+j-d,1\}\leq k\leq i</annotation></semantics></math></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex25.m1" class="ltx_Math" alttext="\displaystyle f_{i+j-k}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle f_{i+j-k}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S6.Ex25.1.3.1" class="ltx_text ltx_markedasmath ltx_font_italic">if <math id="S6.Ex25.m2.m1" class="ltx_Math" alttext="j&lt;k&lt;d" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&lt;</mo><mi>k</mi><mo>&lt;</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">j&lt;k&lt;d</annotation></semantics></math></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex26.m1" class="ltx_Math" alttext="\displaystyle-f_{i+j-d}f_{d}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><msub><mi>f</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>d</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-f_{i+j-d}f_{d}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S6.Ex26.1.3.1" class="ltx_text ltx_markedasmath ltx_font_italic">if <math id="S6.Ex26.m2.m1" class="ltx_Math" alttext="k=0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k=0</annotation></semantics></math> and <math id="S6.Ex26.m2.m2" class="ltx_Math" alttext="i+j\geq d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>≥</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">i+j\geq d</annotation></semantics></math></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex27.m1" class="ltx_Math" alttext="\displaystyle 1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">\displaystyle 1</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S6.Ex27.1.3.1" class="ltx_text ltx_markedasmath ltx_font_italic">if <math id="S6.Ex27.m2.m1" class="ltx_Math" alttext="i=0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i=0</annotation></semantics></math> and <math id="S6.Ex27.m2.m2" class="ltx_Math" alttext="j=k" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">j=k</annotation></semantics></math></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex28.m1" class="ltx_Math" alttext="\displaystyle 0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\displaystyle 0</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S6.Ex28.1.3.1" class="ltx_text ltx_markedasmath ltx_font_italic">otherwise.</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.p4" class="ltx_para">
<p id="S6.p4.1" class="ltx_p">This is a special case of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx37" title="" class="ltx_ref">W</a>, §3]</cite>; see also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx29" title="" class="ltx_ref">N</a>]</cite>. Now to prove Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we describe a particular cover <math id="S6.p4.m1" class="ltx_Math" alttext="C^{\prime}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>′</mo></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C^{\prime}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> whose normalization <math id="S6.p4.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> will have the desired Tschirnhausen bundle.</p>
</div>
<div id="S6.p5" class="ltx_para">
<p id="S6.p5.1" class="ltx_p">We take <math id="S6.p5.m1" class="ltx_Math" alttext="a=e_{1}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">a=e_{1}</annotation></semantics></math>.
Take a general curve <math id="S6.p5.m2" class="ltx_Math" alttext="C^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>′</mo></msup><annotation encoding="application/x-tex">C^{\prime}</annotation></semantics></math> on <math id="S6.p5.m3" class="ltx_Math" alttext="\mathbb{F}_{a}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{a}</annotation></semantics></math> in class <math id="S6.p5.m4" class="ltx_Math" alttext="dD" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">dD</annotation></semantics></math> (so <math id="S6.p5.m5" class="ltx_Math" alttext="k=0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k=0</annotation></semantics></math> in (<a href="#S6.E17" title="In 6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>)) subject to the constraint that <math id="S6.p5.m6" class="ltx_Math" alttext="t^{ai-e_{i}}|f_{i}(s,t)" display="inline" intent=":literal"><semantics><mrow><msup><mi>t</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow></msup><mo fence="false">|</mo><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t^{ai-e_{i}}|f_{i}(s,t)</annotation></semantics></math> (<math id="S6.p5.m7" class="ltx_Math" alttext="0\leq i\leq d" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">0\leq i\leq d</annotation></semantics></math>). (Note that the assumptions of Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, namely concavity of the <math id="S6.p5.m8" class="ltx_Math" alttext="e_{i}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mi>i</mi></msub><annotation encoding="application/x-tex">e_{i}</annotation></semantics></math>, ensure that <math id="S6.p5.m9" class="ltx_Math" alttext="ai-e_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">ai-e_{i}\geq 0</annotation></semantics></math> for all such <math id="S6.p5.m10" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. Recall also that by convention, we set <math id="S6.p5.m11" class="ltx_Math" alttext="e_{0}=e_{d}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>0</mn></msub><mo>=</mo><msub><mi>e</mi><mi>d</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e_{0}=e_{d}=0</annotation></semantics></math>.)</p>
</div>
<div id="S6.p6" class="ltx_para ltx_noindent">
<p id="S6.p6.1" class="ltx_p">6.3.
<span id="S6.p6.1.1" class="ltx_text ltx_font_bold">Claim. —</span>  <span id="S6.p6.1.2" class="ltx_text ltx_font_italic">The curve <math id="S6.p6.m1" class="ltx_Math" alttext="C^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>′</mo></msup><annotation encoding="application/x-tex">C^{\prime}</annotation></semantics></math> is irreducible, smooth away from <math id="S6.p6.m2" class="ltx_Math" alttext="x=t=0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x=t=0</annotation></semantics></math>, and <math id="S6.p6.m3" class="ltx_Math" alttext="C^{\prime}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>′</mo></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C^{\prime}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> is primitive.</span></p>
</div>
<div id="S6.p7" class="ltx_para ltx_noindent">
<p id="S6.p7.1" class="ltx_p"><span id="S6.p7.1.1" class="ltx_text ltx_font_italic">Proof. </span>We consider the linear system of curves on the Hirzebruch surface
with our imposed singularity at <math id="S6.p7.m1" class="ltx_Math" alttext="x=t=0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x=t=0</annotation></semantics></math> (a subsystem of <math id="S6.p7.m2" class="ltx_Math" alttext="|{\mathscr{O}}_{\mathbb{F}_{a}}(dD)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>𝔽</mi><mi>a</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\mathscr{O}}_{\mathbb{F}_{a}}(dD)|</annotation></semantics></math>).
Smoothness follows from Bertini’s Theorem applied to the Hirzebruch surface minus the points <math id="S6.p7.m3" class="ltx_Math" alttext="x=t=0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x=t=0</annotation></semantics></math> (in the form of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">Va</a>, Ex. 21.6.I]</cite>): the linear system in question on the Hirzebruch surface is base-point-free away from <math id="S6.p7.m4" class="ltx_Math" alttext="x=t=0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x=t=0</annotation></semantics></math>. It is easy to exhibit an irreducible curve in the system. (We omit the details, because we will also soon show that if <math id="S6.p7.m5" class="ltx_Math" alttext="C\rightarrow C^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>C</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">C\rightarrow C^{\prime}</annotation></semantics></math> is the normalization, then <math id="S6.p7.m6" class="ltx_Math" alttext="h^{0}(C,{\mathscr{O}}_{C})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h^{0}(C,{\mathscr{O}}_{C})=1</annotation></semantics></math>, which also will give irreducibility.) It is also straightforward to exhibit a curve in the linear system whose points above <math id="S6.p7.m7" class="ltx_Math" alttext="[s;t]=[0;1]\in\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>s</mi><mo>;</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>;</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">[s;t]=[0;1]\in\mathbb{P}^{1}</annotation></semantics></math> are regular and branched with multiplicity <math id="S6.p7.m8" class="ltx_Math" alttext="d-1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d-1</annotation></semantics></math> and <math id="S6.p7.m9" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, respectively (e.g., in local coordinates near <math id="S6.p7.m10" class="ltx_Math" alttext="s=0" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s=0</annotation></semantics></math>, <math id="S6.p7.m11" class="ltx_Math" alttext="s+y^{d-1}(y-1)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>+</mo><mrow><msup><mi>y</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s+y^{d-1}(y-1)</annotation></semantics></math>); this implies primitivity. ∎</p>
</div>
<div id="S6.p8" class="ltx_para">
<p id="S6.p8.1" class="ltx_p">Define the locally free sheaf <math id="S6.p8.m1" class="ltx_math_unparsed" alttext="{\mathscr{A}}=\oplus_{i=0}^{d-1}t^{-ia+e_{i}}E_{i}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo rspace="0em">=</mo><mo lspace="0em">⊕</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>t</mi><msup><mrow></mrow><mrow><mrow><mo>−</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>+</mo><msub><mi>e</mi><mi>i</mi></msub></mrow></msup><mi>E</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">{\mathscr{A}}=\oplus_{i=0}^{d-1}t^{-ia+e_{i}}E_{i}</annotation></semantics></math>. Then <math id="S6.p8.m2" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C^{\prime}}\subset{\mathscr{A}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>C</mi><mo>′</mo></msup></msub></mrow><mo>⊂</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C^{\prime}}\subset{\mathscr{A}}</annotation></semantics></math> (as <math id="S6.p8.m3" class="ltx_Math" alttext="e_{i}\leq ie_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>≤</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e_{i}\leq ie_{1}</annotation></semantics></math> by concavity).</p>
</div>
<div id="S6.p9" class="ltx_para ltx_noindent">
<p id="S6.p9.1" class="ltx_p">6.4.
<span id="S6.p9.1.1" class="ltx_text ltx_font_bold">Claim. —</span>   <span id="S6.p9.1.2" class="ltx_text ltx_font_italic">The multiplication map of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> extends to give an <math id="S6.p9.m1" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebra structure on <math id="S6.p9.m2" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math>. </span></p>
</div>
<div id="S6.p10" class="ltx_para ltx_noindent">
<p id="S6.p10.1" class="ltx_p"><span id="S6.p10.1.1" class="ltx_text ltx_font_italic">Proof. </span>For every <math id="S6.p10.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>,<math id="S6.p10.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, and <math id="S6.p10.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, let <math id="S6.p10.m4" class="ltx_Math" alttext="g_{ijk}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">g_{ijk}</annotation></semantics></math> represent the multiplication coefficient given in Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>; it suffices to show that</p>
<table id="S6.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(18)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E18.m1" class="ltx_Math" alttext="t^{-ia+e_{i}}t^{-ja+e_{j}}g_{ijk}\in t^{-ka+e_{k}}\mathbb{C}[s,t]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>t</mi><mrow><mrow><mo>−</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>+</mo><msub><mi>e</mi><mi>i</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mrow><mo>−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><mo>∈</mo><mrow><msup><mi>t</mi><mrow><mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>+</mo><msub><mi>e</mi><mi>k</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t^{-ia+e_{i}}t^{-ja+e_{j}}g_{ijk}\in t^{-ka+e_{k}}\mathbb{C}[s,t].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.p11" class="ltx_para">
<p id="S6.p11.1" class="ltx_p">We check the five cases given in Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. The last two cases (when <math id="S6.p11.m1" class="ltx_Math" alttext="i=0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i=0</annotation></semantics></math> and <math id="S6.p11.m2" class="ltx_Math" alttext="j=k" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">j=k</annotation></semantics></math>, and when the multiplication coefficient is <math id="S6.p11.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>) are trivial. We check the other three cases now. If <math id="S6.p11.m4" class="ltx_Math" alttext="\max\{i+j-d,1\}\leq k\leq i" display="inline" intent=":literal"><semantics><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>d</mi></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">\max\{i+j-d,1\}\leq k\leq i</annotation></semantics></math> or <math id="S6.p11.m5" class="ltx_Math" alttext="j&lt;k&lt;d" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&lt;</mo><mi>k</mi><mo>&lt;</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">j&lt;k&lt;d</annotation></semantics></math> then <math id="S6.p11.m6" class="ltx_Math" alttext="g_{ijk}=\pm f_{i+j-k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo rspace="0em">=</mo><mrow><mo lspace="0em">±</mo><msub><mi>f</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>k</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">g_{ijk}=\pm f_{i+j-k}</annotation></semantics></math>. By comparing <math id="S6.p11.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-valuations, the inclusion (<a href="#S6.E18" title="In 6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) is equivalent to</p>
<table id="S6.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex29.m1" class="ltx_Math" alttext="(-ia+e_{i})+(-ja+e_{j})+a(i+j-k)-e_{i+j-k}\geq-ka+e_{k}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>+</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>e</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>k</mi></mrow></msub></mrow><mo rspace="0em">≥</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>+</mo><msub><mi>e</mi><mi>k</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(-ia+e_{i})+(-ja+e_{j})+a(i+j-k)-e_{i+j-k}\geq-ka+e_{k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p11.2" class="ltx_p">The above is equivalent to <math id="S6.p11.m8" class="ltx_Math" alttext="e_{i}+e_{j}\geq e_{i+j-k}+e_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo>≥</mo><mrow><msub><mi>e</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>k</mi></mrow></msub><mo>+</mo><msub><mi>e</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">e_{i}+e_{j}\geq e_{i+j-k}+e_{k}</annotation></semantics></math>, which follows from concavity. If <math id="S6.p11.m9" class="ltx_Math" alttext="k=0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k=0</annotation></semantics></math> and <math id="S6.p11.m10" class="ltx_Math" alttext="i+j\geq d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>≥</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">i+j\geq d</annotation></semantics></math>, then <math id="S6.p11.m11" class="ltx_Math" alttext="g_{ijk}=f_{i+j-d}f_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msub><mi>f</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>d</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">g_{ijk}=f_{i+j-d}f_{d}</annotation></semantics></math>. Proceeding as above, it suffices to show that</p>
<table id="S6.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex30.m1" class="ltx_Math" alttext="(-ia+e_{i})+(-ja+e_{j})+a(i+j-d)-e_{i+j-d}+ad-e_{d}+\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>+</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo lspace="0em">−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>e</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>d</mi></mrow></msub></mrow><mo>+</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>−</mo><msub><mi>e</mi><mi>d</mi></msub></mrow><mo rspace="0em">+</mo></mrow><mo lspace="0em">≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(-ia+e_{i})+(-ja+e_{j})+a(i+j-d)-e_{i+j-d}+ad-e_{d}+\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p11.3" class="ltx_p">The above is equivalent to <math id="S6.p11.m12" class="ltx_Math" alttext="e_{i}+e_{j}\geq e_{i+j-d}+e_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mi>i</mi></msub><mo>+</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo>≥</mo><mrow><msub><mi>e</mi><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>−</mo><mi>d</mi></mrow></msub><mo>+</mo><msub><mi>e</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">e_{i}+e_{j}\geq e_{i+j-d}+e_{d}</annotation></semantics></math>, which again follows from concavity.
∎</p>
</div>
<div id="S6.p12" class="ltx_para">
<p id="S6.p12.1" class="ltx_p">Thus</p>
<table id="S6.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex31.m1" class="ltx_Math" alttext="C\coloneq\underline{\operatorname{Spec}}\;{\mathscr{A}}\rightarrow\underline{\operatorname{Spec}}\;\pi_{*}{\mathscr{O}}_{C^{\prime}}=C^{\prime}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>≔</mo><mrow><munder accentunder="true"><mi>Spec</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.167em" rspace="0em">​</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow><mo stretchy="false">→</mo><mrow><munder accentunder="true"><mi>Spec</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>C</mi><mo>′</mo></msup></msub></mrow><mo>=</mo><msup><mi>C</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">C\coloneq\underline{\operatorname{Spec}}\;{\mathscr{A}}\rightarrow\underline{\operatorname{Spec}}\;\pi_{*}{\mathscr{O}}_{C^{\prime}}=C^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p12.2" class="ltx_p">is a birational morphism, and an isomorphism away from <math id="S6.p12.m1" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.</p>
</div>
<div id="S6.p13" class="ltx_para ltx_noindent">
<p id="S6.p13.1" class="ltx_p">6.5.
<span id="S6.p13.1.1" class="ltx_text ltx_font_bold">Claim. —</span>  <span id="S6.p13.1.2" class="ltx_text ltx_font_italic">The morphism <math id="S6.p13.m1" class="ltx_Math" alttext="\underline{\operatorname{Spec}}\;{\mathscr{A}}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>Spec</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.447em" rspace="0em">​</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\underline{\operatorname{Spec}}\;{\mathscr{A}}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> is unramified at <math id="S6.p13.m2" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.</span></p>
</div>
<div id="S6.p14" class="ltx_para ltx_noindent">
<p id="S6.p14.1" class="ltx_p"><span id="S6.p14.1.1" class="ltx_text ltx_font_italic">Proof. </span>The ramification divisor of <math id="S6.p14.m1" class="ltx_Math" alttext="C^{\prime}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>′</mo></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C^{\prime}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> is given by the vanishing of <math id="S6.p14.m2" class="ltx_Math" alttext="\Disc(f)" display="inline" intent=":literal"><semantics><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Disc(f)</annotation></semantics></math>, and the ramification divisor of the map <math id="S6.p14.m3" class="ltx_Math" alttext="C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> is the previous quantity minus <math id="S6.p14.m4" class="ltx_Math" alttext="2\sum_{i=1}^{d-1}(ia-e_{i})" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2\sum_{i=1}^{d-1}(ia-e_{i})</annotation></semantics></math> copies of <math id="S6.p14.m5" class="ltx_math_unparsed" alttext="[1\colon 0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1\colon 0]</annotation></semantics></math>. Thus, to show that the ramification divisor of <math id="S6.p14.m6" class="ltx_Math" alttext="C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> is not supported at <math id="S6.p14.m7" class="ltx_math_unparsed" alttext="[1\colon 0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1\colon 0]</annotation></semantics></math>, it suffices to show that the power of <math id="S6.p14.m8" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> dividing <math id="S6.p14.m9" class="ltx_Math" alttext="\Disc(f)" display="inline" intent=":literal"><semantics><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Disc(f)</annotation></semantics></math> is bounded above by <math id="S6.p14.m10" class="ltx_Math" alttext="2\sum_{i=1}^{d-1}(ia-e_{i})" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2\sum_{i=1}^{d-1}(ia-e_{i})</annotation></semantics></math>.</p>
</div>
<div id="S6.p15" class="ltx_para">
<p id="S6.p15.1" class="ltx_p">Consider the universal binary <math id="S6.p15.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-ic form <math id="S6.p15.m2" class="ltx_Math" alttext="F=F_{0}x^{d}+\dots+F_{d}y^{d}\in\mathbb{Z}[F_{0},\dots,F_{d}]" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mrow><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><msub><mi>F</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow></mrow><mo>∈</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>F</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F=F_{0}x^{d}+\dots+F_{d}y^{d}\in\mathbb{Z}[F_{0},\dots,F_{d}]</annotation></semantics></math>. Lemma <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> shows that the polynomial <math id="S6.p15.m3" class="ltx_Math" alttext="\Disc(F)\in\mathbb{Z}[F_{0},\dots,F_{d}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>F</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Disc(F)\in\mathbb{Z}[F_{0},\dots,F_{d}]</annotation></semantics></math> contains the monomial <math id="S6.p15.m4" class="ltx_Math" alttext="F_{1}^{2}\dots F_{d-1}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>F</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">F_{1}^{2}\dots F_{d-1}^{2}</annotation></semantics></math>. Because our polynomial <math id="S6.p15.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is general subject to the constraint that <math id="S6.p15.m6" class="ltx_Math" alttext="t^{ia-e_{i}}\mid f_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>t</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow></msup><mo fence="false">|</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">t^{ia-e_{i}}\mid f_{i}</annotation></semantics></math>, this implies that the power of <math id="S6.p15.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> dividing <math id="S6.p15.m8" class="ltx_Math" alttext="\Disc(f)" display="inline" intent=":literal"><semantics><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Disc(f)</annotation></semantics></math> is bounded above by <math id="S6.p15.m9" class="ltx_Math" alttext="2\sum_{i=1}^{d-1}(ia-e_{i})" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2\sum_{i=1}^{d-1}(ia-e_{i})</annotation></semantics></math>.
∎</p>
</div>
<div id="S6.p16" class="ltx_para ltx_noindent">
<p id="S6.p16.1" class="ltx_p">6.6.
<span id="S6.p16.1.1" class="ltx_text ltx_font_bold">Lemma. —</span>  <span id="S6.p16.1.2" class="ltx_text ltx_font_italic">
Consider the universal binary <math id="S6.p16.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-ic form <math id="S6.p16.m2" class="ltx_Math" alttext="F=F_{0}x^{d}+\dots+F_{d}y^{d}\in\mathbb{Z}[F_{0},\dots,F_{d}]" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mrow><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><msub><mi>F</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow></mrow><mo>∈</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>F</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>F</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F=F_{0}x^{d}+\dots+F_{d}y^{d}\in\mathbb{Z}[F_{0},\dots,F_{d}]</annotation></semantics></math>. The monomial <math id="S6.p16.m3" class="ltx_Math" alttext="F_{1}^{2}\dots F_{d-1}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>F</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">F_{1}^{2}\dots F_{d-1}^{2}</annotation></semantics></math> occurs in the polynomial <math id="S6.p16.m4" class="ltx_Math" alttext="\Disc(F)" display="inline" intent=":literal"><semantics><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Disc(F)</annotation></semantics></math>.
</span></p>
</div>
<div id="S6.p17" class="ltx_para ltx_noindent">
<p id="S6.p17.1" class="ltx_p"><span id="S6.p17.1.1" class="ltx_text ltx_font_italic">Proof. </span>This is a completely formal statement. The discriminant <math id="S6.p17.m1" class="ltx_Math" alttext="\Disc(F)" display="inline" intent=":literal"><semantics><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Disc(F)</annotation></semantics></math> of
<math id="S6.p17.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> with respect to <math id="S6.p17.m3" class="ltx_Math" alttext="(x,y)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x,y)</annotation></semantics></math> is a polynomial in the (symbolic) coefficients <math id="S6.p17.m4" class="ltx_Math" alttext="F_{i}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>i</mi></msub><annotation encoding="application/x-tex">F_{i}</annotation></semantics></math>
of total degree <math id="S6.p17.m5" class="ltx_Math" alttext="2d-2" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2d-2</annotation></semantics></math>. The statement of the lemma is about a term in
this polynomial. Let <math id="S6.p17.m6" class="ltx_Math" alttext="G=F_{1}x^{d-2}+\dots+F_{d-1}y^{d-2}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mrow><msub><mi>F</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><msub><mi>F</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">G=F_{1}x^{d-2}+\dots+F_{d-1}y^{d-2}</annotation></semantics></math>.
From <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">GKZ</a>, p. 407, Equation 1.41]</cite> we have:</p>
<table id="S6.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex32.m1" class="ltx_Math" alttext="\Disc(F)(0,F_{1},\dots,F_{d-1},0)=\Disc(G)F_{1}^{2}F_{d-1}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>F</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>F</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Disc(F)(0,F_{1},\dots,F_{d-1},0)=\Disc(G)F_{1}^{2}F_{d-1}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p17.2" class="ltx_p">The proof concludes via induction on <math id="S6.p17.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> (with base cases <math id="S6.p17.m8" class="ltx_Math" alttext="d=2,3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d=2,3</annotation></semantics></math> obvious).
∎</p>
</div>
<div id="S6.p18" class="ltx_para">
<p id="S6.p18.1" class="ltx_p">Hence <math id="S6.p18.m1" class="ltx_Math" alttext="C=\underline{\operatorname{Spec}}\;{\mathscr{A}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><munder accentunder="true"><mi>Spec</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.167em" rspace="0em">​</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow></mrow><annotation encoding="application/x-tex">C=\underline{\operatorname{Spec}}\;{\mathscr{A}}</annotation></semantics></math> is regular (hence normal) above <math id="S6.p18.m2" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>, so <math id="S6.p18.m3" class="ltx_Math" alttext="C\rightarrow C^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>C</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">C\rightarrow C^{\prime}</annotation></semantics></math> must be the normalization. (Recall from Claim <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> that <math id="S6.p18.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> was normal away from <math id="S6.p18.m5" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.)</p>
</div>
<div id="S6.p19" class="ltx_para ltx_noindent">
<p id="S6.p19.1" class="ltx_p">6.7.
<span id="S6.p19.1.1" class="ltx_text ltx_font_italic">Completion of proof of Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</span> 
To complete the proof of Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we simply observe that <math id="S6.p19.m1" class="ltx_math_unparsed" alttext="{\mathscr{A}}=\pi_{*}{\mathscr{O}}_{C}=\oplus_{i=0}^{d-1}E_{i}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>=</mo><mi>π</mi><msub><mrow></mrow><mo>∗</mo></msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mrow></mrow><mi>C</mi></msub><mo rspace="0em">=</mo><mo lspace="0em">⊕</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>E</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">{\mathscr{A}}=\pi_{*}{\mathscr{O}}_{C}=\oplus_{i=0}^{d-1}E_{i}</annotation></semantics></math>, where <math id="S6.p19.m2" class="ltx_Math" alttext="E_{i}\cong{\mathscr{O}}(-e_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>i</mi></msub><mo>≅</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{i}\cong{\mathscr{O}}(-e_{i})</annotation></semantics></math>. ∎</p>
</div>
<div id="S6.p20" class="ltx_para">
<p id="S6.p20.1" class="ltx_p">(We also now immediately see that <math id="S6.p20.m1" class="ltx_Math" alttext="h^{0}(C,{\mathscr{O}}_{C})=\sum_{i=0}^{d-1}h^{0}(\mathbb{P}^{1},\oplus{\mathscr{O}}(-e_{i}))=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo rspace="0em">,</mo><mrow><mo lspace="0em">⊕</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h^{0}(C,{\mathscr{O}}_{C})=\sum_{i=0}^{d-1}h^{0}(\mathbb{P}^{1},\oplus{\mathscr{O}}(-e_{i}))=1</annotation></semantics></math>, fulfilling a promise in the proof of Claim <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.)</p>
</div>
<div id="S6.p21" class="ltx_para ltx_noindent">
<p id="S6.p21.1" class="ltx_p">6.8.
<span id="S6.p21.1.1" class="ltx_text ltx_font_bold">Generalizations of the construction.</span> 

In the proof of Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we started with a concave sequence <math id="S6.p21.m1" class="ltx_Math" alttext="(0,e_{1},\dots,e_{d-1},0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,e_{1},\dots,e_{d-1},0)</annotation></semantics></math>, considered certain binary forms <math id="S6.p21.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> such that <math id="S6.p21.m3" class="ltx_Math" alttext="t^{ai-e_{i}}\mid f_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>t</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow></msup><mo fence="false">|</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">t^{ai-e_{i}}\mid f_{i}</annotation></semantics></math>, and showed that the scrollar invariants of the normalization were given by <math id="S6.p21.m4" class="ltx_Math" alttext="(e_{1},\dots,e_{d-1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e_{1},\dots,e_{d-1})</annotation></semantics></math>. More generally, given any <math id="S6.p21.m5" class="ltx_Math" alttext="(a_{0},\dots,a_{d})\in\mathbb{Z}_{\geq 0}^{d+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">(a_{0},\dots,a_{d})\in\mathbb{Z}_{\geq 0}^{d+1}</annotation></semantics></math> and a form <math id="S6.p21.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> such that <math id="S6.p21.m7" class="ltx_Math" alttext="t^{a_{i}}\mid f_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>t</mi><msub><mi>a</mi><mi>i</mi></msub></msup><mo fence="false">|</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">t^{a_{i}}\mid f_{i}</annotation></semantics></math>, we compute the scrollar invariants of the normalization below.</p>
</div>
<div id="S6.p22" class="ltx_para">
<p id="S6.p22.1" class="ltx_p">Let <math id="S6.p22.m1" class="ltx_Math" alttext="f\in\operatorname{Sym}^{d}({\mathscr{O}}\oplus{\mathscr{O}}(a))\otimes{\mathscr{O}}(k)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><mrow><msup><mi>Sym</mi><mi>d</mi></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⊕</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in\operatorname{Sym}^{d}({\mathscr{O}}\oplus{\mathscr{O}}(a))\otimes{\mathscr{O}}(k)</annotation></semantics></math> and write</p>
<table id="S6.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex33.m1" class="ltx_Math" alttext="f=f_{0}x^{d}+\dots+f_{d}y^{d}," display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>=</mo><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><msub><mi>f</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f=f_{0}x^{d}+\dots+f_{d}y^{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p22.2" class="ltx_p">again in “toric coordinates” where <math id="S6.p22.m2" class="ltx_Math" alttext="f_{i}\in\mathbb{C}[s,t]" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>∈</mo><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{i}\in\mathbb{C}[s,t]</annotation></semantics></math> is a homogeneous polynomial of degree <math id="S6.p22.m3" class="ltx_Math" alttext="k+ia" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">k+ia</annotation></semantics></math>. The construction of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx37" title="" class="ltx_ref">W</a>, Thm. 1.2]</cite> associates to <math id="S6.p22.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> a finite flat morphism <math id="S6.p22.m5" class="ltx_Math" alttext="\pi:C^{\prime}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>C</mi><mo>′</mo></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi:C^{\prime}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> (note that <math id="S6.p22.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> can even be the zero form). Let <math id="S6.p22.m7" class="ltx_Math" alttext="\{(i,b_{i})\}_{0\leq i\leq d}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><msub><mi>b</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">\{(i,b_{i})\}_{0\leq i\leq d}</annotation></semantics></math> be the lower convex hull of <math id="S6.p22.m8" class="ltx_Math" alttext="\{(i,a_{i})\}_{0\leq i\leq d}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">\{(i,a_{i})\}_{0\leq i\leq d}</annotation></semantics></math>.</p>
</div>
<div id="S6.p23" class="ltx_para ltx_noindent">
<p id="S6.p23.1" class="ltx_p">6.9.
<span id="S6.p23.1.1" class="ltx_text ltx_font_bold">Theorem (“general <math id="S6.p23.m1" class="ltx_Math" alttext="(a_{0},\dots,a_{d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{0},\dots,a_{d})</annotation></semantics></math>”). —</span>  <span id="S6.p23.1.2" class="ltx_text ltx_font_italic">
If <math id="S6.p23.m2" class="ltx_Math" alttext="t^{a_{i}}\mid f_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>t</mi><msub><mi>a</mi><mi>i</mi></msub></msup><mo fence="false">|</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">t^{a_{i}}\mid f_{i}</annotation></semantics></math>, then there exists a curve <math id="S6.p23.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> and a birational morphism <math id="S6.p23.m4" class="ltx_Math" alttext="C\rightarrow C^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>C</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">C\rightarrow C^{\prime}</annotation></semantics></math> such that the composition <math id="S6.p23.m5" class="ltx_Math" alttext="C\rightarrow C^{\prime}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>C</mi><mo>′</mo></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C\rightarrow C^{\prime}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> has scrollar invariants</span></p>
<table id="S6.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex34.m1" class="ltx_Math" alttext="(\deg(f_{1})-\lfloor b_{1}\rfloor,\dots,\deg(f_{d-1})-\lfloor b_{d-1}\rfloor)." display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>b</mi><mn>1</mn></msub><mo stretchy="false">⌋</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>b</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">⌋</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\deg(f_{1})-\lfloor b_{1}\rfloor,\dots,\deg(f_{d-1})-\lfloor b_{d-1}\rfloor).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p23.2" class="ltx_p"><span id="S6.p23.2.1" class="ltx_text ltx_font_italic">Now suppose <math id="S6.p23.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is general subject to the constraint that <math id="S6.p23.m7" class="ltx_Math" alttext="t^{a_{i}}\mid f_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>t</mi><msub><mi>a</mi><mi>i</mi></msub></msup><mo fence="false">|</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">t^{a_{i}}\mid f_{i}</annotation></semantics></math>. If <math id="S6.p23.m8" class="ltx_Math" alttext="\deg(f_{i})\geq a_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\deg(f_{i})\geq a_{i}</annotation></semantics></math> for all <math id="S6.p23.m9" class="ltx_Math" alttext="0\leq i\leq d" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">0\leq i\leq d</annotation></semantics></math> and <math id="S6.p23.m10" class="ltx_Math" alttext="\deg(f_{i})-b_{i}\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg(f_{i})-b_{i}\geq 1</annotation></semantics></math> for all <math id="S6.p23.m11" class="ltx_Math" alttext="1\leq i\leq d-1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq d-1</annotation></semantics></math>, then <math id="S6.p23.m12" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is smooth and irreducible.
</span></p>
</div>
<div id="S6.p24" class="ltx_para ltx_noindent">
<p id="S6.p24.1" class="ltx_p">6.10.
<span id="S6.p24.1.1" class="ltx_text ltx_font_italic">Remark: how we used Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> to prove Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</span>  
Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> is simply the case of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> where <math id="S6.p24.m1" class="ltx_Math" alttext="k=0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k=0</annotation></semantics></math> and <math id="S6.p24.m2" class="ltx_Math" alttext="a=e_{1}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">a=e_{1}</annotation></semantics></math>, and <math id="S6.p24.m3" class="ltx_Math" alttext="a_{i}=ai-e_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">a_{i}=ai-e_{i}</annotation></semantics></math>. The concavity of <math id="S6.p24.m4" class="ltx_Math" alttext="(0,e_{1},\dots,e_{d-1},0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,e_{1},\dots,e_{d-1},0)</annotation></semantics></math> now implies that <math id="S6.p24.m5" class="ltx_Math" alttext="b_{i}=ia-e_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>=</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">b_{i}=ia-e_{i}</annotation></semantics></math>, so</p>
<table id="S6.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex35.m1" class="ltx_Math" alttext="\deg(f_{i})-b_{i}=(k+ai)-(ia-e_{i})=e_{i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>−</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\deg(f_{i})-b_{i}=(k+ai)-(ia-e_{i})=e_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.p25" class="ltx_para">
<p id="S6.p25.1" class="ltx_p">A natural question is: can we use Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> to produce even more scrollar invariants? The answer is yes: when <math id="S6.p25.m1" class="ltx_Math" alttext="d=6" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">d=6</annotation></semantics></math>, the scrollar invariant <math id="S6.p25.m2" class="ltx_Math" alttext="(1,1,1,2,2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1,1,2,2)</annotation></semantics></math> does <em id="S6.p25.1.1" class="ltx_emph ltx_font_italic">not</em> arise from Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> as it is not concave (and no reordering is concave). However, it does arise from Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>: simply take <math id="S6.p25.m3" class="ltx_Math" alttext="k=2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k=2</annotation></semantics></math>, <math id="S6.p25.m4" class="ltx_Math" alttext="a=0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a=0</annotation></semantics></math>, and <math id="S6.p25.m5" class="ltx_Math" alttext="(a_{0},\dots,a_{6})=(2,2,1,1,0,0,0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a_{0},\dots,a_{6})=(2,2,1,1,0,0,0)</annotation></semantics></math>. One can easily generalize this example to any degree <math id="S6.p25.m6" class="ltx_Math" alttext="d\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">d\geq 4</annotation></semantics></math>. (There is also an example for <math id="S6.p25.m7" class="ltx_Math" alttext="d=5" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">d=5</annotation></semantics></math>, but it is more complicated to explain.)</p>
</div>
<div id="S6.p26" class="ltx_para">
<p id="S6.p26.1" class="ltx_p">Sadly, although Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> allows us to construct scrollar invariants not present in Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, it does not obtain a larger proportion of <math id="S6.p26.m1" class="ltx_Math" alttext="\mathcal{P}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{d}</annotation></semantics></math>, as <math id="S6.p26.m2" class="ltx_Math" alttext="g\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">g\rightarrow\infty</annotation></semantics></math>, as compared to the current approach. This can be checked via a lengthy computation, but this argument is not relevant to our discussion here.</p>
</div>
<div id="S6.p27" class="ltx_para ltx_noindent">
<p id="S6.p27.1" class="ltx_p">6.11.
<span id="S6.p27.1.1" class="ltx_text ltx_font_italic">Proof of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</span> 
The <math id="S6.p27.m1" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebra structure of <math id="S6.p27.m2" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>C</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C^{\prime}}</annotation></semantics></math> is described in Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx37" title="" class="ltx_ref">W</a>, §3]</cite>). Define the locally free sheaf</p>
<table id="S6.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex36.m1" class="ltx_Math" alttext="{\mathscr{A}}={\mathscr{O}}_{\mathbb{P}^{1}}\oplus t^{-\lfloor b_{1}\rfloor}{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})\oplus\dots\oplus t^{-\lfloor b_{d-1}\rfloor}{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{d-1})." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathscript">𝒜</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo>⊕</mo><mrow><msup><mi>t</mi><mrow><mo>−</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>b</mi><mn>1</mn></msub><mo stretchy="false">⌋</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mi mathvariant="normal">⋯</mi><mo>⊕</mo><mrow><msup><mi>t</mi><mrow><mo>−</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>b</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">⌋</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathscr{A}}={\mathscr{O}}_{\mathbb{P}^{1}}\oplus t^{-\lfloor b_{1}\rfloor}{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{1})\oplus\dots\oplus t^{-\lfloor b_{d-1}\rfloor}{\mathscr{O}}_{\mathbb{P}^{1}}(-e_{d-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p27.2" class="ltx_p">Observe that <math id="S6.p27.m3" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C^{\prime}}\subseteq{\mathscr{A}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>C</mi><mo>′</mo></msup></msub></mrow><mo>⊆</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C^{\prime}}\subseteq{\mathscr{A}}</annotation></semantics></math>. The multiplication map on <math id="S6.p27.m4" class="ltx_Math" alttext="\pi_{*}{\mathscr{O}}_{C^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>C</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">\pi_{*}{\mathscr{O}}_{C^{\prime}}</annotation></semantics></math> extends to an <math id="S6.p27.m5" class="ltx_Math" alttext="{\mathscr{O}}_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathscr{O}}_{\mathbb{P}^{1}}</annotation></semantics></math>-algebra structure on <math id="S6.p27.m6" class="ltx_Math" alttext="{\mathscr{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒜</mi><annotation encoding="application/x-tex">{\mathscr{A}}</annotation></semantics></math>; this can be seen by easily generalizing the computation in §<a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Thus as before,</p>
<table id="S6.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex37.m1" class="ltx_Math" alttext="C\coloneq\underline{\operatorname{Spec}}\;{\mathscr{A}}\rightarrow\underline{\operatorname{Spec}}\;\pi_{*}{\mathscr{O}}_{C^{\prime}}=C^{\prime}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>≔</mo><mrow><munder accentunder="true"><mi>Spec</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.167em" rspace="0em">​</mo><mi class="ltx_font_mathscript">𝒜</mi></mrow><mo stretchy="false">→</mo><mrow><munder accentunder="true"><mi>Spec</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msup><mi>C</mi><mo>′</mo></msup></msub></mrow><mo>=</mo><msup><mi>C</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">C\coloneq\underline{\operatorname{Spec}}\;{\mathscr{A}}\rightarrow\underline{\operatorname{Spec}}\;\pi_{*}{\mathscr{O}}_{C^{\prime}}=C^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p27.3" class="ltx_p">is a birational morphism, and an isomorphism away from <math id="S6.p27.m7" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>. This completes the proof of the first part of the theorem.</p>
</div>
<div id="S6.p28" class="ltx_para">
<p id="S6.p28.1" class="ltx_p">Now suppose <math id="S6.p28.m1" class="ltx_Math" alttext="\deg(f_{i})\geq a_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\deg(f_{i})\geq a_{i}</annotation></semantics></math> for all <math id="S6.p28.m2" class="ltx_Math" alttext="0\leq i\leq d" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">0\leq i\leq d</annotation></semantics></math> and <math id="S6.p28.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is general subject to the constraint that <math id="S6.p28.m4" class="ltx_Math" alttext="t^{a_{i}}\mid f_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>t</mi><msub><mi>a</mi><mi>i</mi></msub></msup><mo fence="false">|</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">t^{a_{i}}\mid f_{i}</annotation></semantics></math>. The resulting linear system is base-point-free away from <math id="S6.p28.m5" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>, and thus <math id="S6.p28.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is smooth away from <math id="S6.p28.m7" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>. Consider the commutative diagram:</p>
<table id="S6.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S6.Ex38.m1.pic1" class="ltx_picture ltx_markedasmath" height="116.7" overflow="visible" style="vertical-align:-57.73px" version="1.1" viewBox="0 0 116.54 116.7" width="116.54"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,116.7) matrix(1 0 0 -1 0 0) translate(58.27,0) translate(0,57.74)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -58.27 -52.67)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 115.47)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 14.52)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(20.98,0) matrix(1.0 0.0 0.0 1.0 -15.02 0)"><foreignObject style="--ltx-fo-width:1.17em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces C_{\ell}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces C_{\ell}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 44.33 0) translate(51.53,0) matrix(1.0 0.0 0.0 1.0 -12.36 0)"><foreignObject style="--ltx-fo-width:0.79em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces C}" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces C}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 62.04)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(20.98,0) matrix(1.0 0.0 0.0 1.0 -15.02 0)"><foreignObject style="--ltx-fo-width:1.17em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="16.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces C^{\prime}_{\ell}}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces C^{\prime}_{\ell}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 42.39 0) translate(53.47,0) matrix(1.0 0.0 0.0 1.0 -14.3 0)"><foreignObject style="--ltx-fo-width:1.07em;--ltx-fo-height:0.75em;--ltx-fo-depth:0em;font-size:10pt;" height="10.4" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="14.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces C^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces C^{\prime}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 110.41)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0.29 0) translate(20.69,0) matrix(1.0 0.0 0.0 1.0 -14.73 0)"><foreignObject style="--ltx-fo-width:1.13em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="15.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m5" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathbb{P}^{1}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 41.96 0) translate(53.9,0) matrix(1.0 0.0 0.0 1.0 -14.73 0)"><foreignObject style="--ltx-fo-width:1.13em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="15.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m6" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathbb{P}^{1}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -16.04 46.67 L 18.44 46.67"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 18.71 46.67)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -1.43 51.81)"><foreignObject style="--ltx-fo-width:0.42em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\gamma}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">γ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\gamma}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -37.29 35.8 L -37.29 12"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -37.29 11.72)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -46.29 22.48)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\rho}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">ρ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\rho}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 37.58 37.87 L 37.58 12"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 37.58 11.72)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 40.84 22.24)"><foreignObject style="--ltx-fo-width:0.48em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m9" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\phi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">ϕ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\phi}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -16.04 -0.84 L 16.49 -0.84"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 16.77 -0.84)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -37.29 -11.71 L -37.29 -35.51"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -37.29 -35.79)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -45.65 -25.98)"><foreignObject style="--ltx-fo-width:0.37em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m11" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\tau}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">τ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\tau}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 37.58 -9.64 L 37.58 -35.51"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 37.58 -35.79)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 40.84 -24.94)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="6.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m12" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\pi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">π</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\pi}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -16.33 -49.21 L 16.06 -49.21"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 16.34 -49.21)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -7.18 -44.49)"><foreignObject style="--ltx-fo-width:1.06em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.11em;font-size:10pt;" height="5.64" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="14.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex38.m1.pic1.m13" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces m_{\ell}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">m</mi><mi mathsize="0.710em" mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces m_{\ell}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p28.2" class="ltx_p">where <math id="S6.p28.m8" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> is the least common multiple of the denominators of <math id="S6.p28.m9" class="ltx_Math" alttext="b_{i}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>i</mi></msub><annotation encoding="application/x-tex">b_{i}</annotation></semantics></math>, and <math id="S6.p28.m10" class="ltx_Math" alttext="m_{\ell}\colon\mathbb{P}^{1}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">m_{\ell}\colon\mathbb{P}^{1}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> sends <math id="S6.p28.m11" class="ltx_math_unparsed" alttext="[u:v]\rightarrow[u^{\ell}:v^{\ell}]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>v</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">[u:v]\rightarrow[u^{\ell}:v^{\ell}]</annotation></semantics></math>, and <math id="S6.p28.m12" class="ltx_Math" alttext="C^{\prime}_{\ell}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">C^{\prime}_{\ell}</annotation></semantics></math> is the pullback of the bottom square. Let <math id="S6.p28.m13" class="ltx_Math" alttext="C_{\ell}\rightarrow C^{\prime}_{\ell}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">→</mo><msubsup><mi>C</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">C_{\ell}\rightarrow C^{\prime}_{\ell}</annotation></semantics></math> and <math id="S6.p28.m14" class="ltx_Math" alttext="C\rightarrow C^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>C</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">C\rightarrow C^{\prime}</annotation></semantics></math> be the partial normalization maps as described above. Note that the top square need not be a pullback diagram.</p>
</div>
<div id="S6.p29" class="ltx_para ltx_noindent">
<p id="S6.p29.1" class="ltx_p">6.12.
<span id="S6.p29.1.1" class="ltx_text ltx_font_bold">Claim. —</span>  <span id="S6.p29.1.2" class="ltx_text ltx_font_italic">The morphism <math id="S6.p29.m1" class="ltx_Math" alttext="\tau\circ\rho\colon C_{\ell}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ρ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\tau\circ\rho\colon C_{\ell}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> is unramified above <math id="S6.p29.m2" class="ltx_Math" alttext="u=0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u=0</annotation></semantics></math>.</span></p>
</div>
<div id="S6.p30" class="ltx_para ltx_noindent">
<p id="S6.p30.1" class="ltx_p"><span id="S6.p30.1.1" class="ltx_text ltx_font_italic">Proof. </span>Because <math id="S6.p30.m1" class="ltx_Math" alttext="C^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>′</mo></msup><annotation encoding="application/x-tex">C^{\prime}</annotation></semantics></math> is defined by an equation of the form</p>
<table id="S6.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex39.m1" class="ltx_Math" alttext="f(x,y)=t^{a_{0}}g_{0}(s,t)x^{d}+\dots+t^{a_{d}}g_{d}(s,t)y^{d}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>t</mi><msub><mi>a</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><msup><mi>t</mi><msub><mi>a</mi><mi>d</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f(x,y)=t^{a_{0}}g_{0}(s,t)x^{d}+\dots+t^{a_{d}}g_{d}(s,t)y^{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p30.2" class="ltx_p">we have that <math id="S6.p30.m2" class="ltx_Math" alttext="C^{\prime}_{\ell}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">C^{\prime}_{\ell}</annotation></semantics></math> is defined by an equation of the form</p>
<table id="S6.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex40.m1" class="ltx_Math" alttext="f_{\ell}(x,y)=u^{\ell a_{0}}g_{0}(u^{\ell},v^{\ell})x^{d}+\dots+u^{\ell a_{d}}g_{d}(u^{\ell},v^{\ell})y^{d}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>u</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>0</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><msup><mi>u</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>d</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{\ell}(x,y)=u^{\ell a_{0}}g_{0}(u^{\ell},v^{\ell})x^{d}+\dots+u^{\ell a_{d}}g_{d}(u^{\ell},v^{\ell})y^{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.p31" class="ltx_para">
<p id="S6.p31.1" class="ltx_p">Let <math id="S6.p31.m1" class="ltx_Math" alttext="F=U^{\ell a_{0}}G_{0}x^{d}+\dots+U^{\ell a_{d}}G_{d}y^{d}\in\mathbb{C}[U,G_{0},\dots,G_{d}]" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mrow><msup><mi>U</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>0</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><msup><mi>U</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>d</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow></mrow><mo>∈</mo><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>U</mi><mo>,</mo><msub><mi>G</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F=U^{\ell a_{0}}G_{0}x^{d}+\dots+U^{\ell a_{d}}G_{d}y^{d}\in\mathbb{C}[U,G_{0},\dots,G_{d}]</annotation></semantics></math> be the universal such form.</p>
</div>
<div id="S6.p32" class="ltx_para ltx_noindent">
<p id="S6.p32.1" class="ltx_p">6.13.
<span id="S6.p32.1.1" class="ltx_text ltx_font_bold">Sub-claim. —</span>   <span id="S6.p32.1.2" class="ltx_text ltx_font_italic">We have <math id="S6.p32.m1" class="ltx_Math" alttext="\Disc(F)=U^{2\sum_{i=1}^{d-1}\ell b_{i}}H(U,G_{0},\dots,G_{d})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>U</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><msub><mi>G</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Disc(F)=U^{2\sum_{i=1}^{d-1}\ell b_{i}}H(U,G_{0},\dots,G_{d})</annotation></semantics></math>
for a polynomial <math id="S6.p32.m2" class="ltx_Math" alttext="H\in\mathbb{C}[U,G_{0},\dots,G_{d}]" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>∈</mo><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>U</mi><mo>,</mo><msub><mi>G</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H\in\mathbb{C}[U,G_{0},\dots,G_{d}]</annotation></semantics></math> which is not divisible by <math id="S6.p32.m3" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.
</span></p>
</div>
<div id="S6.p33" class="ltx_para ltx_noindent">
<p id="S6.p33.1" class="ltx_p"><span id="S6.p33.1.1" class="ltx_text ltx_font_italic">Proof. </span>Let <math id="S6.p33.m1" class="ltx_Math" alttext="v_{U}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>U</mi></msub><annotation encoding="application/x-tex">v_{U}</annotation></semantics></math> be the <math id="S6.p33.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>-adic valuation on <math id="S6.p33.m3" class="ltx_Math" alttext="\mathbb{C}[U,G_{0},\dots,G_{d}]" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>U</mi><mo>,</mo><msub><mi>G</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{C}[U,G_{0},\dots,G_{d}]</annotation></semantics></math>. It suffices to show that</p>
<table id="S6.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex41.m1" class="ltx_Math" alttext="v_{U}(\Disc(F))=2\sum_{i=1}^{d-1}\ell b_{i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">v_{U}(\Disc(F))=2\sum_{i=1}^{d-1}\ell b_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p33.2" class="ltx_p">Let <math id="S6.p33.m4" class="ltx_Math" alttext="\alpha_{1},\dots,\alpha_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>α</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{1},\dots,\alpha_{d}</annotation></semantics></math> be the roots of <math id="S6.p33.m5" class="ltx_Math" alttext="F(x,1)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(x,1)</annotation></semantics></math>, ordered so that <math id="S6.p33.m6" class="ltx_Math" alttext="v_{U}(\alpha_{1})\leq\dots\leq v_{U}(\alpha_{d})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi mathvariant="normal">⋯</mi><mo>≤</mo><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{U}(\alpha_{1})\leq\dots\leq v_{U}(\alpha_{d})</annotation></semantics></math>. We have that</p>
<table id="S6.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex42.m1" class="ltx_Math" alttext="\Disc(F)=\left(U^{\ell a_{0}}\right)^{2d-2}\prod_{i&lt;j}(\alpha_{i}-\alpha_{j})^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><msup><mi>U</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>0</mn></msub></mrow></msup><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow></munder><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>i</mi></msub><mo>−</mo><msub><mi>α</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Disc(F)=\left(U^{\ell a_{0}}\right)^{2d-2}\prod_{i&lt;j}(\alpha_{i}-\alpha_{j})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p33.3" class="ltx_p">Because the lower convex hull of the points <math id="S6.p33.m7" class="ltx_Math" alttext="(i,\ell a_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,\ell a_{i})</annotation></semantics></math> is exactly <math id="S6.p33.m8" class="ltx_Math" alttext="(i,\ell b_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,\ell b_{i})</annotation></semantics></math>, we have <math id="S6.p33.m9" class="ltx_Math" alttext="a_{0}=b_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>=</mo><msub><mi>b</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">a_{0}=b_{0}</annotation></semantics></math>. Moreover, by the theory of Newton polygons, we have <math id="S6.p33.m10" class="ltx_Math" alttext="v_{U}(\alpha_{i})=\ell(b_{i}-b_{i-1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>−</mo><msub><mi>b</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{U}(\alpha_{i})=\ell(b_{i}-b_{i-1})</annotation></semantics></math>. Moreover, because <math id="S6.p33.m11" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is the universal such form, we have</p>
<table id="S6.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(19)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E19.m1" class="ltx_Math" alttext="v_{U}(\alpha_{i}-\alpha_{j})=\min(v_{U}(\alpha_{i}),v_{U}(\alpha_{j}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>i</mi></msub><mo>−</mo><msub><mi>α</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">v_{U}(\alpha_{i}-\alpha_{j})=\min(v_{U}(\alpha_{i}),v_{U}(\alpha_{j})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p33.4" class="ltx_p">Computing <math id="S6.p33.m12" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>-adic valuations, we see that</p>
<table id="S6.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(20)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E20.m1" class="ltx_Math" alttext="v_{U}(\Disc(F))=(\ell a_{0})(2d-2)+2\sum_{i&lt;j}\min(v_{U}(\alpha_{i}),v_{U}(\alpha_{j}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow></munder><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">v_{U}(\Disc(F))=(\ell a_{0})(2d-2)+2\sum_{i&lt;j}\min(v_{U}(\alpha_{i}),v_{U}(\alpha_{j})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p33.5" class="ltx_p">Expanding out the last term, we see that:</p>
<table id="S6.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(21)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E21.m1" class="ltx_Math" alttext="\sum_{i&lt;j}\min(v_{U}(\alpha_{i}),v_{U}(\alpha_{j}))=\sum_{i&lt;j}v_{U}(\alpha_{i})=\ell\sum_{i&lt;j}(b_{i}-b_{i-1})=\ell\sum_{i=1}^{d-1}(d-i)(b_{i}-b_{i-1})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow></munder><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow></munder><mrow><msub><mi>v</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow></munder><mrow><mo stretchy="false">(</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>−</mo><msub><mi>b</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>−</mo><msub><mi>b</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i&lt;j}\min(v_{U}(\alpha_{i}),v_{U}(\alpha_{j}))=\sum_{i&lt;j}v_{U}(\alpha_{i})=\ell\sum_{i&lt;j}(b_{i}-b_{i-1})=\ell\sum_{i=1}^{d-1}(d-i)(b_{i}-b_{i-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p33.6" class="ltx_p">Now, a short computation shows that</p>
<table id="S6.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex43.m1" class="ltx_Math" alttext="(\ell b_{0})(2d-2)+2\ell\sum_{i=1}^{d-1}(d-i)(b_{i}-b_{i-1})=2\sum_{i=1}^{d-1}\ell b_{i}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>−</mo><msub><mi>b</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(\ell b_{0})(2d-2)+2\ell\sum_{i=1}^{d-1}(d-i)(b_{i}-b_{i-1})=2\sum_{i=1}^{d-1}\ell b_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p33.7" class="ltx_p">as required.
∎</p>
</div>
<div id="S6.p34" class="ltx_para">
<p id="S6.p34.1" class="ltx_p">Evaluating on <math id="S6.p34.m1" class="ltx_Math" alttext="f_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">f_{\ell}</annotation></semantics></math> we obtain:</p>
<table id="S6.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex44.m1" class="ltx_Math" alttext="\Disc(f_{\ell})=u^{2\sum_{i=1}^{d-1}\ell b_{i}}H(u,g_{0}(u^{\ell},v^{\ell}),\dots,g_{d}(u^{\ell},v^{\ell}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>u</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mrow><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>g</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Disc(f_{\ell})=u^{2\sum_{i=1}^{d-1}\ell b_{i}}H(u,g_{0}(u^{\ell},v^{\ell}),\dots,g_{d}(u^{\ell},v^{\ell})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p34.2" class="ltx_p">Because <math id="S6.p34.m2" class="ltx_Math" alttext="\deg(f_{i})\geq a_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\deg(f_{i})\geq a_{i}</annotation></semantics></math>, all the <math id="S6.p34.m3" class="ltx_Math" alttext="g_{i}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>i</mi></msub><annotation encoding="application/x-tex">g_{i}</annotation></semantics></math> have nonnegative degree, and so for a general choice of <math id="S6.p34.m4" class="ltx_Math" alttext="g_{0},\dots,g_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>g</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">g_{0},\dots,g_{d}</annotation></semantics></math>, the polynomial <math id="S6.p34.m5" class="ltx_Math" alttext="H(u,g_{0}(u^{\ell},v^{\ell}),\dots,g_{d}(u^{\ell},v^{\ell}))" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mrow><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>g</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(u,g_{0}(u^{\ell},v^{\ell}),\dots,g_{d}(u^{\ell},v^{\ell}))</annotation></semantics></math> will not be divisible by <math id="S6.p34.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>. Therefore the ramification divisor of <math id="S6.p34.m7" class="ltx_Math" alttext="\tau:C_{\ell}^{\prime}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>C</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\tau:C_{\ell}^{\prime}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> has degree precisely <math id="S6.p34.m8" class="ltx_Math" alttext="2\sum_{i=1}^{d-1}\ell b_{i}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">2\sum_{i=1}^{d-1}\ell b_{i}</annotation></semantics></math> at <math id="S6.p34.m9" class="ltx_Math" alttext="u=0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u=0</annotation></semantics></math>.</p>
</div>
<div id="S6.p35" class="ltx_para">
<p id="S6.p35.1" class="ltx_p">The scrollar invariants of <math id="S6.p35.m1" class="ltx_Math" alttext="\tau:C_{\ell}^{\prime}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>C</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\tau:C_{\ell}^{\prime}\rightarrow\mathbb{P}^{1}</annotation></semantics></math>, again by Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, are <math id="S6.p35.m2" class="ltx_Math" alttext="(\ell\deg(f_{1}),\dots,\ell\deg(f_{d-1}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\ell\deg(f_{1}),\dots,\ell\deg(f_{d-1}))</annotation></semantics></math>. Now, by definition the scrollar invariants of <math id="S6.p35.m3" class="ltx_Math" alttext="\tau\circ\rho\colon C_{\ell}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ρ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\tau\circ\rho\colon C_{\ell}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> are:</p>
<table id="S6.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex45.m1" class="ltx_Math" alttext="(\ell\deg(f_{1})-\ell b_{1},\dots,\ell\deg(f_{d-1})-\ell b_{d-1})." display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\ell\deg(f_{1})-\ell b_{1},\dots,\ell\deg(f_{d-1})-\ell b_{d-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p35.2" class="ltx_p">Hence the degree of the ramification divisor of <math id="S6.p35.m4" class="ltx_Math" alttext="\tau\circ\rho\colon C_{\ell}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ρ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\tau\circ\rho\colon C_{\ell}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> at <math id="S6.p35.m5" class="ltx_Math" alttext="u=0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u=0</annotation></semantics></math> is <math id="S6.p35.m6" class="ltx_Math" alttext="2\sum_{i=1}^{d-1}\ell b_{i}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">2\sum_{i=1}^{d-1}\ell b_{i}</annotation></semantics></math> less than that of <math id="S6.p35.m7" class="ltx_Math" alttext="C_{\ell}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">C_{\ell}^{\prime}</annotation></semantics></math>, and hence <math id="S6.p35.m8" class="ltx_Math" alttext="C_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">C_{\ell}</annotation></semantics></math> is unramified above <math id="S6.p35.m9" class="ltx_Math" alttext="u=0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u=0</annotation></semantics></math>.
∎</p>
</div>
<div id="S6.p36" class="ltx_para ltx_noindent">
<p id="S6.p36.1" class="ltx_p">6.14.
<span id="S6.p36.1.1" class="ltx_text ltx_font_bold">Completion of the proof of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</span> 
Because <math id="S6.p36.m1" class="ltx_Math" alttext="\tau\circ\rho\colon C_{\ell}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ρ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\tau\circ\rho\colon C_{\ell}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> is unramified, the points of <math id="S6.p36.m2" class="ltx_Math" alttext="C_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">C_{\ell}</annotation></semantics></math> above <math id="S6.p36.m3" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math> in the map <math id="S6.p36.m4" class="ltx_Math" alttext="m_{\ell}\circ\tau\circ\rho=\pi\circ\phi\circ\gamma" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>τ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ρ</mi></mrow><mo>=</mo><mrow><mi>π</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ϕ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>γ</mi></mrow></mrow><annotation encoding="application/x-tex">m_{\ell}\circ\tau\circ\rho=\pi\circ\phi\circ\gamma</annotation></semantics></math> are smooth.</p>
</div>
<div id="S6.p37" class="ltx_para">
<p id="S6.p37.1" class="ltx_p">There is a natural inclusion <math id="S6.p37.m1" class="ltx_Math" alttext="{\mathscr{O}}_{C}\subseteq\gamma_{*}{\mathscr{O}}_{C_{\ell}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><mo>⊆</mo><mrow><msub><mi>γ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{O}}_{C}\subseteq\gamma_{*}{\mathscr{O}}_{C_{\ell}}</annotation></semantics></math> which pushes forward to an inclusion</p>
<table id="S6.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex46.m1" class="ltx_Math" alttext="(\pi\circ\phi)_{*}{\mathscr{O}}_{C}\subset(\pi\circ\phi\circ\gamma)_{*}{\mathscr{O}}_{C_{\ell}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ϕ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo>⊂</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ϕ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">(\pi\circ\phi)_{*}{\mathscr{O}}_{C}\subset(\pi\circ\phi\circ\gamma)_{*}{\mathscr{O}}_{C_{\ell}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p37.2" class="ltx_p">Restricting to the affine line <math id="S6.p37.m2" class="ltx_Math" alttext="\mathbb{A}^{1}=\mathbb{P}^{1}\setminus\infty" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔸</mi><mn>1</mn></msup><mo>=</mo><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo>∖</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{A}^{1}=\mathbb{P}^{1}\setminus\infty</annotation></semantics></math> and taking global sections, we have that</p>
<table id="S6.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex47.m1" class="ltx_Math" alttext="\Gamma(\mathbb{A}^{1},(\pi\circ\phi)_{*}{\mathscr{O}}_{C})\subset\Gamma(\mathbb{A}^{1},(\pi\circ\phi\circ\gamma)_{*}{\mathscr{O}}_{C_{\ell}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔸</mi><mn>1</mn></msup><mo>,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ϕ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔸</mi><mn>1</mn></msup><mo>,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ϕ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Gamma(\mathbb{A}^{1},(\pi\circ\phi)_{*}{\mathscr{O}}_{C})\subset\Gamma(\mathbb{A}^{1},(\pi\circ\phi\circ\gamma)_{*}{\mathscr{O}}_{C_{\ell}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p37.3" class="ltx_p">By construction,</p>
<table id="S6.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex48.m1" class="ltx_Math" alttext="\Gamma(\mathbb{A}^{1},(\pi\circ\phi)_{*}{\mathscr{O}}_{C})=\Gamma(\mathbb{A}^{1},(\pi\circ\phi\circ\gamma)_{*}{\mathscr{O}}_{C_{\ell}})\cap K(C)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔸</mi><mn>1</mn></msup><mo>,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ϕ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔸</mi><mn>1</mn></msup><mo>,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ϕ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Gamma(\mathbb{A}^{1},(\pi\circ\phi)_{*}{\mathscr{O}}_{C})=\Gamma(\mathbb{A}^{1},(\pi\circ\phi\circ\gamma)_{*}{\mathscr{O}}_{C_{\ell}})\cap K(C).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p37.4" class="ltx_p">The last equality shows that the smoothness of <math id="S6.p37.m3" class="ltx_Math" alttext="C_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">C_{\ell}</annotation></semantics></math> implies the smoothness of <math id="S6.p37.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> above <math id="S6.p37.m5" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.</p>
</div>
<div id="S6.p38" class="ltx_para">
<p id="S6.p38.1" class="ltx_p">Finally, <math id="S6.p38.m1" class="ltx_Math" alttext="h^{0}(C,{\mathscr{O}}_{C})=h^{0}(\mathbb{P}^{1},{\mathscr{O}})+\sum_{i=1}^{d-1}h^{0}(\mathbb{P}^{1},\oplus{\mathscr{O}}(b_{i}-\deg(f_{i})))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo>,</mo><mi class="ltx_font_mathscript">𝒪</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo rspace="0em">,</mo><mrow><mo lspace="0em">⊕</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{0}(C,{\mathscr{O}}_{C})=h^{0}(\mathbb{P}^{1},{\mathscr{O}})+\sum_{i=1}^{d-1}h^{0}(\mathbb{P}^{1},\oplus{\mathscr{O}}(b_{i}-\deg(f_{i})))</annotation></semantics></math>. If <math id="S6.p38.m2" class="ltx_Math" alttext="\deg(f_{i})-b_{i}\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg(f_{i})-b_{i}\geq 1</annotation></semantics></math> for all <math id="S6.p38.m3" class="ltx_Math" alttext="1\leq i\leq d-1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq d-1</annotation></semantics></math>, then <math id="S6.p38.m4" class="ltx_Math" alttext="h^{0}(C,{\mathscr{O}}_{C})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒪</mi><mi>C</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h^{0}(C,{\mathscr{O}}_{C})=1</annotation></semantics></math> so <math id="S6.p38.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is irreducible.
∎</p>
</div>
<div id="S6.p39" class="ltx_para">
<p id="S6.p39.1" class="ltx_p">There is one more trick we may play to construct <em id="S6.p39.1.1" class="ltx_emph ltx_font_italic">even more</em> scrollar invariants — we may start with singularities above multiple points of <math id="S6.p39.m1" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>. More precisely if <math id="S6.p39.m2" class="ltx_Math" alttext="\ell_{1},\dots,\ell_{m}\in\mathbb{C}[s,t]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>m</mi></msub><mo>∈</mo><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell_{1},\dots,\ell_{m}\in\mathbb{C}[s,t]</annotation></semantics></math> are linear forms with distinct roots, then in the notation as in Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we obtain the following theorem, whose proof is the obvious generalization of that of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div>
<div id="S6.p40" class="ltx_para ltx_noindent">
<p id="S6.p40.1" class="ltx_p">6.15.
<span id="S6.p40.1.1" class="ltx_text ltx_font_bold">Theorem (“multiple points of the base”). —</span>    <span id="S6.p40.1.2" class="ltx_text ltx_font_italic">Fix <math id="S6.p40.m1" class="ltx_Math" alttext="(a^{1}_{0},\dots,a^{1}_{d}),\dots,(a^{m}_{0},\dots,a^{m}_{d})\in\mathbb{Z}_{\geq 0}^{d+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>0</mn><mn>1</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>a</mi><mi>d</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>0</mn><mi>m</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>a</mi><mi>d</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">(a^{1}_{0},\dots,a^{1}_{d}),\dots,(a^{m}_{0},\dots,a^{m}_{d})\in\mathbb{Z}_{\geq 0}^{d+1}</annotation></semantics></math> and let <math id="S6.p40.m2" class="ltx_Math" alttext="b_{i}^{j}" display="inline" intent=":literal"><semantics><msubsup><mi>b</mi><mi>i</mi><mi>j</mi></msubsup><annotation encoding="application/x-tex">b_{i}^{j}</annotation></semantics></math> be the lower convex hull. If <math id="S6.p40.m3" class="ltx_Math" alttext="\ell_{j}^{a_{i}^{j}}\mid f_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">ℓ</mi><mi>j</mi><msubsup><mi>a</mi><mi>i</mi><mi>j</mi></msubsup></msubsup><mo fence="false">|</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\ell_{j}^{a_{i}^{j}}\mid f_{i}</annotation></semantics></math> for all <math id="S6.p40.m4" class="ltx_Math" alttext="i,j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i,j</annotation></semantics></math>, then there exists a curve <math id="S6.p40.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> and a birational morphism <math id="S6.p40.m6" class="ltx_Math" alttext="C\rightarrow C^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>C</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">C\rightarrow C^{\prime}</annotation></semantics></math> such that the composition <math id="S6.p40.m7" class="ltx_Math" alttext="C\rightarrow C^{\prime}\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>C</mi><mo>′</mo></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">C\rightarrow C^{\prime}\rightarrow\mathbb{P}^{1}</annotation></semantics></math> has scrollar invariants</span></p>
<table id="S6.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex49.m1" class="ltx_Math" alttext="(\deg(f_{1})-\sum_{j}b_{1}^{j},\dots,\deg(f_{d-1})-\sum_{j}b_{d-1}^{j})." display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder><msubsup><mi>b</mi><mn>1</mn><mi>j</mi></msubsup></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder><msubsup><mi>b</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\deg(f_{1})-\sum_{j}b_{1}^{j},\dots,\deg(f_{d-1})-\sum_{j}b_{d-1}^{j}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p40.2" class="ltx_p"><span id="S6.p40.2.1" class="ltx_text ltx_font_italic">Now suppose the <math id="S6.p40.m8" class="ltx_Math" alttext="\ell_{j}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\ell_{j}</annotation></semantics></math> are general and <math id="S6.p40.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is general subject to the constraint that <math id="S6.p40.m10" class="ltx_Math" alttext="\ell_{j}^{a^{j}_{i}}\mid f_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">ℓ</mi><mi>j</mi><msubsup><mi>a</mi><mi>i</mi><mi>j</mi></msubsup></msubsup><mo fence="false">|</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\ell_{j}^{a^{j}_{i}}\mid f_{i}</annotation></semantics></math>. If <math id="S6.p40.m11" class="ltx_Math" alttext="\deg(f_{i})\geq\sum_{j}a^{j}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><msubsup><mi>a</mi><mi>i</mi><mi>j</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\deg(f_{i})\geq\sum_{j}a^{j}_{i}</annotation></semantics></math> for all <math id="S6.p40.m12" class="ltx_Math" alttext="0\leq i\leq d" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">0\leq i\leq d</annotation></semantics></math> and <math id="S6.p40.m13" class="ltx_Math" alttext="\deg(f_{i})-\sum_{j}b^{j}_{i}\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><msubsup><mi>b</mi><mi>i</mi><mi>j</mi></msubsup></mrow></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg(f_{i})-\sum_{j}b^{j}_{i}\geq 1</annotation></semantics></math> for all <math id="S6.p40.m14" class="ltx_Math" alttext="1\leq i\leq d-1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq d-1</annotation></semantics></math>, then <math id="S6.p40.m15" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is smooth and irreducible.
</span></p>
</div>
<div id="S6.p41" class="ltx_para ltx_noindent">
<p id="S6.p41.1" class="ltx_p">6.16.
<span id="S6.p41.1.1" class="ltx_text ltx_font_italic">Proof of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</span> 
The proof of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> is almost identical to that of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. The only additional difficulty is checking smoothness above the vanishing of the <math id="S6.p41.m1" class="ltx_Math" alttext="\ell_{j}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\ell_{j}</annotation></semantics></math>; in other words, we need to prove that if the <math id="S6.p41.m2" class="ltx_Math" alttext="\ell_{j}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\ell_{j}</annotation></semantics></math> are general and <math id="S6.p41.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is general subject to the given constraint and <math id="S6.p41.m4" class="ltx_Math" alttext="\deg(f_{i})\geq\sum_{j}a^{j}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><msubsup><mi>a</mi><mi>i</mi><mi>j</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\deg(f_{i})\geq\sum_{j}a^{j}_{i}</annotation></semantics></math> for all <math id="S6.p41.m5" class="ltx_Math" alttext="0\leq i\leq d" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">0\leq i\leq d</annotation></semantics></math> and <math id="S6.p41.m6" class="ltx_Math" alttext="\deg(f_{i})-\sum_{j}b^{j}_{i}\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><msubsup><mi>b</mi><mi>i</mi><mi>j</mi></msubsup></mrow></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg(f_{i})-\sum_{j}b^{j}_{i}\geq 1</annotation></semantics></math> for all <math id="S6.p41.m7" class="ltx_Math" alttext="1\leq i\leq d-1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq d-1</annotation></semantics></math>, then <math id="S6.p41.m8" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is smooth. Suppose without loss of generality that <math id="S6.p41.m9" class="ltx_Math" alttext="\ell_{1}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\ell_{1}=t</annotation></semantics></math>.</p>
</div>
<div id="S6.p42" class="ltx_para">
<p id="S6.p42.1" class="ltx_p">Following the idea behind the proof of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, let <math id="S6.p42.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> be the least common multiple of the <math id="S6.p42.m2" class="ltx_Math" alttext="b^{1}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>b</mi><mi>i</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">b^{1}_{i}</annotation></semantics></math>. Consider the commutative diagram as in the proof of Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> where now <math id="S6.p42.m3" class="ltx_Math" alttext="C_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">C_{\ell}</annotation></semantics></math> is the given partial normalization above <math id="S6.p42.m4" class="ltx_Math" alttext="\ell_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\ell_{1}</annotation></semantics></math>. Then <math id="S6.p42.m5" class="ltx_Math" alttext="C_{\ell}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">C_{\ell}^{\prime}</annotation></semantics></math> is defined by the equation</p>
<table id="S6.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex50.m1" class="ltx_Math" alttext="f_{\ell}(x,y)=u^{\ell a_{0}^{1}}\Big(\prod_{j=2}^{m}\ell_{j}(u^{\ell},v^{\ell})^{a_{0}^{j}}\Big)g_{0}(u^{\ell},v^{\ell})x^{d}+\dots+u^{\ell a_{d}^{1}}\Big(\prod_{j=2}^{m}\ell_{j}(u^{\ell},v^{\ell})^{a_{d}^{j}}\Big)g_{d}(u^{\ell},v^{\ell})y^{d}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>u</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mn>0</mn><mn>1</mn></msubsup></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>2</mn></mrow><mi>m</mi></munderover><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><msubsup><mi>a</mi><mn>0</mn><mi>j</mi></msubsup></msup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><msup><mi>u</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mi>d</mi><mn>1</mn></msubsup></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>2</mn></mrow><mi>m</mi></munderover><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><msubsup><mi>a</mi><mi>d</mi><mi>j</mi></msubsup></msup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{\ell}(x,y)=u^{\ell a_{0}^{1}}\Big(\prod_{j=2}^{m}\ell_{j}(u^{\ell},v^{\ell})^{a_{0}^{j}}\Big)g_{0}(u^{\ell},v^{\ell})x^{d}+\dots+u^{\ell a_{d}^{1}}\Big(\prod_{j=2}^{m}\ell_{j}(u^{\ell},v^{\ell})^{a_{d}^{j}}\Big)g_{d}(u^{\ell},v^{\ell})y^{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.p43" class="ltx_para">
<p id="S6.p43.1" class="ltx_p">As before, let <math id="S6.p43.m1" class="ltx_Math" alttext="F\in\mathbb{C}[U,L_{2},\dots,L_{m},G_{0},\dots,G_{d}]" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><mrow><mi>ℂ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>U</mi><mo>,</mo><msub><mi>L</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>L</mi><mi>m</mi></msub><mo>,</mo><msub><mi>G</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\in\mathbb{C}[U,L_{2},\dots,L_{m},G_{0},\dots,G_{d}]</annotation></semantics></math> be the universal such form. We have that</p>
<table id="S6.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex51.m1" class="ltx_Math" alttext="\Disc(F)=U^{2\sum_{i=1}^{d-1}\ell b_{i}^{1}}H(U,L_{2},\dots,L_{m},G_{0},\dots,G_{d})" display="block" intent=":literal"><semantics><mrow><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>U</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mi>i</mi><mn>1</mn></msubsup></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><msub><mi>L</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>L</mi><mi>m</mi></msub><mo>,</mo><msub><mi>G</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Disc(F)=U^{2\sum_{i=1}^{d-1}\ell b_{i}^{1}}H(U,L_{2},\dots,L_{m},G_{0},\dots,G_{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p43.2" class="ltx_p">for some polynomial <math id="S6.p43.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> which is not divisible by <math id="S6.p43.m3" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. Evaluating on <math id="S6.p43.m4" class="ltx_Math" alttext="f_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">f_{\ell}</annotation></semantics></math>, we get</p>
<table id="S6.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex52.m1" class="ltx_Math" alttext="\Disc(f_{\ell})=u^{2\sum_{i=1}^{d-1}\ell b_{i}^{1}}H(u,\ell_{2}(u^{\ell},v^{\ell}),\dots,\ell_{m}(u^{\ell},v^{\ell}),g_{0}(u^{\ell},v^{\ell}),\dots,g_{d}(u^{\ell},v^{\ell}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>u</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mi>i</mi><mn>1</mn></msubsup></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>g</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Disc(f_{\ell})=u^{2\sum_{i=1}^{d-1}\ell b_{i}^{1}}H(u,\ell_{2}(u^{\ell},v^{\ell}),\dots,\ell_{m}(u^{\ell},v^{\ell}),g_{0}(u^{\ell},v^{\ell}),\dots,g_{d}(u^{\ell},v^{\ell})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p43.3" class="ltx_p">Because <math id="S6.p43.m5" class="ltx_Math" alttext="\deg(f_{i})\geq\sum_{j}a^{j}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><msubsup><mi>a</mi><mi>i</mi><mi>j</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\deg(f_{i})\geq\sum_{j}a^{j}_{i}</annotation></semantics></math> for all <math id="S6.p43.m6" class="ltx_Math" alttext="0\leq i\leq d" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">0\leq i\leq d</annotation></semantics></math>, we have that <math id="S6.p43.m7" class="ltx_Math" alttext="\deg(g_{i})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\deg(g_{i})\geq 0</annotation></semantics></math>. Similarly, <math id="S6.p43.m8" class="ltx_Math" alttext="\deg(\ell_{j})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg(\ell_{j})=1</annotation></semantics></math>, so a general choice of <math id="S6.p43.m9" class="ltx_Math" alttext="\ell_{j}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\ell_{j}</annotation></semantics></math> and <math id="S6.p43.m10" class="ltx_Math" alttext="g_{i}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>i</mi></msub><annotation encoding="application/x-tex">g_{i}</annotation></semantics></math> ensures that the polynomial</p>
<table id="S6.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex53.m1" class="ltx_Math" alttext="H(u,\ell_{2}(u^{\ell},v^{\ell}),\dots,\ell_{m}(u^{\ell},v^{\ell}),g_{0}(u^{\ell},v^{\ell}),\dots,g_{d}(u^{\ell},v^{\ell}))" display="block" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>g</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mi mathvariant="normal">ℓ</mi></msup><mo>,</mo><msup><mi>v</mi><mi mathvariant="normal">ℓ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(u,\ell_{2}(u^{\ell},v^{\ell}),\dots,\ell_{m}(u^{\ell},v^{\ell}),g_{0}(u^{\ell},v^{\ell}),\dots,g_{d}(u^{\ell},v^{\ell}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p43.4" class="ltx_p">is indivisible by <math id="S6.p43.m11" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>. Proceeding as in Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> completes the proof of the theorem.
∎</p>
</div>
<div id="S6.p44" class="ltx_para">
<p id="S6.p44.1" class="ltx_p">Remarkably, Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> <em id="S6.p44.1.1" class="ltx_emph ltx_font_italic">does</em> produce a new positive proportion of <math id="S6.p44.m1" class="ltx_Math" alttext="\mathcal{P}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{d}</annotation></semantics></math>, but we are still unable to fill <math id="S6.p44.m2" class="ltx_Math" alttext="\mathcal{P}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{d}</annotation></semantics></math> for all <math id="S6.p44.m3" class="ltx_Math" alttext="d\geq 5" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">d\geq 5</annotation></semantics></math>. For example, suppose we wanted to obtain the scrollar invariants <math id="S6.p44.m4" class="ltx_Math" alttext="(3,3,3,5,5)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(3,3,3,5,5)</annotation></semantics></math>. It is <em id="S6.p44.1.2" class="ltx_emph ltx_font_italic">not</em> possible to get these scrollar invariants by using only Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Indeed if we apply Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> to <math id="S6.p44.m5" class="ltx_Math" alttext="k=5" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k=5</annotation></semantics></math>, <math id="S6.p44.m6" class="ltx_Math" alttext="a=0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a=0</annotation></semantics></math>, and <math id="S6.p44.m7" class="ltx_Math" alttext="(a_{0},\dots,a_{6})=(0,0,0,2,2,4,4)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a_{0},\dots,a_{6})=(0,0,0,2,2,4,4)</annotation></semantics></math>, and then the corresponding normalization will have the scrollar invariants <math id="S6.p44.m8" class="ltx_Math" alttext="(2,3,4,5,5)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2,3,4,5,5)</annotation></semantics></math>. However if we instead apply Theorem <a href="#S6" title="6. All concave scrollar invariants (a positive proportion of the polytope 
        
          
            
            P
            d
          
        
      ) are achieved ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> with <math id="S6.p44.m9" class="ltx_Math" alttext="m=2" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">m=2</annotation></semantics></math> and <math id="S6.p44.m10" class="ltx_Math" alttext="(a^{j}_{0},\dots,a^{j}_{6})=(0,0,0,1,1,2,2)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>0</mn><mi>j</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>a</mi><mn>6</mn><mi>j</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a^{j}_{0},\dots,a^{j}_{6})=(0,0,0,1,1,2,2)</annotation></semantics></math> for <math id="S6.p44.m11" class="ltx_Math" alttext="j=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j=1,2</annotation></semantics></math>, then we obtain the desired scrollar invariants.</p>
</div>
</section>
<section id="S7" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">7. </span>The image of <math id="S7.m1" class="ltx_Math" alttext="\operatorname{Tsch}:\mathcal{H}ur_{d,g}\rightarrow\mathcal{B}un_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><mrow><mi>Tsch</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><mo stretchy="false">→</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Tsch}:\mathcal{H}ur_{d,g}\rightarrow\mathcal{B}un_{\mathbb{P}^{1}}</annotation></semantics></math> is not preserved under generization (<math id="S7.m2" class="ltx_math_unparsed" alttext="d&gt;4,g\gg_{d}1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&gt;</mo><mn>4</mn><mo>,</mo><mi>g</mi><mo>≫</mo><msub><mrow></mrow><mi>d</mi></msub><mn>1</mn></mrow><annotation encoding="application/x-tex">d&gt;4,g\gg_{d}1</annotation></semantics></math>)</h2>

<div id="S7.p1" class="ltx_para">
<p id="S7.p1.1" class="ltx_p">In low genus (<math id="S7.p1.m1" class="ltx_Math" alttext="2g+1\leq d" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">2g+1\leq d</annotation></semantics></math>), the image of <math id="S7.p1.m2" class="ltx_Math" alttext="\operatorname{Tsch}:\mathcal{H}ur_{d,g}\rightarrow\mathcal{B}un_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><mrow><mi>Tsch</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><mo stretchy="false">→</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Tsch}:\mathcal{H}ur_{d,g}\rightarrow\mathcal{B}un_{\mathbb{P}^{1}}</annotation></semantics></math> is preserved under generization. This is because the image of the map <math id="S7.p1.m3" class="ltx_Math" alttext="\operatorname{Tsch}" display="inline" intent=":literal"><semantics><mi>Tsch</mi><annotation encoding="application/x-tex">\operatorname{Tsch}</annotation></semantics></math> is a single point, and the corresponding bundle <math id="S7.p1.m4" class="ltx_Math" alttext="{\mathscr{O}}(e_{1})\oplus\dots\oplus{\mathscr{O}}(e_{d-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mi mathvariant="normal">⋯</mi><mo>⊕</mo><mrow><mi class="ltx_font_mathscript">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{O}}(e_{1})\oplus\dots\oplus{\mathscr{O}}(e_{d-1})</annotation></semantics></math> has no nontrivial generization because <math id="S7.p1.m5" class="ltx_Math" alttext="e_{d-1}-e_{1}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e_{d-1}-e_{1}\leq 1</annotation></semantics></math> (see Proposition <a href="#S2" title="2. Warm-up: Low degree (
        
          
            ≤
            d
            3
          
        
      ) and low genus (
        
          
            ≤
            
              +
              
                ⁢
                2
                g
              
              1
            
            d
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). Likewise, in low degree (<math id="S7.p1.m6" class="ltx_Math" alttext="d\leq 4" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≤</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">d\leq 4</annotation></semantics></math>), the image of <math id="S7.p1.m7" class="ltx_Math" alttext="\operatorname{Tsch}" display="inline" intent=":literal"><semantics><mi>Tsch</mi><annotation encoding="application/x-tex">\operatorname{Tsch}</annotation></semantics></math> is also preserved under generization. This is trivial for <math id="S7.p1.m8" class="ltx_Math" alttext="d=2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d=2</annotation></semantics></math>, and follows from §<a href="#S2" title="2. Warm-up: Low degree (
        
          
            ≤
            d
            3
          
        
      ) and low genus (
        
          
            ≤
            
              +
              
                ⁢
                2
                g
              
              1
            
            d
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and Theorem <a href="#S3" title="3. Key Example: Quartic covers (
        
          
            =
            d
            4
          
        
      ) ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> respectively when <math id="S7.p1.m9" class="ltx_Math" alttext="d=3,4" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>=</mo><mn>3</mn></mrow><mo>,</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">d=3,4</annotation></semantics></math>. In this section we prove that when <math id="S7.p1.m10" class="ltx_Math" alttext="d\geq 5" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">d\geq 5</annotation></semantics></math> and <math id="S7.p1.m11" class="ltx_math_unparsed" alttext="g\gg_{d}1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≫</mo><msub><mrow></mrow><mi>d</mi></msub><mn>1</mn></mrow><annotation encoding="application/x-tex">g\gg_{d}1</annotation></semantics></math>, the image of <math id="S7.p1.m12" class="ltx_Math" alttext="\operatorname{Tsch}" display="inline" intent=":literal"><semantics><mi>Tsch</mi><annotation encoding="application/x-tex">\operatorname{Tsch}</annotation></semantics></math> is <em id="S7.p1.1.1" class="ltx_emph ltx_font_italic">not</em> preserved under generization, i.e. that there exists a smooth curve whose Tschirnhausen bundle admits a generization which does <em id="S7.p1.1.2" class="ltx_emph ltx_font_italic">not</em> arise as the Tschirnhausen bundle of a smooth curve. Along the way, we also prove that when <math id="S7.p1.m13" class="ltx_Math" alttext="d\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">d\geq 4</annotation></semantics></math> and <math id="S7.p1.m14" class="ltx_math_unparsed" alttext="g\gg_{d}1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≫</mo><msub><mrow></mrow><mi>d</mi></msub><mn>1</mn></mrow><annotation encoding="application/x-tex">g\gg_{d}1</annotation></semantics></math>, the image of <math id="S7.p1.m15" class="ltx_Math" alttext="\operatorname{Tsch}" display="inline" intent=":literal"><semantics><mi>Tsch</mi><annotation encoding="application/x-tex">\operatorname{Tsch}</annotation></semantics></math> restricted to primitive covers is also not preserved under generization.</p>
</div>
<div id="S7.p2" class="ltx_para ltx_noindent">
<p id="S7.p2.1" class="ltx_p">7.1.
<span id="S7.p2.1.1" class="ltx_text ltx_font_bold">Proposition. —</span>   <span id="S7.p2.1.2" class="ltx_text ltx_font_italic">If <math id="S7.p2.m1" class="ltx_Math" alttext="d\geq 5" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">d\geq 5</annotation></semantics></math>, then for <math id="S7.p2.m2" class="ltx_math_unparsed" alttext="g\gg_{d}1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≫</mo><msub><mrow></mrow><mi>d</mi></msub><mn>1</mn></mrow><annotation encoding="application/x-tex">g\gg_{d}1</annotation></semantics></math>, the image of <math id="S7.p2.m3" class="ltx_Math" alttext="\operatorname{Tsch}:\mathcal{H}ur_{d,g}\rightarrow\mathcal{B}un_{\mathbb{P}^{1}}" display="inline" intent=":literal"><semantics><mrow><mi>Tsch</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><mo stretchy="false">→</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><msup><mi>ℙ</mi><mn>1</mn></msup></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Tsch}:\mathcal{H}ur_{d,g}\rightarrow\mathcal{B}un_{\mathbb{P}^{1}}</annotation></semantics></math> is not preserved under generization.</span></p>
</div>
<div id="S7.p3" class="ltx_para ltx_noindent">
<p id="S7.p3.1" class="ltx_p"><span id="S7.p3.1.1" class="ltx_text ltx_font_italic">Proof. </span>Suppose <math id="S7.p3.m1" class="ltx_Math" alttext="(e_{1},e_{2},\dots,e_{d-1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e_{1},e_{2},\dots,e_{d-1})</annotation></semantics></math> is a concave nondecreasing sequence of positive integers, with <math id="S7.p3.m2" class="ltx_Math" alttext="e_{1}=a" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>=</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">e_{1}=a</annotation></semantics></math>, <math id="S7.p3.m3" class="ltx_Math" alttext="e_{2}=2a" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">e_{2}=2a</annotation></semantics></math>, <math id="S7.p3.m4" class="ltx_Math" alttext="e_{3}=3a" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>3</mn></msub><mo>=</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">e_{3}=3a</annotation></semantics></math>, <math id="S7.p3.m5" class="ltx_Math" alttext="e_{4}\geq 3a+5" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>4</mn></msub><mo>≥</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>+</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">e_{4}\geq 3a+5</annotation></semantics></math> (where <math id="S7.p3.m6" class="ltx_Math" alttext="a\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">a\in\mathbb{Z}</annotation></semantics></math>, <math id="S7.p3.m7" class="ltx_Math" alttext="a\geq 5" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≥</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">a\geq 5</annotation></semantics></math>). Then by Theorem <a href="#S1" title="1. Introduction ‣ Tschirnhausen bundles of covers of the projective line" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, there is a primitive cover <math id="S7.p3.m8" class="ltx_Math" alttext="\pi:C\rightarrow\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi:C\rightarrow\mathbb{P}^{1}</annotation></semantics></math> by a smooth curve with Tschirnhausen bundle <math id="S7.p3.m9" class="ltx_math_unparsed" alttext="{\mathscr{E}}_{\pi}\cong\oplus_{i=1}^{d-1}{\mathscr{O}}(e_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">ℰ</mi><mi>π</mi></msub><mo rspace="0em">≅</mo><msubsup><mo lspace="0em">⊕</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi class="ltx_font_mathscript">𝒪</mi><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathscr{E}}_{\pi}\cong\oplus_{i=1}^{d-1}{\mathscr{O}}(e_{i})</annotation></semantics></math>. If <math id="S7.p3.m10" class="ltx_Math" alttext="(e^{\prime}_{1},\dots,e^{\prime}_{d-1})=(e_{1},e_{2}+1,e_{3}+2,e_{4}-3,e_{5},\dots,e_{d-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>e</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>e</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><msub><mi>e</mi><mn>3</mn></msub><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mrow><msub><mi>e</mi><mn>4</mn></msub><mo>−</mo><mn>3</mn></mrow><mo>,</mo><msub><mi>e</mi><mn>5</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(e^{\prime}_{1},\dots,e^{\prime}_{d-1})=(e_{1},e_{2}+1,e_{3}+2,e_{4}-3,e_{5},\dots,e_{d-1})</annotation></semantics></math>, then the bundle <math id="S7.p3.m11" class="ltx_math_unparsed" alttext="\oplus_{i=1}^{d-1}{\mathscr{O}}(e^{\prime}_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>⊕</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mi class="ltx_font_mathscript">𝒪</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>e</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\oplus_{i=1}^{d-1}{\mathscr{O}}(e^{\prime}_{i})</annotation></semantics></math> is <span id="S7.p3.1.2" class="ltx_text ltx_font_italic">not</span> the Tschirnhausen bundle of a cover (Lemma <a href="#S7" title="7. The image of 
        
          
            :
            Tsch
            
              →
              
                ⁢
                H
                u
                
                  
