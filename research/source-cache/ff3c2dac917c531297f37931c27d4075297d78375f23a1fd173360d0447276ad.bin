671-0407:S2050508624000246:S2050508624000246_inline537.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$n'\\leq 13$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. Since we assume \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline538.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"56\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline538.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$n \\leq 11$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, no \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline539.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"50\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline539.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\overline {\\mathcal {M}}}_{1,n'}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E with \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline540.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"63\" height=\"17\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline540.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$n' \\geq 14$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E appears as a factor in a component of the normalized boundary. It follows that, \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline541.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"133\" height=\"27\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline541.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{k-2}(\\widetilde {\\partial {\\mathcal {M}}_{3,n}})^{\\mathrm {ss}}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E is a polynomial in \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline542.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"9\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline542.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathsf {L}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E and \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline543.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"27\" height=\"17\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline543.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. By [\u003Ca class=\"xref bibr\" href=\"#r5\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Canning and Larson\u003C\u002Fspan\u003E5\u003C\u002Fa\u003E, Theorem 1.4], \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline544.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"47\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline544.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathcal {M}}_{3,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E has the CKgP and \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline545.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"195\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline545.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$A^*({\\mathcal {M}}_{3,n}) = R^*({\\mathcal {M}}_{3,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline546.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"56\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline546.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$n \\leq 11$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. Thus, \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline547.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"246\" height=\"24\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline547.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$W_k H^k({\\mathcal {M}}_{3,n})=RH^k({\\mathcal {M}}_{3,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E by Lemma \u003Ca class=\"xref statement\" href=\"#lemma4\"\u003E4.3\u003C\u002Fa\u003E. Hence, \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline548.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"117\" height=\"24\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline548.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$W_k H^k({\\mathcal {M}}_{3,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E is pure Hodge–Tate, and the theorem follows.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"sec\" data-magellan-destination=\"sec9\" id=\"sec9\"\u003E\n\n\u003Ch2 class=\"A\"\u003E\u003Cspan class=\"label\"\u003E5\u003C\u002Fspan\u003E The CKgP in genus 7 with at most three marked points\u003C\u002Fh2\u003E\n\u003Cp class=\"p\"\u003E In order to prove Theorems \u003Ca class=\"xref statement\" href=\"#theorem1\"\u003E1.1\u003C\u002Fa\u003E, \u003Ca class=\"xref statement\" href=\"#theorem3\"\u003E1.5\u003C\u002Fa\u003E(3) for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline549.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"55\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline549.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$k = 14$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E and \u003Ca class=\"xref statement\" href=\"#theorem5\"\u003E1.7\u003C\u002Fa\u003E, we need more base cases in genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline550.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline550.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$7$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. The required base cases are given by Theorem \u003Ca class=\"xref statement\" href=\"#theorem7\"\u003E1.10\u003C\u002Fa\u003E, which we now prove.\u003C\u002Fp\u003E\n\u003Cp class=\"p\"\u003E In order to prove Theorem \u003Ca class=\"xref statement\" href=\"#theorem7\"\u003E1.10\u003C\u002Fa\u003E, we filter \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline551.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"47\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline551.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathcal {M}}_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E by gonality: \u003C\u002Fp\u003E\u003Cdiv data-mathjax-status=\"texmath alt-graphic\" class=\"disp-formula\" data-magellan-destination=\"eqnU31\" id=\"eqnU31\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu31.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"273\" height=\"29\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu31.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$$\\begin{align*}\\mathcal{M}^{2}_{7,n}\\subset \\mathcal{M}^{3}_{7,n}\\subset \\mathcal{M}^4_{7,n} \\subset \\mathcal{M}^{5}_{7,n}. \\end{align*}$$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003EHere, \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline552.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"47\" height=\"28\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline552.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {M}^{k}_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E is the locus parametrizing smooth curves \u003Cem class=\"italic\"\u003EC\u003C\u002Fem\u003E with \u003Cem class=\"italic\"\u003En\u003C\u002Fem\u003E marked points that admit a map of degree at most \u003Cem class=\"italic\"\u003Ek\u003C\u002Fem\u003E to \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline553.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"17\" height=\"18\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline553.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathbb {P}^1$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. Standard results from Brill–Noether theory show that the maximal gonality of a genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline554.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline554.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$7$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E curve is \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline555.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"9\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline555.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$5$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. By Proposition \u003Ca class=\"xref statement\" href=\"#proposition5\"\u003E4.2\u003C\u002Fa\u003E(3), to show that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline556.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"47\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline556.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathcal {M}}_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E has the CKgP, it suffices to show that each gonality stratum \u003C\u002Fp\u003E\u003Cdiv data-mathjax-status=\"texmath alt-graphic\" class=\"disp-formula\" data-magellan-destination=\"eqnU32\" id=\"eqnU32\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu32.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"116\" height=\"29\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu32.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$$\\begin{align*}\\mathcal{M}^k_{7,n}\\smallsetminus \\mathcal{M}^{k-1}_{7,n} \\end{align*}$$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003Ehas the CKgP. Moreover, to show that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline557.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"195\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline557.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$A^*({\\mathcal {M}}_{7,n})=R^*({\\mathcal {M}}_{7,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, it suffices to show for each \u003Cem class=\"italic\"\u003Ek\u003C\u002Fem\u003E, that all classes supported on \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline558.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"47\" height=\"28\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline558.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {M}^k_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E are tautological up to classes supported on \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline559.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"50\" height=\"28\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline559.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {M}^{k-1}_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. In other words, we must show that every class in \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline560.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"155\" height=\"28\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline560.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$A^*({\\mathcal {M}}_{7,n}^k \\smallsetminus {\\mathcal {M}}_{7,n}^{k-1})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E pushes forward to a class in \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline561.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"155\" height=\"28\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline561.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$A^*({\\mathcal {M}}_{7,n} \\smallsetminus \\mathcal {M}^{k-1}_ {7,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E that is the restriction of a tautological class on \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline562.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"47\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline562.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathcal {M}}_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003Cdiv class=\"sec\" data-magellan-destination=\"sec10\" id=\"sec10\"\u003E\n\n\u003Ch3 class=\"B\"\u003E\u003Cspan class=\"label\"\u003E5.1\u003C\u002Fspan\u003E Hyperelliptic and trigonal loci\u003C\u002Fh3\u003E\n\u003Cp class=\"p\"\u003E By [\u003Ca class=\"xref bibr\" href=\"#r5\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Canning and Larson\u003C\u002Fspan\u003E5\u003C\u002Fa\u003E, Lemma 9.9], if \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline563.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"57\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline563.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$n\\leq 14$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, then \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline564.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"47\" height=\"28\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline564.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {M}^3_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E has the CKgP and all classes in \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline565.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"84\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline565.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$A^*({\\mathcal {M}}_{7,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E supported on \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline566.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"47\" height=\"28\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline566.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {M}^3_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E are tautological. Note that this includes the hyperelliptic locus.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"sec\" data-magellan-destination=\"sec11\" id=\"sec11\"\u003E\n\n\u003Ch3 class=\"B\"\u003E\u003Cspan class=\"label\"\u003E5.2\u003C\u002Fspan\u003E The tetragonal locus\u003C\u002Fh3\u003E\n\u003Cp class=\"p\"\u003E To study the tetragonal locus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline567.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"113\" height=\"28\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline567.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {M}^4_{7,n}\\smallsetminus \\mathcal {M}^3_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, we will use the Hurwitz stack \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline568.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"54\" height=\"22\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline568.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {H}_{4,g,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E parametrizing degree \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline569.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline569.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$4$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E covers \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline570.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"92\" height=\"23\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline570.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$f\\colon C\\rightarrow \\mathbb {P}^1$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, where \u003Cem class=\"italic\"\u003EC\u003C\u002Fem\u003E is a smooth curve of genus \u003Cem class=\"italic\"\u003Eg\u003C\u002Fem\u003E with \u003Cem class=\"italic\"\u003En\u003C\u002Fem\u003E marked points. There is a forgetful morphism \u003C\u002Fp\u003E\u003Cdiv data-mathjax-status=\"texmath alt-graphic\" class=\"disp-formula\" data-magellan-destination=\"eqnU33\" id=\"eqnU33\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu33.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"179\" height=\"22\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu33.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$$\\begin{align*}\\beta_n\\colon\\mathcal{H}_{4,g,n}\\rightarrow {\\mathcal{M}}_{g,n}. \\end{align*}$$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003ERestricting to curves of gonality exactly \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline571.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline571.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$4$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, we obtain a proper morphism \u003C\u002Fp\u003E\u003Cdiv data-mathjax-status=\"texmath alt-graphic\" class=\"disp-formula\" data-magellan-destination=\"eqnU34\" id=\"eqnU34\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu34.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"441\" height=\"31\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu34.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$$\\begin{align*}\\beta_n'\\colon\\mathcal{H}_{4,g,n}^{\\Diamond}:= \\mathcal{H}_{4,g,n}\\smallsetminus \\beta_n^{-1}(\\mathcal{M}^3_{g,n})\\rightarrow {\\mathcal{M}}_{g,n}\\smallsetminus \\mathcal{M}^3_{g,n} \\end{align*}$$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003Ewith image \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline572.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"116\" height=\"27\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline572.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathcal {M}}_{g,n}^4 \\smallsetminus {\\mathcal {M}}_{g,n}^3$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. To show that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline573.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"113\" height=\"28\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline573.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {M}^4_{7,n}\\smallsetminus \\mathcal {M}^3_{7,n}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E has the CKgP, it suffices to show that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline574.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"52\" height=\"29\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline574.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {H}_{4,7,n}^\\Diamond $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E has the CKgP by Proposition \u003Ca class=\"xref statement\" href=\"#proposition5\"\u003E4.2\u003C\u002Fa\u003E(2). We will do so by further stratifying \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline575.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"52\" height=\"29\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline575.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {H}_{4,7,n}^\\Diamond $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003Cp class=\"p\"\u003E In [\u003Ca class=\"xref bibr\" href=\"#r6\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Canning and Larson\u003C\u002Fspan\u003E6\u003C\u002Fa\u003E, Section 4.4], the first two authors studied a stratification of \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline576.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"119\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline576.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {H}_{4,7} := \\mathcal {H}_{4,7,0}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E with no markings. Here, we carry out a similar analysis with marked points. The Casnati–Ekedahl structure theorem [\u003Ca class=\"xref bibr\" href=\"#r9\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Casnati and Ekedahl\u003C\u002Fspan\u003E9\u003C\u002Fa\u003E] associates to a point in \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline577.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"38\" height=\"22\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline577.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathcal {H}_{4,g}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E a rank \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline578.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"8\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline578.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$3$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E vector bundle \u003Cem class=\"italic\"\u003EE\u003C\u002Fem\u003E and a rank \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline579.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline579.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$2$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E vector bundle \u003Cem class=\"italic\"\u003EF\u003C\u002Fem\u003E on \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline580.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"17\" height=\"18\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline580.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathbb {P}^1$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, both of degree \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline581.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"41\" height=\"19\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline581.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$g+3$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, equipped with a canonical isomorphism \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline582.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"113\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline582.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\det E \\cong \\det F$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E [\u003Ca class=\"xref bibr\" href=\"#r7\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Canning and Larson\u003C\u002Fspan\u003E7\u003C\u002Fa\u003E, Section 3]. Let \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline583.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"14\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S