AAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1158.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"17\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1158.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$11$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E or \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1159.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"19\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1159.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$55$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E relations among the \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1160.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"31\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1160.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$M_{ij}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. There cannot be only \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1161.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"17\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1161.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$11$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E relations among the \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1162.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"31\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1162.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$M_{ij}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E because then there would be more than \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1163.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1163.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$836$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E independent copies of \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1164.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"46\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1164.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathsf {L}}^2{\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E in \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1165.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1165.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{15}({\\overline {\\mathcal {M}}}_{2,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, violating the dimension count (\u003Ca class=\"xref disp-formula\" href=\"#eqn29\"\u003E7.1\u003C\u002Fa\u003E). Hence, there must be exactly \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1166.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"19\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1166.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$55$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E relations among the \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1167.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"31\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1167.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$M_{ij}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. This shows that the \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1168.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"29\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1168.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$891$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E copies of \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1169.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"46\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1169.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathsf {L}}^2{\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E listed on the left of the table generate an \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1170.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1170.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$836$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E-dimensional space, so they span all of \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1171.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1171.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{15}({\\overline {\\mathcal {M}}}_{2,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement remark\" data-magellan-destination=\"remark9\" id=\"remark9\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003ERemark 7.9.\u003C\u002Fspan\u003E One could instead prove that the \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1172.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"29\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1172.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$891$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E classes span a space of rank \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1173.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1173.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$836$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E by computing the pairing of this space against itself. By the argument above, the pairing must have rank \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1174.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1174.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$836$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cp class=\"p\"\u003E Finally, applying Lemma \u003Ca class=\"xref statement\" href=\"#lemma3\"\u003E3.2\u003C\u002Fa\u003E(a) together with Lemmas \u003Ca class=\"xref statement\" href=\"#lemma19\"\u003E7.3\u003C\u002Fa\u003E and \u003Ca class=\"xref statement\" href=\"#lemma23\"\u003E7.7\u003C\u002Fa\u003E, and Corollary \u003Ca class=\"xref statement\" href=\"#corollary2\"\u003E2.3\u003C\u002Fa\u003E, we obtain one more base case.\u003C\u002Fp\u003E\u003Cdiv class=\"statement lemma\" data-magellan-destination=\"lemma24\" id=\"lemma24\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003ELemma 7.10.\u003C\u002Fspan\u003E \n\u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1175.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1175.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{15}({\\overline {\\mathcal {M}}}_{2,13})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E lies in the STE generated by \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1176.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"102\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1176.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{11}({\\overline {\\mathcal {M}}}_{1,11})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement other\" data-magellan-destination=\"sta8\" id=\"sta8\"\u003E\n\u003Ch2 class=\"C\"\u003EProof of Theorem \u003Ca class=\"xref statement\" href=\"#theorem5\"\u003E1.7\u003C\u002Fa\u003E.\u003C\u002Fh2\u003E\n\u003Cp class=\"p\"\u003E The proof is similar to that of Theorem \u003Ca class=\"xref statement\" href=\"#theorem4\"\u003E1.6\u003C\u002Fa\u003E. When \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1177.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"45\" height=\"19\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1177.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$g=0$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, all odd cohomology vanishes [\u003Ca class=\"xref bibr\" href=\"#r18\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Keel\u003C\u002Fspan\u003E18\u003C\u002Fa\u003E], so we can assume \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1178.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"46\" height=\"19\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1178.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$g\\geq 1$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. By [\u003Ca class=\"xref bibr\" href=\"#r4\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Bergström, Faber and Payne\u003C\u002Fspan\u003E4\u003C\u002Fa\u003E, Proposition 2.1] and the duality between \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1179.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"44\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1179.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H_{15}^{BM}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E and \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1180.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"32\" height=\"24\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1180.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{15}_c$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, we have that for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1181.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"46\" height=\"19\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1181.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$g\\geq 1$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E \u003C\u002Fp\u003E\u003Cdiv data-mathjax-status=\"texmath alt-graphic\" class=\"disp-formula\" data-magellan-destination=\"eqnU74\" id=\"eqnU74\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu74.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"421\" height=\"63\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu74.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$$ \\begin{align*} H^{BM}_{15}({\\mathcal{M}}_{g,n})=0 \\text{ for } \\begin{cases} 15&lt;2g \\text{ and } n=0,1 \\\\ 15&lt;2g-2+n \\text{ and } n\\geq 2. \\end{cases} \\end{align*} $$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003ECombining this with the exact sequence (\u003Ca class=\"xref disp-formula\" href=\"#eqn28\"\u003E6.1\u003C\u002Fa\u003E), we reduce inductively to the finitely many cases \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1182.png?pub-sta