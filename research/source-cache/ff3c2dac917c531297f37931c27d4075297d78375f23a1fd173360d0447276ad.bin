ase64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1072.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"14\" height=\"11\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1072.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\omega $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E over \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1073.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"158\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1073.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{11}({\\overline {\\mathcal {M}}}_{1,11}) \\cong {\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, pushforward along a map that glues \u003Cem class=\"italic\"\u003Ee\u003C\u002Fem\u003E pairs of marked points determines a morphism \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1074.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"201\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1074.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathsf {L}^e {\\mathsf {S}}_{12} \\to H^{11+2e}({\\overline {\\mathcal {M}}}_{g,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. We say that a collection of \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1075.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"14\" height=\"11\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1075.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\omega $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E-decorated graphs “is a basis for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1076.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"91\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1076.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^k({\\overline {\\mathcal {M}}}_{g,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E” if the corresponding morphisms \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1077.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"171\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1077.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathsf {L}^e {\\mathsf {S}}_{12} \\to H^{k}({\\overline {\\mathcal {M}}}_{g,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E form a basis for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1078.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"207\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1078.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\operatorname {\\mathrm {Hom}}(\\mathsf {L}^e{\\mathsf {S}}_{12}, H^{k}({\\overline {\\mathcal {M}}}_{g,n}))$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E and we have \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1079.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"400\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1079.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^k({\\overline {\\mathcal {M}}}_{g,n}) \\cong \\operatorname {\\mathrm {Hom}}(\\mathsf {L}^e{\\mathsf {S}}_{12}, H^{k}({\\overline {\\mathcal {M}}}_{g,n})) \\otimes \\mathsf {L}^e {\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003C\u002Fol\u003E\n\u003Cp class=\"p\"\u003E Bergström and Faber’s implementation [\u003Ca class=\"xref bibr\" href=\"#r2\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Bergström\u003C\u002Fspan\u003E2\u003C\u002Fa\u003E] of the Getzler–Kapranov formula in genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1080.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1080.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$2$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E shows that, viewed as Galois representations, \u003C\u002Fp\u003E\u003Cdiv data-mathjax-status=\"texmath alt-graphic\" class=\"disp-formula\" data-magellan-destination=\"eqn29\" id=\"eqn29\"\u003E\n\u003Cspan class=\"label\"\u003E(7.1)\u003C\u002Fspan\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqn29.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"226\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqn29.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$$ \\begin{align} H^{15}({\\overline{\\mathcal{M}}}_{2,12})^{\\mathrm{ss}} = 836 \\, {\\mathsf{L}}^2{\\mathsf{S}}_{12.} \\end{align} $$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003EIn fact, we will produce \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1081.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1081.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$836$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E independent maps \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1082.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"181\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1082.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathsf {L}}^2{\\mathsf {S}}_{12} \\to H^{15}({\\overline {\\mathcal {M}}}_{2,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E that arise through pushforward from the boundary. From this, we will conclude that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1083.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1083.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{15}({\\overline {\\mathcal {M}}}_{2,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E is semi-simple and decomposes as a sum of these \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1084.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1084.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$836$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E copies of \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1085.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"46\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1085.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\mathsf {L}}^2{\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003Cp class=\"p\"\u003E As discussed above, an \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1086.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"14\" height=\"11\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1086.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\omega $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E-decorated graph with \u003Cem class=\"italic\"\u003Ee\u003C\u002Fem\u003E edges represents a morphism \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1087.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"201\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1087.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\mathsf {L}^e {\\mathsf {S}}_{12} \\to H^{11 + 2e}({\\overline {\\mathcal {M}}}_{g,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. In Figure \u003Ca class=\"xref fig\" href=\"#fig2\"\u003E2\u003C\u002Fa\u003E, we list \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1088.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"29\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1088.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$891$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E such decorated graphs for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1089.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1089.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{15}({\\overline {\\mathcal {M}}}_{2,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E and record particular Künneth components of their pullbacks to boundary divisors. We then argue that there are \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1090.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"19\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1090.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$55$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E relations among these graphs, which allow us to conclude that there are \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1091.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1091.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$836$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E independent graphs among them.\u003C\u002Fp\u003E\u003Csection\u003E\u003Cdiv class=\"fig-ada\" data-magellan-destination=\"fig2\" id=\"fig2\"\u003E\u003Cdiv class=\"caption\"\u003E\u003Cspan class=\"label\"\u003EFigure 2\u003C\u002Fspan\u003E\n\u003Cp class=\"p\"\u003ESelected Künneth components of pullbacks of the \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1092.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"29\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1092.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$891$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E classes to boundary divisors. In the chart, each row represents several rows of a block matrix. The number of rows in each group is listed to its left. The two half-edges glued to make a boundary divisor (pictured across the top) are labeled \u003Cem class=\"italic\"\u003Eq\u003C\u002Fem\u003E on the left vertex and \u003Cem class=\"italic\"\u003Ep\u003C\u002Fem\u003E on the right vertex.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\n\n\u003Cdiv class=\"figure-thumb\"\u003E\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_fig2.png?pub-status=live\" class=\"aop-lazy-load-image\" width=\"1417\" height=\"1431\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_fig2.png\" data-zoomable=\"true\"\u003E\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\u003C\u002Fsection\u003E\n\u003Cp class=\"p\"\u003E Before proving Lemma \u003Ca class=\"xref statement\" href=\"#lemma19\"\u003E7.3\u003C\u002Fa\u003E, we require some explicit bases for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1093.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"97\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1093.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{g,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E for small \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1094.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1094.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$g, n$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. Recall that Getzler [\u003Ca class=\"xref bibr\" href=\"#r16\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Getzler\u003C\u002Fspan\u003E16\u003C\u002Fa\u003E] showed that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1095.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"202\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1095.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,n})^{\\mathrm {ss}} = \\bigoplus \\mathsf {L}{\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E for all \u003Cem class=\"italic\"\u003En\u003C\u002Fem\u003E.\u003C\u002Fp\u003E\u003Cdiv class=\"statement lemma\" data-magellan-destination=\"lemma20\" id=\"lemma20\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003ELemma 7.4.\u003C\u002Fspan\u003E The following \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1096.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"38\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1096.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$11\\ \\omega $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E-decorated graphs form a basis for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1097.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1097.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E \u003C\u002Fp\u003E\u003Cdiv class=\"disp-formula\" data-magellan-destination=\"eqnU68\" id=\"eqnU68\"\u003E\n\u003Cdiv class=\"figure-thumb\"\u003E\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu68.png?pub-status=live\" class=\"aop-lazy-load-image\" width=\"103\" height=\"53\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu68.png\" data-zoomable=\"false\"\u003E\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement other\" data-magellan-destination=\"proof26\" id=\"proof26\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003EProof.\u003C\u002Fspan\u003E Consider the block diagonal pairing against the basis for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1098.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1098.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{11}({\\overline {\\mathcal {M}}}_{1,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E given by the set of genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1099.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"7\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1099.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$1$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E vertices decorated by \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1100.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"99\" height=\"13\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1100.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\omega _2, \\ldots , \\omega _{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement lemma\" data-magellan-destination=\"lemma21\" id=\"lemma21\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003ELemma 7.5.\u003C\u002Fspan\u003E The following \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1101.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"50\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1101.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$429\\ \\omega $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E-decorated graphs form a basis for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1102.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1102.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,13})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E \u003C\u002Fp\u003E\u003Cdiv class=\"disp-formula\" data-magellan-destination=\"eqnU69\" id=\"eqnU69\"\u003E\n\u003Cdiv class=\"figure-thumb\"\u003E\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu69.png?pub-status=live\" class=\"aop-lazy-load-image\" width=\"513\" height=\"127\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu69.png\" data-zoomable=\"false\"\u003E\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003EAbove, \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1103.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1103.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$x, y$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E are any two markings. In the last group of classes, \u003Cem class=\"italic\"\u003Ei\u003C\u002Fem\u003E or \u003Cem class=\"italic\"\u003Ej\u003C\u002Fem\u003E can be equal to \u003Cem class=\"italic\"\u003Ey\u003C\u002Fem\u003E.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement other\" data-magellan-destination=\"proof27\" id=\"proof27\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003EProof.\u003C\u002Fspan\u003E Getzler [\u003Ca class=\"xref bibr\" href=\"#r16\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Getzler\u003C\u002Fspan\u003E16\u003C\u002Fa\u003E] proved that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1104.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"214\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1104.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,13})^{\\mathrm {ss}} = 429 \\, \\mathsf {L}{\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, so it suffices to show that the images of these maps span. We know that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1105.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1105.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,13})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E is pushed forward from the boundary by Proposition \u003Ca class=\"xref statement\" href=\"#proposition1\"\u003E2.2\u003C\u002Fa\u003E. Modulo classes of the first kind, the second two kinds are pulled back from \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1106.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"102\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1106.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. Pulling back the relations from \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1107.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1107.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, we can ensure that a fixed marking, such as \u003Cem class=\"italic\"\u003Ey\u003C\u002Fem\u003E in the first case or \u003Cem class=\"italic\"\u003Ex\u003C\u002Fem\u003E in the next case, is on the genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1108.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1108.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$0$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E vertex.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement lemma\" data-magellan-destination=\"lemma22\" id=\"lemma22\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003ELemma 7.6.\u003C\u002Fspan\u003E Let \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1109.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"132\" height=\"20\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1109.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\{x, y, 1, \\ldots , 12\\}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E be a set of \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1110.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"18\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1110.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$14$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E markings. The following \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1111.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"70\" height=\"18\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1111.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$6,006\\ \\omega $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E-decorated graphs form a basis for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1112.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"102\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1112.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,14})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E \u003C\u002Fp\u003E\u003Cdiv class=\"disp-formula\" data-magellan-destination=\"eqnU70\" id=\"eqnU70\"\u003E\n\u003Cdiv class=\"figure-thumb\"\u003E\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu70.png?pub-status=live\" class=\"aop-lazy-load-image\" width=\"712\" height=\"126\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu70.png\" data-zoomable=\"true\"\u003E\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003EIn the last grouping above, \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1113.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"24\" height=\"19\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1113.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$i, j$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E or \u003Cem class=\"italic\"\u003Ek\u003C\u002Fem\u003E can equal \u003Cem class=\"italic\"\u003Ey\u003C\u002Fem\u003E.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement other\" data-magellan-destination=\"proof28\" id=\"proof28\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003EProof.\u003C\u002Fspan\u003E Getzler [\u003Ca class=\"xref bibr\" href=\"#r16\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Getzler\u003C\u002Fspan\u003E16\u003C\u002Fa\u003E] proved that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1114.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"223\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1114.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,14})^{\\mathrm {ss}}=6006\\,\\mathsf {L}{\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, so it suffices to show that the images of these maps span. Modulo classes of the first and second kinds above, the last three kinds are pulled back from \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1115.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"54\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1115.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\overline {\\mathcal {M}}}_{1,12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. Thus, using the relations on \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1116.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1116.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E, we can ensure that a fixed marking among those \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1117.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"18\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1117.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$12$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E is on the genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1118.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1118.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$0$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E vertex.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement lemma\" data-magellan-destination=\"lemma23\" id=\"lemma23\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003ELemma 7.7.\u003C\u002Fspan\u003E The following \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1119.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"50\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1119.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$264\\ \\omega $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E-decorated graphs form a basis for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1120.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1120.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{2,12})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E \u003C\u002Fp\u003E\u003Cdiv class=\"disp-formula\" data-magellan-destination=\"eqnU71\" id=\"eqnU71\"\u003E\n\u003Cdiv class=\"figure-thumb\"\u003E\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu71.png?pub-status=live\" class=\"aop-lazy-load-image\" width=\"509\" height=\"108\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu71.png\" data-zoomable=\"false\"\u003E\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement other\" data-magellan-destination=\"proof29\" id=\"proof29\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003EProof.\u003C\u002Fspan\u003E Bergström and Faber’s implementation [\u003Ca class=\"xref bibr\" href=\"#r2\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Bergström\u003C\u002Fspan\u003E2\u003C\u002Fa\u003E] of the Getzler–Kapranov formula in genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1121.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1121.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$2$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E shows that, as Galois representations, \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1122.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"214\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1122.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{2,12})^{\\mathrm {ss}} = 264 \\, \\mathsf {L}{\\mathsf {S}}_{12}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. Thus, it suffices to show that the above \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1123.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"31\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1123.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$264$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E maps are independent. We verify this by computing their pullbacks to \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1124.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"102\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1124.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{1,14})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E and using Lemma \u003Ca class=\"xref statement\" href=\"#lemma22\"\u003E7.6\u003C\u002Fa\u003E to see that those maps are independent. Indeed, the pullback is given by the graph that replaces the rightmost genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1125.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"7\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1125.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$1$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E vertex with a genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1126.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"10\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1126.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$0$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E vertex and adds two markings labeled \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1127.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"30\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1127.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$x, y$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E to that vertex.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement remark\" data-magellan-destination=\"remark8\" id=\"remark8\"\u003E\n\n\u003Cp class=\"p\"\u003E\u003Cspan class=\"label\"\u003ERemark 7.8.\u003C\u002Fspan\u003E Theorem \u003Ca class=\"xref statement\" href=\"#theorem4\"\u003E1.6\u003C\u002Fa\u003E says that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1128.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"97\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1128.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H_{13}({\\overline {\\mathcal {M}}}_{g,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E is contained in the STE generated by \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1129.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"101\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1129.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{11}({\\overline {\\mathcal {M}}}_{1,11})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. Thus, it has a graphical presentation in which the generators are graphs of the sort appearing in Lemmas \u003Ca class=\"xref statement\" href=\"#lemma20\"\u003E7.4\u003C\u002Fa\u003E–\u003Ca class=\"xref statement\" href=\"#lemma23\"\u003E7.7\u003C\u002Fa\u003E. In forthcoming work, we will show that \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1130.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"98\" height=\"26\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1130.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{13}({\\overline {\\mathcal {M}}}_{g,n})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E is also contained in this STE. There, we take a more systematic approach and provide a complete list of relations among the corresponding decorated graph generators.\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"statement other\" data-magellan-destination=\"sta7\" id=\"sta7\"\u003E\n\u003Ch2 class=\"C\"\u003EProof of Lemma \u003Ca class=\"xref statement\" href=\"#lemma19\"\u003E7.3\u003C\u002Fa\u003E.\u003C\u002Fh2\u003E\n\u003Cp class=\"p\"\u003E Figure \u003Ca class=\"xref fig\" href=\"#fig2\"\u003E2\u003C\u002Fa\u003E represents a matrix with \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1131.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"29\" height=\"15\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1131.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$891$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E rows. We first show that the matrix has rank \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1132.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"29\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1132.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$825$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E and describe the \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1133.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"20\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1133.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$66$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E relations among the rows.\u003C\u002Fp\u003E\n\u003Cp class=\"p\"\u003E First, notice that the rows in A1 are the only rows with nonzero entries in the first column. Next, rows in A2, A3 and A4 have entries in column 2 that are independent from the other entries that appear in that column for later rows (by Lemma \u003Ca class=\"xref statement\" href=\"#lemma21\"\u003E7.5\u003C\u002Fa\u003E). This shows that the rows in A1 through A4 are independent and independent from the remaining five rows. Meanwhile, the bottom four rows are block upper triangular. This shows that the rank of the matrix is at least \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1134.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"29\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1134.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$825$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003Cp class=\"p\"\u003E Meanwhile, it is not hard to check that the following \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1135.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"20\" height=\"16\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1135.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$66$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E relations exist among the rows: \u003C\u002Fp\u003E\u003Cdiv data-mathjax-status=\"texmath alt-graphic\" class=\"disp-formula\" data-magellan-destination=\"eqnU72\" id=\"eqnU72\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu72.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"547\" height=\"42\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu72.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$$\\begin{align*}R_1(ij) + \\frac{1}{24}R_2(ij) + R_3[i,j] + R_3[j,i] - R_4(ij) + \\frac{1}{12} R_5(ij) = 0.\\end{align*}$$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003ETo verify these relations, one needs to make use of known relations among tautological classes in \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1136.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"86\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1136.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^4({\\overline {\\mathcal {M}}}_{1,3})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E and \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1137.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"87\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1137.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^2({\\overline {\\mathcal {M}}}_{1,2})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E and \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1138.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"86\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1138.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^2({\\overline {\\mathcal {M}}}_{1,1})$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E.\u003C\u002Fp\u003E\n\u003Cp class=\"p\"\u003E Now, let \u003C\u002Fp\u003E\u003Cdiv class=\"disp-formula\" data-magellan-destination=\"eqnU73\" id=\"eqnU73\"\u003E\n\u003Cdiv class=\"figure-thumb\"\u003E\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu73.png?pub-status=live\" class=\"aop-lazy-load-image\" width=\"686\" height=\"72\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_eqnu73.png\" data-zoomable=\"true\"\u003E\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\u003Cp class=\"p continuation\"\u003EWe claim \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1139.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"67\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1139.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$M_{ij} \\neq 0$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. To see this, consider the intersection of \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1140.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"31\" height=\"21\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1140.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$M_{ij}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E with \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1141.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"55\" height=\"20\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1141.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$R_5(ik)$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E for \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1142.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"45\" height=\"19\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1142.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$k \\neq j$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E. The intersection of \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1143.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"55\" height=\"20\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1143.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$R_5(ik)$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E with the first five terms in the above equation vanish, since there is no \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1144.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"31\" height=\"18\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1144.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$H^{11}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E on a genus \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1145.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"7\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1145.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$1$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E vertex with less than \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1146.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"17\" height=\"14\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1146.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$11$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E markings. Meanwhile, the intersection \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1147.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"125\" height=\"20\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1147.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$R_5(ij) \\cdot R_5(ik)$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E is nonzero using the usual rules for intersecting decorated graphs, as in [\u003Ca class=\"xref bibr\" href=\"#r17\"\u003E\u003Cspan class=\"show-for-sr\"\u003EReference Graber and Pandharipande\u003C\u002Fspan\u003E17\u003C\u002Fa\u003E]. To see this, one should take the \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1148.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"14\" height=\"11\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1148.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n$\\omega $\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E decoration on the \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1149.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphic mathjax-off\" width=\"51\" height=\"25\" data-original-image=\"\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1149.png\" data-zoomable=\"false\"\u003E\n\u003Cspan class=\"mathjax-tex-wrapper\" data-mathjax-type=\"texmath\"\u003E\u003Cspan class=\"tex-math mathjax-tex-math mathjax-on\"\u003E\n${\\overline {\\mathcal {M}}}_{1,11}$\n\u003C\u002Fspan\u003E\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E\n\u003C\u002Fspan\u003E vertex in \u003Cspan data-mathjax-status=\"texmath alt-graphic\" class=\"inline-formula\"\u003E\n\u003Cspan class=\"alternatives\"\u003E\n\u003Cimg src=\"data:image\u002Fgif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\" data-src=\"https:\u002F\u002Fstatic.cambridge.org\u002Fbinary\u002Fversion\u002Fid\u002Furn:cambridge.org:id:binary:20241118052945671-0407:S2050508624000246:S2050508624000246_inline1150.png?pub-status=live\" class=\"aop-lazy-load-image mathjax-alternative mathjax-alt-graphi