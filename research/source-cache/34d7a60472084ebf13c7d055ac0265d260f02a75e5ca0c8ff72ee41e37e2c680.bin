nslate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex11.m1.pic1.m15" class="ltx_Math" alttext="\textstyle{\ldots\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi mathvariant="normal">…</mi><annotation encoding="application/x-tex">\textstyle{\ldots\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 149.1128476276031 -88.14168665869958 L 149.1128476276031 -87.58821509859943" fill="none" stroke="#000000"></path><g transform="translate(190.69,0) translate(0,-87.87)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 149.1128476276031 -88.14168665869958 L 190.6900813639931 -87.58821509859943" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 190.6900813639931 -88.14168665869958 L 190.6900813639931 -87.58821509859943" fill="none" stroke="#000000"></path><g transform="translate(190.69,0) translate(0,-87.87) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.31em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="31.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex11.m1.pic1.m16" class="ltx_Math" alttext="\textstyle{F_{k}|_{H}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>F</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow><mi>H</mi></msub><annotation encoding="application/x-tex">\textstyle{F_{k}|_{H}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 230.95871611421362 -88.14168665869958 L 230.95871611421362 -87.58821509859943" fill="none" stroke="#000000"></path><g transform="translate(294.54,0) translate(0,-87.87)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 230.95871611421362 -88.14168665869958 L 294.538650734388 -87.58821509859943" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 294.538650734388 -88.14168665869958 L 294.538650734388 -87.58821509859943" fill="none" stroke="#000000"></path><g transform="translate(294.54,0) translate(0,-87.87) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.34em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.26" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="32.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex11.m1.pic1.m17" class="ltx_Math" alttext="\textstyle{{\mathcal{I}}_{Z\subset H}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>Z</mi><mo>⊂</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">\textstyle{{\mathcal{I}}_{Z\subset H}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 335.19833022271087 -88.14168665869958 L 335.19833022271087 -87.58821509859943" fill="none" stroke="#000000"></path><g transform="translate(390.41,0) translate(0,-87.87)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 335.19833022271087 -88.14168665869958 L 390.40981032499656 -87.58821509859943" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 390.40981032499656 -88.14168665869958 L 390.40981032499656 -87.58821509859943" fill="none" stroke="#000000"></path><g transform="translate(390.41,0) translate(0,-87.87) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.Ex11.m1.pic1.m18" class="ltx_Math" alttext="\textstyle{0}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\textstyle{0}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p7.4" class="ltx_p"><span id="S2.SS2.p7.4.1" class="ltx_text">The top two rows are exact, and so is every column. Therefore, the bottom row is exact as well, and hence a resolution
for <math id="S2.SS2.p7.m2" class="ltx_Math" alttext="{\mathcal{I}}_{Z\subset H}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>Z</mi><mo>⊂</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{I}}_{Z\subset H}</annotation></semantics></math>. The bottom resolution is minimal because the degrees of the <math id="S2.SS2.p7.m3" class="ltx_Math" alttext="F_{k}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>k</mi></msub><annotation encoding="application/x-tex">F_{k}</annotation></semantics></math> strictly increase with <math id="S2.SS2.p7.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.p8" class="ltx_para">
<p id="S2.SS2.p8.1" class="ltx_p"><span id="S2.SS2.p8.1.1" class="ltx_text">The second part of the lemma is a well-known computation of the minimal free resolution of an elliptic normal curve found, for example, in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx8" title="" class="ltx_ref">Eis</a>]</cite>.
∎</span></p>
</div>
</div>
<div id="S2.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S2.Thmtheorem4" title="2.4. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">2.4</span></a>.</h6>
<div id="S2.SS2.p9" class="ltx_para">
<p id="S2.SS2.p9.1" class="ltx_p"><span id="S2.SS2.p9.1.1" class="ltx_text">We essentially apply <a href="#S2.Thmtheorem5" title="2.5. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">2.5</span></a> relatively over <math id="S2.SS2.p9.m1" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>. Let <math id="S2.SS2.p9.m2" class="ltx_Math" alttext="C\subset E\times{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">C\subset E\times{\bf P}^{1}</annotation></semantics></math> be a smooth bi-degree <math id="S2.SS2.p9.m3" class="ltx_Math" alttext="(d,m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d,m)</annotation></semantics></math> curve; this means that <math id="S2.SS2.p9.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> intersects the elliptic curve rulings <math id="S2.SS2.p9.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> times. These intersections are all in the same linear system <math id="S2.SS2.p9.m6" class="ltx_Math" alttext="|D|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|D|</annotation></semantics></math> of degree <math id="S2.SS2.p9.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> on <math id="S2.SS2.p9.m8" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>. By adjunction, the curve <math id="S2.SS2.p9.m9" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is seen to have genus <math id="S2.SS2.p9.m10" class="ltx_Math" alttext="g=d(m-1)+1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">g=d(m-1)+1</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.p10" class="ltx_para">
<p id="S2.SS2.p10.1" class="ltx_p"><span id="S2.SS2.p10.1.1" class="ltx_text">We can embed the surface <math id="S2.SS2.p10.m1" class="ltx_Math" alttext="E\times{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">E\times{\bf P}^{1}</annotation></semantics></math> into <math id="S2.SS2.p10.m2" class="ltx_Math" alttext="{\bf P}^{d-1}\times{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">{\bf P}^{d-1}\times{\bf P}^{1}</annotation></semantics></math> where the first factor is embedded by the linear system <math id="S2.SS2.p10.m3" class="ltx_Math" alttext="|D|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|D|</annotation></semantics></math>, i.e. <math id="S2.SS2.p10.m4" class="ltx_Math" alttext="E\times{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">E\times{\bf P}^{1}</annotation></semantics></math> is a constant family of degree <math id="S2.SS2.p10.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> elliptic normal curves in <math id="S2.SS2.p10.m6" class="ltx_Math" alttext="{\bf P}^{d-1}\times{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">{\bf P}^{d-1}\times{\bf P}^{1}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.p11" class="ltx_para">
<p id="S2.SS2.p11.1" class="ltx_p"><span id="S2.SS2.p11.1.1" class="ltx_text">Let <math id="S2.SS2.p11.m1" class="ltx_Math" alttext="\pi\colon{\bf P}^{d-1}\times{\bf P}^{1}\to{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\pi\colon{\bf P}^{d-1}\times{\bf P}^{1}\to{\bf P}^{1}</annotation></semantics></math> denote the projection. Then the ideal sheaf <math id="S2.SS2.p11.m2" class="ltx_Math" alttext="{\mathcal{I}}_{E\times{\bf P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></msub><annotation encoding="application/x-tex">{\mathcal{I}}_{E\times{\bf P}^{1}}</annotation></semantics></math> has a “relative” minimal resolution which is pulled back via the projection to <math id="S2.SS2.p11.m3" class="ltx_Math" alttext="{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-1}</annotation></semantics></math>:</span></p>
<table id="S2.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E7.m1" class="ltx_Math" alttext="0\to F_{1}\to...\to F_{k}\to{{\mathcal{I}}}_{E\times{\bf P}^{1}\subset{\bf P}^{d-1}\times{\bf P}^{1}}\to 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">→</mo><msub><mi>F</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi mathvariant="normal">…</mi><mo stretchy="false">→</mo><msub><mi>F</mi><mi>k</mi></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><mo>⊂</mo><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\to F_{1}\to...\to F_{k}\to{{\mathcal{I}}}_{E\times{\bf P}^{1}\subset{\bf P}^{d-1}\times{\bf P}^{1}}\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.SS2.p12" class="ltx_para">
<p id="S2.SS2.p12.1" class="ltx_p"><span id="S2.SS2.p12.1.1" class="ltx_text">Let <math id="S2.SS2.p12.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> denote the pullback of the hyperplane class on <math id="S2.SS2.p12.m2" class="ltx_Math" alttext="{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-1}</annotation></semantics></math> to the product <math id="S2.SS2.p12.m3" class="ltx_Math" alttext="{\bf P}^{d-1}\times{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">{\bf P}^{d-1}\times{\bf P}^{1}</annotation></semantics></math>, and let <math id="S2.SS2.p12.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> denote the class of a fiber of <math id="S2.SS2.p12.m5" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>. Then the curve <math id="S2.SS2.p12.m6" class="ltx_Math" alttext="C\subset E\times{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">C\subset E\times{\bf P}^{1}</annotation></semantics></math> is the intersection of <math id="S2.SS2.p12.m7" class="ltx_Math" alttext="E\times{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">E\times{\bf P}^{1}</annotation></semantics></math> with some relative hyperplane divisor <math id="S2.SS2.p12.m8" class="ltx_Math" alttext="\Lambda\subset{\bf P}^{d-1}\times{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset{\bf P}^{d-1}\times{\bf P}^{1}</annotation></semantics></math> with divisor class <math id="S2.SS2.p12.m9" class="ltx_Math" alttext="h+mf" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">h+mf</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.p13" class="ltx_para">
<p id="S2.SS2.p13.1" class="ltx_p"><span id="S2.SS2.p13.1.1" class="ltx_text">The curve <math id="S2.SS2.p13.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, viewed as a subscheme of the <math id="S2.SS2.p13.m2" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math>-bundle <math id="S2.SS2.p13.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>, is a branched cover in its relative canonical embedding. This follows because, by <a href="#S2.Thmtheorem5" title="2.5. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">2.5</span></a>, the fibers <math id="S2.SS2.p13.m4" class="ltx_Math" alttext="C\cap{\bf P}^{d-2}\subset{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>∩</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">C\cap{\bf P}^{d-2}\subset{\bf P}^{d-2}</annotation></semantics></math> are length <math id="S2.SS2.p13.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> arithmetically Gorenstein subschemes of <math id="S2.SS2.p13.m6" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math>, a property which characterizes the relative canonical embedding <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx5" title="" class="ltx_ref">CE96</a>]</cite>.</span></p>
</div>
<div id="S2.SS2.p14" class="ltx_para">
<p id="S2.SS2.p14.1" class="ltx_p"><span id="S2.SS2.p14.1.1" class="ltx_text">We then restrict sequence (<a href="#S2.E7" title="Equation 7 ‣ Proof of . ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) to the relative hyperplane <math id="S2.SS2.p14.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>, and use <a href="#S2.Thmtheorem5" title="2.5. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">2.5</span></a> in each fiber of <math id="S2.SS2.p14.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> to conclude that</span></p>
<table id="S2.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E8.m1" class="ltx_Math" alttext="0\to F_{1}|_{\Lambda}\to...\to F_{k}|_{\Lambda}\to{{\mathcal{I}}}_{C\subset\Lambda}\to 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">→</mo><msub><mrow><msub><mi>F</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Λ</mi></msub><mo stretchy="false">→</mo><mi mathvariant="normal">…</mi><mo stretchy="false">→</mo><msub><mrow><msub><mi>F</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Λ</mi></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>C</mi><mo>⊂</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\to F_{1}|_{\Lambda}\to...\to F_{k}|_{\Lambda}\to{{\mathcal{I}}}_{C\subset\Lambda}\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p14.2" class="ltx_p"><span id="S2.SS2.p14.2.1" class="ltx_text">is the Casnati-Ekedahl resolution of <math id="S2.SS2.p14.m3" class="ltx_Math" alttext="C\subset\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">C\subset\Lambda</annotation></semantics></math>. If we write</span></p>
<table id="S2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex12.m1" class="ltx_Math" alttext="F_{i}|_{\Lambda}=\pi^{*}N_{i}(-m_{i})" display="block" intent=":literal"><semantics><mrow><msub><mrow><msub><mi>F</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Λ</mi></msub><mo>=</mo><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><msub><mi>m</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{i}|_{\Lambda}=\pi^{*}N_{i}(-m_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p14.3" class="ltx_p"><span id="S2.SS2.p14.3.1" class="ltx_text">we see that each bundle <math id="S2.SS2.p14.m4" class="ltx_Math" alttext="N_{i}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>i</mi></msub><annotation encoding="application/x-tex">N_{i}</annotation></semantics></math> is in fact <em id="S2.SS2.p14.3.1.1" class="ltx_emph ltx_font_italic">perfectly</em> balanced, i.e.</span></p>
<table id="S2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex13.m1" class="ltx_Math" alttext="N_{i}=\mathcal{O}_{{\bf P}^{1}}(k_{i})^{\oplus r_{i}}" display="block" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">N_{i}=\mathcal{O}_{{\bf P}^{1}}(k_{i})^{\oplus r_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p14.4" class="ltx_p"><span id="S2.SS2.p14.4.1" class="ltx_text">for some integer <math id="S2.SS2.p14.m5" class="ltx_Math" alttext="k_{i}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>i</mi></msub><annotation encoding="application/x-tex">k_{i}</annotation></semantics></math>, where <math id="S2.SS2.p14.m6" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math> is given in <a href="#S2.I1.i2" title="In 2.1. ‣ 2.1. The Casnati-Ekedahl Resolution ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">item</span> <span class="ltx_text ltx_ref_tag">(b)</span></a> of <a href="#S2.Thmtheorem1" title="2.1. ‣ 2.1. The Casnati-Ekedahl Resolution ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2.1</span></a>.</span></p>
</div>
<div id="S2.SS2.p15" class="ltx_para">
<p id="S2.SS2.p15.1" class="ltx_p"><span id="S2.SS2.p15.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S2.Thmtheorem6" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem6.2" class="ltx_text ltx_font_italic">2.6</span></span><span id="S2.Thmtheorem6.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S2.Thmtheorem6.p1" class="ltx_para">
<p id="S2.Thmtheorem6.p1.1" class="ltx_p"><a href="#S2.Thmtheorem4" title="2.4. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">2.4</span></a> and <a href="#S2.Thmtheorem5" title="2.5. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">2.5</span></a> indicate a direct relationship between invariants of branched covers and properties of genus <math id="S2.Thmtheorem6.p1.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> fibrations.</p>
</div>
<div id="S2.Thmtheorem6.p2" class="ltx_para">
<p id="S2.Thmtheorem6.p2.1" class="ltx_p">Let <math id="S2.Thmtheorem6.p2.m1" class="ltx_Math" alttext="f\colon S\to{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">f\colon S\to{\bf P}^{1}</annotation></semantics></math> be a generically smooth family of arithmetic genus <math id="S2.Thmtheorem6.p2.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> curves, and let <math id="S2.Thmtheorem6.p2.m3" class="ltx_Math" alttext="C\subset S" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">C\subset S</annotation></semantics></math> be a smooth <math id="S2.Thmtheorem6.p2.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-section of the map <math id="S2.Thmtheorem6.p2.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, i.e. <math id="S2.Thmtheorem6.p2.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is a smooth curve whose intersection number with the fibers of <math id="S2.Thmtheorem6.p2.m7" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is <math id="S2.Thmtheorem6.p2.m8" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.</p>
</div>
<div id="S2.Thmtheorem6.p3" class="ltx_para">
<p id="S2.Thmtheorem6.p3.1" class="ltx_p">Then the pair <math id="S2.Thmtheorem6.p3.m1" class="ltx_math_unparsed" alttext="(f\colon S\to{\bf P}^{1},C)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>S</mi><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f\colon S\to{\bf P}^{1},C)</annotation></semantics></math> gives rise to the natural embedding</p>
<table id="S2.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(9)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E9.m1" class="ltx_Math" alttext="S\hookrightarrow{\bf P}(f_{*}\mathcal{O}_{S}(C))" display="block" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">↪</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S\hookrightarrow{\bf P}(f_{*}\mathcal{O}_{S}(C))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.Thmtheorem6.p3.2" class="ltx_p">over <math id="S2.Thmtheorem6.p3.m2" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>. The projective bundle <math id="S2.Thmtheorem6.p3.m3" class="ltx_Math" alttext="{\bf P}(f_{*}\mathcal{O}_{S}(C))" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf P}(f_{*}\mathcal{O}_{S}(C))</annotation></semantics></math> is a <math id="S2.Thmtheorem6.p3.m4" class="ltx_Math" alttext="{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-1}</annotation></semantics></math>-bundle, and each fiber of <math id="S2.Thmtheorem6.p3.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> embeds as a possibly singular degree <math id="S2.Thmtheorem6.p3.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> elliptic normal curve. Furthermore, there exists a relative hyperplane <math id="S2.Thmtheorem6.p3.m7" class="ltx_Math" alttext="\Lambda\subset{\bf P}(f_{*}\mathcal{O}_{S}(C))" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset{\bf P}(f_{*}\mathcal{O}_{S}(C))</annotation></semantics></math> whose intersection with <math id="S2.Thmtheorem6.p3.m8" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is precisely the curve <math id="S2.Thmtheorem6.p3.m9" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>.</p>
</div>
<div id="S2.Thmtheorem6.p4" class="ltx_para">
<p id="S2.Thmtheorem6.p4.1" class="ltx_p">The main observation, following from <a href="#S2.Thmtheorem5" title="2.5. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">2.5</span></a>, is that the curve <math id="S2.Thmtheorem6.p4.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, viewed as a branched cover of <math id="S2.Thmtheorem6.p4.m2" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>, is embedded via its relative canonical embedding in the <math id="S2.Thmtheorem6.p4.m3" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math>-bundle <math id="S2.Thmtheorem6.p4.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>.</p>
</div>
<div id="S2.Thmtheorem6.p5" class="ltx_para">
<p id="S2.Thmtheorem6.p5.1" class="ltx_p">As an analogy, the reader should recall the relationship between the syzygies of a canonical curve <math id="S2.Thmtheorem6.p5.m1" class="ltx_Math" alttext="C\subset{\bf P}^{g-1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">C\subset{\bf P}^{g-1}</annotation></semantics></math> and a <math id="S2.Thmtheorem6.p5.m2" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface <math id="S2.Thmtheorem6.p5.m3" class="ltx_Math" alttext="S\subset{\bf P}^{g}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>g</mi></msup></mrow><annotation encoding="application/x-tex">S\subset{\bf P}^{g}</annotation></semantics></math> containing <math id="S2.Thmtheorem6.p5.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>. A generic version of Green’s conjecture was proved by Voisin in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">Voi02</a>]</cite> using this relationship.</p>
</div>
<div id="S2.Thmtheorem6.p6" class="ltx_para">
<p id="S2.Thmtheorem6.p6.1" class="ltx_p">A dimension count says that a general branched cover <math id="S2.Thmtheorem6.p6.m1" class="ltx_Math" alttext="\alpha\colon C\to{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha\colon C\to{\bf P}^{1}</annotation></semantics></math> does not occur as a <math id="S2.Thmtheorem6.p6.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-section in a genus <math id="S2.Thmtheorem6.p6.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> fibration. However, the proof of <a href="#S2.Thmtheorem4" title="2.4. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">2.4</span></a> shows us that <em id="S2.Thmtheorem6.p6.1.1" class="ltx_emph ltx_font_italic">if the syzygy bundles for <math id="S2.Thmtheorem6.p6.m4" class="ltx_Math" alttext="S\subset{\bf P}(f_{*}\mathcal{O}_{S}(C))" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S\subset{\bf P}(f_{*}\mathcal{O}_{S}(C))</annotation></semantics></math> are balanced, then the same follows for <math id="S2.Thmtheorem6.p6.m5" class="ltx_Math" alttext="C\subset\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">C\subset\Lambda</annotation></semantics></math>.</em></p>
</div>
<div id="S2.Thmtheorem6.p7" class="ltx_para">
<p id="S2.Thmtheorem6.p7.1" class="ltx_p">This suggests a more attractive approach for proving <a href="#Thmconjecture1" title="A. ‣ 1. Introduction ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>: Show that the generic pair <math id="S2.Thmtheorem6.p7.m1" class="ltx_math_unparsed" alttext="(f\colon S\to{\bf P}^{1},C)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>S</mi><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f\colon S\to{\bf P}^{1},C)</annotation></semantics></math> has balanced syzygies in its relative embedding (<a href="#S2.E9" title="Equation 9 ‣ 2.6. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>). This is the subject of future work.</p>
</div>
</div>
</section>
<section id="S2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.3. </span>Covers of genus <math id="S2.SS3.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S2.SS3.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.</h3>

<div id="S2.SS3.p1" class="ltx_para">
<p id="S2.SS3.p1.1" class="ltx_p">We will now gather some relevant facts about genus <math id="S2.SS3.p1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and genus <math id="S2.SS3.p1.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> covers of <math id="S2.SS3.p1.m3" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>.</p>
</div>
<div id="S2.Thmtheorem7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem7.2" class="ltx_text ltx_font_bold">2.7</span></span><span id="S2.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem7.p1" class="ltx_para">
<p id="S2.Thmtheorem7.p1.1" class="ltx_p"><span id="S2.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S2.Thmtheorem7.p1.m1" class="ltx_Math" alttext="\alpha\colon R\to{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>R</mi><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha\colon R\to{\bf P}^{1}</annotation></semantics></math> and <math id="S2.Thmtheorem7.p1.m2" class="ltx_Math" alttext="\beta\colon X\to{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\beta\colon X\to{\bf P}^{1}</annotation></semantics></math> be degree <math id="S2.Thmtheorem7.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> covers where <math id="S2.Thmtheorem7.p1.m4" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is a smooth rational curve and <math id="S2.Thmtheorem7.p1.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a smooth elliptic curve. Then:</span></p>
<ol id="S2.I3" class="ltx_enumerate">
<li id="S2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S2.I3.i1.p1" class="ltx_para">
<p id="S2.I3.i1.p1.1" class="ltx_p"><math id="S2.I3.i1.p1.m1" class="ltx_Math" alttext="E_{\alpha}={\mathcal{O}}(1)^{\oplus d-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>α</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mi>d</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">E_{\alpha}={\mathcal{O}}(1)^{\oplus d-1}</annotation></semantics></math><span id="S2.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">,</span></p>
</div></li>
<li id="S2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S2.I3.i2.p1" class="ltx_para">
<p id="S2.I3.i2.p1.1" class="ltx_p"><math id="S2.I3.i2.p1.m1" class="ltx_Math" alttext="F_{\alpha}={\mathcal{O}}(1)^{\oplus d-3}\oplus{\mathcal{O}}(2)^{\oplus\binom{d-2}{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>α</mi></msub><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mi>d</mi></mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mn>2</mn></mfrac><mo>)</mo></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{\alpha}={\mathcal{O}}(1)^{\oplus d-3}\oplus{\mathcal{O}}(2)^{\oplus\binom{d-2}{2}}</annotation></semantics></math></p>
</div></li>
<li id="S2.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S2.I3.i3.p1" class="ltx_para">
<p id="S2.I3.i3.p1.1" class="ltx_p"><math id="S2.I3.i3.p1.m1" class="ltx_Math" alttext="E_{\beta}={\mathcal{O}}(1)^{\oplus d-2}\oplus{\mathcal{O}}(2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>β</mi></msub><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mi>d</mi></mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{\beta}={\mathcal{O}}(1)^{\oplus d-2}\oplus{\mathcal{O}}(2)</annotation></semantics></math></p>
</div></li>
<li id="S2.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="S2.I3.i4.p1" class="ltx_para">
<p id="S2.I3.i4.p1.1" class="ltx_p"><math id="S2.I3.i4.p1.m1" class="ltx_Math" alttext="F_{\beta}={\mathcal{O}}(2)^{\oplus\frac{d(d-3)}{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>β</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mfrac><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">F_{\beta}={\mathcal{O}}(2)^{\oplus\frac{d(d-3)}{2}}</annotation></semantics></math></p>
</div></li>
</ol>
</div>
</div>
<div id="S2.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS3.p2" class="ltx_para">
<p id="S2.SS3.p2.1" class="ltx_p"><span id="S2.SS3.p2.1.1" class="ltx_text">For <a href="#S2.I3.i1" title="In 2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">item</span> <span class="ltx_text ltx_ref_tag">(a)</span></a>, note that the sequence</span></p>
<table id="S2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex14.m1" class="ltx_Math" alttext="0\to{\mathcal{O}}_{{\bf P}^{1}}\to\alpha_{*}{\mathcal{O}}_{C}\to E_{\alpha}^{\vee}\to 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><mo stretchy="false">→</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>C</mi></msub></mrow><mo stretchy="false">→</mo><msubsup><mi>E</mi><mi>α</mi><mo>∨</mo></msubsup><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\to{\mathcal{O}}_{{\bf P}^{1}}\to\alpha_{*}{\mathcal{O}}_{C}\to E_{\alpha}^{\vee}\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p2.2" class="ltx_p"><span id="S2.SS3.p2.2.1" class="ltx_text">splits, and therefore <math id="S2.SS3.p2.m1" class="ltx_Math" alttext="H^{0}(E_{\alpha}^{\vee})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>E</mi><mi>α</mi><mo>∨</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{0}(E_{\alpha}^{\vee})=0</annotation></semantics></math>. This means all summands of <math id="S2.SS3.p2.m2" class="ltx_Math" alttext="E_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>α</mi></msub><annotation encoding="application/x-tex">E_{\alpha}</annotation></semantics></math> are positive and add up to <math id="S2.SS3.p2.m3" class="ltx_Math" alttext="d-1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d-1</annotation></semantics></math>. Therefore, all summands must have degree one.</span></p>
</div>
<div id="S2.SS3.p3" class="ltx_para">
<p id="S2.SS3.p3.1" class="ltx_p"><span id="S2.SS3.p3.1.1" class="ltx_text">For <a href="#S2.I3.i2" title="In 2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">item</span> <span class="ltx_text ltx_ref_tag">(b)</span></a>, note that using the relative canonical factorization <math id="S2.SS3.p3.m1" class="ltx_Math" alttext="\iota\colon R\to{\bf P}E" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>R</mi><mo stretchy="false">→</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota\colon R\to{\bf P}E</annotation></semantics></math>, we may think of <math id="S2.SS3.p3.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> as lying inside <math id="S2.SS3.p3.m3" class="ltx_Math" alttext="{\bf P}E" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">{\bf P}E</annotation></semantics></math>. The series <math id="S2.SS3.p3.m4" class="ltx_Math" alttext="|\zeta-f|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>ζ</mi><mo>−</mo><mi>f</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\zeta-f|</annotation></semantics></math> on <math id="S2.SS3.p3.m5" class="ltx_Math" alttext="{\bf P}E" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">{\bf P}E</annotation></semantics></math> restricts to the complete series <math id="S2.SS3.p3.m6" class="ltx_Math" alttext="{\mathcal{O}}_{R}(d-2)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{R}(d-2)</annotation></semantics></math>, and the morphism <math id="S2.SS3.p3.m7" class="ltx_Math" alttext="q\colon{\bf P}E\to{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">q\colon{\bf P}E\to{\bf P}^{d-2}</annotation></semantics></math> given by the series <math id="S2.SS3.p3.m8" class="ltx_Math" alttext="|\zeta-f|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>ζ</mi><mo>−</mo><mi>f</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\zeta-f|</annotation></semantics></math> restricts to the embedding of <math id="S2.SS3.p3.m9" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> into <math id="S2.SS3.p3.m10" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math> as a rational normal curve.</span></p>
</div>
<div id="S2.SS3.p4" class="ltx_para">
<p id="S2.SS3.p4.1" class="ltx_p"><span id="S2.SS3.p4.1.1" class="ltx_text">The rational normal curve <math id="S2.SS3.p4.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is contained in a <math id="S2.SS3.p4.m2" class="ltx_Math" alttext="\binom{d-2}{2}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mn>2</mn></mfrac><mo>)</mo></mrow><annotation encoding="application/x-tex">\binom{d-2}{2}</annotation></semantics></math> dimensional space of quadrics. The divisor class of these quadrics, when pulled back along <math id="S2.SS3.p4.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, is <math id="S2.SS3.p4.m4" class="ltx_Math" alttext="2\zeta-2f" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">2\zeta-2f</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS3.p5" class="ltx_para">
<p id="S2.SS3.p5.1" class="ltx_p"><span id="S2.SS3.p5.1.1" class="ltx_text">Recall the exact sequence on the target <math id="S2.SS3.p5.m1" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>:</span></p>
<table id="S2.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(10)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E10.m1" class="ltx_Math" alttext="0\to F_{\alpha}\to\Sym^{2}E_{\alpha}\to\alpha_{*}{\omega^{2}_{\alpha}}\to 0." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo stretchy="false">→</mo><msub><mi>F</mi><mi>α</mi></msub><mo stretchy="false">→</mo><mrow><msup><mi>Sym</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>E</mi><mi>α</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>α</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\to F_{\alpha}\to\Sym^{2}E_{\alpha}\to\alpha_{*}{\omega^{2}_{\alpha}}\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p5.2" class="ltx_p"><span id="S2.SS3.p5.2.1" class="ltx_text">We twist by <math id="S2.SS3.p5.m2" class="ltx_Math" alttext="{\mathcal{O}}(-2)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(-2)</annotation></semantics></math> and consider global sections, to get:</span></p>
<table id="S2.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex15.m1" class="ltx_Math" alttext="\displaystyle H^{0}({\bf P}^{1},F_{\alpha}(-2))=" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mrow><msub><mi>F</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle H^{0}({\bf P}^{1},F_{\alpha}(-2))=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex15.m2" class="ltx_Math" alttext="\displaystyle\ker(H^{0}({\bf P}^{1},\Sym^{2}E_{\alpha}(-2))\to H^{0}({\bf P}^{1},\alpha_{*}{\omega^{2}_{\alpha}}(-2)))" display="inline" intent=":literal"><semantics><mrow><mi>ker</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mrow><mrow><msup><mi>Sym</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>E</mi><mi>α</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo>,</mo><mrow><msub><mi>α</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>α</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ker(H^{0}({\bf P}^{1},\Sym^{2}E_{\alpha}(-2))\to H^{0}({\bf P}^{1},\alpha_{*}{\omega^{2}_{\alpha}}(-2)))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex16.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex16.m2" class="ltx_Math" alttext="\displaystyle\ker(H^{0}({\bf P}E_{\alpha},2\zeta-2f)\to H^{0}(R,(2\zeta-2f)|_{R}))" display="inline" intent=":literal"><semantics><mrow><mi>ker</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>α</mi></msub></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo>,</mo><msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mi>R</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ker(H^{0}({\bf P}E_{\alpha},2\zeta-2f)\to H^{0}(R,(2\zeta-2f)|_{R}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex17.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex17.m2" class="ltx_Math" alttext="\displaystyle\ker(H^{0}({\bf P}^{d-2},{\mathcal{O}}_{{\bf P}^{d-2}}(2))\to H^{0}(R,{\mathcal{O}}_{{\bf P}^{d-2}}(2)|_{R}))" display="inline" intent=":literal"><semantics><mrow><mi>ker</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo>,</mo><msub><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>R</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ker(H^{0}({\bf P}^{d-2},{\mathcal{O}}_{{\bf P}^{d-2}}(2))\to H^{0}(R,{\mathcal{O}}_{{\bf P}^{d-2}}(2)|_{R}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.SS3.p6" class="ltx_para">
<p id="S2.SS3.p6.1" class="ltx_p"><span id="S2.SS3.p6.1.1" class="ltx_text">The previous paragraph along with projective normality of <math id="S2.SS3.p6.m1" class="ltx_Math" alttext="R\subset{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">R\subset{\bf P}^{d-2}</annotation></semantics></math> imply that <math id="S2.SS3.p6.m2" class="ltx_Math" alttext="h^{0}(F_{\alpha}(-2))=\binom{d-2}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>F</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">h^{0}(F_{\alpha}(-2))=\binom{d-2}{2}</annotation></semantics></math>. We conclude by noting that (<a href="#S2.E10" title="Equation 10 ‣ Proof. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) shows that no degree of a summand of <math id="S2.SS3.p6.m3" class="ltx_Math" alttext="F_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>α</mi></msub><annotation encoding="application/x-tex">F_{\alpha}</annotation></semantics></math> may exceed <math id="S2.SS3.p6.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, and the degree of <math id="S2.SS3.p6.m5" class="ltx_Math" alttext="F_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>α</mi></msub><annotation encoding="application/x-tex">F_{\alpha}</annotation></semantics></math> must be <math id="S2.SS3.p6.m6" class="ltx_Math" alttext="(d-3)(d-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(d-3)(d-1)</annotation></semantics></math>. This forces its splitting type to be <math id="S2.SS3.p6.m7" class="ltx_Math" alttext="{\mathcal{O}}(1)^{\oplus d-3}\oplus{\mathcal{O}}(2)^{\oplus\binom{d-2}{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>⊕</mo><mi>d</mi></mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mn>2</mn></mfrac><mo>)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(1)^{\oplus d-3}\oplus{\mathcal{O}}(2)^{\oplus\binom{d-2}{2}}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS3.p7" class="ltx_para">
<p id="S2.SS3.p7.1" class="ltx_p"><span id="S2.SS3.p7.1.1" class="ltx_text">For <a href="#S2.I3.i3" title="In 2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">item</span> <span class="ltx_text ltx_ref_tag">(c)</span></a>, we note that all <math id="S2.SS3.p7.m1" class="ltx_Math" alttext="d-1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d-1</annotation></semantics></math> summands of <math id="S2.SS3.p7.m2" class="ltx_Math" alttext="E_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>β</mi></msub><annotation encoding="application/x-tex">E_{\beta}</annotation></semantics></math> are positive, and their degrees sum to <math id="S2.SS3.p7.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. Therefore <math id="S2.SS3.p7.m4" class="ltx_Math" alttext="E_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>β</mi></msub><annotation encoding="application/x-tex">E_{\beta}</annotation></semantics></math> must be as indicated.</span></p>
</div>
<div id="S2.SS3.p8" class="ltx_para">
<p id="S2.SS3.p8.1" class="ltx_p"><span id="S2.SS3.p8.1.1" class="ltx_text">Finally, for <a href="#S2.I3.i4" title="In 2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">item</span> <span class="ltx_text ltx_ref_tag">(d)</span></a>, see that the pencil of sections of <math id="S2.SS3.p8.m1" class="ltx_Math" alttext="\beta^{*}{\mathcal{O}}_{{\bf P}^{1}}(1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>β</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta^{*}{\mathcal{O}}_{{\bf P}^{1}}(1)</annotation></semantics></math> on <math id="S2.SS3.p8.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> forms a two dimensional vector subspace of its complete linear system. The complete series gives an embedding of <math id="S2.SS3.p8.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> into the projective space <math id="S2.SS3.p8.m4" class="ltx_Math" alttext="{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-1}</annotation></semantics></math>, and the map <math id="S2.SS3.p8.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> is realized as projection from a general <math id="S2.SS3.p8.m6" class="ltx_Math" alttext="(d-3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d-3)</annotation></semantics></math>-dimensional linear space <math id="S2.SS3.p8.m7" class="ltx_Math" alttext="\Lambda\subset{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\Lambda\subset{\bf P}^{d-1}</annotation></semantics></math> disjoint from <math id="S2.SS3.p8.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS3.p9" class="ltx_para">
<p id="S2.SS3.p9.1" class="ltx_p"><span id="S2.SS3.p9.1.1" class="ltx_text">We note that <math id="S2.SS3.p9.m1" class="ltx_Math" alttext="{\bf P}E" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">{\bf P}E</annotation></semantics></math>, as an abstract scroll, is isomorphic to <math id="S2.SS3.p9.m2" class="ltx_Math" alttext="Y:=Bl_{\Lambda}{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>:=</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>l</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">Y:=Bl_{\Lambda}{\bf P}^{d-1}</annotation></semantics></math>. The linear system <math id="S2.SS3.p9.m3" class="ltx_Math" alttext="|\zeta-f|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>ζ</mi><mo>−</mo><mi>f</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\zeta-f|</annotation></semantics></math> provides the map <math id="S2.SS3.p9.m4" class="ltx_Math" alttext="f\colon{\bf P}E\to{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f\colon{\bf P}E\to{\bf P}^{d-1}</annotation></semantics></math>. Furthermore, the linear system <math id="S2.SS3.p9.m5" class="ltx_Math" alttext="|2\zeta-2f|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|2\zeta-2f|</annotation></semantics></math> parametrizes the quadric hypersurfaces in <math id="S2.SS3.p9.m6" class="ltx_Math" alttext="{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-1}</annotation></semantics></math>. Therefore, <math id="S2.SS3.p9.m7" class="ltx_Math" alttext="h^{0}(F_{\beta}(-2))" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>F</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h^{0}(F_{\beta}(-2))</annotation></semantics></math> is simply the vector space dimension of quadrics in <math id="S2.SS3.p9.m8" class="ltx_Math" alttext="{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-1}</annotation></semantics></math> containing the elliptic normal curve <math id="S2.SS3.p9.m9" class="ltx_Math" alttext="X\subset{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">X\subset{\bf P}^{d-1}</annotation></semantics></math>, which is easily calculated to be <math id="S2.SS3.p9.m10" class="ltx_Math" alttext="d(d-3)/2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d(d-3)/2</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS3.p10" class="ltx_para">
<p id="S2.SS3.p10.1" class="ltx_p"><span id="S2.SS3.p10.1.1" class="ltx_text">Next we show that <math id="S2.SS3.p10.m1" class="ltx_Math" alttext="h^{0}(F_{\beta}(-3))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>F</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{0}(F_{\beta}(-3))=0</annotation></semantics></math>. An element of the linear system <math id="S2.SS3.p10.m2" class="ltx_Math" alttext="|2\zeta-3f|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|2\zeta-3f|</annotation></semantics></math> corresponds to a quadric in <math id="S2.SS3.p10.m3" class="ltx_Math" alttext="{\bf P}^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-1}</annotation></semantics></math> which splits off a hyperplane component <math id="S2.SS3.p10.m4" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> containing <math id="S2.SS3.p10.m5" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>. No such quadric can contain the elliptic normal curve <math id="S2.SS3.p10.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, by nondegeneracy of the curve. This means <math id="S2.SS3.p10.m7" class="ltx_Math" alttext="h^{0}(F_{\beta}(-3))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>F</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{0}(F_{\beta}(-3))=0</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS3.p11" class="ltx_para">
<p id="S2.SS3.p11.1" class="ltx_p"><span id="S2.SS3.p11.1.1" class="ltx_text">Therefore, the largest degree summand of <math id="S2.SS3.p11.m1" class="ltx_Math" alttext="F_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>β</mi></msub><annotation encoding="application/x-tex">F_{\beta}</annotation></semantics></math> is <math id="S2.SS3.p11.m2" class="ltx_Math" alttext="\mathcal{O}(2)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(2)</annotation></semantics></math>. Since the degree of <math id="S2.SS3.p11.m3" class="ltx_Math" alttext="F_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>β</mi></msub><annotation encoding="application/x-tex">F_{\beta}</annotation></semantics></math>, by sequence (<a href="#S2.E10" title="Equation 10 ‣ Proof. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>), is <math id="S2.SS3.p11.m4" class="ltx_Math" alttext="d(d-3)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(d-3)</annotation></semantics></math> we conclude that <math id="S2.SS3.p11.m5" class="ltx_Math" alttext="F_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>β</mi></msub><annotation encoding="application/x-tex">F_{\beta}</annotation></semantics></math> must split as <math id="S2.SS3.p11.m6" class="ltx_Math" alttext="\mathcal{O}(2)^{\oplus\frac{d(d-3)}{2}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mfrac><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{O}(2)^{\oplus\frac{d(d-3)}{2}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S2.Thmtheorem8" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem8.2" class="ltx_text ltx_font_italic">2.8</span></span><span id="S2.Thmtheorem8.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S2.Thmtheorem8.p1" class="ltx_para">
<p id="S2.Thmtheorem8.p1.1" class="ltx_p">Of course <a href="#S2.Thmtheorem7" title="2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">2.7</span></a> part <math id="S2.Thmtheorem8.p1.m1" class="ltx_Math" alttext="(d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d)</annotation></semantics></math> also follows from the much more general <a href="#S2.Thmtheorem4" title="2.4. ‣ 2.2. Evidence ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">2.4</span></a>.</p>
</div>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3. </span>Vector bundles on rational chains</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">In this section we find necessary and sufficient conditions for determining when a vector bundle on a chain of rational curves is balanced. We will eventually use these criteria to prove <a href="#S4.Thmtheorem1" title="4.1. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>.</p>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">Let <math id="S3.p2.m1" class="ltx_Math" alttext="{\bf P}=P_{1}\cup P_{2}\cup\ldots\cup P_{k}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>=</mo><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>P</mi><mn>2</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>P</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\bf P}=P_{1}\cup P_{2}\cup\ldots\cup P_{k}</annotation></semantics></math> be a chain of <math id="S3.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> rational curves <math id="S3.p2.m3" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math>, and let <math id="S3.p2.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a vector bundle on <math id="S3.p2.m5" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math> of rank <math id="S3.p2.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. We let <math id="S3.p2.m7" class="ltx_Math" alttext="V_{i}=V|_{P_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>i</mi></msub><mo>=</mo><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><msub><mi>P</mi><mi>i</mi></msub></msub></mrow><annotation encoding="application/x-tex">V_{i}=V|_{P_{i}}</annotation></semantics></math> be the restriction to the <math id="S3.p2.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th component, and we denote by <math id="S3.p2.m9" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> the node <math id="S3.p2.m10" class="ltx_Math" alttext="P_{i}\cap P_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>i</mi></msub><mo>∩</mo><msub><mi>P</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">P_{i}\cap P_{i+1}</annotation></semantics></math>, for <math id="S3.p2.m11" class="ltx_Math" alttext="i=1,\ldots,k-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=1,\ldots,k-1</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem1.2" class="ltx_text ltx_font_bold">3.1</span></span><span id="S3.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem1.p1" class="ltx_para">
<p id="S3.Thmtheorem1.p1.1" class="ltx_p">A vector bundle <math id="S3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> on a reduced curve <math id="S3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is <em id="S3.Thmtheorem1.p1.1.1" class="ltx_emph ltx_font_italic">balanced</em> if</p>
<table id="S3.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex18.m1" class="ltx_Math" alttext="h^{1}(\End V)=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h^{1}(\End V)=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p">Since the first order deformations of a vector bundle <math id="S3.p3.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> are parametrized by <math id="S3.p3.m2" class="ltx_Math" alttext="\Ext^{1}(V,V)=H^{1}(\End V)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>Ext</mi><mn>1</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Ext^{1}(V,V)=H^{1}(\End V)</annotation></semantics></math>, we see that a balanced vector bundle does not deform. Our goal is to determine necessary and sufficient criteria for a vector bundle <math id="S3.p3.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> on the chain <math id="S3.p3.m4" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math> to be balanced in terms of the “relative position” of the vector bundles <math id="S3.p3.m5" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math>.</p>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p">Our first easy observation is the following.</p>
</div>
<div id="S3.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem2.2" class="ltx_text ltx_font_bold">3.2</span></span><span id="S3.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem2.p1" class="ltx_para">
<p id="S3.Thmtheorem2.p1.1" class="ltx_p"><span id="S3.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a vector bundle on <math id="S3.Thmtheorem2.p1.m2" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math> of rank <math id="S3.Thmtheorem2.p1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. If <math id="S3.Thmtheorem2.p1.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is balanced, then every component <math id="S3.Thmtheorem2.p1.m5" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> is a balanced vector bundle on <math id="S3.Thmtheorem2.p1.m6" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p5" class="ltx_para">
<p id="S3.p5.1" class="ltx_p"><span id="S3.p5.1.1" class="ltx_text">Let <math id="S3.p5.m1" class="ltx_Math" alttext="\nu\colon\coprod_{i}P_{i}\to{\bf P}" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><msub><mo>∐</mo><mi>i</mi></msub><msub><mi>P</mi><mi>i</mi></msub></mrow><mo stretchy="false">→</mo><mi>𝐏</mi></mrow></mrow><annotation encoding="application/x-tex">\nu\colon\coprod_{i}P_{i}\to{\bf P}</annotation></semantics></math> be the total normalization map. Consider the exact sequence of <math id="S3.p5.m2" class="ltx_Math" alttext="{\mathcal{O}}_{{\bf P}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>𝐏</mi></msub><annotation encoding="application/x-tex">{\mathcal{O}}_{{\bf P}}</annotation></semantics></math>-sheaves</span></p>
<table id="S3.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(11)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E11.m1" class="ltx_math_unparsed" alttext="0\to\End V\to\nu_{*}\nu^{*}(\End V)\to\oplus_{i}\End(k(p_{i})^{r})\to 0." display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">→</mo><mi>End</mi><mi>V</mi><mo stretchy="false">→</mo><msub><mi>ν</mi><mo>∗</mo></msub><msup><mi>ν</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>End</mi><mi>V</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em" stretchy="false">→</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><mi>End</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\to\End V\to\nu_{*}\nu^{*}(\End V)\to\oplus_{i}\End(k(p_{i})^{r})\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p5.2" class="ltx_p"><span id="S3.p5.2.1" class="ltx_text">The last part of the long exact sequence of cohomology looks like</span></p>
<table id="S3.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex19.m1" class="ltx_Math" alttext="\ldots\to H^{1}({\bf P},\End V)\to H^{1}({\bf P},\nu_{*}\nu^{*}\End V)\to 0." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">…</mi><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐏</mi><mo>,</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐏</mi><mo>,</mo><mrow><msub><mi>ν</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ν</mi><mo>∗</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ldots\to H^{1}({\bf P},\End V)\to H^{1}({\bf P},\nu_{*}\nu^{*}\End V)\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p5.3" class="ltx_p"><span id="S3.p5.3.1" class="ltx_text">Since <math id="S3.p5.m3" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> is finite, we can identify the vector space <math id="S3.p5.m4" class="ltx_Math" alttext="H^{1}({\bf P},\nu_{*}\nu^{*}\End V)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐏</mi><mo>,</mo><mrow><msub><mi>ν</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ν</mi><mo>∗</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}({\bf P},\nu_{*}\nu^{*}\End V)</annotation></semantics></math> with <math id="S3.p5.m5" class="ltx_math_unparsed" alttext="H^{1}(\coprod P_{i},\nu^{*}\End V)=\oplus_{i}H^{1}(P_{i},\End V_{i})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">∐</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><msup><mi>ν</mi><mo>∗</mo></msup><mi>End</mi><mi>V</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mi>End</mi><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\coprod P_{i},\nu^{*}\End V)=\oplus_{i}H^{1}(P_{i},\End V_{i})</annotation></semantics></math>. Therefore, if <math id="S3.p5.m6" class="ltx_Math" alttext="H^{1}({\bf P},\End V)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐏</mi><mo>,</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{1}({\bf P},\End V)=0</annotation></semantics></math>, then <math id="S3.p5.m7" class="ltx_math_unparsed" alttext="\oplus_{i}H^{1}(P_{i},\End V_{i})=0" display="inline" intent=":literal"><semantics><mrow><msub><mo>⊕</mo><mi>i</mi></msub><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mi>End</mi><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\oplus_{i}H^{1}(P_{i},\End V_{i})=0</annotation></semantics></math>, which proves the lemma.
∎</span></p>
</div>
</div>
<div id="S3.p6" class="ltx_para">
<p id="S3.p6.1" class="ltx_p">We now assume that each component <math id="S3.p6.m1" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> is balanced. Consider the long exact sequence of cohomology groups associated to (<a href="#S3.E11" title="Equation 11 ‣ Proof. ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>):</p>
<table id="S3.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(12)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E12.m1" class="ltx_math_unparsed" alttext="\ldots\to\oplus_{i}H^{0}(P_{i},\End V_{i})\to\oplus_{i}\End(k(p_{i})^{r})\to H^{1}(P,\End V)\to 0" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">…</mi><mo rspace="0em" stretchy="false">→</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mi>End</mi><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em" stretchy="false">→</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><mi>End</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi>End</mi><mi>V</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\ldots\to\oplus_{i}H^{0}(P_{i},\End V_{i})\to\oplus_{i}\End(k(p_{i})^{r})\to H^{1}(P,\End V)\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p6.2" class="ltx_p">This sequence shows that <math id="S3.p6.m2" class="ltx_Math" alttext="h^{1}(P,\End V)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{1}(P,\End V)=0</annotation></semantics></math> if and only if the map</p>
<table id="S3.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex20.m1" class="ltx_math_unparsed" alttext="D\colon\oplus_{i}H^{0}(P_{i},\End V_{i})\to\oplus_{i}\End(k(p_{i})^{r})" display="block" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0.278em" rspace="0em">:</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mi>End</mi><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em" stretchy="false">→</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><mi>End</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D\colon\oplus_{i}H^{0}(P_{i},\End V_{i})\to\oplus_{i}\End(k(p_{i})^{r})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p6.3" class="ltx_p">is surjective. The map <math id="S3.p6.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is described as follows. Let <math id="S3.p6.m4" class="ltx_Math" alttext="\infty_{i}\in P_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">∞</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>P</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\infty_{i}\in P_{i}</annotation></semantics></math>, <math id="S3.p6.m5" class="ltx_Math" alttext="0_{i+1}\in P_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mn>0</mn><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∈</mo><msub><mi>P</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">0_{i+1}\in P_{i+1}</annotation></semantics></math> denote the two pre images of the node <math id="S3.p6.m6" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> in the normalization <math id="S3.p6.m7" class="ltx_Math" alttext="\coprod P_{i}" display="inline" intent=":literal"><semantics><mrow><mo>∐</mo><msub><mi>P</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\coprod P_{i}</annotation></semantics></math>. For any <math id="S3.p6.m8" class="ltx_math_unparsed" alttext="(M_{1},\ldots,M_{k})\in\oplus_{i}H^{0}(P_{i},\End V_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>M</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">∈</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mi>End</mi><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(M_{1},\ldots,M_{k})\in\oplus_{i}H^{0}(P_{i},\End V_{i})</annotation></semantics></math>,</p>
<table id="S3.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex21.m1" class="ltx_Math" alttext="D(M_{1},\ldots,M_{k})=(M_{1}|_{\infty_{1}}-M_{2}|_{0_{2}},\ldots,M_{k-1}|_{\infty_{k-1}}-M_{k}|_{0_{k}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>M</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><msub><mi mathvariant="normal">∞</mi><mn>1</mn></msub></msub><mo>−</mo><msub><mrow><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><msub><mn>0</mn><mn>2</mn></msub></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mrow><msub><mi>M</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><msub><mi mathvariant="normal">∞</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo>−</mo><msub><mrow><msub><mi>M</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow><msub><mn>0</mn><mi>k</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D(M_{1},\ldots,M_{k})=(M_{1}|_{\infty_{1}}-M_{2}|_{0_{2}},\ldots,M_{k-1}|_{\infty_{k-1}}-M_{k}|_{0_{k}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p6.4" class="ltx_p">In other words, since the structure sheaves <math id="S3.p6.m9" class="ltx_Math" alttext="k(\infty_{i})" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">∞</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">k(\infty_{i})</annotation></semantics></math> and <math id="S3.p6.m10" class="ltx_Math" alttext="k(0_{i+1})" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mn>0</mn><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">k(0_{i+1})</annotation></semantics></math> are naturally identified with <math id="S3.p6.m11" class="ltx_Math" alttext="k(p_{i})" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">k(p_{i})</annotation></semantics></math> via the normalization map <math id="S3.p6.m12" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math>, we may compare the restriction of any section <math id="S3.p6.m13" class="ltx_Math" alttext="M_{i}\in H^{0}(P_{i},\End V_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><msub><mi>V</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{i}\in H^{0}(P_{i},\End V_{i})</annotation></semantics></math> at <math id="S3.p6.m14" class="ltx_Math" alttext="\infty_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">∞</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\infty_{i}</annotation></semantics></math> with the restriction of any section <math id="S3.p6.m15" class="ltx_Math" alttext="M_{i+1}\in H^{0}(P_{i+1},\End V_{i+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><msub><mi>V</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{i+1}\in H^{0}(P_{i+1},\End V_{i+1})</annotation></semantics></math> at <math id="S3.p6.m16" class="ltx_Math" alttext="0_{i+1}" display="inline" intent=":literal"><semantics><msub><mn>0</mn><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">0_{i+1}</annotation></semantics></math>. For this reason, we call <math id="S3.p6.m17" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> the <em id="S3.p6.4.1" class="ltx_emph ltx_font_italic">difference</em> map. (We are using the letter <math id="S3.p6.m18" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> to emphasize that we are thinking of these sections as <math id="S3.p6.m19" class="ltx_Math" alttext="r\times r" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">r\times r</annotation></semantics></math> matrices.)</p>
</div>
<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p">Recall that the first order deformation space of a vector bundle <math id="S3.p7.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is naturally identified with the vector space <math id="S3.p7.m2" class="ltx_Math" alttext="H^{1}(\End V)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{1}(\End V)</annotation></semantics></math>. Consider the connecting homomorphism</p>
<table id="S3.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex22.m1" class="ltx_math_unparsed" alttext="\oplus_{i}\End(k(p_{i})^{r})\to H^{1}(P,\End V)." display="block" intent=":literal"><semantics><mrow><msub><mo>⊕</mo><mi>i</mi></msub><mi>End</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi>End</mi><mi>V</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\oplus_{i}\End(k(p_{i})^{r})\to H^{1}(P,\End V).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.2" class="ltx_p">There is a very simple way of interpreting this map in terms of the deformations of <math id="S3.p7.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>. A vector bundle <math id="S3.p7.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> on <math id="S3.p7.m5" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math> is equivalent to the data of the <math id="S3.p7.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> vector bundles <math id="S3.p7.m7" class="ltx_Math" alttext="(V_{1},\ldots,V_{k})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>V</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V_{1},\ldots,V_{k})</annotation></semantics></math> and gluing maps <math id="S3.p7.m8" class="ltx_Math" alttext="(g_{1},\ldots,g_{k-1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>g</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g_{1},\ldots,g_{k-1})</annotation></semantics></math>, where <math id="S3.p7.m9" class="ltx_Math" alttext="g_{i}\colon V_{i}|_{\infty_{i}}\to V_{i+1}|_{0_{i+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi mathvariant="normal">∞</mi><mi>i</mi></msub></msub><mo stretchy="false">→</mo><msub><mrow><msub><mi>V</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><msub><mn>0</mn><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msub></mrow></mrow><annotation encoding="application/x-tex">g_{i}\colon V_{i}|_{\infty_{i}}\to V_{i+1}|_{0_{i+1}}</annotation></semantics></math> are invertible linear maps. We can deform this data by simply varying the gluing maps, viewed as invertible <math id="S3.p7.m10" class="ltx_Math" alttext="r\times r" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">r\times r</annotation></semantics></math> matrices. The tangent space to <math id="S3.p7.m11" class="ltx_Math" alttext="\GL_{r}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>GL</mi><mi>r</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\GL_{r}(k)</annotation></semantics></math> is the space <math id="S3.p7.m12" class="ltx_Math" alttext="M_{r\times r}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{r\times r}(k)</annotation></semantics></math> of <math id="S3.p7.m13" class="ltx_Math" alttext="r\times r" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">r\times r</annotation></semantics></math> matrices, and the resulting <math id="S3.p7.m14" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math>-tuple of of elements in <math id="S3.p7.m15" class="ltx_Math" alttext="M_{r\times r}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">M_{r\times r}</annotation></semantics></math> correspond to components in the direct sum <math id="S3.p7.m16" class="ltx_math_unparsed" alttext="\oplus_{i}\End(k(p_{i})^{r})" display="inline" intent=":literal"><semantics><mrow><msub><mo>⊕</mo><mi>i</mi></msub><mi>End</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\oplus_{i}\End(k(p_{i})^{r})</annotation></semantics></math>. Therefore, by considering different gluing data, we think of the condition of being balanced as a condition about the “relative position” of the <math id="S3.p7.m17" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> being general. We will make this more precise in the next subsection.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1. </span>Directrices and Filtrations</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">A balanced bundle on <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math> has a canonically defined <em id="S3.SS1.p1.1.1" class="ltx_emph ltx_font_italic">directrix</em> subbundle.</p>
</div>
<div id="S3.Thmtheorem3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem3.2" class="ltx_text ltx_font_bold">3.3</span></span><span id="S3.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem3.p1" class="ltx_para">
<p id="S3.Thmtheorem3.p1.1" class="ltx_p">Let <math id="S3.Thmtheorem3.p1.m1" class="ltx_Math" alttext="V={\mathcal{O}}(m)^{\oplus a}\oplus{\mathcal{O}}(m+1)^{\oplus b}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>a</mi></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>b</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">V={\mathcal{O}}(m)^{\oplus a}\oplus{\mathcal{O}}(m+1)^{\oplus b}</annotation></semantics></math> be a balanced vector bundle on <math id="S3.Thmtheorem3.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>. Then the <em id="S3.Thmtheorem3.p1.1.1" class="ltx_emph ltx_font_italic">directrix</em> subbundle <math id="S3.Thmtheorem3.p1.m3" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is the summand <math id="S3.Thmtheorem3.p1.m4" class="ltx_Math" alttext="{\mathcal{O}}(m+1)^{\oplus b}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>b</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(m+1)^{\oplus b}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">Now let us mark two points <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math> on <math id="S3.SS1.p2.m3" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>, and let <math id="S3.SS1.p2.m4" class="ltx_math_unparsed" alttext="[s:t]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[s:t]</annotation></semantics></math> be homogeneous coordinates on <math id="S3.SS1.p2.m5" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math> with <math id="S3.SS1.p2.m6" class="ltx_math_unparsed" alttext="0=[0:1]" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">0=[0:1]</annotation></semantics></math> and <math id="S3.SS1.p2.m7" class="ltx_math_unparsed" alttext="\infty=[1:0]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">∞</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\infty=[1:0]</annotation></semantics></math>. Suppose <math id="S3.SS1.p2.m8" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is a balanced vector bundle on <math id="S3.SS1.p2.m9" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math> and <math id="S3.SS1.p2.m10" class="ltx_Math" alttext="W\subset V" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>⊂</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">W\subset V</annotation></semantics></math> its directrix subbundle. Of course, there is no canonical identification of <math id="S3.SS1.p2.m11" class="ltx_Math" alttext="V|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">V|_{0}</annotation></semantics></math> with <math id="S3.SS1.p2.m12" class="ltx_Math" alttext="V|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">V|_{\infty}</annotation></semantics></math>, since the vector bundle is not trivial.
However, since <math id="S3.SS1.p2.m13" class="ltx_Math" alttext="W={\mathcal{O}}(m+1)^{\oplus b}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>b</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">W={\mathcal{O}}(m+1)^{\oplus b}</annotation></semantics></math>, the subbundle <math id="S3.SS1.p2.m14" class="ltx_Math" alttext="{\bf P}W\subset{\bf P}V" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo>⊂</mo><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">{\bf P}W\subset{\bf P}V</annotation></semantics></math> <em id="S3.SS1.p2.1.1" class="ltx_emph ltx_font_italic">is</em> trivial.
Therefore, the subspace <math id="S3.SS1.p2.m15" class="ltx_Math" alttext="W|_{0}\subset V|_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>⊂</mo><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">W|_{0}\subset V|_{0}</annotation></semantics></math> naturally corresponds to the subspace <math id="S3.SS1.p2.m16" class="ltx_Math" alttext="W|_{\infty}\subset V|_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>⊂</mo><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">W|_{\infty}\subset V|_{\infty}</annotation></semantics></math>, <em id="S3.SS1.p2.1.2" class="ltx_emph ltx_font_italic">as a subspace</em>. Similarly, any linear subspace <math id="S3.SS1.p2.m17" class="ltx_Math" alttext="L|_{0}\subset W|_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>L</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>⊂</mo><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">L|_{0}\subset W|_{0}</annotation></semantics></math> corresponds to a unique subspace <math id="S3.SS1.p2.m18" class="ltx_Math" alttext="L_{\infty}\subset W_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi mathvariant="normal">∞</mi></msub><mo>⊂</mo><msub><mi>W</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">L_{\infty}\subset W_{\infty}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS1.p3" class="ltx_para">
<p id="S3.SS1.p3.1" class="ltx_p">By the same token, since <math id="S3.SS1.p3.m1" class="ltx_Math" alttext="V/W={\mathcal{O}}(m)^{\oplus a}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mrow><mo>⊕</mo><mi>a</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">V/W={\mathcal{O}}(m)^{\oplus a}</annotation></semantics></math>, we see that any subspace <math id="S3.SS1.p3.m2" class="ltx_Math" alttext="N|_{0}\subset V/W|_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>N</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>⊂</mo><mrow><mi>V</mi><mo>/</mo><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">N|_{0}\subset V/W|_{0}</annotation></semantics></math> can be naturally identified with a subspace <math id="S3.SS1.p3.m3" class="ltx_Math" alttext="N|_{\infty}\subset V/W|_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>N</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>⊂</mo><mrow><mi>V</mi><mo>/</mo><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">N|_{\infty}\subset V/W|_{\infty}</annotation></semantics></math>. To summarize we have established the following.</p>
</div>
<div id="S3.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem4.2" class="ltx_text ltx_font_bold">3.4</span></span><span id="S3.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem4.p1" class="ltx_para">
<p id="S3.Thmtheorem4.p1.1" class="ltx_p"><span id="S3.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem4.p1.m1" class="ltx_Math" alttext="W\subset V" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>⊂</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">W\subset V</annotation></semantics></math> be as above. Then subspaces of <math id="S3.Thmtheorem4.p1.m2" class="ltx_Math" alttext="W|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">W|_{0}</annotation></semantics></math> are in natural one to one correspondence with subspaces of <math id="S3.Thmtheorem4.p1.m3" class="ltx_Math" alttext="W|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">W|_{\infty}</annotation></semantics></math>. Furthermore, intermediate subspaces <math id="S3.Thmtheorem4.p1.m4" class="ltx_Math" alttext="W|_{0}\subset N_{0}\subset V|_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>⊂</mo><msub><mi>N</mi><mn>0</mn></msub><mo>⊂</mo><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">W|_{0}\subset N_{0}\subset V|_{0}</annotation></semantics></math> are in natural one to one correspondence with intermediate subspaces <math id="S3.Thmtheorem4.p1.m5" class="ltx_Math" alttext="W|_{\infty}\subset N_{\infty}\subset V|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>⊂</mo><msub><mi>N</mi><mi mathvariant="normal">∞</mi></msub><mo>⊂</mo><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">W|_{\infty}\subset N_{\infty}\subset V|_{\infty}.</annotation></semantics></math></span></p>
</div>
</div>
<div id="S3.Thmtheorem5" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem5.2" class="ltx_text ltx_font_bold">3.5</span></span><span id="S3.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem5.p1" class="ltx_para">
<p id="S3.Thmtheorem5.p1.1" class="ltx_p">Let <math id="S3.Thmtheorem5.p1.m1" class="ltx_Math" alttext="F^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">F^{\bullet}</annotation></semantics></math> be an increasing filtration of a vector space <math id="S3.Thmtheorem5.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, and let <math id="S3.Thmtheorem5.p1.m3" class="ltx_Math" alttext="B\subset A" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⊂</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">B\subset A</annotation></semantics></math> be a subspace. We say that <math id="S3.Thmtheorem5.p1.m4" class="ltx_Math" alttext="F^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">F^{\bullet}</annotation></semantics></math> <em id="S3.Thmtheorem5.p1.1.1" class="ltx_emph ltx_font_italic">contains</em> <math id="S3.Thmtheorem5.p1.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> if <math id="S3.Thmtheorem5.p1.m6" class="ltx_Math" alttext="B=F^{i}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><msup><mi>F</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">B=F^{i}</annotation></semantics></math> for some <math id="S3.Thmtheorem5.p1.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.Thmtheorem6" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem6.2" class="ltx_text ltx_font_bold">3.6</span></span><span id="S3.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem6.p1" class="ltx_para">
<p id="S3.Thmtheorem6.p1.1" class="ltx_p"><span id="S3.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">The filtrations <math id="S3.Thmtheorem6.p1.m1" class="ltx_Math" alttext="F^{\bullet}_{0}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mn>0</mn><mo>∙</mo></msubsup><annotation encoding="application/x-tex">F^{\bullet}_{0}</annotation></semantics></math> of <math id="S3.Thmtheorem6.p1.m2" class="ltx_Math" alttext="V|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">V|_{0}</annotation></semantics></math> containing <math id="S3.Thmtheorem6.p1.m3" class="ltx_Math" alttext="W|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">W|_{0}</annotation></semantics></math> are in natural one to one correspondence with the filtrations <math id="S3.Thmtheorem6.p1.m4" class="ltx_Math" alttext="F^{\bullet}_{\infty}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mi mathvariant="normal">∞</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">F^{\bullet}_{\infty}</annotation></semantics></math> of <math id="S3.Thmtheorem6.p1.m5" class="ltx_Math" alttext="V|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">V|_{\infty}</annotation></semantics></math> containing <math id="S3.Thmtheorem6.p1.m6" class="ltx_Math" alttext="W|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">W|_{\infty}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS1.p4" class="ltx_para">
<p id="S3.SS1.p4.1" class="ltx_p">We let</p>
<table id="S3.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex23.m1" class="ltx_Math" alttext="r\colon\big\{\text{filt. $F^{\bullet}_{0}$ of $V|_{0}$ containing $W|_{0}$ }\big\}\to\big\{\text{filt. $F^{\bullet}_{\infty}$ of $V|_{\infty}$ containing $W|_{\infty}$}\big\}" display="block" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mtext>filt. </mtext><msubsup><mi>F</mi><mn>0</mn><mo>∙</mo></msubsup><mtext> of </mtext><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mtext> containing </mtext><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mtext> </mtext></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>filt. </mtext><msubsup><mi>F</mi><mi mathvariant="normal">∞</mi><mo>∙</mo></msubsup><mtext> of </mtext><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mtext> containing </mtext><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r\colon\big\{\text{filt. $F^{\bullet}_{0}$ of $V|_{0}$ containing $W|_{0}$ }\big\}\to\big\{\text{filt. $F^{\bullet}_{\infty}$ of $V|_{\infty}$ containing $W|_{\infty}$}\big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p4.2" class="ltx_p">denote the natural correspondence, and let <math id="S3.SS1.p4.m1" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> denote its inverse. We call <math id="S3.SS1.p4.m2" class="ltx_Math" alttext="r(F^{\bullet}_{0})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>F</mi><mn>0</mn><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(F^{\bullet}_{0})</annotation></semantics></math> the <em id="S3.SS1.p4.2.1" class="ltx_emph ltx_font_italic">right transport</em> of <math id="S3.SS1.p4.m3" class="ltx_Math" alttext="F^{\bullet}_{0}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mn>0</mn><mo>∙</mo></msubsup><annotation encoding="application/x-tex">F^{\bullet}_{0}</annotation></semantics></math>, and <math id="S3.SS1.p4.m4" class="ltx_Math" alttext="l(F^{\bullet}_{\infty})" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>F</mi><mi mathvariant="normal">∞</mi><mo>∙</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">l(F^{\bullet}_{\infty})</annotation></semantics></math> the <em id="S3.SS1.p4.2.2" class="ltx_emph ltx_font_italic">left transport</em> of <math id="S3.SS1.p4.m5" class="ltx_Math" alttext="F^{\bullet}_{\infty}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mi mathvariant="normal">∞</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">F^{\bullet}_{\infty}</annotation></semantics></math></p>
</div>
<div id="S3.SS1.p5" class="ltx_para">
<p id="S3.SS1.p5.1" class="ltx_p">For a balanced vector bundle <math id="S3.SS1.p5.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> with directrix <math id="S3.SS1.p5.m2" class="ltx_Math" alttext="W\subset V" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>⊂</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">W\subset V</annotation></semantics></math>, we define</p>
<table id="S3.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex24.m1" class="ltx_math_unparsed" alttext="G^{\bullet}(V):=\{0\subset W\subset V\}" display="block" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>∙</mo></msup><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>⊂</mo><mi>W</mi><mo>⊂</mo><mi>V</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">G^{\bullet}(V):=\{0\subset W\subset V\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p5.2" class="ltx_p">to be the <em id="S3.SS1.p5.2.1" class="ltx_emph ltx_font_italic">directrix flag</em> of <math id="S3.SS1.p5.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>. Furthermore, we let <math id="S3.SS1.p5.m4" class="ltx_Math" alttext="G^{\bullet}(V|_{0})" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G^{\bullet}(V|_{0})</annotation></semantics></math> and <math id="S3.SS1.p5.m5" class="ltx_Math" alttext="G^{\bullet}(V|_{\infty})" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G^{\bullet}(V|_{\infty})</annotation></semantics></math> denote the respective flags in <math id="S3.SS1.p5.m6" class="ltx_Math" alttext="V|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">V|_{0}</annotation></semantics></math> and <math id="S3.SS1.p5.m7" class="ltx_Math" alttext="V|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">V|_{\infty}</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmtheorem7" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem7.2" class="ltx_text ltx_font_bold">3.7</span></span><span id="S3.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem7.p1" class="ltx_para">
<p id="S3.Thmtheorem7.p1.1" class="ltx_p">Let <math id="S3.Thmtheorem7.p1.m1" class="ltx_math_unparsed" alttext="F^{\bullet}=\{0=F^{0}\subset F^{1}\subset\ldots\subset F^{N}=A\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>F</mi><mo>∙</mo></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>=</mo><msup><mi>F</mi><mn>0</mn></msup><mo>⊂</mo><msup><mi>F</mi><mn>1</mn></msup><mo>⊂</mo><mi mathvariant="normal">…</mi><mo>⊂</mo><msup><mi>F</mi><mi>N</mi></msup><mo>=</mo><mi>A</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">F^{\bullet}=\{0=F^{0}\subset F^{1}\subset\ldots\subset F^{N}=A\}</annotation></semantics></math> and <math id="S3.Thmtheorem7.p1.m2" class="ltx_math_unparsed" alttext="G^{\bullet}=\{0\subset B\subset A\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>∙</mo></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>⊂</mo><mi>B</mi><mo>⊂</mo><mi>A</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">G^{\bullet}=\{0\subset B\subset A\}</annotation></semantics></math> be two filtrations of a <math id="S3.Thmtheorem7.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-vector space <math id="S3.Thmtheorem7.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>. Then the <em id="S3.Thmtheorem7.p1.1.1" class="ltx_emph ltx_font_italic">modification of <math id="S3.Thmtheorem7.p1.m5" class="ltx_Math" alttext="F^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">F^{\bullet}</annotation></semantics></math> by <math id="S3.Thmtheorem7.p1.m6" class="ltx_Math" alttext="G^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">G^{\bullet}</annotation></semantics></math></em>, denoted <math id="S3.Thmtheorem7.p1.m7" class="ltx_Math" alttext="F\vee G" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∨</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">F\vee G</annotation></semantics></math>, is the flag with elements <math id="S3.Thmtheorem7.p1.m8" class="ltx_Math" alttext="(F\vee G)^{i}=F^{i}\cap B" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>∨</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msup><mo>=</mo><mrow><msup><mi>F</mi><mi>i</mi></msup><mo>∩</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">(F\vee G)^{i}=F^{i}\cap B</annotation></semantics></math> for <math id="S3.Thmtheorem7.p1.m9" class="ltx_Math" alttext="i\leq N" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">i\leq N</annotation></semantics></math>, and <math id="S3.Thmtheorem7.p1.m10" class="ltx_Math" alttext="(F\vee G)^{j}=B+F^{j-N}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>∨</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow><mi>j</mi></msup><mo>=</mo><mrow><mi>B</mi><mo>+</mo><msup><mi>F</mi><mrow><mi>j</mi><mo>−</mo><mi>N</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">(F\vee G)^{j}=B+F^{j-N}</annotation></semantics></math> for <math id="S3.Thmtheorem7.p1.m11" class="ltx_Math" alttext="j\geq N" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">j\geq N</annotation></semantics></math>.</p>
</div>
</div>
<section id="S3.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.1.1. </span>The two natural filtrations at a node.</h4>

<div id="S3.SS1.SSS1.p1" class="ltx_para">
<p id="S3.SS1.SSS1.p1.1" class="ltx_p">Now let <math id="S3.SS1.SSS1.p1.m1" class="ltx_Math" alttext="{\bf P}:=P_{1}\cup P_{2}\cup\ldots\cup P_{k}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>:=</mo><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>P</mi><mn>2</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>P</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\bf P}:=P_{1}\cup P_{2}\cup\ldots\cup P_{k}</annotation></semantics></math> be a chain of <math id="S3.SS1.SSS1.p1.m2" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>’s. Recall that we let <math id="S3.SS1.SSS1.p1.m3" class="ltx_Math" alttext="0_{i}" display="inline" intent=":literal"><semantics><msub><mn>0</mn><mi>i</mi></msub><annotation encoding="application/x-tex">0_{i}</annotation></semantics></math> and <math id="S3.SS1.SSS1.p1.m4" class="ltx_Math" alttext="\infty_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">∞</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\infty_{i}</annotation></semantics></math> denote marked points <math id="S3.SS1.SSS1.p1.m5" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S3.SS1.SSS1.p1.m6" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math> on the respective <math id="S3.SS1.SSS1.p1.m7" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math>, and <math id="S3.SS1.SSS1.p1.m8" class="ltx_Math" alttext="p_{j}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>j</mi></msub><annotation encoding="application/x-tex">p_{j}</annotation></semantics></math> be the node joining <math id="S3.SS1.SSS1.p1.m9" class="ltx_Math" alttext="P_{j}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>j</mi></msub><annotation encoding="application/x-tex">P_{j}</annotation></semantics></math> with <math id="S3.SS1.SSS1.p1.m10" class="ltx_Math" alttext="P_{j+1}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">P_{j+1}</annotation></semantics></math>, so that <math id="S3.SS1.SSS1.p1.m11" class="ltx_Math" alttext="p_{j}=\infty_{j}=0_{j+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>j</mi></msub><mo>=</mo><msub><mi mathvariant="normal">∞</mi><mi>j</mi></msub><mo>=</mo><msub><mn>0</mn><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">p_{j}=\infty_{j}=0_{j+1}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS1.SSS1.p2" class="ltx_para">
<p id="S3.SS1.SSS1.p2.1" class="ltx_p">Let <math id="S3.SS1.SSS1.p2.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a rank <math id="S3.SS1.SSS1.p2.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> vector bundle on <math id="S3.SS1.SSS1.p2.m3" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math>. We continue to assume that each <math id="S3.SS1.SSS1.p2.m4" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> is balanced, and let <math id="S3.SS1.SSS1.p2.m5" class="ltx_Math" alttext="W_{i}\subset V_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>i</mi></msub><mo>⊂</mo><msub><mi>V</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">W_{i}\subset V_{i}</annotation></semantics></math> be the <math id="S3.SS1.SSS1.p2.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th directrix subbundle.</p>
</div>
<div id="S3.SS1.SSS1.p3" class="ltx_para">
<p id="S3.SS1.SSS1.p3.1" class="ltx_p">At each node <math id="S3.SS1.SSS1.p3.m1" class="ltx_Math" alttext="p_{j}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>j</mi></msub><annotation encoding="application/x-tex">p_{j}</annotation></semantics></math> there are two natural filtrations of <math id="S3.SS1.SSS1.p3.m2" class="ltx_Math" alttext="V|_{p_{j}}" display="inline" intent=":literal"><semantics><msub><mrow><mi>V</mi><mo stretchy="false">|</mo></mrow><msub><mi>p</mi><mi>j</mi></msub></msub><annotation encoding="application/x-tex">V|_{p_{j}}</annotation></semantics></math>, called the <em id="S3.SS1.SSS1.p3.1.1" class="ltx_emph ltx_font_italic">left filtration</em> <math id="S3.SS1.SSS1.p3.m3" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> and the <em id="S3.SS1.SSS1.p3.1.2" class="ltx_emph ltx_font_italic">right filtration</em> <math id="S3.SS1.SSS1.p3.m4" class="ltx_Math" alttext="R^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">R^{\bullet}_{j}</annotation></semantics></math>, which we describe inductively. Let <math id="S3.SS1.SSS1.p3.m5" class="ltx_Math" alttext="L^{\bullet}_{1}=G^{\bullet}(V_{1}|_{0})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mn>1</mn><mo>∙</mo></msubsup><mo>=</mo><mrow><msup><mi>G</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi>V</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L^{\bullet}_{1}=G^{\bullet}(V_{1}|_{0})</annotation></semantics></math>,
and inductively define <math id="S3.SS1.SSS1.p3.m6" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> as the filtration given by</p>
<table id="S3.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex25.m1" class="ltx_Math" alttext="L^{\bullet}_{j}:=r\left(L^{\bullet}_{j-1}\wedge G^{\bullet}(V_{j}|_{0})\right)\text{.}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><mo>:=</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>L</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><mo>∧</mo><mrow><msup><mi>G</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi>V</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>.</mtext></mrow></mrow><annotation encoding="application/x-tex">L^{\bullet}_{j}:=r\left(L^{\bullet}_{j-1}\wedge G^{\bullet}(V_{j}|_{0})\right)\text{.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.p3.2" class="ltx_p">In words, we sequentially right transport and modify the directrix flags of the vector bundles <math id="S3.SS1.SSS1.p3.m7" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math>, beginning at <math id="S3.SS1.SSS1.p3.m8" class="ltx_Math" alttext="V_{1}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>1</mn></msub><annotation encoding="application/x-tex">V_{1}</annotation></semantics></math> and ending at <math id="S3.SS1.SSS1.p3.m9" class="ltx_Math" alttext="V_{j}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>j</mi></msub><annotation encoding="application/x-tex">V_{j}</annotation></semantics></math>. The filtration <math id="S3.SS1.SSS1.p3.m10" class="ltx_Math" alttext="R^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">R^{\bullet}_{j}</annotation></semantics></math> is defined similarly, except we begin at <math id="S3.SS1.SSS1.p3.m11" class="ltx_Math" alttext="V_{k}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>k</mi></msub><annotation encoding="application/x-tex">V_{k}</annotation></semantics></math> and then sequentially left transport and modify the directrix subbundles until we reach <math id="S3.SS1.SSS1.p3.m12" class="ltx_Math" alttext="V_{j+1}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">V_{j+1}</annotation></semantics></math>:</p>
<table id="S3.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex26.m1" class="ltx_Math" alttext="R^{\bullet}_{j}=l\left(R^{\bullet}_{j+1}\wedge G^{\bullet}(V_{j+1}|_{\infty})\right)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><mo>=</mo><mrow><mi>l</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><mo>∧</mo><mrow><msup><mi>G</mi><mo>∙</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi>V</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{\bullet}_{j}=l\left(R^{\bullet}_{j+1}\wedge G^{\bullet}(V_{j+1}|_{\infty})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS1.SSS1.p4" class="ltx_para">
<p id="S3.SS1.SSS1.p4.1" class="ltx_p">The essential point is that the collection of filtrations <math id="S3.SS1.SSS1.p4.m1" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> and <math id="S3.SS1.SSS1.p4.m2" class="ltx_Math" alttext="R^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">R^{\bullet}_{j}</annotation></semantics></math> completely captures the “relative position” of the system of directrices <math id="S3.SS1.SSS1.p4.m3" class="ltx_Math" alttext="W_{i}\subset V_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>i</mi></msub><mo>⊂</mo><msub><mi>V</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">W_{i}\subset V_{i}</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmtheorem8" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem8.2" class="ltx_text ltx_font_bold">3.8</span></span><span id="S3.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem8.p1" class="ltx_para">
<p id="S3.Thmtheorem8.p1.1" class="ltx_p">We say that a vector bundle <math id="S3.Thmtheorem8.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> on <math id="S3.Thmtheorem8.p1.m2" class="ltx_Math" alttext="{\bf P}=P_{1}\cup\ldots\cup P_{k}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>=</mo><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>P</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\bf P}=P_{1}\cup\ldots\cup P_{k}</annotation></semantics></math> as above <em id="S3.Thmtheorem8.p1.1.1" class="ltx_emph ltx_font_italic">has transverse directrices</em> if the filtrations <math id="S3.Thmtheorem8.p1.m3" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> and <math id="S3.Thmtheorem8.p1.m4" class="ltx_Math" alttext="R^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">R^{\bullet}_{j}</annotation></semantics></math> meet transversely for each node <math id="S3.Thmtheorem8.p1.m5" class="ltx_Math" alttext="p_{j}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>j</mi></msub><annotation encoding="application/x-tex">p_{j}</annotation></semantics></math>.</p>
</div>
</div>
<figure id="S3.F2" class="ltx_figure"><span id="S3.F2.pic1" class="ltx_picture ltx_centering" style="width:296.31pt;height:361.35366590819996pt;"></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2. </span>Some bundles whose directrices fail to meet transversely.
In the first diagram, the codimension 2 directrix <math id="S3.F2.m1" class="ltx_Math" alttext="{\bf P}W_{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\bf P}W_{2}</annotation></semantics></math> of <math id="S3.F2.m2" class="ltx_Math" alttext="{\bf P}V_{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\bf P}V_{2}</annotation></semantics></math> meets the codimension 1 directrix <math id="S3.F2.m3" class="ltx_Math" alttext="{\bf P}W_{1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">{\bf P}W_{1}</annotation></semantics></math> of <math id="S3.F2.m4" class="ltx_Math" alttext="{\bf P}V_{1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">{\bf P}V_{1}</annotation></semantics></math>
over the node <math id="S3.F2.m5" class="ltx_Math" alttext="P_{1}\cap P_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>∩</mo><msub><mi>P</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">P_{1}\cap P_{2}</annotation></semantics></math>, even though <math id="S3.F2.m6" class="ltx_Math" alttext="{\bf P}V" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">{\bf P}V</annotation></semantics></math> is a <math id="S3.F2.m7" class="ltx_Math" alttext="{\bf P}^{2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\bf P}^{2}</annotation></semantics></math>-bundle.
In the second diagram, although adjacent directrices meet transversely, if we transport the flag above node
<math id="S3.F2.m8" class="ltx_Math" alttext="P_{1}\cap P_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>∩</mo><msub><mi>P</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">P_{1}\cap P_{2}</annotation></semantics></math> to node <math id="S3.F2.m9" class="ltx_Math" alttext="P_{2}\cap P_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>2</mn></msub><mo>∩</mo><msub><mi>P</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">P_{2}\cap P_{3}</annotation></semantics></math> via the minimal subbundle <math id="S3.F2.m10" class="ltx_Math" alttext="{\bf P}T" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">{\bf P}T</annotation></semantics></math>, we get non-transverse intersection with
<math id="S3.F2.m11" class="ltx_Math" alttext="{\bf P}W_{3}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">{\bf P}W_{3}</annotation></semantics></math>.
</figcaption>
</figure>
<div id="S3.SS1.SSS1.p5" class="ltx_para">
<p id="S3.SS1.SSS1.p5.1" class="ltx_p">See <a href="#S3.F2" title="In 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">fig.</span> <span class="ltx_text ltx_ref_tag">2</span></a> for examples of bundles whose directrices fail to meet transversely. We can now state the theorem which characterizes balanced vector bundles on chains of <math id="S3.SS1.SSS1.p5.m1" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>’s.</p>
</div>
<div id="S3.Thmtheorem9" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem9.2" class="ltx_text ltx_font_bold">3.9</span></span><span id="S3.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem9.p1" class="ltx_para">
<p id="S3.Thmtheorem9.p1.1" class="ltx_p"><span id="S3.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem9.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a vector bundle on <math id="S3.Thmtheorem9.p1.m2" class="ltx_Math" alttext="{\bf P}=P_{1}\cup\ldots\cup P_{k}" display="inline" intent=":literal"><semantics><mrow><mi>𝐏</mi><mo>=</mo><mrow><msub><mi>P</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>P</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\bf P}=P_{1}\cup\ldots\cup P_{k}</annotation></semantics></math>. Then <math id="S3.Thmtheorem9.p1.m3" class="ltx_Math" alttext="h^{1}(\End V)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{1}(\End V)=0</annotation></semantics></math> if and only if</span></p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p"><span id="S3.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">Each </span><math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math><span id="S3.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> is balanced, for </span><math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="i=1,\ldots,k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,k</annotation></semantics></math><span id="S3.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">, and</span></p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p"><math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math><span id="S3.I1.i2.p1.1.1" class="ltx_text ltx_font_italic"> has transverse directrices.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS1.SSS1.p6" class="ltx_para">
<p id="S3.SS1.SSS1.p6.1" class="ltx_p">The remainder of this section will be spent proving <a href="#S3.Thmtheorem9" title="3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">3.9</span></a>.</p>
</div>
<div id="S3.SS1.SSS1.p7" class="ltx_para">
<p id="S3.SS1.SSS1.p7.1" class="ltx_p"><a href="#S3.Thmtheorem2" title="3.2. ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.2</span></a> already states that if <math id="S3.SS1.SSS1.p7.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is balanced,
then each <math id="S3.SS1.SSS1.p7.m2" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> is balanced as well. The following proposition shows that <math id="S3.SS1.SSS1.p7.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> also has to have
transverse directrices.</p>
</div>
<div id="S3.Thmtheorem10" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem10.2" class="ltx_text ltx_font_bold">3.10</span></span><span id="S3.Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem10.p1" class="ltx_para">
<p id="S3.Thmtheorem10.p1.1" class="ltx_p"><span id="S3.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem10.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a vector bundle on <math id="S3.Thmtheorem10.p1.m2" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math> such that <math id="S3.Thmtheorem10.p1.m3" class="ltx_Math" alttext="V_{i}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>i</mi></msub><annotation encoding="application/x-tex">V_{i}</annotation></semantics></math> are balanced for all <math id="S3.Thmtheorem10.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. Furthermore, suppose there is a node <math id="S3.Thmtheorem10.p1.m5" class="ltx_Math" alttext="p_{j}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>j</mi></msub><annotation encoding="application/x-tex">p_{j}</annotation></semantics></math> where <math id="S3.Thmtheorem10.p1.m6" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> and <math id="S3.Thmtheorem10.p1.m7" class="ltx_Math" alttext="R^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">R^{\bullet}_{j}</annotation></semantics></math> fail to intersect transversely. Then <math id="S3.Thmtheorem10.p1.m8" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is not balanced, i.e. <math id="S3.Thmtheorem10.p1.m9" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> admits a non trivial first order deformation.</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S3.Thmtheorem10" title="3.10. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">3.10</span></a>.</h6>
<div id="S3.SS1.SSS1.p8" class="ltx_para">
<p id="S3.SS1.SSS1.p8.1" class="ltx_p"><span id="S3.SS1.SSS1.p8.1.1" class="ltx_text">We can produce non-trivial deformations of <math id="S3.SS1.SSS1.p8.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> by modifying the gluing over <math id="S3.SS1.SSS1.p8.m2" class="ltx_Math" alttext="p_{j}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>j</mi></msub><annotation encoding="application/x-tex">p_{j}</annotation></semantics></math>, in a way that the filtrations
<math id="S3.SS1.SSS1.p8.m3" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> and <math id="S3.SS1.SSS1.p8.m4" class="ltx_Math" alttext="R^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">R^{\bullet}_{j}</annotation></semantics></math> become transverse. While it is clear that there will be non-trivial deformations over a DVR, we need to check that the restriction to <math id="S3.SS1.SSS1.p8.m5" class="ltx_Math" alttext="{\bf D}=\spec k[\varepsilon]/(\varepsilon^{2})" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>=</mo><mrow><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf D}=\spec k[\varepsilon]/(\varepsilon^{2})</annotation></semantics></math> is still
non-trivial.</span></p>
</div>
<div id="S3.SS1.SSS1.p9" class="ltx_para">
<p id="S3.SS1.SSS1.p9.1" class="ltx_p"><span id="S3.SS1.SSS1.p9.1.1" class="ltx_text">We get our hands on the first order deformations from
the boundary map</span></p>
<table id="S3.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex27.m1" class="ltx_math_unparsed" alttext="\delta\colon\oplus_{i}H^{0}(\End k(p_{i})^{r})\to H^{1}(\End V)." display="block" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.278em" rspace="0em">:</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><mi>End</mi><mi>k</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msup><mi>H</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><mi>End</mi><mi>V</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\delta\colon\oplus_{i}H^{0}(\End k(p_{i})^{r})\to H^{1}(\End V).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.p9.2" class="ltx_p"><span id="S3.SS1.SSS1.p9.2.1" class="ltx_text">Given <math id="S3.SS1.SSS1.p9.m1" class="ltx_math_unparsed" alttext="M=(M_{1},\ldots,M_{k-1})\in\oplus_{i}H^{0}(\End k(p_{i})^{r})" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>M</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">∈</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><mi>End</mi><mi>k</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M=(M_{1},\ldots,M_{k-1})\in\oplus_{i}H^{0}(\End k(p_{i})^{r})</annotation></semantics></math>, we construct the corresponding first order deformation <math id="S3.SS1.SSS1.p9.m2" class="ltx_Math" alttext="\delta(M)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta(M)</annotation></semantics></math> of <math id="S3.SS1.SSS1.p9.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> as follows. Take
the (trivially deformed) bundle <math id="S3.SS1.SSS1.p9.m4" class="ltx_Math" alttext="V_{i}\times{\bf D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐃</mi></mrow><annotation encoding="application/x-tex">V_{i}\times{\bf D}</annotation></semantics></math> on each component <math id="S3.SS1.SSS1.p9.m5" class="ltx_Math" alttext="P_{i}\times{\bf D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐃</mi></mrow><annotation encoding="application/x-tex">P_{i}\times{\bf D}</annotation></semantics></math>, and glue these vector bundles using the map</span></p>
<table id="S3.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex28.m1" class="ltx_Math" alttext="f_{i}+\varepsilon M_{i}\colon\left(V_{i}|_{\infty}\times{\bf D}\right)\to\left(V_{i+1}|_{0}\times{\bf D}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo>(</mo><mrow><msub><mrow><msub><mi>V</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.222em">×</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mo stretchy="false">→</mo><mrow><mo>(</mo><mrow><msub><mrow><msub><mi>V</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0.055em" stretchy="false">|</mo></mrow><mn>0</mn></msub><mo rspace="0.222em">×</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{i}+\varepsilon M_{i}\colon\left(V_{i}|_{\infty}\times{\bf D}\right)\to\left(V_{i+1}|_{0}\times{\bf D}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.p9.3" class="ltx_p"><span id="S3.SS1.SSS1.p9.3.1" class="ltx_text">where <math id="S3.SS1.SSS1.p9.m6" class="ltx_Math" alttext="f_{i}\colon V_{i}|_{\infty}\to V_{i+1}|_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><msub><mrow><msub><mi>V</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f_{i}\colon V_{i}|_{\infty}\to V_{i+1}|_{0}</annotation></semantics></math> are the original gluing maps for the vector bundle <math id="S3.SS1.SSS1.p9.m7" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> on <math id="S3.SS1.SSS1.p9.m8" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.SSS1.p10" class="ltx_para">
<p id="S3.SS1.SSS1.p10.1" class="ltx_p"><span id="S3.SS1.SSS1.p10.1.1" class="ltx_text">We claim that a generic choice of <math id="S3.SS1.SSS1.p10.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> makes the deformation obtained by the gluings above nontrivial. As a matter of fact, we can even take
<math id="S3.SS1.SSS1.p10.m2" class="ltx_Math" alttext="M_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{i}=0</annotation></semantics></math> for <math id="S3.SS1.SSS1.p10.m3" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, as long as <math id="S3.SS1.SSS1.p10.m4" class="ltx_Math" alttext="M_{j}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>j</mi></msub><annotation encoding="application/x-tex">M_{j}</annotation></semantics></math> <em id="S3.SS1.SSS1.p10.1.1.1" class="ltx_emph ltx_font_italic">separates</em> the flags <math id="S3.SS1.SSS1.p10.m5" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> and <math id="S3.SS1.SSS1.p10.m6" class="ltx_Math" alttext="R^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">R^{\bullet}_{j}</annotation></semantics></math> in
the following sense.</span></p>
</div>
<div id="S3.Thmtheorem11" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem11.2" class="ltx_text ltx_font_bold">3.11</span></span><span id="S3.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem11.p1" class="ltx_para">
<p id="S3.Thmtheorem11.p1.1" class="ltx_p">Let <math id="S3.Thmtheorem11.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be an <math id="S3.Thmtheorem11.p1.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>-dimensional <math id="S3.Thmtheorem11.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-vector space, and let <math id="S3.Thmtheorem11.p1.m4" class="ltx_Math" alttext="V[\varepsilon]" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">V[\varepsilon]</annotation></semantics></math> be the module <math id="S3.Thmtheorem11.p1.m5" class="ltx_Math" alttext="V\otimes_{k}k[\varepsilon]/(\varepsilon^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>k</mi></msub><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V\otimes_{k}k[\varepsilon]/(\varepsilon^{2})</annotation></semantics></math>. Suppose <math id="S3.Thmtheorem11.p1.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="S3.Thmtheorem11.p1.m7" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> are subspaces of <math id="S3.Thmtheorem11.p1.m8" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> which fail to meet properly. Let <math id="S3.Thmtheorem11.p1.m9" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be an endomorphism of <math id="S3.Thmtheorem11.p1.m10" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> and consider the invertible module map</p>
<table id="S3.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex29.m1" class="ltx_Math" alttext="f_{M}:=Id+\varepsilon M\colon V[\varepsilon]\to V[\varepsilon]." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>M</mi></msub><mo>:=</mo><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{M}:=Id+\varepsilon M\colon V[\varepsilon]\to V[\varepsilon].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.Thmtheorem11.p2" class="ltx_para">
<p id="S3.Thmtheorem11.p2.1" class="ltx_p">We say that <math id="S3.Thmtheorem11.p2.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> <em id="S3.Thmtheorem11.p2.1.1" class="ltx_emph ltx_font_italic">separates</em> <math id="S3.Thmtheorem11.p2.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="S3.Thmtheorem11.p2.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> if the submodule <math id="S3.Thmtheorem11.p2.m4" class="ltx_Math" alttext="A[\varepsilon]\cap f_{M}(B[\varepsilon])" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo>∩</mo><mrow><msub><mi>f</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A[\varepsilon]\cap f_{M}(B[\varepsilon])</annotation></semantics></math> is not flat as a <math id="S3.Thmtheorem11.p2.m5" class="ltx_Math" alttext="k[\varepsilon]/(\varepsilon^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">k[\varepsilon]/(\varepsilon^{2})</annotation></semantics></math>-module.</p>
</div>
</div>
<div id="S3.SS1.SSS1.p11" class="ltx_para">
<p id="S3.SS1.SSS1.p11.1" class="ltx_p"><span id="S3.SS1.SSS1.p11.1.1" class="ltx_text">Note that if <math id="S3.SS1.SSS1.p11.m1" class="ltx_Math" alttext="M_{j}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>j</mi></msub><annotation encoding="application/x-tex">M_{j}</annotation></semantics></math> separates the flags <math id="S3.SS1.SSS1.p11.m2" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> and <math id="S3.SS1.SSS1.p11.m3" class="ltx_Math" alttext="R^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">R^{\bullet}_{j}</annotation></semantics></math>, then the deformation is not trivial.
We just have to show that a generic choice of <math id="S3.SS1.SSS1.p11.m4" class="ltx_Math" alttext="M_{j}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>j</mi></msub><annotation encoding="application/x-tex">M_{j}</annotation></semantics></math> does separate these flags. The following lemma assures that this is the case.</span></p>
</div>
<div id="S3.Thmtheorem12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem12.2" class="ltx_text ltx_font_bold">3.12</span></span><span id="S3.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem12.p1" class="ltx_para">
<p id="S3.Thmtheorem12.p1.1" class="ltx_p"><span id="S3.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem12.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, <math id="S3.Thmtheorem12.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, and <math id="S3.Thmtheorem12.p1.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> be as in <a href="#S3.Thmtheorem11" title="3.11. ‣ Proof of . ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">definition</span> <span class="ltx_text ltx_ref_tag">3.11</span></a>. Then there exists <math id="S3.Thmtheorem12.p1.m4" class="ltx_Math" alttext="M\in\End V" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">M\in\End V</annotation></semantics></math> which separates <math id="S3.Thmtheorem12.p1.m5" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="S3.Thmtheorem12.p1.m6" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>. Furthermore, the general choice of <math id="S3.Thmtheorem12.p1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> separates <math id="S3.Thmtheorem12.p1.m8" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="S3.Thmtheorem12.p1.m9" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S3.Thmtheorem12" title="3.12. ‣ Proof of . ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">3.12</span></a>.</h6>
<div id="S3.SS1.SSS1.p12" class="ltx_para">
<p id="S3.SS1.SSS1.p12.1" class="ltx_p"><span id="S3.SS1.SSS1.p12.1.1" class="ltx_text">Note that flat and free are the same notion for the local Artinian ring <math id="S3.SS1.SSS1.p12.m1" class="ltx_Math" alttext="k[\varepsilon]/(\varepsilon^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">k[\varepsilon]/(\varepsilon^{2})</annotation></semantics></math>. Furthermore, a <math id="S3.SS1.SSS1.p12.m2" class="ltx_Math" alttext="k[\varepsilon]/(\varepsilon^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">k[\varepsilon]/(\varepsilon^{2})</annotation></semantics></math>-module <math id="S3.SS1.SSS1.p12.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is flat if and only if the multiplication map
<math id="S3.SS1.SSS1.p12.m4" class="ltx_Math" alttext="\times\varepsilon\colon\left(N/\varepsilon N\right)\to N" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mi>ε</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo>(</mo><mrow><mrow><mi>N</mi><mo>/</mo><mi>ε</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>)</mo></mrow><mo stretchy="false">→</mo><mi>N</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\times\varepsilon\colon\left(N/\varepsilon N\right)\to N</annotation></semantics></math> is injective.</span></p>
</div>
<div id="S3.SS1.SSS1.p13" class="ltx_para">
<p id="S3.SS1.SSS1.p13.1" class="ltx_p"><span id="S3.SS1.SSS1.p13.1.1" class="ltx_text">We now choose a basis <math id="S3.SS1.SSS1.p13.m1" class="ltx_Math" alttext="\{v_{1},\ldots,v_{r}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>r</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{v_{1},\ldots,v_{r}\}</annotation></semantics></math> for <math id="S3.SS1.SSS1.p13.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> such that <math id="S3.SS1.SSS1.p13.m3" class="ltx_Math" alttext="A=\langle v_{1},\ldots,v_{a}\rangle" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>a</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">A=\langle v_{1},\ldots,v_{a}\rangle</annotation></semantics></math> and <math id="S3.SS1.SSS1.p13.m4" class="ltx_Math" alttext="B=\langle v_{m+1},\ldots,v_{m+b}\rangle" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>v</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mrow><mi>m</mi><mo>+</mo><mi>b</mi></mrow></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">B=\langle v_{m+1},\ldots,v_{m+b}\rangle</annotation></semantics></math>, and assume that <math id="S3.SS1.SSS1.p13.m5" class="ltx_Math" alttext="m+b&lt;r" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>+</mo><mi>b</mi></mrow><mo>&lt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">m+b&lt;r</annotation></semantics></math> and <math id="S3.SS1.SSS1.p13.m6" class="ltx_Math" alttext="m+1\leq a" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">m+1\leq a</annotation></semantics></math>, so that <math id="S3.SS1.SSS1.p13.m7" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="S3.SS1.SSS1.p13.m8" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> do not meet properly. Now consider the endomorphism <math id="S3.SS1.SSS1.p13.m9" class="ltx_Math" alttext="M\in\End V" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">M\in\End V</annotation></semantics></math> which is <math id="S3.SS1.SSS1.p13.m10" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> on all <math id="S3.SS1.SSS1.p13.m11" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> except sends <math id="S3.SS1.SSS1.p13.m12" class="ltx_Math" alttext="v_{m+1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{m+1}</annotation></semantics></math> to <math id="S3.SS1.SSS1.p13.m13" class="ltx_Math" alttext="v_{r}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>r</mi></msub><annotation encoding="application/x-tex">v_{r}</annotation></semantics></math>. Then <math id="S3.SS1.SSS1.p13.m14" class="ltx_Math" alttext="f_{M}(B[\varepsilon])=\langle v_{m+1}+\varepsilon v_{r},v_{m+2},\ldots,v_{m+b}\rangle\subset V[\varepsilon]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>v</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>r</mi></msub></mrow></mrow><mo>,</mo><msub><mi>v</mi><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mrow><mi>m</mi><mo>+</mo><mi>b</mi></mrow></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>⊂</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{M}(B[\varepsilon])=\langle v_{m+1}+\varepsilon v_{r},v_{m+2},\ldots,v_{m+b}\rangle\subset V[\varepsilon]</annotation></semantics></math>. The element <math id="S3.SS1.SSS1.p13.m15" class="ltx_Math" alttext="\varepsilon v_{m+1}" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\varepsilon v_{m+1}</annotation></semantics></math> is annihilated by <math id="S3.SS1.SSS1.p13.m16" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>, but is non-zero in the quotient module <math id="S3.SS1.SSS1.p13.m17" class="ltx_Math" alttext="A[\varepsilon]\cap f_{M}(B[\varepsilon])/\varepsilon(A[\varepsilon]\cap f_{M}(B[\varepsilon]))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo>∩</mo><mrow><mrow><msub><mi>f</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>ε</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo>∩</mo><mrow><msub><mi>f</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">A[\varepsilon]\cap f_{M}(B[\varepsilon])/\varepsilon(A[\varepsilon]\cap f_{M}(B[\varepsilon]))</annotation></semantics></math>. Hence, <math id="S3.SS1.SSS1.p13.m18" class="ltx_Math" alttext="A[\varepsilon]\cap f_{M}(B[\varepsilon])" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo>∩</mo><mrow><msub><mi>f</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A[\varepsilon]\cap f_{M}(B[\varepsilon])</annotation></semantics></math> is not flat.
∎</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.p14" class="ltx_para">
<p id="S3.SS1.SSS1.p14.1" class="ltx_p"><a href="#S3.Thmtheorem12" title="3.12. ‣ Proof of . ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.12</span></a><span id="S3.SS1.SSS1.p14.1.1" class="ltx_text"> now implies <a href="#S3.Thmtheorem10" title="3.10. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">3.10</span></a>.
∎</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.p15" class="ltx_para">
<p id="S3.SS1.SSS1.p15.1" class="ltx_p"><a href="#S3.Thmtheorem10" title="3.10. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3.10</span></a> tells us conditions (<a href="#S3.I1.i1" title="Item 1 ‣ 3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) and (<a href="#S3.I1.i2" title="Item 2 ‣ 3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) are necessary in <a href="#S3.Thmtheorem9" title="3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">3.9</span></a>. Now we must prove sufficiency.
Specifically, we must show that if <math id="S3.SS1.SSS1.p15.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> has transverse directrices, then the difference map</p>
<table id="S3.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex30.m1" class="ltx_math_unparsed" alttext="D\colon\oplus_{i}H^{0}(P_{i},\End V_{i})\to\oplus_{i}\End(k(p_{i})^{r})" display="block" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0.278em" rspace="0em">:</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mi>End</mi><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em" stretchy="false">→</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><mi>End</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D\colon\oplus_{i}H^{0}(P_{i},\End V_{i})\to\oplus_{i}\End(k(p_{i})^{r})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.p15.2" class="ltx_p">is surjective. For <math id="S3.SS1.SSS1.p15.m2" class="ltx_math_unparsed" alttext="M\in\oplus_{i}H^{0}(P_{i},\End V_{i})" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo rspace="0em">∈</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mi>End</mi><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M\in\oplus_{i}H^{0}(P_{i},\End V_{i})</annotation></semantics></math>, denote by <math id="S3.SS1.SSS1.p15.m3" class="ltx_Math" alttext="D_{i}(M)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{i}(M)</annotation></semantics></math> the <math id="S3.SS1.SSS1.p15.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th component of <math id="S3.SS1.SSS1.p15.m5" class="ltx_math_unparsed" alttext="D(M)\in\oplus_{i}\End(k(p_{i})^{r})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">∈</mo><msub><mo lspace="0em">⊕</mo><mi>i</mi></msub><mi>End</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(M)\in\oplus_{i}\End(k(p_{i})^{r})</annotation></semantics></math>.
It is enough to show that for each <math id="S3.SS1.SSS1.p15.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, we can choose <math id="S3.SS1.SSS1.p15.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> such that <math id="S3.SS1.SSS1.p15.m8" class="ltx_Math" alttext="D_{i}(M)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D_{i}(M)=0</annotation></semantics></math> for all
<math id="S3.SS1.SSS1.p15.m9" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, while <math id="S3.SS1.SSS1.p15.m10" class="ltx_Math" alttext="D_{j}(M)\in\End(k(p_{j})^{r})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{j}(M)\in\End(k(p_{j})^{r})</annotation></semantics></math> is arbitrary.</p>
</div>
<div id="S3.SS1.SSS1.p16" class="ltx_para">
<p id="S3.SS1.SSS1.p16.1" class="ltx_p">We will first choose <math id="S3.SS1.SSS1.p16.m1" class="ltx_Math" alttext="M_{i}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>i</mi></msub><annotation encoding="application/x-tex">M_{i}</annotation></semantics></math> for <math id="S3.SS1.SSS1.p16.m2" class="ltx_Math" alttext="i&lt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&lt;j</annotation></semantics></math> such that <math id="S3.SS1.SSS1.p16.m3" class="ltx_Math" alttext="D_{i}(M)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D_{i}(M)=0</annotation></semantics></math> for all <math id="S3.SS1.SSS1.p16.m4" class="ltx_Math" alttext="i&lt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&lt;j</annotation></semantics></math>, and see what constraints we have on
<math id="S3.SS1.SSS1.p16.m5" class="ltx_Math" alttext="M_{j-1}|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>M</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">M_{j-1}|_{\infty}</annotation></semantics></math>. We will then do the same from the other side, starting at <math id="S3.SS1.SSS1.p16.m6" class="ltx_Math" alttext="M_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">M_{k-1}</annotation></semantics></math> and going down to <math id="S3.SS1.SSS1.p16.m7" class="ltx_Math" alttext="M_{j}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>j</mi></msub><annotation encoding="application/x-tex">M_{j}</annotation></semantics></math>, and
then conclude that the difference <math id="S3.SS1.SSS1.p16.m8" class="ltx_Math" alttext="D_{j}(M)=M_{j-1}|_{\infty}-M_{j}|_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mrow><msub><mi>M</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>−</mo><msub><mrow><msub><mi>M</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">D_{j}(M)=M_{j-1}|_{\infty}-M_{j}|_{0}</annotation></semantics></math> can be made to be arbitrary.</p>
</div>
<div id="S3.SS1.SSS1.p17" class="ltx_para">
<p id="S3.SS1.SSS1.p17.1" class="ltx_p">To express the constraints on <math id="S3.SS1.SSS1.p17.m1" class="ltx_Math" alttext="M_{j-1}|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>M</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">M_{j-1}|_{\infty}</annotation></semantics></math>, let us introduce the following notation:</p>
</div>
<div id="S3.Thmtheorem13" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem13.2" class="ltx_text ltx_font_bold">3.13</span></span><span id="S3.Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem13.p1" class="ltx_para">
<p id="S3.Thmtheorem13.p1.1" class="ltx_p">We say that an endomorphism <math id="S3.Thmtheorem13.p1.m1" class="ltx_Math" alttext="M\in\End(V)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\in\End(V)</annotation></semantics></math> of a vector space <math id="S3.Thmtheorem13.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> <em id="S3.Thmtheorem13.p1.1.1" class="ltx_emph ltx_font_italic">respects the flag</em>
<math id="S3.Thmtheorem13.p1.m3" class="ltx_Math" alttext="0\subset F_{1}\subset F_{2}\subset\ldots\subset F_{r}\subset V" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>⊂</mo><msub><mi>F</mi><mn>1</mn></msub><mo>⊂</mo><msub><mi>F</mi><mn>2</mn></msub><mo>⊂</mo><mi mathvariant="normal">…</mi><mo>⊂</mo><msub><mi>F</mi><mi>r</mi></msub><mo>⊂</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">0\subset F_{1}\subset F_{2}\subset\ldots\subset F_{r}\subset V</annotation></semantics></math> if <math id="S3.Thmtheorem13.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> preserves the <math id="S3.Thmtheorem13.p1.m5" class="ltx_Math" alttext="F_{i}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>i</mi></msub><annotation encoding="application/x-tex">F_{i}</annotation></semantics></math> as subspaces of <math id="S3.Thmtheorem13.p1.m6" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS1.SSS1.p18" class="ltx_para">
<p id="S3.SS1.SSS1.p18.1" class="ltx_p">We now can state the following.</p>
</div>
<div id="S3.Thmtheorem14" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem14.2" class="ltx_text ltx_font_bold">3.14</span></span><span id="S3.Thmtheorem14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem14.p1" class="ltx_para">
<p id="S3.Thmtheorem14.p1.1" class="ltx_p"><span id="S3.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">We can choose <math id="S3.Thmtheorem14.p1.m1" class="ltx_Math" alttext="M_{i}\in H^{0}(P_{i},\End V_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><msub><mi>V</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{i}\in H^{0}(P_{i},\End V_{i})</annotation></semantics></math> for <math id="S3.Thmtheorem14.p1.m2" class="ltx_Math" alttext="i&lt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&lt;j</annotation></semantics></math> such that <math id="S3.Thmtheorem14.p1.m3" class="ltx_Math" alttext="D_{i}(M)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D_{i}(M)=0</annotation></semantics></math> for <math id="S3.Thmtheorem14.p1.m4" class="ltx_Math" alttext="i&lt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&lt;j</annotation></semantics></math>,
and <math id="S3.Thmtheorem14.p1.m5" class="ltx_Math" alttext="M_{j-1}|_{\infty}\in\End(k(p_{j})^{r})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msub><mi>M</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>∈</mo><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{j-1}|_{\infty}\in\End(k(p_{j})^{r})</annotation></semantics></math> is an arbitrary endomorphism that preserves the left flag
<math id="S3.Thmtheorem14.p1.m6" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.p19" class="ltx_para">
<p id="S3.SS1.SSS1.p19.1" class="ltx_p">Of course the analogous result is true if we started from the right: we can choose <math id="S3.SS1.SSS1.p19.m1" class="ltx_Math" alttext="M_{i}\in H^{0}(P_{i},\End V_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><msub><mi>V</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{i}\in H^{0}(P_{i},\End V_{i})</annotation></semantics></math> for <math id="S3.SS1.SSS1.p19.m2" class="ltx_Math" alttext="i\geq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≥</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\geq j</annotation></semantics></math> such that <math id="S3.SS1.SSS1.p19.m3" class="ltx_Math" alttext="D_{i}(M)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D_{i}(M)=0</annotation></semantics></math> for <math id="S3.SS1.SSS1.p19.m4" class="ltx_Math" alttext="i&gt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&gt;j</annotation></semantics></math> and <math id="S3.SS1.SSS1.p19.m5" class="ltx_Math" alttext="M_{j}|_{0}\in H^{0}(P_{i},\End V_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msub><mi>M</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>i</mi></msub><mo>,</mo><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><msub><mi>V</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{j}|_{0}\in H^{0}(P_{i},\End V_{i})</annotation></semantics></math> is an arbitrary
endomorphism preserving the <em id="S3.SS1.SSS1.p19.1.1" class="ltx_emph ltx_font_italic">right</em> flag <math id="S3.SS1.SSS1.p19.m6" class="ltx_Math" alttext="R^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">R^{\bullet}_{j}</annotation></semantics></math>. Now we only have to assure that we can arrange the difference <math id="S3.SS1.SSS1.p19.m7" class="ltx_Math" alttext="M_{j-1}|_{\infty}-M_{j}|_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msub><mi>M</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>−</mo><msub><mrow><msub><mi>M</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">M_{j-1}|_{\infty}-M_{j}|_{0}</annotation></semantics></math> to be arbitrary. The following lemma does that.</p>
</div>
<div id="S3.Thmtheorem15" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem15.2" class="ltx_text ltx_font_bold">3.15</span></span><span id="S3.Thmtheorem15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem15.p1" class="ltx_para">
<p id="S3.Thmtheorem15.p1.1" class="ltx_p"><span id="S3.Thmtheorem15.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S3.Thmtheorem15.p1.m1" class="ltx_Math" alttext="F^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">F^{\bullet}</annotation></semantics></math> and <math id="S3.Thmtheorem15.p1.m2" class="ltx_Math" alttext="G^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">G^{\bullet}</annotation></semantics></math> are transverse flags of a vector space <math id="S3.Thmtheorem15.p1.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, then any endomorphism of <math id="S3.Thmtheorem15.p1.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> can be written as a difference of an endomorphism respecting the flag <math id="S3.Thmtheorem15.p1.m5" class="ltx_Math" alttext="F^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">F^{\bullet}</annotation></semantics></math>, and one respecting <math id="S3.Thmtheorem15.p1.m6" class="ltx_Math" alttext="G^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">G^{\bullet}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S3.Thmtheorem15" title="3.15. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">3.15</span></a>.</h6>
<div id="S3.SS1.SSS1.p20" class="ltx_para">
<p id="S3.SS1.SSS1.p20.1" class="ltx_p"><span id="S3.SS1.SSS1.p20.1.1" class="ltx_text">Without loss of generality, we may assume that <math id="S3.SS1.SSS1.p20.m1" class="ltx_Math" alttext="F^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">F^{\bullet}</annotation></semantics></math> and <math id="S3.SS1.SSS1.p20.m2" class="ltx_Math" alttext="G^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">G^{\bullet}</annotation></semantics></math> are complete flags. Indeed, if they are not, just choose generic finer complete flags containing them, and the problem only becomes more restrictive.</span></p>
</div>
<div id="S3.SS1.SSS1.p21" class="ltx_para">
<p id="S3.SS1.SSS1.p21.1" class="ltx_p"><span id="S3.SS1.SSS1.p21.1.1" class="ltx_text">Now pick a basis <math id="S3.SS1.SSS1.p21.m1" class="ltx_Math" alttext="v_{1},\ldots,v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">v_{1},\ldots,v_{n}</annotation></semantics></math> of <math id="S3.SS1.SSS1.p21.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> such that <math id="S3.SS1.SSS1.p21.m3" class="ltx_Math" alttext="\langle v_{i}\rangle=F^{i}\cap G^{n-i-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mrow><msup><mi>F</mi><mi>i</mi></msup><mo>∩</mo><msup><mi>G</mi><mrow><mi>n</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\langle v_{i}\rangle=F^{i}\cap G^{n-i-1}</annotation></semantics></math>. In this basis,
endomorphisms preserving <math id="S3.SS1.SSS1.p21.m4" class="ltx_Math" alttext="F^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">F^{\bullet}</annotation></semantics></math> are upper triangular matrices, and the ones respecting <math id="S3.SS1.SSS1.p21.m5" class="ltx_Math" alttext="G^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">G^{\bullet}</annotation></semantics></math> are the lower
triangular ones. And any matrix can be written as a difference of two such matrices.
∎</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.p22" class="ltx_para">
<p id="S3.SS1.SSS1.p22.1" class="ltx_p">To complete the proof of <a href="#S3.Thmtheorem9" title="3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">3.9</span></a>, we only need to prove <a href="#S3.Thmtheorem14" title="3.14. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">3.14</span></a>.</p>
</div>
<div id="S3.SS1.SSS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S3.Thmtheorem14" title="3.14. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">3.14</span></a>.</h6>
<div id="S3.SS1.SSS1.p23" class="ltx_para">
<p id="S3.SS1.SSS1.p23.1" class="ltx_p"><span id="S3.SS1.SSS1.p23.1.1" class="ltx_text">We proceed by induction on the length of the chain <math id="S3.SS1.SSS1.p23.m1" class="ltx_Math" alttext="{\bf P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">{\bf P}</annotation></semantics></math>. If there is only one component, the claim states that for
any endomorphism <math id="S3.SS1.SSS1.p23.m2" class="ltx_Math" alttext="\overline{M}:V_{1}|_{\infty}\to V_{1}|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><msub><mi>V</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><msub><mrow><msub><mi>V</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\overline{M}:V_{1}|_{\infty}\to V_{1}|_{\infty}</annotation></semantics></math> which sends the restriction of the directrix <math id="S3.SS1.SSS1.p23.m3" class="ltx_Math" alttext="W|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">W|_{\infty}</annotation></semantics></math> to itself,
we can find <math id="S3.SS1.SSS1.p23.m4" class="ltx_Math" alttext="M\in H^{0}(\End(V_{1}))" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\in H^{0}(\End(V_{1}))</annotation></semantics></math> such that <math id="S3.SS1.SSS1.p23.m5" class="ltx_Math" alttext="M|_{\infty}=\overline{M}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>M</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">M|_{\infty}=\overline{M}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.SSS1.p24" class="ltx_para">
<p id="S3.SS1.SSS1.p24.1" class="ltx_p"><span id="S3.SS1.SSS1.p24.1.1" class="ltx_text">Fix a splitting <math id="S3.SS1.SSS1.p24.m1" class="ltx_Math" alttext="V_{1}={\mathcal{O}}(m)^{a}\oplus{\mathcal{O}}(m+1)^{b}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mi>a</mi></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>b</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{1}={\mathcal{O}}(m)^{a}\oplus{\mathcal{O}}(m+1)^{b}</annotation></semantics></math>. Then <math id="S3.SS1.SSS1.p24.m2" class="ltx_Math" alttext="\End(V_{1})={\mathcal{O}}^{a^{2}}\oplus{\mathcal{O}}(1)^{ab}\oplus{\mathcal{O}}(-1)^{ab}\oplus{\mathcal{O}}^{b^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>a</mi><mn>2</mn></msup></msup><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup></mrow><mo>⊕</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup></mrow><mo>⊕</mo><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>b</mi><mn>2</mn></msup></msup></mrow></mrow><annotation encoding="application/x-tex">\End(V_{1})={\mathcal{O}}^{a^{2}}\oplus{\mathcal{O}}(1)^{ab}\oplus{\mathcal{O}}(-1)^{ab}\oplus{\mathcal{O}}^{b^{2}}</annotation></semantics></math>, and we can realize this splitting more naturally by realizing an element of <math id="S3.SS1.SSS1.p24.m3" class="ltx_Math" alttext="\End V_{1}" display="inline" intent=":literal"><semantics><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><msub><mi>V</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\End V_{1}</annotation></semantics></math> as an <math id="S3.SS1.SSS1.p24.m4" class="ltx_Math" alttext="(a+b)\times(a+b)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a+b)\times(a+b)</annotation></semantics></math> matrix block matrix. For
example, for <math id="S3.SS1.SSS1.p24.m5" class="ltx_Math" alttext="a=2,b=3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>b</mi><mo>=</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">a=2,b=3</annotation></semantics></math>, we have</span></p>
<table id="S3.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex31.m1" class="ltx_Math" alttext="\End V_{1}=\left[\begin{array}[]{cc|ccc}{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}(1)&amp;{\mathcal{O}}(1)&amp;{\mathcal{O}}(1)\\
{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}(1)&amp;{\mathcal{O}}(1)&amp;{\mathcal{O}}(1)\\
\hline\cr{\mathcal{O}}(-1)&amp;{\mathcal{O}}(-1)&amp;{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}\\
{\mathcal{O}}(-1)&amp;{\mathcal{O}}(-1)&amp;{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}\\
{\mathcal{O}}(-1)&amp;{\mathcal{O}}(-1)&amp;{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}\end{array}\right]" display="block" intent=":literal"><semantics><mrow><mrow><mi>End</mi><mo lspace="0.167em">⁡</mo><msub><mi>V</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd></mtr><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd></mtr><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd></mtr><mtr><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd><mtd><mi class="ltx_font_mathcaligraphic">𝒪</mi></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\End V_{1}=\left[\begin{array}[]{cc|ccc}{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}(1)&amp;{\mathcal{O}}(1)&amp;{\mathcal{O}}(1)\\
{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}(1)&amp;{\mathcal{O}}(1)&amp;{\mathcal{O}}(1)\\
\hline\cr{\mathcal{O}}(-1)&amp;{\mathcal{O}}(-1)&amp;{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}\\
{\mathcal{O}}(-1)&amp;{\mathcal{O}}(-1)&amp;{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}\\
{\mathcal{O}}(-1)&amp;{\mathcal{O}}(-1)&amp;{\mathcal{O}}&amp;{\mathcal{O}}&amp;{\mathcal{O}}\end{array}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.p24.2" class="ltx_p"><span id="S3.SS1.SSS1.p24.2.1" class="ltx_text">The global sections of <math id="S3.SS1.SSS1.p24.m6" class="ltx_Math" alttext="\End(V_{1})" display="inline" intent=":literal"><semantics><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\End(V_{1})</annotation></semantics></math> restrict to an arbitrary block upper triangular matrix at <math id="S3.SS1.SSS1.p24.m7" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math>. And being
block upper triangular exactly means that the directrix is preserved. This proves the case for one component.</span></p>
</div>
<div id="S3.SS1.SSS1.p25" class="ltx_para">
<p id="S3.SS1.SSS1.p25.1" class="ltx_p"><span id="S3.SS1.SSS1.p25.1.1" class="ltx_text">For the induction step, we are given an endomorphism <math id="S3.SS1.SSS1.p25.m1" class="ltx_Math" alttext="\overline{M}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{M}</annotation></semantics></math> of <math id="S3.SS1.SSS1.p25.m2" class="ltx_Math" alttext="V_{j-1}|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>V</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">V_{j-1}|_{\infty}</annotation></semantics></math> preserving <math id="S3.SS1.SSS1.p25.m3" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math>,
and we want to find <math id="S3.SS1.SSS1.p25.m4" class="ltx_Math" alttext="M\in H^{0}(\End(V_{j-1})" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\in H^{0}(\End(V_{j-1})</annotation></semantics></math> such that</span></p>
<ul id="S3.I2" class="ltx_itemize">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<p id="S3.I2.i1.p1.1" class="ltx_p"><math id="S3.I2.i1.p1.m1" class="ltx_Math" alttext="M|_{\infty}=\overline{M}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>M</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">M|_{\infty}=\overline{M}</annotation></semantics></math>, and</p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<p id="S3.I2.i2.p1.1" class="ltx_p"><math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="M|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mi>M</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">M|_{0}</annotation></semantics></math> is an endomorphism of <math id="S3.I2.i2.p1.m2" class="ltx_Math" alttext="V_{j-1}|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>V</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">V_{j-1}|_{0}</annotation></semantics></math> respecting <math id="S3.I2.i2.p1.m3" class="ltx_Math" alttext="L^{\bullet}_{j-1}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j-1}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="S3.SS1.SSS1.p26" class="ltx_para">
<p id="S3.SS1.SSS1.p26.1" class="ltx_p"><span id="S3.SS1.SSS1.p26.1.1" class="ltx_text">This is enough for our purposes, because by induction we can choose global sections of <math id="S3.SS1.SSS1.p26.m1" class="ltx_Math" alttext="\End(V_{i})" display="inline" intent=":literal"><semantics><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\End(V_{i})</annotation></semantics></math> for <math id="S3.SS1.SSS1.p26.m2" class="ltx_Math" alttext="i&lt;j-1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i&lt;j-1</annotation></semantics></math> such that
all differences <math id="S3.SS1.SSS1.p26.m3" class="ltx_Math" alttext="D_{i}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>i</mi></msub><annotation encoding="application/x-tex">D_{i}</annotation></semantics></math> are zero, for <math id="S3.SS1.SSS1.p26.m4" class="ltx_Math" alttext="i&lt;j-1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i&lt;j-1</annotation></semantics></math>, and produce <math id="S3.SS1.SSS1.p26.m5" class="ltx_Math" alttext="M|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mi>M</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">M|_{0}</annotation></semantics></math> over the <math id="S3.SS1.SSS1.p26.m6" class="ltx_Math" alttext="(j-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(j-1)</annotation></semantics></math>-th node.</span></p>
</div>
<div id="S3.SS1.SSS1.p27" class="ltx_para">
<p id="S3.SS1.SSS1.p27.1" class="ltx_p"><span id="S3.SS1.SSS1.p27.1.1" class="ltx_text">We will choose an appropriate splitting of <math id="S3.SS1.SSS1.p27.m1" class="ltx_Math" alttext="V_{j-1}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">V_{j-1}</annotation></semantics></math> so that endomorphisms preserving the flags <math id="S3.SS1.SSS1.p27.m2" class="ltx_Math" alttext="L^{\bullet}_{j-1}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j-1}</annotation></semantics></math>
and <math id="S3.SS1.SSS1.p27.m3" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> become block matrices.</span></p>
</div>
<div id="S3.Thmtheorem16" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem16.2" class="ltx_text ltx_font_bold">3.16</span></span><span id="S3.Thmtheorem16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem16.p1" class="ltx_para">
<p id="S3.Thmtheorem16.p1.1" class="ltx_p">An ordered basis <math id="S3.Thmtheorem16.p1.m1" class="ltx_Math" alttext="v_{1},\ldots,v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">v_{1},\ldots,v_{n}</annotation></semantics></math> <em id="S3.Thmtheorem16.p1.1.1" class="ltx_emph ltx_font_italic">generates the flag</em> <math id="S3.Thmtheorem16.p1.m2" class="ltx_Math" alttext="F^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">F^{\bullet}</annotation></semantics></math> if each <math id="S3.Thmtheorem16.p1.m3" class="ltx_Math" alttext="F^{i}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mi>i</mi></msup><annotation encoding="application/x-tex">F^{i}</annotation></semantics></math> is the span of
<math id="S3.Thmtheorem16.p1.m4" class="ltx_Math" alttext="v_{1},v_{2},\ldots,v_{n_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><msub><mi>n</mi><mi>i</mi></msub></msub></mrow><annotation encoding="application/x-tex">v_{1},v_{2},\ldots,v_{n_{i}}</annotation></semantics></math> for some <math id="S3.Thmtheorem16.p1.m5" class="ltx_Math" alttext="n_{i}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>i</mi></msub><annotation encoding="application/x-tex">n_{i}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.Thmtheorem17" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem17.2" class="ltx_text ltx_font_bold">3.17</span></span><span id="S3.Thmtheorem17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem17.p1" class="ltx_para">
<p id="S3.Thmtheorem17.p1.1" class="ltx_p"><span id="S3.Thmtheorem17.p1.1.1" class="ltx_text ltx_font_italic">We may choose an ordered basis <math id="S3.Thmtheorem17.p1.m1" class="ltx_Math" alttext="v_{1},\ldots,v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">v_{1},\ldots,v_{n}</annotation></semantics></math> of <math id="S3.Thmtheorem17.p1.m2" class="ltx_Math" alttext="V_{j-1}|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>V</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">V_{j-1}|_{0}</annotation></semantics></math> generating <math id="S3.Thmtheorem17.p1.m3" class="ltx_Math" alttext="L^{\bullet}_{j-1}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j-1}</annotation></semantics></math> and
such that <math id="S3.Thmtheorem17.p1.m4" class="ltx_Math" alttext="W_{j-1}|_{0}=\langle v_{k},v_{k+1},\ldots,v_{n}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msub><mi>W</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>v</mi><mi>k</mi></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">W_{j-1}|_{0}=\langle v_{k},v_{k+1},\ldots,v_{n}\rangle</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.4.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S3.Thmtheorem17" title="3.17. ‣ Proof of . ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.17</span></a>.</h6>
<div id="S3.SS1.SSS1.p28" class="ltx_para">
<p id="S3.SS1.SSS1.p28.1" class="ltx_p"><span id="S3.SS1.SSS1.p28.1.1" class="ltx_text">We use the same idea as in the proof of <a href="#S3.Thmtheorem15" title="3.15. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">3.15</span></a>. Complete <math id="S3.SS1.SSS1.p28.m1" class="ltx_Math" alttext="L^{\bullet}_{j-1}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j-1}</annotation></semantics></math>
and <math id="S3.SS1.SSS1.p28.m2" class="ltx_Math" alttext="G^{\bullet}=(0\subset W_{j-1}|_{0}\subset V_{j-1}|_{0})" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>∙</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0</mn><mo>⊂</mo><msub><mrow><msub><mi>W</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>⊂</mo><msub><mrow><msub><mi>V</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G^{\bullet}=(0\subset W_{j-1}|_{0}\subset V_{j-1}|_{0})</annotation></semantics></math> to generic complete flags <math id="S3.SS1.SSS1.p28.m3" class="ltx_Math" alttext="\widehat{L}^{\bullet}_{j-1}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>L</mi><mo>^</mo></mover><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">\widehat{L}^{\bullet}_{j-1}</annotation></semantics></math> and <math id="S3.SS1.SSS1.p28.m4" class="ltx_Math" alttext="\widehat{G}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>G</mi><mo>^</mo></mover><mo>∙</mo></msup><annotation encoding="application/x-tex">\widehat{G}^{\bullet}</annotation></semantics></math>.
Since <math id="S3.SS1.SSS1.p28.m5" class="ltx_Math" alttext="G^{\bullet}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∙</mo></msup><annotation encoding="application/x-tex">G^{\bullet}</annotation></semantics></math> is transverse to <math id="S3.SS1.SSS1.p28.m6" class="ltx_Math" alttext="L^{\bullet}_{j-1}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j-1}</annotation></semantics></math> by assumption, so is
<math id="S3.SS1.SSS1.p28.m7" class="ltx_Math" alttext="\widehat{L}^{\bullet}_{j-1}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>L</mi><mo>^</mo></mover><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">\widehat{L}^{\bullet}_{j-1}</annotation></semantics></math> and <math id="S3.SS1.SSS1.p28.m8" class="ltx_Math" alttext="\widehat{G}^{\bullet}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>G</mi><mo>^</mo></mover><mo>∙</mo></msup><annotation encoding="application/x-tex">\widehat{G}^{\bullet}</annotation></semantics></math>.
Choose <math id="S3.SS1.SSS1.p28.m9" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> such that <math id="S3.SS1.SSS1.p28.m10" class="ltx_Math" alttext="\langle v_{i}\rangle=\widehat{L}^{i}_{j-1}\cap\widehat{G}^{n-i-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>^</mo></mover><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo>∩</mo><msup><mover accent="true"><mi>G</mi><mo>^</mo></mover><mrow><mi>n</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\langle v_{i}\rangle=\widehat{L}^{i}_{j-1}\cap\widehat{G}^{n-i-1}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.p29" class="ltx_para">
<p id="S3.SS1.SSS1.p29.1" class="ltx_p"><span id="S3.SS1.SSS1.p29.1.1" class="ltx_text">Note that the modification <math id="S3.SS1.SSS1.p29.m1" class="ltx_Math" alttext="L^{\bullet}_{j-1}\wedge(0\subset W_{j-1}|_{0}\subset V_{j-1}|_{0})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><mo>∧</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0</mn><mo>⊂</mo><msub><mrow><msub><mi>W</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><mo>⊂</mo><msub><mrow><msub><mi>V</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{\bullet}_{j-1}\wedge(0\subset W_{j-1}|_{0}\subset V_{j-1}|_{0})</annotation></semantics></math> is generated by the
ordered basis <math id="S3.SS1.SSS1.p29.m2" class="ltx_Math" alttext="(v_{k},v_{k+1},\ldots,v_{n},v_{1},v_{2},\ldots,v_{k-1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>k</mi></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v_{k},v_{k+1},\ldots,v_{n},v_{1},v_{2},\ldots,v_{k-1})</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.SSS1.p30" class="ltx_para">
<p id="S3.SS1.SSS1.p30.1" class="ltx_p"><span id="S3.SS1.SSS1.p30.1.1" class="ltx_text">Now pick a splitting of <math id="S3.SS1.SSS1.p30.m1" class="ltx_Math" alttext="V_{j-1}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">V_{j-1}</annotation></semantics></math> that restricts to the basis <math id="S3.SS1.SSS1.p30.m2" class="ltx_Math" alttext="v_{1},\ldots,v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">v_{1},\ldots,v_{n}</annotation></semantics></math> over zero. Let us write the matrix <math id="S3.SS1.SSS1.p30.m3" class="ltx_Math" alttext="M\in H^{0}(\End(V_{j-1}))" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\in H^{0}(\End(V_{j-1}))</annotation></semantics></math> in this basis.
For convenience, we will use block notation, separating the vectors generating <math id="S3.SS1.SSS1.p30.m4" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> (that is, <math id="S3.SS1.SSS1.p30.m5" class="ltx_Math" alttext="v_{k},\ldots,v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>k</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">v_{k},\ldots,v_{n}</annotation></semantics></math>), from the remaining <math id="S3.SS1.SSS1.p30.m6" class="ltx_Math" alttext="v_{1},\ldots,v_{k-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">v_{1},\ldots,v_{k-1}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.SSS1.p31" class="ltx_para">
<table id="S3.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex32.m1" class="ltx_Math" alttext="M=\left[\begin{array}[]{c|c}M(V/W,V/W)&amp;M(W,V/W)\\
\hline\cr M(V/W,W)&amp;M(W,W)\end{array}\right]" display="block" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo>,</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd></mtd></mtr><mtr><mtd><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo>,</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">M=\left[\begin{array}[]{c|c}M(V/W,V/W)&amp;M(W,V/W)\\
\hline\cr M(V/W,W)&amp;M(W,W)\end{array}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.p31.1" class="ltx_p"><span id="S3.SS1.SSS1.p31.1.1" class="ltx_text">We want <math id="S3.SS1.SSS1.p31.m1" class="ltx_Math" alttext="M|_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mi>M</mi><mo stretchy="false">|</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">M|_{0}</annotation></semantics></math> to respect the flag <math id="S3.SS1.SSS1.p31.m2" class="ltx_Math" alttext="L^{\bullet}_{j-1}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j-1}</annotation></semantics></math>, and <math id="S3.SS1.SSS1.p31.m3" class="ltx_Math" alttext="M|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mi>M</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">M|_{\infty}</annotation></semantics></math> to be the given matrix <math id="S3.SS1.SSS1.p31.m4" class="ltx_Math" alttext="\overline{M}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{M}</annotation></semantics></math> respecting the <math id="S3.SS1.SSS1.p31.m5" class="ltx_Math" alttext="L_{j}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>j</mi></msub><annotation encoding="application/x-tex">L_{j}</annotation></semantics></math> flag. In this block notation this
translates into the following conditions:</span></p>
<ol id="S3.I3" class="ltx_enumerate">
<li id="S3.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I3.i1.p1" class="ltx_para">
<p id="S3.I3.i1.p1.1" class="ltx_p">The matrix <math id="S3.I3.i1.p1.m1" class="ltx_Math" alttext="M(V/W,V/W)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo>,</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(V/W,V/W)</annotation></semantics></math> is upper block triangular when restricted to both zero and infinity (for the same block shapes). The entries of
<math id="S3.I3.i1.p1.m2" class="ltx_Math" alttext="M(V/W,V/W)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo>,</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(V/W,V/W)</annotation></semantics></math> are valued in <math id="S3.I3.i1.p1.m3" class="ltx_Math" alttext="{\mathcal{O}}_{{\bf P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathcal{O}}_{{\bf P}^{1}}</annotation></semantics></math>, so we must take the constant matrix specified by <math id="S3.I3.i1.p1.m4" class="ltx_Math" alttext="\overline{M}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{M}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I3.i2.p1" class="ltx_para">
<p id="S3.I3.i2.p1.1" class="ltx_p">The same applies for the block <math id="S3.I3.i2.p1.m1" class="ltx_Math" alttext="M(W,W)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(W,W)</annotation></semantics></math>: we want it to be upper block triangular at zero, with the restriction at infinity specified by <math id="S3.I3.i2.p1.m2" class="ltx_Math" alttext="\overline{M}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{M}</annotation></semantics></math>. Since the matrix <math id="S3.I3.i2.p1.m3" class="ltx_Math" alttext="M(W,W)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(W,W)</annotation></semantics></math> is valued in <math id="S3.I3.i2.p1.m4" class="ltx_Math" alttext="{\mathcal{O}}_{{\bf P}^{1}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><annotation encoding="application/x-tex">{\mathcal{O}}_{{\bf P}^{1}}</annotation></semantics></math>, we must use a constant matrix.</p>
</div></li>
<li id="S3.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I3.i3.p1" class="ltx_para">
<p id="S3.I3.i3.p1.1" class="ltx_p">The entries of <math id="S3.I3.i3.p1.m1" class="ltx_Math" alttext="M(W,V/W)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(W,V/W)</annotation></semantics></math> are valued in <math id="S3.I3.i3.p1.m2" class="ltx_Math" alttext="{\mathcal{O}}_{{\bf P}^{1}}(-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{{\bf P}^{1}}(-1)</annotation></semantics></math>, so it has to be the zero matrix. This poses no problems, because at infinity the
corresponding block of <math id="S3.I3.i3.p1.m3" class="ltx_Math" alttext="\overline{M}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{M}</annotation></semantics></math> is automatically zero to begin with.</p>
</div></li>
<li id="S3.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S3.I3.i4.p1" class="ltx_para">
<p id="S3.I3.i4.p1.1" class="ltx_p">Finally, the block <math id="S3.I3.i4.p1.m1" class="ltx_Math" alttext="M(V/W,W)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo>/</mo><mi>W</mi></mrow><mo>,</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(V/W,W)</annotation></semantics></math> must restrict to a specified matrix over infinity (given by <math id="S3.I3.i4.p1.m2" class="ltx_Math" alttext="\overline{M}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{M}</annotation></semantics></math>), but has to vanish over zero. This can be
achieved, because all the entries are valued in <math id="S3.I3.i4.p1.m3" class="ltx_Math" alttext="{\mathcal{O}}_{{\bf P}^{1}}(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}_{{\bf P}^{1}}(1)</annotation></semantics></math>, so we may take linear functions interpolating between arbitrary values
at zero and infinity.</p>
</div></li>
</ol>
</div>
<div id="S3.SS1.SSS1.p32" class="ltx_para">
<p id="S3.SS1.SSS1.p32.1" class="ltx_p"><span id="S3.SS1.SSS1.p32.1.1" class="ltx_text">This completes the proof <a href="#S3.Thmtheorem14" title="3.14. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">3.14</span></a>, and hence by induction the proof of <a href="#S3.Thmtheorem9" title="3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">3.9</span></a>.
∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Balanced <math id="S4.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundles and a maximal rank problem</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">The goal of this section is to translate the Main Theorem into a degree <math id="S4.p1.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> maximal rank problem for “maximally connected chains” in <math id="S4.p1.m2" class="ltx_Math" alttext="{\bf P}^{r}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mi>r</mi></msup><annotation encoding="application/x-tex">{\bf P}^{r}</annotation></semantics></math>. This
will in fact allow us to establish the following slightly stronger theorem.</p>
</div>
<div id="S4.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem1.2" class="ltx_text ltx_font_bold">4.1</span></span><span id="S4.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem1.p1" class="ltx_para">
<p id="S4.Thmtheorem1.p1.1" class="ltx_p"><span id="S4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">The general cover <math id="S4.Thmtheorem1.p1.m1" class="ltx_math_unparsed" alttext="[\alpha\colon C\to{\bf P}^{1}]\in\mathcal{H}_{d,g}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>C</mi><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo stretchy="false">]</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>d</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">[\alpha\colon C\to{\bf P}^{1}]\in\mathcal{H}_{d,g}</annotation></semantics></math> has a balanced bundle of quadrics <math id="S4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> whenever <math id="S4.Thmtheorem1.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> can be written as <math id="S4.Thmtheorem1.p1.m4" class="ltx_Math" alttext="(a-1)(d-1)+bd" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">(a-1)(d-1)+bd</annotation></semantics></math>, for integers <math id="S4.Thmtheorem1.p1.m5" class="ltx_Math" alttext="a,b\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a,b\geq 0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">The Main Theorem follows from <a href="#S4.Thmtheorem1" title="4.1. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> and the following lemma.</p>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem2.2" class="ltx_text ltx_font_bold">4.2</span></span><span id="S4.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
<p id="S4.Thmtheorem2.p1.1" class="ltx_p"><span id="S4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Any integer <math id="S4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="g\geq(d-3)(d-1)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g\geq(d-3)(d-1)</annotation></semantics></math> can be written as <math id="S4.Thmtheorem2.p1.m2" class="ltx_Math" alttext="(a-1)(d-1)+bd" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">(a-1)(d-1)+bd</annotation></semantics></math> for integers <math id="S4.Thmtheorem2.p1.m3" class="ltx_Math" alttext="a,b\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a,b\geq 0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p"><span id="S4.p3.1.1" class="ltx_text">We may write <math id="S4.p3.m1" class="ltx_Math" alttext="g=q(d-1)+r" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">g=q(d-1)+r</annotation></semantics></math> for</span></p>
<table id="S4.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex33.m1" class="ltx_Math" alttext="q\geq d-3\text{ and }d-2\geq r\geq 0" display="block" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mrow><mi>d</mi><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo>≥</mo><mi>r</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q\geq d-3\text{ and }d-2\geq r\geq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.p4" class="ltx_para">
<p id="S4.p4.1" class="ltx_p"><span id="S4.p4.1.1" class="ltx_text">Setting <math id="S4.p4.m1" class="ltx_Math" alttext="b=r\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mi>r</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b=r\geq 0</annotation></semantics></math> and <math id="S4.p4.m2" class="ltx_Math" alttext="a=q-r+1\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mrow><mi>q</mi><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a=q-r+1\geq 0</annotation></semantics></math>, we have</span></p>
<table id="S4.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex34.m1" class="ltx_Math" alttext="(a-1)(d-1)+bd=(q-r)(d-1)+rd=q(d-1)+r=g" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>=</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>r</mi></mrow><mo>=</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">(a-1)(d-1)+bd=(q-r)(d-1)+rd=q(d-1)+r=g</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p4.2" class="ltx_p"><span id="S4.p4.2.1" class="ltx_text">as we wanted.
∎</span></p>
</div>
</div>
<div id="S4.p5" class="ltx_para">
<p id="S4.p5.1" class="ltx_p">We prove <a href="#S4.Thmtheorem1" title="4.1. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> by first observing that being balanced is an open condition. Hence, it is enough to exhibit a single (admissible) cover with balanced <math id="S4.p5.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle. We will use <a href="#S3.Thmtheorem9" title="3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">3.9</span></a>
to translate this condition to a version of the maximal rank problem, specifically <a href="#S5.Thmtheorem1" title="5.1. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>.</p>
</div>
<div id="S4.p6" class="ltx_para">
<p id="S4.p6.1" class="ltx_p">The specific admissible cover we will consider arises from the following construction. Given:</p>
<ul id="S4.I1" class="ltx_itemize">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p">degree <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, genus <math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="g_{i}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>i</mi></msub><annotation encoding="application/x-tex">g_{i}</annotation></semantics></math> simply branched covers
<math id="S4.I1.i1.p1.m3" class="ltx_math_unparsed" alttext="[\alpha_{i}\colon C_{i}\to{\bf P}^{1}]\in\mathcal{H}_{d,g_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>C</mi><mi>i</mi></msub><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup><mo stretchy="false">]</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>d</mi><mo>,</mo><msub><mi>g</mi><mi>i</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">[\alpha_{i}\colon C_{i}\to{\bf P}^{1}]\in\mathcal{H}_{d,g_{i}}</annotation></semantics></math> unramified over
<math id="S4.I1.i1.p1.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S4.I1.i1.p1.m5" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math>, for <math id="S4.I1.i1.p1.m6" class="ltx_Math" alttext="i=1,\ldots,n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,n</annotation></semantics></math>, and</p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p">bijections <math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="\varphi_{i}:\alpha_{i}^{-1}(\infty)\to\alpha_{i+1}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>α</mi><mi>i</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi_{i}:\alpha_{i}^{-1}(\infty)\to\alpha_{i+1}^{-1}(0)</annotation></semantics></math>, for <math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="i=1,\ldots,n-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=1,\ldots,n-1</annotation></semantics></math></p>
</div></li>
</ul>
<p id="S4.p6.2" class="ltx_p">we may construct the nodal curve <math id="S4.p6.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, with irreducible components <math id="S4.p6.m2" class="ltx_Math" alttext="C_{1},\ldots,C_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>C</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">C_{1},\ldots,C_{n}</annotation></semantics></math>, obtained by identifying each <math id="S4.p6.m3" class="ltx_Math" alttext="p\in\alpha_{i}^{-1}(0)\subset C_{i}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><msubsup><mi>α</mi><mi>i</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>C</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">p\in\alpha_{i}^{-1}(0)\subset C_{i}</annotation></semantics></math> with <math id="S4.p6.m4" class="ltx_Math" alttext="\varphi(p)\in\alpha_{i+1}^{-1}(\infty)\subset C_{i+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>C</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\varphi(p)\in\alpha_{i+1}^{-1}(\infty)\subset C_{i+1}</annotation></semantics></math> via <math id="S4.p6.m5" class="ltx_Math" alttext="\varphi_{i}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\varphi_{i}</annotation></semantics></math>, for all <math id="S4.p6.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. (See <a href="#S4.F3" title="In 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">fig.</span> <span class="ltx_text ltx_ref_tag">3</span></a>.) The curve <math id="S4.p6.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has <math id="S4.p6.m8" class="ltx_Math" alttext="d(n-1)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(n-1)</annotation></semantics></math> nodes in total, and admits a map</p>
<table id="S4.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex35.m1" class="ltx_Math" alttext="\alpha\colon X\to{\bf P}_{n}" display="block" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha\colon X\to{\bf P}_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p6.3" class="ltx_p">to a chain of <math id="S4.p6.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> <math id="S4.p6.m10" class="ltx_Math" alttext="{\bf P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\bf P}^{1}</annotation></semantics></math>’s, which we denote by <math id="S4.p6.m11" class="ltx_Math" alttext="{\bf P}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝐏</mi><mi>n</mi></msub><annotation encoding="application/x-tex">{\bf P}_{n}</annotation></semantics></math>. The map <math id="S4.p6.m12" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is an admissible cover in the sense of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx10" title="" class="ltx_ref">HM82</a>]</cite>.</p>
</div>
<div id="S4.p7" class="ltx_para">
<p id="S4.p7.1" class="ltx_p">Denote by
<math id="S4.p7.m1" class="ltx_Math" alttext="\Sigma(d;g_{1},\ldots,g_{n})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>g</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma(d;g_{1},\ldots,g_{n})</annotation></semantics></math> the parameter space of admissible covers obtained by this procedure. Note that</p>
<table id="S4.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(13)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E13.m1" class="ltx_Math" alttext="g=p_{a}(X)=1+\sum_{i}(g_{i}-1)+d(n-1)." display="block" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>=</mo><mrow><msub><mi>p</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mi>i</mi></munder><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mi>i</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">g=p_{a}(X)=1+\sum_{i}(g_{i}-1)+d(n-1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<figure id="S4.F3" class="ltx_figure"><span id="S4.F3.pic1" class="ltx_picture ltx_centering" style="width:368.58pt;height:325.2176539968pt;"></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3. </span>An admissible cover <math id="S4.F3.m4" class="ltx_math_unparsed" alttext="[X\to{\bf P}_{n}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>n</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[X\to{\bf P}_{n}]</annotation></semantics></math> in <math id="S4.F3.m5" class="ltx_Math" alttext="\Sigma(d;g_{1},\ldots,g_{n})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>g</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma(d;g_{1},\ldots,g_{n})</annotation></semantics></math> for <math id="S4.F3.m6" class="ltx_Math" alttext="n=4,d=3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>4</mn></mrow><mo>,</mo><mrow><mi>d</mi><mo>=</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">n=4,d=3</annotation></semantics></math>.</figcaption>
</figure>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p"><span id="S4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">The space <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\Sigma(d;g_{1},\ldots,g_{n})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>g</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma(d;g_{1},\ldots,g_{n})</annotation></semantics></math> is irreducible.</span></p>
</div>
</div>
<div id="S4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p8" class="ltx_para">
<p id="S4.p8.1" class="ltx_p"><span id="S4.p8.1.1" class="ltx_text">Consider the forgetful finite map from <math id="S4.p8.m1" class="ltx_Math" alttext="g:\Sigma\to{\mathcal{H}}_{d,g_{1}}\times{\mathcal{H}}_{d,g_{2}}\times\ldots\times{\mathcal{H}}_{d,g_{n}}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>d</mi><mo>,</mo><msub><mi>g</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>d</mi><mo>,</mo><msub><mi>g</mi><mn>2</mn></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>d</mi><mo>,</mo><msub><mi>g</mi><mi>n</mi></msub></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">g:\Sigma\to{\mathcal{H}}_{d,g_{1}}\times{\mathcal{H}}_{d,g_{2}}\times\ldots\times{\mathcal{H}}_{d,g_{n}}</annotation></semantics></math>. The target is irreducible and smooth, so we only have to show that the monodromy on the fibers is transitive. The fibers
correspond to choosing different systems of bijections <math id="S4.p8.m2" class="ltx_Math" alttext="\{\varphi_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>φ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\varphi_{i}\}</annotation></semantics></math>. But each simply branched cover <math id="S4.p8.m3" class="ltx_Math" alttext="\alpha_{i}:C_{i}\to{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>i</mi></msub><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha_{i}:C_{i}\to{\bf P}^{1}</annotation></semantics></math> has full
monodromy, which in turn induces a transitive action on the set of systems of bijections <math id="S4.p8.m4" class="ltx_Math" alttext="\{\varphi_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>φ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\varphi_{i}\}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.p9" class="ltx_para">
<p id="S4.p9.1" class="ltx_p">From now on, we focus our attention on proving the following proposition, which implies <a href="#S4.Thmtheorem1" title="4.1. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>.</p>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">4.4</span></span><span id="S4.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p"><span id="S4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="g_{1}=\ldots=g_{a}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">…</mi><mo>=</mo><msub><mi>g</mi><mi>a</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g_{1}=\ldots=g_{a}=0</annotation></semantics></math> and <math id="S4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="g_{a+1}=\ldots=g_{a+b}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi mathvariant="normal">…</mi><mo>=</mo><msub><mi>g</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g_{a+1}=\ldots=g_{a+b}=1</annotation></semantics></math>, then the general admissible cover <math id="S4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\alpha\colon X\to{\bf P}_{a+b}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha\colon X\to{\bf P}_{a+b}</annotation></semantics></math>
in <math id="S4.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\Sigma(d;g_{1},\ldots,g_{a+b})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>g</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma(d;g_{1},\ldots,g_{a+b})</annotation></semantics></math> has balanced <math id="S4.Thmtheorem4.p1.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle.</span></p>
</div>
</div>
<div id="S4.p10" class="ltx_para">
<p id="S4.p10.1" class="ltx_p">Note that in the context of the proposition above, <a href="#S4.E13" title="In 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">13</span></a> becomes</p>
<table id="S4.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex36.m1" class="ltx_Math" alttext="\displaystyle g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">\displaystyle g</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex36.m2" class="ltx_Math" alttext="\displaystyle=1+\sum_{i}(g_{i}-1)+d(a+b-1)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mi>i</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1+\sum_{i}(g_{i}-1)+d(a+b-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex37.m1" class="ltx_Math" alttext="\displaystyle=1+a(0-1)+b(1-1)+d(a+b-1)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0</mn><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1+a(0-1)+b(1-1)+d(a+b-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex38.m1" class="ltx_Math" alttext="\displaystyle=(a-1)(d-1)+bd." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(a-1)(d-1)+bd.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.p11" class="ltx_para">
<p id="S4.p11.1" class="ltx_p">We start the proof of <a href="#S4.Thmtheorem4" title="4.4. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">4.4</span></a> by reducing to the case where all components
are rational.</p>
</div>
<div id="S4.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem5.2" class="ltx_text ltx_font_bold">4.5</span></span><span id="S4.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem5.p1" class="ltx_para">
<p id="S4.Thmtheorem5.p1.1" class="ltx_p"><span id="S4.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">To prove <a href="#S4.Thmtheorem4" title="4.4. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">4.4</span></a>, it suffices to prove the case <math id="S4.Thmtheorem5.p1.m1" class="ltx_Math" alttext="b=0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b=0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p12" class="ltx_para">
<p id="S4.p12.1" class="ltx_p"><span id="S4.p12.1.1" class="ltx_text">Let <math id="S4.p12.m1" class="ltx_Math" alttext="\alpha:X\to{\bf P}_{a+b}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha:X\to{\bf P}_{a+b}</annotation></semantics></math> be a general cover in <math id="S4.p12.m2" class="ltx_Math" alttext="\Sigma(d;0,...,0,1,...1)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma(d;0,...,0,1,...1)</annotation></semantics></math>. Split it into the <math id="S4.p12.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> rational
components <math id="S4.p12.m4" class="ltx_Math" alttext="X_{R}\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>R</mi></msub><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">X_{R}\to{\bf P}_{a}</annotation></semantics></math> and the <math id="S4.p12.m5" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> genus one components <math id="S4.p12.m6" class="ltx_Math" alttext="X_{E}\to{\bf P}_{b}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>E</mi></msub><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">X_{E}\to{\bf P}_{b}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.p13" class="ltx_para">
<p id="S4.p13.1" class="ltx_p"><span id="S4.p13.1.1" class="ltx_text">The forgetful map <math id="S4.p13.m1" class="ltx_Math" alttext="\Sigma(d;0,...,0,1,...1)\to\Sigma(d;0,...,0)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Sigma(d;0,...,0,1,...1)\to\Sigma(d;0,...,0)</annotation></semantics></math> (which sends the cover <math id="S4.p13.m2" class="ltx_Math" alttext="X\to{\bf P}_{a+b}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></msub></mrow><annotation encoding="application/x-tex">X\to{\bf P}_{a+b}</annotation></semantics></math> to <math id="S4.p13.m3" class="ltx_Math" alttext="X_{R}\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>R</mi></msub><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">X_{R}\to{\bf P}_{a}</annotation></semantics></math>) is dominant. Hence, if we assume <a href="#S4.Thmtheorem4" title="4.4. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">4.4</span></a> is true when <math id="S4.p13.m4" class="ltx_Math" alttext="b=0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b=0</annotation></semantics></math>, we may assume the <math id="S4.p13.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle of <math id="S4.p13.m6" class="ltx_Math" alttext="X_{R}\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>R</mi></msub><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">X_{R}\to{\bf P}_{a}</annotation></semantics></math> is balanced.</span></p>
</div>
<div id="S4.p14" class="ltx_para">
<p id="S4.p14.1" class="ltx_p"><span id="S4.p14.1.1" class="ltx_text">Moreover, by <a href="#S2.I3.i4" title="In 2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">item</span> <span class="ltx_text ltx_ref_tag">(d)</span></a> of <a href="#S2.Thmtheorem7" title="2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">2.7</span></a>, the <math id="S4.p14.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle of <math id="S4.p14.m2" class="ltx_Math" alttext="X_{E}\to{\bf P}_{b}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>E</mi></msub><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">X_{E}\to{\bf P}_{b}</annotation></semantics></math> is not only balanced, it is <em id="S4.p14.1.1.1" class="ltx_emph ltx_font_italic">trivial</em>, up to a twist by a line bundle. Hence, the <math id="S4.p14.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle of <math id="S4.p14.m4" class="ltx_Math" alttext="\alpha:X\to{\bf P}_{a+b}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha:X\to{\bf P}_{a+b}</annotation></semantics></math>—which is obtained by gluing the
(balanced) <math id="S4.p14.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle of <math id="S4.p14.m6" class="ltx_Math" alttext="X_{R}\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>R</mi></msub><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">X_{R}\to{\bf P}_{a}</annotation></semantics></math> with the (trivial, up to twist) <math id="S4.p14.m7" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle of <math id="S4.p14.m8" class="ltx_Math" alttext="X_{E}\to{\bf P}_{b}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>E</mi></msub><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">X_{E}\to{\bf P}_{b}</annotation></semantics></math>—is balanced as well.
∎</span></p>
</div>
</div>
<div id="S4.p15" class="ltx_para">
<p id="S4.p15.1" class="ltx_p">Given this lemma, we need only consider the case <math id="S4.p15.m1" class="ltx_Math" alttext="g_{1}=\ldots=g_{a}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">…</mi><mo>=</mo><msub><mi>g</mi><mi>a</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g_{1}=\ldots=g_{a}=0</annotation></semantics></math>. So we simplify notation by setting</p>
<table id="S4.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex39.m1" class="ltx_Math" alttext="\Sigma_{d,a}:=\Sigma(d;0,0,\ldots,0)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>d</mi><mo>,</mo><mi>a</mi></mrow></msub><mo>:=</mo><mrow><mi mathvariant="normal">Σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Sigma_{d,a}:=\Sigma(d;0,0,\ldots,0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.p16" class="ltx_para">
<p id="S4.p16.1" class="ltx_p">Let <math id="S4.p16.m1" class="ltx_Math" alttext="\alpha:X\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha:X\to{\bf P}_{a}</annotation></semantics></math> be a general cover in <math id="S4.p16.m2" class="ltx_Math" alttext="\Sigma_{d,a}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>d</mi><mo>,</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{d,a}</annotation></semantics></math>. We want to show that its <math id="S4.p16.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle is balanced. Each component of <math id="S4.p16.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is rational—we will denote the components by <math id="S4.p16.m5" class="ltx_Math" alttext="R_{1},R_{2},\ldots,R_{a}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>,</mo><msub><mi>R</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>R</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">R_{1},R_{2},\ldots,R_{a}</annotation></semantics></math>.</p>
</div>
<div id="S4.p17" class="ltx_para">
<p id="S4.p17.1" class="ltx_p">From <a href="#S2.Thmtheorem7" title="2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">2.7</span></a>, the Tschirnhausen bundle <math id="S4.p17.m1" class="ltx_Math" alttext="E_{\alpha_{i}}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><msub><mi>α</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">E_{\alpha_{i}}</annotation></semantics></math> for each component <math id="S4.p17.m2" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math> is trivial up to a twist by a line bundle.
Hence the Tschirnhausen bundle <math id="S4.p17.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> for the entire cover <math id="S4.p17.m4" class="ltx_Math" alttext="\alpha\colon X\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha\colon X\to{\bf P}_{a}</annotation></semantics></math> is trivial up to a twist as well, which implies <math id="S4.p17.m5" class="ltx_Math" alttext="{\bf P}(E)\simeq{\bf P}^{d-2}\times{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\bf P}(E)\simeq{\bf P}^{d-2}\times{\bf P}_{a}</annotation></semantics></math>. Composing the relative canonical embedding
<math id="S4.p17.m6" class="ltx_Math" alttext="X\hookrightarrow{\bf P}(E)={\bf P}^{d-2}\times{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo stretchy="false">↪</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X\hookrightarrow{\bf P}(E)={\bf P}^{d-2}\times{\bf P}_{a}</annotation></semantics></math> with the projection onto the first factor gives us a map <math id="S4.p17.m7" class="ltx_Math" alttext="X\to{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo stretchy="false">→</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">X\to{\bf P}^{d-2}</annotation></semantics></math>. As in the proof of <a href="#S2.Thmtheorem7" title="2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">2.7</span></a>, this
map is easily seen to be an embedding, and each component <math id="S4.p17.m8" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math> maps to a rational normal curve in <math id="S4.p17.m9" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math>. The resulting embedded curve <math id="S4.p17.m10" class="ltx_Math" alttext="X\subset{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">X\subset{\bf P}^{d-2}</annotation></semantics></math> is the main object of our investigation moving forward, so we make the following definition:</p>
</div>
<div id="S4.Thmtheorem6" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem6.2" class="ltx_text ltx_font_bold">4.6</span></span><span id="S4.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem6.p1" class="ltx_para">
<p id="S4.Thmtheorem6.p1.1" class="ltx_p">A <em id="S4.Thmtheorem6.p1.1.1" class="ltx_emph ltx_font_italic">maximally connected chain of length</em> <math id="S4.Thmtheorem6.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> in <math id="S4.Thmtheorem6.p1.m2" class="ltx_Math" alttext="{\bf P}^{r}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mi>r</mi></msup><annotation encoding="application/x-tex">{\bf P}^{r}</annotation></semantics></math> is a reducible nodal curve
<math id="S4.Thmtheorem6.p1.m3" class="ltx_Math" alttext="X=R_{1}\cup\ldots R_{n}\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∪</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>n</mi></msub></mrow></mrow><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">X=R_{1}\cup\ldots R_{n}\subset{\bf P}^{r}</annotation></semantics></math> with <math id="S4.Thmtheorem6.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> components, which are called <em id="S4.Thmtheorem6.p1.1.2" class="ltx_emph ltx_font_italic">links</em>. Each
link <math id="S4.Thmtheorem6.p1.m5" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math> is a non-degenerate, degree <math id="S4.Thmtheorem6.p1.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, nodal, connected curve, and consecutive links <math id="S4.Thmtheorem6.p1.m7" class="ltx_Math" alttext="R_{i}\cap R_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∩</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">R_{i}\cap R_{i+1}</annotation></semantics></math> meet in <math id="S4.Thmtheorem6.p1.m8" class="ltx_Math" alttext="r+2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r+2</annotation></semantics></math> points; otherwise there are no further intersections between components. The points <math id="S4.Thmtheorem6.p1.m9" class="ltx_Math" alttext="R_{i}\cap R_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∩</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">R_{i}\cap R_{i+1}</annotation></semantics></math> will be called <em id="S4.Thmtheorem6.p1.1.3" class="ltx_emph ltx_font_italic">anchor points</em>. See <a href="#footnote2" title="In Figure 4 ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">footnote</span> <span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<div id="S4.Thmtheorem6.p2" class="ltx_para">
<p id="S4.Thmtheorem6.p2.1" class="ltx_p">Let <math id="S4.Thmtheorem6.p2.m1" class="ltx_Math" alttext="MC_{r,n}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">MC_{r,n}</annotation></semantics></math> denote the quasi-projective variety parametrizing all maximally connected chains of length <math id="S4.Thmtheorem6.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> in <math id="S4.Thmtheorem6.p2.m3" class="ltx_Math" alttext="{\bf P}^{r}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mi>r</mi></msup><annotation encoding="application/x-tex">{\bf P}^{r}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.Thmtheorem7" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem7.2" class="ltx_text ltx_font_italic">4.7</span></span><span id="S4.Thmtheorem7.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmtheorem7.p1" class="ltx_para">
<p id="S4.Thmtheorem7.p1.1" class="ltx_p">For a generic maximally connected chain, each link <math id="S4.Thmtheorem7.p1.m1" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math> is a smooth rational normal curve. We will eventually need to consider degenerate maximally connected chains where the <math id="S4.Thmtheorem7.p1.m2" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math> become singular.</p>
</div>
</div>
<figure id="S4.F4" class="ltx_figure"><span id="S4.F4.pic1" class="ltx_picture ltx_centering" style="width:219.7pt;height:73.715130307pt;"></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4. </span>An illustration<span id="footnote2" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">2</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">2</sup>
            <span class="ltx_tag ltx_tag_note">2</span>
            
            
            
            
            
            
            
          Strictly speaking,
our definition <a href="#S4.Thmtheorem6" title="4.6. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">definition</span> <span class="ltx_text ltx_ref_tag">4.6</span></a> does not allow for maximally connected chains in <math id="footnotex1.m1a" class="ltx_Math" alttext="{\bf P}^{2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\bf P}^{2}</annotation></semantics></math> because pairs of non-consecutive links will meet. However, for illustration purposes the real points of a chain of conics make a more informative and legible picture than a chain of twisted cubics, meeting pairwise at 5 points.</span></span></span>of a maximally connected chain in <math id="S4.F4.m2" class="ltx_Math" alttext="{\bf P}^{2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\bf P}^{2}</annotation></semantics></math>.
</figcaption>
</figure>
<div id="S4.Thmtheorem8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem8.2" class="ltx_text ltx_font_bold">4.8</span></span><span id="S4.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem8.p1" class="ltx_para">
<p id="S4.Thmtheorem8.p1.1" class="ltx_p"><span id="S4.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">The space <math id="S4.Thmtheorem8.p1.m1" class="ltx_Math" alttext="MC_{r,n}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">MC_{r,n}</annotation></semantics></math> is irreducible of dimension
<math id="S4.Thmtheorem8.p1.m2" class="ltx_Math" alttext="(r-1)(r+3)+(n-1)(2r+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(r-1)(r+3)+(n-1)(2r+1)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p18" class="ltx_para">
<p id="S4.p18.1" class="ltx_p"><span id="S4.p18.1.1" class="ltx_text">We use induction on <math id="S4.p18.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. For <math id="S4.p18.m2" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math>, we are simply parametrizing rational normal curves in <math id="S4.p18.m3" class="ltx_Math" alttext="{\bf P}^{r}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mi>r</mi></msup><annotation encoding="application/x-tex">{\bf P}^{r}</annotation></semantics></math> (possibly nodal), and their
parameter space is irreducible of dimension <math id="S4.p18.m4" class="ltx_Math" alttext="(r-1)(r+3)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(r-1)(r+3)</annotation></semantics></math>, as we wanted to show.</span></p>
</div>
<div id="S4.p19" class="ltx_para">
<p id="S4.p19.1" class="ltx_p"><span id="S4.p19.1.1" class="ltx_text">For the induction
step, notice that the space <math id="S4.p19.m1" class="ltx_Math" alttext="MC_{r,n}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">MC_{r,n}</annotation></semantics></math> admits a dominant forgetful morphism to <math id="S4.p19.m2" class="ltx_Math" alttext="MC_{r,n-1}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">MC_{r,n-1}</annotation></semantics></math> by forgetting the last
component. It is enough to show that the fibers are irreducible of dimension <math id="S4.p19.m3" class="ltx_Math" alttext="2r+1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2r+1</annotation></semantics></math>.
The fiber over <math id="S4.p19.m4" class="ltx_Math" alttext="R_{1}\cup\ldots R_{n-1}\in MC_{r,n-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∪</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>∈</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">R_{1}\cup\ldots R_{n-1}\in MC_{r,n-1}</annotation></semantics></math> is an open subset of the scheme of rational normal curves <math id="S4.p19.m5" class="ltx_Math" alttext="R_{n}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>n</mi></msub><annotation encoding="application/x-tex">R_{n}</annotation></semantics></math> meeting
<math id="S4.p19.m6" class="ltx_Math" alttext="R_{n-1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{n-1}</annotation></semantics></math> in <math id="S4.p19.m7" class="ltx_Math" alttext="r+2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r+2</annotation></semantics></math> points. This is irreducible, since upon fixing the <math id="S4.p19.m8" class="ltx_Math" alttext="r+2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r+2</annotation></semantics></math> points of intersection,
the space of rational normal curves through them is isomorphic to the moduli space <math id="S4.p19.m9" class="ltx_Math" alttext="\overline{\mathcal{M}}_{r+2,0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{r+2,0}</annotation></semantics></math>, which has dimension <math id="S4.p19.m10" class="ltx_Math" alttext="r-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r-1</annotation></semantics></math>. (This is the <em id="S4.p19.1.1.1" class="ltx_emph ltx_font_italic">Kapranov model</em> of <math id="S4.p19.m11" class="ltx_Math" alttext="\overline{\mathcal{M}}_{r+2,0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{r+2,0}</annotation></semantics></math> as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx11" title="" class="ltx_ref">Kap93</a>]</cite>.)
In total, the fiber of the forgetful map has dimension <math id="S4.p19.m12" class="ltx_Math" alttext="(r+2)+(r-1)=2r+1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">(r+2)+(r-1)=2r+1</annotation></semantics></math>, which allows us to conclude the lemma.
∎</span></p>
</div>
</div>
<div id="S4.p20" class="ltx_para">
<p id="S4.p20.1" class="ltx_p">By projecting an admissible cover of type <math id="S4.p20.m1" class="ltx_Math" alttext="\alpha:X\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha:X\to{\bf P}_{a}</annotation></semantics></math> in its relative canonical embedding <math id="S4.p20.m2" class="ltx_Math" alttext="X\,{\hookrightarrow}\,{\bf P}^{d-2}\times{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo lspace="0.448em" rspace="0.448em" stretchy="false">↪</mo><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X\,{\hookrightarrow}\,{\bf P}^{d-2}\times{\bf P}_{a}</annotation></semantics></math> to <math id="S4.p20.m3" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math>, we obtain a
maximally connected chain of length <math id="S4.p20.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> in <math id="S4.p20.m5" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math>. That is, there is a natural map <math id="S4.p20.m6" class="ltx_Math" alttext="f:\Sigma_{d,a}\to MC_{d-2,a}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>d</mi><mo>,</mo><mi>a</mi></mrow></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mi>a</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f:\Sigma_{d,a}\to MC_{d-2,a}</annotation></semantics></math>.
Conversely, we claim that a generic
maximally connected chain can be realized as such a projection of an admissible cover in <math id="S4.p20.m7" class="ltx_Math" alttext="\Sigma_{d,a}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>d</mi><mo>,</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{d,a}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem9.2" class="ltx_text ltx_font_bold">4.9</span></span><span id="S4.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem9.p1" class="ltx_para">
<p id="S4.Thmtheorem9.p1.1" class="ltx_p"><span id="S4.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">The map <math id="S4.Thmtheorem9.p1.m1" class="ltx_Math" alttext="f:\Sigma_{d,a}\to MC_{d-2,a}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>d</mi><mo>,</mo><mi>a</mi></mrow></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mi>a</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f:\Sigma_{d,a}\to MC_{d-2,a}</annotation></semantics></math> is dominant.</span></p>
</div>
</div>
<div id="S4.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p21" class="ltx_para">
<p id="S4.p21.1" class="ltx_p"><span id="S4.p21.1.1" class="ltx_text">Let <math id="S4.p21.m1" class="ltx_Math" alttext="X\subset{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">X\subset{\bf P}^{d-2}</annotation></semantics></math> be a general maximally connected chain of length <math id="S4.p21.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, and let <math id="S4.p21.m3" class="ltx_Math" alttext="R_{1},\ldots,R_{a}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>R</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">R_{1},\ldots,R_{a}</annotation></semantics></math> be its components. For <math id="S4.p21.m4" class="ltx_Math" alttext="i=2,\ldots,a-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=2,\ldots,a-1</annotation></semantics></math>, the rational curve <math id="S4.p21.m5" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math> has a distinguished pencil of divisors on <math id="S4.p21.m6" class="ltx_Math" alttext="\mathcal{O}_{R_{i}}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>R</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}_{R_{i}}(d)</annotation></semantics></math>, namely the pencil spanned by the two sets of anchor points <math id="S4.p21.m7" class="ltx_Math" alttext="R_{i}\cap R_{i-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∩</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">R_{i}\cap R_{i-1}</annotation></semantics></math> and <math id="S4.p21.m8" class="ltx_Math" alttext="R_{i}\cap R_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∩</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">R_{i}\cap R_{i+1}</annotation></semantics></math>. Let <math id="S4.p21.m9" class="ltx_Math" alttext="0\in{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>∈</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">0\in{\bf P}^{1}</annotation></semantics></math> correspond to the former, and let <math id="S4.p21.m10" class="ltx_Math" alttext="\infty\in{\bf P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">∞</mi><mo>∈</mo><msup><mi>𝐏</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\infty\in{\bf P}^{1}</annotation></semantics></math> correspond to the latter. Now, for <math id="S4.p21.m11" class="ltx_Math" alttext="R_{1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>1</mn></msub><annotation encoding="application/x-tex">R_{1}</annotation></semantics></math> (and <math id="S4.p21.m12" class="ltx_Math" alttext="R_{a}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>a</mi></msub><annotation encoding="application/x-tex">R_{a}</annotation></semantics></math>), simply choose a basepoint free pencil of sections of <math id="S4.p21.m13" class="ltx_Math" alttext="\mathcal{O}_{R_{1}}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>R</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}_{R_{1}}(d)</annotation></semantics></math> (resp. <math id="S4.p21.m14" class="ltx_Math" alttext="\mathcal{O}_{R_{a}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msub><mi>R</mi><mi>a</mi></msub></msub><annotation encoding="application/x-tex">\mathcal{O}_{R_{a}}</annotation></semantics></math>) containing <math id="S4.p21.m15" class="ltx_Math" alttext="R_{1}\cap R_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∩</mo><msub><mi>R</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">R_{1}\cap R_{2}</annotation></semantics></math> (resp. <math id="S4.p21.m16" class="ltx_Math" alttext="R_{a-1}\cap R_{a}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∩</mo><msub><mi>R</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">R_{a-1}\cap R_{a}</annotation></semantics></math>). The data of the curves <math id="S4.p21.m17" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math> along with the pencils of degree <math id="S4.p21.m18" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> divisors on each gives rise to an admissible cover <math id="S4.p21.m19" class="ltx_Math" alttext="\alpha\colon X\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha\colon X\to{\bf P}_{a}</annotation></semantics></math>. The map <math id="S4.p21.m20" class="ltx_Math" alttext="X\to{\bf P}^{d-2}\times{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo stretchy="false">→</mo><mrow><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X\to{\bf P}^{d-2}\times{\bf P}_{a}</annotation></semantics></math> is the relative canonical embedding for <math id="S4.p21.m21" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, because each fiber <math id="S4.p21.m22" class="ltx_Math" alttext="X_{t}\subset{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">X_{t}\subset{\bf P}^{d-2}</annotation></semantics></math> is a length <math id="S4.p21.m23" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> arithmetically Gorenstein subscheme. Therefore, <math id="S4.p21.m24" class="ltx_Math" alttext="f(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)</annotation></semantics></math> is the
original maximally connected chain <math id="S4.p21.m25" class="ltx_Math" alttext="X\subset{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">X\subset{\bf P}^{d-2}</annotation></semantics></math>, as we wanted to show.
∎</span></p>
</div>
</div>
<div id="S4.p22" class="ltx_para">
<p id="S4.p22.1" class="ltx_p">Two properties of maximally connected chains will be important for us.</p>
</div>
<div id="S4.Thmtheorem10" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem10.2" class="ltx_text ltx_font_bold">4.10</span></span><span id="S4.Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem10.p1" class="ltx_para">
<p id="S4.Thmtheorem10.p1.1" class="ltx_p">A maximally connected chain <math id="S4.Thmtheorem10.p1.m1" class="ltx_Math" alttext="X=R_{1}\cup\ldots\cup R_{n}\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>n</mi></msub></mrow><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">X=R_{1}\cup\ldots\cup R_{n}\subset{\bf P}^{r}</annotation></semantics></math> is <em id="S4.Thmtheorem10.p1.1.1" class="ltx_emph ltx_font_italic">quadric-generic</em> if for any subchain
<math id="S4.Thmtheorem10.p1.m2" class="ltx_Math" alttext="Y=R_{i}\cup R_{i+1}\cup\ldots\cup R_{i+j}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∪</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">Y=R_{i}\cup R_{i+1}\cup\ldots\cup R_{i+j}</annotation></semantics></math>, the restriction map</p>
<table id="S4.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex40.m1" class="ltx_Math" alttext="H^{0}({\bf P}^{r},{\mathcal{O}}_{{\bf P}^{r}}(2))\to H^{0}(Y,{\mathcal{O}}_{Y}(2))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mi>r</mi></msup><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>Y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\bf P}^{r},{\mathcal{O}}_{{\bf P}^{r}}(2))\to H^{0}(Y,{\mathcal{O}}_{Y}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem10.p1.2" class="ltx_p">has maximal rank.</p>
</div>
</div>
<div id="S4.Thmtheorem11" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem11.2" class="ltx_text ltx_font_bold">4.11</span></span><span id="S4.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem11.p1" class="ltx_para">
<p id="S4.Thmtheorem11.p1.1" class="ltx_p">Let <math id="S4.Thmtheorem11.p1.m1" class="ltx_Math" alttext="X=R_{1}\cup\ldots\cup R_{n}\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>n</mi></msub></mrow><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">X=R_{1}\cup\ldots\cup R_{n}\subset{\bf P}^{r}</annotation></semantics></math> be a maximally connected chain. The residual intersection with <math id="S4.Thmtheorem11.p1.m2" class="ltx_Math" alttext="R_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{i+1}</annotation></semantics></math>
of a quadric <math id="S4.Thmtheorem11.p1.m3" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> containing a link <math id="S4.Thmtheorem11.p1.m4" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math> is</p>
<table id="S4.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex41.m1" class="ltx_Math" alttext="\operatorname{res}_{R_{i+1}}(Q)=Q\cap R_{i+1}-R_{i}\cap R_{i+1}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>res</mi><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>Q</mi><mo>∩</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><msub><mi>R</mi><mi>i</mi></msub></mrow><mo>∩</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\operatorname{res}_{R_{i+1}}(Q)=Q\cap R_{i+1}-R_{i}\cap R_{i+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem11.p1.2" class="ltx_p">That is, the <math id="S4.Thmtheorem11.p1.m5" class="ltx_Math" alttext="r-2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r-2</annotation></semantics></math> points of intersection of <math id="S4.Thmtheorem11.p1.m6" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> with <math id="S4.Thmtheorem11.p1.m7" class="ltx_Math" alttext="R_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{i+1}</annotation></semantics></math> besides the <math id="S4.Thmtheorem11.p1.m8" class="ltx_Math" alttext="r+2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r+2</annotation></semantics></math> anchor points <math id="S4.Thmtheorem11.p1.m9" class="ltx_Math" alttext="R_{i}\cap R_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∩</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">R_{i}\cap R_{i+1}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.Thmtheorem12" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem12.2" class="ltx_text ltx_font_bold">4.12</span></span><span id="S4.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem12.p1" class="ltx_para">
<p id="S4.Thmtheorem12.p1.1" class="ltx_p">A maximally connected chain <math id="S4.Thmtheorem12.p1.m1" class="ltx_Math" alttext="R_{1}\cup\ldots\cup R_{n}\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>n</mi></msub></mrow><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">R_{1}\cup\ldots\cup R_{n}\subset{\bf P}^{r}</annotation></semantics></math> has <em id="S4.Thmtheorem12.p1.1.1" class="ltx_emph ltx_font_italic">transverse residues</em>
if either</p>
<ul id="S4.I2" class="ltx_itemize">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p"><math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> is even, or</p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p"><math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> is odd and
for any subchain <math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> of length <math id="S4.I2.i2.p1.m3" class="ltx_Math" alttext="r+2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r+2</annotation></semantics></math>,
there are no quadrics <math id="S4.I2.i2.p1.m4" class="ltx_Math" alttext="Q_{\text{left}},Q_{\text{right}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mtext>left</mtext></msub><mo>,</mo><msub><mi>Q</mi><mtext>right</mtext></msub></mrow><annotation encoding="application/x-tex">Q_{\text{left}},Q_{\text{right}}</annotation></semantics></math> satisfying</p>
<table id="S4.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex42.m1" class="ltx_Math" alttext="Y_{\text{left}}\subset Q_{\text{left}},\,Y_{\text{right}}\subset Q_{\text{right}}\text{ and }\operatorname{res}_{R_{\text{middle}}}(Q_{\text{left}})=\operatorname{res}_{R_{\text{middle}}}(Q_{\text{right}})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Y</mi><mtext>left</mtext></msub><mo>⊂</mo><msub><mi>Q</mi><mtext>left</mtext></msub></mrow><mo rspace="0.337em">,</mo><mrow><msub><mi>Y</mi><mtext>right</mtext></msub><mo>⊂</mo><mrow><msub><mi>Q</mi><mtext>right</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>res</mi><msub><mi>R</mi><mtext>middle</mtext></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mtext>left</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>res</mi><msub><mi>R</mi><mtext>middle</mtext></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mtext>right</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Y_{\text{left}}\subset Q_{\text{left}},\,Y_{\text{right}}\subset Q_{\text{right}}\text{ and }\operatorname{res}_{R_{\text{middle}}}(Q_{\text{left}})=\operatorname{res}_{R_{\text{middle}}}(Q_{\text{right}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I2.i2.p1.2" class="ltx_p">where</p>
<ul id="S4.I2.i2.I1" class="ltx_itemize">
<li id="S4.I2.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="S4.I2.i2.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="S4.I2.i2.I1.i1.p1" class="ltx_para">
<p id="S4.I2.i2.I1.i1.p1.1" class="ltx_p"><math id="S4.I2.i2.I1.i1.p1.m1" class="ltx_Math" alttext="Y_{\text{left}}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mtext>left</mtext></msub><annotation encoding="application/x-tex">Y_{\text{left}}</annotation></semantics></math> be the first <math id="S4.I2.i2.I1.i1.p1.m2" class="ltx_Math" alttext="\frac{r+1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{r+1}{2}</annotation></semantics></math> links of <math id="S4.I2.i2.I1.i1.p1.m3" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>,</p>
</div></li>
<li id="S4.I2.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="S4.I2.i2.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="S4.I2.i2.I1.i2.p1" class="ltx_para">
<p id="S4.I2.i2.I1.i2.p1.1" class="ltx_p"><math id="S4.I2.i2.I1.i2.p1.m1" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math> the middle rational curve, and</p>
</div></li>
<li id="S4.I2.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="S4.I2.i2.I1.i3.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="S4.I2.i2.I1.i3.p1" class="ltx_para">
<p id="S4.I2.i2.I1.i3.p1.1" class="ltx_p"><math id="S4.I2.i2.I1.i3.p1.m1" class="ltx_Math" alttext="Y_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">Y_{\text{right}}</annotation></semantics></math> the remaining <math id="S4.I2.i2.I1.i3.p1.m2" class="ltx_Math" alttext="\frac{r+1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{r+1}{2}</annotation></semantics></math> links.</p>
</div></li>
</ul>
</div></li>
</ul>
</div>
</div>
<div id="S4.Thmtheorem13" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem13.2" class="ltx_text ltx_font_italic">4.13</span></span><span id="S4.Thmtheorem13.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmtheorem13.p1" class="ltx_para">
<p id="S4.Thmtheorem13.p1.1" class="ltx_p">While contrived at first sight, having transverse residues simply reflects the expectation
that the naive dimension count goes through. Indeed, the pair of quadrics <math id="S4.Thmtheorem13.p1.m1" class="ltx_Math" alttext="Q_{\text{left}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mtext>left</mtext></msub><annotation encoding="application/x-tex">Q_{\text{left}}</annotation></semantics></math> and <math id="S4.Thmtheorem13.p1.m2" class="ltx_Math" alttext="Q_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">Q_{\text{right}}</annotation></semantics></math> has to satisfy</p>
<ul id="S4.I3" class="ltx_itemize">
<li id="S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I3.i1.p1" class="ltx_para">
<p id="S4.I3.i1.p1.1" class="ltx_p"><math id="S4.I3.i1.p1.m1" class="ltx_Math" alttext="(r+2)+(r-1)\frac{r+1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">(r+2)+(r-1)\frac{r+1}{2}</annotation></semantics></math> conditions for <math id="S4.I3.i1.p1.m2" class="ltx_Math" alttext="Y_{\text{left}}\subset Q_{\text{left}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mtext>left</mtext></msub><mo>⊂</mo><msub><mi>Q</mi><mtext>left</mtext></msub></mrow><annotation encoding="application/x-tex">Y_{\text{left}}\subset Q_{\text{left}}</annotation></semantics></math>, plus</p>
</div></li>
<li id="S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I3.i2.p1" class="ltx_para">
<p id="S4.I3.i2.p1.1" class="ltx_p"><math id="S4.I3.i2.p1.m1" class="ltx_Math" alttext="(r+2)+(r-1)\frac{r+1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">(r+2)+(r-1)\frac{r+1}{2}</annotation></semantics></math> conditions for <math id="S4.I3.i2.p1.m2" class="ltx_Math" alttext="Y_{\text{right}}\subset Q_{\text{right}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mtext>right</mtext></msub><mo>⊂</mo><msub><mi>Q</mi><mtext>right</mtext></msub></mrow><annotation encoding="application/x-tex">Y_{\text{right}}\subset Q_{\text{right}}</annotation></semantics></math>, plus</p>
</div></li>
<li id="S4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I3.i3.p1" class="ltx_para">
<p id="S4.I3.i3.p1.1" class="ltx_p"><math id="S4.I3.i3.p1.m1" class="ltx_Math" alttext="r-2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r-2</annotation></semantics></math> conditions for <math id="S4.I3.i3.p1.m2" class="ltx_Math" alttext="\operatorname{res}_{R_{\text{middle}}}(Q_{\text{left}})=\operatorname{res}_{R_{\text{middle}}}(Q_{\text{right}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>res</mi><msub><mi>R</mi><mtext>middle</mtext></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mtext>left</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>res</mi><msub><mi>R</mi><mtext>middle</mtext></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mtext>right</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{res}_{R_{\text{middle}}}(Q_{\text{left}})=\operatorname{res}_{R_{\text{middle}}}(Q_{\text{right}})</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="S4.Thmtheorem13.p1.2" class="ltx_p">We get a total of</p>
<table id="S4.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex43.m1" class="ltx_Math" alttext="2\times\left(r+2+(r-1)\frac{r+1}{2}\right)+r-2=r^{2}+3r+1=2\times\left(\binom{r+2}{2}-1\right)+1" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>(</mo><mrow><mi>r</mi><mo>+</mo><mn>2</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mi>r</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo>=</mo><mrow><msup><mi>r</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mn>2</mn></mfrac><mo>)</mo></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">2\times\left(r+2+(r-1)\frac{r+1}{2}\right)+r-2=r^{2}+3r+1=2\times\left(\binom{r+2}{2}-1\right)+1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem13.p1.3" class="ltx_p">conditions, which exceeds by one the dimensions available for choosing a pair of quadrics <math id="S4.Thmtheorem13.p1.m3" class="ltx_Math" alttext="(Q_{\text{left}},Q_{\text{right}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mtext>left</mtext></msub><mo>,</mo><msub><mi>Q</mi><mtext>right</mtext></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Q_{\text{left}},Q_{\text{right}})</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.p23" class="ltx_para">
<p id="S4.p23.1" class="ltx_p">We may detect if the admissible cover <math id="S4.p23.m1" class="ltx_Math" alttext="\alpha:X\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha:X\to{\bf P}_{a}</annotation></semantics></math> in <math id="S4.p23.m2" class="ltx_Math" alttext="\Sigma_{d,a}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>d</mi><mo>,</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{d,a}</annotation></semantics></math> has balanced
<math id="S4.p23.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle only using properties of the maximally connected <math id="S4.p23.m4" class="ltx_Math" alttext="f(\alpha)\in MC_{d-2,a}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mi>a</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)\in MC_{d-2,a}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem14" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem14.2" class="ltx_text ltx_font_bold">4.14</span></span><span id="S4.Thmtheorem14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem14.p1" class="ltx_para">
<p id="S4.Thmtheorem14.p1.1" class="ltx_p"><span id="S4.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">A cover <math id="S4.Thmtheorem14.p1.m1" class="ltx_Math" alttext="\alpha:X\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha:X\to{\bf P}_{a}</annotation></semantics></math> in <math id="S4.Thmtheorem14.p1.m2" class="ltx_Math" alttext="\Sigma_{d,a}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>d</mi><mo>,</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{d,a}</annotation></semantics></math> has balanced <math id="S4.Thmtheorem14.p1.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle if and only if
<math id="S4.Thmtheorem14.p1.m4" class="ltx_Math" alttext="f(\alpha)\in MC_{d-2,a}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mi>a</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)\in MC_{d-2,a}</annotation></semantics></math> is quadric-generic and has transverse residues.</span></p>
</div>
</div>
<div id="S4.p24" class="ltx_para">
<p id="S4.p24.1" class="ltx_p"><a href="#S4.Thmtheorem4" title="4.4. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.4</span></a> – and hence <a href="#S4.Thmtheorem1" title="4.1. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> – follows from
<a href="#S4.Thmtheorem9" title="4.9. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemmas</span> <span class="ltx_text ltx_ref_tag">4.9</span></a>, <a href="#S4.Thmtheorem14" title="4.14. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a> and <a href="#S4.Thmtheorem5" title="4.5. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.5</span></a> and the following claims, which will be proved in <a href="#S5" title="5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">section</span> <span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<div id="S4.Thmtheorem15" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem15.2" class="ltx_text ltx_font_bold">4.15</span></span><span id="S4.Thmtheorem15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem15.p1" class="ltx_para">
<p id="S4.Thmtheorem15.p1.1" class="ltx_p"><span id="S4.Thmtheorem15.p1.1.1" class="ltx_text ltx_font_italic">A general maximally connected chain is quadric-generic.</span></p>
</div>
</div>
<div id="S4.Thmtheorem16" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem16.2" class="ltx_text ltx_font_bold">4.16</span></span><span id="S4.Thmtheorem16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem16.p1" class="ltx_para">
<p id="S4.Thmtheorem16.p1.1" class="ltx_p"><span id="S4.Thmtheorem16.p1.1.1" class="ltx_text ltx_font_italic">A general maximally connected chain has transverse residues.</span></p>
</div>
</div>
<div id="S4.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S4.Thmtheorem14" title="4.14. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">4.14</span></a>.</h6>
<div id="S4.p25" class="ltx_para">
<p id="S4.p25.1" class="ltx_p"><span id="S4.p25.1.1" class="ltx_text">We will first translate the <math id="S4.p25.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle of <math id="S4.p25.m2" class="ltx_Math" alttext="\alpha:X\to{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha:X\to{\bf P}_{a}</annotation></semantics></math> into
the language of quadrics in <math id="S4.p25.m3" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math>, and then use <a href="#S3.Thmtheorem9" title="3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">3.9</span></a>
to translate the balancedness of <math id="S4.p25.m4" class="ltx_Math" alttext="F_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>α</mi></msub><annotation encoding="application/x-tex">F_{\alpha}</annotation></semantics></math> into the statement that <math id="S4.p25.m5" class="ltx_Math" alttext="f(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)</annotation></semantics></math> is quadric-generic and has transverse residues.</span></p>
</div>
<div id="S4.p26" class="ltx_para">
<p id="S4.p26.1" class="ltx_p"><span id="S4.p26.1.1" class="ltx_text">Start by recalling the geometric interpretation of the directrix of the <math id="S4.p26.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle for
genus zero covers.</span></p>
</div>
<div id="S4.Thmtheorem17" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem17.2" class="ltx_text ltx_font_bold">4.17</span></span><span id="S4.Thmtheorem17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem17.p1" class="ltx_para">
<p id="S4.Thmtheorem17.p1.1" class="ltx_p"><span id="S4.Thmtheorem17.p1.1.1" class="ltx_text ltx_font_italic">There is a map of vector bundles over <math id="S4.Thmtheorem17.p1.m1" class="ltx_Math" alttext="{\bf P}_{a}" display="inline" intent=":literal"><semantics><msub><mi>𝐏</mi><mi>a</mi></msub><annotation encoding="application/x-tex">{\bf P}_{a}</annotation></semantics></math>:</span></p>
<table id="S4.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex44.m1" class="ltx_Math" alttext="\Phi\colon F\to{\bf P}_{a}\times H^{0}({\bf P}^{d-2},\mathcal{O}_{{\bf P}^{d-2}}(2))" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>F</mi><mo stretchy="false">→</mo><mrow><mrow><msub><mi>𝐏</mi><mi>a</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>H</mi><mn>0</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi\colon F\to{\bf P}_{a}\times H^{0}({\bf P}^{d-2},\mathcal{O}_{{\bf P}^{d-2}}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem17.p1.2" class="ltx_p"><span id="S4.Thmtheorem17.p1.2.1" class="ltx_text ltx_font_italic">such that:</span></p>
</div>
<div id="S4.Thmtheorem17.p2" class="ltx_para">
<ol id="S4.I4" class="ltx_enumerate">
<li id="S4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I4.i1.p1" class="ltx_para">
<p id="S4.I4.i1.p1.1" class="ltx_p"><math id="S4.I4.i1.p1.m1" class="ltx_Math" alttext="\Phi_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Phi_{t}</annotation></semantics></math><span id="S4.I4.i1.p1.1.1" class="ltx_text ltx_font_italic"> sends the vector space </span><math id="S4.I4.i1.p1.m2" class="ltx_Math" alttext="F_{t}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>t</mi></msub><annotation encoding="application/x-tex">F_{t}</annotation></semantics></math><span id="S4.I4.i1.p1.1.2" class="ltx_text ltx_font_italic"> to the vector space of quadrics vanishing at the
</span><math id="S4.I4.i1.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math><span id="S4.I4.i1.p1.1.3" class="ltx_text ltx_font_italic"> points </span><math id="S4.I4.i1.p1.m4" class="ltx_Math" alttext="\alpha^{-1}(t)\subset X\subset{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\alpha^{-1}(t)\subset X\subset{\bf P}^{d-2}</annotation></semantics></math><span id="S4.I4.i1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I4.i2.p1" class="ltx_para">
<p id="S4.I4.i2.p1.1" class="ltx_p"><span id="S4.I4.i2.p1.1.1" class="ltx_text ltx_font_italic">For each component </span><math id="S4.I4.i2.p1.m1" class="ltx_Math" alttext="R_{i}\subset X" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>⊂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">R_{i}\subset X</annotation></semantics></math><span id="S4.I4.i2.p1.1.2" class="ltx_text ltx_font_italic">, the directrix </span><math id="S4.I4.i2.p1.m2" class="ltx_Math" alttext="W_{i}\subset F_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>i</mi></msub><mo>⊂</mo><msub><mi>F</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">W_{i}\subset F_{i}</annotation></semantics></math><span id="S4.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> maps under </span><math id="S4.I4.i2.p1.m3" class="ltx_Math" alttext="\Phi_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Phi_{t}</annotation></semantics></math><span id="S4.I4.i2.p1.1.4" class="ltx_text ltx_font_italic"> to the
vector space </span><math id="S4.I4.i2.p1.m4" class="ltx_Math" alttext="H^{0}(I_{R_{i}}(2))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><msub><mi>R</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}(I_{R_{i}}(2))</annotation></semantics></math><span id="S4.I4.i2.p1.1.5" class="ltx_text ltx_font_italic"> of quadrics containing the rational normal curve </span><math id="S4.I4.i2.p1.m5" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math><span id="S4.I4.i2.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.7.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p27" class="ltx_para">
<p id="S4.p27.1" class="ltx_p"><span id="S4.p27.1.1" class="ltx_text">This is contained in the proof of <a href="#S2.Thmtheorem7" title="2.7. ‣ 2.3. Covers of genus 
          
            0
          
         and 
          
            1
          
        . ‣ 2. Preliminaries ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2.7</span></a>, part <math id="S4.p27.m1" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.p28" class="ltx_para">
<p id="S4.p28.1" class="ltx_p"><span id="S4.p28.1.1" class="ltx_text">Our analysis now breaks up into two cases, depending on the parity of the degree <math id="S4.p28.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. Recall the language
of left and right flags introduced in <a href="#S3.SS1.SSS1" title="3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">section</span> <span class="ltx_text ltx_ref_tag">3.1.1</span></a>.</span></p>
</div>
<div id="S4.Thmtheorem18" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem18.2" class="ltx_text ltx_font_bold">4.18</span></span><span id="S4.Thmtheorem18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem18.p1" class="ltx_para">
<p id="S4.Thmtheorem18.p1.1" class="ltx_p"><span id="S4.Thmtheorem18.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem18.p1.m1" class="ltx_Math" alttext="\alpha:X\to{\bf P}_{a}\in\Sigma_{d,a}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>𝐏</mi><mi>a</mi></msub><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>d</mi><mo>,</mo><mi>a</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha:X\to{\bf P}_{a}\in\Sigma_{d,a}</annotation></semantics></math> be given. Assume that <math id="S4.Thmtheorem18.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is even and <math id="S4.Thmtheorem18.p1.m3" class="ltx_Math" alttext="f(\alpha)=R_{1}\cup\ldots\cup R_{a}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)=R_{1}\cup\ldots\cup R_{a}</annotation></semantics></math> is quadric-generic. For any node <math id="S4.Thmtheorem18.p1.m4" class="ltx_Math" alttext="p_{j}\in{\bf P}_{a}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>j</mi></msub><mo>∈</mo><msub><mi>𝐏</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">p_{j}\in{\bf P}_{a}</annotation></semantics></math>, the
left flag <math id="S4.Thmtheorem18.p1.m5" class="ltx_Math" alttext="L^{\bullet}_{j}=(L^{1}_{j}\subset L^{2}_{j}\subset\ldots\subset L^{k}_{j})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>L</mi><mi>j</mi><mn>1</mn></msubsup><mo>⊂</mo><msubsup><mi>L</mi><mi>j</mi><mn>2</mn></msubsup><mo>⊂</mo><mi mathvariant="normal">…</mi><mo>⊂</mo><msubsup><mi>L</mi><mi>j</mi><mi>k</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{\bullet}_{j}=(L^{1}_{j}\subset L^{2}_{j}\subset\ldots\subset L^{k}_{j})</annotation></semantics></math> of <math id="S4.Thmtheorem18.p1.m6" class="ltx_Math" alttext="F_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>α</mi></msub><annotation encoding="application/x-tex">F_{\alpha}</annotation></semantics></math> may be described as follows:</span></p>
<ol id="S4.I5" class="ltx_enumerate">
<li id="S4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I5.i1.p1" class="ltx_para">
<p id="S4.I5.i1.p1.1" class="ltx_p"><span id="S4.I5.i1.p1.1.1" class="ltx_text ltx_font_italic">The total space: </span><math id="S4.I5.i1.p1.m1" class="ltx_Math" alttext="L_{j}^{k}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mi>k</mi></msubsup><annotation encoding="application/x-tex">L_{j}^{k}</annotation></semantics></math><span id="S4.I5.i1.p1.1.2" class="ltx_text ltx_font_italic"> is the vector space of quadrics in </span><math id="S4.I5.i1.p1.m2" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math><span id="S4.I5.i1.p1.1.3" class="ltx_text ltx_font_italic"> containing the </span><math id="S4.I5.i1.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math><span id="S4.I5.i1.p1.1.4" class="ltx_text ltx_font_italic"> anchor
points over the </span><math id="S4.I5.i1.p1.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="S4.I5.i1.p1.1.5" class="ltx_text ltx_font_italic">-th node.</span></p>
</div></li>
<li id="S4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I5.i2.p1" class="ltx_para">
<p id="S4.I5.i2.p1.1" class="ltx_p"><math id="S4.I5.i2.p1.m1" class="ltx_Math" alttext="L_{j}^{k-l}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mrow><mi>k</mi><mo>−</mo><mi>l</mi></mrow></msubsup><annotation encoding="application/x-tex">L_{j}^{k-l}</annotation></semantics></math><span id="S4.I5.i2.p1.1.1" class="ltx_text ltx_font_italic"> is the vector space of quadrics in </span><math id="S4.I5.i2.p1.m2" class="ltx_Math" alttext="{\bf P}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝐏</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\bf P}^{d-2}</annotation></semantics></math><span id="S4.I5.i2.p1.1.2" class="ltx_text ltx_font_italic"> containing the sub-chain </span><math id="S4.I5.i2.p1.m3" class="ltx_Math" alttext="R_{j-l+1}\cup\ldots\cup R_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">R_{j-l+1}\cup\ldots\cup R_{j}</annotation></semantics></math><span id="S4.I5.i2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I5.i3.p1" class="ltx_para">
<p id="S4.I5.i3.p1.1" class="ltx_p"><span id="S4.I5.i3.p1.1.1" class="ltx_text ltx_font_italic">The codimension of </span><math id="S4.I5.i3.p1.m1" class="ltx_Math" alttext="L^{k-l}_{j}\subset L^{k}_{j}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mi>j</mi><mrow><mi>k</mi><mo>−</mo><mi>l</mi></mrow></msubsup><mo>⊂</mo><msubsup><mi>L</mi><mi>j</mi><mi>k</mi></msubsup></mrow><annotation encoding="application/x-tex">L^{k-l}_{j}\subset L^{k}_{j}</annotation></semantics></math><span id="S4.I5.i3.p1.1.2" class="ltx_text ltx_font_italic"> is </span><math id="S4.I5.i3.p1.m2" class="ltx_Math" alttext="l(d-3)" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">l(d-3)</annotation></semantics></math><span id="S4.I5.i3.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I5.i4.p1" class="ltx_para">
<p id="S4.I5.i4.p1.1" class="ltx_p"><span id="S4.I5.i4.p1.1.1" class="ltx_text ltx_font_italic">The length </span><math id="S4.I5.i4.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S4.I5.i4.p1.1.2" class="ltx_text ltx_font_italic"> of the flag </span><math id="S4.I5.i4.p1.m2" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math><span id="S4.I5.i4.p1.1.3" class="ltx_text ltx_font_italic"> is equal
to the minimum of </span><math id="S4.I5.i4.p1.m3" class="ltx_Math" alttext="j+1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j+1</annotation></semantics></math><span id="S4.I5.i4.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="S4.I5.i4.p1.m4" class="ltx_Math" alttext="\frac{d}{2}" display="inline" intent=":literal"><semantics><mfrac><mi>d</mi><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{d}{2}</annotation></semantics></math><span id="S4.I5.i4.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p29" class="ltx_para">
<p id="S4.p29.1" class="ltx_p"><span id="S4.p29.1.1" class="ltx_text">The proof is by induction on <math id="S4.p29.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>. For <math id="S4.p29.m2" class="ltx_Math" alttext="j=1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j=1</annotation></semantics></math>, the description above follows directly from the definition of the flag
and <a href="#S4.Thmtheorem17" title="4.17. ‣ Proof of . ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">4.17</span></a>.
Supposing the description is valid for <math id="S4.p29.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, we now prove its validity for <math id="S4.p29.m4" class="ltx_Math" alttext="j+1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j+1</annotation></semantics></math>.</span></p>
</div>
<div id="S4.p30" class="ltx_para">
<p id="S4.p30.1" class="ltx_p"><span id="S4.p30.1.1" class="ltx_text">The right hand modification of the flag <math id="S4.p30.m1" class="ltx_Math" alttext="L^{\bullet}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L^{\bullet}_{j}</annotation></semantics></math> consists of three types of spaces:</span></p>
<ul id="S4.I6" class="ltx_itemize">
<li id="S4.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I6.i1.p1" class="ltx_para">
<p id="S4.I6.i1.p1.1" class="ltx_p">Intersections of <math id="S4.I6.i1.p1.m1" class="ltx_Math" alttext="L^{k-l}_{j}:=\{\text{quadrics containing $R_{j-l+1},\ldots,R_{j}$}\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mi>j</mi><mrow><mi>k</mi><mo>−</mo><mi>l</mi></mrow></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>quadrics containing </mtext><mrow><msub><mi>R</mi><mrow><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>R</mi><mi>j</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">L^{k-l}_{j}:=\{\text{quadrics containing $R_{j-l+1},\ldots,R_{j}$}\}</annotation></semantics></math> with the directrix <math id="S4.I6.i1.p1.m2" class="ltx_Math" alttext="W_{j+1}:=\{\text{quadrics containing $R_{j+1}$}\}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>quadrics containing </mtext><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">W_{j+1}:=\{\text{quadrics containing $R_{j+1}$}\}.</annotation></semantics></math> That is, the quadrics containing the range
from <math id="S4.I6.i1.p1.m3" class="ltx_Math" alttext="R_{j-l+1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{j-l+1}</annotation></semantics></math> up to <math id="S4.I6.i1.p1.m4" class="ltx_Math" alttext="R_{j+1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{j+1}</annotation></semantics></math>. This has the expected dimension since <math id="S4.I6.i1.p1.m5" class="ltx_Math" alttext="f(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)</annotation></semantics></math> is quadric-generic.</p>
</div></li>
<li id="S4.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I6.i2.p1" class="ltx_para">
<p id="S4.I6.i2.p1.1" class="ltx_p">The directrix <math id="S4.I6.i2.p1.m1" class="ltx_Math" alttext="W_{j+1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">W_{j+1}</annotation></semantics></math> itself, that is, quadrics containing <math id="S4.I6.i2.p1.m2" class="ltx_Math" alttext="R_{j+1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{j+1}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I6.i3.p1" class="ltx_para">
<p id="S4.I6.i3.p1.1" class="ltx_p">The spans <math id="S4.I6.i3.p1.m1" class="ltx_Math" alttext="L^{i}_{j}+W_{j+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mi>j</mi><mi>i</mi></msubsup><mo>+</mo><msub><mi>W</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">L^{i}_{j}+W_{j+1}</annotation></semantics></math>. But these will all be equal to the total space
of quadrics containing the <math id="S4.I6.i3.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> anchor points. Indeed, <math id="S4.I6.i3.p1.m3" class="ltx_Math" alttext="W_{j+1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">W_{j+1}</annotation></semantics></math> has codimension <math id="S4.I6.i3.p1.m4" class="ltx_Math" alttext="d-3" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d-3</annotation></semantics></math>, and the smallest space <math id="S4.I6.i3.p1.m5" class="ltx_Math" alttext="L^{1}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">L^{1}_{j}</annotation></semantics></math>
has dimension at least <math id="S4.I6.i3.p1.m6" class="ltx_Math" alttext="d-3" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d-3</annotation></semantics></math>, by induction.
If the span <math id="S4.I6.i3.p1.m7" class="ltx_Math" alttext="W_{j+1}+L^{1}_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><msubsup><mi>L</mi><mi>j</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">W_{j+1}+L^{1}_{j}</annotation></semantics></math> were a proper subspace of <math id="S4.I6.i3.p1.m8" class="ltx_Math" alttext="F|_{p_{j+1}}" display="inline" intent=":literal"><semantics><msub><mrow><mi>F</mi><mo stretchy="false">|</mo></mrow><msub><mi>p</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><annotation encoding="application/x-tex">F|_{p_{j+1}}</annotation></semantics></math>, then the
intersection <math id="S4.I6.i3.p1.m9" class="ltx_Math" alttext="L^{1}_{j}\cap W_{j+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mi>j</mi><mn>1</mn></msubsup><mo>∩</mo><msub><mi>W</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">L^{1}_{j}\cap W_{j+1}</annotation></semantics></math> would have dimension larger than expected, which would violate being
quadric-generic.</p>
</div></li>
</ul>
<p id="S4.p30.2" class="ltx_p"><span id="S4.p30.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S4.p31" class="ltx_para">
<p id="S4.p31.1" class="ltx_p"><span id="S4.p31.1.1" class="ltx_text">From <a href="#S3.Thmtheorem9" title="3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">3.9</span></a> and <a href="#S4.Thmtheorem18" title="4.18. ‣ Proof of . ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">4.18</span></a> it follows straightforwardly that if <math id="S4.p31.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is even and <math id="S4.p31.m2" class="ltx_Math" alttext="f(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)</annotation></semantics></math> is quadric-generic
then <math id="S4.p31.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> has a balanced <math id="S4.p31.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle. Conversely, if <math id="S4.p31.m5" class="ltx_Math" alttext="f(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)</annotation></semantics></math> is not quadric-generic, it is easy to
see that the bundle of quadrics of <math id="S4.p31.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> does not have transverse-flags, and therefore is not balanced. This
settles <a href="#S4.Thmtheorem14" title="4.14. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">4.14</span></a> for even degrees <math id="S4.p31.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.</span></p>
</div>
<div id="S4.p32" class="ltx_para">
<p id="S4.p32.1" class="ltx_p"><span id="S4.p32.1.1" class="ltx_text">Here is the analogue of <a href="#S4.Thmtheorem18" title="4.18. ‣ Proof of . ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">4.18</span></a> for odd degrees.</span></p>
</div>
<div id="S4.Thmtheorem19" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem19.2" class="ltx_text ltx_font_bold">4.19</span></span><span id="S4.Thmtheorem19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem19.p1" class="ltx_para">
<p id="S4.Thmtheorem19.p1.1" class="ltx_p"><span id="S4.Thmtheorem19.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem19.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> be odd and <math id="S4.Thmtheorem19.p1.m2" class="ltx_Math" alttext="f(\alpha)=R_{1}\cup R_{2}\cup\ldots\cup R_{a}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>R</mi><mn>2</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>a</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)=R_{1}\cup R_{2}\cup\ldots\cup R_{a}</annotation></semantics></math> be quadric-generic and have transverse residues.
The elements of the left flag <math id="S4.Thmtheorem19.p1.m3" class="ltx_Math" alttext="L_{j}^{\bullet}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>j</mi><mo>∙</mo></msubsup><annotation encoding="application/x-tex">L_{j}^{\bullet}</annotation></semantics></math> are of the following form:</span></p>
<ol id="S4.I7" class="ltx_enumerate">
<li id="S4.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I7.i1.p1" class="ltx_para">
<p id="S4.I7.i1.p1.1" class="ltx_p"><span id="S4.I7.i1.p1.1.1" class="ltx_text ltx_font_italic">The total space: Quadrics containing the anchor points </span><math id="S4.I7.i1.p1.m1" class="ltx_Math" alttext="p_{1},\ldots,p_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">p_{1},\ldots,p_{d}</annotation></semantics></math><span id="S4.I7.i1.p1.1.2" class="ltx_text ltx_font_italic"> over the
</span><math id="S4.I7.i1.p1.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="S4.I7.i1.p1.1.3" class="ltx_text ltx_font_italic">-th node. This is a vector space of dimension </span><math id="S4.I7.i1.p1.m3" class="ltx_Math" alttext="d(d-3)/2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d(d-3)/2</annotation></semantics></math><span id="S4.I7.i1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I7.i2.p1" class="ltx_para">
<p id="S4.I7.i2.p1.1" class="ltx_p"><span id="S4.I7.i2.p1.1.1" class="ltx_text ltx_font_italic">Quadrics containing a subchain of rational curves
</span><math id="S4.I7.i2.p1.m1" class="ltx_Math" alttext="R_{j-l+1}\cup\ldots\cup R_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">R_{j-l+1}\cup\ldots\cup R_{j}</annotation></semantics></math><span id="S4.I7.i2.p1.1.2" class="ltx_text ltx_font_italic">. This has dimension </span><math id="S4.I7.i2.p1.m2" class="ltx_Math" alttext="(d-2l)\frac{d-3}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">(d-2l)\frac{d-3}{2}</annotation></semantics></math><span id="S4.I7.i2.p1.1.3" class="ltx_text ltx_font_italic">.
Note that </span><math id="S4.I7.i2.p1.m3" class="ltx_Math" alttext="l&lt;\frac{d}{2}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>&lt;</mo><mfrac><mi>d</mi><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">l&lt;\frac{d}{2}</annotation></semantics></math><span id="S4.I7.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I7.i3.p1" class="ltx_para">
<p id="S4.I7.i3.p1.1" class="ltx_p"><span id="S4.I7.i3.p1.1.1" class="ltx_text ltx_font_italic">Quadrics containing the subchain </span><math id="S4.I7.i3.p1.m1" class="ltx_Math" alttext="R_{j-l+1}\cup\ldots\cup R_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">R_{j-l+1}\cup\ldots\cup R_{j}</annotation></semantics></math><span id="S4.I7.i3.p1.1.2" class="ltx_text ltx_font_italic">, and whose
residual intersection with </span><math id="S4.I7.i3.p1.m2" class="ltx_Math" alttext="R_{j-l}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">R_{j-l}</annotation></semantics></math><span id="S4.I7.i3.p1.1.3" class="ltx_text ltx_font_italic"> is equal to the residual intersection of a quadric
containing the length </span><math id="S4.I7.i3.p1.m3" class="ltx_Math" alttext="\frac{d-1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{d-1}{2}</annotation></semantics></math><span id="S4.I7.i3.p1.1.4" class="ltx_text ltx_font_italic"> subchain
</span><math id="S4.I7.i3.p1.m4" class="ltx_Math" alttext="R_{j-l-\frac{d-1}{2}}\cup\ldots\cup R_{j-l-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>j</mi><mo>−</mo><mi>l</mi><mo>−</mo><mfrac><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mrow><mi>j</mi><mo>−</mo><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">R_{j-l-\frac{d-1}{2}}\cup\ldots\cup R_{j-l-1}</annotation></semantics></math><span id="S4.I7.i3.p1.1.5" class="ltx_text ltx_font_italic">. We will call this the </span><em id="S4.I7.i3.p1.1.6" class="ltx_emph">restriction condition on <math id="S4.I7.i3.p1.m5" class="ltx_Math" alttext="R_{j-l}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>j</mi><mo>−</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">R_{j-l}</annotation></semantics></math></em><span id="S4.I7.i3.p1.1.7" class="ltx_text ltx_font_italic">.
This flag element has dimension
</span><math id="S4.I7.i3.p1.m6" class="ltx_Math" alttext="(d-2l-1)\frac{d-3}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">(d-2l-1)\frac{d-3}{2}</annotation></semantics></math><span id="S4.I7.i3.p1.1.8" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.p33" class="ltx_para">
<p id="S4.p33.1" class="ltx_p"><span id="S4.p33.1.1" class="ltx_text">The proof is analogous to the proof of <a href="#S4.Thmtheorem18" title="4.18. ‣ Proof of . ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">4.18</span></a>.
The third case comes from the span construction.</span></p>
</div>
<div id="S4.p34" class="ltx_para">
<p id="S4.p34.1" class="ltx_p"><span id="S4.p34.1.1" class="ltx_text">To establish balancedness of the <math id="S4.p34.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle, <a href="#S3.Thmtheorem9" title="3.9. ‣ 3.1.1. The two natural filtrations at a node. ‣ 3.1. Directrices and Filtrations ‣ 3. Vector bundles on rational chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">3.9</span></a> tells us we need to establish transverse directrices.
This amounts to checking the following three conditions:</span></p>
<ul id="S4.I8" class="ltx_itemize">
<li id="S4.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I8.i1.p1" class="ltx_para">
<p id="S4.I8.i1.p1.1" class="ltx_p">The linear series of quadrics containing an arbitrary subchain <math id="S4.I8.i1.p1.m1" class="ltx_Math" alttext="R_{i}\cup\ldots\cup R_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">R_{i}\cup\ldots\cup R_{j}</annotation></semantics></math> has the expected dimension.
This follows from <math id="S4.I8.i1.p1.m2" class="ltx_Math" alttext="f(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)</annotation></semantics></math> being quadric-generic.</p>
</div></li>
<li id="S4.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I8.i2.p1" class="ltx_para">
<p id="S4.I8.i2.p1.1" class="ltx_p">The linear series of quadrics containing an arbitrary subchain <math id="S4.I8.i2.p1.m1" class="ltx_Math" alttext="R_{i}\cup\ldots\cup R_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">R_{i}\cup\ldots\cup R_{j}</annotation></semantics></math>
and satisfying the restriction condition on <math id="S4.I8.i2.p1.m2" class="ltx_Math" alttext="R_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{i-1}</annotation></semantics></math> has the expected dimension.
In many situations, this follows from being quadric-generic , since the restriction map</p>
<table id="S4.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex45.m1" class="ltx_Math" alttext="H^{0}({\bf P}^{n},{\mathcal{I}}_{R_{i}\cup\ldots\cup R_{j}}(2))\to H^{0}(R_{i-1},{\mathcal{I}}_{\text{anchor}}(2))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mi>n</mi></msup><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>anchor</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\bf P}^{n},{\mathcal{I}}_{R_{i}\cup\ldots\cup R_{j}}(2))\to H^{0}(R_{i-1},{\mathcal{I}}_{\text{anchor}}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I8.i2.p1.2" class="ltx_p">is surjective as long as the length of the range <math id="S4.I8.i2.p1.m3" class="ltx_Math" alttext="R_{i-1}\cup\ldots\cup R_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">R_{i-1}\cup\ldots\cup R_{j}</annotation></semantics></math> is at most equal to <math id="S4.I8.i2.p1.m4" class="ltx_Math" alttext="\frac{d-1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{d-1}{2}</annotation></semantics></math>. Indeed, the kernel corresponds to quadrics
containing the range from <math id="S4.I8.i2.p1.m5" class="ltx_Math" alttext="i-1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i-1</annotation></semantics></math> to <math id="S4.I8.i2.p1.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, which we know the dimension of by being quadric-generic.</p>
</div>
<div id="S4.I8.i2.p2" class="ltx_para">
<p id="S4.I8.i2.p2.1" class="ltx_p">The only extremal case to check is when the subchain <math id="S4.I8.i2.p2.m1" class="ltx_Math" alttext="R_{i}\cup\ldots\cup R_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">R_{i}\cup\ldots\cup R_{j}</annotation></semantics></math> has length
<math id="S4.I8.i2.p2.m2" class="ltx_Math" alttext="\frac{d-1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{d-1}{2}</annotation></semantics></math>. In this situation, the property we require is precisely having transverse residues (see <a href="#S4.Thmtheorem12" title="4.12. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">definition</span> <span class="ltx_text ltx_ref_tag">4.12</span></a>).</p>
</div></li>
<li id="S4.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I8.i3.p1" class="ltx_para">
<p id="S4.I8.i3.p1.1" class="ltx_p">The linear series of quadrics containing
an arbitrary subchain <math id="S4.I8.i3.p1.m1" class="ltx_Math" alttext="\bar{X}=R_{i}\cup\ldots\cup R_{j}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>=</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\bar{X}=R_{i}\cup\ldots\cup R_{j}</annotation></semantics></math> and satisfying the restriction condition
on both <math id="S4.I8.i3.p1.m2" class="ltx_Math" alttext="R_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{i-1}</annotation></semantics></math> and <math id="S4.I8.i3.p1.m3" class="ltx_Math" alttext="R_{j+1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{j+1}</annotation></semantics></math> has the expected dimension. Again, the restriction map</p>
<table id="S4.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex46.m1" class="ltx_Math" alttext="H^{0}({\bf P}^{n},{\mathcal{I}}_{R_{i}\cup\ldots\cup R_{j}}(2))\to H^{0}(R_{i-1},{\mathcal{I}}_{\text{anchor}}(2))\oplus H^{0}(R_{j+1},{\mathcal{I}}_{\text{anchor}}(2))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mi>n</mi></msup><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>anchor</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>anchor</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\bf P}^{n},{\mathcal{I}}_{R_{i}\cup\ldots\cup R_{j}}(2))\to H^{0}(R_{i-1},{\mathcal{I}}_{\text{anchor}}(2))\oplus H^{0}(R_{j+1},{\mathcal{I}}_{\text{anchor}}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I8.i3.p1.2" class="ltx_p">will be surjective for subchains <math id="S4.I8.i3.p1.m4" class="ltx_Math" alttext="\bar{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{X}</annotation></semantics></math> of length less than <math id="S4.I8.i3.p1.m5" class="ltx_Math" alttext="\frac{d-3}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{d-3}{2}</annotation></semantics></math>, since we can control
the dimension of the kernel by being quadric-generic. This implies that the restriction conditions on
<math id="S4.I8.i3.p1.m6" class="ltx_Math" alttext="R_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{i-1}</annotation></semantics></math> and <math id="S4.I8.i3.p1.m7" class="ltx_Math" alttext="R_{j+1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{j+1}</annotation></semantics></math> are independent.</p>
</div>
<div id="S4.I8.i3.p2" class="ltx_para">
<p id="S4.I8.i3.p2.1" class="ltx_p">On the other hand, if the length of the
subchain <math id="S4.I8.i3.p2.m1" class="ltx_Math" alttext="\bar{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{X}</annotation></semantics></math> is bigger than <math id="S4.I8.i3.p2.m2" class="ltx_Math" alttext="\frac{d-3}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{d-3}{2}</annotation></semantics></math>, there are no such quadrics by the previous item. Hence,
the only case left to consider is subchains <math id="S4.I8.i3.p2.m3" class="ltx_Math" alttext="\bar{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{X}</annotation></semantics></math> of length exactly <math id="S4.I8.i3.p2.m4" class="ltx_Math" alttext="\frac{d-3}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{d-3}{2}</annotation></semantics></math>.</p>
</div>
<div id="S4.I8.i3.p3" class="ltx_para">
<p id="S4.I8.i3.p3.1" class="ltx_p">In this case, let <math id="S4.I8.i3.p3.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be the space of quadrics containing <math id="S4.I8.i3.p3.m2" class="ltx_Math" alttext="\bar{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{X}</annotation></semantics></math> and satisfying the
restriction condition on <math id="S4.I8.i3.p3.m3" class="ltx_Math" alttext="R_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{i-1}</annotation></semantics></math>. The space <math id="S4.I8.i3.p3.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> has the expected dimension <math id="S4.I8.i3.p3.m5" class="ltx_Math" alttext="d-3" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d-3</annotation></semantics></math>, by the previous item.
Moreover, the restriction map</p>
<table id="S4.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex47.m1" class="ltx_Math" alttext="V\to H^{0}(R_{j+1},{\mathcal{I}}_{\text{anchor}}(2))" display="block" intent=":literal"><semantics><mrow><mi>V</mi><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>anchor</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V\to H^{0}(R_{j+1},{\mathcal{I}}_{\text{anchor}}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I8.i3.p3.2" class="ltx_p">is an isomorphism, since a non-zero kernel would violate having transverse residues. Therefore, the linear
series of quadrics containing the subchain <math id="S4.I8.i3.p3.m6" class="ltx_Math" alttext="R_{i}\cup\ldots\cup R_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">R_{i}\cup\ldots\cup R_{j}</annotation></semantics></math> and satisfying the restriction
condition on both <math id="S4.I8.i3.p3.m7" class="ltx_Math" alttext="R_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{i-1}</annotation></semantics></math> and <math id="S4.I8.i3.p3.m8" class="ltx_Math" alttext="R_{j+1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{j+1}</annotation></semantics></math> has the expected dimension, as we wanted to show.</p>
</div></li>
</ul>
<p id="S4.p34.2" class="ltx_p"><span id="S4.p34.2.1" class="ltx_text">Furthermore, the argument above shows that for odd degrees <math id="S4.p34.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, whenever <math id="S4.p34.m3" class="ltx_Math" alttext="f(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\alpha)</annotation></semantics></math> is quadric-generic and has transverse residues, the
<math id="S4.p34.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle of <math id="S4.p34.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is balanced. Conversely, if one of these conditions fail, we can show that the <math id="S4.p34.m6" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>-bundle does
not have transverse directrices, and therefore is not balanced.
This completes the proof of <a href="#S4.Thmtheorem14" title="4.14. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">4.14</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5. </span>The maximal rank problem for maximally connected chains</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">The previous section demonstrated that <a href="#S4.Thmtheorem15" title="4.15. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.15</span></a> and <a href="#S4.Thmtheorem16" title="4.16. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.16</span></a> were exactly what was necessary to conclude <a href="#S4.Thmtheorem1" title="4.1. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> (and the Main Theorem as a corollary).
In this section, we provide these necessary facts. The key result is the following.</p>
</div>
<div id="S5.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem1.2" class="ltx_text ltx_font_bold">5.1</span></span><span id="S5.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem1.p1" class="ltx_para">
<p id="S5.Thmtheorem1.p1.1" class="ltx_p"><span id="S5.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">For a general maximally connected chain <math id="S5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="X\in MC_{r,n}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">X\in MC_{r,n}</annotation></semantics></math>, the restriction map</span></p>
<table id="S5.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex48.m1" class="ltx_Math" alttext="\rho:H^{0}({\bf P}^{r},{\mathcal{O}}_{{\bf P}^{r}}(2))\to H^{0}(X,{\mathcal{O}}_{X}(2))" display="block" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐏</mi><mi>r</mi></msup><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:H^{0}({\bf P}^{r},{\mathcal{O}}_{{\bf P}^{r}}(2))\to H^{0}(X,{\mathcal{O}}_{X}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem1.p1.2" class="ltx_p"><span id="S5.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">has maximal rank.</span></p>
</div>
</div>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p">Note that <a href="#S4.Thmtheorem15" title="4.15. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.15</span></a> follows from <a href="#S5.Thmtheorem1" title="5.1. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>
and the fact that the forgetful map</p>
</div>
<div id="S5.p3" class="ltx_para">
<table id="S5.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex49.m1" class="ltx_Math" alttext="\operatorname{subchain}_{n_{1},n_{2}}:MC_{r,n}\to MC_{r,n_{2}-n_{1}+1}" display="block" intent=":literal"><semantics><mrow><msub><mi>subchain</mi><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>,</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mrow><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>−</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{subchain}_{n_{1},n_{2}}:MC_{r,n}\to MC_{r,n_{2}-n_{1}+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p3.1" class="ltx_p">sending <math id="S5.p3.m1" class="ltx_Math" alttext="R_{1}\cup\ldots\cup R_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">R_{1}\cup\ldots\cup R_{n}</annotation></semantics></math> to the subchain <math id="S5.p3.m2" class="ltx_Math" alttext="R_{n_{1}}\cup R_{n_{1}+1}\cup\ldots\cup R_{n_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><msub><mi>n</mi><mn>1</mn></msub></msub><mo>∪</mo><msub><mi>R</mi><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><msub><mi>n</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">R_{n_{1}}\cup R_{n_{1}+1}\cup\ldots\cup R_{n_{2}}</annotation></semantics></math> is dominant.</p>
</div>
<div id="S5.p4" class="ltx_para">
<p id="S5.p4.1" class="ltx_p">We will defer the proof of <a href="#S4.Thmtheorem16" title="4.16. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.16</span></a> to <a href="#S5.SS1" title="5.1. Transverse residues ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">section</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>, since the argument will seem more natural after studying the proof of <a href="#S5.Thmtheorem1" title="5.1. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>.</p>
</div>
<div id="S5.p5" class="ltx_para">
<p id="S5.p5.1" class="ltx_p">We can rephrase <a href="#S5.Thmtheorem1" title="5.1. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">5.1</span></a> as a way to determine how many quadrics contain a general maximally connected chain.</p>
</div>
<div id="S5.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem2.2" class="ltx_text ltx_font_bold">5.2</span></span><span id="S5.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem2.p1" class="ltx_para">
<p id="S5.Thmtheorem2.p1.1" class="ltx_p"><span id="S5.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">For any maximally connected chain <math id="S5.Thmtheorem2.p1.m1" class="ltx_Math" alttext="X\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">X\subset{\bf P}^{r}</annotation></semantics></math> with <math id="S5.Thmtheorem2.p1.m2" class="ltx_Math" alttext="r\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">r\geq 3</annotation></semantics></math>, we have</span></p>
<table id="S5.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex50.m1" class="ltx_Math" alttext="h^{0}({\mathcal{I}}_{X}(2))-h^{1}({\mathcal{I}}_{X}(2))=\frac{(r-1)(r+2-2n)}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{I}}_{X}(2))-h^{1}({\mathcal{I}}_{X}(2))=\frac{(r-1)(r+2-2n)}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.p6" class="ltx_para">
<p id="S5.p6.1" class="ltx_p"><span id="S5.p6.1.1" class="ltx_text">Consider the standard short exact sequence</span></p>
<table id="S5.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex51.m1" class="ltx_Math" alttext="0\to{\mathcal{I}}_{X}(2)\to{\mathcal{O}}_{{\bf P}^{r}}(2)\to{\mathcal{O}}_{X}(2)\to 0." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\to{\mathcal{I}}_{X}(2)\to{\mathcal{O}}_{{\bf P}^{r}}(2)\to{\mathcal{O}}_{X}(2)\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p6.2" class="ltx_p"><span id="S5.p6.2.1" class="ltx_text">Since <math id="S5.p6.m1" class="ltx_Math" alttext="H^{1}({\mathcal{O}}_{{\bf P}^{r}}(2))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{1}({\mathcal{O}}_{{\bf P}^{r}}(2))=0</annotation></semantics></math>, the long exact sequence gives</span></p>
<table id="S5.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex52.m1" class="ltx_Math" alttext="\displaystyle h^{0}({\mathcal{I}}_{X}(2))-h^{1}({\mathcal{I}}_{X}(2))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h^{0}({\mathcal{I}}_{X}(2))-h^{1}({\mathcal{I}}_{X}(2))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex52.m2" class="ltx_Math" alttext="\displaystyle=h^{0}({\mathcal{O}}_{{\bf P}^{r}}(2))-h^{0}({\mathcal{O}}_{X}(2))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=h^{0}({\mathcal{O}}_{{\bf P}^{r}}(2))-h^{0}({\mathcal{O}}_{X}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex53.m1" class="ltx_Math" alttext="\displaystyle=\binom{r+2}{2}-(2nr-(n-1)(r+1)+1)+h^{1}({\mathcal{O}}_{X}(2))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\binom{r+2}{2}-(2nr-(n-1)(r+1)+1)+h^{1}({\mathcal{O}}_{X}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex54.m1" class="ltx_Math" alttext="\displaystyle=\frac{(r-1)(r+2-2n)}{2}+h^{1}({\mathcal{O}}_{X}(2))." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(r-1)(r+2-2n)}{2}+h^{1}({\mathcal{O}}_{X}(2)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p6.3" class="ltx_p"><span id="S5.p6.3.1" class="ltx_text">We are left with showing that <math id="S5.p6.m2" class="ltx_Math" alttext="h^{1}({\mathcal{O}}_{X}(2))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{1}({\mathcal{O}}_{X}(2))=0</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p7" class="ltx_para">
<p id="S5.p7.1" class="ltx_p"><span id="S5.p7.1.1" class="ltx_text">By Serre duality,
<math id="S5.p7.m1" class="ltx_Math" alttext="h^{1}({\mathcal{O}}_{X}(2))=h^{0}(\omega_{X}(-2))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ω</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{1}({\mathcal{O}}_{X}(2))=h^{0}(\omega_{X}(-2))</annotation></semantics></math>. The line bundle <math id="S5.p7.m2" class="ltx_Math" alttext="\omega_{X}(-2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ω</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\omega_{X}(-2)</annotation></semantics></math>
has degree <math id="S5.p7.m3" class="ltx_Math" alttext="-r" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">-r</annotation></semantics></math> on <math id="S5.p7.m4" class="ltx_Math" alttext="R_{1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>1</mn></msub><annotation encoding="application/x-tex">R_{1}</annotation></semantics></math> and <math id="S5.p7.m5" class="ltx_Math" alttext="R_{n}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>n</mi></msub><annotation encoding="application/x-tex">R_{n}</annotation></semantics></math>, and degree <math id="S5.p7.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> on the other components.
Let <math id="S5.p7.m7" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> be a global section of <math id="S5.p7.m8" class="ltx_Math" alttext="\omega_{X}(-2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ω</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\omega_{X}(-2)</annotation></semantics></math>.
Since <math id="S5.p7.m9" class="ltx_Math" alttext="-r&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi>r</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-r&lt;0</annotation></semantics></math>, it vanishes on <math id="S5.p7.m10" class="ltx_Math" alttext="R_{1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>1</mn></msub><annotation encoding="application/x-tex">R_{1}</annotation></semantics></math>, and hence also on <math id="S5.p7.m11" class="ltx_Math" alttext="R_{1}\cap R_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>∩</mo><msub><mi>R</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">R_{1}\cap R_{2}</annotation></semantics></math>. So
the section restricted to <math id="S5.p7.m12" class="ltx_Math" alttext="R_{2}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>2</mn></msub><annotation encoding="application/x-tex">R_{2}</annotation></semantics></math> has at least <math id="S5.p7.m13" class="ltx_Math" alttext="r+2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r+2</annotation></semantics></math> zeros, but degree <math id="S5.p7.m14" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>. Hence it
vanishes identically on <math id="S5.p7.m15" class="ltx_Math" alttext="R_{2}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>2</mn></msub><annotation encoding="application/x-tex">R_{2}</annotation></semantics></math> as well, and so on for each component. Therefore, <math id="S5.p7.m16" class="ltx_Math" alttext="\sigma=0" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma=0</annotation></semantics></math>,
as we wanted to show.
∎</span></p>
</div>
</div>
<div id="S5.p8" class="ltx_para">
<p id="S5.p8.1" class="ltx_p">Taking <a href="#S5.Thmtheorem2" title="5.2. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">5.2</span></a> into account, <a href="#S5.Thmtheorem1" title="5.1. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">5.1</span></a> says that</p>
<table id="S5.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(14)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E14.m1" class="ltx_Math" alttext="h^{0}({\mathcal{I}}_{X}(2))=\begin{cases}0,\text{ if }n\geq\frac{r+2}{2},\\
\frac{(r-1)(r+2-2n)}{2},\text{ else.}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>0</mn><mo>,</mo><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>≥</mo><mstyle displaystyle="false"><mfrac><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="false"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo>,</mo><mtext> else.</mtext></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{I}}_{X}(2))=\begin{cases}0,\text{ if }n\geq\frac{r+2}{2},\\
\frac{(r-1)(r+2-2n)}{2},\text{ else.}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S5.Thmtheorem1" title="5.1. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>.</h6>
<div id="S5.p9" class="ltx_para">
<p id="S5.p9.1" class="ltx_p"><span id="S5.p9.1.1" class="ltx_text">We will use induction on the ambient dimension <math id="S5.p9.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. The base case <math id="S5.p9.m2" class="ltx_Math" alttext="r=3" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">r=3</annotation></semantics></math> translates into the following three simple facts:</span></p>
<ul id="S5.I1" class="ltx_itemize">
<li id="S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I1.i1.p1" class="ltx_para">
<p id="S5.I1.i1.p1.1" class="ltx_p">A twisted cubic is contained in a three dimensional linear system of quadrics.</p>
</div></li>
<li id="S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I1.i2.p1" class="ltx_para">
<p id="S5.I1.i2.p1.1" class="ltx_p">There is a unique quadric containing a pair of twisted cubics meeting at five points.</p>
</div></li>
<li id="S5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I1.i3.p1" class="ltx_para">
<p id="S5.I1.i3.p1.1" class="ltx_p">By picking the third link <math id="S5.I1.i3.p1.m1" class="ltx_Math" alttext="R_{3}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>3</mn></msub><annotation encoding="application/x-tex">R_{3}</annotation></semantics></math> generically, the resulting length 3 maximally connected chain <math id="S5.I1.i3.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> of twisted cubics is not contained in any quadric.</p>
</div></li>
</ul>
</div>
<figure id="S5.F5" class="ltx_figure"><span id="S5.F5.pic1" class="ltx_picture ltx_centering" style="width:296.31pt;height:346.89953373180003pt;"></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5. </span>The maximally connected chain <math id="S5.F5.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> used in the induction argument.</figcaption>
</figure>
<div id="S5.p10" class="ltx_para">
<p id="S5.p10.1" class="ltx_p"><span id="S5.p10.1.1" class="ltx_text">For the induction step, we use the following key construction suggested to us by Eric Larson:</span></p>
</div>
<div id="S5.Thmtheorem3" class="ltx_theorem ltx_theorem_construction">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem3.2" class="ltx_text ltx_font_italic">5.3</span></span><span id="S5.Thmtheorem3.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S5.Thmtheorem3.p1" class="ltx_para">
<p id="S5.Thmtheorem3.p1.1" class="ltx_p"><math id="S5.Thmtheorem3.p1.m1" class="ltx_Math" alttext="X=C\cup\overline{X}=R_{0}\cup R_{1}\cup\ldots\cup R_{n-1}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><mi>C</mi><mo>∪</mo><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover></mrow><mo>=</mo><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>R</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>R</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">X=C\cup\overline{X}=R_{0}\cup R_{1}\cup\ldots\cup R_{n-1}</annotation></semantics></math> is a maximally connected chain, constructed as follows.</p>
<ul id="S5.I2" class="ltx_itemize">
<li id="S5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i1.p1" class="ltx_para">
<p id="S5.I2.i1.p1.1" class="ltx_p">Take <math id="S5.I2.i1.p1.m1" class="ltx_Math" alttext="R_{0}\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">R_{0}\subset{\bf P}^{r}</annotation></semantics></math> a smooth rational normal curve.</p>
</div></li>
<li id="S5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i2.p1" class="ltx_para">
<p id="S5.I2.i2.p1.1" class="ltx_p">Choose a general hyperplane <math id="S5.I2.i2.p1.m1" class="ltx_Math" alttext="H\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">H\subset{\bf P}^{r}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i3.p1" class="ltx_para">
<p id="S5.I2.i3.p1.1" class="ltx_p">Let <math id="S5.I2.i3.p1.m1" class="ltx_Math" alttext="L_{1}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>1</mn></msub><annotation encoding="application/x-tex">L_{1}</annotation></semantics></math> be a general 2-secant line to <math id="S5.I2.i3.p1.m2" class="ltx_Math" alttext="R_{0}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>0</mn></msub><annotation encoding="application/x-tex">R_{0}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i4.p1" class="ltx_para">
<p id="S5.I2.i4.p1.1" class="ltx_p">Let <math id="S5.I2.i4.p1.m1" class="ltx_Math" alttext="\overline{R}_{1}\subset H" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>⊂</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">\overline{R}_{1}\subset H</annotation></semantics></math> be a rational normal curve (of degree <math id="S5.I2.i4.p1.m2" class="ltx_Math" alttext="r-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r-1</annotation></semantics></math>) containing the <math id="S5.I2.i4.p1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> points <math id="S5.I2.i4.p1.m4" class="ltx_Math" alttext="R_{0}\cap H" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∩</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">R_{0}\cap H</annotation></semantics></math> and the point <math id="S5.I2.i4.p1.m5" class="ltx_Math" alttext="p:=L_{1}\cap H" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>:=</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>∩</mo><mi>H</mi></mrow></mrow><annotation encoding="application/x-tex">p:=L_{1}\cap H</annotation></semantics></math>. Set <math id="S5.I2.i4.p1.m6" class="ltx_math_unparsed" alttext="R_{1}=L_{1}\cup_{p}\overline{R}_{1}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><msub><mrow></mrow><mn>1</mn></msub><mo>=</mo><mi>L</mi><msub><mrow></mrow><mn>1</mn></msub><mo>∪</mo><msub><mrow></mrow><mi>p</mi></msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">R_{1}=L_{1}\cup_{p}\overline{R}_{1}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I2.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i5.p1" class="ltx_para">
<p id="S5.I2.i5.p1.1" class="ltx_p">Inductively, choose <math id="S5.I2.i5.p1.m1" class="ltx_Math" alttext="\overline{R}_{i+1}\subset H" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>⊂</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">\overline{R}_{i+1}\subset H</annotation></semantics></math> a general rational normal curve meeting <math id="S5.I2.i5.p1.m2" class="ltx_Math" alttext="\overline{R}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\overline{R}_{i}</annotation></semantics></math> in
<math id="S5.I2.i5.p1.m3" class="ltx_Math" alttext="r+1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r+1</annotation></semantics></math> general points. That is, the curve <math id="S5.I2.i5.p1.m4" class="ltx_Math" alttext="\overline{X}:=\overline{R}_{1}\cup\overline{R}_{2}\cup\ldots\cup\overline{R}_{n-1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>:=</mo><mrow><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>∪</mo><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\overline{X}:=\overline{R}_{1}\cup\overline{R}_{2}\cup\ldots\cup\overline{R}_{n-1}</annotation></semantics></math> is a maximally connected chain of length <math id="S5.I2.i5.p1.m5" class="ltx_Math" alttext="n-1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n-1</annotation></semantics></math> in <math id="S5.I2.i5.p1.m6" class="ltx_Math" alttext="H={\bf P}^{r-1}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><msup><mi>𝐏</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">H={\bf P}^{r-1}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I2.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i6.p1" class="ltx_para">
<p id="S5.I2.i6.p1.1" class="ltx_p">Inductively choose <math id="S5.I2.i6.p1.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> to be a general line joining <math id="S5.I2.i6.p1.m2" class="ltx_Math" alttext="L_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">L_{i-1}</annotation></semantics></math> and <math id="S5.I2.i6.p1.m3" class="ltx_Math" alttext="\overline{R}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\overline{R}_{i}</annotation></semantics></math>. Set
<math id="S5.I2.i6.p1.m4" class="ltx_Math" alttext="R_{i}=L_{i}\cup\overline{R}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>∪</mo><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">R_{i}=L_{i}\cup\overline{R}_{i}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I2.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i7.p1" class="ltx_para">
<p id="S5.I2.i7.p1.1" class="ltx_p">Let <math id="S5.I2.i7.p1.m1" class="ltx_Math" alttext="C=R_{0}\cup L_{1}\cup L_{2}\cup\ldots\cup L_{n-1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>2</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>L</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">C=R_{0}\cup L_{1}\cup L_{2}\cup\ldots\cup L_{n-1}</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="S5.Thmtheorem3.p1.2" class="ltx_p">See <a href="#S5.F5" title="In Proof of . ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">fig.</span> <span class="ltx_text ltx_ref_tag">5</span></a> for a diagrammatic representation of this construction.</p>
</div>
</div>
<div id="S5.p11" class="ltx_para">
<p id="S5.p11.1" class="ltx_p"><span id="S5.p11.1.1" class="ltx_text">We will show that <math id="S5.p11.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> as above satisfies the maximal rank condition for quadrics. That is, we will show:</span></p>
<ul id="S5.I3" class="ltx_itemize">
<li id="S5.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I3.i1.p1" class="ltx_para">
<p id="S5.I3.i1.p1.1" class="ltx_p">If <math id="S5.I3.i1.p1.m1" class="ltx_Math" alttext="n&gt;\frac{r+2}{2}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&gt;</mo><mfrac><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">n&gt;\frac{r+2}{2}</annotation></semantics></math>, then there are no quadrics containing <math id="S5.I3.i1.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I3.i2.p1" class="ltx_para">
<p id="S5.I3.i2.p1.1" class="ltx_p">Otherwise there is a <math id="S5.I3.i2.p1.m1" class="ltx_Math" alttext="\frac{(r-1)(r+2-2n)}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{(r-1)(r+2-2n)}{2}</annotation></semantics></math> dimensional space of quadrics containing <math id="S5.I3.i2.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="S5.p11.2" class="ltx_p"><span id="S5.p11.2.1" class="ltx_text">We do this by looking at the sequence</span></p>
<table id="S5.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex55.m1" class="ltx_Math" alttext="0\to{\mathcal{O}}_{{\bf P}^{r}}(1)={\mathcal{I}}_{H}(2)\to{\mathcal{O}}_{{\bf P}^{r}}(2)\to{\mathcal{O}}_{H}(2)\to 0" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">0\to{\mathcal{O}}_{{\bf P}^{r}}(1)={\mathcal{I}}_{H}(2)\to{\mathcal{O}}_{{\bf P}^{r}}(2)\to{\mathcal{O}}_{H}(2)\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p11.3" class="ltx_p"><span id="S5.p11.3.1" class="ltx_text">and tensoring it with <math id="S5.p11.m2" class="ltx_Math" alttext="{\mathcal{I}}_{X}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>X</mi></msub><annotation encoding="application/x-tex">{\mathcal{I}}_{X}</annotation></semantics></math> to get</span></p>
<table id="S5.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(15)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E15.m1" class="ltx_Math" alttext="0\to{\mathcal{I}}_{C\subset{\bf P}^{r}}(1)\to{\mathcal{I}}_{X\subset{\bf P}^{r}}(2)\to{\mathcal{I}}_{\overline{X}\subset H}(2)\to 0." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>C</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\to{\mathcal{I}}_{C\subset{\bf P}^{r}}(1)\to{\mathcal{I}}_{X\subset{\bf P}^{r}}(2)\to{\mathcal{I}}_{\overline{X}\subset H}(2)\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p11.4" class="ltx_p"><span id="S5.p11.4.1" class="ltx_text">By induction we know that <math id="S5.p11.m3" class="ltx_Math" alttext="\overline{X}\subset H" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">\overline{X}\subset H</annotation></semantics></math> satisfies the maximal rank condition, and
the sequence (<a href="#S5.E15" title="Equation 15 ‣ Proof of . ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) will let us understand the quadrics containing <math id="S5.p11.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</span></p>
</div>
</div>
<section id="S5.SS0.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">The case <math id="S5.SS0.SSSx1.m1" class="ltx_Math" alttext="n&gt;\frac{r+2}{2}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&gt;</mo><mfrac><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">n&gt;\frac{r+2}{2}</annotation></semantics></math></h4>

<div id="S5.SS0.SSSx1.p1" class="ltx_para">
<p id="S5.SS0.SSSx1.p1.1" class="ltx_p">Then <math id="S5.SS0.SSSx1.p1.m1" class="ltx_Math" alttext="n-1\geq\frac{(r-1)+2}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>≥</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">n-1\geq\frac{(r-1)+2}{2}</annotation></semantics></math> and by induction and (<a href="#S5.E14" title="Equation 14 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), we can assume that
<math id="S5.SS0.SSSx1.p1.m2" class="ltx_Math" alttext="h^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))=0</annotation></semantics></math>. Hence,</p>
<table id="S5.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex56.m1" class="ltx_Math" alttext="h^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))=h^{0}({\mathcal{I}}_{C\subset{\bf P}^{r}}(1))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>C</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))=h^{0}({\mathcal{I}}_{C\subset{\bf P}^{r}}(1))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS0.SSSx1.p1.2" class="ltx_p">and the latter is zero, since <math id="S5.SS0.SSSx1.p1.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is not contained in any hyperplane (the component <math id="S5.SS0.SSSx1.p1.m4" class="ltx_Math" alttext="R_{0}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>0</mn></msub><annotation encoding="application/x-tex">R_{0}</annotation></semantics></math> is non-degenerate). Hence, <math id="S5.SS0.SSSx1.p1.m5" class="ltx_Math" alttext="h^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))=0</annotation></semantics></math>, as we wanted to show.</p>
</div>
</section>
<section id="S5.SS0.SSSx2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">The case <math id="S5.SS0.SSSx2.m1" class="ltx_Math" alttext="n\leq\frac{r+2}{2}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mfrac><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">n\leq\frac{r+2}{2}</annotation></semantics></math></h4>

<div id="S5.SS0.SSSx2.p1" class="ltx_para">
<p id="S5.SS0.SSSx2.p1.1" class="ltx_p">We have <math id="S5.SS0.SSSx2.p1.m1" class="ltx_Math" alttext="n-1&lt;\frac{(r-1)+2}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>&lt;</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">n-1&lt;\frac{(r-1)+2}{2}</annotation></semantics></math>, and by induction
we can assume</p>
<table id="S5.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex57.m1" class="ltx_Math" alttext="h^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))=\frac{(r-2)(r+3-2n)}{2}=\frac{(r-1)(r+2-2n)}{2}+n-2." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>h</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>+</mo><mn>3</mn></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo>=</mo><mrow><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo>+</mo><mi>n</mi></mrow><mo>−</mo><mn>2</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))=\frac{(r-2)(r+3-2n)}{2}=\frac{(r-1)(r+2-2n)}{2}+n-2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS0.SSSx2.p1.2" class="ltx_p">Hence, we want to show that the inclusion</p>
<table id="S5.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(16)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E16.m1" class="ltx_Math" alttext="H^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))\subset H^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))\subset H^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS0.SSSx2.p1.3" class="ltx_p">has codimension <math id="S5.SS0.SSSx2.p1.m2" class="ltx_Math" alttext="n-2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n-2</annotation></semantics></math>. The inclusion (<a href="#S5.E16" title="Equation 16 ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) factors as</p>
<table id="S5.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(17)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E17.m1" class="ltx_Math" alttext="H^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))\subset H^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))\subset H^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS0.SSSx2.p1.4" class="ltx_p">and the latter inclusion is actually an isomorphism, since it fits in the sequence</p>
<table id="S5.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex58.m1" class="ltx_Math" alttext="H^{0}({\mathcal{I}}_{R_{0}\cup L_{1}}(1))\to H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))\to H^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))\to H^{1}({\mathcal{I}}_{R_{0}\cup L_{1}}(1))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{I}}_{R_{0}\cup L_{1}}(1))\to H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))\to H^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))\to H^{1}({\mathcal{I}}_{R_{0}\cup L_{1}}(1))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS0.SSSx2.p1.5" class="ltx_p">where the first and last groups vanish, as deduced from the sequence</p>
<table id="S5.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S5.Ex59.m1.pic1" class="ltx_picture ltx_markedasmath" height="68.19" overflow="visible" style="vertical-align:-56.23358883137886px" version="1.1" viewBox="7.61 56.23 459.61 68.19" width="459.61"><g transform="matrix(1 0 0 -1 7.610350076103501 68.18879833356036) translate(0,3.46) translate(7.61,0)"><g transform="translate(-7.61,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex59.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{0\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\textstyle{0\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 7.610371189690138 -0.27673578005007266 L 7.610371189690138 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(40.82,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 7.610371189690138 -0.27673578005007266 L 40.819150408191504 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 40.819150408191504 -0.27673578005007266 L 40.819150408191504 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(40.82,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.3em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;f