ss="ltx_foreignobject_content"><math id="S5.Ex59.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{H^{0}({\mathcal{O}}_{R_{0}\cup L_{1}}(1))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H^{0}({\mathcal{O}}_{R_{0}\cup L_{1}}(1))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 309.2244381691487 -8.405910020582537 L 309.2244381691487 -8.531852564871748" fill="none" stroke="#000000"></path><g transform="translate(136.32,0) translate(0,-37.24)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.28 -1.6" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 6.37 3.86" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 309.2244381691487 -8.405910020582537 L 136.3202310522282 -37.23666036839932" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 136.3202310522282 -37.11069671052347 L 136.3202310522282 -37.23666036839932" fill="none" stroke="#000000"></path><g transform="translate(40.82,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.3em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="87.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex59.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{H^{1}({\mathcal{I}}_{R_{0}\cup L_{1}}(1))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H^{1}({\mathcal{I}}_{R_{0}\cup L_{1}}(1))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 136.3202310522282 -45.44072450073293 L 136.3202310522282 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(169.53,0) translate(0,-45.16)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 136.3202310522282 -45.44072450073293 L 169.52901027072954 -44.887252940632784" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 169.52901027072954 -45.44072450073293 L 169.52901027072954 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(169.53,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.1em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="98.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex59.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{H^{1}({\mathcal{O}}_{{\bf P}^{r}}(1))=0}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\textstyle{H^{1}({\mathcal{O}}_{{\bf P}^{r}}(1))=0}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS0.SSSx2.p1.6" class="ltx_p">and the fact that the map <math id="S5.SS0.SSSx2.p1.m3" class="ltx_Math" alttext="H^{0}({\mathcal{O}}_{{\bf P}^{r}}(1))\to H^{0}({\mathcal{O}}_{R_{0}\cup L_{1}}(1))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><msup><mi>𝐏</mi><mi>r</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{O}}_{{\bf P}^{r}}(1))\to H^{0}({\mathcal{O}}_{R_{0}\cup L_{1}}(1))</annotation></semantics></math> is an isomorphism (in other words, <math id="S5.SS0.SSSx2.p1.m4" class="ltx_Math" alttext="R_{0}\cup L_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">R_{0}\cup L_{1}</annotation></semantics></math> is linearly
normal, i.e., it is embedded with the full linear series).</p>
</div>
<div id="S5.SS0.SSSx2.p2" class="ltx_para">
<p id="S5.SS0.SSSx2.p2.1" class="ltx_p">So we have translated our problem into showing that the first inclusion in (<a href="#S5.E17" title="Equation 17 ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>),
that is <math id="S5.SS0.SSSx2.p2.m1" class="ltx_Math" alttext="H^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{I}}_{X\subset{\bf P}^{r}}(2))\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))</annotation></semantics></math>,
has codimension <math id="S5.SS0.SSSx2.p2.m2" class="ltx_Math" alttext="n-2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n-2</annotation></semantics></math>. But this factors naturally in a sequence of <math id="S5.SS0.SSSx2.p2.m3" class="ltx_Math" alttext="n-2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n-2</annotation></semantics></math> inclusions:</p>
<table id="S5.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(18)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E18.m1" class="ltx_Math" alttext="\begin{split}H^{0}({\mathcal{I}}_{X}(2))=H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\cup L_{2}\cup\ldots L_{n-1}}(2))&amp;\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\cup L_{2}\cup\ldots\cup L_{n-2}}(2))\\
&amp;\subset\ldots\\
&amp;\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\cup L_{2}}(2))\\
&amp;\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>2</mn></msub><mo>∪</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>⊂</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>2</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>L</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>⊂</mo><mi mathvariant="normal">…</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>⊂</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>2</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>⊂</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}H^{0}({\mathcal{I}}_{X}(2))=H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\cup L_{2}\cup\ldots L_{n-1}}(2))&amp;\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\cup L_{2}\cup\ldots\cup L_{n-2}}(2))\\
&amp;\subset\ldots\\
&amp;\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\cup L_{2}}(2))\\
&amp;\subset H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.SS0.SSSx2.p3" class="ltx_para">
<p id="S5.SS0.SSSx2.p3.1" class="ltx_p">So it is enough to show the following.</p>
</div>
<div id="S5.Thmtheorem4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem4.2" class="ltx_text ltx_font_bold">5.4</span></span><span id="S5.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem4.p1" class="ltx_para">
<p id="S5.Thmtheorem4.p1.1" class="ltx_p"><span id="S5.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Each inclusion in (<a href="#S5.E18" title="Equation 18 ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) is strict.
In other words,
for each <math id="S5.Thmtheorem4.p1.m1" class="ltx_Math" alttext="i=2,\ldots,n-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=2,\ldots,n-1</annotation></semantics></math>, there exists a quadric containing
<math id="S5.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\overline{X}\cup R_{0}\cup L_{1}\cup\ldots\cup L_{i-1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mi>L</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{X}\cup R_{0}\cup L_{1}\cup\ldots\cup L_{i-1}</annotation></semantics></math>,
which does not contain the line <math id="S5.Thmtheorem4.p1.m3" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS0.SSSx2.p4" class="ltx_para">
<p id="S5.SS0.SSSx2.p4.1" class="ltx_p">We establish <a href="#S5.Thmtheorem4" title="5.4. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">5.4</span></a> below, completing the proof of
<a href="#S5.Thmtheorem1" title="5.1. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>.
∎</p>
</div>
<div id="S5.SS0.SSSx2.p5" class="ltx_para">
<p id="S5.SS0.SSSx2.p5.1" class="ltx_p">The key lemma needed for the proof of <a href="#S5.Thmtheorem4" title="5.4. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">5.4</span></a> is the following:</p>
</div>
<div id="S5.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem5.2" class="ltx_text ltx_font_bold">5.5</span></span><span id="S5.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem5.p1" class="ltx_para">
<p id="S5.Thmtheorem5.p1.1" class="ltx_p"><span id="S5.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmtheorem5.p1.m1" class="ltx_Math" alttext="L\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">L\subset{\bf P}^{r}</annotation></semantics></math> be a line, and <math id="S5.Thmtheorem5.p1.m2" class="ltx_Math" alttext="H\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">H\subset{\bf P}^{r}</annotation></semantics></math> a
hyperplane transverse to <math id="S5.Thmtheorem5.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, and <math id="S5.Thmtheorem5.p1.m4" class="ltx_Math" alttext="R\subset H" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⊂</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">R\subset H</annotation></semantics></math> a rational normal curve.
Let <math id="S5.Thmtheorem5.p1.m5" class="ltx_Math" alttext="V\subset H^{0}({\mathcal{I}}_{L\cup R}(2))" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⊂</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>L</mi><mo>∪</mo><mi>R</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V\subset H^{0}({\mathcal{I}}_{L\cup R}(2))</annotation></semantics></math> be a non-empty linear
series. Assume:</span></p>
<ol id="S5.I4" class="ltx_enumerate">
<li id="S5.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S5.I4.i1.p1" class="ltx_para">
<p id="S5.I4.i1.p1.1" class="ltx_p"><span id="S5.I4.i1.p1.1.1" class="ltx_text ltx_font_italic">no element of </span><math id="S5.I4.i1.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math><span id="S5.I4.i1.p1.1.2" class="ltx_text ltx_font_italic"> is a reducible quadric containing </span><math id="S5.I4.i1.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="S5.I4.i1.p1.1.3" class="ltx_text ltx_font_italic">,</span></p>
</div></li>
<li id="S5.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S5.I4.i2.p1" class="ltx_para">
<p id="S5.I4.i2.p1.1" class="ltx_p"><span id="S5.I4.i2.p1.1.1" class="ltx_text ltx_font_italic">the general element </span><math id="S5.I4.i2.p1.m1" class="ltx_Math" alttext="Q_{\text{gen}}\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mtext class="ltx_mathvariant_italic">gen</mtext></msub><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">Q_{\text{gen}}\subset{\bf P}^{r}</annotation></semantics></math><span id="S5.I4.i2.p1.1.2" class="ltx_text ltx_font_italic"> of </span><math id="S5.I4.i2.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math><span id="S5.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> is such that
</span><math id="S5.I4.i2.p1.m3" class="ltx_Math" alttext="L\not\subset\Sing Q_{\text{gen}}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊄</mo><mrow><mi>Sing</mi><mo lspace="0.167em">⁡</mo><msub><mi>Q</mi><mtext class="ltx_mathvariant_italic">gen</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">L\not\subset\Sing Q_{\text{gen}}</annotation></semantics></math><span id="S5.I4.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S5.Thmtheorem5.p1.2" class="ltx_p"><span id="S5.Thmtheorem5.p1.2.1" class="ltx_text ltx_font_italic">Then for general choices of <math id="S5.Thmtheorem5.p1.m6" class="ltx_Math" alttext="p\in L" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">p\in L</annotation></semantics></math> and <math id="S5.Thmtheorem5.p1.m7" class="ltx_Math" alttext="q\in R" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">q\in R</annotation></semantics></math>:</span></p>
<ul id="S5.I5" class="ltx_itemize">
<li id="S5.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I5.i1.p1" class="ltx_para">
<p id="S5.I5.i1.p1.1" class="ltx_p"><span id="S5.I5.i1.p1.1.1" class="ltx_text ltx_font_italic">The line </span><math id="S5.I5.i1.p1.m1" class="ltx_Math" alttext="L_{\text{gen}}=\overline{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mtext class="ltx_mathvariant_italic">gen</mtext></msub><mo>=</mo><mover accent="true"><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">L_{\text{gen}}=\overline{pq}</annotation></semantics></math><span id="S5.I5.i1.p1.1.2" class="ltx_text ltx_font_italic">
is not contained in </span><math id="S5.I5.i1.p1.m2" class="ltx_Math" alttext="Q_{\text{gen}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mtext class="ltx_mathvariant_italic">gen</mtext></msub><annotation encoding="application/x-tex">Q_{\text{gen}}</annotation></semantics></math><span id="S5.I5.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S5.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I5.i2.p1" class="ltx_para">
<p id="S5.I5.i2.p1.1" class="ltx_p"><span id="S5.I5.i2.p1.1.1" class="ltx_text ltx_font_italic">Among the quadrics </span><math id="S5.I5.i2.p1.m1" class="ltx_Math" alttext="Q\in V" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">Q\in V</annotation></semantics></math><span id="S5.I5.i2.p1.1.2" class="ltx_text ltx_font_italic"> containing
</span><math id="S5.I5.i2.p1.m2" class="ltx_Math" alttext="L_{\text{gen}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mtext class="ltx_mathvariant_italic">gen</mtext></msub><annotation encoding="application/x-tex">L_{\text{gen}}</annotation></semantics></math><span id="S5.I5.i2.p1.1.3" class="ltx_text ltx_font_italic">, a general one does not contain </span><math id="S5.I5.i2.p1.m3" class="ltx_Math" alttext="L_{\text{gen}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mtext class="ltx_mathvariant_italic">gen</mtext></msub><annotation encoding="application/x-tex">L_{\text{gen}}</annotation></semantics></math><span id="S5.I5.i2.p1.1.4" class="ltx_text ltx_font_italic"> in its singular locus.</span></p>
</div></li>
</ul>
</div>
</div>
<div id="S5.SS0.SSSx2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S5.Thmtheorem4" title="5.4. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">5.4</span></a> assuming <a href="#S5.Thmtheorem5" title="5.5. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">5.5</span></a>.</h6>
<div id="S5.SS0.SSSx2.p6" class="ltx_para">
<p id="S5.SS0.SSSx2.p6.1" class="ltx_p"><span id="S5.SS0.SSSx2.p6.1.1" class="ltx_text">We want to show that each inclusion in (<a href="#S5.E18" title="Equation 18 ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) is strict.
Let us start with the last one. We set <math id="S5.SS0.SSSx2.p6.m1" class="ltx_Math" alttext="V=H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V=H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}}(2))</annotation></semantics></math>, <math id="S5.SS0.SSSx2.p6.m2" class="ltx_Math" alttext="L=L_{1}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">L=L_{1}</annotation></semantics></math>, and
<math id="S5.SS0.SSSx2.p6.m3" class="ltx_Math" alttext="R=\overline{R}_{2}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">R=\overline{R}_{2}</annotation></semantics></math>. None of the elements of <math id="S5.SS0.SSSx2.p6.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> are reducible quadrics, because they contain the non-degenerate curve <math id="S5.SS0.SSSx2.p6.m5" class="ltx_Math" alttext="R_{0}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>0</mn></msub><annotation encoding="application/x-tex">R_{0}</annotation></semantics></math>. Thus, condition <a href="#S5.I4.i1" title="Item (a) ‣ 5.5. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(a)</span></a> is met.</span></p>
</div>
<div id="S5.SS0.SSSx2.p7" class="ltx_para">
<p id="S5.SS0.SSSx2.p7.1" class="ltx_p"><span id="S5.SS0.SSSx2.p7.1.1" class="ltx_text">Let us check that the general quadric in <math id="S5.SS0.SSSx2.p7.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is not singular all along
<math id="S5.SS0.SSSx2.p7.m2" class="ltx_Math" alttext="L_{1}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>1</mn></msub><annotation encoding="application/x-tex">L_{1}</annotation></semantics></math>. It is enough to show that the restriction
of the quadric to <math id="S5.SS0.SSSx2.p7.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is smooth at <math id="S5.SS0.SSSx2.p7.m4" class="ltx_Math" alttext="L_{1}\cap H" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>∩</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">L_{1}\cap H</annotation></semantics></math>. The restriction of the linear system
<math id="S5.SS0.SSSx2.p7.m5" class="ltx_Math" alttext="H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\subset{\bf P}^{r}}(2))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\subset{\bf P}^{r}}(2))</annotation></semantics></math> to <math id="S5.SS0.SSSx2.p7.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is
<math id="S5.SS0.SSSx2.p7.m7" class="ltx_Math" alttext="H^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{I}}_{\overline{X}\subset H}(2))</annotation></semantics></math>, which only depends on <math id="S5.SS0.SSSx2.p7.m8" class="ltx_Math" alttext="\overline{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{X}</annotation></semantics></math>. The general quadric in <math id="S5.SS0.SSSx2.p7.m9" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> containing <math id="S5.SS0.SSSx2.p7.m10" class="ltx_Math" alttext="\overline{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{X}</annotation></semantics></math> cannot be singular all along <math id="S5.SS0.SSSx2.p7.m11" class="ltx_Math" alttext="\overline{R}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\overline{R}_{1}</annotation></semantics></math>, because
<math id="S5.SS0.SSSx2.p7.m12" class="ltx_Math" alttext="\overline{R}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\overline{R}_{1}</annotation></semantics></math> is a non-degenerate curve in <math id="S5.SS0.SSSx2.p7.m13" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, and the singular locus of a quadric is always a linear space. Hence, as long as we pick <math id="S5.SS0.SSSx2.p7.m14" class="ltx_Math" alttext="L_{1}\cap H" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>∩</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">L_{1}\cap H</annotation></semantics></math> to be a general point in <math id="S5.SS0.SSSx2.p7.m15" class="ltx_Math" alttext="\overline{R}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\overline{R}_{1}</annotation></semantics></math>, we will be fine. We can do this, as a matter of fact in <a href="#S5.Thmtheorem3" title="5.3. ‣ Proof of . ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a> we may first choose <math id="S5.SS0.SSSx2.p7.m16" class="ltx_Math" alttext="\overline{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{X}</annotation></semantics></math> and any <math id="S5.SS0.SSSx2.p7.m17" class="ltx_Math" alttext="r+1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r+1</annotation></semantics></math> distinct points in <math id="S5.SS0.SSSx2.p7.m18" class="ltx_Math" alttext="\overline{R}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\overline{R}_{1}</annotation></semantics></math>, and then we can find an <math id="S5.SS0.SSSx2.p7.m19" class="ltx_Math" alttext="L_{1}\cup R_{0}\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">L_{1}\cup R_{0}\subset{\bf P}^{r}</annotation></semantics></math>
meeting <math id="S5.SS0.SSSx2.p7.m20" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> exactly at these points.</span></p>
</div>
<div id="S5.SS0.SSSx2.p8" class="ltx_para">
<p id="S5.SS0.SSSx2.p8.1" class="ltx_p"><span id="S5.SS0.SSSx2.p8.1.1" class="ltx_text">The hypotheses of <a href="#S5.Thmtheorem5" title="5.5. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">5.5</span></a> are satisfied, so its conclusion says that
for a general choice of <math id="S5.SS0.SSSx2.p8.m1" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math>, the inclusion (<a href="#S5.E18" title="Equation 18 ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) will be strict.</span></p>
</div>
<div id="S5.SS0.SSSx2.p9" class="ltx_para">
<p id="S5.SS0.SSSx2.p9.1" class="ltx_p"><span id="S5.SS0.SSSx2.p9.1.1" class="ltx_text">Moreover, <a href="#S5.Thmtheorem5" title="5.5. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">5.5</span></a> also says that a general quadric in
<math id="S5.SS0.SSSx2.p9.m1" class="ltx_Math" alttext="H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\cup L_{2}}(2))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mo>∪</mo><msub><mi>R</mi><mn>0</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>L</mi><mn>2</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{I}}_{\overline{X}\cup R_{0}\cup L_{1}\cup L_{2}}(2))</annotation></semantics></math> is not singular all along <math id="S5.SS0.SSSx2.p9.m2" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math>. Thus we conclude <a href="#S5.Thmtheorem4" title="5.4. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">5.4</span></a> by iteratively applying <a href="#S5.Thmtheorem5" title="5.5. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">5.5</span></a>.</span></p>
</div>
<div id="S5.SS0.SSSx2.p10" class="ltx_para">
<p id="S5.SS0.SSSx2.p10.1" class="ltx_p"><span id="S5.SS0.SSSx2.p10.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S5.SS0.SSSx2.p11" class="ltx_para">
<p id="S5.SS0.SSSx2.p11.1" class="ltx_p">Hence, we will be done with the proof of <a href="#S5.Thmtheorem1" title="5.1. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">5.1</span></a> as soon as
we establish <a href="#S5.Thmtheorem5" title="5.5. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">5.5</span></a>.</p>
</div>
<div id="S5.SS0.SSSx2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S5.Thmtheorem5" title="5.5. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">5.5</span></a>.</h6>
<div id="S5.SS0.SSSx2.p12" class="ltx_para">
<p id="S5.SS0.SSSx2.p12.1" class="ltx_p"><span id="S5.SS0.SSSx2.p12.1.1" class="ltx_text">For the first part, assume that <math id="S5.SS0.SSSx2.p12.m1" class="ltx_Math" alttext="L_{\text{gen}}\subset Q_{\text{gen}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mtext>gen</mtext></msub><mo>⊂</mo><msub><mi>Q</mi><mtext>gen</mtext></msub></mrow><annotation encoding="application/x-tex">L_{\text{gen}}\subset Q_{\text{gen}}</annotation></semantics></math>. Then <math id="S5.SS0.SSSx2.p12.m2" class="ltx_Math" alttext="Q_{\text{gen}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mtext>gen</mtext></msub><annotation encoding="application/x-tex">Q_{\text{gen}}</annotation></semantics></math> contains
the join <math id="S5.SS0.SSSx2.p12.m3" class="ltx_Math" alttext="J(L,R)" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(L,R)</annotation></semantics></math>. But the tangent space to <math id="S5.SS0.SSSx2.p12.m4" class="ltx_Math" alttext="J(L,R)" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(L,R)</annotation></semantics></math> at <math id="S5.SS0.SSSx2.p12.m5" class="ltx_Math" alttext="p\in L" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">p\in L</annotation></semantics></math>
is <math id="S5.SS0.SSSx2.p12.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>-dimensional, because the cone <math id="S5.SS0.SSSx2.p12.m7" class="ltx_Math" alttext="C_{p}R" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">C_{p}R</annotation></semantics></math> with vertex <math id="S5.SS0.SSSx2.p12.m8" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> over <math id="S5.SS0.SSSx2.p12.m9" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is contained in
<math id="S5.SS0.SSSx2.p12.m10" class="ltx_Math" alttext="J(L,R)" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(L,R)</annotation></semantics></math>. Hence, <math id="S5.SS0.SSSx2.p12.m11" class="ltx_Math" alttext="Q_{\text{gen}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mtext>gen</mtext></msub><annotation encoding="application/x-tex">Q_{\text{gen}}</annotation></semantics></math> is singular along <math id="S5.SS0.SSSx2.p12.m12" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> as well, but we assumed this was not the case – contradiction.</span></p>
</div>
<div id="S5.SS0.SSSx2.p13" class="ltx_para">
<p id="S5.SS0.SSSx2.p13.1" class="ltx_p"><span id="S5.SS0.SSSx2.p13.1.1" class="ltx_text">Now let us show that among the quadrics in <math id="S5.SS0.SSSx2.p13.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> containing <math id="S5.SS0.SSSx2.p13.m2" class="ltx_Math" alttext="L_{\text{gen}}=\overline{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mtext>gen</mtext></msub><mo>=</mo><mover accent="true"><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">L_{\text{gen}}=\overline{pq}</annotation></semantics></math>, a general
one does not contain <math id="S5.SS0.SSSx2.p13.m3" class="ltx_Math" alttext="L_{\text{gen}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mtext>gen</mtext></msub><annotation encoding="application/x-tex">L_{\text{gen}}</annotation></semantics></math> in its singular locus. Pick <math id="S5.SS0.SSSx2.p13.m4" class="ltx_Math" alttext="p\in L" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">p\in L</annotation></semantics></math> such that
the general element of <math id="S5.SS0.SSSx2.p13.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is not singular at <math id="S5.SS0.SSSx2.p13.m6" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> (this can be done by our assumption). Now there are two cases.</span></p>
<dl id="S5.I6" class="ltx_description">
<dt id="S5.I6.ix1" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="S5.I6.ix1.1" class="ltx_text ltx_font_bold">Case 1: </span></span></dt>
<dd class="ltx_item">
<div id="S5.I6.ix1.p1" class="ltx_para">
<p id="S5.I6.ix1.p1.1" class="ltx_p">One possibility is that as we vary <math id="S5.I6.ix1.p1.m1" class="ltx_Math" alttext="q\in R" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">q\in R</annotation></semantics></math>, we get a non-trivial family of
hyperplanes consisting of quadrics in <math id="S5.I6.ix1.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> containing <math id="S5.I6.ix1.p1.m3" class="ltx_Math" alttext="\overline{pq}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{pq}</annotation></semantics></math>. But then the union of these hyperplanes
is the whole vector space <math id="S5.I6.ix1.p1.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, and we know that the general quadric in <math id="S5.I6.ix1.p1.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is smooth at <math id="S5.I6.ix1.p1.m6" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>. Hence, it is smooth
at the general point of the line <math id="S5.I6.ix1.p1.m7" class="ltx_Math" alttext="\overline{pq}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{pq}</annotation></semantics></math> as well.</p>
</div></dd>
<dt id="S5.I6.ix2" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="S5.I6.ix2.1" class="ltx_text ltx_font_bold">Case 2: </span></span></dt>
<dd class="ltx_item">
<div id="S5.I6.ix2.p1" class="ltx_para">
<p id="S5.I6.ix2.p1.1" class="ltx_p">Otherwise, every quadric in <math id="S5.I6.ix2.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> containing <math id="S5.I6.ix2.p1.m2" class="ltx_Math" alttext="\overline{pq}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{pq}</annotation></semantics></math> also contains the cone <math id="S5.I6.ix2.p1.m3" class="ltx_Math" alttext="C_{p}R" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">C_{p}R</annotation></semantics></math>.
Pick any of these quadrics, <math id="S5.I6.ix2.p1.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>. Then <math id="S5.I6.ix2.p1.m5" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> cannot be singular all along <math id="S5.I6.ix2.p1.m6" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, because the
singular locus of <math id="S5.I6.ix2.p1.m7" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is a linear space, and <math id="S5.I6.ix2.p1.m8" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> spans the hyperplane <math id="S5.I6.ix2.p1.m9" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. Hence, for some
<math id="S5.I6.ix2.p1.m10" class="ltx_Math" alttext="q\in R" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">q\in R</annotation></semantics></math>, the quadric <math id="S5.I6.ix2.p1.m11" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is smooth at <math id="S5.I6.ix2.p1.m12" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. Take the line <math id="S5.I6.ix2.p1.m13" class="ltx_Math" alttext="\overline{pq}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{pq}</annotation></semantics></math> which is contained in <math id="S5.I6.ix2.p1.m14" class="ltx_Math" alttext="C_{p}R" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">C_{p}R</annotation></semantics></math>, and hence in <math id="S5.I6.ix2.p1.m15" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>. As <math id="S5.I6.ix2.p1.m16" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is smooth at <math id="S5.I6.ix2.p1.m17" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, it is smooth at the general point of
<math id="S5.I6.ix2.p1.m18" class="ltx_Math" alttext="\overline{pq}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{pq}</annotation></semantics></math>.</p>
</div></dd>
</dl>
<p id="S5.SS0.SSSx2.p13.2" class="ltx_p"><span id="S5.SS0.SSSx2.p13.2.1" class="ltx_text">In any case, we still conclude <a href="#S5.Thmtheorem5" title="5.5. ‣ The case 
          
            
              ≤
              n
              
                
                
                  +
                  r
                  2
                
                2 ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">5.5</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1. </span>Transverse residues</h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">We now adapt <a href="#S5.Thmtheorem3" title="5.3. ‣ Proof of . ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a> to prove <a href="#S4.Thmtheorem16" title="4.16. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.16</span></a>.</p>
</div>
<div id="S5.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S4.Thmtheorem16" title="4.16. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.16</span></a>.</h6>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.1" class="ltx_p"><span id="S5.SS1.p2.1.1" class="ltx_text">From now on the ambient dimension <math id="S5.SS1.p2.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> will be odd. We want to show that a general maximally connected chain <math id="S5.SS1.p2.m2" class="ltx_Math" alttext="X\subset{\bf P}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊂</mo><msup><mi>𝐏</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">X\subset{\bf P}^{r}</annotation></semantics></math> of length <math id="S5.SS1.p2.m3" class="ltx_Math" alttext="r+2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r+2</annotation></semantics></math> has transverse residues, as in <a href="#S4.Thmtheorem12" title="4.12. ‣ 4. Balanced 
        
          F
        
      -bundles and a maximal rank problem ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">definition</span> <span class="ltx_text ltx_ref_tag">4.12</span></a>. This means we
partition <math id="S5.SS1.p2.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> in three groups: the middle link <math id="S5.SS1.p2.m5" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math>, and the <math id="S5.SS1.p2.m6" class="ltx_Math" alttext="\frac{r+1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{r+1}{2}</annotation></semantics></math> links coming before (<math id="S5.SS1.p2.m7" class="ltx_Math" alttext="X_{\text{left}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mtext>left</mtext></msub><annotation encoding="application/x-tex">X_{\text{left}}</annotation></semantics></math>) and after (<math id="S5.SS1.p2.m8" class="ltx_Math" alttext="X_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">X_{\text{right}}</annotation></semantics></math>) it. We want to show that a pair of
quadrics <math id="S5.SS1.p2.m9" class="ltx_Math" alttext="Q_{\text{left}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mtext>left</mtext></msub><annotation encoding="application/x-tex">Q_{\text{left}}</annotation></semantics></math> and <math id="S5.SS1.p2.m10" class="ltx_Math" alttext="Q_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">Q_{\text{right}}</annotation></semantics></math> containing <math id="S5.SS1.p2.m11" class="ltx_Math" alttext="X_{\text{left}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mtext>left</mtext></msub><annotation encoding="application/x-tex">X_{\text{left}}</annotation></semantics></math> and <math id="S5.SS1.p2.m12" class="ltx_Math" alttext="X_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">X_{\text{right}}</annotation></semantics></math> respectively cannot have the same residual intersections with <math id="S5.SS1.p2.m13" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p3" class="ltx_para">
<p id="S5.SS1.p3.1" class="ltx_p"><span id="S5.SS1.p3.1.1" class="ltx_text">It is enough to exhibit a single example of such an <math id="S5.SS1.p3.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Consider an <math id="S5.SS1.p3.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with the following properties:</span></p>
<ul id="S5.I7" class="ltx_itemize">
<li id="S5.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I7.i1.p1" class="ltx_para">
<p id="S5.I7.i1.p1.1" class="ltx_p"><math id="S5.I7.i1.p1.m1" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math> is a smooth rational normal curve</p>
</div></li>
<li id="S5.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I7.i2.p1" class="ltx_para">
<p id="S5.I7.i2.p1.1" class="ltx_p"><math id="S5.I7.i2.p1.m1" class="ltx_Math" alttext="R_{\text{middle}}\cup X_{\text{right}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mtext>middle</mtext></msub><mo>∪</mo><msub><mi>X</mi><mtext>right</mtext></msub></mrow><annotation encoding="application/x-tex">R_{\text{middle}}\cup X_{\text{right}}</annotation></semantics></math> and <math id="S5.I7.i2.p1.m2" class="ltx_Math" alttext="X_{\text{left}}\cup R_{\text{middle}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mtext>left</mtext></msub><mo>∪</mo><msub><mi>R</mi><mtext>middle</mtext></msub></mrow><annotation encoding="application/x-tex">X_{\text{left}}\cup R_{\text{middle}}</annotation></semantics></math> are exactly as in <a href="#S5.Thmtheorem3" title="5.3. ‣ Proof of . ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a>. That is, to construct <math id="S5.I7.i2.p1.m3" class="ltx_Math" alttext="X_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">X_{\text{right}}</annotation></semantics></math>, choose a hyperplane <math id="S5.I7.i2.p1.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and let <math id="S5.I7.i2.p1.m5" class="ltx_Math" alttext="R_{i}=L_{i}\cup\overline{R}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>∪</mo><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">R_{i}=L_{i}\cup\overline{R}_{i}</annotation></semantics></math>, where:</p>
<ul id="S5.I7.i2.I1" class="ltx_itemize">
<li id="S5.I7.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="S5.I7.i2.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="S5.I7.i2.I1.i1.p1" class="ltx_para">
<p id="S5.I7.i2.I1.i1.p1.1" class="ltx_p"><math id="S5.I7.i2.I1.i1.p1.m1" class="ltx_Math" alttext="L_{1}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>1</mn></msub><annotation encoding="application/x-tex">L_{1}</annotation></semantics></math> is a general secant line to <math id="S5.I7.i2.I1.i1.p1.m2" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math></p>
</div></li>
<li id="S5.I7.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="S5.I7.i2.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="S5.I7.i2.I1.i2.p1" class="ltx_para">
<p id="S5.I7.i2.I1.i2.p1.1" class="ltx_p"><math id="S5.I7.i2.I1.i2.p1.m1" class="ltx_Math" alttext="\overline{R}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\overline{R}_{1}</annotation></semantics></math> is a general rational normal curve in the hyperplane <math id="S5.I7.i2.I1.i2.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> containing <math id="S5.I7.i2.I1.i2.p1.m3" class="ltx_Math" alttext="R_{\text{middle}}\cap H" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mtext>middle</mtext></msub><mo>∩</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">R_{\text{middle}}\cap H</annotation></semantics></math> and <math id="S5.I7.i2.I1.i2.p1.m4" class="ltx_Math" alttext="L_{1}\cap H" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>∩</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">L_{1}\cap H</annotation></semantics></math></p>
</div></li>
<li id="S5.I7.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="S5.I7.i2.I1.i3.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="S5.I7.i2.I1.i3.p1" class="ltx_para">
<p id="S5.I7.i2.I1.i3.p1.1" class="ltx_p"><math id="S5.I7.i2.I1.i3.p1.m1" class="ltx_Math" alttext="\overline{R}_{1}\cup\overline{R}_{2}\cup\overline{R}_{3}\cup\ldots\cup\overline{R}_{\frac{r+1}{2}}\subset H" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>1</mn></msub><mo>∪</mo><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>2</mn></msub><mo>∪</mo><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mn>3</mn></msub><mo>∪</mo><mi mathvariant="normal">…</mi><mo>∪</mo><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></msub></mrow><mo>⊂</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">\overline{R}_{1}\cup\overline{R}_{2}\cup\overline{R}_{3}\cup\ldots\cup\overline{R}_{\frac{r+1}{2}}\subset H</annotation></semantics></math> form a
general maximally connected chain in <math id="S5.I7.i2.I1.i3.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I7.i2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="S5.I7.i2.I1.i4.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="S5.I7.i2.I1.i4.p1" class="ltx_para">
<p id="S5.I7.i2.I1.i4.p1.1" class="ltx_p"><math id="S5.I7.i2.I1.i4.p1.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> is a general line joining <math id="S5.I7.i2.I1.i4.p1.m2" class="ltx_Math" alttext="L_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">L_{i-1}</annotation></semantics></math> and <math id="S5.I7.i2.I1.i4.p1.m3" class="ltx_Math" alttext="\overline{R}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\overline{R}_{i}</annotation></semantics></math> for <math id="S5.I7.i2.I1.i4.p1.m4" class="ltx_Math" alttext="i=2,\ldots,\frac{r+1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">i=2,\ldots,\frac{r+1}{2}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div></li>
</ul>
</div>
<div id="S5.SS1.p4" class="ltx_para">
<p id="S5.SS1.p4.1" class="ltx_p"><span id="S5.SS1.p4.1.1" class="ltx_text">We claim that such a curve <math id="S5.SS1.p4.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has transverse residues. Let <math id="S5.SS1.p4.m2" class="ltx_Math" alttext="\Lambda_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">\Lambda_{\text{right}}</annotation></semantics></math> be the linear span of <math id="S5.SS1.p4.m3" class="ltx_Math" alttext="L_{1},L_{2},\ldots,L_{\frac{r+1}{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>,</mo><msub><mi>L</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>L</mi><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></msub></mrow><annotation encoding="application/x-tex">L_{1},L_{2},\ldots,L_{\frac{r+1}{2}}</annotation></semantics></math>. Any quadric containing <math id="S5.SS1.p4.m4" class="ltx_Math" alttext="X_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">X_{\text{right}}</annotation></semantics></math> must split as <math id="S5.SS1.p4.m5" class="ltx_Math" alttext="H\cup H_{\text{right}}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>∪</mo><msub><mi>H</mi><mtext>right</mtext></msub></mrow><annotation encoding="application/x-tex">H\cup H_{\text{right}}</annotation></semantics></math>, where <math id="S5.SS1.p4.m6" class="ltx_Math" alttext="H_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">H_{\text{right}}</annotation></semantics></math> is a hyperplane containing <math id="S5.SS1.p4.m7" class="ltx_Math" alttext="\Lambda_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">\Lambda_{\text{right}}</annotation></semantics></math>. Otherwise, the restriction of such quadric to <math id="S5.SS1.p4.m8" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> would contain a general maximally connected chain of length <math id="S5.SS1.p4.m9" class="ltx_Math" alttext="\frac{r+1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{r+1}{2}</annotation></semantics></math>, which <a href="#S5.Thmtheorem1" title="5.1. ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">5.1</span></a> says cannot exist.</span></p>
</div>
<div id="S5.SS1.p5" class="ltx_para">
<p id="S5.SS1.p5.1" class="ltx_p"><span id="S5.SS1.p5.1.1" class="ltx_text">The <math id="S5.SS1.p5.m1" class="ltx_Math" alttext="r-2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r-2</annotation></semantics></math> points of residual intersection of the reducible quadric <math id="S5.SS1.p5.m2" class="ltx_Math" alttext="H\cup H_{\text{right}}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>∪</mo><msub><mi>H</mi><mtext>right</mtext></msub></mrow><annotation encoding="application/x-tex">H\cup H_{\text{right}}</annotation></semantics></math> with <math id="S5.SS1.p5.m3" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math> is the set <math id="S5.SS1.p5.m4" class="ltx_Math" alttext="R_{\text{middle}}\cap H_{\text{right}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mtext>middle</mtext></msub><mo>∩</mo><msub><mi>H</mi><mtext>right</mtext></msub></mrow><annotation encoding="application/x-tex">R_{\text{middle}}\cap H_{\text{right}}</annotation></semantics></math> minus the pair of points in <math id="S5.SS1.p5.m5" class="ltx_Math" alttext="L_{1}\cap R_{\text{middle}}=\Lambda_{\text{right}}\cap R_{\text{middle}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub></mrow><mo>=</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">L_{1}\cap R_{\text{middle}}=\Lambda_{\text{right}}\cap R_{\text{middle}}</annotation></semantics></math>. Therefore, to see how the residual points vary in <math id="S5.SS1.p5.m6" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math>, we only need to remember the linear space <math id="S5.SS1.p5.m7" class="ltx_Math" alttext="\Lambda_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">\Lambda_{\text{right}}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p6" class="ltx_para">
<p id="S5.SS1.p6.1" class="ltx_p"><span id="S5.SS1.p6.1.1" class="ltx_text">Define <math id="S5.SS1.p6.m1" class="ltx_Math" alttext="\Lambda_{\text{left}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><annotation encoding="application/x-tex">\Lambda_{\text{left}}</annotation></semantics></math> analogously. Note that we may choose the pair of
<math id="S5.SS1.p6.m2" class="ltx_Math" alttext="(\Lambda_{\text{right}},\Lambda_{\text{left}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Lambda_{\text{right}},\Lambda_{\text{left}})</annotation></semantics></math> arbitrarily, as long as they meet <math id="S5.SS1.p6.m3" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math> in a pair of points each. This is because when performing <a href="#S5.Thmtheorem3" title="5.3. ‣ Proof of . ‣ 5. The maximal rank problem for maximally connected chains ‣ Invariants of a general branched cover of 
      
        
          
          P
          1" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a>, we may first choose the lines <math id="S5.SS1.p6.m4" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> arbitrarily, and then choose fitting <math id="S5.SS1.p6.m5" class="ltx_Math" alttext="\overline{R}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo stretchy="true">¯</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\overline{R}_{i}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS1.p7" class="ltx_para">
<p id="S5.SS1.p7.1" class="ltx_p"><span id="S5.SS1.p7.1.1" class="ltx_text">So we want to show that for <math id="S5.SS1.p7.m1" class="ltx_Math" alttext="\Lambda_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">\Lambda_{\text{right}}</annotation></semantics></math> and <math id="S5.SS1.p7.m2" class="ltx_Math" alttext="\Lambda_{\text{left}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><annotation encoding="application/x-tex">\Lambda_{\text{left}}</annotation></semantics></math> generic, there are no hyperplanes <math id="S5.SS1.p7.m3" class="ltx_Math" alttext="H_{\text{left}}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mtext>left</mtext></msub><annotation encoding="application/x-tex">H_{\text{left}}</annotation></semantics></math> and <math id="S5.SS1.p7.m4" class="ltx_Math" alttext="H_{\text{right}}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mtext>right</mtext></msub><annotation encoding="application/x-tex">H_{\text{right}}</annotation></semantics></math> containing the respective linear spaces <math id="S5.SS1.p7.m5" class="ltx_Math" alttext="\Lambda_{\text{left}},\Lambda_{\text{right}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub></mrow><annotation encoding="application/x-tex">\Lambda_{\text{left}},\Lambda_{\text{right}}</annotation></semantics></math> whilst having the same residual intersection on <math id="S5.SS1.p7.m6" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math>. Consider the incidence correspondence:</span></p>
<table id="S5.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex60.m1" class="ltx_math_unparsed" alttext="\displaystyle\Sigma:=\big\{(\Lambda_{\text{left}},\Lambda_{\text{right}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Sigma:=\big\{(\Lambda_{\text{left}},\Lambda_{\text{right}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex60.m2" class="ltx_math_unparsed" alttext="\displaystyle,H_{\text{left}},H_{\text{right}},p_{1},\ldots,p_{r-2})\mid" display="inline" intent=":literal"><semantics><mrow><mo>,</mo><msub><mi>H</mi><mtext>left</mtext></msub><mo>,</mo><msub><mi>H</mi><mtext>right</mtext></msub><mo>,</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo><mo lspace="0em">∣</mo></mrow><annotation encoding="application/x-tex">\displaystyle,H_{\text{left}},H_{\text{right}},p_{1},\ldots,p_{r-2})\mid</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex61.m1" class="ltx_Math" alttext="\displaystyle\#(\Lambda_{\text{left}}\cap R_{\text{middle}})=\#(\Lambda_{\text{right}}\cap R_{\text{middle}})=2," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>#</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>#</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\#(\Lambda_{\text{left}}\cap R_{\text{middle}})=\#(\Lambda_{\text{right}}\cap R_{\text{middle}})=2,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex62.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{\text{left}}\subset H_{\text{left}},\,\Lambda_{\text{right}}\subset H_{\text{right}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><mo>⊂</mo><msub><mi>H</mi><mtext>left</mtext></msub></mrow><mo rspace="0.337em">,</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><mo>⊂</mo><msub><mi>H</mi><mtext>right</mtext></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{\text{left}}\subset H_{\text{left}},\,\Lambda_{\text{right}}\subset H_{\text{right}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex63.m1" class="ltx_Math" alttext="\displaystyle\{p_{1},\ldots,p_{r-2}\}\cup(\Lambda_{\text{left}}\cap R_{\text{middle}})=H_{\text{left}}\cap R_{\text{middle}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow></msub><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>H</mi><mtext>left</mtext></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{p_{1},\ldots,p_{r-2}\}\cup(\Lambda_{\text{left}}\cap R_{\text{middle}})=H_{\text{left}}\cap R_{\text{middle}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex64.m1" class="ltx_math_unparsed" alttext="\displaystyle\{p_{1},\ldots,p_{r-2}\}\cup(\Lambda_{\text{right}}\cap R_{\text{middle}})=H_{\text{right}}\cap R_{\text{middle}}\big\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow></msub><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>H</mi><mtext>right</mtext></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{p_{1},\ldots,p_{r-2}\}\cup(\Lambda_{\text{right}}\cap R_{\text{middle}})=H_{\text{right}}\cap R_{\text{middle}}\big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p7.2" class="ltx_p"><span id="S5.SS1.p7.2.1" class="ltx_text">That is, the points <math id="S5.SS1.p7.m7" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> are the (common) residual intersection of the hyperplanes <math id="S5.SS1.p7.m8" class="ltx_Math" alttext="\Lambda\subset H" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">\Lambda\subset H</annotation></semantics></math> with
<math id="S5.SS1.p7.m9" class="ltx_Math" alttext="R_{\text{middle}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>middle</mtext></msub><annotation encoding="application/x-tex">R_{\text{middle}}</annotation></semantics></math>. The incidence correspondence <math id="S5.SS1.p7.m10" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> admits a projection map to:</span></p>
<table id="S5.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex65.m1" class="ltx_Math" alttext="\Sigma^{\prime}=\big\{(\Lambda_{\text{left}},\Lambda_{\text{right}})\mid\#(\Lambda_{\text{left}}\cap R_{\text{middle}})=\#(\Lambda_{\text{right}}\cap R_{\text{middle}})=2\big\}" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Σ</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><mo stretchy="false">)</mo></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>#</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mtext>left</mtext></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>#</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mtext>right</mtext></msub><mo>∩</mo><msub><mi>R</mi><mtext>middle</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma^{\prime}=\big\{(\Lambda_{\text{left}},\Lambda_{\text{right}})\mid\#(\Lambda_{\text{left}}\cap R_{\text{middle}})=\#(\Lambda_{\text{right}}\cap R_{\text{middle}})=2\big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.SS1.p8" class="ltx_para">
<p id="S5.SS1.p8.1" class="ltx_p"><span id="S5.SS1.p8.1.1" class="ltx_text">We want to show that the map <math id="S5.SS1.p8.m1" class="ltx_Math" alttext="\Sigma\to\Sigma^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msup><mi mathvariant="normal">Σ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\Sigma\to\Sigma^{\prime}</annotation></semantics></math> is not dominant. We do this by showing that <math id="S5.SS1.p8.m2" class="ltx_Math" alttext="\dim\Sigma&lt;\dim\Sigma^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi mathvariant="normal">Σ</mi></mrow><mo rspace="0.1389em">&lt;</mo><mrow><mo lspace="0.1389em" rspace="0.167em">dim</mo><msup><mi mathvariant="normal">Σ</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\dim\Sigma&lt;\dim\Sigma^{\prime}</annotation></semantics></math>, as follows.</span></p>
<table id="S5.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex66.m1" class="ltx_Math" alttext="\displaystyle\dim\Sigma=" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi mathvariant="normal">Σ</mi></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\dim\Sigma=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex66.m2" class="ltx_Math" alttext="\displaystyle\,r-2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle\,r-2</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="S5.Ex66.4.1" class="ltx_text ltx_markedasmath">(choose the <math id="S5.Ex66.m3.m1" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math>’s)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
