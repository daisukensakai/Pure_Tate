<td id="S1.Thmthm4.p2.1.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-bottom: 6.0pt;"><math id="S1.Thmthm4.m27" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math></td>
