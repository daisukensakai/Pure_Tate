ject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex2.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces{\mathcal{F}_{d,n}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>d</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces{\mathcal{F}_{d,n}}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 62.97)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(30.92,0) matrix(1.0 0.0 0.0 1.0 -24.97 0)"><foreignObject style="--ltx-fo-width:2.61em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="36.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex2.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\BSL_{3}}" display="inline" intent=":literal"><semantics><msub><mi>BSL</mi><mn>3</mn></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\BSL_{3}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 61.85 0) translate(70.34,0) matrix(1.0 0.0 0.0 1.0 -31.17 0)"><foreignObject style="--ltx-fo-width:3.51em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="48.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex2.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\BPGL_{3}}" display="inline" intent=":literal"><semantics><msub><mi>BPGL</mi><mn>3</mn></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\BPGL_{3}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -26.94 23.99 L 21.09 23.99"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 21.37 23.99)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -53.73 11.23 L -53.73 -12.56"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -53.73 -12.84)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 47.53 11.23 L 47.53 -12.56"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 47.53 -12.84)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -22.53 -24.45 L 9.57 -24.45"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 9.85 -24.45)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
