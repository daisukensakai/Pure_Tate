rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{*}(U\times X)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 387.63 0) translate(42.63,0) matrix(1.0 0.0 0.0 1.0 -3.46 0)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS1.p4.pic1.m8" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces 0}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces 0}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -113.17 24.44 L -81.07 24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -80.79 24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -166.64 12.18 L -166.64 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -166.64 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -26.5 12.18 L -26.5 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -26.5 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 27.52 24.44 L 59.63 24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 59.9 24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 114.12 12.18 L 114.12 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 114.12 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 168.07 24.44 L 200.17 24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 200.45 24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -126.92 -24.44 L -67.32 -24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -67.04 -24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 13.77 -24.44 L 73.38 -24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 73.65 -24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 154.32 -24.44 L 200.17 -24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 200.45 -24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span>
<p id="S3.SS1.p4.2" class="ltx_p"><span id="S3.SS1.p4.2.1" class="ltx_text">By induction the right vertical map is surjective (using the stratification <math id="S3.SS1.p4.m8" class="ltx_Math" alttext="\mathcal{S}-T" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>−</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\mathcal{S}-T</annotation></semantics></math> of <math id="S3.SS1.p4.m9" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>). The left vertical map is surjective because <math id="S3.SS1.p4.m10" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> has the CKgP. A diagram chase shows that the middle map is surjective as well, so <math id="S3.SS1.p4.m11" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> has the CKgP.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm5" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm5.2" class="ltx_text ltx_font_bold">Lemma 3.5</span></span><span id="S3.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm5.p1" class="ltx_para">
<p id="S3.Thmthm5.p1.1" class="ltx_p"><span id="S3.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm5.p1.m1" class="ltx_Math" alttext="\pi:V\rightarrow Y" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:V\rightarrow Y</annotation></semantics></math> be an affine bundle. Then <math id="S3.Thmthm5.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> has the CKgP if and only if <math id="S3.Thmthm5.p1.m3" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> does.</span></p>
</div>
</div>
<div id="S3.SS1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p5" class="ltx_para">
<p id="S3.SS1.p5.1" class="ltx_p"><span id="S3.SS1.p5.1.1" class="ltx_text">For any algebraic stack <math id="S3.SS1.p5.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, the map <math id="S3.SS1.p5.m2" class="ltx_Math" alttext="V\times X\rightarrow Y\times X" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">→</mo><mrow><mi>Y</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">V\times X\rightarrow Y\times X</annotation></semantics></math> is an affine bundle. We have the following commutative diagram:</span></p>
<table id="S3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex5.m1.pic1" class="ltx_picture ltx_markedasmath" height="72.84" overflow="visible" style="vertical-align:-36.42px" version="1.1" viewBox="0 0 248.43 72.84" width="248.43"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,72.84) matrix(1 0 0 -1 0 0) translate(124.22,0) translate(0,36.42)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -124.22 -27.9)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 72.83)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.44)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(60.68,0) matrix(1.0 0.0 0.0 1.0 -54.72 0)"><foreignObject style="--ltx-fo-width:6.91em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="95.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex5.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{*}(V)\otimes A_{*}(X)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>A</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>A</mi><mo>∗</mo></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{*}(V)\otimes A_{*}(X)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 121.36 0) translate(80.14,0) matrix(1.0 0.0 0.0 1.0 -40.97 0)"><foreignObject style="--ltx-fo-width:4.92em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="68.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex5.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{*}(V\times X)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{*}(V\times X)}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 64.31)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0.02 0) translate(60.66,0) matrix(1.0 0.0 0.0 1.0 -54.7 0)"><foreignObject style="--ltx-fo-width:6.91em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="95.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex5.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{*}(Y)\otimes A_{*}(X)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>A</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>A</mi><mo>∗</mo></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{*}(Y)\otimes A_{*}(X)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 121.38 0) translate(80.12,0) matrix(1.0 0.0 0.0 1.0 -40.95 0)"><foreignObject style="--ltx-fo-width:4.92em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="68.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex5.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{*}(Y\times X)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{*}(Y\times X)}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -2.58 24.44 L 29.52 24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 29.8 24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -63.53 -12.18 L -63.53 11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 -63.53 11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -2.6 -24.44 L 29.54 -24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 29.82 -24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 77.29 -12.18 L 77.29 11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 77.29 11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p5.2" class="ltx_p"><span id="S3.SS1.p5.2.1" class="ltx_text">The vertical maps are isomorphisms induced by pullback. Therefore, one horizontal map is surjective if and only if the other is.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm6" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm6.2" class="ltx_text ltx_font_bold">Lemma 3.6</span></span><span id="S3.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm6.p1" class="ltx_para">
<p id="S3.Thmthm6.p1.1" class="ltx_p"><span id="S3.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm6.p1.m1" class="ltx_Math" alttext="\pi:\mathcal{Y}\rightarrow Y" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:\mathcal{Y}\rightarrow Y</annotation></semantics></math> be a gerbe banded by a finite group. Then <math id="S3.Thmthm6.p1.m2" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> has the CKgP if and only if <math id="S3.Thmthm6.p1.m3" class="ltx_Math" alttext="\mathcal{Y}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒴</mi><annotation encoding="application/x-tex">\mathcal{Y}</annotation></semantics></math> does.</span></p>
</div>
</div>
<div id="S3.SS1.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p6" class="ltx_para">
<p id="S3.SS1.p6.1" class="ltx_p"><span id="S3.SS1.p6.1.1" class="ltx_text">The proof is the same as Lemma <a href="#S3.Thmthm5" title="Lemma 3.5. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>, using that pullback induces an isomorphism on Chow rings for gerbes banded by finite groups.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm7" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm7.2" class="ltx_text ltx_font_bold">Lemma 3.7</span></span><span id="S3.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm7.p1" class="ltx_para">
<p id="S3.Thmthm7.p1.1" class="ltx_p"><span id="S3.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">Suppose that <math id="S3.Thmthm7.p1.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> has the CKgP and that <math id="S3.Thmthm7.p1.m2" class="ltx_Math" alttext="G\rightarrow Y" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">G\rightarrow Y</annotation></semantics></math> is a Grassmann bundle over <math id="S3.Thmthm7.p1.m3" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. Then <math id="S3.Thmthm7.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> has the CKgP.</span></p>
</div>
</div>
<div id="S3.SS1.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p7" class="ltx_para">
<p id="S3.SS1.p7.1" class="ltx_p"><span id="S3.SS1.p7.1.1" class="ltx_text">The Chow ring of a Grassmann bundle is generated over the Chow ring of the base by the Chern classes <math id="S3.SS1.p7.m1" class="ltx_Math" alttext="c_{1},\ldots,c_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">c_{1},\ldots,c_{n}</annotation></semantics></math> of the tautological subbundle. Consider the diagram</span></p><span class="ltx_inline-block"><svg id="S3.SS1.p7.pic1" class="ltx_picture ltx_centering" height="72.84" overflow="visible" style="vertical-align:-36.42px" version="1.1" viewBox="0 0 328.23 72.84" width="328.23"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,72.84) matrix(1 0 0 -1 0 0) translate(164.12,0) translate(0,36.42)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -164.11 -27.9)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 72.83)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.44)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(80.63,0) matrix(1.0 0.0 0.0 1.0 -74.67 0)"><foreignObject style="--ltx-fo-width:10.79em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="149.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS1.p7.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A^{*}(Y)[c_{1},\ldots,c_{n}]\otimes A^{*}(X)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>n</mi></msub></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>A</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A^{*}(Y)[c_{1},\ldots,c_{n}]\otimes A^{*}(X)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 161.26 0) translate(100.09,0) matrix(1.0 0.0 0.0 1.0 -60.92 0)"><foreignObject style="--ltx-fo-width:8.81em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="121.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS1.p7.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A^{*}(Y\times X)[c_{1},\ldots,c_{n}]}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A^{*}(Y\times X)[c_{1},\ldots,c_{n}]}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 64.31)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 27 0) translate(53.63,0) matrix(1.0 0.0 0.0 1.0 -47.67 0)"><foreignObject style="--ltx-fo-width:6.89em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="95.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS1.p7.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A^{*}(G)\otimes A^{*}(X)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>A</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A^{*}(G)\otimes A^{*}(X)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 188.26 0) translate(73.09,0) matrix(1.0 0.0 0.0 1.0 -33.92 0)"><foreignObject style="--ltx-fo-width:4.9em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="67.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS1.p7.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A^{*}(G\times X)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A^{*}(G\times X)}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -83.48 12.18 L -83.48 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -83.48 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -2.58 24.44 L 29.52 24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 29.8 24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 97.23 12.18 L 97.23 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 97.23 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -29.58 -24.44 L 56.53 -24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 56.8 -24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span>
<p id="S3.SS1.p7.2" class="ltx_p"><span id="S3.SS1.p7.2.1" class="ltx_text">The top horizontal arrow is surjective because <math id="S3.SS1.p7.m2" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> has the CKgP. The right vertical arrow is surjective because <math id="S3.SS1.p7.m3" class="ltx_Math" alttext="G\times X\to Y\times X" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">→</mo><mrow><mi>Y</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">G\times X\to Y\times X</annotation></semantics></math> is a Grassmann bundle whose tautological subbundle is the pullback of the tautological subbundle on <math id="S3.SS1.p7.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. It follows that the bottom horizontal arrow is also surjective.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm8" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm8.2" class="ltx_text ltx_font_bold">Lemma 3.8</span></span><span id="S3.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm8.p1" class="ltx_para">
<p id="S3.Thmthm8.p1.1" class="ltx_p"><span id="S3.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">The following stacks have the CKgP:</span></p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p"><span id="S3.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">The classifying stack </span><math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="\BGL_{n}" display="inline" intent=":literal"><semantics><msub><mi>BGL</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\BGL_{n}</annotation></semantics></math><span id="S3.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p"><span id="S3.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">The classifying stack </span><math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="\BSL_{n}" display="inline" intent=":literal"><semantics><msub><mi>BSL</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\BSL_{n}</annotation></semantics></math><span id="S3.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i3.p1.1" class="ltx_p"><span id="S3.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">The classifying stack </span><math id="S3.I1.i3.p1.m1" class="ltx_Math" alttext="\BPGL_{n}" display="inline" intent=":literal"><semantics><msub><mi>BPGL</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\BPGL_{n}</annotation></semantics></math><span id="S3.I1.i3.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS1.8" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p8" class="ltx_para">
<p id="S3.SS1.p8.1" class="ltx_p"><span id="S3.SS1.p8.1.1" class="ltx_text">(1) Take <math id="S3.SS1.p8.m1" class="ltx_Math" alttext="V_{k}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>k</mi></msub><annotation encoding="application/x-tex">V_{k}</annotation></semantics></math> be the representation of <math id="S3.SS1.p8.m2" class="ltx_Math" alttext="\GL_{n}" display="inline" intent=":literal"><semantics><msub><mi>GL</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\GL_{n}</annotation></semantics></math> given by matrices of size <math id="S3.SS1.p8.m3" class="ltx_Math" alttext="n\times k" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">n\times k</annotation></semantics></math>. Let <math id="S3.SS1.p8.m4" class="ltx_Math" alttext="U_{k}\subset V_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>k</mi></msub><mo>⊂</mo><msub><mi>V</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">U_{k}\subset V_{k}</annotation></semantics></math> be the open subset of full rank matrices. The complement of <math id="S3.SS1.p8.m5" class="ltx_Math" alttext="U_{k}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>k</mi></msub><annotation encoding="application/x-tex">U_{k}</annotation></semantics></math> has codimension <math id="S3.SS1.p8.m6" class="ltx_Math" alttext="k-n+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>−</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-n+1</annotation></semantics></math>. Then</span></p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_Math" alttext="[U_{k}/\GL_{n}]\times X\cong G(n,k)\times X." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>U</mi><mi>k</mi></msub><mo>/</mo><msub><mi>GL</mi><mi>n</mi></msub></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>X</mi></mrow><mo>≅</mo><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mi>X</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[U_{k}/\GL_{n}]\times X\cong G(n,k)\times X.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p8.2" class="ltx_p"><span id="S3.SS1.p8.2.1" class="ltx_text">Taking <math id="S3.SS1.p8.m7" class="ltx_Math" alttext="k\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">k\to\infty</annotation></semantics></math> and noting that <math id="S3.SS1.p8.m8" class="ltx_Math" alttext="G(n,k)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(n,k)</annotation></semantics></math> has the CKgP by Lemma <a href="#S3.Thmthm7" title="Lemma 3.7. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a>, we see that <math id="S3.SS1.p8.m9" class="ltx_Math" alttext="\BGL_{n}" display="inline" intent=":literal"><semantics><msub><mi>BGL</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\BGL_{n}</annotation></semantics></math> has the CKgP.</span></p>
</div>
<div id="S3.SS1.p9" class="ltx_para">
<p id="S3.SS1.p9.1" class="ltx_p"><span id="S3.SS1.p9.1.1" class="ltx_text">(2) The case of <math id="S3.SS1.p9.m1" class="ltx_Math" alttext="\BSL_{n}" display="inline" intent=":literal"><semantics><msub><mi>BSL</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\BSL_{n}</annotation></semantics></math> is similar, except that the quotient <math id="S3.SS1.p9.m2" class="ltx_Math" alttext="[U_{k}/\SL_{n}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>U</mi><mi>k</mi></msub><mo>/</mo><msub><mi>SL</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[U_{k}/\SL_{n}]</annotation></semantics></math> is isomorphic to the complement of the zero section of the line bundle <math id="S3.SS1.p9.m3" class="ltx_Math" alttext="\det\mathcal{S}\rightarrow G(n,k)" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">det</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mo stretchy="false">→</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\det\mathcal{S}\rightarrow G(n,k)</annotation></semantics></math>, where <math id="S3.SS1.p9.m4" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> is the tautological subbundle. By Lemmas <a href="#S3.Thmthm3" title="Lemma 3.3. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> and <a href="#S3.Thmthm5" title="Lemma 3.5. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>, we see <math id="S3.SS1.p9.m5" class="ltx_Math" alttext="[U_{k}/\SL_{n}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>U</mi><mi>k</mi></msub><mo>/</mo><msub><mi>SL</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[U_{k}/\SL_{n}]</annotation></semantics></math> has CKgP too, and taking <math id="S3.SS1.p9.m6" class="ltx_Math" alttext="k\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">k\to\infty</annotation></semantics></math>, we see that <math id="S3.SS1.p9.m7" class="ltx_Math" alttext="\BSL_{n}" display="inline" intent=":literal"><semantics><msub><mi>BSL</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\BSL_{n}</annotation></semantics></math> has CKgP.</span></p>
</div>
<div id="S3.SS1.p10" class="ltx_para">
<p id="S3.SS1.p10.1" class="ltx_p"><span id="S3.SS1.p10.1.1" class="ltx_text">(3) The map <math id="S3.SS1.p10.m1" class="ltx_Math" alttext="\BSL_{n}\rightarrow\BPGL_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>BSL</mi><mi>n</mi></msub><mo stretchy="false">→</mo><msub><mi>BPGL</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\BSL_{n}\rightarrow\BPGL_{n}</annotation></semantics></math> is a gerbe banded by <math id="S3.SS1.p10.m2" class="ltx_Math" alttext="\mu_{n}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mu_{n}</annotation></semantics></math>. Thus, <math id="S3.SS1.p10.m3" class="ltx_Math" alttext="\BPGL_{n}" display="inline" intent=":literal"><semantics><msub><mi>BPGL</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\BPGL_{n}</annotation></semantics></math> has the CKgP by (2) and Lemma <a href="#S3.Thmthm6" title="Lemma 3.6. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm9" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm9.2" class="ltx_text ltx_font_bold">Lemma 3.9</span></span><span id="S3.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm9.p1" class="ltx_para">
<p id="S3.Thmthm9.p1.1" class="ltx_p"><span id="S3.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="S3.Thmthm9.p1.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is a stack that admits a coarse moduli space <math id="S3.Thmthm9.p1.m2" class="ltx_Math" alttext="\pi:Y\rightarrow M" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:Y\rightarrow M</annotation></semantics></math>. Then <math id="S3.Thmthm9.p1.m3" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> has the CKgP if and only if <math id="S3.Thmthm9.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> does.</span></p>
</div>
</div>
<div id="S3.SS1.9" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p11" class="ltx_para">
<p id="S3.SS1.p11.1" class="ltx_p"><span id="S3.SS1.p11.1.1" class="ltx_text">Let <math id="S3.SS1.p11.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a stack that admits a stratification by global quotient stacks. By noetherian induction, we may reduce to the case that <math id="S3.SS1.p11.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a global quotient stack. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>, Proposition 4.5.6]</cite>, for any integer <math id="S3.SS1.p11.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, there exists a vector bundle <math id="S3.SS1.p11.m4" class="ltx_Math" alttext="E\to X" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">E\to X</annotation></semantics></math> and a representable open substack <math id="S3.SS1.p11.m5" class="ltx_Math" alttext="U\subset E" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">U\subset E</annotation></semantics></math> whose complement has codimension at least <math id="S3.SS1.p11.m6" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>. Formation of coarse moduli spaces commutes with flat base change, so <math id="S3.SS1.p11.m7" class="ltx_Math" alttext="M\times U" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">M\times U</annotation></semantics></math> is a coarse moduli space for <math id="S3.SS1.p11.m8" class="ltx_Math" alttext="Y\times U" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">Y\times U</annotation></semantics></math>. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib55" title="" class="ltx_ref">55</a>, Proposition 6.1]</cite>, there is an isomorphism <math id="S3.SS1.p11.m9" class="ltx_Math" alttext="A^{*}(M\times U)\cong A^{*}(Y\times U)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{*}(M\times U)\cong A^{*}(Y\times U)</annotation></semantics></math>. Then,
for <math id="S3.SS1.p11.m10" class="ltx_Math" alttext="*&lt;N" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mphantom></mphantom><mo>&lt;</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">*&lt;N</annotation></semantics></math>, we have</span></p>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="A^{*}(X\times Y)\cong A^{*}(E\times Y)\cong A^{*}(U\times Y)\cong A^{*}(U\times M)\cong A^{*}(E\times M)\cong A^{*}(X\times M)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A^{*}(X\times Y)\cong A^{*}(E\times Y)\cong A^{*}(U\times Y)\cong A^{*}(U\times M)\cong A^{*}(E\times M)\cong A^{*}(X\times M).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p11.2" class="ltx_p"><span id="S3.SS1.p11.2.1" class="ltx_text">Taking <math id="S3.SS1.p11.m11" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> to be arbitrarily large, we have an isomorphism <math id="S3.SS1.p11.m12" class="ltx_Math" alttext="A^{*}(X\times Y)\cong A^{*}(X\times M)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{*}(X\times Y)\cong A^{*}(X\times M)</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.p12" class="ltx_para">
<p id="S3.SS1.p12.1" class="ltx_p"><span id="S3.SS1.p12.1.1" class="ltx_text">Now we have the following commutative diagram, where both horizontal maps are isomorphisms.</span></p><span class="ltx_inline-block"><svg id="S3.SS1.p12.pic1" class="ltx_picture ltx_centering" height="72.84" overflow="visible" style="vertical-align:-36.42px" version="1.1" viewBox="0 0 252.01 72.84" width="252.01"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,72.84) matrix(1 0 0 -1 0 0) translate(126,0) translate(0,36.42)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -126 -27.9)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 72.83)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.44)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(53.74,0) matrix(1.0 0.0 0.0 1.0 -47.79 0)"><foreignObject style="--ltx-fo-width:6.91em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="95.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS1.p12.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{*}(Y)\otimes A_{*}(X)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>A</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>A</mi><mo>∗</mo></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{*}(Y)\otimes A_{*}(X)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 107.49 0) translate(88.87,0) matrix(1.0 0.0 0.0 1.0 -49.7 0)"><foreignObject style="--ltx-fo-width:7.18em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="99.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS1.p12.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{*}(M)\otimes A_{*}(X)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>A</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>A</mi><mo>∗</mo></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{*}(M)\otimes A_{*}(X)}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 64.31)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 13.75 0) translate(39.99,0) matrix(1.0 0.0 0.0 1.0 -34.04 0)"><foreignObject style="--ltx-fo-width:4.92em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="68.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS1.p12.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{*}(Y\times X)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{*}(Y\times X)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 119.32 0) translate(77.04,0) matrix(1.0 0.0 0.0 1.0 -37.87 0)"><foreignObject style="--ltx-fo-width:5.47em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="75.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.SS1.p12.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A_{*}(M\times X).}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A_{*}(M\times X).}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -72.26 12.18 L -72.26 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -72.26 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -18.24 24.44 L 13.86 24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 14.14 24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 70.35 12.18 L 70.35 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 70.35 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -31.99 -24.44 L 25.69 -24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 25.97 -24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span>
<p id="S3.SS1.p12.2" class="ltx_p"><span id="S3.SS1.p12.2.1" class="ltx_text">If one of the vertical maps is surjective, then so is the other one.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm10" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm10.2" class="ltx_text ltx_font_bold">Lemma 3.10</span></span><span id="S3.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm10.p1" class="ltx_para">
<p id="S3.Thmthm10.p1.1" class="ltx_p"><span id="S3.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm10.p1.m1" class="ltx_Math" alttext="f:Y\rightarrow X" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">f:Y\rightarrow X</annotation></semantics></math> be a surjective proper morphism that is representable by Deligne–Mumford stacks. (For example, any quotient by a finite group <math id="S3.Thmthm10.p1.m2" class="ltx_Math" alttext="Y\to Y/G" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo stretchy="false">→</mo><mrow><mi>Y</mi><mo>/</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">Y\to Y/G</annotation></semantics></math>.) If <math id="S3.Thmthm10.p1.m3" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> has the CKgP, then <math id="S3.Thmthm10.p1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has the CKgP.</span></p>
</div>
</div>
<div id="S3.SS1.10" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p13" class="ltx_para">
<p id="S3.SS1.p13.1" class="ltx_p"><span id="S3.SS1.p13.1.1" class="ltx_text">This is a special case of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>, Lemma 2.9]</cite>.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2. </span>The cycle class map</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">One important consequence of the CKgP is that, if the space is smooth and proper, the cycle class map is an isomorphism.
The proof of the following lemma was inspired by the argument in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>, Theorem 3.6]</cite>, which involves constructing an algebraic decomposition of the diagonal to prove surjectivity of the cycle class map.</p>
</div>
<div id="S3.Thmthm11" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm11.2" class="ltx_text ltx_font_bold">Lemma 3.11</span></span><span id="S3.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm11.p1" class="ltx_para">
<p id="S3.Thmthm11.p1.1" class="ltx_p"><span id="S3.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="S3.Thmthm11.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a smooth, proper Deligne–Mumford stack of dimension <math id="S3.Thmthm11.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.
If <math id="S3.Thmthm11.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has the CKgP, then the cycle class map <math id="S3.Thmthm11.p1.m4" class="ltx_Math" alttext="\mathrm{cl}:A^{*}(X)\to H^{*}(X,\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><mi>cl</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{cl}:A^{*}(X)\to H^{*}(X,\mathbb{Q})</annotation></semantics></math> is an isomorphism.</span></p>
</div>
</div>
<div id="S3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p"><span id="S3.SS2.p2.1.1" class="ltx_text">Let <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="p_{1}:X\times X\to X" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">p_{1}:X\times X\to X</annotation></semantics></math> and <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="p_{2}:X\times X\to X" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">p_{2}:X\times X\to X</annotation></semantics></math> be the projection maps onto the first and second factors.
Because <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has the CKgP, the map <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="\bigoplus_{i=0}^{d}A^{i}(X)\otimes A^{d-i}(X)\to A^{d}(X\times X)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mo>⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></msubsup><mrow><msup><mi>A</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>A</mi><mrow><mi>d</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>A</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bigoplus_{i=0}^{d}A^{i}(X)\otimes A^{d-i}(X)\to A^{d}(X\times X)</annotation></semantics></math> is surjective. In particular, the class of the diagonal <math id="S3.SS2.p2.m5" class="ltx_Math" alttext="[\Delta]\in A^{d}(X\times X)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msup><mi>A</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[\Delta]\in A^{d}(X\times X)</annotation></semantics></math> has the form</span></p>
<table id="S3.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E1.m1" class="ltx_Math" alttext="[\Delta]=\sum_{i=0}^{d}\sum_{j=0}^{a_{i}}n_{i,j}\cdot(p_{1}^{*}y_{i,j})\cdot(p_{2}^{*}z_{i,j})\in A^{d}(X\times X)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">]</mo></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></munderover><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>a</mi><mi>i</mi></msub></munderover><mrow><msub><mi>n</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>p</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>p</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>∈</mo><mrow><msup><mi>A</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[\Delta]=\sum_{i=0}^{d}\sum_{j=0}^{a_{i}}n_{i,j}\cdot(p_{1}^{*}y_{i,j})\cdot(p_{2}^{*}z_{i,j})\in A^{d}(X\times X).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p2.2" class="ltx_p"><span id="S3.SS2.p2.2.1" class="ltx_text">where <math id="S3.SS2.p2.m6" class="ltx_Math" alttext="y_{i,j}\in A^{i}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∈</mo><mrow><msup><mi>A</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{i,j}\in A^{i}(X)</annotation></semantics></math> and <math id="S3.SS2.p2.m7" class="ltx_Math" alttext="z_{i,j}\in A^{d-i}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>∈</mo><mrow><msup><mi>A</mi><mrow><mi>d</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{i,j}\in A^{d-i}(X)</annotation></semantics></math>. Applying the cycle class map gives a decomposition of the diagonal in cohomology:</span></p>
<table id="S3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex8.m1" class="ltx_Math" alttext="[\Delta]=\sum_{i=0}^{d}n_{i,j}\cdot p_{1}^{*}\mathrm{cl}(y_{i,j})\cdot p_{2}^{*}\mathrm{cl}(z_{i,j})\in H^{2d}(X\times X)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">]</mo></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></munderover><mrow><mrow><mrow><mrow><msub><mi>n</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>p</mi><mn>1</mn><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>cl</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>p</mi><mn>2</mn><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>cl</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[\Delta]=\sum_{i=0}^{d}n_{i,j}\cdot p_{1}^{*}\mathrm{cl}(y_{i,j})\cdot p_{2}^{*}\mathrm{cl}(z_{i,j})\in H^{2d}(X\times X).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p2.3" class="ltx_p"><span id="S3.SS2.p2.3.1" class="ltx_text">We use this to show that all cohomology is algebraic. Given <math id="S3.SS2.p2.m8" class="ltx_Math" alttext="\alpha\in H^{n}(X)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><msup><mi>H</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha\in H^{n}(X)</annotation></semantics></math>, we have</span></p>
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex9.m1" class="ltx_Math" alttext="\displaystyle\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\displaystyle\alpha</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex9.m2" class="ltx_math_unparsed" alttext="\displaystyle=p_{2*}(p_{1}^{*}\alpha\cdot[\Delta])" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>p</mi><mrow><mn>2</mn><mo lspace="0.222em">∗</mo></mrow></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>p</mi><mn>1</mn><mo>∗</mo></msubsup><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=p_{2*}(p_{1}^{*}\alpha\cdot[\Delta])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex10.m1" class="ltx_math_unparsed" alttext="\displaystyle=p_{2*}\left(\sum_{i=0}^{d}\sum_{j=0}^{a_{i}}p_{1}^{*}\alpha\cdot p_{1}^{*}\mathrm{cl}(y_{i,j})\cdot p_{2}^{*}\mathrm{cl}(z_{i,j})\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>p</mi><mrow><mn>2</mn><mo lspace="0.222em">∗</mo></mrow></msub><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>a</mi><mi>i</mi></msub></munderover></mstyle><msubsup><mi>p</mi><mn>1</mn><mo>∗</mo></msubsup><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>p</mi><mn>1</mn><mo>∗</mo></msubsup><mi>cl</mi><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>p</mi><mn>2</mn><mo>∗</mo></msubsup><mi>cl</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=p_{2*}\left(\sum_{i=0}^{d}\sum_{j=0}^{a_{i}}p_{1}^{*}\alpha\cdot p_{1}^{*}\mathrm{cl}(y_{i,j})\cdot p_{2}^{*}\mathrm{cl}(z_{i,j})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex11.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{i=0}^{d}\sum_{j=0}^{a_{i}}p_{2*}p_{1}^{*}(\alpha\cdot\mathrm{cl}(y_{i,j}))\cdot\mathrm{cl}(z_{i,j})." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>a</mi><mi>i</mi></msub></munderover></mstyle><msub><mi>p</mi><mrow><mn>2</mn><mo lspace="0.222em">∗</mo></mrow></msub><msubsup><mi>p</mi><mn>1</mn><mo>∗</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>cl</mi><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>cl</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{d}\sum_{j=0}^{a_{i}}p_{2*}p_{1}^{*}(\alpha\cdot\mathrm{cl}(y_{i,j}))\cdot\mathrm{cl}(z_{i,j}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody><tr class="ltx_eqn_row ltx_align_baseline"><td class="ltx_eqn_cell ltx_align_left" style="white-space:normal;" colspan="5">For dimension reasons, <math id="S3.EGx1.m1" class="ltx_Math" alttext="\alpha\cdot\cl(y_{i,j})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>cl</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha\cdot\cl(y_{i,j})=0</annotation></semantics></math> whenever <math id="S3.EGx1.m2" class="ltx_Math" alttext="n+2i&gt;2d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">n+2i&gt;2d</annotation></semantics></math>.
On the other hand,
<math id="S3.EGx1.m3" class="ltx_math_unparsed" alttext="p_{2*}p_{1}^{*}(\alpha\cdot\mathrm{cl}(y_{i}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mn>2</mn><mo lspace="0.222em">∗</mo></mrow></msub><msubsup><mi>p</mi><mn>1</mn><mo>∗</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>cl</mi><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{2*}p_{1}^{*}(\alpha\cdot\mathrm{cl}(y_{i}))</annotation></semantics></math> has codimension <math id="S3.EGx1.m4" class="ltx_Math" alttext="n+2i-2d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">n+2i-2d</annotation></semantics></math>, so it vanishes if <math id="S3.EGx1.m5" class="ltx_Math" alttext="n+2i&lt;2d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo>&lt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">n+2i&lt;2d</annotation></semantics></math>. It follows that the only non-zero terms in the sum above are those with <math id="S3.EGx1.m6" class="ltx_Math" alttext="n+2i=2d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">n+2i=2d</annotation></semantics></math>. In this case, <math id="S3.EGx1.m7" class="ltx_Math" alttext="\alpha\cdot\mathrm{cl}(y_{i,j})\in H^{2d}(X)=\mathbb{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>cl</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">\alpha\cdot\mathrm{cl}(y_{i,j})\in H^{2d}(X)=\mathbb{Q}</annotation></semantics></math> is top degree, so we get</td></tr></tbody>
<tbody id="S3.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex12.m1" class="ltx_Math" alttext="\displaystyle=\sum_{j=0}^{a_{i}}\deg(\alpha\cdot\mathrm{cl}(y_{i,j}))\cdot\mathrm{cl}(z_{i,j})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>a</mi><mi>i</mi></msub></munderover></mstyle><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>cl</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>cl</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=0}^{a_{i}}\deg(\alpha\cdot\mathrm{cl}(y_{i,j}))\cdot\mathrm{cl}(z_{i,j}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p2.4" class="ltx_p"><span id="S3.SS2.p2.4.1" class="ltx_text">showing <math id="S3.SS2.p2.m9" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is in the image of <math id="S3.SS2.p2.m10" class="ltx_Math" alttext="\mathrm{cl}" display="inline" intent=":literal"><semantics><mi>cl</mi><annotation encoding="application/x-tex">\mathrm{cl}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p"><span id="S3.SS2.p3.1.1" class="ltx_text">For injectivity, let <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="\beta\in A^{i}(X)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mrow><msup><mi>A</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta\in A^{i}(X)</annotation></semantics></math> be in the kernel of <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="\mathrm{cl}" display="inline" intent=":literal"><semantics><mi>cl</mi><annotation encoding="application/x-tex">\mathrm{cl}</annotation></semantics></math>. Then for any class <math id="S3.SS2.p3.m3" class="ltx_Math" alttext="\gamma\in A^{d-i}(X)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><mrow><msup><mi>A</mi><mrow><mi>d</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma\in A^{d-i}(X)</annotation></semantics></math>, we have</span></p>
<table id="S3.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex13.m1" class="ltx_Math" alttext="0=\mathrm{cl}(\beta)\cup\mathrm{cl}(\gamma)=\mathrm{cl}(\beta\cdot\gamma)=\deg(\beta\cdot\gamma)." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>=</mo><mrow><mrow><mi>cl</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mi>cl</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>cl</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0=\mathrm{cl}(\beta)\cup\mathrm{cl}(\gamma)=\mathrm{cl}(\beta\cdot\gamma)=\deg(\beta\cdot\gamma).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p3.2" class="ltx_p"><span id="S3.SS2.p3.2.1" class="ltx_text">Applying the diagonal correspondence in Chow (<a href="#S3.E1" title="In Proof. ‣ 3.2. The cycle class map ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>), and using the push–pull formula as in the proof of surjectivity, we then have</span></p>
<table id="S3.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex14.m1" class="ltx_Math" alttext="\beta=\sum_{j=0}^{a_{i}}\deg(\beta\cdot y_{i,j})\cdot z_{i,j}=0.\qed" display="block" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>a</mi><mi>i</mi></msub></munderover><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>z</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\beta=\sum_{j=0}^{a_{i}}\deg(\beta\cdot y_{i,j})\cdot z_{i,j}=0.\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.Thmthm12" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm12.2" class="ltx_text ltx_font_bold">Remark 3.12</span></span><span id="S3.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm12.p1" class="ltx_para">
<p id="S3.Thmthm12.p1.1" class="ltx_p">In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib52" title="" class="ltx_ref">52</a>, Theorem 4.1]</cite>, Totaro proves a stronger version of Lemma <a href="#S3.Thmthm11" title="Lemma 3.11. ‣ 3.2. The cycle class map ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.11</span></a> for Chow motives, and in particular, for smooth, proper schemes over a field.</p>
</div>
</div>
<div id="S3.Thmthm13" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm13.2" class="ltx_text ltx_font_bold">Remark 3.13</span></span><span id="S3.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm13.p1" class="ltx_para">
<p id="S3.Thmthm13.p1.1" class="ltx_p">Properness of <math id="S3.Thmthm13.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is essential and was used in the proof to ensure the pushforward map <math id="S3.Thmthm13.p1.m2" class="ltx_math_unparsed" alttext="p_{2*}:A_{*}(X\times X)\to A_{*}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mn>2</mn><mo lspace="0.222em">∗</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>A</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msub><mi>A</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{2*}:A_{*}(X\times X)\to A_{*}(X)</annotation></semantics></math> was well-defined.
For a non-example if the properness assumption is dropped, <math id="S3.Thmthm13.p1.m3" class="ltx_Math" alttext="\mathbb{A}^{1}\smallsetminus\{0\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔸</mi><mn>1</mn></msup><mo>∖</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{A}^{1}\smallsetminus\{0\}</annotation></semantics></math> has the CKgP, but <math id="S3.Thmthm13.p1.m4" class="ltx_Math" alttext="H^{1}(\mathbb{A}^{1}\smallsetminus\{0\})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝔸</mi><mn>1</mn></msup><mo>∖</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{1}(\mathbb{A}^{1}\smallsetminus\{0\})\neq 0</annotation></semantics></math>, so <math id="S3.Thmthm13.p1.m5" class="ltx_Math" alttext="\mathrm{cl}" display="inline" intent=":literal"><semantics><mi>cl</mi><annotation encoding="application/x-tex">\mathrm{cl}</annotation></semantics></math> is not surjective.</p>
</div>
</div>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p">As an immediate consequence of Lemma <a href="#S3.Thmthm11" title="Lemma 3.11. ‣ 3.2. The cycle class map ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.11</span></a>, we see that the CKgP allows us to convert results in Chow to results in cohomology.</p>
</div>
<div id="S3.Thmthm14" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm14.2" class="ltx_text ltx_font_bold">Lemma 3.14</span></span><span id="S3.Thmthm14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm14.p1" class="ltx_para">
<p id="S3.Thmthm14.p1.1" class="ltx_p"><span id="S3.Thmthm14.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="S3.Thmthm14.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> has the CKgP and <math id="S3.Thmthm14.p1.m2" class="ltx_Math" alttext="A^{*}(\overline{\mathcal{M}}_{g,n})=R^{*}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\overline{\mathcal{M}}_{g,n})=R^{*}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>. Then we also have <math id="S3.Thmthm14.p1.m3" class="ltx_Math" alttext="H^{*}(\overline{\mathcal{M}}_{g,n})=RH^{*}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{*}(\overline{\mathcal{M}}_{g,n})=RH^{*}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>.</span></p>
</div>
</div>
<section id="S3.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.2.1. </span>Tautological cohomology and polynomial point counts</h4>

<div id="S3.SS2.SSS1.p1" class="ltx_para">
<p id="S3.SS2.SSS1.p1.1" class="ltx_p">By the Grothendieck–Lefschetz trace formula, the cohomology of <math id="S3.SS2.SSS1.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> is intimately related to its point counts over finite fields. Given a Deligne–Mumford stack <math id="S3.SS2.SSS1.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> that is smooth and proper over <math id="S3.SS2.SSS1.p1.m3" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>, we say <math id="S3.SS2.SSS1.p1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has <em id="S3.SS2.SSS1.p1.1.1" class="ltx_emph ltx_font_italic">polynomial point count</em> if <math id="S3.SS2.SSS1.p1.m5" class="ltx_Math" alttext="\#X(\mathbb{F}_{q})=P(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\#X(\mathbb{F}_{q})=P(q)</annotation></semantics></math> for some polynomial <math id="S3.SS2.SSS1.p1.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> with integer coefficients. Here, the count of points is weighted by size of the automorphism group of each point:</p>
<table id="S3.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex15.m1" class="ltx_Math" alttext="\#X(k)=\sum_{\xi\in X(k)}\frac{1}{|\mathrm{Aut}(\xi)|}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>ξ</mi><mo>∈</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#X(k)=\sum_{\xi\in X(k)}\frac{1}{|\mathrm{Aut}(\xi)|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.SSS1.p1.2" class="ltx_p">If <math id="S3.SS2.SSS1.p1.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has polynomial point count, then van den Bogaart–Edixhoven <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib53" title="" class="ltx_ref">53</a>]</cite> show that the polynomial <math id="S3.SS2.SSS1.p1.m8" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> determines the cohomology of <math id="S3.SS2.SSS1.p1.m9" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.
Conversely, information about the cohomology of <math id="S3.SS2.SSS1.p1.m10" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>
can determine information about its point counts.
The following fact was explained to us by Sam Payne.</p>
</div>
<div id="S3.Thmthm15" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm15.2" class="ltx_text ltx_font_bold">Proposition 3.15</span></span><span id="S3.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm15.p1" class="ltx_para">
<p id="S3.Thmthm15.p1.1" class="ltx_p"><span id="S3.Thmthm15.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S3.Thmthm15.p1.m1" class="ltx_Math" alttext="H^{*}(\overline{\mathcal{M}}_{g,n})=RH^{*}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{*}(\overline{\mathcal{M}}_{g,n})=RH^{*}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>, then <math id="S3.Thmthm15.p1.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> has polynomial point count.</span></p>
</div>
</div>
<div id="S3.SS2.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.SSS1.p2" class="ltx_para">
<p id="S3.SS2.SSS1.p2.1" class="ltx_p"><span id="S3.SS2.SSS1.p2.1.1" class="ltx_text">This result relies crucially on the fact that <math id="S3.SS2.SSS1.p2.m1" class="ltx_Math" alttext="X:=\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>:=</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">X:=\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> is smooth and proper over <math id="S3.SS2.SSS1.p2.m2" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>.
The <math id="S3.SS2.SSS1.p2.m3" class="ltx_Math" alttext="\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{q}</annotation></semantics></math>-points of <math id="S3.SS2.SSS1.p2.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> are the fixed points of the action of Frobenius on <math id="S3.SS2.SSS1.p2.m5" class="ltx_Math" alttext="X_{\overline{\mathbb{F}}_{q}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>q</mi></msub></msub><annotation encoding="application/x-tex">X_{\overline{\mathbb{F}}_{q}}</annotation></semantics></math>.
Using the Grothendieck–Lefschetz trace formula <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite>, <math id="S3.SS2.SSS1.p2.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has polynomial point count if Frobenius acts by powers of <math id="S3.SS2.SSS1.p2.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> on
<math id="S3.SS2.SSS1.p2.m8" class="ltx_Math" alttext="H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{q}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>q</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{q}},\mathbb{Q}_{\ell})</annotation></semantics></math> for <math id="S3.SS2.SSS1.p2.m9" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> a prime not equal to <math id="S3.SS2.SSS1.p2.m10" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.
Frobenius always acts by <math id="S3.SS2.SSS1.p2.m11" class="ltx_Math" alttext="q^{k}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mi>k</mi></msup><annotation encoding="application/x-tex">q^{k}</annotation></semantics></math> on the fundamental class of an algebraic subvariety of codimension <math id="S3.SS2.SSS1.p2.m12" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> defined over <math id="S3.SS2.SSS1.p2.m13" class="ltx_Math" alttext="\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{q}</annotation></semantics></math>.
Thus, it suffices to show that
<math id="S3.SS2.SSS1.p2.m14" class="ltx_Math" alttext="H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{q}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>q</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{q}},\mathbb{Q}_{\ell})</annotation></semantics></math> is generated by algebraic classes defined over <math id="S3.SS2.SSS1.p2.m15" class="ltx_Math" alttext="\mathbb{F}_{p}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>p</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{p}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.SSS1.p3" class="ltx_para">
<p id="S3.SS2.SSS1.p3.1" class="ltx_p"><span id="S3.SS2.SSS1.p3.1.1" class="ltx_text">The tautological ring is generated by algebraic classes defined over <math id="S3.SS2.SSS1.p3.m1" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>. Therefore, there is a surjection <math id="S3.SS2.SSS1.p3.m2" class="ltx_Math" alttext="R^{*}(X_{\mathbb{Z}})\to RH^{*}(X_{\mathbb{C}})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℤ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℂ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{*}(X_{\mathbb{Z}})\to RH^{*}(X_{\mathbb{C}})</annotation></semantics></math>. Assuming <math id="S3.SS2.SSS1.p3.m3" class="ltx_Math" alttext="H^{*}(X_{\mathbb{C}})=RH^{*}(X_{\mathbb{C}})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℂ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℂ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{*}(X_{\mathbb{C}})=RH^{*}(X_{\mathbb{C}})</annotation></semantics></math>, we obtain the diagram below where the arrow from the left to the far upper right is surjective.</span></p>
<table id="S3.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.E2.m1.pic1" class="ltx_picture ltx_markedasmath" height="124.76" overflow="visible" style="vertical-align:-62.38px" version="1.1" viewBox="0 0 326.62 124.76" width="326.62"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,124.76) matrix(1 0 0 -1 0 0) translate(163.31,0) translate(0,62.38)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -163.31 -50.8)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 124.77)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.44)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 75.96 0) translate(70.41,0) matrix(1.0 0.0 0.0 1.0 -31.24 0)"><foreignObject style="--ltx-fo-width:3.52em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="48.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E2.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A^{*}(X_{\mathbb{C}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℂ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A^{*}(X_{\mathbb{C}})}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 201.43 0) translate(71.53,0) matrix(1.0 0.0 0.0 1.0 -32.36 0)"><foreignObject style="--ltx-fo-width:3.68em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="50.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E2.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces H^{*}(X_{\mathbb{C}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℂ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces H^{*}(X_{\mathbb{C}})}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 64.31)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(36.72,0) matrix(1.0 0.0 0.0 1.0 -30.76 0)"><foreignObject style="--ltx-fo-width:3.45em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="47.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E2.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces R^{*}(X_{\mathbb{Z}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℤ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces R^{*}(X_{\mathbb{Z}})}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 113.18)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 73.44 0) translate(72.93,0) matrix(1.0 0.0 0.0 1.0 -33.76 0)"><foreignObject style="--ltx-fo-width:3.88em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.35em;font-size:10pt;" height="15.18" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="53.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E2.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A^{*}(X_{\mathbb{F}_{p}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mi>𝔽</mi><mi>p</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A^{*}(X_{\mathbb{F}_{p}})}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 186.09 0) translate(86.87,0) matrix(1.0 0.0 0.0 1.0 -47.7 0)"><foreignObject style="--ltx-fo-width:5.89em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.47em;font-size:10pt;" height="16.89" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="81.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E2.m1.pic1.m5" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 20.53 50.4 L 70.5 50.4"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 70.77 50.4)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -89.59 2.62 C -22.38 4.86 16.44 13.04 78.32 37.93"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.92776 0.37315 -0.37315 0.92776 76.72 37.29)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.92776 0.37315 -0.37315 0.92776 78.57 38.04)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -99.09 13.79 L -44.94 37.91"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.91342 0.40701 -0.40701 0.91342 -44.69 38.03)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -99.09 -10.73 L -44.94 -34.86"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.91342 -0.40701 0.40701 0.91342 -44.69 -34.97)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 23.06 -47.35 L 55.16 -47.35"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 55.44 -47.35)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.SSS1.p3.2" class="ltx_p"><span id="S3.SS2.SSS1.p3.2.1" class="ltx_text">Because <math id="S3.SS2.SSS1.p3.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is smooth over <math id="S3.SS2.SSS1.p3.m5" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>, we have (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib53" title="" class="ltx_ref">53</a>, Proposition 3.1]</cite>)</span></p>
<table id="S3.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex16.m1" class="ltx_Math" alttext="H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})\cong H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{Q}}_{p}},\mathbb{Q}_{\ell})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>ℚ</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})\cong H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{Q}}_{p}},\mathbb{Q}_{\ell}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.SSS1.p3.3" class="ltx_p"><span id="S3.SS2.SSS1.p3.3.1" class="ltx_text">Meanwhile, choosing an isomorphism <math id="S3.SS2.SSS1.p3.m6" class="ltx_Math" alttext="\overline{\mathbb{Q}}_{p}\cong\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ℚ</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub><mo>≅</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">\overline{\mathbb{Q}}_{p}\cong\mathbb{C}</annotation></semantics></math>, the comparison theorem gives an isomorphism</span></p>
<table id="S3.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex17.m1" class="ltx_Math" alttext="H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{Q}}_{p}},\mathbb{Q}_{\ell})\cong H^{*}(X_{\mathbb{C}},\mathbb{Q}_{\ell})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>ℚ</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℂ</mi></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{Q}}_{p}},\mathbb{Q}_{\ell})\cong H^{*}(X_{\mathbb{C}},\mathbb{Q}_{\ell}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.SSS1.p3.4" class="ltx_p"><span id="S3.SS2.SSS1.p3.4.1" class="ltx_text">Thus, upon tensoring the vector spaces in (<a href="#S3.E2" title="In Proof. ‣ 3.2.1. Tautological cohomology and polynomial point counts ‣ 3.2. The cycle class map ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>) up to <math id="S3.SS2.SSS1.p3.m7" class="ltx_Math" alttext="\mathbb{Q}_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\mathbb{Q}_{\ell}</annotation></semantics></math>, there is an isomorphism between the two vector spaces in the rightmost column.
This implies that the image of <math id="S3.SS2.SSS1.p3.m8" class="ltx_Math" alttext="R^{*}(X_{\mathbb{Z}})\to H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>ℤ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{*}(X_{\mathbb{Z}})\to H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})</annotation></semantics></math> generates <math id="S3.SS2.SSS1.p3.m9" class="ltx_Math" alttext="H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})</annotation></semantics></math> over <math id="S3.SS2.SSS1.p3.m10" class="ltx_Math" alttext="\mathbb{Q}_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\mathbb{Q}_{\ell}</annotation></semantics></math>.
Hence, the image of <math id="S3.SS2.SSS1.p3.m11" class="ltx_Math" alttext="A^{*}(X_{\mathbb{F}_{p}})\to H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mi>𝔽</mi><mi>p</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{*}(X_{\mathbb{F}_{p}})\to H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})</annotation></semantics></math> generates
<math id="S3.SS2.SSS1.p3.m12" class="ltx_Math" alttext="H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mtext>ét</mtext><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}_{\text{\'{e}t}}(X_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})</annotation></semantics></math> over <math id="S3.SS2.SSS1.p3.m13" class="ltx_Math" alttext="\mathbb{Q}_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\mathbb{Q}_{\ell}</annotation></semantics></math>. Frobenius acts on such elements by powers of <math id="S3.SS2.SSS1.p3.m14" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, so we obtain a polynomial point count.
∎</span></p>
</div>
</div>
<div id="S3.SS2.SSS1.p4" class="ltx_para">
<p id="S3.SS2.SSS1.p4.1" class="ltx_p">By Proposition <a href="#S3.Thmthm15" title="Proposition 3.15. ‣ 3.2.1. Tautological cohomology and polynomial point counts ‣ 3.2. The cycle class map ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.15</span></a>,
Corollary <a href="#S1.Thmthm5" title="Corollary 1.5. ‣ 1.2. Statement of main result ‣ 1. Introduction ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.5</span></a> follows immediately from Theorem <a href="#S1.Thmthm4" title="Theorem 1.4. ‣ 1.2. Statement of main result ‣ 1. Introduction ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a>. Thus, our work gives new proofs of all of the previously known cases establishing <math id="S3.SS2.SSS1.p4.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> has polynomial point count listed in Section <a href="#S1.SS1" title="1.1. Summary of previous work ‣ 1. Introduction ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>. Unlike previous work, we have not determined the polynomial, arguing instead just with our knowledge of generators for cohomology. However, the polynomial could in principle be determined by using Corollary <a href="#S1.Thmthm8" title="Corollary 1.8. ‣ 1.4. The Gorenstein property ‣ 1. Introduction ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.8</span></a> and admcycles <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite> to compute the ranks of <math id="S3.SS2.SSS1.p4.m2" class="ltx_Math" alttext="RH^{*}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">RH^{*}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>.</p>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Filling criteria</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">Given any open subset <math id="S4.p1.m1" class="ltx_Math" alttext="U\subseteq\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊆</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">U\subseteq\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> we say “<math id="S4.p1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> has <math id="S4.p1.m3" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>” when <math id="S4.p1.m4" class="ltx_Math" alttext="A^{*}(U)" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A^{*}(U)</annotation></semantics></math> is generated by restrictions of tautological classes on <math id="S4.p1.m5" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>. We keep track of our progress proving <math id="S4.p1.m6" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math> results with circles on the <math id="S4.p1.m7" class="ltx_Math" alttext="(g,n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g,n)</annotation></semantics></math> grid as in Figure <a href="#S1.F1" title="Figure 1 ‣ 1. Introduction ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>:</p>
<ul id="S4.I1" class="ltx_itemize">
<li id="S4.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S4.I1.ix1.m1" class="ltx_Math" alttext="\circ" display="inline" intent=":literal"><semantics><mo>∘</mo><annotation encoding="application/x-tex">\circ</annotation></semantics></math></span> 
<div id="S4.I1.ix1.p1" class="ltx_para">
<p id="S4.I1.ix1.p1.1" class="ltx_p">An open circle at coordinate <math id="S4.I1.ix1.p1.m1" class="ltx_Math" alttext="(g,n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g,n)</annotation></semantics></math> means <math id="S4.I1.ix1.p1.m2" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> has the CKgP and <math id="S4.I1.ix1.p1.m3" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"> <span id="S4.I1.ix2.pic1" class="ltx_picture"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="100.00" height="100.00" overflow="visible"><g transform="translate(0,100.00) scale(1,-1)"><g transform="translate(0.69,3.32)"><circle fill="#000000" r="3.46" stroke="none" stroke-width="0.4" x="0" y="0"/></g><g transform="translate(0.69,3.32)"><circle fill="#000000" r="1.38" stroke="none" stroke-width="0.4" x="0" y="0"/></g></g></svg></span></span> 
<div id="S4.I1.ix2.p1" class="ltx_para">
<p id="S4.I1.ix2.p1.1" class="ltx_p">A thick open circle at coordinate <math id="S4.I1.ix2.p1.m1" class="ltx_Math" alttext="(g,n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g,n)</annotation></semantics></math> means <math id="S4.I1.ix2.p1.m2" class="ltx_Math" alttext="\mathcal{M}_{g,n}^{\ct}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow><mi>ct</mi></msubsup><annotation encoding="application/x-tex">\mathcal{M}_{g,n}^{\ct}</annotation></semantics></math> has the CKgP and <math id="S4.I1.ix2.p1.m3" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p">A filled circle at coordinate <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="(g,n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g,n)</annotation></semantics></math> means <math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> has the CKgP and <math id="S4.I1.i1.p1.m3" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="S4.p1.2" class="ltx_p">Filled circles are stronger than thick open circles are stronger than open circles: By Lemma <a href="#S3.Thmthm3" title="Lemma 3.3. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> and excision if one of these <math id="S4.p1.m8" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> has the CKgP and <math id="S4.p1.m9" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>, then any open subset of <math id="S4.p1.m10" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> has the CKgP and <math id="S4.p1.m11" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>. By Lemma <a href="#S3.Thmthm14" title="Lemma 3.14. ‣ 3.2. The cycle class map ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.14</span></a>, a filled circle <math id="S4.p1.m12" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math> implies what it meant in Figure <a href="#S1.F1" title="Figure 1 ‣ 1. Introduction ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> of the introduction.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">Considering the forgetful maps <math id="S4.p2.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}\to\overline{\mathcal{M}}_{g,n-1}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}\to\overline{\mathcal{M}}_{g,n-1}</annotation></semantics></math>, which are surjective and proper, we see that
filled circles always come in columns where all circles below a filled circle are also filled.
Indeed, Lemma <a href="#S3.Thmthm10" title="Lemma 3.10. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a> shows that if <math id="S4.p2.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> has CKgP then <math id="S4.p2.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n-1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n-1}</annotation></semantics></math> has CKgP. Meanwhile, the push forward map induces a surjection on Chow groups and sends tautological classes to tautological classes, so if <math id="S4.p2.m4" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> has <math id="S4.p2.m5" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math> then <math id="S4.p2.m6" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n-1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n-1}</annotation></semantics></math> has <math id="S4.p2.m7" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>.</p>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">The inductive nature of the boundary of <math id="S4.p3.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> allows us to convert open circles to filled circles when certain circles to the left (i.e. for lower <math id="S4.p3.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>) are already filled.</p>
</div>
<div id="S4.Thmthm1" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm1.2" class="ltx_text ltx_font_bold">Lemma 4.1</span></span><span id="S4.Thmthm1.3" class="ltx_text ltx_font_bold"> </span>(Filling criterion, version 1)<span id="S4.Thmthm1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm1.p1" class="ltx_para">
<p id="S4.Thmthm1.p1.1" class="ltx_p"><span id="S4.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">Suppose that</span></p>
<ol id="S4.I2" class="ltx_enumerate">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p"><math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n^{\prime}}</annotation></semantics></math><span id="S4.I2.i1.p1.1.1" class="ltx_text ltx_font_italic"> has the CKgP and </span><math id="S4.I2.i1.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math><span id="S4.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> for all </span><math id="S4.I2.i1.p1.m3" class="ltx_Math" alttext="n^{\prime}\leq n" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n</annotation></semantics></math><span id="S4.I2.i1.p1.1.3" class="ltx_text ltx_font_italic"> (we have a column of </span><math id="S4.I2.i1.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="S4.I2.i1.p1.1.4" class="ltx_text ltx_font_italic"> open circles in genus </span><math id="S4.I2.i1.p1.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math><span id="S4.I2.i1.p1.1.5" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p"><math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g^{\prime},n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g^{\prime},n^{\prime}}</annotation></semantics></math><span id="S4.I2.i2.p1.1.1" class="ltx_text ltx_font_italic"> has the CKgP and </span><math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math><span id="S4.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> for all </span><math id="S4.I2.i2.p1.m3" class="ltx_Math" alttext="g^{\prime}\leq g-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>≤</mo><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">g^{\prime}\leq g-1</annotation></semantics></math><span id="S4.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S4.I2.i2.p1.m4" class="ltx_Math" alttext="n^{\prime}\leq n+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n+1</annotation></semantics></math><span id="S4.I2.i2.p1.1.4" class="ltx_text ltx_font_italic"> (all dots in the rectangular region to the left going one row higher are filled)</span></p>
</div></li>
<li id="S4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I2.i3.p1" class="ltx_para">
<p id="S4.I2.i3.p1.1" class="ltx_p"><math id="S4.I2.i3.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g-1,n+2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g-1,n+2}</annotation></semantics></math><span id="S4.I2.i3.p1.1.1" class="ltx_text ltx_font_italic"> has the CKgP and </span><math id="S4.I2.i3.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math><span id="S4.I2.i3.p1.1.2" class="ltx_text ltx_font_italic"> (the dot up two and one to the left is filled).</span></p>
</div></li>
</ol>
<p id="S4.Thmthm1.p1.2" class="ltx_p"><span id="S4.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="S4.Thmthm1.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n^{\prime}}</annotation></semantics></math> has the CKgP and <math id="S4.Thmthm1.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math> for all <math id="S4.Thmthm1.p1.m3" class="ltx_Math" alttext="n^{\prime}\leq n" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n</annotation></semantics></math> (we get a column of <math id="S4.Thmthm1.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> filled circles in genus <math id="S4.Thmthm1.p1.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>).</span></p>
</div>
</div>
<div id="S4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p4" class="ltx_para">
<p id="S4.p4.1" class="ltx_p"><span id="S4.p4.1.1" class="ltx_text">Inducting on <math id="S4.p4.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, we may assume that <math id="S4.p4.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n^{\prime}}</annotation></semantics></math> has the CKgP for <math id="S4.p4.m3" class="ltx_Math" alttext="n^{\prime}\leq n-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n-1</annotation></semantics></math>. Each component of the boundary of <math id="S4.p4.m4" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> is the image of
a gluing map</span></p>
<table id="S4.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g_{1},n_{1}+1}\times\overline{\mathcal{M}}_{g_{2},n_{2}+1}\to\overline{\mathcal{M}}_{g,n}\qquad\text{or}\qquad\overline{\mathcal{M}}_{g-1,n+2}\to\overline{\mathcal{M}}_{g,n}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><mspace style="width:2em;" width="2em"></mspace><mtext>or</mtext><mspace style="width:2em;" width="2em"></mspace><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g_{1},n_{1}+1}\times\overline{\mathcal{M}}_{g_{2},n_{2}+1}\to\overline{\mathcal{M}}_{g,n}\qquad\text{or}\qquad\overline{\mathcal{M}}_{g-1,n+2}\to\overline{\mathcal{M}}_{g,n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p4.2" class="ltx_p"><span id="S4.p4.2.1" class="ltx_text">where <math id="S4.p4.m5" class="ltx_Math" alttext="g_{1}+g_{2}=g" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>+</mo><msub><mi>g</mi><mn>2</mn></msub></mrow><mo>=</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">g_{1}+g_{2}=g</annotation></semantics></math> and <math id="S4.p4.m6" class="ltx_Math" alttext="n_{1}+n_{2}=n" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msub><mi>n</mi><mn>2</mn></msub></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n_{1}+n_{2}=n</annotation></semantics></math>.
Note that if <math id="S4.p4.m7" class="ltx_Math" alttext="g_{1}=g" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>=</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">g_{1}=g</annotation></semantics></math>, then
<math id="S4.p4.m8" class="ltx_Math" alttext="g_{2}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g_{2}=0</annotation></semantics></math>, so <math id="S4.p4.m9" class="ltx_Math" alttext="n_{2}\geq 2" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n_{2}\geq 2</annotation></semantics></math> and hence <math id="S4.p4.m10" class="ltx_Math" alttext="n_{1}+1\leq n-1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n_{1}+1\leq n-1</annotation></semantics></math>.
Thus, the assumptions (1) – (3) and our inductive hypothesis ensure that all of the relevant <math id="S4.p4.m11" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g^{\prime},n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g^{\prime},n^{\prime}}</annotation></semantics></math> used above have the CKgP and <math id="S4.p4.m12" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>.
By Lemmas <a href="#S3.Thmthm2" title="Lemma 3.2. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> and <a href="#S3.Thmthm10" title="Lemma 3.10. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a>, we see that every component of the boundary of <math id="S4.p4.m13" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> has CKgP. To see classes supported there are tautological,
consider the diagram</span></p><span class="ltx_inline-block"><svg id="S4.p4.pic1" class="ltx_picture ltx_centering" height="73.84" overflow="visible" style="vertical-align:-36.92px" version="1.1" viewBox="0 0 493.69 73.84" width="493.69"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,73.84) matrix(1 0 0 -1 0 0) translate(246.85,0) translate(0,36.92)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -246.85 -27.9)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 73.83)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.44)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(90.29,0) matrix(1.0 0.0 0.0 1.0 -84.33 0)"><foreignObject style="--ltx-fo-width:12.19em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="168.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.p4.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces R^{*}(\overline{\mathcal{M}}_{g_{1},n_{1}+1})\otimes R^{*}(\overline{\mathcal{M}}_{g_{2},n_{2}+1})}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces R^{*}(\overline{\mathcal{M}}_{g_{1},n_{1}+1})\otimes R^{*}(\overline{\mathcal{M}}_{g_{2},n_{2}+1})}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 180.58 0) translate(123.26,0) matrix(1.0 0.0 0.0 1.0 -84.1 0)"><foreignObject style="--ltx-fo-width:12.16em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="168.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.p4.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A^{*}(\overline{\mathcal{M}}_{g_{1},n_{1}+1})\otimes A^{*}(\overline{\mathcal{M}}_{g_{2},n_{2}+1})}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi>A</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A^{*}(\overline{\mathcal{M}}_{g_{1},n_{1}+1})\otimes A^{*}(\overline{\mathcal{M}}_{g_{2},n_{2}+1})}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 64.81)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 197.41 0) translate(106.44,0) matrix(1.0 0.0 0.0 1.0 -67.27 0)"><foreignObject style="--ltx-fo-width:9.72em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="134.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.p4.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A^{*}(\overline{\mathcal{M}}_{g_{1},n_{1}+1}\times\overline{\mathcal{M}}_{g_{2},n_{2}+1})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>g</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A^{*}(\overline{\mathcal{M}}_{g_{1},n_{1}+1}\times\overline{\mathcal{M}}_{g_{2},n_{2}+1})}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 393.9 0) translate(66.5,0) matrix(1.0 0.0 0.0 1.0 -27.34 0)"><foreignObject style="--ltx-fo-width:3.95em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="54.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.p4.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces A^{*}(\overline{\mathcal{M}}_{g,n}).}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces A^{*}(\overline{\mathcal{M}}_{g,n}).}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -65.99 24.94 L -33.89 24.94"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -35.6 24.94)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -33.61 24.94)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 57 12.18 L 57 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 57 -9.91)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 57 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 130.5 -24.44 L 179.43 -24.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 179.7 -24.44)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span>
<p id="S4.p4.3" class="ltx_p"><span id="S4.p4.3.1" class="ltx_text">The first horizontal arrow is surjective because the moduli spaces have <math id="S4.p4.m14" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>. The vertical arrow is surjective because they have the CKgP.
The image of the last horizontal arrow is all cycles supported on this boundary component. Because the first two arrows are surjections, the image of the last map is the same as the image of the composition. Finally, the image of the composition consists of tautological classes by the definition of the tautological rings.</span></p>
</div>
<div id="S4.p5" class="ltx_para">
<p id="S4.p5.1" class="ltx_p"><span id="S4.p5.1.1" class="ltx_text">A similar argument holds for the self-glue boundary stratum. We have</span></p>
<table id="S4.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex2.m1" class="ltx_Math" alttext="R^{*}(\overline{\mathcal{M}}_{g-1,n+2})\twoheadrightarrow A^{*}(\overline{\mathcal{M}}_{g-1,n+2})\rightarrow A^{*}(\overline{\mathcal{M}}_{g,n})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↠</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R^{*}(\overline{\mathcal{M}}_{g-1,n+2})\twoheadrightarrow A^{*}(\overline{\mathcal{M}}_{g-1,n+2})\rightarrow A^{*}(\overline{\mathcal{M}}_{g,n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p5.2" class="ltx_p"><span id="S4.p5.2.1" class="ltx_text">The image of the second map is all cycles supported on this boundary stratum. The image of the composition consists of tautological classes by definition of the tautological rings.
∎</span></p>
</div>
</div>
<div id="S4.p6" class="ltx_para">
<p id="S4.p6.1" class="ltx_p">Iterated use of Lemma <a href="#S4.Thmthm1" title="Lemma 4.1 (Filling criterion, version 1). ‣ 4. Filling criteria ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> tells us that if we have all open circles in a
region bounded by the axes, a vertical line, and a line of slope <math id="S4.p6.m1" class="ltx_Math" alttext="-2" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">-2</annotation></semantics></math>, then they can all be converted to filled circles.</p>
</div>
<div id="S4.3" class="ltx_logical-block">
      
