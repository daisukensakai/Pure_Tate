<td id="S1.Thmthm4.p2.1.6.1" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.Thmthm4.p2.1.6.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#FFFFFF;"><math id="S1.Thmthm4.m33" class="ltx_Math" alttext="\circ" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FFFFFF;" mathcolor="#FFFFFF">∘</mo><annotation encoding="application/x-tex">\circ</annotation></semantics></math></span><span id="S1.Thmthm4.p2.1.6.1.2" class="ltx_text ltx_font_italic"> </span><math id="S1.Thmthm4.m34" class="ltx_Math" alttext="A^{*}(\mathcal{M}_{g,n})=R^{*}(\mathcal{M}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\mathcal{M}_{g,n})=R^{*}(\mathcal{M}_{g,n})</annotation></semantics></math><span id="S1.Thmthm4.p2.1.6.1.3" class="ltx_text ltx_font_italic"> </span><span id="S1.Thmthm4.p2.1.6.1.4" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#FFFFFF;"> for <math id="S1.Thmthm4.m35" class="ltx_Math" alttext="n\leq" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#FFFFFF;" mathcolor="#FFFFFF">n</mi><mo style="--ltx-fg-color:#FFFFFF;" mathcolor="#FFFFFF">≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">n\leq</annotation></semantics></math></span></td>
