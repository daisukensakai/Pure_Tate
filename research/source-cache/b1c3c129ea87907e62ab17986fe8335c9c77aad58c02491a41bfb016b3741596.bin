rm="matrix(1 0 0 -1 0 4.17)" width="10.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S10.E2.m1.pic1.m9" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\sigma_{i}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">σ</mi><mi mathsize="0.710em">i</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\sigma_{i}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -54.31 -23.05 L -22.21 -23.05"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -21.93 -23.05)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 30.11 -23.05 L 68.88 -23.05"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 69.16 -23.05)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
