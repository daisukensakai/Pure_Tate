"M 31.5 62.99 M 33.71 62.99 C 33.71 64.21 32.72 65.21 31.5 65.21 C 30.27 65.21 29.28 64.21 29.28 62.99 C 29.28 61.77 30.27 60.78 31.5 60.78 C 32.72 60.78 33.71 61.77 33.71 62.99 Z M 31.5 62.99"></path><path d="M 31.5 78.74 M 33.71 78.74 C 33.71 79.96 32.72 80.95 31.5 80.95 C 30.27 80.95 29.28 79.96 29.28 78.74 C 29.28 77.52 30.27 76.53 31.5 76.53 C 32.72 76.53 33.71 77.52 33.71 78.74 Z M 31.5 78.74"></path><path d="M 31.5 94.49 M 33.71 94.49 C 33.71 95.71 32.72 96.7 31.5 96.7 C 30.27 96.7 29.28 95.71 29.28 94.49 C 29.28 93.26 30.27 92.27 31.5 92.27 C 32.72 92.27 33.71 93.26 33.71 94.49 Z M 31.5 94.49"></path><path d="M 31.5 110.23 M 33.71 110.23 C 33.71 111.46 32.72 112.45 31.5 112.45 C 30.27 112.45 29.28 111.46 29.28 110.23 C 29.28 109.01 30.27 108.02 31.5 108.02 C 32.72 108.02 33.71 109.01 33.71 110.23 Z M 31.5 110.23"></path><path d="M 31.5 125.98 M 33.71 125.98 C 33.71 127.21 32.72 128.2 31.5 128.2 C 30.27 128.2 29.28 127.21 29.28 125.98 C 29.28 124.76 30.27 123.77 31.5 123.77 C 32.72 123.77 33.71 124.76 33.71 125.98 Z M 31.5 125.98"></path><path d="M 47.24 0 M 49.46 0 C 49.46 1.22 48.47 2.21 47.24 2.21 C 46.02 2.21 45.03 1.22 45.03 0 C 45.03 -1.22 46.02 -2.21 47.24 -2.21 C 48.47 -2.21 49.46 -1.22 49.46 0 Z M 47.24 0"></path><path d="M 47.24 15.75 M 49.46 15.75 C 49.46 16.97 48.47 17.96 47.24 17.96 C 46.02 17.96 45.03 16.97 45.03 15.75 C 45.03 14.53 46.02 13.53 47.24 13.53 C 48.47 13.53 49.46 14.53 49.46 15.75 Z M 47.24 15.75"></path><path d="M 47.24 31.5 M 49.46 31.5 C 49.46 32.72 48.47 33.71 47.24 33.71 C 46.02 33.71 45.03 32.72 45.03 31.5 C 45.03 30.27 46.02 29.28 47.24 29.28 C 48.47 29.28 49.46 30.27 49.46 31.5 Z M 47.24 31.5"></path><path d="M 47.24 47.24 M 49.46 47.24 C 49.46 48.47 48.47 49.46 47.24 49.46 C 46.02 49.46 45.03 48.47 45.03 47.24 C 45.03 46.02 46.02 45.03 47.24 45.03 C 48.47 45.03 49.46 46.02 49.46 47.24 Z M 47.24 47.24"></path><path d="M 47.24 62.99 M 49.46 62.99 C 49.46 64.21 48.47 65.21 47.24 65.21 C 46.02 65.21 45.03 64.21 45.03 62.99 C 45.03 61.77 46.02 60.78 47.24 60.78 C 48.47 60.78 49.46 61.77 49.46 62.99 Z M 47.24 62.99"></path><path d="M 47.24 78.74 M 49.46 78.74 C 49.46 79.96 48.47 80.95 47.24 80.95 C 46.02 80.95 45.03 79.96 45.03 78.74 C 45.03 77.52 46.02 76.53 47.24 76.53 C 48.47 76.53 49.46 77.52 49.46 78.74 Z M 47.24 78.74"></path><path d="M 47.24 94.49 M 49.46 94.49 C 49.46 95.71 48.47 96.7 47.24 96.7 C 46.02 96.7 45.03 95.71 45.03 94.49 C 45.03 93.26 46.02 92.27 47.24 92.27 C 48.47 92.27 49.46 93.26 49.46 94.49 Z M 47.24 94.49"></path><path d="M 62.99 0 M 65.21 0 C 65.21 1.22 64.21 2.21 62.99 2.21 C 61.77 2.21 60.78 1.22 60.78 0 C 60.78 -1.22 61.77 -2.21 62.99 -2.21 C 64.21 -2.21 65.21 -1.22 65.21 0 Z M 62.99 0"></path><path d="M 62.99 15.75 M 65.21 15.75 C 65.21 16.97 64.21 17.96 62.99 17.96 C 61.77 17.96 60.78 16.97 60.78 15.75 C 60.78 14.53 61.77 13.53 62.99 13.53 C 64.21 13.53 65.21 14.53 65.21 15.75 Z M 62.99 15.75"></path><path d="M 62.99 31.5 M 65.21 31.5 C 65.21 32.72 64.21 33.71 62.99 33.71 C 61.77 33.71 60.78 32.72 60.78 31.5 C 60.78 30.27 61.77 29.28 62.99 29.28 C 64.21 29.28 65.21 30.27 65.21 31.5 Z M 62.99 31.5"></path><path d="M 62.99 47.24 M 65.21 47.24 C 65.21 48.47 64.21 49.46 62.99 49.46 C 61.77 49.46 60.78 48.47 60.78 47.24 C 60.78 46.02 61.77 45.03 62.99 45.03 C 64.21 45.03 65.21 46.02 65.21 47.24 Z M 62.99 47.24"></path><path d="M 62.99 62.99 M 65.21 62.99 C 65.21 64.21 64.21 65.21 62.99 65.21 C 61.77 65.21 60.78 64.21 60.78 62.99 C 60.78 61.77 61.77 60.78 62.99 60.78 C 64.21 60.78 65.21 61.77 65.21 62.99 Z M 62.99 62.99"></path><path d="M 78.74 0 M 80.95 0 C 80.95 1.22 79.96 2.21 78.74 2.21 C 77.52 2.21 76.53 1.22 76.53 0 C 76.53 -1.22 77.52 -2.21 78.74 -2.21 C 79.96 -2.21 80.95 -1.22 80.95 0 Z M 78.74 0"></path><path d="M 78.74 15.75 M 80.95 15.75 C 80.95 16.97 79.96 17.96 78.74 17.96 C 77.52 17.96 76.53 16.97 76.53 15.75 C 76.53 14.53 77.52 13.53 78.74 13.53 C 79.96 13.53 80.95 14.53 80.95 15.75 Z M 78.74 15.75"></path><path d="M 78.74 31.5 M 80.95 31.5 C 80.95 32.72 79.96 33.71 78.74 33.71 C 77.52 33.71 76.53 32.72 76.53 31.5 C 76.53 30.27 77.52 29.28 78.74 29.28 C 79.96 29.28 80.95 30.27 80.95 31.5 Z M 78.74 31.5"></path><path d="M 94.49 0 M 96.7 0 C 96.7 1.22 95.71 2.21 94.49 2.21 C 93.26 2.21 92.27 1.22 92.27 0 C 92.27 -1.22 93.26 -2.21 94.49 -2.21 C 95.71 -2.21 96.7 -1.22 96.7 0 Z M 94.49 0"></path></g></svg></span>
</div>
</div>
<div id="S4.Thmthm2" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm2.2" class="ltx_text ltx_font_bold">Lemma 4.2</span></span><span id="S4.Thmthm2.3" class="ltx_text ltx_font_bold"> </span>(Filling criterion, version 2)<span id="S4.Thmthm2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm2.p1" class="ltx_para">
<p id="S4.Thmthm2.p1.1" class="ltx_p"><span id="S4.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">Suppose that</span></p>
<ol id="S4.I3" class="ltx_enumerate">
<li id="S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I3.i1.p1" class="ltx_para">
<p id="S4.I3.i1.p1.1" class="ltx_p"><math id="S4.I3.i1.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n^{\prime}}</annotation></semantics></math><span id="S4.I3.i1.p1.1.1" class="ltx_text ltx_font_italic"> has the CKgP and </span><math id="S4.I3.i1.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math><span id="S4.I3.i1.p1.1.2" class="ltx_text ltx_font_italic"> for all </span><math id="S4.I3.i1.p1.m3" class="ltx_Math" alttext="n^{\prime}\leq n" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n</annotation></semantics></math><span id="S4.I3.i1.p1.1.3" class="ltx_text ltx_font_italic"> (we have a column of </span><math id="S4.I3.i1.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="S4.I3.i1.p1.1.4" class="ltx_text ltx_font_italic"> open circles in genus </span><math id="S4.I3.i1.p1.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math><span id="S4.I3.i1.p1.1.5" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I3.i2.p1" class="ltx_para">
<p id="S4.I3.i2.p1.1" class="ltx_p"><math id="S4.I3.i2.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g^{\prime},n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g^{\prime},n^{\prime}}</annotation></semantics></math><span id="S4.I3.i2.p1.1.1" class="ltx_text ltx_font_italic"> has the CKgP and </span><math id="S4.I3.i2.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math><span id="S4.I3.i2.p1.1.2" class="ltx_text ltx_font_italic"> for all </span><math id="S4.I3.i2.p1.m3" class="ltx_Math" alttext="g^{\prime}\leq g-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>≤</mo><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">g^{\prime}\leq g-1</annotation></semantics></math><span id="S4.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S4.I3.i2.p1.m4" class="ltx_Math" alttext="n^{\prime}\leq n+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n+1</annotation></semantics></math><span id="S4.I3.i2.p1.1.4" class="ltx_text ltx_font_italic"> (all dots in the rectangular region to the left going one row higher are filled)</span></p>
</div></li>
<li id="S4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I3.i3.p1" class="ltx_para">
<p id="S4.I3.i3.p1.1" class="ltx_p"><math id="S4.I3.i3.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}\smallsetminus\Delta_{\mathrm{dn}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>∖</mo><msub><mi mathvariant="normal">Δ</mi><mi>dn</mi></msub></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}\smallsetminus\Delta_{\mathrm{dn}}</annotation></semantics></math><span id="S4.I3.i3.p1.1.1" class="ltx_text ltx_font_italic"> has the CKgP and </span><math id="S4.I3.i3.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math><span id="S4.I3.i3.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S4.Thmthm2.p1.2" class="ltx_p"><span id="S4.Thmthm2.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="S4.Thmthm2.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n^{\prime}}</annotation></semantics></math> has the CKgP and <math id="S4.Thmthm2.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math> for all <math id="S4.Thmthm2.p1.m3" class="ltx_Math" alttext="n^{\prime}\leq n" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n</annotation></semantics></math> (we get a column of <math id="S4.Thmthm2.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> filled circles in genus <math id="S4.Thmthm2.p1.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>).</span></p>
</div>
</div>
<div id="S4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p10" class="ltx_para">
<p id="S4.p10.1" class="ltx_p"><span id="S4.p10.1.1" class="ltx_text">Arguing as in Lemma <a href="#S4.Thmthm1" title="Lemma 4.1 (Filling criterion, version 1). ‣ 4. Filling criteria ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, assumptions (1) and (2) ensure that all classes supported on boundary components for curves with a disconnecting node are tautological and such boundary components have the CKgP. Using excision, part (3) completes the result.
∎</span></p>
</div>
</div>
<div id="S4.p11" class="ltx_para">
<p id="S4.p11.1" class="ltx_p">Our results with <math id="S4.p11.m1" class="ltx_Math" alttext="2g+n&gt;12" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mi>n</mi></mrow><mo>&gt;</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">2g+n&gt;12</annotation></semantics></math> start with <math id="S4.p11.m2" class="ltx_Math" alttext="(g,n)=(2,9)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>9</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(g,n)=(2,9)</annotation></semantics></math> and rely on version 2 of the filling criterion (see Lemma <a href="#S6.Thmthm3" title="Lemma 6.3. ‣ 6. Genus 2 and hyperelliptic curves in general ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.3</span></a>). We also access <math id="S4.p11.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{3,8}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mn>8</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{3,8}</annotation></semantics></math> using version 2 of our filling criterion. In both of these cases, the key idea is to realize that our construction of <math id="S4.p11.m4" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> naturally extends to cover a slightly larger open subset <math id="S4.p11.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> of <math id="S4.p11.m6" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>; then we make adhoc arguments to cover anything we have missed in <math id="S4.p11.m7" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}\smallsetminus(\Delta_{\mathrm{dn}}\cup U)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>dn</mi></msub><mo>∪</mo><mi>U</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}\smallsetminus(\Delta_{\mathrm{dn}}\cup U)</annotation></semantics></math>.
Once we obtain these extra filled circles, Lemma <a href="#S4.Thmthm1" title="Lemma 4.1 (Filling criterion, version 1). ‣ 4. Filling criteria ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> has a “ripple effect” which allows us to fill in other open circles to the right along the line of slope <math id="S4.p11.m8" class="ltx_Math" alttext="-2" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">-2</annotation></semantics></math> through <math id="S4.p11.m9" class="ltx_Math" alttext="(3,8)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>8</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(3,8)</annotation></semantics></math>, eventually resulting in a filled circle for <math id="S4.p11.m10" class="ltx_Math" alttext="\overline{\mathcal{M}}_{7}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mn>7</mn></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{7}</annotation></semantics></math>.</p>
</div>
<div id="S4.p12" class="ltx_para">
<p id="S4.p12.1" class="ltx_p">As the proof of version 2 of the filling criterion suggests, if we focus on the curves where all nodes are disconnecting — in other words the open locus <math id="S4.p12.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n}^{\ct}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow><mi>ct</mi></msubsup><annotation encoding="application/x-tex">\mathcal{M}_{g,n}^{\ct}</annotation></semantics></math> — then we can convert open circles to thick circles along lines of higher slope.</p>
</div>
<div id="S4.Thmthm3" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm3.2" class="ltx_text ltx_font_bold">Lemma 4.3</span></span><span id="S4.Thmthm3.3" class="ltx_text ltx_font_bold"> </span>(Thickening criterion, for compact type)<span id="S4.Thmthm3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm3.p1" class="ltx_para">
<p id="S4.Thmthm3.p1.1" class="ltx_p"><span id="S4.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">Suppose that</span></p>
<ol id="S4.I4" class="ltx_enumerate">
<li id="S4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I4.i1.p1" class="ltx_para">
<p id="S4.I4.i1.p1.1" class="ltx_p"><math id="S4.I4.i1.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n^{\prime}}</annotation></semantics></math><span id="S4.I4.i1.p1.1.1" class="ltx_text ltx_font_italic"> has the CKgP and </span><math id="S4.I4.i1.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math><span id="S4.I4.i1.p1.1.2" class="ltx_text ltx_font_italic"> for all </span><math id="S4.I4.i1.p1.m3" class="ltx_Math" alttext="n^{\prime}\leq n" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n</annotation></semantics></math><span id="S4.I4.i1.p1.1.3" class="ltx_text ltx_font_italic"> (we have a column of </span><math id="S4.I4.i1.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="S4.I4.i1.p1.1.4" class="ltx_text ltx_font_italic"> open circles in genus </span><math id="S4.I4.i1.p1.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math><span id="S4.I4.i1.p1.1.5" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="S4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I4.i2.p1" class="ltx_para">
<p id="S4.I4.i2.p1.1" class="ltx_p"><math id="S4.I4.i2.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{g^{\prime},n^{\prime}}^{\ct}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow><mi>ct</mi></msubsup><annotation encoding="application/x-tex">\mathcal{M}_{g^{\prime},n^{\prime}}^{\ct}</annotation></semantics></math><span id="S4.I4.i2.p1.1.1" class="ltx_text ltx_font_italic"> has the CKgP and </span><math id="S4.I4.i2.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math><span id="S4.I4.i2.p1.1.2" class="ltx_text ltx_font_italic"> for all </span><math id="S4.I4.i2.p1.m3" class="ltx_Math" alttext="g^{\prime}\leq g-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>≤</mo><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">g^{\prime}\leq g-1</annotation></semantics></math><span id="S4.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S4.I4.i2.p1.m4" class="ltx_Math" alttext="n^{\prime}\leq n+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n+1</annotation></semantics></math><span id="S4.I4.i2.p1.1.4" class="ltx_text ltx_font_italic"> (all dots in the rectangular region to the left going one row higher are thick circles)</span></p>
</div></li>
</ol>
<p id="S4.Thmthm3.p1.2" class="ltx_p"><span id="S4.Thmthm3.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="S4.Thmthm3.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n^{\prime}}^{\ct}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow><mi>ct</mi></msubsup><annotation encoding="application/x-tex">\mathcal{M}_{g,n^{\prime}}^{\ct}</annotation></semantics></math> has the CKgP and <math id="S4.Thmthm3.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math> for all <math id="S4.Thmthm3.p1.m3" class="ltx_Math" alttext="n^{\prime}\leq n" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n</annotation></semantics></math> (we get a column of <math id="S4.Thmthm3.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> thick circles in genus <math id="S4.Thmthm3.p1.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>).</span></p>
</div>
</div>
<div id="S4.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p13" class="ltx_para">
<p id="S4.p13.1" class="ltx_p"><span id="S4.p13.1.1" class="ltx_text">As in Lemmas <a href="#S4.Thmthm1" title="Lemma 4.1 (Filling criterion, version 1). ‣ 4. Filling criteria ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> and <a href="#S4.Thmthm2" title="Lemma 4.2 (Filling criterion, version 2). ‣ 4. Filling criteria ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, the assumptions (1) and (2) guarantee that all boundary components of <math id="S4.p13.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n}^{\ct}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow><mi>ct</mi></msubsup><annotation encoding="application/x-tex">\mathcal{M}_{g,n}^{\ct}</annotation></semantics></math> are images under gluing maps of products of moduli spaces that satisfy the CKgP and <math id="S4.p13.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm4" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm4.2" class="ltx_text ltx_font_bold">Remark 4.4</span></span><span id="S4.Thmthm4.3" class="ltx_text ltx_font_bold"> </span>(Column of open circles also gives rational tails)<span id="S4.Thmthm4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm4.p1" class="ltx_para">
<p id="S4.Thmthm4.p1.1" class="ltx_p">We shall soon see that <math id="S4.Thmthm4.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{0,n}</annotation></semantics></math> has the CKgP and <math id="S4.Thmthm4.p1.m2" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math> for all <math id="S4.Thmthm4.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> (Section <a href="#S5.SS1" title="5.1. Genus 
          
            0 ‣ 5. Genus 
        
          0
        
       and 
        
          1 ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>). Each component of the boundary of <math id="S4.Thmthm4.p1.m4" class="ltx_Math" alttext="\mathcal{M}_{g,n}^{\rt}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow><mi>rt</mi></msubsup><annotation encoding="application/x-tex">\mathcal{M}_{g,n}^{\rt}</annotation></semantics></math> is the image of <math id="S4.Thmthm4.p1.m5" class="ltx_Math" alttext="\mathcal{M}_{g,n_{1}+1}^{\rt}\times\overline{\mathcal{M}}_{0,n_{2}+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>rt</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}_{g,n_{1}+1}^{\rt}\times\overline{\mathcal{M}}_{0,n_{2}+1}</annotation></semantics></math>
for some <math id="S4.Thmthm4.p1.m6" class="ltx_Math" alttext="n_{1}+n_{2}=n" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msub><mi>n</mi><mn>2</mn></msub></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n_{1}+n_{2}=n</annotation></semantics></math> with <math id="S4.Thmthm4.p1.m7" class="ltx_Math" alttext="n_{2}\geq 2" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n_{2}\geq 2</annotation></semantics></math>.
Inducting on <math id="S4.Thmthm4.p1.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, it follows that any time we have a column of open circles for <math id="S4.Thmthm4.p1.m9" class="ltx_Math" alttext="\mathcal{M}_{g,n^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n^{\prime}}</annotation></semantics></math> with <math id="S4.Thmthm4.p1.m10" class="ltx_Math" alttext="n^{\prime}\leq n" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n</annotation></semantics></math>, we also get <math id="S4.Thmthm4.p1.m11" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math> and CKgP for <math id="S4.Thmthm4.p1.m12" class="ltx_Math" alttext="\mathcal{M}_{g,n^{\prime}}^{\rt}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><msup><mi>n</mi><mo>′</mo></msup></mrow><mi>rt</mi></msubsup><annotation encoding="application/x-tex">\mathcal{M}_{g,n^{\prime}}^{\rt}</annotation></semantics></math> with <math id="S4.Thmthm4.p1.m13" class="ltx_Math" alttext="n^{\prime}\leq n" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n^{\prime}\leq n</annotation></semantics></math>.</p>
</div>
</div>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5. </span>Genus <math id="S5.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S5.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">In this section, we give a brief overview of past results that have completed the genus <math id="S5.p1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S5.p1.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> columns of our chart.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1. </span>Genus <math id="S5.SS1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">In genus <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, we always have <math id="S5.SS1.p1.m2" class="ltx_Math" alttext="n\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n\geq 3</annotation></semantics></math>. By an automorphism of <math id="S5.SS1.p1.m3" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math>, we can fix the first three marked points at <math id="S5.SS1.p1.m4" class="ltx_Math" alttext="0,1,\infty" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">0,1,\infty</annotation></semantics></math>. Then, <math id="S5.SS1.p1.m5" class="ltx_Math" alttext="\mathcal{M}_{0,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{0,n}</annotation></semantics></math> is isomorphic to a complement of hyperplanes in <math id="S5.SS1.p1.m6" class="ltx_Math" alttext="\mathbb{A}^{n-3}" display="inline" intent=":literal"><semantics><msup><mi>𝔸</mi><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow></msup><annotation encoding="application/x-tex">\mathbb{A}^{n-3}</annotation></semantics></math>. Therefore, <math id="S5.SS1.p1.m7" class="ltx_Math" alttext="A^{*}(\mathcal{M}_{0,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\mathcal{M}_{0,n})</annotation></semantics></math> is generated by the fundamental class <math id="S5.SS1.p1.m8" class="ltx_Math" alttext="[\mathcal{M}_{0,n}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\mathcal{M}_{0,n}]</annotation></semantics></math>, so <math id="S5.SS1.p1.m9" class="ltx_Math" alttext="A^{*}(\mathcal{M}_{0,n})=R^{*}(\mathcal{M}_{0,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\mathcal{M}_{0,n})=R^{*}(\mathcal{M}_{0,n})</annotation></semantics></math>. We also see that <math id="S5.SS1.p1.m10" class="ltx_Math" alttext="\mathcal{M}_{0,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{0,n}</annotation></semantics></math> has the CKgP by Lemma <a href="#S3.Thmthm3" title="Lemma 3.3. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>. The filling criteria of Lemma <a href="#S4.Thmthm1" title="Lemma 4.1 (Filling criterion, version 1). ‣ 4. Filling criteria ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> are satisfied (we just have a column of open circles and nothing to the left). Inducting on <math id="S5.SS1.p1.m11" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, we see that <math id="S5.SS1.p1.m12" class="ltx_Math" alttext="\overline{\mathcal{M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{0,n}</annotation></semantics></math> has CKgP and <math id="S5.SS1.p1.m13" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math> for all <math id="S5.SS1.p1.m14" class="ltx_Math" alttext="n\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n\geq 3</annotation></semantics></math>. The structure of <math id="S5.SS1.p1.m15" class="ltx_Math" alttext="A^{*}(\overline{\mathcal{M}}_{0,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\overline{\mathcal{M}}_{0,n})</annotation></semantics></math> has been determined (integrally, in fact) by Keel <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite>.</p>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2. </span>Genus <math id="S5.SS2.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.1" class="ltx_p">In order to set up inductive arguments using the strategy of Section <a href="#S4" title="4. Filling criteria ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>,
we want to show for each space <math id="S5.SS2.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{1,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,n}</annotation></semantics></math> with <math id="S5.SS2.p1.m2" class="ltx_Math" alttext="1\leq n\leq 10" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">1\leq n\leq 10</annotation></semantics></math> that the following two conditions are satisfied:</p>
<ol id="S5.I1" class="ltx_enumerate">
<li id="S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I1.i1.p1" class="ltx_para">
<p id="S5.I1.i1.p1.1" class="ltx_p">The Chow ring of <math id="S5.I1.i1.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{1,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,n}</annotation></semantics></math> is generated by tautological classes.</p>
</div></li>
<li id="S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I1.i2.p1" class="ltx_para">
<p id="S5.I1.i2.p1.1" class="ltx_p"><math id="S5.I1.i2.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{1,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,n}</annotation></semantics></math> has the CKgP.</p>
</div></li>
</ol>
<p id="S5.SS2.p1.2" class="ltx_p">Applying Lemma <a href="#S4.Thmthm1" title="Lemma 4.1 (Filling criterion, version 1). ‣ 4. Filling criteria ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> and the genus <math id="S5.SS2.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> case above, these conditions imply that <math id="S5.SS2.p1.m4" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,n}</annotation></semantics></math> has the CKgP and <math id="S5.SS2.p1.m5" class="ltx_Math" alttext="A^{*}=R^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">A^{*}=R^{*}</annotation></semantics></math> for <math id="S5.SS2.p1.m6" class="ltx_Math" alttext="1\leq n\leq 10" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">1\leq n\leq 10</annotation></semantics></math>.</p>
</div>
<div id="S5.SS2.p2" class="ltx_para">
<p id="S5.SS2.p2.1" class="ltx_p">To start, Belorousski has computed the Chow ring of <math id="S5.SS2.p2.m1" class="ltx_Math" alttext="\mathcal{M}_{1,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,n}</annotation></semantics></math>, <math id="S5.SS2.p2.m2" class="ltx_Math" alttext="1\leq n\leq 10" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">1\leq n\leq 10</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmthm1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm1.2" class="ltx_text ltx_font_bold">Theorem 5.1</span></span><span id="S5.Thmthm1.3" class="ltx_text ltx_font_bold"> </span>(Belorousski <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>]</cite>)<span id="S5.Thmthm1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm1.p1" class="ltx_para">
<p id="S5.Thmthm1.p1.1" class="ltx_p"><span id="S5.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S5.Thmthm1.p1.m1" class="ltx_Math" alttext="1\leq n\leq 10" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">1\leq n\leq 10</annotation></semantics></math>, we have <math id="S5.Thmthm1.p1.m2" class="ltx_Math" alttext="A^{*}(\mathcal{M}_{1,n})=R^{*}(\mathcal{M}_{1,n})=\mathbb{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">A^{*}(\mathcal{M}_{1,n})=R^{*}(\mathcal{M}_{1,n})=\mathbb{Q}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS2.p3" class="ltx_para">
<p id="S5.SS2.p3.1" class="ltx_p">What remains is to show that <math id="S5.SS2.p3.m1" class="ltx_Math" alttext="\mathcal{M}_{1,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,n}</annotation></semantics></math> has the CKgP. Although not stated explicitly in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>]</cite>, the CKgP actually follows from Belorousski’s proof of Theorem <a href="#S5.Thmthm1" title="Theorem 5.1 (Belorousski []). ‣ 5.2. Genus 
          
            1 ‣ 5. Genus 
        
          0
        
       and 
        
          1 ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, as we now summarize.</p>
</div>
<div id="S5.SS2.p4" class="ltx_para ltx_noindent">
<div id="S5.SS2.p4.1" class="ltx_sectional-block ltx_minipage">
          
<section id="S5.SSx1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><math id="S5.SSx1.m1" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math></h3>

<div id="S5.SSx1.p1" class="ltx_para">
<p id="S5.SSx1.p1.1" class="ltx_p">The coarse moduli space of <math id="S5.SSx1.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{1,1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,1}</annotation></semantics></math> is isomorphic to <math id="S5.SSx1.p1.m2" class="ltx_Math" alttext="\mathbb{A}^{1}" display="inline" intent=":literal"><semantics><msup><mi>𝔸</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{A}^{1}</annotation></semantics></math>. Hence, it has the CKgP by Lemma <a href="#S3.Thmthm5" title="Lemma 3.5. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>.</p>
</div>
</section>
          
<section id="S5.SSx2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><math id="S5.SSx2.m1" class="ltx_Math" alttext="n=2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n=2</annotation></semantics></math></h3>

<div id="S5.SSx2.p1" class="ltx_para">
<p id="S5.SSx2.p1.1" class="ltx_p">Mumford <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">40</a>]</cite> proved that the coarse space of <math id="S5.SSx2.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{1,2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,2}</annotation></semantics></math> is isomorphic to a quotient <math id="S5.SSx2.p1.m2" class="ltx_Math" alttext="U/S_{3}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>/</mo><msub><mi>S</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">U/S_{3}</annotation></semantics></math> where <math id="S5.SSx2.p1.m3" class="ltx_Math" alttext="U\subset\mathbb{A}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><msup><mi>𝔸</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">U\subset\mathbb{A}^{2}</annotation></semantics></math> is open. It follows from Lemma <a href="#S3.Thmthm10" title="Lemma 3.10. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a> that <math id="S5.SSx2.p1.m4" class="ltx_Math" alttext="\mathcal{M}_{1,2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,2}</annotation></semantics></math> has the CKgP.</p>
</div>
</section>
          
<section id="S5.SSx3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><math id="S5.SSx3.m1" class="ltx_Math" alttext="3\leq n\leq 10" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">3\leq n\leq 10</annotation></semantics></math></h3>

<div id="S5.SSx3.p1" class="ltx_para">
<p id="S5.SSx3.p1.1" class="ltx_p">Belorousski finds divisors <math id="S5.SSx3.p1.m1" class="ltx_Math" alttext="D_{i}\subset\mathcal{M}_{1,n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>i</mi></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">D_{i}\subset\mathcal{M}_{1,n}</annotation></semantics></math> for each such <math id="S5.SSx3.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> so that</p>
<ol id="S5.I2" class="ltx_enumerate">
<li id="S5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I2.i1.p1" class="ltx_para">
<p id="S5.I2.i1.p1.1" class="ltx_p">Each <math id="S5.I2.i1.p1.m1" class="ltx_Math" alttext="D_{i}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>i</mi></msub><annotation encoding="application/x-tex">D_{i}</annotation></semantics></math> is isomorphic to an open subset of <math id="S5.I2.i1.p1.m2" class="ltx_Math" alttext="\mathcal{M}_{1,n-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,n-1}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I2.i2.p1" class="ltx_para">
<p id="S5.I2.i2.p1.1" class="ltx_p">The complement <math id="S5.I2.i2.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{1,n}\smallsetminus\bigcup D_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><mo rspace="0.055em">∖</mo><mrow><mo>⋃</mo><msub><mi>D</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{1,n}\smallsetminus\bigcup D_{i}</annotation></semantics></math> is the image under a proper map of an open subset of (a product of) projective spaces.</p>
</div></li>
</ol>
<p id="S5.SSx3.p1.2" class="ltx_p">It thus follows by induction and Lemmas <a href="#S3.Thmthm2" title="Lemma 3.2. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, <a href="#S3.Thmthm3" title="Lemma 3.3. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, <a href="#S3.Thmthm4" title="Lemma 3.4. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>, and <a href="#S3.Thmthm7" title="Lemma 3.7. ‣ 3.1. Basic lemmas ‣ 3. The Chow–Künneth generation property ‣ On the Chow and cohomology rings of moduli spaces of stable curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a> that each <math id="S5.SSx3.p1.m3" class="ltx_Math" alttext="\mathcal{M}_{1,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,n}</annotation></semantics></math> has the CKgP for <math id="S5.SSx3.p1.m4" class="ltx_Math" alttext="n\leq 10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n\leq 10</annotation></semantics></math>.</p>
</div>
</section>
        
</div>
