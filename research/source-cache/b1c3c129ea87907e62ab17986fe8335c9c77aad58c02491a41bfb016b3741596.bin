0.0 0.0 1.0 149.42 -48.16)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span>
<p id="S8.SS2.p8.2" class="ltx_p"><span id="S8.SS2.p8.2.1" class="ltx_text">where the map <math id="S8.SS2.p8.m5" class="ltx_Math" alttext="\mathcal{M}_{g,N}\to\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>N</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}_{g,N}\to\mathcal{M}_{g,n}</annotation></semantics></math> remembers the
<math id="S8.SS2.p8.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> points whose indices were dedicated to marked ramification points in <math id="S8.SS2.p8.m7" class="ltx_Math" alttext="H_{g}(\mu^{1},\ldots,\mu^{m})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>μ</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>μ</mi><mi>m</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{g}(\mu^{1},\ldots,\mu^{m})</annotation></semantics></math>.
Let <math id="S8.SS2.p8.m8" class="ltx_Math" alttext="\mathcal{H}_{k,g}^{s}\subset\mathcal{H}_{k,g}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow><mi>s</mi></msubsup><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>k</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{H}_{k,g}^{s}\subset\mathcal{H}_{k,g}</annotation></semantics></math> denote the open locus of simply branched covers. By construction, the image of</span></p>
