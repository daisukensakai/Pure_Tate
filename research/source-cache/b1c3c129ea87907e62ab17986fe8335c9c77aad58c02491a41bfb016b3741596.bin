verflow="visible" transform="matrix(1 0 0 -1 0 6.41)" width="5.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex3.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces j}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">j</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces j}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -39.76 12.18 L -39.76 -11.62"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -39.76 -11.9)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -36.51 -2.42)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex3.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces f}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">f</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces f}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 20.15 12.18 L -21.49 -12.63"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(-0.85912 -0.51178 0.51178 -0.85912 -21.73 -12.77)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#0