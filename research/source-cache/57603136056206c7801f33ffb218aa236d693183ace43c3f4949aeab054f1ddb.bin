        <mi>Spec</mi>
        <mo>⁡<!-- ⁡ --></mo>
        <mi>A</mi>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle S=\operatorname {Spec} A}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/1e443e0d00ee0c43fa8f6c064a702828b2257fd7" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.671ex; width:11.378ex; height:2.509ex;" alt="{\displaystyle S=\operatorname {Spec} A}"/></span>: there is a finite complex <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt108" id="mwASY" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"0 \\to K^0 \\to K^1 \\to \\cdots \\to K^n \\to 0"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle 0\to K^{0}\to K^{1}\to \cdots \to K^{n}\to 0}">
