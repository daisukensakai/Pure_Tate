          <mi>g</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mo>∗<!-- ∗ --></mo>
          </mrow>
        </msup>
        <mi>R</mi>
        <msub>
          <mi>f</mi>
          <mrow class="MJX-TeXAtom-ORD">
