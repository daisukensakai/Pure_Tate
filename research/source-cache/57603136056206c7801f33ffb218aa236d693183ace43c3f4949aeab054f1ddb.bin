          <mi>g</mi>
          <mrow class="MJX-TeXAtom-ORD">
            <mo>∗<!-- ∗ --></mo>
          </mrow>
          <mo>′</mo>
        </msubsup>
        <mo>∘<!-- ∘ --></mo>
        <msup>
          <mi>g</mi>
          <mrow>
            <mo class="MJX-variant">′</mo>
            <mrow class="MJX-TeXAtom-ORD">
              <mo>∗<!-- ∗ --></mo>
            </mrow>
          </mrow>
        </msup>
      </mstyle>
    </mrow>
