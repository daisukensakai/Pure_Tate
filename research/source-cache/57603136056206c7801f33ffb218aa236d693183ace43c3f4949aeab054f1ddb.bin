</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/09b88c3d72121a0171e72a812cc02066d768b403" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.505ex; width:2.77ex; height:2.843ex;" alt="{\displaystyle -^{\dagger }}"/></span> and <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt171" id="mwAcQ" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\int"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \int }">
