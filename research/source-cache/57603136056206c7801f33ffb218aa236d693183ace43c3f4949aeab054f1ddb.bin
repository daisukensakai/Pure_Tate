<p id="mwaw">Combining this with the above yields</p>

<dl id="mwbA"><dd id="mwbQ"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt38" id="mwbg" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"R^r f_* \\to g_* \\circ R^r f&apos;_* \\circ g&apos;^*."}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle R^{r}f_{*}\to g_{*}\circ R^{r}f'_{*}\circ g'^{*}.}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <msup>
          <mi>R</mi>
