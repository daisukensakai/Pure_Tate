<li id="mwAXk"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt154" id="mwAXo" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"g"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle g}">
