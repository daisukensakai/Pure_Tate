<li about="#cite_note-2" id="cite_note-2" data-mw-footnote-number="2"><span class="mw-cite-backlink" id="mwpQ"><a href="#cite_ref-2" rel="mw:referencedBy" id="mwpg"><span class="mw-linkback-text" id="mwpw">↑</span></a></span> <span id="mw-reference-text-cite_note-2" class="mw-reference-text reference-text">Hartshorne, Ch. III.10.</span></li>
