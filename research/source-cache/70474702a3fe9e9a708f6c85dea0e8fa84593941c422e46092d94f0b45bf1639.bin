<td id="S1.T1.2.10.4" class="ltx_td ltx_nopad_r" style="padding-top:0.7pt;padding-bottom:0.7pt;"></td></tr>
<tr id="S1.T1.2.11" class="ltx_tr">
<td id="S1.T1.2.11.1" class="ltx_td ltx_align_left" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="S1.T1.m23" class="ltx_Math" alttext="2d-j" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">j</mi></mrow><annotation encoding="application/x-tex">2d-j</annotation></semantics></math><span id="S1.T1.2.11.1.1" class="ltx_text" style="font-size:90%;"> for <math id="S1.T1.m24" class="ltx_Math" alttext="j=11,13" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>11</mn></mrow><mo>,</mo><mn>13</mn></mrow><annotation encoding="application/x-tex">j=11,13</annotation></semantics></math></span></td>
<td id="S1.T1.2.11.2" class="ltx_td ltx_align_left" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="S1.T1.m25" class="ltx_Math" alttext="\mathsf{L}^{(2d-j-11)/2}\,\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.900em">𝖫</mi><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">j</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">11</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">2</mn></mrow></msup><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝖲</mi><mn mathsize="0.900em">12</mn></msub></mrow><annotation encoding="application/x-tex">\mathsf{L}^{(2d-j-11)/2}\,\mathsf{S}_{12}</annotation></semantics></math></td>
<td id="S1.T1.2.11.3" class="ltx_td ltx_align_left" style="padding-top:0.7pt;padding-bottom:0.7pt;"><cite class="ltx_cite ltx_citemacro_cite"><span id="S1.T1.2.11.3.1" class="ltx_text" style="font-size:90%;">[</span><a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a><span id="S1.T1.2.11.3.2" class="ltx_text" style="font-size:90%;">]</span></cite></td>
<td id="S1.T1.2.11.4" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="S1.T1.m26" class="ltx_Math" alttext="p\nmid\tau(p)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">∤</mo><mrow><mi mathsize="0.900em">τ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">p</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p\nmid\tau(p)</annotation></semantics></math></td></tr>
<tr id="S1.T1.2.12" class="ltx_tr">
<td id="S1.T1.2.12.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="S1.T1.m27" class="ltx_Math" alttext="2d-15" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">15</mn></mrow><annotation encoding="application/x-tex">2d-15</annotation></semantics></math></td>
<td id="S1.T1.2.12.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="S1.T1.m28" class="ltx_Math" alttext="\mathsf{L}^{(2d-26)/2}\,\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.900em">𝖫</mi><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">26</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">2</mn></mrow></msup><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝖲</mi><mn mathsize="0.900em">12</mn></msub></mrow><annotation encoding="application/x-tex">\mathsf{L}^{(2d-26)/2}\,\mathsf{S}_{12}</annotation></semantics></math><span id="S1.T1.2.12.2.1" class="ltx_text" style="font-size:90%;">,   <math id="S1.T1.m29" class="ltx_Math" alttext="\mathsf{L}^{(2d-30)/2}\,\mathsf{S}_{16}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝖫</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>30</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝖲</mi><mn>16</mn></msub></mrow><annotation encoding="application/x-tex">\mathsf{L}^{(2d-30)/2}\,\mathsf{S}_{16}</annotation></semantics></math></span></td>
<td id="S1.T1.2.12.3" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:0.7pt;padding-bottom:0.7pt;"><cite class="ltx_cite ltx_citemacro_cite"><span id="S1.T1.2.12.3.1" class="ltx_text" style="font-size:90%;">[</span><a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a><span id="S1.T1.2.12.3.2" class="ltx_text" style="font-size:90%;">]</span></cite></td>
<td id="S1.T1.2.12.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="S1.T1.m30" class="ltx_Math" alttext="p\nmid\tau(p)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">∤</mo><mrow><mi mathsize="0.900em">τ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">p</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p\nmid\tau(p)</annotation></semantics></math><span id="S1.T1.2.12.4.1" class="ltx_text" style="font-size:90%;">, <math id="S1.T1.m31" class="ltx_Math" alttext="p\nmid a_{p}(\Delta_{16})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∤</mo><mrow><msub><mi>a</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mn>16</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p\nmid a_{p}(\Delta_{16})</annotation></semantics></math></span></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_table">Table 1. </span>Known cases of the generalized Hodge and Tate conjectures for <math id="S1.T1.m34" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> and <math id="S1.T1.m35" class="ltx_Math" alttext="H^{k}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math>, respectively.</figcaption>
</figure>
<div id="S1.SS2.p3" class="ltx_para">
<p id="S1.SS2.p3.1" class="ltx_p">Thus, the verified picture up to degree <math id="S1.SS2.p3.m1" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math> is that low even degree cohomology is Hodge–Tate, odd cohomology vanishes below degree 11, <math id="S1.SS2.p3.m2" class="ltx_Math" alttext="H^{11}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mn>11</mn></msup><annotation encoding="application/x-tex">H^{11}</annotation></semantics></math> comes from the weight 12 cusp-form motive <math id="S1.SS2.p3.m3" class="ltx_Math" alttext="\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>12</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{12}</annotation></semantics></math>, and <math id="S1.SS2.p3.m4" class="ltx_Math" alttext="H^{13}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mn>13</mn></msup><annotation encoding="application/x-tex">H^{13}</annotation></semantics></math> comes from boundary-supported Tate twists of that motive. Moreover, homology classes in even degrees less than or equal to 14 come from tautological cycles, as do cohomology classes in degrees less than or equal to 6, except possibly for <math id="S1.SS2.p3.m5" class="ltx_Math" alttext="g\in\{7,8,9\}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>7</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>9</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">g\in\{7,8,9\}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">1.3. </span>Structure of the article</h3>

<div id="S1.SS3.p1" class="ltx_para">
<p id="S1.SS3.p1.1" class="ltx_p">The article is organized as follows. Section <a href="#S2" title="2. Hodge and Tate conjectures ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> recalls the Hodge and Tate conjectures and their generalized forms, and explains why moduli spaces of stable curves are a particularly interesting testing ground for these questions. Section <a href="#S3" title="3. Tautologically generated cohomology groups ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> discusses tautological classes and the Arbarello–Cornalba inductive method, leading to the proof of Theorem <a href="#ThmTheorem1" title="Theorem A. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>. Section <a href="#S4" title="4. Inspiration from arithmetic ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> describes the arithmetic predictions that motivate much of the story, especially those arising from the work of Chenevier and Lannes. Section <a href="#S5" title="5. Further results and predictions ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> then proves Theorem <a href="#ThmTheorem2" title="Theorem B. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a> and discusses related conjectures on Chow groups and cycle class maps. Section <a href="#S6" title="6. Future outlook ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> concludes with a selection of open problems and future directions.</p>
</div>
<div id="S1.SS3.p2" class="ltx_para ltx_noindent">
<p id="S1.SS3.p2.1" class="ltx_p"><span id="S1.SS3.p2.1.1" class="ltx_text ltx_font_bold">Acknowledgments.</span> I thank J. Bergström, S. Canning, C. Faber, H. Larson, and J. Milne for helpful comments on a draft of this article, and Q. Yin for illuminating discussions.</p>
</div>
</section>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2. </span>Hodge and Tate conjectures</h2>

<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">We now recall the statements of the conjectures in question and discuss how and why the moduli spaces of stable curves are an interesting test case.</p>
</div>
<section id="S2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.1. </span>The Hodge conjecture</h3>

<div id="S2.SS1.p1" class="ltx_para">
<p id="S2.SS1.p1.1" class="ltx_p">Let <math id="S2.SS1.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a smooth projective variety, or a smooth and proper Deligne–Mumford stack with projective coarse moduli space, over <math id="S2.SS1.p1.m2" class="ltx_Math" alttext="\mathbb{C}" display="inline" intent=":literal"><semantics><mi>ℂ</mi><annotation encoding="application/x-tex">\mathbb{C}</annotation></semantics></math>. The rational singular cohomology group <math id="S2.SS1.p1.m3" class="ltx_Math" alttext="H^{k}(X):=H^{k}(X(\mathbb{C}),\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{k}(X):=H^{k}(X(\mathbb{C}),\mathbb{Q})</annotation></semantics></math> carries a canonical pure Hodge
structure, i.e., a decomposition</p>
<table id="S2.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex4.m1" class="ltx_Math" alttext="H^{k}(X)\otimes\mathbb{C}\simeq\bigoplus_{p+q=k}H^{p,q}(X)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow><mo rspace="0.111em">≃</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>=</mo><mi>k</mi></mrow></munder><mrow><msup><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{k}(X)\otimes\mathbb{C}\simeq\bigoplus_{p+q=k}H^{p,q}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p1.2" class="ltx_p">such that <math id="S2.SS1.p1.m4" class="ltx_Math" alttext="H^{p,q}(X)=\overline{H^{q,p}(X)}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mover accent="true"><mrow><msup><mi>H</mi><mrow><mi>q</mi><mo>,</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">H^{p,q}(X)=\overline{H^{q,p}(X)}</annotation></semantics></math>. This decomposition is functorial for maps between cohomology groups induced by algebraic morphisms.</p>
</div>
<div id="S2.SS1.p2" class="ltx_para">
<p id="S2.SS1.p2.1" class="ltx_p">Let <math id="S2.SS1.p2.m1" class="ltx_Math" alttext="Z^{k}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{k}(X)</annotation></semantics></math> denote the free abelian group on closed irreducible algebraic subsets of codimension <math id="S2.SS1.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> in <math id="S2.SS1.p2.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Elements of <math id="S2.SS1.p2.m4" class="ltx_Math" alttext="Z^{k}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{k}(X)</annotation></semantics></math> are codimension <math id="S2.SS1.p2.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> algebraic cycles.</p>
</div>
<div id="ThmHCx1" class="ltx_theorem ltx_theorem_HC">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="ThmHCx1.2" class="ltx_text ltx_font_bold">Hodge Conjecture</span></span><span id="ThmHCx1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="ThmHCx1.p1" class="ltx_para">
<p id="ThmHCx1.p1.1" class="ltx_p"><span id="ThmHCx1.p1.1.1" class="ltx_text ltx_font_italic">The rational cycle class map</span></p>
<table id="S2.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex5.m1" class="ltx_Math" alttext="\operatorname{cyc}^{k}\colon Z^{k}(X)\otimes\mathbb{Q}\to H^{2k}(X)\cap H^{k,k}(X)" display="block" intent=":literal"><semantics><mrow><msup><mi>cyc</mi><mi>k</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msup><mi>Z</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℚ</mi></mrow><mo stretchy="false">→</mo><mrow><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><msup><mi>H</mi><mrow><mi>k</mi><mo>,</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{cyc}^{k}\colon Z^{k}(X)\otimes\mathbb{Q}\to H^{2k}(X)\cap H^{k,k}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="ThmHCx1.p1.2" class="ltx_p"><span id="ThmHCx1.p1.2.1" class="ltx_text ltx_font_italic">is surjective for all <math id="ThmHCx1.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.SS1.p3" class="ltx_para ltx_noindent">
<p id="S2.SS1.p3.1" class="ltx_p">The Hodge conjecture is known in only a few important cases. First, the conjecture is true for codimension <math id="S2.SS1.p3.m1" class="ltx_Math" alttext="k=1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k=1</annotation></semantics></math>; this is the Lefschetz <math id="S2.SS1.p3.m2" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math>-theorem. Using the hard Lefschetz theorem, it follows that the Hodge conjecture holds when <math id="S2.SS1.p3.m3" class="ltx_Math" alttext="\dim(X)\leq 3" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\dim(X)\leq 3</annotation></semantics></math>. Also, by intersection theory, the image of <math id="S2.SS1.p3.m4" class="ltx_Math" alttext="\bigoplus_{k}\operatorname{cyc}^{k}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⨁</mo><mi>k</mi></msub><msup><mi>cyc</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\bigoplus_{k}\operatorname{cyc}^{k}</annotation></semantics></math> is a subring of <math id="S2.SS1.p3.m5" class="ltx_Math" alttext="H^{*}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(X)</annotation></semantics></math>. In particular, the Hodge conjecture holds for <math id="S2.SS1.p3.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> whenever the subring <math id="S2.SS1.p3.m7" class="ltx_Math" alttext="\bigoplus_{k}\big(H^{2k}(X)\cap H^{k,k}(X)\big)" display="inline" intent=":literal"><semantics><mrow><msub><mo>⨁</mo><mi>k</mi></msub><mrow><mo lspace="0em" maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><msup><mi>H</mi><mrow><mi>k</mi><mo>,</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bigoplus_{k}\big(H^{2k}(X)\cap H^{k,k}(X)\big)</annotation></semantics></math> is generated by <math id="S2.SS1.p3.m8" class="ltx_Math" alttext="H^{2}(X)\cap H^{1,1}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><msup><mi>H</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{2}(X)\cap H^{1,1}(X)</annotation></semantics></math>. In particular, this is true for very general abelian varieties in each dimension <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx50" title="" class="ltx_ref">Mat58</a>]</cite>. The Hodge conjecture also holds when <math id="S2.SS1.p3.m9" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is cellular (i.e. paved by locally closed subvarieties isomorphic to affine spaces), a class that includes Grassmannians, flag varieties, and smooth projective toric varieties <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Ful98</a>, Example 19.1.11]</cite>, and more generally for smooth and proper linear varieties, in the sense of Totaro <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx73" title="" class="ltx_ref">Tot14</a>, Theorem 3]</cite>, and for smooth and proper Deligne–Mumford stacks with the Chow–Künneth generation property <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx17" title="" class="ltx_ref">CL24</a>, Lemma 3.11]</cite>. In addition, a recent preprint of Markman proves the Hodge conjecture for abelian varieties of dimension at most 5 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx49" title="" class="ltx_ref">Mar25</a>]</cite>.</p>
</div>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.2. </span>The Tate conjecture</h3>

<div id="S2.SS2.p1" class="ltx_para">
<p id="S2.SS2.p1.1" class="ltx_p">Let <math id="S2.SS2.p1.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> be a smooth projective variety, or a smooth and proper Deligne–Mumford stack with projective coarse moduli space, over a finitely generated field <math id="S2.SS2.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. For instance, <math id="S2.SS2.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> might be a number field, a finite field, or the function field of a variety over a finite field. The Galois group of <math id="S2.SS2.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is the automorphism group of its separable closure</p>
<table id="S2.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex6.m1" class="ltx_Math" alttext="\operatorname{Gal}:=\operatorname{Gal}(L^{\mathrm{s}}/L)." display="block" intent=":literal"><semantics><mrow><mrow><mi>Gal</mi><mo>:=</mo><mrow><mi>Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>L</mi><mi>s</mi></msup><mo>/</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Gal}:=\operatorname{Gal}(L^{\mathrm{s}}/L).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p1.2" class="ltx_p">Let <math id="S2.SS2.p1.m5" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> be a prime invertible in <math id="S2.SS2.p1.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, i.e., <math id="S2.SS2.p1.m7" class="ltx_Math" alttext="\ell\neq\mathrm{char}(L)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≠</mo><mrow><mi>char</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell\neq\mathrm{char}(L)</annotation></semantics></math>.</p>
</div>
<div id="ThmTCx1" class="ltx_theorem ltx_theorem_TC">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="ThmTCx1.2" class="ltx_text ltx_font_bold">Tate Conjecture</span></span><span id="ThmTCx1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="ThmTCx1.p1" class="ltx_para">
<p id="ThmTCx1.p1.1" class="ltx_p"><span id="ThmTCx1.p1.1.1" class="ltx_text ltx_font_italic">The <math id="ThmTCx1.p1.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic rational cycle class map</span></p>
<table id="S2.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex7.m1" class="ltx_Math" alttext="\operatorname{cyc}^{k}_{\ell}\colon Z^{k}(Y)\otimes\mathbb{Q}_{\ell}\to H^{2k}(Y_{L^{s}},\mathbb{Q}_{\ell}(k))^{\operatorname{Gal}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>cyc</mi><mi mathvariant="normal">ℓ</mi><mi>k</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msup><mi>Z</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><mrow><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>Gal</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{cyc}^{k}_{\ell}\colon Z^{k}(Y)\otimes\mathbb{Q}_{\ell}\to H^{2k}(Y_{L^{s}},\mathbb{Q}_{\ell}(k))^{\operatorname{Gal}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="ThmTCx1.p1.2" class="ltx_p"><span id="ThmTCx1.p1.2.1" class="ltx_text ltx_font_italic">is surjective for all <math id="ThmTCx1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.SS2.p2" class="ltx_para ltx_noindent">
<p id="S2.SS2.p2.1" class="ltx_p">Like the Hodge conjecture, the Tate conjecture is wide open in general, and known in only a few important cases. In particular, it is known for <math id="S2.SS2.p2.m1" class="ltx_Math" alttext="k=1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k=1</annotation></semantics></math> when <math id="S2.SS2.p2.m2" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is an abelian variety <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx72" title="" class="ltx_ref">Tat66</a>, <a href="#bib.bibx27" title="" class="ltx_ref">Fal83</a>, <a href="#bib.bibx77" title="" class="ltx_ref">Zar14</a>]</cite>, and when <math id="S2.SS2.p2.m3" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is a <math id="S2.SS2.p2.m4" class="ltx_Math" alttext="K3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K3</annotation></semantics></math> surface <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx57" title="" class="ltx_ref">MP15</a>, <a href="#bib.bibx44" title="" class="ltx_ref">KMP16</a>, <a href="#bib.bibx58" title="" class="ltx_ref">MP20</a>]</cite>.</p>
</div>
<div id="S2.SS2.p3" class="ltx_para">
<p id="S2.SS2.p3.1" class="ltx_p">The Hodge and Tate conjectures are two keystones in an intricate structure of interrelated conjectures about algebraic cycles and motivic structures on cohomology, all tied to the expected properties of categories of motives, as envisioned by Grothendieck. See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx4" title="" class="ltx_ref">And04</a>]</cite> for a comprehensive introduction to this topic, as well as the more recent survey <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx74" title="" class="ltx_ref">Tot17</a>]</cite> highlighting the role of the Tate conjecture.</p>
</div>
<div id="S2.SS2.p4" class="ltx_para">
<p id="S2.SS2.p4.1" class="ltx_p">One conjecture closely linked to the Tate conjecture is the expectation that the Galois representations arising in the cohomology of smooth projective varieties should decompose as direct sums of irreducible representations.</p>
</div>
<div id="ThmSSCx1" class="ltx_theorem ltx_theorem_SSC">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="ThmSSCx1.2" class="ltx_text ltx_font_bold">Semisimplicity Conjecture</span></span><span id="ThmSSCx1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="ThmSSCx1.p1" class="ltx_para">
<p id="ThmSSCx1.p1.1" class="ltx_p"><span id="ThmSSCx1.p1.1.1" class="ltx_text ltx_font_italic">The Galois action on <math id="ThmSSCx1.p1.m1" class="ltx_Math" alttext="H^{*}(Y_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(Y_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math> is semisimple.</span></p>
</div>
</div>
<div id="S2.SS2.p5" class="ltx_para ltx_noindent">
<p id="S2.SS2.p5.1" class="ltx_p">Other closely related conjectures include the Grothendieck standard conjectures. There are many known implications among various cases of these conjectures. For instance, when <math id="S2.SS2.p5.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has characteristic zero, the Tate conjecture implies the semisimplicity conjecture <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx56" title="" class="ltx_ref">Moo19</a>]</cite>. Also, the Hodge conjecture for CM abelian varieties implies the Tate conjecture and the Grothendieck standard conjectures for abelian varieties over finite fields <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx53" title="" class="ltx_ref">Mil99</a>, <a href="#bib.bibx54" title="" class="ltx_ref">Mil02</a>]</cite>. Furthermore, the Grothendieck standard conjectures follow from the Hodge conjecture in characteristic zero <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx43" title="" class="ltx_ref">Kle94</a>]</cite>.</p>
</div>
<div id="S2.SS2.p6" class="ltx_para">
<p id="S2.SS2.p6.1" class="ltx_p">For the applications in this article, the most relevant strengthenings are the generalized Hodge and Tate conjectures. Rather than focusing only on when even degree classes arise from algebraic cycles, they ask when a given substructure in cohomology must be supported on a closed subset of specified codimension. We begin with the Hodge-theoretic formulation.</p>
</div>
<div id="ThmGHCx1" class="ltx_theorem ltx_theorem_GHC">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="ThmGHCx1.2" class="ltx_text ltx_font_bold">Generalized Hodge Conjecture</span></span><span id="ThmGHCx1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="ThmGHCx1.p1" class="ltx_para">
<p id="ThmGHCx1.p1.1" class="ltx_p"><span id="ThmGHCx1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="ThmGHCx1.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a smooth projective algebraic variety, or a smooth and proper Deligne–Mumford stack with projective coarse moduli space, over <math id="ThmGHCx1.p1.m2" class="ltx_Math" alttext="\mathbb{C}" display="inline" intent=":literal"><semantics><mi>ℂ</mi><annotation encoding="application/x-tex">\mathbb{C}</annotation></semantics></math>. Let <math id="ThmGHCx1.p1.m3" class="ltx_Math" alttext="V\subset H^{j}(X)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⊂</mo><mrow><msup><mi>H</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V\subset H^{j}(X)</annotation></semantics></math> be a rational sub-Hodge structure, with <math id="ThmGHCx1.p1.m4" class="ltx_Math" alttext="V\otimes\mathbb{C}=\bigoplus_{p+q=j}V^{p,q}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>=</mo><mi>j</mi></mrow></msub><msup><mi>V</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">V\otimes\mathbb{C}=\bigoplus_{p+q=j}V^{p,q}</annotation></semantics></math>. If <math id="ThmGHCx1.p1.m5" class="ltx_Math" alttext="V^{p,q}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>V</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">V^{p,q}=0</annotation></semantics></math> for <math id="ThmGHCx1.p1.m6" class="ltx_Math" alttext="p&lt;k" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">p&lt;k</annotation></semantics></math> then there is a closed algebraic subset <math id="ThmGHCx1.p1.m7" class="ltx_Math" alttext="Z\subset X" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">Z\subset X</annotation></semantics></math> of codimension <math id="ThmGHCx1.p1.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> such that</span></p>
<table id="S2.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex8.m1" class="ltx_Math" alttext="V\subset\ker(H^{j}(X)\to H^{j}(X\smallsetminus Z))." display="block" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⊂</mo><mrow><mi>ker</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>H</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∖</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V\subset\ker(H^{j}(X)\to H^{j}(X\smallsetminus Z)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.SS2.p7" class="ltx_para ltx_noindent">
<p id="S2.SS2.p7.1" class="ltx_p">In other words, a rational sub-Hodge structure of Hodge coniveau <math id="S2.SS2.p7.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> should be supported on an algebraic subset of codimension <math id="S2.SS2.p7.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. The Hodge conjecture is recovered by taking <math id="S2.SS2.p7.m3" class="ltx_Math" alttext="j=2k" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">j=2k</annotation></semantics></math> and <math id="S2.SS2.p7.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> to be the sub-Hodge structure <math id="S2.SS2.p7.m5" class="ltx_Math" alttext="H^{2k}(X)\cap H^{k,k}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><msup><mi>H</mi><mrow><mi>k</mi><mo>,</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">H^{2k}(X)\cap H^{k,k}</annotation></semantics></math>.</p>
</div>
<div id="S2.SS2.p8" class="ltx_para">
<p id="S2.SS2.p8.1" class="ltx_p">There is a parallel formulation on the arithmetic side, where the Hodge coniveau is replaced by an analogous condition on the divisibility of Frobenius eigenvalues. The predicted geometric conclusion remains the same.</p>
</div>
<div id="ThmGTCx1" class="ltx_theorem ltx_theorem_GTC">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="ThmGTCx1.2" class="ltx_text ltx_font_bold">Generalized Tate Conjecture</span></span><span id="ThmGTCx1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="ThmGTCx1.p1" class="ltx_para">
<p id="ThmGTCx1.p1.1" class="ltx_p"><span id="ThmGTCx1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="ThmGTCx1.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a smooth projective variety, or a smooth and proper Deligne–Mumford stack with projective coarse moduli space over a finitely generated field <math id="ThmGTCx1.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. Let <math id="ThmGTCx1.p1.m3" class="ltx_Math" alttext="V\subset H^{j}(X_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⊂</mo><mrow><msup><mi>H</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V\subset H^{j}(X_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math> be a Galois subrepresentation, and suppose that <math id="ThmGTCx1.p1.m4" class="ltx_Math" alttext="V(k)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(k)</annotation></semantics></math> is effective, meaning that the eigenvalues of Frobenius elements acting on <math id="ThmGTCx1.p1.m5" class="ltx_Math" alttext="V(k)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(k)</annotation></semantics></math>, at good places, are algebraic integers. Then there is a closed algebraic subset <math id="ThmGTCx1.p1.m6" class="ltx_Math" alttext="Z\subset X" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">Z\subset X</annotation></semantics></math> of codimension <math id="ThmGTCx1.p1.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> such that</span></p>
<table id="S2.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex9.m1" class="ltx_Math" alttext="V\subset\ker\big(H^{j}(X_{L^{s}},\mathbb{Q}_{\ell})\to H^{j}((X\smallsetminus Z)_{L^{s}},\mathbb{Q}_{\ell})\big)." display="block" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⊂</mo><mrow><mi>ker</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mi>H</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∖</mo><mi>Z</mi></mrow><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V\subset\ker\big(H^{j}(X_{L^{s}},\mathbb{Q}_{\ell})\to H^{j}((X\smallsetminus Z)_{L^{s}},\mathbb{Q}_{\ell})\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.SS2.p9" class="ltx_para ltx_noindent">
<p id="S2.SS2.p9.1" class="ltx_p">In other words, a sub-Galois representation of Tate coniveau <math id="S2.SS2.p9.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> should be supported on an algebraic subset of codimension <math id="S2.SS2.p9.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. The Tate conjecture is recovered by taking <math id="S2.SS2.p9.m3" class="ltx_Math" alttext="j=2k" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">j=2k</annotation></semantics></math> and <math id="S2.SS2.p9.m4" class="ltx_Math" alttext="V\subset H^{2k}(X_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⊂</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V\subset H^{2k}(X_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math> to be the untwisted form of the invariant subspace <math id="S2.SS2.p9.m5" class="ltx_Math" alttext="H^{2k}(X_{L_{s}},\mathbb{Q}_{\ell}(k))^{\operatorname{Gal}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><msub><mi>L</mi><mi>s</mi></msub></msub><mo>,</mo><mrow><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>Gal</mi></msup></mrow><annotation encoding="application/x-tex">H^{2k}(X_{L_{s}},\mathbb{Q}_{\ell}(k))^{\operatorname{Gal}}</annotation></semantics></math>.</p>
</div>
<div id="S2.SS2.p10" class="ltx_para">
<p id="S2.SS2.p10.1" class="ltx_p">These generalized formulations, together with the semisimplicity conjecture for the <math id="S2.SS2.p10.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic Galois representations, are the natural framework for the results discussed below. They turn questions about motivic structures into concrete geometric statements. This perspective is well-suited to <math id="S2.SS2.p10.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> where, in many cases, the boundary strata, together with cycles representing the <math id="S2.SS2.p10.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>- and <math id="S2.SS2.p10.m4" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math>-classes, and intersection products thereof, supply natural candidates for the expected support loci.</p>
</div>
</section>
<section id="S2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.3. </span>Moduli spaces of stable curves as a test case</h3>

<div id="S2.SS3.p1" class="ltx_para">
<p id="S2.SS3.p1.1" class="ltx_p">The moduli spaces of stable algebraic curves <math id="S2.SS3.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>, for <math id="S2.SS3.p1.m2" class="ltx_Math" alttext="2g-2+n&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo>+</mo><mi>n</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">2g-2+n&gt;0</annotation></semantics></math>, occupy a central position in modern mathematics, connecting algebraic geometry to other branches of mathematics ranging from combinatorics and representation theory to number theory and mathematical physics. Mumford famously detailed his obsession with these spaces, which he described as a “passion flower” in the “secret garden” of algebraic geometry <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx61" title="" class="ltx_ref">Mum97</a>]</cite>.</p>
</div>
<div id="S2.SS3.p2" class="ltx_para">
<p id="S2.SS3.p2.1" class="ltx_p">The structure of these spaces, and the natural morphisms between them, are extraordinarily deep and intricate. The combinatorics of the boundary</p>
<table id="S2.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex10.m1" class="ltx_Math" alttext="D_{g,n}:=\overline{\mathcal{M}}_{g,n}\smallsetminus\mathcal{M}_{g,n}" display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>:=</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">D_{g,n}:=\overline{\mathcal{M}}_{g,n}\smallsetminus\mathcal{M}_{g,n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS3.p2.2" class="ltx_p">is encoded in the moduli space of tropical curves <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACP15</a>]</cite>; its structure is sufficiently intricate to encode Kontsevich’s commutative graph complex and, in particular, the Grothendieck–Teichmüller Lie algebra <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx14" title="" class="ltx_ref">CGP21</a>]</cite>. Meanwhile, the pure weight cohomology of the interior <math id="S2.SS3.p2.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> is a rich source of motives and Galois representations over <math id="S2.SS3.p2.m2" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx34" title="" class="ltx_ref">FvdG04a</a>, <a href="#bib.bibx35" title="" class="ltx_ref">FvdG04b</a>, <a href="#bib.bibx12" title="" class="ltx_ref">BvdG08</a>, <a href="#bib.bibx10" title="" class="ltx_ref">BFvdG14</a>, <a href="#bib.bibx8" title="" class="ltx_ref">BF23</a>]</cite>.</p>
</div>
<div id="S2.SS3.p3" class="ltx_para">
<p id="S2.SS3.p3.1" class="ltx_p">It is of fundamental importance that both <math id="S2.SS3.p3.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> and its normalized boundary <math id="S2.SS3.p3.m2" class="ltx_Math" alttext="\widetilde{D}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{D}_{g,n}</annotation></semantics></math> are smooth and proper over <math id="S2.SS3.p3.m3" class="ltx_Math" alttext="\operatorname{Spec}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\operatorname{Spec}\mathbb{Z}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx26" title="" class="ltx_ref">DM69</a>, <a href="#bib.bibx45" title="" class="ltx_ref">Knu83</a>]</cite>.
Recent work in arithmetic makes deep predictions regarding the classification of motives over <math id="S2.SS3.p3.m4" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>; see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">CL19</a>, Theorem F]</cite> for a list of the expected motives in weights less than or equal to <math id="S2.SS3.p3.m5" class="ltx_Math" alttext="22" display="inline" intent=":literal"><semantics><mn>22</mn><annotation encoding="application/x-tex">22</annotation></semantics></math> that should appear in the cohomology of spaces that are smooth and proper over <math id="S2.SS3.p3.m6" class="ltx_Math" alttext="\operatorname{Spec}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\operatorname{Spec}\mathbb{Z}</annotation></semantics></math>. Every motive on this list appears in <math id="S2.SS3.p3.m7" class="ltx_Math" alttext="H^{*}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> for suitable <math id="S2.SS3.p3.m8" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S2.SS3.p3.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</p>
</div>
<div id="S2.SS3.p4" class="ltx_para">
<p id="S2.SS3.p4.1" class="ltx_p">Recent geometric work <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx14" title="" class="ltx_ref">CGP21</a>, <a href="#bib.bibx15" title="" class="ltx_ref">CGP22</a>, <a href="#bib.bibx70" title="" class="ltx_ref">PW24b</a>, <a href="#bib.bibx69" title="" class="ltx_ref">PW24a</a>, <a href="#bib.bibx22" title="" class="ltx_ref">CLPW25b</a>, <a href="#bib.bibx21" title="" class="ltx_ref">CLPW25a</a>]</cite> casts light on the patterns with which each motive appears in the cohomology of both <math id="S2.SS3.p4.m1" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> and <math id="S2.SS3.p4.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>, as <math id="S2.SS3.p4.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S2.SS3.p4.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> vary. Up to weight 15, the appearance of each small motive in <math id="S2.SS3.p4.m5" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> is governed by an explicit graph complex, and techniques for computing with graph complexes shed new light on the cohomology of these moduli spaces. For instance, we now know that the cohomology of <math id="S2.SS3.p4.m6" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> is of Tate type if and only if <math id="S2.SS3.p4.m7" class="ltx_Math" alttext="g=0" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g=0</annotation></semantics></math> or <math id="S2.SS3.p4.m8" class="ltx_Math" alttext="3g+2n&lt;25" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>&lt;</mo><mn>25</mn></mrow><annotation encoding="application/x-tex">3g+2n&lt;25</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">CLPW24</a>]</cite>.</p>
</div>
<div id="S2.SS3.p5" class="ltx_para">
<p id="S2.SS3.p5.1" class="ltx_p">Since we have a precise list of the expected motives in each weight up to <math id="S2.SS3.p5.m1" class="ltx_Math" alttext="22" display="inline" intent=":literal"><semantics><mn>22</mn><annotation encoding="application/x-tex">22</annotation></semantics></math>, and since we have geometric methods for computing where each of these motives appears, the cohomology of <math id="S2.SS3.p5.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> is a rich testing ground for general conjectures about motives, Hodge structures, and Galois representations.</p>
</div>
<div id="S2.SS3.p6" class="ltx_para">
<p id="S2.SS3.p6.1" class="ltx_p">Throughout, whenever we refer to <math id="S2.SS3.p6.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>, we assume that <math id="S2.SS3.p6.m2" class="ltx_Math" alttext="2g-2+n&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo>+</mo><mi>n</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">2g-2+n&gt;0</annotation></semantics></math>.</p>
</div>
</section>
<section id="S2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.4. </span>Odd examples</h3>

<div id="S2.SS4.p1" class="ltx_para">
<p id="S2.SS4.p1.1" class="ltx_p">For odd <math id="S2.SS4.p1.m1" class="ltx_Math" alttext="k&lt;11" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">k&lt;11</annotation></semantics></math>, we have <math id="S2.SS4.p1.m2" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})=0</annotation></semantics></math> for all <math id="S2.SS4.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S2.SS4.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BFP24</a>]</cite>. The proof of this topological fact relies heavily on algebraic geometry (point counting over finite fields and the Behrend-Grothendieck-Lefschetz trace formula for algebraic stacks). Given this vanishing, the generalized Hodge and Tate conjectures hold vacuously in these cases.</p>
</div>
<div id="S2.SS4.p2" class="ltx_para">
<p id="S2.SS4.p2.1" class="ltx_p">For <math id="S2.SS4.p2.m1" class="ltx_Math" alttext="k=11" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">k=11</annotation></semantics></math>, we have the famous example <math id="S2.SS4.p2.m2" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11})\cong\mathbb{Q}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msup><mi>ℚ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11})\cong\mathbb{Q}^{2}</annotation></semantics></math>, with Hodge type</p>
<table id="S2.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex11.m1" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11},\mathbb{C})\cong H^{11,0}\oplus H^{0,11}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>H</mi><mrow><mn>11</mn><mo>,</mo><mn>0</mn></mrow></msup><mo>⊕</mo><msup><mi>H</mi><mrow><mn>0</mn><mo>,</mo><mn>11</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11},\mathbb{C})\cong H^{11,0}\oplus H^{0,11}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS4.p2.2" class="ltx_p">In particular, <math id="S2.SS4.p2.m3" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11},\mathbb{C})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11},\mathbb{C})</annotation></semantics></math> is spanned by a holomorphic form and its complex conjugate. This holomorphic form has origins in arithmetic, and comes, in particular, from the Ramanujan cusp form of weight <math id="S2.SS4.p2.m4" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn>12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math> for <math id="S2.SS4.p2.m5" class="ltx_Math" alttext="\mathrm{SL}_{2}(\mathbb{Z})" display="inline" intent=":literal"><semantics><mrow><msub><mi>SL</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SL}_{2}(\mathbb{Z})</annotation></semantics></math>, as we now recall.</p>
</div>
<div id="S2.SS4.p3" class="ltx_para">
<p id="S2.SS4.p3.1" class="ltx_p">By mixed Hodge theory, the subspace <math id="S2.SS4.p3.m1" class="ltx_Math" alttext="W_{k}H^{k}(\mathcal{M}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{k}H^{k}(\mathcal{M}_{g,n})</annotation></semantics></math> is the image of <math id="S2.SS4.p3.m2" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> under restriction to the open subspace parameterizing smooth curves. It carries a pure Hodge structure of weight <math id="S2.SS4.p3.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, given by <math id="S2.SS4.p3.m4" class="ltx_Math" alttext="W_{k}H^{k}(\mathcal{M}_{1,k})\otimes\mathbb{C}=\bigoplus_{p+q=k}H^{p,q}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>=</mo><mi>k</mi></mrow></msub><msup><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">W_{k}H^{k}(\mathcal{M}_{1,k})\otimes\mathbb{C}=\bigoplus_{p+q=k}H^{p,q}</annotation></semantics></math>. For <math id="S2.SS4.p3.m5" class="ltx_Math" alttext="g=1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g=1</annotation></semantics></math>, the Eichler–Shimura correspondence identifies <math id="S2.SS4.p3.m6" class="ltx_Math" alttext="W_{k}H^{k}(\mathcal{M}_{1,k})\cap H^{k,0}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><msup><mi>H</mi><mrow><mi>k</mi><mo>,</mo><mn>0</mn></mrow></msup></mrow><annotation encoding="application/x-tex">W_{k}H^{k}(\mathcal{M}_{1,k})\cap H^{k,0}</annotation></semantics></math> with the space of cuspidal modular forms of weight <math id="S2.SS4.p3.m7" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math> and level <math id="S2.SS4.p3.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> for <math id="S2.SS4.p3.m9" class="ltx_Math" alttext="\mathrm{SL}_{2}(\mathbb{Z})" display="inline" intent=":literal"><semantics><mrow><msub><mi>SL</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SL}_{2}(\mathbb{Z})</annotation></semantics></math>. This can be made completely explicit, as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">FP13</a>, Section 2.3]</cite>. Let <math id="S2.SS4.p3.m10" class="ltx_Math" alttext="\mathbb{H}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">\mathbb{H}</annotation></semantics></math> denote the upper half-plane, the universal cover of <math id="S2.SS4.p3.m11" class="ltx_Math" alttext="\mathcal{M}_{1,1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,1}</annotation></semantics></math>. Then <math id="S2.SS4.p3.m12" class="ltx_Math" alttext="\mathbb{H}\times\mathbb{C}^{k-1}" display="inline" intent=":literal"><semantics><mrow><mi>ℍ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℂ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{H}\times\mathbb{C}^{k-1}</annotation></semantics></math> is the universal cover of the <math id="S2.SS4.p3.m13" class="ltx_Math" alttext="(k-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k-1)</annotation></semantics></math>-fold fiber product of the universal curve, which contains <math id="S2.SS4.p3.m14" class="ltx_Math" alttext="\mathcal{M}_{1,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,k}</annotation></semantics></math> as a dense open subspace. The transformation rule for a modular form <math id="S2.SS4.p3.m15" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> of weight <math id="S2.SS4.p3.m16" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math> is exactly such that the restriction of the holomorphic form <math id="S2.SS4.p3.m17" class="ltx_Math" alttext="fdz\wedge dz_{1}\wedge\cdots\wedge dz_{k-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>∧</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>1</mn></msub></mrow><mo>∧</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>∧</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">fdz\wedge dz_{1}\wedge\cdots\wedge dz_{k-1}</annotation></semantics></math> on <math id="S2.SS4.p3.m18" class="ltx_Math" alttext="\mathbb{H}\times\mathbb{C}^{k-1}" display="inline" intent=":literal"><semantics><mrow><mi>ℍ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℂ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{H}\times\mathbb{C}^{k-1}</annotation></semantics></math> to the preimage of this open set descends to a holomorphic form on <math id="S2.SS4.p3.m19" class="ltx_Math" alttext="\mathcal{M}_{1,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{1,k}</annotation></semantics></math>. The cuspidal condition ensures that this form extends to <math id="S2.SS4.p3.m20" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,k}</annotation></semantics></math>. In particular, the image of the Ramanujan cusp form <math id="S2.SS4.p3.m21" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> under this correspondence spans <math id="S2.SS4.p3.m22" class="ltx_Math" alttext="H^{11,0}(\overline{\mathcal{M}}_{1,11})\cong\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mrow><mn>11</mn><mo>,</mo><mn>0</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">H^{11,0}(\overline{\mathcal{M}}_{1,11})\cong\mathbb{C}</annotation></semantics></math>. Since <math id="S2.SS4.p3.m23" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11})</annotation></semantics></math> is irreducible as a rational Hodge structure, and <math id="S2.SS4.p3.m24" class="ltx_Math" alttext="H^{11,0}\neq 0" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>11</mn><mo>,</mo><mn>0</mn></mrow></msup><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{11,0}\neq 0</annotation></semantics></math>, there is no nontrivial substructure with positive Hodge coniveau, and hence the generalized Hodge conjecture is true in this case. Similarly, under the stated hypothesis on the characteristic, <math id="S2.SS4.p3.m25" class="ltx_Math" alttext="H^{11}((\overline{\mathcal{M}}_{1,11})_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}((\overline{\mathcal{M}}_{1,11})_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math> has Tate coniveau 0, and no nonzero sub-Galois representation has positive Tate coniveau. Hence, the generalized Tate conjecture is true in this case.</p>
</div>
<div id="S2.SS4.p4" class="ltx_para">
<p id="S2.SS4.p4.1" class="ltx_p">Recent results show that <math id="S2.SS4.p4.m1" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> vanishes unless <math id="S2.SS4.p4.m2" class="ltx_Math" alttext="g=1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g=1</annotation></semantics></math> and <math id="S2.SS4.p4.m3" class="ltx_Math" alttext="n\geq 11" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">n\geq 11</annotation></semantics></math>, in which case it is a direct sum of pullbacks of <math id="S2.SS4.p4.m4" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11})</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx18" title="" class="ltx_ref">CLP23</a>]</cite>. In particular, any nonzero rational sub-Hodge structure has non-vanishing <math id="S2.SS4.p4.m5" class="ltx_Math" alttext="H^{11,0}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mn>11</mn><mo>,</mo><mn>0</mn></mrow></msup><annotation encoding="application/x-tex">H^{11,0}</annotation></semantics></math>, and the Tate twist <math id="S2.SS4.p4.m6" class="ltx_Math" alttext="V(1)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(1)</annotation></semantics></math> is not effective for any nonzero sub-Galois representation <math id="S2.SS4.p4.m7" class="ltx_Math" alttext="V\subset H^{11}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⊂</mo><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V\subset H^{11}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math>. The generalized Hodge and Tate conjectures therefore hold for <math id="S2.SS4.p4.m8" class="ltx_Math" alttext="k=11" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">k=11</annotation></semantics></math>.</p>
</div>
<div id="S2.SS4.p5" class="ltx_para">
<p id="S2.SS4.p5.1" class="ltx_p">The first case where there is a nontrivial substructure of positive Hodge coniveau is for <math id="S2.SS4.p5.m1" class="ltx_Math" alttext="H^{13}(\overline{\mathcal{M}}_{1,12})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}(\overline{\mathcal{M}}_{1,12})</annotation></semantics></math>. Explicit computation shows that this cohomology group is isomorphic to <math id="S2.SS4.p5.m2" class="ltx_Math" alttext="\mathbb{Q}^{22}" display="inline" intent=":literal"><semantics><msup><mi>ℚ</mi><mn>22</mn></msup><annotation encoding="application/x-tex">\mathbb{Q}^{22}</annotation></semantics></math>, with Hodge types</p>
<table id="S2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex12.m1" class="ltx_Math" alttext="H^{13}(\overline{\mathcal{M}}_{1,12},\mathbb{C})\cong H^{12,1}\oplus H^{1,12}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msub><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>H</mi><mrow><mn>12</mn><mo>,</mo><mn>1</mn></mrow></msup><mo>⊕</mo><msup><mi>H</mi><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{13}(\overline{\mathcal{M}}_{1,12},\mathbb{C})\cong H^{12,1}\oplus H^{1,12}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS4.p5.2" class="ltx_p">Moreover, the symmetric group <math id="S2.SS4.p5.m3" class="ltx_Math" alttext="S_{12}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mn>12</mn></msub><annotation encoding="application/x-tex">S_{12}</annotation></semantics></math> acts on <math id="S2.SS4.p5.m4" class="ltx_Math" alttext="H^{12,1}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mn>12</mn><mo>,</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">H^{12,1}</annotation></semantics></math> as the irreducible representation associated to the hook shape partition <math id="S2.SS4.p5.m5" class="ltx_Math" alttext="(2,1^{10})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msup><mn>1</mn><mn>10</mn></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2,1^{10})</annotation></semantics></math> (see, e.g., <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx7" title="" class="ltx_ref">Ber</a>]</cite>). The generalized Hodge conjecture predicts that, since <math id="S2.SS4.p5.m6" class="ltx_Math" alttext="H^{13,0}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>13</mn><mo>,</mo><mn>0</mn></mrow></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{13,0}=0</annotation></semantics></math>, the group <math id="S2.SS4.p5.m7" class="ltx_Math" alttext="H^{13}(\overline{\mathcal{M}}_{1,12})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}(\overline{\mathcal{M}}_{1,12})</annotation></semantics></math> should be supported on a divisor.</p>
</div>
<div id="S2.SS4.p6" class="ltx_para">
<p id="S2.SS4.p6.1" class="ltx_p">For each subset <math id="S2.SS4.p6.m1" class="ltx_Math" alttext="A\subset\{1,\ldots,12\}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊂</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>12</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A\subset\{1,\ldots,12\}</annotation></semantics></math> of size <math id="S2.SS4.p6.m2" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>, there is a gluing map</p>
<table id="S2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex13.m1" class="ltx_Math" alttext="\iota_{A}\colon\overline{\mathcal{M}}_{1,A\cup\{p\}}\times\overline{\mathcal{M}}_{0,A^{c}\cup\{q\}}\to\overline{\mathcal{M}}_{1,12}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ι</mi><mi>A</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>p</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><msup><mi>A</mi><mi>c</mi></msup><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>q</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\iota_{A}\colon\overline{\mathcal{M}}_{1,A\cup\{p\}}\times\overline{\mathcal{M}}_{0,A^{c}\cup\{q\}}\to\overline{\mathcal{M}}_{1,12},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS4.p6.2" class="ltx_p">obtained by gluing <math id="S2.SS4.p6.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> to <math id="S2.SS4.p6.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. The domain is isomorphic to <math id="S2.SS4.p6.m5" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,11}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,11}</annotation></semantics></math>, and the Gysin push-forward of <math id="S2.SS4.p6.m6" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11})</annotation></semantics></math> is nonzero; this can be seen by pulling back under other tautological morphisms and taking Künneth components. Using the Hodge structure and irreducibility of <math id="S2.SS4.p6.m7" class="ltx_Math" alttext="H^{12,1}(\overline{\mathcal{M}}_{1,12})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>12</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{12,1}(\overline{\mathcal{M}}_{1,12})</annotation></semantics></math> as an <math id="S2.SS4.p6.m8" class="ltx_Math" alttext="S_{12}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mn>12</mn></msub><annotation encoding="application/x-tex">S_{12}</annotation></semantics></math>-representation, we conclude that the sum of the Gysin maps <math id="S2.SS4.p6.m9" class="ltx_math_unparsed" alttext="\bigoplus_{A}\iota_{A*}" display="inline" intent=":literal"><semantics><mrow><mo>⨁</mo><msub><mrow></mrow><mi>A</mi></msub><mi>ι</mi><msub><mrow></mrow><mrow><mi>A</mi><mo lspace="0.222em">∗</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\bigoplus_{A}\iota_{A*}</annotation></semantics></math> surjects onto <math id="S2.SS4.p6.m10" class="ltx_Math" alttext="H^{13}(\overline{\mathcal{M}}_{1,12})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}(\overline{\mathcal{M}}_{1,12})</annotation></semantics></math>. Hence, <math id="S2.SS4.p6.m11" class="ltx_Math" alttext="H^{13}(\overline{\mathcal{M}}_{1,12})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}(\overline{\mathcal{M}}_{1,12})</annotation></semantics></math> is supported on the union of the images of these gluing maps. In particular, it is supported on a divisor, as predicted by the generalized Hodge conjecture.</p>
</div>
<div id="S2.Thmtheorem1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Remark 2.1</span></span><span id="S2.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem1.p1" class="ltx_para">
<p id="S2.Thmtheorem1.p1.1" class="ltx_p"><span id="S2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">The fact that <math id="S2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="H^{13}(\overline{\mathcal{M}}_{1,12})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}(\overline{\mathcal{M}}_{1,12})</annotation></semantics></math> is supported on a divisor was proved decades ago <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx37" title="" class="ltx_ref">GP03</a>, Proposition 6]</cite>. The generalization to arbitrary <math id="S2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is more recent <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">CLPW24</a>, Section 4]</cite>.</span></p>
</div>
</div>
</section>
<section id="S2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.5. </span>Motivic structures</h3>

<div id="S2.SS5.p1" class="ltx_para">
<p id="S2.SS5.p1.1" class="ltx_p">The topics discussed here are informed by the philosophy of motives, which predicts a geometrically defined abelian category with properties that explain and unify observed phenomena in Hodge theory, algebraic cycles, and point counts over finite fields. However, lacking proof that any geometrically defined category has all of the expected properties, we work naively, and define a motivic structure of weight <math id="S2.SS5.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> to be a rational vector space <math id="S2.SS5.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> together with a pure Hodge structure of weight <math id="S2.SS5.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> on <math id="S2.SS5.p1.m4" class="ltx_Math" alttext="V\otimes\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">V\otimes\mathbb{C}</annotation></semantics></math> and a continuous <math id="S2.SS5.p1.m5" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic Galois representation of weight <math id="S2.SS5.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> on <math id="S2.SS5.p1.m7" class="ltx_Math" alttext="V\otimes\mathbb{Q}_{\ell}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">V\otimes\mathbb{Q}_{\ell}</annotation></semantics></math>, with suitable compatibilities and comparison isomorphisms <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx25" title="" class="ltx_ref">Del89</a>]</cite>. (In other contexts, one may also wish to include other realizations, such as de Rham and crystalline cohomology, but for simplicity we leave these aside.)</p>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3. </span>Tautologically generated cohomology groups</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">The tautological subring <math id="S3.p1.m1" class="ltx_Math" alttext="RH^{*}(\overline{\mathcal{M}}_{g,n})\subset H^{*}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">RH^{*}(\overline{\mathcal{M}}_{g,n})\subset H^{*}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is the <math id="S3.p1.m2" class="ltx_Math" alttext="\mathbb{Q}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">\mathbb{Q}</annotation></semantics></math>-subalgebra generated by classes that arise most naturally from the projection map from the universal curve and the stratification of the boundary. More precisely, it is the <math id="S3.p1.m3" class="ltx_Math" alttext="\mathbb{Q}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">\mathbb{Q}</annotation></semantics></math>-subalgebra generated by the <math id="S3.p1.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-, <math id="S3.p1.m5" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math>-, and boundary classes. Equivalently, <math id="S3.p1.m6" class="ltx_Math" alttext="\{RH^{*}(\overline{\mathcal{M}}_{g,n})\}_{g,n}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\{RH^{*}(\overline{\mathcal{M}}_{g,n})\}_{g,n}</annotation></semantics></math> is the smallest system of subrings that contains <math id="S3.p1.m7" class="ltx_Math" alttext="\mathbb{Q}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">\mathbb{Q}</annotation></semantics></math> and is closed under push-forward for all tautological morphisms. One says that <math id="S3.p1.m8" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological when <math id="S3.p1.m9" class="ltx_Math" alttext="RH^{k}(\overline{\mathcal{M}}_{g,n})=H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">RH^{k}(\overline{\mathcal{M}}_{g,n})=H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>. In particular, if <math id="S3.p1.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is odd then <math id="S3.p1.m11" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological if and only if it is zero.</p>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">The systematic study of these tautological rings was initiated by Mumford, in pursuit of an enumerative geometry of curves analogous to Schubert calculus on Grassmannians and flag varieties <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx60" title="" class="ltx_ref">Mum83</a>]</cite>. It is now the most intensively studied part of the intersection theory of moduli spaces of curves, particularly in the context of enumerative geometry and Gromov-Witten theory <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx29" title="" class="ltx_ref">FP00</a>, <a href="#bib.bibx30" title="" class="ltx_ref">FP03</a>, <a href="#bib.bibx31" title="" class="ltx_ref">FP05</a>, <a href="#bib.bibx32" title="" class="ltx_ref">FP13</a>, <a href="#bib.bibx68" title="" class="ltx_ref">Pix13</a>]</cite>.</p>
</div>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p">A fair bit is known about the set of pairs <math id="S3.p3.m1" class="ltx_Math" alttext="(g,n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g,n)</annotation></semantics></math> such that the full cohomology ring <math id="S3.p3.m2" class="ltx_Math" alttext="H^{*}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological. This is the case for <math id="S3.p3.m3" class="ltx_Math" alttext="g=0" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g=0</annotation></semantics></math>; for <math id="S3.p3.m4" class="ltx_Math" alttext="g=1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g=1</annotation></semantics></math> and <math id="S3.p3.m5" class="ltx_Math" alttext="n\leq 10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n\leq 10</annotation></semantics></math>; for <math id="S3.p3.m6" class="ltx_Math" alttext="g=2" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">g=2</annotation></semantics></math> and <math id="S3.p3.m7" class="ltx_Math" alttext="n\leq 9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n\leq 9</annotation></semantics></math>, and for <math id="S3.p3.m8" class="ltx_Math" alttext="3\leq g\leq 7" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>≤</mo><mi>g</mi><mo>≤</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">3\leq g\leq 7</annotation></semantics></math> and <math id="S3.p3.m9" class="ltx_Math" alttext="2g+n\leq 14" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mi>n</mi></mrow><mo>≤</mo><mn>14</mn></mrow><annotation encoding="application/x-tex">2g+n\leq 14</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx41" title="" class="ltx_ref">Kee92</a>, <a href="#bib.bibx65" title="" class="ltx_ref">Pet14</a>, <a href="#bib.bibx17" title="" class="ltx_ref">CL24</a>]</cite>. Odd cohomology first arises in <math id="S3.p3.m10" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11})</annotation></semantics></math>; however, the even degree cohomology of <math id="S3.p3.m11" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,n}</annotation></semantics></math> is tautological for all <math id="S3.p3.m12" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx65" title="" class="ltx_ref">Pet14</a>]</cite>.</p>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p">Non-tautological classes also appear in even degree, and even in <math id="S3.p4.m1" class="ltx_Math" alttext="H^{2k}(\overline{\mathcal{M}}_{g,n})\cap H^{k,k}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><msup><mi>H</mi><mrow><mi>k</mi><mo>,</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">H^{2k}(\overline{\mathcal{M}}_{g,n})\cap H^{k,k}</annotation></semantics></math>. This was first observed on <math id="S3.p4.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{2,20}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>20</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{2,20}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx37" title="" class="ltx_ref">GP03</a>]</cite>. The first example without marked points comes from the closure of the bielliptic locus in <math id="S3.p4.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{12}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mn>12</mn></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{12}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx76" title="" class="ltx_ref">vZ18</a>]</cite>. Many more examples are given in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">ACC+25</a>]</cite>.</p>
</div>
<div id="S3.p5" class="ltx_para">
<p id="S3.p5.1" class="ltx_p">A related problem is to determine the degrees <math id="S3.p5.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> such that <math id="S3.p5.m2" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for all <math id="S3.p5.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S3.p5.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. Arbarello and Cornalba proved that <math id="S3.p5.m5" class="ltx_Math" alttext="H^{2}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for all <math id="S3.p5.m6" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S3.p5.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AC98</a>]</cite>. More recently, it was shown that <math id="S3.p5.m8" class="ltx_Math" alttext="H^{4}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{4}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for all <math id="S3.p5.m9" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S3.p5.m10" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, and that <math id="S3.p5.m11" class="ltx_Math" alttext="H^{6}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{6}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for all <math id="S3.p5.m12" class="ltx_Math" alttext="g\notin\{7,8,9\}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∉</mo><mrow><mo stretchy="false">{</mo><mrow><mn>7</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>9</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">g\notin\{7,8,9\}</annotation></semantics></math> and all <math id="S3.p5.m13" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>]</cite>.</p>
</div>
<div id="S3.Thmtheorem1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Proposition 3.1</span></span><span id="S3.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem1.p1" class="ltx_para">
<p id="S3.Thmtheorem1.p1.1" class="ltx_p"><span id="S3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="H^{2k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological then the Hodge conjecture holds for algebraic cycles of codimension <math id="S3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> on <math id="S3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>, as does the Tate conjecture for algebraic cycles of codimension <math id="S3.Thmtheorem1.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> over any finitely generated field <math id="S3.Thmtheorem1.p1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p6" class="ltx_para">
<p id="S3.p6.1" class="ltx_p"><span id="S3.p6.1.1" class="ltx_text">Suppose the rational singular cohomology group <math id="S3.p6.m1" class="ltx_Math" alttext="H^{2k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is generated by tautological algebraic cycle classes. For the Hodge conjecture, the proposition is clear. We now show that the Tate conjecture holds for algebraic cycles of codimension <math id="S3.p6.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> on <math id="S3.p6.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> over any finitely generated field <math id="S3.p6.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, using the standard comparison theorems for schemes and Deligne–Mumford stacks <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx52" title="" class="ltx_ref">Mil80</a>, <a href="#bib.bibx6" title="" class="ltx_ref">Beh04</a>]</cite>.</span></p>
</div>
<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p"><span id="S3.p7.1.1" class="ltx_text">If <math id="S3.p7.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has characteristic zero, then the choice of an embedding <math id="S3.p7.m2" class="ltx_Math" alttext="L^{s}\hookrightarrow\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mi>s</mi></msup><mo stretchy="false">↪</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">L^{s}\hookrightarrow\mathbb{C}</annotation></semantics></math> determines a comparison isomorphism</span></p>
<table id="S3.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex14.m1" class="ltx_Math" alttext="H^{2k}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell}(k))\xrightarrow{\sim}H^{2k}(\overline{\mathcal{M}}_{g,n}(\mathbb{C}),\mathbb{Q}(k))\otimes\mathbb{Q}_{\ell}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><mrow><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">H^{2k}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell}(k))\xrightarrow{\sim}H^{2k}(\overline{\mathcal{M}}_{g,n}(\mathbb{C}),\mathbb{Q}(k))\otimes\mathbb{Q}_{\ell},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.2" class="ltx_p"><span id="S3.p7.2.1" class="ltx_text">which is compatible with the cycle class maps. The tautological classes are defined over <math id="S3.p7.m3" class="ltx_Math" alttext="\mathbb{Q}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">\mathbb{Q}</annotation></semantics></math> and hence invariant under <math id="S3.p7.m4" class="ltx_Math" alttext="\operatorname{Gal}(L^{s}/L)" display="inline" intent=":literal"><semantics><mrow><mi>Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>L</mi><mi>s</mi></msup><mo>/</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Gal}(L^{s}/L)</annotation></semantics></math>. Thus, if tautological cycle classes generate <math id="S3.p7.m5" class="ltx_Math" alttext="H^{2k}(\overline{\mathcal{M}}_{g,n}(\mathbb{C}),\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2k}(\overline{\mathcal{M}}_{g,n}(\mathbb{C}),\mathbb{Q})</annotation></semantics></math>, then they also generate <math id="S3.p7.m6" class="ltx_Math" alttext="H^{2k}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell}(k))" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><mrow><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2k}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell}(k))</annotation></semantics></math>, and the Tate conjecture holds in these cases.</span></p>
</div>
<div id="S3.p8" class="ltx_para">
<p id="S3.p8.1" class="ltx_p"><span id="S3.p8.1.1" class="ltx_text">It remains to consider the case where <math id="S3.p8.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has characteristic <math id="S3.p8.m2" class="ltx_Math" alttext="p&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p&gt;0</annotation></semantics></math>. Since the structure map <math id="S3.p8.m3" class="ltx_Math" alttext="f\colon\overline{\mathcal{M}}_{g,n}\to\operatorname{Spec}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">→</mo><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mi>ℤ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f\colon\overline{\mathcal{M}}_{g,n}\to\operatorname{Spec}\mathbb{Z}</annotation></semantics></math> is smooth and proper, the sheaf <math id="S3.p8.m4" class="ltx_Math" alttext="R^{2k}f_{*}\mathbb{Q}_{\ell}(k)" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{2k}f_{*}\mathbb{Q}_{\ell}(k)</annotation></semantics></math> is lisse over <math id="S3.p8.m5" class="ltx_Math" alttext="\operatorname{Spec}\mathbb{Z}[\frac{1}{\ell}]" display="inline" intent=":literal"><semantics><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mfrac><mn>1</mn><mi mathvariant="normal">ℓ</mi></mfrac><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Spec}\mathbb{Z}[\frac{1}{\ell}]</annotation></semantics></math>. Since the tautological cycle classes are defined over <math id="S3.p8.m6" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>, they give global sections of this sheaf. If these sections span the characteristic zero fiber, then they span every geometric fiber over <math id="S3.p8.m7" class="ltx_Math" alttext="\operatorname{Spec}\mathbb{Z}[\frac{1}{\ell}]" display="inline" intent=":literal"><semantics><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mfrac><mn>1</mn><mi mathvariant="normal">ℓ</mi></mfrac><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Spec}\mathbb{Z}[\frac{1}{\ell}]</annotation></semantics></math>. In particular, their span contains the Galois-invariant subspace.
∎</span></p>
</div>
</div>
<div id="S3.p9" class="ltx_para">
<p id="S3.p9.1" class="ltx_p">We briefly recall the inductive method of Arbarello and Cornalba <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AC98</a>]</cite>, which underlies much of the recent progress in this area. Recall that</p>
<table id="S3.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex15.m1" class="ltx_Math" alttext="D_{g,n}:=\overline{\mathcal{M}}_{g,n}\setminus\mathcal{M}_{g,n}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>:=</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">D_{g,n}:=\overline{\mathcal{M}}_{g,n}\setminus\mathcal{M}_{g,n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.2" class="ltx_p">denotes the boundary divisor in the moduli space of stable curves, and <math id="S3.p9.m1" class="ltx_Math" alttext="\widetilde{D}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{D}_{g,n}</annotation></semantics></math> is its normalization, which is a disjoint union of products of smaller moduli spaces (or quotients of such products by finite groups). The localization sequence for the open inclusion <math id="S3.p9.m2" class="ltx_Math" alttext="\mathcal{M}_{g,n}\subset\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>⊂</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}_{g,n}\subset\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>, together with the yoga of weights, gives a right exact sequence</p>
<table id="S3.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E1.m1" class="ltx_Math" alttext="H^{k-2}(\widetilde{D}_{g,n})(-1)\to H^{k}(\overline{\mathcal{M}}_{g,n})\to W_{k}H^{k}(\mathcal{M}_{g,n})\to 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{k-2}(\widetilde{D}_{g,n})(-1)\to H^{k}(\overline{\mathcal{M}}_{g,n})\to W_{k}H^{k}(\mathcal{M}_{g,n})\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.3" class="ltx_p">In this way, every class in <math id="S3.p9.m3" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is built out of cohomology classes on smaller moduli spaces of curves and classes in <math id="S3.p9.m4" class="ltx_Math" alttext="W_{k}H^{k}(\mathcal{M}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{k}H^{k}(\mathcal{M}_{g,n})</annotation></semantics></math>, the pure part of the cohomology of the interior.</p>
</div>
<div id="S3.p10" class="ltx_para">
<p id="S3.p10.1" class="ltx_p">There are many techniques for understanding the cohomology groups <math id="S3.p10.m1" class="ltx_Math" alttext="H^{k}(\mathcal{M}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\mathcal{M}_{g,n})</annotation></semantics></math> and their pure weight subspace <math id="S3.p10.m2" class="ltx_Math" alttext="W_{k}H^{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">W_{k}H^{k}</annotation></semantics></math>. Some of these techniques are topological, using nontrivial inputs from either geometric group theory or stable homotopy theory, based on the interpretation of <math id="S3.p10.m3" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> as a rational classifying space for the mapping class group, or oriented diffeomorphism group, of a marked surface. Harer’s computation of the virtual cohomological dimension of mapping class groups of surfaces gives strong vanishing results for <math id="S3.p10.m4" class="ltx_Math" alttext="H^{k}(\mathcal{M}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\mathcal{M}_{g,n})</annotation></semantics></math> when <math id="S3.p10.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is large relative to <math id="S3.p10.m6" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S3.p10.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx39" title="" class="ltx_ref">Har86</a>]</cite>. The relevant bound is roughly <math id="S3.p10.m8" class="ltx_Math" alttext="4g-4+n" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>4</mn></mrow><mo>+</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">4g-4+n</annotation></semantics></math>, for <math id="S3.p10.m9" class="ltx_Math" alttext="g\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">g\geq 2</annotation></semantics></math>. Equivalently, by Poincaré duality, the compactly supported cohomology of <math id="S3.p10.m10" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> vanishes in degrees less than roughly <math id="S3.p10.m11" class="ltx_Math" alttext="2g+n-1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>+</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2g+n-1</annotation></semantics></math>. We then have the alternative formulation of excision of the boundary,</p>
<table id="S3.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E2.m1" class="ltx_Math" alttext="\cdots\to H^{k}_{c}(\mathcal{M}_{g,n})\to H^{k}(\overline{\mathcal{M}}_{g,n})\to H^{k}(D_{g,n})\to\cdots" display="block" intent=":literal"><semantics><mrow><mo rspace="0.1389em">⋯</mo><mo lspace="0.1389em" stretchy="false">→</mo><mrow><msubsup><mi>H</mi><mi>c</mi><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em" stretchy="false">→</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">\cdots\to H^{k}_{c}(\mathcal{M}_{g,n})\to H^{k}(\overline{\mathcal{M}}_{g,n})\to H^{k}(D_{g,n})\to\cdots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p10.2" class="ltx_p">In particular, when <math id="S3.p10.m12" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is small, the first term in (<a href="#S3.E2" title="In 3. Tautologically generated cohomology groups ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) vanishes and <math id="S3.p10.m13" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> injects into <math id="S3.p10.m14" class="ltx_Math" alttext="H^{k}(D_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(D_{g,n})</annotation></semantics></math>. Moreover, an easy mixed Hodge theory argument shows that the composition with pullback to the normalization <math id="S3.p10.m15" class="ltx_Math" alttext="\tilde{D}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{D}_{g,n}</annotation></semantics></math> is also injective. Thus, when <math id="S3.p10.m16" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is small there is an injection <math id="S3.p10.m17" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})\hookrightarrow H^{k}(\tilde{D}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})\hookrightarrow H^{k}(\tilde{D}_{g,n})</annotation></semantics></math> and hence every class in <math id="S3.p10.m18" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> comes from cohomology classes of the same degree on smaller moduli spaces.</p>
</div>
<div id="S3.p11" class="ltx_para">
<p id="S3.p11.1" class="ltx_p">Another key input from topology is stabilization: when <math id="S3.p11.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is smaller than <math id="S3.p11.m2" class="ltx_Math" alttext="\frac{2g-2}{3}" display="inline" intent=":literal"><semantics><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>2</mn></mrow><mn>3</mn></mfrac><annotation encoding="application/x-tex">\frac{2g-2}{3}</annotation></semantics></math>, the cohomology of <math id="S3.p11.m3" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> is stable and freely generated by tautological <math id="S3.p11.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>- and <math id="S3.p11.m5" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math>-classes. For <math id="S3.p11.m6" class="ltx_Math" alttext="\mathcal{M}_{g}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>g</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{g}</annotation></semantics></math>, this is the famous theorem of Madsen and Weiss <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx62" title="" class="ltx_ref">MW07</a>]</cite> conjectured by Mumford <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx60" title="" class="ltx_ref">Mum83</a>]</cite>. See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx47" title="" class="ltx_ref">Loo96</a>]</cite> for the extension to <math id="S3.p11.m7" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math>.</p>
</div>
<div id="S3.p12" class="ltx_para">
<p id="S3.p12.1" class="ltx_p">Elaborations on these ideas, combining nontrivial inputs from topology with techniques from mixed Hodge theory, are at the heart of the proofs in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AC98</a>]</cite>, and continue to form the basis of many inductive arguments about the cohomology of <math id="S3.p12.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>.</p>
</div>
<div id="S3.p13" class="ltx_para">
<p id="S3.p13.1" class="ltx_p">The recent work <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>]</cite> follows the same philosophy but packages it in a form better suited to controlling high degree cohomology groups. Rather than working with either the full cohomology ring, or only with the tautological subring, one allows intermediate systems of subrings, formalized as semi-tautological extensions, that are still closed under the tautological operations that move classes from smaller moduli spaces to larger moduli spaces, by push-forward for gluing and pullback for forgetting markings. The localization sequence (<a href="#S3.E1" title="In 3. Tautologically generated cohomology groups ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) reduces many questions to controlling the quotient of <math id="S3.p13.m1" class="ltx_Math" alttext="W_{k}H^{k}(\mathcal{M}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{k}H^{k}(\mathcal{M}_{g,n})</annotation></semantics></math> by classes coming from the boundary and from fewer markings. A Leray–Künneth analysis of the universal curve shows that this quotient vanishes once <math id="S3.p13.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is large relative to <math id="S3.p13.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, while the virtual cohomological dimension rules out the opposite extreme, so for fixed <math id="S3.p13.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> only finitely many small pairs <math id="S3.p13.m5" class="ltx_Math" alttext="(g,n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g,n)</annotation></semantics></math> can contribute.</p>
</div>
<div id="S3.p14" class="ltx_para">
<p id="S3.p14.1" class="ltx_p">To get strong new results from this formalism, one also needs new ways of establishing the base cases needed to run the inductive arguments in this framework. In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>]</cite>, this is done using explicit low-genus calculations and algebraicity results for pure weight cohomology, via the Chow–Künneth generation property. The Chow–Künneth generation property is established geometrically, on a case-by-case basis. For instance, for certain moduli of genus <math id="S3.p14.m1" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math> curves, the key geometric input comes from Mukai’s description of canonical curves as linear sections of an orthogonal Grassmannian. With this framework in mind, the proof of Theorem A is essentially an accounting of the base cases that are currently accessible.</p>
</div>
<div id="S3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_bold ltx_title_proof">Sketch of proof of Theorem <a href="#ThmTheorem1" title="Theorem A. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</h6>
<div id="S3.p15" class="ltx_para">
<p id="S3.p15.1" class="ltx_p"><span id="S3.p15.1.1" class="ltx_text">Arbarello and Cornalba computed <math id="S3.p15.m1" class="ltx_Math" alttext="H^{2}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> for all <math id="S3.p15.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S3.p15.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, showing that it is generated by the tautological classes <math id="S3.p15.m4" class="ltx_Math" alttext="\kappa_{1},\psi_{1},\ldots,\psi_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ψ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ψ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\kappa_{1},\psi_{1},\ldots,\psi_{n}</annotation></semantics></math> and boundary divisors <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AC98</a>]</cite>. By Proposition <a href="#S3.Thmtheorem1" title="Proposition 3.1. ‣ 3. Tautologically generated cohomology groups ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, this proves the theorem for cycles of codimension 1.</span></p>
</div>
<div id="S3.p16" class="ltx_para">
<p id="S3.p16.1" class="ltx_p"><span id="S3.p16.1.1" class="ltx_text">For cycles of codimension 2, we follow a similar argument, namely a double induction on <math id="S3.p16.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S3.p16.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> using the weight spectral sequence for the open inclusion <math id="S3.p16.m3" class="ltx_Math" alttext="\mathcal{M}_{g,n}\subset\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>⊂</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}_{g,n}\subset\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>. The argument also relies on knowledge of the stable cohomology of the open moduli spaces <math id="S3.p16.m4" class="ltx_Math" alttext="\mathcal{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{g,n}</annotation></semantics></math> in low degrees, and vanishing theorems for their high degree cohomology <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx38" title="" class="ltx_ref">Har85</a>, <a href="#bib.bibx39" title="" class="ltx_ref">Har86</a>, <a href="#bib.bibx47" title="" class="ltx_ref">Loo96</a>, <a href="#bib.bibx62" title="" class="ltx_ref">MW07</a>]</cite>. The details are given in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>]</cite> and show that <math id="S3.p16.m5" class="ltx_Math" alttext="H^{4}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{4}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is generated by tautological cycle classes for all <math id="S3.p16.m6" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S3.p16.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. There, we mentioned that an easy variation on these arguments also shows that <math id="S3.p16.m8" class="ltx_Math" alttext="H^{6}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{6}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for <math id="S3.p16.m9" class="ltx_Math" alttext="g\geq 10" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">g\geq 10</annotation></semantics></math>, and for all <math id="S3.p16.m10" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. With a little more care in handling base cases, essentially the same argument works also for <math id="S3.p16.m11" class="ltx_Math" alttext="g\leq 6" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≤</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">g\leq 6</annotation></semantics></math>.</span></p>
</div>
<div id="S3.p17" class="ltx_para">
<p id="S3.p17.1" class="ltx_p"><span id="S3.p17.1.1" class="ltx_text">The tautological ring contains all divisor classes, including an ample class. Therefore, from what we have discussed above and the hard Lefschetz theorem, we know that <math id="S3.p17.m1" class="ltx_Math" alttext="H^{2d-k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2d-k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is generated by the classes of tautological algebraic cycles for even <math id="S3.p17.m2" class="ltx_Math" alttext="k\leq 4" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">k\leq 4</annotation></semantics></math>, as well as for <math id="S3.p17.m3" class="ltx_Math" alttext="k=6" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">k=6</annotation></semantics></math> and <math id="S3.p17.m4" class="ltx_Math" alttext="g\not\in\{7,8,9\}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∉</mo><mrow><mo stretchy="false">{</mo><mrow><mn>7</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>9</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">g\not\in\{7,8,9\}</annotation></semantics></math>. However, in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>, Theorem 1.5]</cite>, we also show that <math id="S3.p17.m5" class="ltx_Math" alttext="H^{2d-k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2d-k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is generated by the classes of tautological algebraic cycles, for even <math id="S3.p17.m6" class="ltx_Math" alttext="k\leq 14" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>14</mn></mrow><annotation encoding="application/x-tex">k\leq 14</annotation></semantics></math>. This proves the theorem for algebraic cycles of dimension less than or equal to <math id="S3.p17.m7" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math>, for all <math id="S3.p17.m8" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S3.p17.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.Thmtheorem2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Remark 3.2</span></span><span id="S3.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem2.p1" class="ltx_para">
<p id="S3.Thmtheorem2.p1.1" class="ltx_p"><span id="S3.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">As noted above, one can deduce tautological generation and related results in high degree <math id="S3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="H^{2d-k}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi>k</mi></mrow></msup><annotation encoding="application/x-tex">H^{2d-k}</annotation></semantics></math> from the corresponding results for <math id="S3.Thmtheorem2.p1.m2" class="ltx_Math" alttext="H^{k}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mi>k</mi></msup><annotation encoding="application/x-tex">H^{k}</annotation></semantics></math>, when <math id="S3.Thmtheorem2.p1.m3" class="ltx_Math" alttext="k&lt;d" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">k&lt;d</annotation></semantics></math>, using the hard Lefschetz theorem. Thus, the high degree results are a priori easier than the corresponding low degree results. Nevertheless, the extent to which one obtains stronger results for cycles of low dimension rather than low codimension is striking. We note that this distinction lessens if one assumes the Grothendieck standard conjectures. In particular, the Lefschetz standard conjecture predicts that the inverse of the hard Lefschetz isomorphism is induced by an algebraic correspondence; assuming this conjecture (which is wide open in general), the Hodge conjecture for <math id="S3.Thmtheorem2.p1.m4" class="ltx_Math" alttext="H^{2d-k}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi>k</mi></mrow></msup><annotation encoding="application/x-tex">H^{2d-k}</annotation></semantics></math> implies the Hodge conjecture for <math id="S3.Thmtheorem2.p1.m5" class="ltx_Math" alttext="H^{k}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mi>k</mi></msup><annotation encoding="application/x-tex">H^{k}</annotation></semantics></math>, when <math id="S3.Thmtheorem2.p1.m6" class="ltx_Math" alttext="k&lt;d" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">k&lt;d</annotation></semantics></math>.</span></p>
</div>
<div id="S3.Thmtheorem2.p2" class="ltx_para">
<p id="S3.Thmtheorem2.p2.1" class="ltx_p"><span id="S3.Thmtheorem2.p2.1.1" class="ltx_text ltx_font_italic">We note that the methods of proof for the high degree and low degree results stated here are similar: one rigorously applies the method of Arbarello and Cornalba and establishes as many base cases as possible with current methods. The recent progress required to prove Theorem <a href="#ThmTheorem1" title="Theorem A. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a> relies most heavily on new arguments to establish the base cases for relatively small values of <math id="S3.Thmtheorem2.p2.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S3.Thmtheorem2.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> needed to run the induction. This includes point counting arguments <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BFP24</a>]</cite>, using the Behrend–Grothendieck–Lefschetz trace formula for stacks <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx5" title="" class="ltx_ref">Beh93</a>]</cite>, and applications of the Chow–Künneth generation property <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx17" title="" class="ltx_ref">CL24</a>, <a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>]</cite>, together with explicit classical constructions of small genus moduli spaces and their Brill–Noether–Petri strata.</span></p>
</div>
</div>
<div id="S3.p18" class="ltx_para">
<p id="S3.p18.1" class="ltx_p">In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>, Conjecture 1.8]</cite>, there is the following proposed extension of Theorem <a href="#ThmTheorem1" title="Theorem A. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div>
<div id="ThmTaut20x1" class="ltx_theorem ltx_theorem_Taut20">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="ThmTaut20x1.2" class="ltx_text ltx_font_bold">Taut 20 Conjecture</span></span><span id="ThmTaut20x1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="ThmTaut20x1.p1" class="ltx_para">
<p id="ThmTaut20x1.p1.1" class="ltx_p"><span id="ThmTaut20x1.p1.1.1" class="ltx_text ltx_font_italic">The cohomology groups <math id="ThmTaut20x1.p1.m1" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> are tautological for all even <math id="ThmTaut20x1.p1.m2" class="ltx_Math" alttext="k\leq 20" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">k\leq 20</annotation></semantics></math>, and for all <math id="ThmTaut20x1.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="ThmTaut20x1.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.p19" class="ltx_para ltx_noindent">
<p id="S3.p19.1" class="ltx_p">By the hard Lefschetz theorem, it would follow that <math id="S3.p19.m1" class="ltx_Math" alttext="H_{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is also tautological for all even <math id="S3.p19.m2" class="ltx_Math" alttext="k\leq 20" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">k\leq 20</annotation></semantics></math>. The conjectured bound is tight (or <em id="S3.p19.1.1" class="ltx_emph ltx_font_italic">taut</em>), since <math id="S3.p19.m3" class="ltx_Math" alttext="H^{22}(\overline{\mathcal{M}}_{2,20})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>22</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>20</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{22}(\overline{\mathcal{M}}_{2,20})</annotation></semantics></math> and <math id="S3.p19.m4" class="ltx_Math" alttext="H^{22}(\overline{\mathcal{M}}_{12})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>22</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mn>12</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{22}(\overline{\mathcal{M}}_{12})</annotation></semantics></math> are not tautological <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx37" title="" class="ltx_ref">GP03</a>, <a href="#bib.bibx76" title="" class="ltx_ref">vZ18</a>]</cite>. If we include odd degree cohomology groups, then the best possible bound drops to <math id="S3.p19.m5" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>.</p>
</div>
<div id="ThmTaut10x1" class="ltx_theorem ltx_theorem_Taut10">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="ThmTaut10x1.2" class="ltx_text ltx_font_bold">Taut 10 Conjecture</span></span><span id="ThmTaut10x1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="ThmTaut10x1.p1" class="ltx_para">
<p id="ThmTaut10x1.p1.1" class="ltx_p"><span id="ThmTaut10x1.p1.1.1" class="ltx_text ltx_font_italic">All cohomology groups <math id="ThmTaut10x1.p1.m1" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> are tautological for <math id="ThmTaut10x1.p1.m2" class="ltx_Math" alttext="k\leq 10" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">k\leq 10</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.p20" class="ltx_para ltx_noindent">
<p id="S3.p20.1" class="ltx_p">This conjectured bound is also best possible, since <math id="S3.p20.m1" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11})</annotation></semantics></math> is not tautological. The taut 10 conjecture follows from the taut 20 conjecture, since <math id="S3.p20.m2" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> vanishes for odd <math id="S3.p20.m3" class="ltx_Math" alttext="k&lt;11" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">k&lt;11</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BFP24</a>]</cite>.</p>
</div>
<div id="S3.p21" class="ltx_para">
<p id="S3.p21.1" class="ltx_p">It is also natural to consider weaker forms of these conjectures, for low degree homology groups. Let <math id="S3.p21.m1" class="ltx_Math" alttext="H_{k}(\overline{\mathcal{M}}_{g,n}):=H_{k}(\overline{\mathcal{M}}_{g,n}(\mathbb{C}),\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{k}(\overline{\mathcal{M}}_{g,n}):=H_{k}(\overline{\mathcal{M}}_{g,n}(\mathbb{C}),\mathbb{Q})</annotation></semantics></math> denote rational singular homology. The Poincaré pairing induces isomorphisms between rational singular homology and cohomology in complementary degrees</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="H_{k}(\overline{\mathcal{M}}_{g,n})\cong H^{2d-k}(\overline{\mathcal{M}}_{g,n})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{k}(\overline{\mathcal{M}}_{g,n})\cong H^{2d-k}(\overline{\mathcal{M}}_{g,n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p21.2" class="ltx_p">Let <math id="S3.p21.m2" class="ltx_Math" alttext="RH_{k}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">RH_{k}</annotation></semantics></math> denote the subspace of <math id="S3.p21.m3" class="ltx_Math" alttext="H_{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> generated by tautological cohomology classes, via (<a href="#S3.E3" title="In 3. Tautologically generated cohomology groups ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>). We say that <math id="S3.p21.m4" class="ltx_Math" alttext="H_{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological if it is equal to <math id="S3.p21.m5" class="ltx_Math" alttext="RH_{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">RH_{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>. By the hard Lefschetz theorem, iterated cup product with an ample class <math id="S3.p21.m6" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> gives an isomorphism</p>
<table id="S3.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex16.m1" class="ltx_Math" alttext="L_{\omega}^{d-k}\colon H^{k}(\overline{\mathcal{M}}_{g,n})\xrightarrow{\sim}H^{2d-k}(\overline{\mathcal{M}}_{g,n})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>L</mi><mi>ω</mi><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">L_{\omega}^{d-k}\colon H^{k}(\overline{\mathcal{M}}_{g,n})\xrightarrow{\sim}H^{2d-k}(\overline{\mathcal{M}}_{g,n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p21.3" class="ltx_p">Since every divisor class is tautological, and in particular the ample class <math id="S3.p21.m7" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>, this isomorphism restricts to an injection</p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="RH^{k}(\overline{\mathcal{M}}_{g,n})\hookrightarrow RH^{2d-k}(\overline{\mathcal{M}}_{g,n})\cong RH_{k}(\overline{\mathcal{M}}_{g,n})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">RH^{k}(\overline{\mathcal{M}}_{g,n})\hookrightarrow RH^{2d-k}(\overline{\mathcal{M}}_{g,n})\cong RH_{k}(\overline{\mathcal{M}}_{g,n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p21.4" class="ltx_p">In particular, if <math id="S3.p21.m8" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological then so is <math id="S3.p21.m9" class="ltx_Math" alttext="H_{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>. Note, however, that the inclusion (<a href="#S3.E4" title="In 3. Tautologically generated cohomology groups ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) can be strict, as is the case for <math id="S3.p21.m10" class="ltx_Math" alttext="(g,n)=(2,20)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>20</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(g,n)=(2,20)</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx67" title="" class="ltx_ref">Pet16</a>]</cite>.</p>
</div>
<div id="S3.p22" class="ltx_para">
<p id="S3.p22.1" class="ltx_p">The taut 20 conjecture seems to be significantly harder than the homological variant, i.e., the conjecture that <math id="S3.p22.m1" class="ltx_Math" alttext="H_{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for even <math id="S3.p22.m2" class="ltx_Math" alttext="k\leq 20" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">k\leq 20</annotation></semantics></math>. Indeed, it is already known that <math id="S3.p22.m3" class="ltx_Math" alttext="H_{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for even <math id="S3.p22.m4" class="ltx_Math" alttext="k\leq 14" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>14</mn></mrow><annotation encoding="application/x-tex">k\leq 14</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>, Theorem 1.5]</cite>.</p>
</div>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Inspiration from arithmetic</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">While the results discussed above are proved geometrically, the statements that have been investigated so far draw heavily on inspiration from arithmetic. The work of Chenevier and Lannes, classifying the automorphic representations of motivic weight less than or equal to 22 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">CL19</a>, Theorem F]</cite> has been particularly influential. See also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">CT20</a>]</cite> for a simplified proof of this classification and a partial extension to weights 23 and 24.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">The classification is proved using analytic <math id="S4.p2.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-function methods and, in particular, a variant of Odlyzko’s minoration of discriminants <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx63" title="" class="ltx_ref">Odl75</a>, <a href="#bib.bibx64" title="" class="ltx_ref">Odl90</a>]</cite>, adapted to conductors of algebraic varieties, cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx51" title="" class="ltx_ref">Mes86</a>]</cite>.</p>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">To state the classification in the geometric setting, we must specify a few <math id="S4.p3.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic Galois representations. For positive integers <math id="S4.p3.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, let</p>
<table id="S4.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex17.m1" class="ltx_Math" alttext="\mathsf{S}_{k+1}:=W_{k}H^{k}(\mathcal{M}_{1,k})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝖲</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>:=</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathsf{S}_{k+1}:=W_{k}H^{k}(\mathcal{M}_{1,k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p3.2" class="ltx_p">which we view as a motivic structure, i.e., a rational vector space together with a pure Hodge structure on its complexification and a continuous action of <math id="S4.p3.m3" class="ltx_Math" alttext="\operatorname{Gal}(\overline{\mathbb{Q}}/\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><mi>Gal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>ℚ</mi><mo stretchy="true">¯</mo></mover><mo>/</mo><mi>ℚ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Gal}(\overline{\mathbb{Q}}/\mathbb{Q})</annotation></semantics></math> on its tensor product with <math id="S4.p3.m4" class="ltx_Math" alttext="\mathbb{Q}_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\mathbb{Q}_{\ell}</annotation></semantics></math>, for each prime <math id="S4.p3.m5" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>.</p>
</div>
<div id="S4.p4" class="ltx_para">
<p id="S4.p4.1" class="ltx_p">By the Eichler–Shimura correspondence, <math id="S4.p4.m1" class="ltx_Math" alttext="\mathsf{S}_{k+1}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathsf{S}_{k+1}</annotation></semantics></math> has dimension twice the dimension of the space of cusp forms of weight <math id="S4.p4.m2" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math> and level <math id="S4.p4.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> for <math id="S4.p4.m4" class="ltx_Math" alttext="\mathrm{SL}_{2}(\mathbb{Z})" display="inline" intent=":literal"><semantics><mrow><msub><mi>SL</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SL}_{2}(\mathbb{Z})</annotation></semantics></math>, and the associated Hodge weights are <math id="S4.p4.m5" class="ltx_Math" alttext="(k,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k,0)</annotation></semantics></math> and <math id="S4.p4.m6" class="ltx_Math" alttext="(0,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,k)</annotation></semantics></math>. In particular, as <math id="S4.p4.m7" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic representations,</p>
<table id="S4.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex18.m1" class="ltx_Math" alttext="\mathsf{S}_{12},\ \mathsf{S}_{16},\ \mathsf{S}_{18},\ \mathsf{S}_{20},\mbox{ and }\ \mathsf{S}_{22}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝖲</mi><mn>12</mn></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mn>16</mn></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mn>18</mn></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mn>20</mn></msub><mo>,</mo><mrow><mtext> and </mtext><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>𝖲</mi><mn>22</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\mathsf{S}_{12},\ \mathsf{S}_{16},\ \mathsf{S}_{18},\ \mathsf{S}_{20},\mbox{ and }\ \mathsf{S}_{22}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p4.2" class="ltx_p">are irreducible and 2-dimensional, of motivic weights 11, 15, 17, 19, and 21, respectively.</p>
</div>
<div id="S4.p5" class="ltx_para">
<p id="S4.p5.1" class="ltx_p">For nonnegative integers <math id="S4.p5.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="S4.p5.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, let <math id="S4.p5.m3" class="ltx_Math" alttext="\mathsf{S}_{j,k}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathsf{S}_{j,k}</annotation></semantics></math> denote the Galois representation attached to the Siegel cusp forms of weight <math id="S4.p5.m4" class="ltx_math_unparsed" alttext="\operatorname{Sym}^{j}\otimes\det^{k}" display="inline" intent=":literal"><semantics><mrow><mi>Sym</mi><msup><mrow></mrow><mi>j</mi></msup><mo lspace="0em">⊗</mo><mo lspace="0.055em">det</mo><msup><mrow></mrow><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\operatorname{Sym}^{j}\otimes\det^{k}</annotation></semantics></math>, which are realized in the appropriate weight-graded piece of the cohomology of a local system on <math id="S4.p5.m5" class="ltx_Math" alttext="\mathcal{A}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{A}_{2}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx66" title="" class="ltx_ref">Pet15</a>]</cite>. The motivic weight of <math id="S4.p5.m6" class="ltx_Math" alttext="\mathsf{S}_{j,k}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathsf{S}_{j,k}</annotation></semantics></math> is <math id="S4.p5.m7" class="ltx_Math" alttext="j+2k-3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo>−</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">j+2k-3</annotation></semantics></math>.
With this notation,</p>
<table id="S4.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex19.m1" class="ltx_Math" alttext="\mathsf{S}_{6,8},\ \mathsf{S}_{4,10},\ \mathsf{S}_{8,8},\ \mbox{ and }\ \mathsf{S}_{12,6}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝖲</mi><mrow><mn>6</mn><mo>,</mo><mn>8</mn></mrow></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mrow><mn>4</mn><mo>,</mo><mn>10</mn></mrow></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mrow><mn>8</mn><mo>,</mo><mn>8</mn></mrow></msub><mo rspace="0.667em">,</mo><mrow><mtext> and </mtext><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>𝖲</mi><mrow><mn>12</mn><mo>,</mo><mn>6</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathsf{S}_{6,8},\ \mathsf{S}_{4,10},\ \mathsf{S}_{8,8},\ \mbox{ and }\ \mathsf{S}_{12,6}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p5.2" class="ltx_p">are irreducible Galois representations of motivic weights 19, 21, 21, and 21, respectively. For further details on these Galois representations and their relations to holomorphic forms on moduli spaces of stable curves, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx21" title="" class="ltx_ref">CLPW25a</a>, Section 3]</cite> and the references therein.</p>
</div>
<div id="S4.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 4.1</span></span><span id="S4.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">CL19</a>, <a href="#bib.bibx23" title="" class="ltx_ref">CT20</a>]</cite>)<span id="S4.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem1.p1" class="ltx_para">
<p id="S4.Thmtheorem1.p1.1" class="ltx_p"><span id="S4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be an effective irreducible <math id="S4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic Galois representation that belongs to a pure compatible system of <math id="S4.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic Galois representations of conductor 1 and motivic weight <math id="S4.Thmtheorem1.p1.m4" class="ltx_Math" alttext="k\leq 22" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>22</mn></mrow><annotation encoding="application/x-tex">k\leq 22</annotation></semantics></math>. Consider the set of such representations</span></p>
<table id="S4.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex20.m1" class="ltx_Math" alttext="R=\{1;\ \mathsf{S}_{12},\ \mathsf{S}_{16},\ \mathsf{S}_{18},\ \mathsf{S}_{20},\ \mathsf{S}_{22};\ \mathsf{S}_{6,8},\ \mathsf{S}_{4,10},\ \mathsf{S}_{8,8},\ \mathsf{S}_{12,6};\ \operatorname{Sym}^{2}\mathsf{S}_{12}\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo rspace="0.667em">;</mo><msub><mi>𝖲</mi><mn>12</mn></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mn>16</mn></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mn>18</mn></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mn>20</mn></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mn>22</mn></msub><mo rspace="0.667em">;</mo><msub><mi>𝖲</mi><mrow><mn>6</mn><mo>,</mo><mn>8</mn></mrow></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mrow><mn>4</mn><mo>,</mo><mn>10</mn></mrow></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mrow><mn>8</mn><mo>,</mo><mn>8</mn></mrow></msub><mo rspace="0.667em">,</mo><msub><mi>𝖲</mi><mrow><mn>12</mn><mo>,</mo><mn>6</mn></mrow></msub><mo rspace="0.667em">;</mo><mrow><msup><mi>Sym</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>𝖲</mi><mn>12</mn></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R=\{1;\ \mathsf{S}_{12},\ \mathsf{S}_{16},\ \mathsf{S}_{18},\ \mathsf{S}_{20},\ \mathsf{S}_{22};\ \mathsf{S}_{6,8},\ \mathsf{S}_{4,10},\ \mathsf{S}_{8,8},\ \mathsf{S}_{12,6};\ \operatorname{Sym}^{2}\mathsf{S}_{12}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem1.p1.2" class="ltx_p"><span id="S4.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">Assume that for each <math id="S4.Thmtheorem1.p1.m5" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> in <math id="S4.Thmtheorem1.p1.m6" class="ltx_Math" alttext="R\cup\{V\}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>V</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">R\cup\{V\}</annotation></semantics></math>, the completed <math id="S4.Thmtheorem1.p1.m7" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-functions attached to <math id="S4.Thmtheorem1.p1.m8" class="ltx_Math" alttext="V\otimes W" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">V\otimes W</annotation></semantics></math> and <math id="S4.Thmtheorem1.p1.m9" class="ltx_Math" alttext="V\otimes W^{\vee}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>W</mi><mo>∨</mo></msup></mrow><annotation encoding="application/x-tex">V\otimes W^{\vee}</annotation></semantics></math> have the expected analytic continuation, functional equation, epsilon factors, zeros, and poles. Then <math id="S4.Thmtheorem1.p1.m10" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is a Tate twist of a representation in <math id="S4.Thmtheorem1.p1.m11" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.p6" class="ltx_para ltx_noindent">
<p id="S4.p6.1" class="ltx_p">Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 ([]). ‣ 4. Inspiration from arithmetic ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> gives striking conditional statements about the motives appearing in algebraic varieties and Deligne–Mumford stacks that are smooth and proper over <math id="S4.p6.m1" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>, assuming standard and widely-believed predictions about the analytic properties of <math id="S4.p6.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-functions attached to motives. We now discuss these predictions, which are important inspiration for the results discussed in Section <a href="#S5" title="5. Further results and predictions ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, which confirm many of the low weight predictions for moduli spaces of stable curves. The proofs of these results are geometric and unconditional.</p>
</div>
<div id="S4.p7" class="ltx_para">
<p id="S4.p7.1" class="ltx_p">Assuming the Tate conjecture, one expects that the <math id="S4.p7.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic Galois realization functor is fully faithful on pure motives over <math id="S4.p7.m2" class="ltx_Math" alttext="\mathbb{Q}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">\mathbb{Q}</annotation></semantics></math> modulo homological equivalence, tensored with <math id="S4.p7.m3" class="ltx_Math" alttext="\mathbb{Q}_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\mathbb{Q}_{\ell}</annotation></semantics></math>. Also, it is widely believed that the <math id="S4.p7.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-functions attached to motives have the expected analytic properties. Thus, when <math id="S4.p7.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is smooth and proper over <math id="S4.p7.m6" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>, and <math id="S4.p7.m7" class="ltx_Math" alttext="k\leq 22" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>22</mn></mrow><annotation encoding="application/x-tex">k\leq 22</annotation></semantics></math>, one expects that <math id="S4.p7.m8" class="ltx_Math" alttext="H^{k}(X_{\overline{\mathbb{Q}}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mover accent="true"><mi>ℚ</mi><mo stretchy="true">¯</mo></mover></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(X_{\overline{\mathbb{Q}}},\mathbb{Q}_{\ell})</annotation></semantics></math> is a direct sum of <math id="S4.p7.m9" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic realizations of irreducible pure motives, each of which is a Tate twist of an element of <math id="S4.p7.m10" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. In particular, the cohomology groups <math id="S4.p7.m11" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> should be pure Tate for even <math id="S4.p7.m12" class="ltx_Math" alttext="k\leq 20" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">k\leq 20</annotation></semantics></math> and should vanish for odd <math id="S4.p7.m13" class="ltx_Math" alttext="k&lt;11" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">k&lt;11</annotation></semantics></math>. This is simply because <math id="S4.p7.m14" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> contains no nontrivial representations of odd weight less than 11, and the only non-trivial representation of even weight is <math id="S4.p7.m15" class="ltx_Math" alttext="\operatorname{Sym}^{2}\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Sym</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>𝖲</mi><mn>12</mn></msub></mrow><annotation encoding="application/x-tex">\operatorname{Sym}^{2}\mathsf{S}_{12}</annotation></semantics></math>, in weight 22.</p>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Remark 4.2</span></span><span id="S4.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
<p id="S4.Thmtheorem2.p1.1" class="ltx_p"><span id="S4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">One of the striking features of Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 ([]). ‣ 4. Inspiration from arithmetic ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> is that the predicted list of Galois representations of weight at most 22 and conductor 1 is <em id="S4.Thmtheorem2.p1.1.1.1" class="ltx_emph ltx_font_upright">finite</em>. See also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">CT20</a>, Theorems 3–5]</cite> for an extension of this finiteness result to weight 23 and, conditional on the Generalized Riemann Hypothesis, to weight 24. These statements should not be taken lightly. Chenevier, Lannes, and Taïbi do not assume any <em id="S4.Thmtheorem2.p1.1.1.2" class="ltx_emph ltx_font_upright">a priori</em> bound on the rank and hence their results do not follow from the standard finiteness results for <math id="S4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic Galois representations <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">Fal83</a>, <a href="#bib.bibx24" title="" class="ltx_ref">Del85</a>]</cite>. Furthermore, the arguments in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">CL19</a>, <a href="#bib.bibx23" title="" class="ltx_ref">CT20</a>]</cite> do not prove finiteness for weights greater than 25.</span></p>
</div>
</div>
<div id="S4.p8" class="ltx_para">
<p id="S4.p8.1" class="ltx_p">The predictions coming from Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 ([]). ‣ 4. Inspiration from arithmetic ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> are consistent with the few previously known classification results for varieties that are smooth and proper over <math id="S4.p8.m1" class="ltx_Math" alttext="\operatorname{Spec}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\operatorname{Spec}\mathbb{Z}</annotation></semantics></math>. In particular, since positive genus curves and nontrivial abelian varieties have nontrivial <math id="S4.p8.m2" class="ltx_Math" alttext="H^{1}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mn>1</mn></msup><annotation encoding="application/x-tex">H^{1}</annotation></semantics></math>, these cohomological predictions agree with the theorem of Fontaine that there are no nontrivial abelian varieties over <math id="S4.p8.m3" class="ltx_Math" alttext="\operatorname{Spec}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\operatorname{Spec}\mathbb{Z}</annotation></semantics></math>, and hence the only smooth projective curve over <math id="S4.p8.m4" class="ltx_Math" alttext="\operatorname{Spec}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>Spec</mi><mo lspace="0.167em">⁡</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\operatorname{Spec}\mathbb{Z}</annotation></semantics></math> is <math id="S4.p8.m5" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Fon85</a>]</cite>.</p>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Remark 4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p"><span id="S4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">The classification of smooth projective surfaces over <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math> is an open problem; it is not known whether there is any such surface of non-negative Kodaira dimension. For further discussion of this intriguing question, and some partial results, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx42" title="" class="ltx_ref">Kha07</a>, <a href="#bib.bibx71" title="" class="ltx_ref">Sch23</a>, <a href="#bib.bibx11" title="" class="ltx_ref">BMP26</a>]</cite>.</span></p>
</div>
</div>
<div id="S4.p9" class="ltx_para">
<p id="S4.p9.1" class="ltx_p">The topological prediction that <math id="S4.p9.m1" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})=0</annotation></semantics></math> for odd <math id="S4.p9.m2" class="ltx_Math" alttext="k&lt;11" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">k&lt;11</annotation></semantics></math> is proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BFP24</a>]</cite>. At present, all of the known proofs use algebraic geometry in an essential way. In particular, the proofs follow the inductive method of Arbarello and Cornalba <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AC98</a>]</cite>, which relies on mixed Hodge theory and the yoga of weights. Moreover, the base cases needed to run the induction also seem out of reach by topological methods; they are proved using point counts over finite fields, the Grothendieck–Lefschetz trace formula, and étale-to-singular comparison theorems, as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BFP24</a>]</cite>, or using the Chow–Künneth generation property, as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx17" title="" class="ltx_ref">CL24</a>, <a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>]</cite>.</p>
</div>
<div id="S4.p10" class="ltx_para">
<p id="S4.p10.1" class="ltx_p">The prediction that <math id="S4.p10.m1" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is pure Tate for even <math id="S4.p10.m2" class="ltx_Math" alttext="k\leq 20" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">k\leq 20</annotation></semantics></math> is confirmed for <math id="S4.p10.m3" class="ltx_Math" alttext="k\leq 14" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>14</mn></mrow><annotation encoding="application/x-tex">k\leq 14</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>]</cite>, but the cases 16, 18, and 20 remain open.</p>
</div>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5. </span>Further results and predictions</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">The predictions of Chenevier–Lannes, and the methods used to prove these predictions for <math id="S5.p1.m1" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>, for <math id="S5.p1.m2" class="ltx_Math" alttext="k\leq 15" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">k\leq 15</annotation></semantics></math>, also shed light on the following stronger forms of the Hodge conjecture and Tate conjecture.</p>
</div>
<div id="S5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_bold ltx_title_proof">Sketch of proof of Theorems <a href="#ThmTheorem2" title="Theorem B. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a> and <a href="#ThmTheorem3" title="Theorem C. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>.</h6>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p"><span id="S5.p2.1.1" class="ltx_text">In even degrees, if <math id="S5.p2.m1" class="ltx_Math" alttext="H^{2k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological, then it is supported on a basis of tautological cycles of codimension <math id="S5.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, which confirms the generalized Hodge and Tate conjectures. In particular, the even degree cases of Theorem <a href="#ThmTheorem2" title="Theorem B. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a> follow immediately from the proof of Theorem <a href="#ThmTheorem1" title="Theorem A. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</span></p>
</div>
<div id="S5.p3" class="ltx_para">
<p id="S5.p3.1" class="ltx_p"><span id="S5.p3.1.1" class="ltx_text">We now consider the odd degree cases. For odd <math id="S5.p3.m1" class="ltx_Math" alttext="k&lt;11" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">k&lt;11</annotation></semantics></math>, the conjectures are vacuous, since <math id="S5.p3.m2" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> vanishes, as predicted by Chenevier and Lannes (Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 ([]). ‣ 4. Inspiration from arithmetic ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>) and proved unconditionally in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BFP24</a>]</cite>.</span></p>
</div>
<div id="S5.p4" class="ltx_para">
<p id="S5.p4.1" class="ltx_p"><span id="S5.p4.1.1" class="ltx_text">For <math id="S5.p4.m1" class="ltx_Math" alttext="k=11" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">k=11</annotation></semantics></math>, Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 ([]). ‣ 4. Inspiration from arithmetic ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> predicts that <math id="S5.p4.m2" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> should be a direct sum of copies of <math id="S5.p4.m3" class="ltx_Math" alttext="\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>12</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{12}</annotation></semantics></math>. In particular, we expect <math id="S5.p4.m4" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{g,n},\mathbb{C})\cong H^{11,0}\oplus H^{0,11}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>H</mi><mrow><mn>11</mn><mo>,</mo><mn>0</mn></mrow></msup><mo>⊕</mo><msup><mi>H</mi><mrow><mn>0</mn><mo>,</mo><mn>11</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{g,n},\mathbb{C})\cong H^{11,0}\oplus H^{0,11}</annotation></semantics></math>, and no Galois subrepresentation of <math id="S5.p4.m5" class="ltx_Math" alttext="H^{11}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math> has positive Tate coniveau, unless <math id="S5.p4.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has characteristic <math id="S5.p4.m7" class="ltx_Math" alttext="p&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p&gt;0</annotation></semantics></math> and <math id="S5.p4.m8" class="ltx_Math" alttext="p|\tau(p)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo fence="false">|</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p|\tau(p)</annotation></semantics></math>. These expectations are proved unconditionally in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx18" title="" class="ltx_ref">CLP23</a>]</cite>, where it is shown that
<math id="S5.p4.m9" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> vanishes unless <math id="S5.p4.m10" class="ltx_Math" alttext="g=1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g=1</annotation></semantics></math> and <math id="S5.p4.m11" class="ltx_Math" alttext="n\geq 11" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">n\geq 11</annotation></semantics></math>, and</span></p>
<table id="S5.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E5.m1" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,n})\cong\bigoplus_{1\in A,|A|=11}\pi_{A}^{*}H^{11}(\overline{\mathcal{M}}_{1,11})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≅</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mrow><mn>1</mn><mo>∈</mo><mi>A</mi></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>11</mn></mrow></mrow></munder><mrow><msubsup><mi>π</mi><mi>A</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,n})\cong\bigoplus_{1\in A,|A|=11}\pi_{A}^{*}H^{11}(\overline{\mathcal{M}}_{1,11})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p4.2" class="ltx_p"><span id="S5.p4.2.1" class="ltx_text">for <math id="S5.p4.m12" class="ltx_Math" alttext="n&gt;11" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&gt;</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">n&gt;11</annotation></semantics></math>. Here, <math id="S5.p4.m13" class="ltx_Math" alttext="\pi_{A}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>A</mi></msub><annotation encoding="application/x-tex">\pi_{A}</annotation></semantics></math> denotes the tautological morphism obtained by forgetting all marked points that are not in a specified subset <math id="S5.p4.m14" class="ltx_Math" alttext="A\subset\{1,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊂</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A\subset\{1,\ldots,n\}</annotation></semantics></math>. The direct sum decomposition (<a href="#S5.E5" title="In Sketch of proof of Theorems  and . ‣ 5. Further results and predictions ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>), together with the semisimplicity and Tate-coniveau-zero property of <math id="S5.p4.m15" class="ltx_Math" alttext="H^{11}((\overline{\mathcal{M}}_{1,11})_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}((\overline{\mathcal{M}}_{1,11})_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math>, proves this case of the semisimplicity and generalized Tate conjecture.</span></p>
</div>
<div id="S5.p5" class="ltx_para">
<p id="S5.p5.1" class="ltx_p"><span id="S5.p5.1.1" class="ltx_text">The proof for <math id="S5.p5.m1" class="ltx_Math" alttext="k=13" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>13</mn></mrow><annotation encoding="application/x-tex">k=13</annotation></semantics></math> is similar, in the sense that we have a complete understanding of <math id="S5.p5.m2" class="ltx_Math" alttext="H^{13}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> for all <math id="S5.p5.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S5.p5.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, as codimension-one Gysin push-forwards of copies of <math id="S5.p5.m5" class="ltx_Math" alttext="\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>12</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{12}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">CLPW24</a>, Theorem 1.7]</cite>. For <math id="S5.p5.m6" class="ltx_Math" alttext="g\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g\geq 1</annotation></semantics></math>, and for <math id="S5.p5.m7" class="ltx_Math" alttext="A\subset\{1,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊂</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A\subset\{1,\ldots,n\}</annotation></semantics></math> such that <math id="S5.p5.m8" class="ltx_Math" alttext="2g-3+|A^{c}|&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>−</mo><mn>3</mn></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><msup><mi>A</mi><mi>c</mi></msup><mo stretchy="false">|</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">2g-3+|A^{c}|&gt;0</annotation></semantics></math>, let <math id="S5.p5.m9" class="ltx_Math" alttext="\xi_{A}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>A</mi></msub><annotation encoding="application/x-tex">\xi_{A}</annotation></semantics></math> be the tautological morphism</span></p>
<table id="S5.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex21.m1" class="ltx_Math" alttext="\xi_{A}\colon\overline{\mathcal{M}}_{1,A\cup\{p\}}\times\overline{\mathcal{M}}_{g-1,A^{c}\cup\{q\}}\to\overline{\mathcal{M}}_{g,n}" display="block" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mi>A</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>p</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><msup><mi>A</mi><mi>c</mi></msup><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>q</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\xi_{A}\colon\overline{\mathcal{M}}_{1,A\cup\{p\}}\times\overline{\mathcal{M}}_{g-1,A^{c}\cup\{q\}}\to\overline{\mathcal{M}}_{g,n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p5.2" class="ltx_p"><span id="S5.p5.2.1" class="ltx_text">obtained by gluing the marked points <math id="S5.p5.m10" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and <math id="S5.p5.m11" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. We then have the Gysin push-forward</span></p>
<table id="S5.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex22.m1" class="ltx_math_unparsed" alttext="\xi_{A*}\colon H^{11}\big(\overline{\mathcal{M}}_{1,A\cup\{p\}}\times\overline{\mathcal{M}}_{g-1,A^{c}\cup\{q\}}\big)\to H^{13}(\overline{\mathcal{M}}_{g,n})." display="block" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mrow><mi>A</mi><mo lspace="0.222em">∗</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi>H</mi><mn>11</mn></msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>p</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><msup><mi>A</mi><mi>c</mi></msup><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>q</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo stretchy="false">→</mo><msup><mi>H</mi><mn>13</mn></msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\xi_{A*}\colon H^{11}\big(\overline{\mathcal{M}}_{1,A\cup\{p\}}\times\overline{\mathcal{M}}_{g-1,A^{c}\cup\{q\}}\big)\to H^{13}(\overline{\mathcal{M}}_{g,n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p5.3" class="ltx_p"><span id="S5.p5.3.1" class="ltx_text">By the Künneth formula and the vanishing of <math id="S5.p5.m12" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> for odd <math id="S5.p5.m13" class="ltx_Math" alttext="k&lt;11" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">k&lt;11</annotation></semantics></math>, we have</span></p>
<table id="S5.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex23.m1" class="ltx_Math" alttext="H^{11}\big(\overline{\mathcal{M}}_{1,A\cup\{p\}}\times\overline{\mathcal{M}}_{g-1,A^{c}\cup\{q\}}\big)\cong H^{11}(\overline{\mathcal{M}}_{1,A\cup\{p\}})\oplus H^{11}(\overline{\mathcal{M}}_{g-1,A^{c}\cup\{q\}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>p</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><msup><mi>A</mi><mi>c</mi></msup><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>q</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>p</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><msup><mi>A</mi><mi>c</mi></msup><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>q</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{11}\big(\overline{\mathcal{M}}_{1,A\cup\{p\}}\times\overline{\mathcal{M}}_{g-1,A^{c}\cup\{q\}}\big)\cong H^{11}(\overline{\mathcal{M}}_{1,A\cup\{p\}})\oplus H^{11}(\overline{\mathcal{M}}_{g-1,A^{c}\cup\{q\}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p5.4" class="ltx_p"><span id="S5.p5.4.1" class="ltx_text">By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">CLPW24</a>, Theorem 1.7]</cite>, the sum of Gysin push-forwards <math id="S5.p5.m14" class="ltx_math_unparsed" alttext="\bigoplus_{A}\xi_{A*}" display="inline" intent=":literal"><semantics><mrow><mo>⨁</mo><msub><mrow></mrow><mi>A</mi></msub><mi>ξ</mi><msub><mrow></mrow><mrow><mi>A</mi><mo lspace="0.222em">∗</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\bigoplus_{A}\xi_{A*}</annotation></semantics></math> is surjective, and is an isomorphism unless <math id="S5.p5.m15" class="ltx_Math" alttext="g=1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g=1</annotation></semantics></math>. (For <math id="S5.p5.m16" class="ltx_Math" alttext="g=1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g=1</annotation></semantics></math>, the kernel is also completely understood; see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">CLPW24</a>, Section 4.4]</cite>.) In any case, from the surjectivity of <math id="S5.p5.m17" class="ltx_math_unparsed" alttext="\bigoplus_{A}\xi_{A*}" display="inline" intent=":literal"><semantics><mrow><mo>⨁</mo><msub><mrow></mrow><mi>A</mi></msub><mi>ξ</mi><msub><mrow></mrow><mrow><mi>A</mi><mo lspace="0.222em">∗</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\bigoplus_{A}\xi_{A*}</annotation></semantics></math>, we immediately see that <math id="S5.p5.m18" class="ltx_Math" alttext="H^{13}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is supported on a codimension-one closed subset, namely the union of the boundary divisors that are the images of the gluing maps <math id="S5.p5.m19" class="ltx_Math" alttext="\xi_{A}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>A</mi></msub><annotation encoding="application/x-tex">\xi_{A}</annotation></semantics></math>. We also see that the Hodge type is</span></p>
<table id="S5.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex24.m1" class="ltx_Math" alttext="H^{13}(\overline{\mathcal{M}}_{g,n},\mathbb{C})=H^{12,1}\oplus H^{1,12}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>H</mi><mrow><mn>12</mn><mo>,</mo><mn>1</mn></mrow></msup><mo>⊕</mo><msup><mi>H</mi><mrow><mn>1</mn><mo>,</mo><mn>12</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{13}(\overline{\mathcal{M}}_{g,n},\mathbb{C})=H^{12,1}\oplus H^{1,12}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p5.5" class="ltx_p"><span id="S5.p5.5.1" class="ltx_text">Similarly, the Galois representation <math id="S5.p5.m20" class="ltx_Math" alttext="H^{13}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math> is a quotient of a direct sum of Tate twists of <math id="S5.p5.m21" class="ltx_Math" alttext="\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>12</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{12}</annotation></semantics></math>. With the additional assumption that either <math id="S5.p5.m22" class="ltx_Math" alttext="\operatorname{char}(L)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>char</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{char}(L)=0</annotation></semantics></math> or <math id="S5.p5.m23" class="ltx_Math" alttext="\operatorname{char}(L)=p" display="inline" intent=":literal"><semantics><mrow><mrow><mi>char</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\operatorname{char}(L)=p</annotation></semantics></math> and <math id="S5.p5.m24" class="ltx_Math" alttext="p\nmid\tau(p)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∤</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p\nmid\tau(p)</annotation></semantics></math>, it follows that every nontrivial Galois subrepresentation <math id="S5.p5.m25" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> has Tate coniveau exactly 1. Since each such <math id="S5.p5.m26" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is supported on the boundary divisors in the image of the maps <math id="S5.p5.m27" class="ltx_Math" alttext="\xi_{A}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>A</mi></msub><annotation encoding="application/x-tex">\xi_{A}</annotation></semantics></math> as above, the generalized Tate conjecture for <math id="S5.p5.m28" class="ltx_Math" alttext="H^{13}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math> is confirmed. Moreover, the semisimplicity of <math id="S5.p5.m29" class="ltx_Math" alttext="H^{13}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>13</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{13}((\overline{\mathcal{M}}_{g,n})_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math> follows from the surjectivity of <math id="S5.p5.m30" class="ltx_math_unparsed" alttext="\bigoplus_{A}\xi_{A*}" display="inline" intent=":literal"><semantics><mrow><mo>⨁</mo><msub><mrow></mrow><mi>A</mi></msub><mi>ξ</mi><msub><mrow></mrow><mrow><mi>A</mi><mo lspace="0.222em">∗</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\bigoplus_{A}\xi_{A*}</annotation></semantics></math> and the semisimplicity of <math id="S5.p5.m31" class="ltx_Math" alttext="H^{11}((\overline{\mathcal{M}}_{1,11})_{L^{s}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow><msup><mi>L</mi><mi>s</mi></msup></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}((\overline{\mathcal{M}}_{1,11})_{L^{s}},\mathbb{Q}_{\ell})</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p6" class="ltx_para">
<p id="S5.p6.1" class="ltx_p"><span id="S5.p6.1.1" class="ltx_text">It remains to discuss <math id="S5.p6.m1" class="ltx_Math" alttext="H^{2d-j}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mi>j</mi></mrow></msup><annotation encoding="application/x-tex">H^{2d-j}</annotation></semantics></math> for odd <math id="S5.p6.m2" class="ltx_Math" alttext="j\leq 15" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≤</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">j\leq 15</annotation></semantics></math>. By Poincaré duality and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BFP24</a>]</cite>, these groups vanish for odd <math id="S5.p6.m3" class="ltx_Math" alttext="j&lt;11" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&lt;</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">j&lt;11</annotation></semantics></math>. For <math id="S5.p6.m4" class="ltx_Math" alttext="j=11" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">j=11</annotation></semantics></math> and <math id="S5.p6.m5" class="ltx_Math" alttext="13" display="inline" intent=":literal"><semantics><mn>13</mn><annotation encoding="application/x-tex">13</annotation></semantics></math>, the relevant classes lie in the semi-tautological extension generated by <math id="S5.p6.m6" class="ltx_Math" alttext="H^{11}(\overline{\mathcal{M}}_{1,11})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}(\overline{\mathcal{M}}_{1,11})</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>, Theorem 1.6]</cite>, which means that these classes are obtained from boundary strata supporting <math id="S5.p6.m7" class="ltx_Math" alttext="\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>12</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{12}</annotation></semantics></math>, via Gysing push-forward and cup product with Chern classes of tautological bundles. By representing the Chern classes of the restrictions of these bundles by algebraic cycles on the boundary strata, we see that the classes are supported on closed algebraic subsets of the predicted codimension. The case <math id="S5.p6.m8" class="ltx_Math" alttext="j=15" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">j=15</annotation></semantics></math> is similar, but now the semi-tautological extension also includes <math id="S5.p6.m9" class="ltx_Math" alttext="H^{15}(\overline{\mathcal{M}}_{1,15})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>15</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>15</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{15}(\overline{\mathcal{M}}_{1,15})</annotation></semantics></math>, and hence <math id="S5.p6.m10" class="ltx_Math" alttext="\mathsf{S}_{16}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>16</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{16}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>, Theorem 1.7]</cite>.
∎</span></p>
</div>
</div>
<div id="S5.p7" class="ltx_para">
<p id="S5.p7.1" class="ltx_p">Up to this point, we have discussed predictions and results regarding the images of cycle class maps and the support of Hodge and Galois substructures. We now turn to a complementary question: the expected structure of the kernel of the cycle class map. There is another rich web of conjectures regarding kernels of cycle class maps and filtrations on Chow groups (see, e.g., <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx40" title="" class="ltx_ref">Jan94</a>, <a href="#bib.bibx55" title="" class="ltx_ref">MNP13</a>]</cite>), which lead to interesting predictions about algebraic cycles on moduli spaces of curves.</p>
</div>
<div id="S5.p8" class="ltx_para">
<p id="S5.p8.1" class="ltx_p">Recall that for a smooth complex projective variety (or smooth and proper Deligne–Mumford stack <math id="S5.p8.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with projective coarse moduli space), we write <math id="S5.p8.m2" class="ltx_Math" alttext="Z^{k}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{k}(X)</annotation></semantics></math> for the group of codimension <math id="S5.p8.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> algebraic cycles on <math id="S5.p8.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. The codimension <math id="S5.p8.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> Chow group <math id="S5.p8.m6" class="ltx_Math" alttext="A^{k}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A^{k}(X)</annotation></semantics></math> is the quotient of <math id="S5.p8.m7" class="ltx_Math" alttext="Z^{k}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{k}(X)</annotation></semantics></math> by the subgroup of cycles rationally equivalent to zero. Let <math id="S5.p8.m8" class="ltx_Math" alttext="A^{k}(X)_{\mathbb{Q}}:=A^{k}(X)\otimes\mathbb{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><mo>:=</mo><mrow><mrow><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℚ</mi></mrow></mrow><annotation encoding="application/x-tex">A^{k}(X)_{\mathbb{Q}}:=A^{k}(X)\otimes\mathbb{Q}</annotation></semantics></math>. Then Bloch and Beilinson conjecture the existence of a decreasing filtration</p>
<table id="S5.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex25.m1" class="ltx_Math" alttext="A^{k}(X)_{\mathbb{Q}}=F^{0}A^{k}(X)_{\mathbb{Q}}\supset F^{1}A^{k}(X)_{\mathbb{Q}}\supset\cdots\supset F^{k+1}A^{k}(X)_{\mathbb{Q}}=0" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><mo>=</mo><mrow><msup><mi>F</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><mo>⊃</mo><mrow><msup><mi>F</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><mo rspace="0.1389em">⊃</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊃</mo><mrow><msup><mi>F</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A^{k}(X)_{\mathbb{Q}}=F^{0}A^{k}(X)_{\mathbb{Q}}\supset F^{1}A^{k}(X)_{\mathbb{Q}}\supset\cdots\supset F^{k+1}A^{k}(X)_{\mathbb{Q}}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p8.2" class="ltx_p">that is stable under correspondences, with the following properties:</p>
<ol id="S5.I1" class="ltx_enumerate">
<li id="S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I1.i1.p1" class="ltx_para">
<p id="S5.I1.i1.p1.1" class="ltx_p">The kernel of the cycle class map <math id="S5.I1.i1.p1.m1" class="ltx_Math" alttext="\operatorname{cyc}^{k}\colon A^{k}(X)_{\mathbb{Q}}\to H^{2k}(X,\mathbb{Q})" display="inline" intent=":literal"><semantics><mrow><msup><mi>cyc</mi><mi>k</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{cyc}^{k}\colon A^{k}(X)_{\mathbb{Q}}\to H^{2k}(X,\mathbb{Q})</annotation></semantics></math> is <math id="S5.I1.i1.p1.m2" class="ltx_Math" alttext="F^{1}A^{k}(X)_{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>F</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><annotation encoding="application/x-tex">F^{1}A^{k}(X)_{\mathbb{Q}}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I1.i2.p1" class="ltx_para">
<p id="S5.I1.i2.p1.1" class="ltx_p">If <math id="S5.I1.i2.p1.m1" class="ltx_Math" alttext="H^{p,q}(X)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{p,q}(X)=0</annotation></semantics></math> for all <math id="S5.I1.i2.p1.m2" class="ltx_Math" alttext="p+q=2k-i" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mi>i</mi></mrow></mrow><annotation encoding="application/x-tex">p+q=2k-i</annotation></semantics></math> and <math id="S5.I1.i2.p1.m3" class="ltx_Math" alttext="q\leq k-i" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≤</mo><mrow><mi>k</mi><mo>−</mo><mi>i</mi></mrow></mrow><annotation encoding="application/x-tex">q\leq k-i</annotation></semantics></math>, then <math id="S5.I1.i2.p1.m4" class="ltx_Math" alttext="F^{i}A_{k}(X)_{\mathbb{Q}}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>F</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">F^{i}A_{k}(X)_{\mathbb{Q}}=0</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S5.p8.3" class="ltx_p">See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx75" title="" class="ltx_ref">Voi03</a>, Conjecture 11.21]</cite>.</p>
</div>
<div id="S5.p9" class="ltx_para">
<p id="S5.p9.1" class="ltx_p">For <math id="S5.p9.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>, recent results show that <math id="S5.p9.m2" class="ltx_Math" alttext="H^{p,q}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{p,q}=0</annotation></semantics></math> for <math id="S5.p9.m3" class="ltx_Math" alttext="p+q\leq 10" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">p+q\leq 10</annotation></semantics></math> and <math id="S5.p9.m4" class="ltx_Math" alttext="q&lt;p" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>&lt;</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">q&lt;p</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">BFP24</a>, <a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>]</cite>. This leads to the following prediction.</p>
</div>
<div id="ThmChow5x1" class="ltx_theorem ltx_theorem_Chow5">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="ThmChow5x1.2" class="ltx_text ltx_font_bold">Chow 5 Conjecture</span></span><span id="ThmChow5x1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="ThmChow5x1.p1" class="ltx_para">
<p id="ThmChow5x1.p1.1" class="ltx_p"><span id="ThmChow5x1.p1.1.1" class="ltx_text ltx_font_italic">The rational cycle class map <math id="ThmChow5x1.p1.m1" class="ltx_Math" alttext="A^{k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}\to H^{2k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}\to H^{2k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is an isomorphism for <math id="ThmChow5x1.p1.m2" class="ltx_Math" alttext="k\leq 5" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k\leq 5</annotation></semantics></math>, and for all <math id="ThmChow5x1.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="ThmChow5x1.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.p10" class="ltx_para ltx_noindent">
<p id="S5.p10.1" class="ltx_p">This is trivial for <math id="S5.p10.m1" class="ltx_Math" alttext="k=0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k=0</annotation></semantics></math>, and for <math id="S5.p10.m2" class="ltx_Math" alttext="k=1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k=1</annotation></semantics></math> it follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AC98</a>]</cite>. As further evidence, we note that both the rational Chow groups <math id="S5.p10.m3" class="ltx_Math" alttext="A^{k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><annotation encoding="application/x-tex">A^{k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}</annotation></semantics></math> and the singular cohomology groups <math id="S5.p10.m4" class="ltx_Math" alttext="H^{2k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> are generated by tautological classes for many small values of <math id="S5.p10.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S5.p10.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx17" title="" class="ltx_ref">CL24</a>]</cite>. Through the work of Pixton <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx68" title="" class="ltx_ref">Pix13</a>]</cite>, it is widely believed that the subring of <math id="S5.p10.m7" class="ltx_Math" alttext="A^{*}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><annotation encoding="application/x-tex">A^{*}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}</annotation></semantics></math> generated by tautological classes maps isomorphically onto its image in <math id="S5.p10.m8" class="ltx_Math" alttext="H^{*}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">Can25</a>, Conjecture 1]</cite>), but this is not known in general. In addition, <math id="S5.p10.m9" class="ltx_Math" alttext="A^{2}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><annotation encoding="application/x-tex">A^{2}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}</annotation></semantics></math> is generated by tautological cycles when the coarse space <math id="S5.p10.m10" class="ltx_Math" alttext="\overline{M}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{M}_{g,n}</annotation></semantics></math> is rationally connected <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx48" title="" class="ltx_ref">Lu25</a>, Theorem 1.4]</cite>.</p>
</div>
<div id="S5.p11" class="ltx_para">
<p id="S5.p11.1" class="ltx_p">Of course, the Chow groups of <math id="S5.p11.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> are not generated by tautological classes in general. By work of Jannsen <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx40" title="" class="ltx_ref">Jan94</a>, Theorem 3.5 and Corollary 3.7]</cite>, the kernel of the cycle class map on <math id="S5.p11.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>-cycles is not finite-dimensional, in the sense of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx59" title="" class="ltx_ref">Mum68</a>]</cite>, when <math id="S5.p11.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> has a nontrivial holomorphic <math id="S5.p11.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-form, for some <math id="S5.p11.m5" class="ltx_Math" alttext="p\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">p\geq 2</annotation></semantics></math>. The moduli spaces of stable curves have no holomorphic <math id="S5.p11.m6" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-forms for <math id="S5.p11.m7" class="ltx_Math" alttext="p&lt;11" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">p&lt;11</annotation></semantics></math>, by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">CLPW24</a>]</cite>, and hence the non-representable Chow groups that are produced in this way are for cycles of codimension 11 and higher. All other known constructions of non-tautological algebraic cycles on <math id="S5.p11.m8" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math>, such as <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx37" title="" class="ltx_ref">GP03</a>, <a href="#bib.bibx76" title="" class="ltx_ref">vZ18</a>, <a href="#bib.bibx2" title="" class="ltx_ref">ACC+25</a>]</cite>, also produce cycles of codimension 11 and higher. We propose the following optimistic conjecture.</p>
</div>
<div id="ThmChow10x1" class="ltx_theorem ltx_theorem_Chow10">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="ThmChow10x1.2" class="ltx_text ltx_font_bold">Chow 10 Conjecture</span></span><span id="ThmChow10x1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="ThmChow10x1.p1" class="ltx_para">
<p id="ThmChow10x1.p1.1" class="ltx_p"><span id="ThmChow10x1.p1.1.1" class="ltx_text ltx_font_italic">The Chow group <math id="ThmChow10x1.p1.m1" class="ltx_Math" alttext="A^{k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><annotation encoding="application/x-tex">A^{k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}</annotation></semantics></math> is generated by tautological cycles for <math id="ThmChow10x1.p1.m2" class="ltx_Math" alttext="k\leq 10" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">k\leq 10</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.p12" class="ltx_para ltx_noindent">
<p id="S5.p12.1" class="ltx_p">Combining the Chow 10 conjecture, the taut 20 conjecture, and the expectation that the tautological subring of Chow maps isomorphically onto its image in cohomology, we arrive at the prediction that the cycle class map</p>
<table id="S5.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex26.m1" class="ltx_Math" alttext="\operatorname{cyc}^{k}\colon A^{k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}\to H^{2k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}" display="block" intent=":literal"><semantics><mrow><msup><mi>cyc</mi><mi>k</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>A</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℚ</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{cyc}^{k}\colon A^{k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}\to H^{2k}(\overline{\mathcal{M}}_{g,n})_{\mathbb{Q}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p12.2" class="ltx_p">is an isomorphism for <math id="S5.p12.m1" class="ltx_Math" alttext="k\leq 10" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">k\leq 10</annotation></semantics></math>. These conjectures are open even in the first nontrivial case, for <math id="S5.p12.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,11}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,11}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6. </span>Future outlook</h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">We now discuss some of the natural next steps toward proving the conjectures stated in this article and deepening our understanding of the Hodge and Tate conjectures for moduli spaces of curves, roughly in increasing order of expected difficulty.</p>
</div>
<div id="S6.p2" class="ltx_para">
<p id="S6.p2.1" class="ltx_p">For even degrees, we have seen that the generalized Hodge and Tate conjectures hold for <math id="S6.p2.m1" class="ltx_Math" alttext="H^{k}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{k}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> for even <math id="S6.p2.m2" class="ltx_Math" alttext="k\leq 6" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">k\leq 6</annotation></semantics></math>, except for <math id="S6.p2.m3" class="ltx_Math" alttext="k=6" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">k=6</annotation></semantics></math> and <math id="S6.p2.m4" class="ltx_Math" alttext="g\in\{7,8,9\}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>7</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>9</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">g\in\{7,8,9\}</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmtheorem1" class="ltx_theorem ltx_theorem_problem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem1.2" class="ltx_text ltx_font_bold">Problem 6.1</span></span><span id="S6.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem1.p1" class="ltx_para">
<p id="S6.Thmtheorem1.p1.1" class="ltx_p"><span id="S6.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Show that <math id="S6.Thmtheorem1.p1.m1" class="ltx_Math" alttext="H^{6}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{6}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for all <math id="S6.Thmtheorem1.p1.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S6.Thmtheorem1.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.p3" class="ltx_para ltx_noindent">
<p id="S6.p3.1" class="ltx_p">Once we know that <math id="S6.p3.m1" class="ltx_Math" alttext="H^{6}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{6}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for all <math id="S6.p3.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> and <math id="S6.p3.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, it will follow by the Arbarello–Cornalba induction that <math id="S6.p3.m4" class="ltx_Math" alttext="H^{8}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{8}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is tautological for all but a small finite list of <math id="S6.p3.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>, and for all <math id="S6.p3.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</p>
</div>
<div id="S6.p4" class="ltx_para">
<p id="S6.p4.1" class="ltx_p">For odd degrees, we have seen that the generalized Hodge conjecture holds for <math id="S6.p4.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> in all odd degrees less than 15, and that the generalized Tate conjecture holds in those cases under the additional ordinarity hypotheses in Theorem <a href="#ThmTheorem3" title="Theorem C. ‣ 1.1. Main statements ‣ 1. Introduction ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">CLP24</a>, Theorems 1.1 and 1.7]</cite>, we also know that each irreducible motivic structure that is a subquotient of <math id="S6.p4.m2" class="ltx_Math" alttext="H^{15}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>15</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{15}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is isomorphic to either <math id="S6.p4.m3" class="ltx_Math" alttext="\mathsf{S}_{16}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>16</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{16}</annotation></semantics></math> or <math id="S6.p4.m4" class="ltx_Math" alttext="\mathsf{L}^{2}\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝖫</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝖲</mi><mn>12</mn></msub></mrow><annotation encoding="application/x-tex">\mathsf{L}^{2}\mathsf{S}_{12}</annotation></semantics></math>, as predicted by Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 ([]). ‣ 4. Inspiration from arithmetic ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>. Moreover, the multiplicity of <math id="S6.p4.m5" class="ltx_Math" alttext="\mathsf{S}_{16}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>16</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{16}</annotation></semantics></math> is zero unless <math id="S6.p4.m6" class="ltx_Math" alttext="g=1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g=1</annotation></semantics></math> and <math id="S6.p4.m7" class="ltx_Math" alttext="n\geq 15" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">n\geq 15</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">CLPW25b</a>, Theorem 1.3]</cite>.</p>
</div>
<div id="S6.Thmtheorem2" class="ltx_theorem ltx_theorem_problem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem2.2" class="ltx_text ltx_font_bold">Problem 6.2</span></span><span id="S6.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem2.p1" class="ltx_para">
<p id="S6.Thmtheorem2.p1.1" class="ltx_p"><span id="S6.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Prove the generalized Hodge conjecture for <math id="S6.Thmtheorem2.p1.m1" class="ltx_Math" alttext="H^{15}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>15</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{15}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.p5" class="ltx_para ltx_noindent">
<p id="S6.p5.1" class="ltx_p">It would suffice to show that every occurrence of <math id="S6.p5.m1" class="ltx_Math" alttext="\mathsf{L}^{2}\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝖫</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝖲</mi><mn>12</mn></msub></mrow><annotation encoding="application/x-tex">\mathsf{L}^{2}\mathsf{S}_{12}</annotation></semantics></math> comes from a codimension 2 push-forward of a degree 11 cohomology class on a product of smaller moduli spaces.</p>
</div>
<div id="S6.p6" class="ltx_para">
<p id="S6.p6.1" class="ltx_p">New phenomena arise in higher cohomological degrees. For instance, the irreducible <math id="S6.p6.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic Galois representation attached to <math id="S6.p6.m2" class="ltx_Math" alttext="\mathsf{S}_{18}:=W_{17}H^{17}(\mathcal{M}_{1,17})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖲</mi><mn>18</mn></msub><mo>:=</mo><mrow><msub><mi>W</mi><mn>17</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>17</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>1</mn><mo>,</mo><mn>17</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{S}_{18}:=W_{17}H^{17}(\mathcal{M}_{1,17})</annotation></semantics></math> appears in the middle cohomology of both <math id="S6.p6.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,17}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>17</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,17}</annotation></semantics></math> and <math id="S6.p6.m4" class="ltx_Math" alttext="\overline{\mathcal{M}}_{2,14}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>14</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{2,14}</annotation></semantics></math>. This is the first instance of a general phenomenon, related to Saito–Kurokawa lifts of modular forms. The cohomology of <math id="S6.p6.m5" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,n}</annotation></semantics></math> is related to modular forms for <math id="S6.p6.m6" class="ltx_Math" alttext="\mathrm{SL}_{2}(\mathbb{Z})" display="inline" intent=":literal"><semantics><mrow><msub><mi>SL</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SL}_{2}(\mathbb{Z})</annotation></semantics></math> by the Eichler–Shimura correspondence, and the cohomology of <math id="S6.p6.m7" class="ltx_Math" alttext="\overline{\mathcal{M}}_{2,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{2,n}</annotation></semantics></math> is related to the cohomology of local systems on <math id="S6.p6.m8" class="ltx_Math" alttext="\mathcal{A}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{A}_{2}</annotation></semantics></math>, which are in turn related to Siegel modular forms. Some Siegel modular forms arise as Saito–Kurokawa lifts of modular forms from <math id="S6.p6.m9" class="ltx_Math" alttext="\mathrm{SL}_{2}(\mathbb{Z})" display="inline" intent=":literal"><semantics><mrow><msub><mi>SL</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SL}_{2}(\mathbb{Z})</annotation></semantics></math> to <math id="S6.p6.m10" class="ltx_Math" alttext="\operatorname{Sp}_{4}(\mathbb{Z})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Sp</mi><mn>4</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Sp}_{4}(\mathbb{Z})</annotation></semantics></math>, and the corresponding <math id="S6.p6.m11" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic Galois representations are isomorphic, without any clear geometric explanation.</p>
</div>
<div id="S6.p7" class="ltx_para">
<p id="S6.p7.1" class="ltx_p">Gu, Lee, and Prasanna have announced work in preparation showing that the rational Hodge structure on <math id="S6.p7.m1" class="ltx_Math" alttext="W_{17}H^{17}(\mathcal{M}_{2,14})" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mn>17</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>17</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>2</mn><mo>,</mo><mn>14</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{17}H^{17}(\mathcal{M}_{2,14})</annotation></semantics></math> agrees with that on <math id="S6.p7.m2" class="ltx_Math" alttext="\mathsf{S}_{18}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>18</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{18}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">GLP26</a>]</cite>. One expects similar agreement of Hodge structures in other instances where isomorphic Galois representations appear on different moduli spaces, but this is not known.</p>
</div>
<div id="S6.p8" class="ltx_para">
<p id="S6.p8.1" class="ltx_p">We know that every holomorphic 17-form on <math id="S6.p8.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> is pulled back, by forgetting marked points, from either <math id="S6.p8.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,17}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>17</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,17}</annotation></semantics></math> or <math id="S6.p8.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{2,14}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>14</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{2,14}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx21" title="" class="ltx_ref">CLPW25a</a>]</cite>. From Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 ([]). ‣ 4. Inspiration from arithmetic ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, we expect that all other irreducible Hodge structures appearing in degree 17 on <math id="S6.p8.m4" class="ltx_Math" alttext="\overline{\mathcal{M}}_{g,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{g,n}</annotation></semantics></math> should have positive Hodge coniveau. The following is therefore a natural first step toward proving the generalized Hodge conjecture for <math id="S6.p8.m5" class="ltx_Math" alttext="H^{17}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>17</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{17}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmtheorem3" class="ltx_theorem ltx_theorem_problem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem3.2" class="ltx_text ltx_font_bold">Problem 6.3</span></span><span id="S6.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem3.p1" class="ltx_para">
<p id="S6.Thmtheorem3.p1.1" class="ltx_p"><span id="S6.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Show that <math id="S6.Thmtheorem3.p1.m1" class="ltx_Math" alttext="H^{17}(\overline{\mathcal{M}}_{g,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>17</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{17}(\overline{\mathcal{M}}_{g,n})</annotation></semantics></math> is supported on a divisor, for <math id="S6.Thmtheorem3.p1.m2" class="ltx_Math" alttext="g\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">g\geq 3</annotation></semantics></math> and all <math id="S6.Thmtheorem3.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.p9" class="ltx_para">
<p id="S6.p9.1" class="ltx_p">Another natural next direction to explore is the generalized Tate conjecture for <math id="S6.p9.m1" class="ltx_Math" alttext="H^{11}((\overline{\mathcal{M}}_{g,n})_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>g</mi><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}((\overline{\mathcal{M}}_{g,n})_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})</annotation></semantics></math> for primes <math id="S6.p9.m2" class="ltx_Math" alttext="p\neq\ell" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≠</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">p\neq\ell</annotation></semantics></math> such that <math id="S6.p9.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> divides <math id="S6.p9.m4" class="ltx_Math" alttext="\tau(p)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(p)</annotation></semantics></math>. The set of such primes less than <math id="S6.p9.m5" class="ltx_Math" alttext="10^{10}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>10</mn></msup><annotation encoding="application/x-tex">10^{10}</annotation></semantics></math> is
<math id="S6.p9.m6" class="ltx_Math" alttext="\{2,\,3,\,5,\,7,\,2411,\,7758337633\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn> 3</mn><mo>,</mo><mn> 5</mn><mo>,</mo><mn> 7</mn><mo>,</mo><mn> 2411</mn><mo>,</mo><mn> 7758337633</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{2,\,3,\,5,\,7,\,2411,\,7758337633\}</annotation></semantics></math>, and the multiplicity with which <math id="S6.p9.m7" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> divides <math id="S6.p9.m8" class="ltx_Math" alttext="\tau(p)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(p)</annotation></semantics></math> in these cases is 1, except for
<math id="S6.p9.m9" class="ltx_Math" alttext="\nu_{2}(\tau(2))=3" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\nu_{2}(\tau(2))=3</annotation></semantics></math> and <math id="S6.p9.m10" class="ltx_Math" alttext="\nu_{3}(\tau(3))=2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\nu_{3}(\tau(3))=2</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmtheorem4" class="ltx_theorem ltx_theorem_problem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem4.2" class="ltx_text ltx_font_bold">Problem 6.4</span></span><span id="S6.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem4.p1" class="ltx_para">
<p id="S6.Thmtheorem4.p1.1" class="ltx_p"><span id="S6.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Show that <math id="S6.Thmtheorem4.p1.m1" class="ltx_Math" alttext="H^{11}((\overline{\mathcal{M}}_{1,11})_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>11</mn></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mi>p</mi></msub></msub><mo>,</mo><msub><mi>ℚ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{11}((\overline{\mathcal{M}}_{1,11})_{\overline{\mathbb{F}}_{p}},\mathbb{Q}_{\ell})</annotation></semantics></math> is supported on a closed algebraic subset of codimension <math id="S6.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\nu_{p}(\tau(p))" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu_{p}(\tau(p))</annotation></semantics></math>, for <math id="S6.Thmtheorem4.p1.m3" class="ltx_Math" alttext="p\in\{2,\,3,\,5,\,7,\,2411,\,7758337633\}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn> 3</mn><mo>,</mo><mn> 5</mn><mo>,</mo><mn> 7</mn><mo>,</mo><mn> 2411</mn><mo>,</mo><mn> 7758337633</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">p\in\{2,\,3,\,5,\,7,\,2411,\,7758337633\}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.p10" class="ltx_para ltx_noindent">
<p id="S6.p10.1" class="ltx_p">This problem illustrates a feature absent from the Hodge-theory side: in positive characteristic, the predicted coniveau can jump at nonordinary primes, and the support problem becomes sensitive to <math id="S6.p10.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-adic slopes of modular Galois representations. Nonordinary primes for higher cusp-form motives, such as <math id="S6.p10.m2" class="ltx_Math" alttext="\mathsf{S}_{16}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>16</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{16}</annotation></semantics></math>, give further support problems analogous to Problem <a href="#S6.Thmtheorem4" title="Problem 6.4. ‣ 6. Future outlook ‣ On the Hodge and Tate conjectures for moduli spaces of curves" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a>.</p>
</div>
<div id="S6.p11" class="ltx_para">
<p id="S6.p11.1" class="ltx_p">Other difficult phenomena arise when one considers products of different moduli spaces of curves, such as <math id="S6.p11.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{1,17}\times\overline{\mathcal{M}}_{2,14}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>17</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>14</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{1,17}\times\overline{\mathcal{M}}_{2,14}</annotation></semantics></math>, where isomorphic motivic structures appear independently, without geometric explanation.</p>
</div>
<div id="S6.Thmtheorem5" class="ltx_theorem ltx_theorem_problem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem5.2" class="ltx_text ltx_font_bold">Problem 6.5</span></span><span id="S6.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem5.p1" class="ltx_para">
<p id="S6.Thmtheorem5.p1.1" class="ltx_p"><span id="S6.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">After choosing an isomorphism between the copies of <math id="S6.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\mathsf{S}_{18}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>18</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{18}</annotation></semantics></math> that appear in <math id="S6.Thmtheorem5.p1.m2" class="ltx_Math" alttext="H^{17}(\overline{\mathcal{M}}_{1,17})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>17</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>17</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{17}(\overline{\mathcal{M}}_{1,17})</annotation></semantics></math> and <math id="S6.Thmtheorem5.p1.m3" class="ltx_Math" alttext="H^{17}(\overline{\mathcal{M}}_{2,14})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>17</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>14</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{17}(\overline{\mathcal{M}}_{2,14})</annotation></semantics></math>, respectively, produce an algebraic cycle of dimension 17 whose class spans the Tate subspace</span></p>
<table id="S6.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex27.m1" class="ltx_math_unparsed" alttext="\mathsf{L}^{17}\cong\wedge^{2}\mathsf{S}_{18}\subset H^{34}(\overline{\mathcal{M}}_{1,17}\times\overline{\mathcal{M}}_{2,14})." display="block" intent=":literal"><semantics><mrow><msup><mi>𝖫</mi><mn>17</mn></msup><mo rspace="0em">≅</mo><msup><mo lspace="0em">∧</mo><mn>2</mn></msup><msub><mi>𝖲</mi><mn>18</mn></msub><mo>⊂</mo><msup><mi>H</mi><mn>34</mn></msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mn>17</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo>,</mo><mn>14</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{L}^{17}\cong\wedge^{2}\mathsf{S}_{18}\subset H^{34}(\overline{\mathcal{M}}_{1,17}\times\overline{\mathcal{M}}_{2,14}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S6.p12" class="ltx_para ltx_noindent">
<p id="S6.p12.1" class="ltx_p">The existence of such a cycle is predicted by the Hodge and Tate conjectures, but there is no known natural candidate.</p>
</div>
<div id="S6.p13" class="ltx_para">
<p id="S6.p13.1" class="ltx_p">One also expects a nontrivial Hodge class in middle degree on <math id="S6.p13.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{3,16}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>3</mn><mo>,</mo><mn>16</mn></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{3,16}</annotation></semantics></math>, coming from a tensor product of two irreducible motivic structures isomorphic to <math id="S6.p13.m2" class="ltx_Math" alttext="\mathsf{S}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝖲</mi><mn>12</mn></msub><annotation encoding="application/x-tex">\mathsf{S}_{12}</annotation></semantics></math> whose <math id="S6.p13.m3" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic realizations are related by an Ikeda lift. Finding algebraic cycles that represent such classes (or proving their nonexistence!) would be most interesting.</p>
</div>
</section>
