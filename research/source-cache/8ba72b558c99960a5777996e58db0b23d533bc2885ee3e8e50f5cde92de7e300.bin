dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="miter" transform="matrix(-0.82358 -0.5672 -0.5672 0.82358 -1.14 -75.94)"><path style="fill:none" d="M 0 2.71 C 0.95 2.71 1.72 2.1 1.72 1.36 C 1.72 0.61 0.95 0 0 0"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.82358 0.5672 -0.5672 0.82358 35.56 -50.67)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></div><div class="ltx_flex_cell ltx_flex_size_2"><span class="ltx_inline-block"><svg id="S4.F2.pic2" class="ltx_picture ltx_centering ltx_figure_panel" height="197.5" overflow="visible" style="vertical-align:-98.75px" version="1.1" viewBox="0 0 141.29 197.5" width="141.29"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,197.5) matrix(1 0 0 -1 0 0) translate(70.65,0) translate(0,98.75)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -70.65 -93.69)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 197.5)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 14.67)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 28.89 0) translate(41.76,0) matrix(1.0 0.0 0.0 1.0 -35.8 0)"><foreignObject style="--ltx-fo-width:5.18em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.14em;font-size:10pt;" height="11.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="71.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F2.pic2.1" class="ltx_text ltx_markedasmath">our <math id="S4.F2.pic2.m1.m1" class="ltx_Math" alttext="\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\leq</annotation></semantics></math> order</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 52.74)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 56.2 0) translate(14.44,0) matrix(1.0 0.0 0.0 1.0 -8.48 0)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.pic2.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Psi_{0}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Psi_{0}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 99.31)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(14.44,0) matrix(1.0 0.0 0.0 1.0 -8.48 0)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.pic2.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Psi_{1}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Psi_{1}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 112.41 0) translate(14.44,0) matrix(1.0 0.0 0.0 1.0 -8.48 0)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.pic2.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Psi_{2}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Psi_{2}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 145.88)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 56.59 0) translate(14.06,0) matrix(1.0 0.0 0.0 1.0 -8.1 0)"><foreignObject style="--ltx-fo-width:1.17em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.pic2.m5" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Sigma_{3}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Sigma_{3}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 192.44)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 59.47 0) translate(11.18,0) matrix(1.0 0.0 0.0 1.0 -5.22 0)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.pic2.m6" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces Z}" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces Z}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -42.52 14.24 L -13.12 38.59"></path></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 42.52 14.24 L 13.12 38.59"></path></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 13.68 -32.33 L 43.08 -7.97"></path></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -13.68 -32.33 L -43.08 -7.97"></path></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 0 -78.89 L 0 -54.54"></path></g></g></svg></span></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2. </span>Two partial orders on the genus <math id="S4.F2.m2" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> strata</figcaption>
</figure>
<div id="S4.Thmthm9" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm9.2" class="ltx_text ltx_font_bold">Lemma 4.9</span></span><span id="S4.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm9.p1" class="ltx_para">
<p id="S4.Thmthm9.p1.1" class="ltx_p"><span id="S4.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">The Chow ring <math id="S4.Thmthm9.p1.m1" class="ltx_Math" alttext="A^{*}(\mathcal{H}_{4,8}\smallsetminus\beta^{-1}(\mathcal{M}_{8}^{3}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><mn>8</mn></mrow></msub><mo>∖</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>8</mn><mn>3</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\mathcal{H}_{4,8}\smallsetminus\beta^{-1}(\mathcal{M}_{8}^{3}))</annotation></semantics></math> is generated by CE classes. Hence, all classes supported on <math id="S4.Thmthm9.p1.m2" class="ltx_Math" alttext="\mathcal{M}_{8}^{4}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>8</mn><mn>4</mn></msubsup><annotation encoding="application/x-tex">\mathcal{M}_{8}^{4}</annotation></semantics></math> are tautological on <math id="S4.Thmthm9.p1.m3" class="ltx_Math" alttext="\mathcal{M}_{8}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>8</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{8}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS5.p3" class="ltx_para">
<p id="S4.SS5.p3.1" class="ltx_p"><span id="S4.SS5.p3.1.1" class="ltx_text">The proof is very similar to Lemma <a href="#S4.Thmthm8" title="Lemma 4.8. ‣ 4.4. Genus 
          
            7
          
         tetragonal curves ‣ 4. The Tetragonal Locus ‣ The Chow Rings of the Moduli Spaces of Curves of Genus 7, 8, and 9" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.8</span></a>. The lowest stratum is again the hyperelliptic locus: <math id="S4.SS5.p3.m1" class="ltx_Math" alttext="Z=\beta^{-1}(\mathcal{M}_{8}^{2})=\beta^{-1}(\mathcal{M}_{8}^{3})" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>=</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>8</mn><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>8</mn><mn>3</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z=\beta^{-1}(\mathcal{M}_{8}^{2})=\beta^{-1}(\mathcal{M}_{8}^{3})</annotation></semantics></math>. Then, we notice that <math id="S4.SS5.p3.m2" class="ltx_Math" alttext="\Sigma_{3}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\Sigma_{3}</annotation></semantics></math> is equal to <math id="S4.SS5.p3.m3" class="ltx_Math" alttext="\Sigma_{(2,4,5)}(\mathcal{E})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{(2,4,5)}(\mathcal{E})</annotation></semantics></math> and</span></p>
<table id="S4.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex13.m1" class="ltx_Math" alttext="\codim\Sigma_{3}=3=h^{1}(\mathbb{P}^{1},\mathcal{E}nd(\mathcal{O}(2,4,5)))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>codim</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Σ</mi><mn>3</mn></msub></mrow><mo>=</mo><mn>3</mn><mo>=</mo><mrow><msup><mi>h</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\codim\Sigma_{3}=3=h^{1}(\mathbb{P}^{1},\mathcal{E}nd(\mathcal{O}(2,4,5))).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.p3.2" class="ltx_p"><span id="S4.SS5.p3.2.1" class="ltx_text">Thus, by Lemma <a href="#S3.Thmthm7" title="Lemma 3.7. ‣ 3. Splitting Loci ‣ The Chow Rings of the Moduli Spaces of Curves of Genus 7, 8, and 9" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a>, the fundamental class of <math id="S4.SS5.p3.m4" class="ltx_Math" alttext="\Sigma_{3}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\Sigma_{3}</annotation></semantics></math> inside <math id="S4.SS5.p3.m5" class="ltx_Math" alttext="\mathcal{H}_{4,8}\smallsetminus\beta^{-1}(\mathcal{M}_{8}^{3})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><mn>8</mn></mrow></msub><mo>∖</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>8</mn><mn>3</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{4,8}\smallsetminus\beta^{-1}(\mathcal{M}_{8}^{3})</annotation></semantics></math> is tautological. By Lemma <a href="#S4.Thmthm3" title="Lemma 4.3. ‣ 4.2. Chow rings of very unbalanced splitting strata ‣ 4. The Tetragonal Locus ‣ The Chow Rings of the Moduli Spaces of Curves of Genus 7, 8, and 9" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> (<a href="#S4.I2.i1" title="item 1 ‣ Lemma 4.3. ‣ 4.2. Chow rings of very unbalanced splitting strata ‣ 4. The Tetragonal Locus ‣ The Chow Rings of the Moduli Spaces of Curves of Genus 7, 8, and 9" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), the Chow ring of the locally closed stratum <math id="S4.SS5.p3.m6" class="ltx_Math" alttext="A^{*}(\Sigma_{3})" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\Sigma_{3})</annotation></semantics></math> is generated by the restrictions of CE classes. By the push-pull formula, every class supported on <math id="S4.SS5.p3.m7" class="ltx_Math" alttext="\Sigma_{3}\subset\mathcal{H}_{4,8}\smallsetminus\beta^{-1}(\mathcal{M}_{8}^{3})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mn>3</mn></msub><mo>⊂</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><mn>8</mn></mrow></msub><mo>∖</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>8</mn><mn>3</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{3}\subset\mathcal{H}_{4,8}\smallsetminus\beta^{-1}(\mathcal{M}_{8}^{3})</annotation></semantics></math> is tautological.</span></p>
</div>
<div id="S4.SS5.p4" class="ltx_para">
<p id="S4.SS5.p4.1" class="ltx_p"><span id="S4.SS5.p4.1.1" class="ltx_text">Meanwhile, Proposition <a href="#S2.Thmthm9" title="Proposition 2.9. ‣ 2.1. The Casnati–Ekedahl structure theorem ‣ 2. Hurwitz Schemes and the Tautological Ring ‣ The Chow Rings of the Moduli Spaces of Curves of Genus 7, 8, and 9" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.9</span></a> shows that <math id="S4.SS5.p4.m1" class="ltx_Math" alttext="A^{*}(\Psi)=A^{*}(\Psi_{0}\cup\Psi_{1}\cup\Psi_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mn>0</mn></msub><mo>∪</mo><msub><mi mathvariant="normal">Ψ</mi><mn>1</mn></msub><mo>∪</mo><msub><mi mathvariant="normal">Ψ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\Psi)=A^{*}(\Psi_{0}\cup\Psi_{1}\cup\Psi_{2})</annotation></semantics></math> is generated by tautological classes. Putting this together with the previous paragraph, all of <math id="S4.SS5.p4.m2" class="ltx_Math" alttext="A^{*}(\mathcal{H}_{4,8}\smallsetminus\beta^{-1}(\mathcal{M}_{8}^{3}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>4</mn><mo>,</mo><mn>8</mn></mrow></msub><mo>∖</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>8</mn><mn>3</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A^{*}(\mathcal{H}_{4,8}\smallsetminus\beta^{-1}(\mathcal{M}_{8}^{3}))</annotation></semantics></math> is generated by tautological classes.
∎</span></p>
</div>
</div>
</section>
<section id="S4.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.6. </span>Genus <math id="S4.SS6.m1" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math> tetragonal curves</h3>

<div id="S4.SS6.p1" class="ltx_para">
<p id="S4.SS6.p1.1" class="ltx_p">Using (<a href="#S4.E3" title="In 4. The Tetragonal Locus ‣ The Chow Rings of the Moduli Spaces of Curves of Genus 7, 8, and 9" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>) – (<a href="#S4.E9" title="In 4. The Tetragonal Locus ‣ The Chow Rings of the Moduli Spaces of Curves of Genus 7, 8, and 9" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>), we find that the allowed splitting types in genus <math id="S4.SS6.p1.m1" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math> are as follows. Again, we label a stratum <math id="S4.SS6.p1.m2" class="ltx_Math" alttext="\Psi_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Psi_{i}</annotation></semantics></math> if <math id="S4.SS6.p1.m3" class="ltx_Math" alttext="2e_{1}-f_{1}\geq-1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo rspace="0em">≥</mo><mrow><mo lspace="0em">−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">2e_{1}-f_{1}\geq-1</annotation></semantics></math>.</p>
<ol id="S4.I7" class="ltx_enumerate">
<li id="S4.I7.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(<math id="S4.I7.ix1.m1" class="ltx_Math" alttext="\Psi_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\Psi_{0}</annotation></semantics></math>)</span> 
