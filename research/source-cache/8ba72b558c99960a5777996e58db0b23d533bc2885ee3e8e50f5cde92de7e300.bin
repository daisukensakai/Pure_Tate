<p id="S4.I7.ix5.p1.1" class="ltx_p"><math id="S4.I7.ix5.p1.m1" class="ltx_Math" alttext="E=(4,4,4),F=(4,8)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mn>8</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E=(4,4,4),F=(4,8)</annotation></semantics></math>: codimension <math id="S4.I7.ix5.p1.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, such curves have bidegree <math id="S4.I7.ix5.p1.m3" class="ltx_Math" alttext="(4,4)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(4,4)</annotation></semantics></math> on <math id="S4.I7.ix5.p1.m4" class="ltx_Math" alttext="\mathbb{P}^{1}\times\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{P}^{1}\times\mathbb{P}^{1}</annotation></semantics></math>.</p>
