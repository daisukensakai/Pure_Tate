<li id="S4.I7.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(<math id="S4.I7.ix4.m1" class="ltx_Math" alttext="\Psi_{3}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\Psi_{3}</annotation></semantics></math>)</span> 
<div id="S4.I7.ix4.p1" class="ltx_para">
<p id="S4.I7.ix4.p1.1" class="ltx_p"><math id="S4.I7.ix4.p1.m1" class="ltx_Math" alttext="E=(3,4,5),F=(5,7)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo>,</mo><mn>7</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E=(3,4,5),F=(5,7)</annotation></semantics></math>: codimension 2, both <math id="S4.I7.ix4.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and <math id="S4.I7.ix4.p1.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> unbalanced.</p>
